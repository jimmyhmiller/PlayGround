// SCENARIO 5 — introduce an enum and dispatch on it.
//
// Particles on the right half become rings — stroked rings, not bigger discs:
// the two arms call different foreign functions, so the enum shows up as an
// actual difference in shape. `draw` now matches on `Kind`, which sets up the
// scenario that follows: what happens to this match when the enum grows a
// variant underneath it.
//
// `radius` is untouched and still sizes both arms, so scrubbing it keeps
// working across the shape change.

enum Kind { Dot, Ring }

fn kind_of(p: Particle) -> Kind {
    if p.x > 320 { return Kind::Ring; }
    Kind::Dot
}

fn draw(p: Particle) -> () {
    match kind_of(p) {
        Dot => { circle(cv, p.x, p.y, radius(p), tint(p)); }
        Ring => { ring(cv, p.x, p.y, radius(p) + 6, tint(p)); }
    }
}
