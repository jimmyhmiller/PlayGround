; Pure-Coil llhttp 9.4.3-compatible streaming HTTP/1 parser.
(module coil.llhttp)
(import "primitive.coil" :as primitive)
(import "slice.coil" :as slice)
(import "llhttp_types.coil" :as types :use [Parser Settings])
(import "llhttp_generated.coil" :as generated)

(export Parser Settings
        HTTP_BOTH HTTP_REQUEST HTTP_RESPONSE
        HPE_OK HPE_INVALID_EOF_STATE HPE_PAUSED HPE_PAUSED_UPGRADE
        init reset settings-init execute finish
        pause resume resume-after-upgrade
        get-type get-http-major get-http-minor get-method get-status-code get-upgrade
        get-errno get-error-reason get-error-pos
        set-error-reason! message-needs-eof? should-keep-alive?
        set-lenient-headers! set-lenient-chunked-length!
        set-lenient-keep-alive! set-lenient-transfer-encoding!
        set-lenient-version! set-lenient-data-after-close!
        set-lenient-optional-lf-after-cr! set-lenient-optional-crlf-after-chunk!
        set-lenient-optional-cr-before-lf! set-lenient-spaces-after-chunk-size!
        set-lenient-header-value-relaxed!
        set-simple-callback! set-span-callback!)

(const HTTP_BOTH 0)
(const HTTP_REQUEST 1)
(const HTTP_RESPONSE 2)

(const HPE_OK 0)
(const HPE_INVALID_EOF_STATE 14)
(const HPE_PAUSED 21)
(const HPE_PAUSED_UPGRADE 22)

(const FINISH_SAFE 0)
(const FINISH_SAFE_WITH_CB 1)
(const FINISH_UNSAFE 2)

(const LENIENT_HEADERS 1)
(const LENIENT_CHUNKED_LENGTH 2)
(const LENIENT_KEEP_ALIVE 4)
(const LENIENT_TRANSFER_ENCODING 8)
(const LENIENT_VERSION 16)
(const LENIENT_DATA_AFTER_CLOSE 32)
(const LENIENT_OPTIONAL_LF_AFTER_CR 64)
(const LENIENT_OPTIONAL_CRLF_AFTER_CHUNK 128)
(const LENIENT_OPTIONAL_CR_BEFORE_LF 256)
(const LENIENT_SPACES_AFTER_CHUNK_SIZE 512)
(const LENIENT_HEADER_VALUE_RELAXED 1024)

;; Initialize parser state. `settings` must outlive the parser.
(defn init [(parser (ptr Parser)) (parser-type i64) (settings (ptr Settings))] (-> i64)
  (generated/internal-init parser)
  (types/field-store! parser 1 parser-type)
  (types/field-store! parser 12 (primitive/cast i64 settings))
  0)

;; Clear every callback in a settings table.
(defn settings-init [(settings (ptr Settings))] (-> i64)
  (primitive/store! settings (primitive/zeroed Settings))
  0)

;; Reset protocol state while preserving type, settings, user data and leniency.
(defn reset [(parser (ptr Parser))] (-> i64)
  (let [parser-type (types/field-load parser 1)
        settings (types/field-load parser 12)
        data (primitive/load (primitive/field parser data))
        lenient (types/field-load parser 6)]
    (generated/internal-init parser)
    (types/field-store! parser 1 parser-type)
    (types/field-store! parser 12 settings)
    (primitive/store! (primitive/field parser data) data)
    (types/field-store! parser 6 lenient)
    0))

;; Feed one arbitrary input chunk. The parser retains only state and callback
;; positions; callers retain ownership of input bytes for the duration of calls.
(defn execute [(parser (ptr Parser)) (input (slice u8))] (-> i64)
  (generated/internal-execute parser (slice/slice-data input) (slice/slice-len input)))

(defn finish [(parser (ptr Parser))] (-> i64)
  (if (primitive/icmp-ne (types/field-load parser 0) 0)
      0
      (case (types/field-load parser 8)
        FINISH_SAFE_WITH_CB
          (let [settings (primitive/cast (ptr Settings)
                           (primitive/load (primitive/field parser settings)))
                err (types/invoke-external parser 12
                      (primitive/cast (ptr u8) 0) (primitive/cast (ptr u8) 0) 0)]
            (if (primitive/icmp-ne err HPE_OK) err HPE_OK))
        FINISH_SAFE HPE_OK
        FINISH_UNSAFE
          (do (primitive/store! (primitive/field parser reason) "Invalid EOF state")
              HPE_INVALID_EOF_STATE)
        HPE_INVALID_EOF_STATE)))

(defn pause [(parser (ptr Parser))] (-> i64)
  (if (primitive/icmp-eq (primitive/load (primitive/field parser error)) HPE_OK)
      (do (primitive/store! (primitive/field parser error) HPE_PAUSED)
          (primitive/store! (primitive/field parser reason) "Paused") 0)
      0))
(defn resume [(parser (ptr Parser))] (-> i64)
  (if (primitive/icmp-eq (primitive/load (primitive/field parser error)) HPE_PAUSED)
      (primitive/store! (primitive/field parser error) HPE_OK)
      0))
(defn resume-after-upgrade [(parser (ptr Parser))] (-> i64)
  (if (primitive/icmp-eq (primitive/load (primitive/field parser error)) HPE_PAUSED_UPGRADE)
      (primitive/store! (primitive/field parser error) HPE_OK)
      0))

(defn get-type [(p (ptr Parser))] (-> i64) (types/field-load p 1))
(defn get-http-major [(p (ptr Parser))] (-> i64) (types/field-load p 3))
(defn get-http-minor [(p (ptr Parser))] (-> i64) (types/field-load p 4))
(defn get-method [(p (ptr Parser))] (-> i64) (types/field-load p 2))
(defn get-status-code [(p (ptr Parser))] (-> i64) (types/field-load p 10))
(defn get-upgrade [(p (ptr Parser))] (-> i64) (types/field-load p 7))
(defn get-errno [(p (ptr Parser))] (-> i64)
  (primitive/load (primitive/field p error)))
(defn get-error-reason [(p (ptr Parser))] (-> (slice u8))
  (primitive/load (primitive/field p reason)))
(defn get-error-pos [(p (ptr Parser))] (-> (ptr u8))
  (primitive/load (primitive/field p error-pos)))
(defn set-error-reason! [(p (ptr Parser)) (reason (slice u8))] (-> i64)
  (primitive/store! (primitive/field p reason) reason)
  0)
(defn message-needs-eof? [(p (ptr Parser))] (-> bool) (types/message-needs-eof? p))
(defn should-keep-alive? [(p (ptr Parser))] (-> bool) (types/should-keep-alive? p))

(defn set-lenient-bit! [(p (ptr Parser)) (bit i64) (enabled bool)] (-> i64)
  (types/field-store! p 6
    (if enabled
        (primitive/ior (types/field-load p 6) bit)
        (primitive/iand (types/field-load p 6) (primitive/ixor bit -1)))))
(defn set-lenient-headers! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_HEADERS v))
(defn set-lenient-chunked-length! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_CHUNKED_LENGTH v))
(defn set-lenient-keep-alive! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_KEEP_ALIVE v))
(defn set-lenient-transfer-encoding! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_TRANSFER_ENCODING v))
(defn set-lenient-version! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_VERSION v))
(defn set-lenient-data-after-close! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_DATA_AFTER_CLOSE v))
(defn set-lenient-optional-lf-after-cr! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_OPTIONAL_LF_AFTER_CR v))
(defn set-lenient-optional-crlf-after-chunk! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_OPTIONAL_CRLF_AFTER_CHUNK v))
(defn set-lenient-optional-cr-before-lf! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_OPTIONAL_CR_BEFORE_LF v))
(defn set-lenient-spaces-after-chunk-size! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_SPACES_AFTER_CHUNK_SIZE v))
(defn set-lenient-header-value-relaxed! [(p (ptr Parser)) (v bool)] (-> i64) (set-lenient-bit! p LENIENT_HEADER_VALUE_RELAXED v))

; Callback slots follow Settings declaration order. These two typed setters
; preserve fnptr checking at the public boundary while Settings stores erased
; code pointers so null callbacks remain representable.
(defn set-simple-callback! [(settings (ptr Settings)) (slot i64)
                            (callback (fnptr c [(ptr Parser)] i64))] (-> i64)
  (let [raw (primitive/cast (ptr i8) callback)]
    (case slot
      0 (primitive/store! (primitive/field settings on-message-begin) raw)
      10 (primitive/store! (primitive/field settings on-headers-complete) raw)
      12 (primitive/store! (primitive/field settings on-message-complete) raw)
      13 (primitive/store! (primitive/field settings on-protocol-complete) raw)
      14 (primitive/store! (primitive/field settings on-url-complete) raw)
      15 (primitive/store! (primitive/field settings on-status-complete) raw)
      16 (primitive/store! (primitive/field settings on-method-complete) raw)
      17 (primitive/store! (primitive/field settings on-version-complete) raw)
      18 (primitive/store! (primitive/field settings on-header-field-complete) raw)
      19 (primitive/store! (primitive/field settings on-header-value-complete) raw)
      20 (primitive/store! (primitive/field settings on-chunk-extension-name-complete) raw)
      21 (primitive/store! (primitive/field settings on-chunk-extension-value-complete) raw)
      22 (primitive/store! (primitive/field settings on-chunk-header) raw)
      23 (primitive/store! (primitive/field settings on-chunk-complete) raw)
      24 (primitive/store! (primitive/field settings on-reset) raw)
      0))
  0)

(defn set-span-callback! [(settings (ptr Settings)) (slot i64)
                          (callback (fnptr c [(ptr Parser) (ptr u8) i64] i64))] (-> i64)
  (let [raw (primitive/cast (ptr i8) callback)]
    (case slot
      1 (primitive/store! (primitive/field settings on-protocol) raw)
      2 (primitive/store! (primitive/field settings on-url) raw)
      3 (primitive/store! (primitive/field settings on-status) raw)
      4 (primitive/store! (primitive/field settings on-method) raw)
      5 (primitive/store! (primitive/field settings on-version) raw)
      6 (primitive/store! (primitive/field settings on-header-field) raw)
      7 (primitive/store! (primitive/field settings on-header-value) raw)
      8 (primitive/store! (primitive/field settings on-chunk-extension-name) raw)
      9 (primitive/store! (primitive/field settings on-chunk-extension-value) raw)
      11 (primitive/store! (primitive/field settings on-body) raw)
      0))
  0)
