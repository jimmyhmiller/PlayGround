(module coil.derive)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
; Type-directed code as a LIBRARY — `(derive-eq T)` / `(derive-hash T)` /
; `(derive-keyops T)` generate a structural `T-eq` / `T-hash` and a HashMap
; `T-keyops` for a struct by reflecting its fields at macro expansion
; (struct-fields / type-kind). This is the prime directive made true for the
; type-directed half of the language: NO compiler `derive` keyword, NO
; hand-written per-type boilerplate — just macros over the reflection builtins.
;
;   (import "src/stdlib/derive.coil" :use *)
;   (defstruct Point [(x i64) (y i64)])
;   (derive-eq Point) (derive-hash Point) (derive-keyops Point)
;   ; => Point-eq / Point-hash / Point-keyops, usable as a real HashMap key
;

(import "hashmap.coil" :use *)   ; KeyOps — for (derive-keyops T)
; v1 field-type support (a HARD ERROR otherwise — never silently wrong):
;   derive-eq:   integers/bools/floats + nested structs (recurse — derive first).
;   derive-hash: integers/bools + nested structs (floats rejected — bit-hashing is
;                lossy; write hash by hand).
; sum/slice/pointer/compound fields are rejected by both — write the op by hand.

; ---- shared field reflection helpers (Stage-3, over a type given as Code) ----
; kind tags: 0=int 1=float 2=bool 3=struct 4=sum 5=ptr 6=array 7=slice 8=other

; ---- derive-eq (standalone T-eq function) ----------------------------------
(defn derive--field-eq [(T Code) (a Code) (b Code) (i i64)] (-> Code)
  (let [fname (primitive/code-field-name T i)
        kind  (primitive/code-field-kind T i)
        pa    `(primitive/field ~a ~fname)
        pb    `(primitive/field ~b ~fname)]
    (if (primitive/icmp-eq kind 3) `(~(primitive/code-symbol (primitive/code-field-type T i) "-eq") ~pa ~pb)  ; nested struct: recurse
      (if (primitive/icmp-eq kind 4) (primitive/error "derive-eq: sum fields unsupported in v1; write eq by hand")
        (if (primitive/icmp-eq kind 1) `(primitive/fcmp-eq (primitive/load ~pa) (primitive/load ~pb))                   ; float
          `(primitive/icmp-eq (primitive/load ~pa) (primitive/load ~pb)))))))                                 ; int/bool

(defn derive--eq-and [(T Code) (a Code) (b Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-eq i n) `true
    (let [this (derive--field-eq T a b i)]
      (if (primitive/icmp-eq (primitive/iadd i 1) n) this
        `(and ~this ~(derive--eq-and T a b (primitive/iadd i 1) n))))))

;; Emits BOTH the standalone `T-eq` free function AND an `(impl Eq T)` that delegates to
;; it — so a `(derive-eq T)` struct immediately works with `=`, `case`, and as a HashMap
;; key (all of which dispatch through the `Eq` trait), not only the named `T-eq`. The
;; structural comparison is defined ONCE (int `T-eq`); the impl is a one-line delegate.
;; (Equivalent to also writing `(derive Eq T)` — do not write both, or the impl duplicates.)
(defn derive-eq [(tname Code)] (-> Code)
  `(do
     (defn ~(primitive/code-symbol tname "-eq") [(a ~tname) (b ~tname)] (-> bool)
       ~(derive--eq-and tname `a `b 0 (primitive/code-field-count tname)))
     (impl Eq ~tname
       (= [(a ~tname) (b ~tname)] (-> bool)
         (~(primitive/code-symbol tname "-eq") a b)))))

; ---- derive-hash (FNV-1a over the fields) ----------------------------------
(defn derive--field-hash [(T Code) (x Code) (i i64)] (-> Code)
  (let [fname (primitive/code-field-name T i)
        kind  (primitive/code-field-kind T i)
        p     `(primitive/field ~x ~fname)]
    (if (primitive/icmp-eq kind 3) `(~(primitive/code-symbol (primitive/code-field-type T i) "-hash") ~p)     ; nested struct: recurse
      (if (primitive/icmp-eq kind 4) (primitive/error "derive-hash: sum fields unsupported in v1; write hash by hand")
        (if (primitive/icmp-eq kind 1) (primitive/error "derive-hash: float fields unsupported (bit-hashing is lossy); write hash by hand")
          `(primitive/load ~p))))))                                                       ; int/bool

(defn derive--hash-steps [(T Code) (x Code) (h Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-eq i n) `()
    (let [fh (derive--field-hash T x i)]
      `((primitive/store! ~h (primitive/imul (primitive/ixor (primitive/load ~h) ~fh) 1099511628211)) ~@(derive--hash-steps T x h (primitive/iadd i 1) n)))))

(defn derive-hash [(tname Code)] (-> Code)
  `(defn ~(primitive/code-symbol tname "-hash") [(x ~tname)] (-> i64)
     (let [(mut h) -3750763034362895579]
       ~@(derive--hash-steps tname `x `h 0 (primitive/code-field-count tname))
       (primitive/load h))))

; ---- derive (generate a TRAIT impl) ----------------------------------------
; ---- generic targets: (derive Eq (Box T)) ----------------------------------
;; `(Box T)` is a LIST whose head is the type and whose rest are its type params.
;; Deriving over one emits a generic impl carrying the derived trait as a bound on each
;; param — mechanically the hand-written `(impl [(T Eq)] Eq (Box T) …)`, which already
;; worked. Without the params the impl mentioned an unbound `T` and blew up with a
;; leaked mangled name ('coil.core.Eq$Box<T>$=' param 'a': unknown type 'T').
(defn derive--tparams [(tname Code) (trait-name Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    `((~(primitive/code-nth tname i) ~trait-name) ~@(derive--tparams tname trait-name (primitive/iadd i 1) n))))

;; is this field's type one of the target's type params (the `v : T` in `(Box T)`)?
;; Such a field must compare through the trait — the bound we emit is what guarantees
;; it — not through icmp-eq, which would be nonsense for a T that turns out to be a struct.
(defn derive--tparam-field? [(tname Code) (fty Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n) false
    (if (primitive/code-eq fty (primitive/code-nth tname i)) true
      (derive--tparam-field? tname fty (primitive/iadd i 1) n))))
(defn derive--generic-field? [(tname Code) (fty Code)] (-> bool)
  (if (primitive/code-list? tname) (derive--tparam-field? tname fty 1 (primitive/code-count tname)) false))

(defn derive--teq-field [(T Code) (a Code) (b Code) (i i64)] (-> Code)
  (let [fname (primitive/code-field-name T i)
        kind  (primitive/code-field-kind T i)
        pa    `(primitive/field ~a ~fname)
        pb    `(primitive/field ~b ~fname)]
    (if (derive--generic-field? T (primitive/code-field-type T i)) `(= ~pa ~pb)           ; T: Eq, via the bound
      (if (primitive/icmp-eq kind 3) `(= ~pa ~pb)                                         ; nested: trait =
        (if (primitive/icmp-eq kind 4) (primitive/error "derive Eq: sum fields unsupported; impl by hand")
          (if (primitive/icmp-eq kind 1) `(primitive/fcmp-eq (primitive/load ~pa) (primitive/load ~pb))
            `(primitive/icmp-eq (primitive/load ~pa) (primitive/load ~pb))))))))

(defn derive--teq-and [(T Code) (a Code) (b Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-eq i n) `true
    (let [this (derive--teq-field T a b i)]
      (if (primitive/icmp-eq (primitive/iadd i 1) n) this
        `(and ~this ~(derive--teq-and T a b (primitive/iadd i 1) n))))))

(defn derive--thash-field [(T Code) (x Code) (i i64)] (-> Code)
  (let [fname (primitive/code-field-name T i)
        kind  (primitive/code-field-kind T i)
        p     `(primitive/field ~x ~fname)]
    (if (derive--generic-field? T (primitive/code-field-type T i)) `(hash ~p)              ; T: Hash, via the bound
      (if (primitive/icmp-eq kind 3) `(hash ~p)                                           ; nested: trait hash
        (if (primitive/icmp-eq kind 4) (primitive/error "derive Hash: sum fields unsupported; impl by hand")
          (if (primitive/icmp-eq kind 1) (primitive/error "derive Hash: float fields unsupported (bit-hashing is lossy); impl by hand")
            `(primitive/load ~p)))))))

(defn derive--thash-steps [(T Code) (x Code) (h Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-eq i n) `()
    (let [fh (derive--thash-field T x i)]
      `((primitive/store! ~h (primitive/imul (primitive/ixor (primitive/load ~h) ~fh) 1099511628211)) ~@(derive--thash-steps T x h (primitive/iadd i 1) n)))))

(defn derive [(trait-name Code) (tname Code)] (-> Code)
  (if (primitive/code-eq trait-name `Eq)
      (if (primitive/code-list? tname)
          `(impl [~@(derive--tparams tname trait-name 1 (primitive/code-count tname))] Eq ~tname
             (= [(a ~tname) (b ~tname)] (-> bool)
               ~(derive--teq-and tname `a `b 0 (primitive/code-field-count tname))))
        `(impl Eq ~tname
           (= [(a ~tname) (b ~tname)] (-> bool)
             ~(derive--teq-and tname `a `b 0 (primitive/code-field-count tname)))))
    (if (primitive/code-eq trait-name `Hash)
      (if (primitive/code-list? tname)
          `(impl [~@(derive--tparams tname trait-name 1 (primitive/code-count tname))] Hash ~tname
             (hash [(x ~tname)] (-> i64)
               (let [(mut h) -3750763034362895579]
                 ~@(derive--thash-steps tname `x `h 0 (primitive/code-field-count tname))
                 (primitive/load h))))
        `(impl Hash ~tname
           (hash [(x ~tname)] (-> i64)
             (let [(mut h) -3750763034362895579]
               ~@(derive--thash-steps tname `x `h 0 (primitive/code-field-count tname))
               (primitive/load h)))))
      (primitive/error "derive: only Eq and Hash are supported (impl other traits by hand)"))))

; ---- derive-keyops (a HashMap key from derived eq + hash) -------------------
(defn derive-keyops [(tname Code)] (-> Code)
  `(do
     (defn ~(primitive/code-symbol tname "-keyhash") [(slot (ptr i8)) (n i64)] (-> i64)
       (~(primitive/code-symbol tname "-hash") (primitive/cast (ptr ~tname) slot)))
     (defn ~(primitive/code-symbol tname "-keyeq") [(ka (ptr i8)) (kb (ptr i8)) (n i64)] (-> bool)
       (~(primitive/code-symbol tname "-eq") (primitive/cast (ptr ~tname) ka) (primitive/cast (ptr ~tname) kb)))
     (defn ~(primitive/code-symbol tname "-keyops") [] (-> (ptr KeyOps))
       (let [o (alloc/static KeyOps)]
         (primitive/store! (primitive/field o hash) (primitive/fnptr-of ~(primitive/code-symbol tname "-keyhash")))
         (primitive/store! (primitive/field o eq)   (primitive/fnptr-of ~(primitive/code-symbol tname "-keyeq")))
         (primitive/store! (primitive/field o size) (primitive/sizeof ~tname))
         o))))
