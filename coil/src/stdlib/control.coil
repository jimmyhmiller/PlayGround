(module coil.control)
(import "primitive.coil" :as primitive)
; `Option` (None | Some) is the iterator protocol's `next` return type; importing
; it here means `for-in (iter …)` works without the user importing result too —
; macro hygiene qualifies the None/Some in the template to result's namespace.
(import "result.coil" :use *)
; `case` defaults to the `Eq` trait, which lives in the auto-loaded prelude — no
; import needed for it.
; Control-flow sugar — written entirely in Coil macros. `(import "src/stdlib/control.coil")`
; then use `when`/`unless`/`|>`/`inline-for`/`for-in`. `cond` lives directly in
; `coil.core`, so it is available even without this module. Nothing in the compiler
; knows about any of these; they expand to `if`/`do`/`let` over the core.
;
; `while` and `for` are MACROS over the core `loop`/`break`/`continue` primitive
; (the 3 structured-control-flow forms in the compiler) — proof that the loop
; *features* live in userland, not the compiler. `inline-for` is the separate
; comptime-UNROLLED loop (bounds known at expand time), a pure macro needing no
; primitive at all.

; ---- conditionals ---------------------------------------------------------
;; `(when c body...)` — evaluate body (yielding its last form) iff c is true,
;; else 0. `(unless c body...)` is the negation.
;; Stage-3 macros: ordinary `[Code…] -> Code` functions, expanded inline.
(defn when [(c Code) & (body Code)] (-> Code)
  `(if ~c (do ~@body) 0))
(defn unless [(c Code) & (body Code)] (-> Code)
  `(if ~c 0 (do ~@body)))

;; `(case x k1 e1 k2 e2 … [default])` — evaluate `x` ONCE, then pick the first `ei`
;; whose `(= x ki)` holds, using the `Eq` trait (auto-loaded prelude); a lone trailing
;; clause is the default (0 if none). Flat `key body` pairs, Clojure-style. The keys'
;; type must implement `Eq` — pass a non-`Eq` value and you get
;; "'T' does not implement 'Eq'". Primitives (i64/bool), strings ((slice u8), via
;; src/stdlib/str.coil), and any struct given an `Eq` impl by `(derive Eq T)` or `(derive-eq T)`
;; (src/stdlib/derive.coil) work out of the box; for a custom comparison (e.g. `sexp-sym-is` on
;; a non-`Eq` type) use `case-by`.
(defn case-arms [(v Code) (eq Code) (clauses Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count clauses) 0)
      `0
      (if (primitive/icmp-eq (primitive/code-count clauses) 1)
          (primitive/code-nth clauses 0)  ; lone trailing = default
          `(if (~eq ~v ~(primitive/code-nth clauses 0))
               ~(primitive/code-nth clauses 1)
               ~(case-arms v eq (primitive/code-rest (primitive/code-rest clauses)))))))
(defn case [(x Code) & (clauses Code)] (-> Code)
  (let [v (primitive/gensym)] `(let [~v ~x] ~(case-arms v `= clauses))))

;; `(case-by x eq? k1 e1 … [default])` — like `case`, but with an explicit 2-arg
;; equality `eq?` instead of the `Eq` trait. For keys whose type isn't `Eq`, or a
;; domain predicate: e.g. `(case-by head sexp-sym-is "if" … default)`.
(defn case-by [(x Code) (eq Code) & (clauses Code)] (-> Code)
  (let [v (primitive/gensym)] `(let [~v ~x] ~(case-arms v eq clauses))))

; NOTE on `->`/`->>` (thread macros): deliberately NOT provided. `->` collides
; with Coil's reserved `(-> :type)` return-type marker — the macro expander runs
; before parsing and is position-insensitive, so a `->` macro would clobber every
; defn/extern return type. A threading macro would need a non-reserved name.

; ---- runtime loops (macros over the loop/break/continue primitive) --------
;; `(while cond body...)` — repeat body while cond is true. Desugars to a `loop`
;; that `break`s when cond goes false. `continue` re-checks cond (correct).
(defn while [(c Code) & (body Code)] (-> Code)
  `(loop (if ~c (do ~@body) (break))))

;; `(for [i LO HI] body...)` — count i from LO to HI-1 (runtime bounds), binding i
;; as an immutable value in body each iteration. The hidden counter is incremented
;; at the TOP of the loop (starting LO-1), so a `continue` in body still advances
;; the counter — matching C `for` semantics, no skipped increment.
;;
;; `(for x COLL body...)` — when the binding is a bare SYMBOL (not a `[i LO HI]`
;; vector), `for` iterates a collection: `COLL` is the collection form
;; (`(iter coll)` / `(int coll)` / `(range …)` / `(over …)`), delegating to `for-in`.
;; This is the ONE surface the decision asks for: `(for x (iter coll))`.
(defn for [(binding Code) & (body Code)] (-> Code)
  (if (primitive/code-sym? binding)
      `(for-in [~binding ~(primitive/code-nth body 0)] ~@(primitive/code-rest body))
      (if (not (primitive/icmp-eq (primitive/code-count binding) 3))
          (primitive/error "for: binding must be [i LO HI], or (for x COLL …) for a collection")
          (let [i (primitive/code-nth binding 0)
                lo (primitive/code-nth binding 1)
                hi (primitive/code-nth binding 2)
                idx (primitive/gensym)]
            `(let [(mut ~idx) (primitive/isub ~lo 1)]
               (loop (primitive/store! ~idx (primitive/iadd (primitive/load ~idx) 1))
                 (if (primitive/icmp-lt (primitive/load ~idx) ~hi)
                     (let [~i (primitive/load ~idx)] ~@body)
                     (break))))))))

;; `(for-in [x COLL] body...)` — iterate a collection, binding x to each element.
;; A macro over `for`/`loop`, dispatching on the collection FORM (the expander has
;; no types):
;;   (range LO HI)  — the ints LO..HI-1
;;   (over ARR LEN) — the elements of a fixed array ARR of length LEN
;;   (iter COLL) / (int COLL) — the coil.core Iterator protocol: `(iter COLL)` mints
;;     an iterator over any `Iterable` (slice/string, ArrayList, HashMap — and any
;;     type you `(impl Iterable …)`), and `(next it)` yields each element. This is
;;     the ONE protocol that replaces the old per-collection `slice-for`/`al-for`/
;;     `hm-for` macros; `(int map)` now iterates the map's KEYS correctly instead of
;;     `get`-by-index garbage (std-4). `iter` and `in` are synonyms here.
(defn for-in [(binding Code) & (body Code)] (-> Code)
  (if (not (primitive/icmp-eq (primitive/code-count binding) 2))
      (primitive/error "for-in: binding must be [x COLL]")
      (let [x (primitive/code-nth binding 0)
            coll (primitive/code-nth binding 1)]
        (if (not (primitive/code-list? coll))
            (primitive/error "for-in: COLL must be a form, e.g. (iter coll), (int coll), (range lo hi), or (over arr len)")
            (let [h (primitive/code-nth coll 0)]
              (if (primitive/code-eq h `range)
                  `(for [~x ~(primitive/code-nth coll 1) ~(primitive/code-nth coll 2)] ~@body)
                  (if (primitive/code-eq h `over)
                      (let [arr (primitive/code-nth coll 1)
                            len (primitive/code-nth coll 2)
                            i (primitive/gensym)]
                        `(for [~i 0 ~len]
                           (let [~x (primitive/load (primitive/index ~arr ~i))] ~@body)))
                      ; (iter COLL) / (int COLL): drive the coil.core Iterator protocol. `(iter COLL)`
                      ; produces the iterator (Iterable::iter); `(next it)` (Iterator::next) yields
                      ; each Item, `(None)` ends the loop. Uniform across every Iterable type.
                      (if (or (primitive/code-eq h `iter) (primitive/code-eq h `in))
                          (let [it (primitive/gensym)]
                            `(let [(mut ~it) (iter ~(primitive/code-nth coll 1))]
                               (loop (match (next (mut ~it))
                                       (None [] (break))
                                       (Some [~x] ~@body)))))
                          (primitive/error "for-in: unsupported collection; use (iter coll), (int coll), (range lo hi), or (over arr len)")))))))))

; ---- threading ------------------------------------------------------------
;; Spelled `|>`/`|>>` (F#/Elixir/OCaml) rather than Clojure's `->`/`->>`: `->`
;; collides with Coil's reserved `(-> :type)` return marker (the pre-parse,
;; position-blind expander would otherwise clobber every defn/extern return type).
;; `|>` is unreserved, so it's a clean macro.
;;
;; `(|> x (f a) g)` => `(g (f x a))` — thread x as the FIRST argument.
(defn thread-first [(x Code) (forms Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count forms) 0)
      x
      (thread-first (let [form (primitive/code-nth forms 0)]
                      (if (primitive/code-list? form)
                          `(~(primitive/code-nth form 0) ~x ~@(primitive/code-rest form))  ; (f a) → (f x a)
                          `(~form ~x)))  ; g → (g x)
                    (primitive/code-rest forms))))
(defn |> [(x Code) & (forms Code)] (-> Code)
  (thread-first x forms))

;; `(|>> x (f a) g)` => `(g (f a x))` — thread x as the LAST argument.
(defn thread-last [(x Code) (forms Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count forms) 0)
      x
      (thread-last (let [form (primitive/code-nth forms 0)]
                     (if (primitive/code-list? form)
                         `(~@form ~x)  ; (f a) → (f a x)
                         `(~form ~x)))
                   (primitive/code-rest forms))))
(defn |>> [(x Code) & (forms Code)] (-> Code)
  (thread-last x forms))

; ---- labeled block + early return (macros over loop/break) ----------------
;; `(block :b body...)` evaluates body and yields its value; `(return-from :b v)`
;; anywhere inside exits the block early with v. Implemented as a single-iteration
;; `loop` whose value is delivered by `break` — so EARLY RETURN is itself a macro,
;; needing no core support. This is the substrate `defer`/scope guards build on.
;;
;; `(block :b e...)` => `(loop :b (break :b (do e...)))`: the inner `do` runs to a
;; value then breaks; an early `(return-from :b v)` => `(break :b v)` short-circuits.
(defn block [(label Code) & (body Code)] (-> Code)
  `(loop ~label (break ~label (do ~@body))))

(defn return-from [(label Code) (v Code)] (-> Code)
  `(break ~label ~v))

; ---- defer / scope guards (macros over block + break) ----------------------
; `(scope :s body...)` runs body, then runs every `(defer cleanup)` form found
; as a DIRECT child of the scope, in REVERSE (LIFO) order — on BOTH normal exit
; and `(return-from :s v)` early exit (both route through the scope's `block :s`).
; Cleanups are emitted inline (they see the scope's lexical bindings).
;
; NO-SILENT-SKIP guarantee: a `break`/`continue` in the body that would escape the
; scope PAST its cleanups is a COMPILE ERROR, never a skipped cleanup. Allowed
; control: break/continue targeting a loop nested *within* the body, and
; `(return-from :s v)` / `(break :s v)` to exit the scope itself. Disallowed
; (hard error): an unlabeled break/continue at scope level, or a labeled one
; targeting an enclosing loop outside the scope.
;
; LIMITATIONS (documented, not hidden): defers are LEXICAL/static (Zig-style, not
; Go's runtime list) and must be DIRECT forms of the scope body (a `(defer …)`
; nested inside an `if`/loop hard-errors). `(continue :s)` is rejected.

;; All Stage-3 comptime helpers over Code. `scope-escape` aborts via `(primitive/error …)` at
;; the point it finds an escaping transfer (rather than returning a string), since a
;; statically-typed helper can't return "string-or-false".
(defn is-control? [(h Code)] (-> bool)
  (if (primitive/code-eq h `break) true (if (primitive/code-eq h `continue) true (primitive/code-eq h `return-from))))

(defn loop-introducer? [(h Code)] (-> bool)
  (if (primitive/code-eq h `loop)
      true
      (if (primitive/code-eq h `while)
          true
          (if (primitive/code-eq h `for)
              true
              (if (primitive/code-eq h `block) true (primitive/code-eq h `scope))))))

;; the :label of a (break …)/(continue …)/(return-from …) form, or `no-label
(defn control-label [(form Code)] (-> Code)
  (if (primitive/icmp-lt 1 (primitive/code-count form))
      (let [a (primitive/code-nth form 1)] (if (primitive/code-keyword? a) a `no-label))
      `no-label))

(defn label-member? [(x Code) (xs Code) (i i64)] (-> bool)
  (if (not (primitive/icmp-lt i (primitive/code-count xs)))
      false
      (if (primitive/code-eq x (primitive/code-nth xs i)) true (label-member? x xs (primitive/iadd i 1)))))

;; prepend a loop form's own label (if any) to the in-scope label list
(defn escape-labels [(form Code) (labels Code)] (-> Code)
  (if (primitive/icmp-lt 1 (primitive/code-count form))
      (let [a (primitive/code-nth form 1)] (if (primitive/code-keyword? a) `(~a ~@labels) labels))
      labels))

(defn is-defer? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (primitive/icmp-lt 0 (primitive/code-count f)) (primitive/code-eq (primitive/code-nth f 0) `defer) false)
      false))

;; Walk a form; (primitive/error …) if it has a scope-escaping break/continue, else return 0.
;; `depth` = enclosing in-body loops; `labels` = their labels; `slabel` = the scope's.
(defn scope-escape [(form Code) (depth i64) (labels Code) (slabel Code)] (-> i64)
  (if (not (primitive/code-list? form))
      0
      (if (not (primitive/icmp-lt 0 (primitive/code-count form)))
          0
          (let [h (primitive/code-nth form 0)]
            (if (is-control? h)
                (let [lab (control-label form)]
                  (if (not (primitive/code-eq lab `no-label))
                      (if (label-member? lab labels 0)
                          0
                          (if (primitive/code-eq lab slabel)
                              (if (primitive/code-eq h `continue)
                                  (primitive/error "scope: (continue) cannot target the scope label; use return-from to exit")
                                  0)
                              (primitive/error "scope: a labeled break/continue escapes the (scope ...) past its defers")))
                      (if (primitive/icmp-lt 0 depth)
                          0
                          (primitive/error "scope: an unlabeled break/continue cannot exit a (scope ...); use (return-from :label v)"))))
                (if (loop-introducer? h)
                    (scope-escape-list (primitive/code-rest form) (primitive/iadd depth 1) (escape-labels form labels) slabel)
                    (scope-escape-list (primitive/code-rest form) depth labels slabel)))))))

(defn scope-escape-list [(forms Code) (depth i64) (labels Code) (slabel Code)] (-> i64)
  (if (not (primitive/icmp-lt 0 (primitive/code-count forms)))
      0
      (let [chk (scope-escape (primitive/code-nth forms 0) depth labels slabel)]
        (scope-escape-list (primitive/code-rest forms) depth labels slabel))))

;; cleanup exprs (defer bodies) in REVERSE (LIFO) order
(defn scope-cleanups [(body Code) (i i64) (acc Code)] (-> Code)
  (if (not (primitive/icmp-lt i (primitive/code-count body)))
      acc
      (let [f (primitive/code-nth body i)]
        (scope-cleanups body
                        (primitive/iadd i 1)
                        (if (is-defer? f) `(~(primitive/code-nth f 1) ~@acc) acc)))))

;; the non-defer forms, in order
(defn scope-mains [(body Code) (i i64) (acc Code)] (-> Code)
  (if (not (primitive/icmp-lt i (primitive/code-count body)))
      acc
      (let [f (primitive/code-nth body i)]
        (scope-mains body
                     (primitive/iadd i 1)
                     (if (is-defer? f) acc `(~@acc ~f))))))

(defn scope [(label Code) & (body Code)] (-> Code)
  (if (not (primitive/code-keyword? label))
      (primitive/error "scope: first argument must be a :label, e.g. (scope :s body...)")
      (let [chk (scope-escape-list body 0 `() label)
            cleanups (scope-cleanups body 0 `())
            mains (scope-mains body 0 `())
            r (primitive/gensym)]
        `(let [~r (block ~label ~@mains)]
           ~@cleanups
           ~r))))

;; A bare `(defer …)` is only meaningful as a direct child of `(scope …)`, where
;; `scope` extracts it before this macro runs. Reaching this expansion means it
;; was used outside a scope (or nested too deep) — hard-error, never a no-op.
(defn defer [& (_ Code)] (-> Code)
  (primitive/error "defer: (defer expr) is only valid as a DIRECT form inside (scope :s ...)"))

; ---- comptime-unrolled loop ----------------------------------------------
;; `(inline-for [i LO HI] body...)` — fully unrolls `body` for i = LO..HI-1,
;; with i a compile-time literal each iteration (zero runtime loop overhead).
;; LO/HI MUST be literal integers (known at expansion); for runtime bounds use
;; `for`.
(defn inline-for-iters [(i Code) (lo i64) (hi i64) (body Code)] (-> Code)
  (if (primitive/icmp-lt lo hi)
      `((let [~i ~lo] ~@body) ~@(inline-for-iters i (primitive/iadd lo 1) hi body))
      `()))
(defn inline-for [(binding Code) & (body Code)] (-> Code)
  (if (not (primitive/icmp-eq (primitive/code-count binding) 3))
      (primitive/error "inline-for: binding must be [i LO HI] with literal integer bounds")
      (let [i (primitive/code-nth binding 0)
            lo (primitive/code-int (primitive/code-nth binding 1))
            hi (primitive/code-int (primitive/code-nth binding 2))]
        `(do ~@(inline-for-iters i lo hi body)))))

;; `(all a b c …)` / `(any a b c …)` — variadic boolean AND / OR, folding to the
;; 2-ary core `and`/`or` (short-circuit). `(all)` = true, `(any)` = false; a single
;; argument is returned as-is. (The core `and`/`or` stay 2-ary; these are the
;; n-ary convenience over them.)
(defn all [& (xs Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count xs) 0)
      `true  ; emit the `true` FORM, not a macro bool
      (if (primitive/icmp-eq (primitive/code-count xs) 1)
          (primitive/code-nth xs 0)
          `(and ~(primitive/code-nth xs 0) (all ~@(primitive/code-rest xs))))))
(defn any [& (xs Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count xs) 0)
      `false
      (if (primitive/icmp-eq (primitive/code-count xs) 1)
          (primitive/code-nth xs 0)
          `(or ~(primitive/code-nth xs 0) (any ~@(primitive/code-rest xs))))))
