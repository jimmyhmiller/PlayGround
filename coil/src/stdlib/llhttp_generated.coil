(defn invoke-code [(s (ptr ll/Parser)) (code i64) (p (ptr u8)) (endp (ptr u8)) (matched i64)] (-> i64)
  (case code
    0 (ll/field-load s 11)
    1 (do (ll/field-store! s 8 2) 0)
    2 (ll/invoke-external s 0 p endp matched)
    3 (ll/field-load s 1)
    4 (do (ll/field-store! s 1 1) 0)
    6 (do (ll/field-store! s 2 matched) 0)
    7 (ll/invoke-external s 2 p endp matched)
    8 (if (primitive/icmp-eq (ll/field-load s 2) 5) 1 0)
    10 (do (ll/field-store! s 3 0) 0)
    11 (do (ll/field-store! s 4 9) 0)
    12 (ll/invoke-external s 4 p endp matched)
    14 (do (ll/field-store! s 5 0) 0)
    15 (ll/invoke-external s 6 p endp matched)
    16 (ll/field-load s 5)
    18 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 6) 1) 1) 1 0)
    19 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 6) 1024) 1024) 1 0)
    20 (ll/invoke-external s 8 p endp matched)
    21 (do (ll/field-or! s 9 1) 0)
    22 (do (ll/field-store! s 5 1) 0)
    23 (do (ll/field-or! s 9 2) 0)
    24 (do (ll/field-or! s 9 4) 0)
    25 (do (ll/field-or! s 9 8) 0)
    26 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 6) 256) 256) 1 0)
    27 (do (ll/field-store! s 5 6) 0)
    28 (do (ll/field-store! s 5 5) 0)
    29 (do (ll/field-store! s 5 7) 0)
    30 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 9) 32) 32) 1 0)
    31 (do (ll/field-or! s 9 32) 0)
    32 (ll/field-mul-add! s 0 10 -1 false matched)
    33 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 9) 8) 8) 1 0)
    34 (do (ll/field-or! s 9 512) 0)
    35 (do (ll/field-and! s 9 -9) 0)
    36 (do (ll/field-store! s 5 8) 0)
    37 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 6) 8) 8) 1 0)
    38 (do (ll/field-or! s 9 16) 0)
    39 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 9) 512) 512) 1 0)
    40 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 6) 2) 2) 1 0)
    41 (do (ll/field-store! s 5 matched) 0)
    42 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 9) 128) 128) 1 0)
    43 (ll/invoke-external s 9 p endp matched)
    44 (ll/invoke-external s 10 p endp matched)
    45 (ll/invoke-external s 11 p endp matched)
    46 (ll/invoke-external s 12 p endp matched)
    47 (ll/invoke-external s 13 p endp matched)
    48 (do (ll/field-store! s 8 0) 0)
    49 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 6) 4) 4) 1 0)
    50 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 6) 32) 32) 1 0)
    51 (do (ll/field-store! s 11 1) 0)
    52 (do (ll/field-store! s 0 0) 0)
    53 (ll/field-mul-add! s 0 16 -1 false matched)
    54 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 6) 512) 512) 1 0)
    55 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 6) 64) 64) 1 0)
    56 (ll/invoke-external s 14 p endp matched)
    57 (if (primitive/icmp-eq (ll/field-load s 0) 0) 1 0)
    58 (do (ll/field-or! s 9 128) 0)
    60 (if (primitive/icmp-eq (primitive/iand (ll/field-load s 6) 128) 128) 1 0)
    61 (ll/invoke-external s 16 p endp matched)
    63 (ll/invoke-external s 18 p endp matched)
    65 (ll/invoke-external s 20 p endp matched)
    66 (if (primitive/icmp-eq (ll/field-load s 7) 1) 1 0)
    67 (do (ll/field-store! s 8 1) 0)
    68 (do (ll/field-or! s 9 64) 0)
    69 (do (ll/field-store! s 7 1) 0)
    71 (ll/invoke-external s 22 p endp matched)
    72 (ll/field-load s 2)
    74 (do (ll/field-store! s 3 matched) 0)
