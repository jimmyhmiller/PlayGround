(module coil.str)
(import "primitive.coil" :as primitive)
; Strings are `(slice u8)` VIEWS (UTF-8 bytes) — see src/stdlib/slice.coil. A `"…"`
; literal is one, borrowing static bytes. These are the content operations over
; that view: equality, hashing, search, and an allocator-aware concatenation.
; Owned, growable strings are `StrBuf` (a library over ArrayList<u8>) at the
; bottom of this file. Nothing here is compiler magic — it is all library over
; the core `(slice u8)` type, the allocator value, and src/stdlib/mem.
;
;   (import "src/stdlib/str.coil" :use *) (import "src/stdlib/slice.coil" :use *)

(import "slice.coil"     :use *)   ; slice-len/data/get, subslice, slice-new
(import "mem.coil"       :use *)   ; mem-eql, mem-copy
(import "result.coil"    :use *)   ; Option/Some/None for find / fallible alloc
(import "alloc.coil" :as alloc     :use *)   ; Allocator, raw-alloc — for concat / StrBuf
(import "arraylist.coil" :use *)   ; ArrayList — owned StrBuf is a library over it
(import "hashmap.coil"   :use *)   ; KeyOps — for str-keyops (string-keyed maps)

; ---- the everyday view operations -----------------------------------------
(defn str-len [(s (slice u8))] (-> i64) (slice-len s))
(defn char-at [(s (slice u8)) (i :i64)] (-> :u8) (slice-get s i))
(defn substr  [(s (slice u8)) (lo :i64) (hi :i64)] (-> (slice u8)) (subslice s lo hi))

; ---- C-string bridge -------------------------------------------------------
;; FFI hands back NUL-terminated `(ptr i8)` strings; the everyday Coil string is a
;; length-carrying `(slice u8)`. These convert between the two. `cstr-len` scans to
;; the terminator (no libc `strlen` extern, so importing this module never collides
;; with io.coil's `strlen` declaration).
(defn cstr-len [(p (ptr i8))] (-> :i64)
  (let [(mut i) 0]
    (loop (if (primitive/icmp-eq (primitive/cast :i64 (primitive/load (primitive/index p (primitive/load i)))) 0) (break)
            (primitive/store! i (primitive/iadd (primitive/load i) 1))))
    (primitive/load i)))
;; A `(slice u8)` VIEW over a C string's bytes (excludes the NUL) — no copy, aliases
;; the C storage.
(defn cstr->str [(p (ptr i8))] (-> (slice u8))
  (slice-new (primitive/cast (ptr u8) p) (cstr-len p)))
;; A freshly-allocated NUL-terminated copy of `s` (what a C API wants). The result
;; owns its `len+1` bytes; free it with the same allocator. Null on OOM (the same
;; descriptive-not-safe contract as `unwrap-ptr`/`box`).
(defn str->cstr [(a (ptr Allocator)) (s (slice u8))] (-> (ptr i8))
  (let [n (slice-len s)
        p (unwrap-ptr [i8] (raw-alloc a (primitive/iadd n 1) 1))]
    (mem-copy [u8] (primitive/cast (ptr u8) p) (slice-data s) n)
    (primitive/store! (primitive/index p n) (primitive/cast i8 0))
    p))

;; Content equality: same length and same bytes.
(defn str-eq [(a (slice u8)) (b (slice u8))] (-> bool)
  (let [la (slice-len a)]
    (if (primitive/icmp-ne la (slice-len b))
        false
        (mem-eql [u8] (slice-data a) (slice-data b) la))))

;; FNV-1a over the bytes (matches src/stdlib/hashmap's bytewise-hash, so a content hash).
(defn str-hash [(s (slice u8))] (-> :i64)
  (let [(mut h) -3750763034362895579    ; FNV-1a offset basis
        (mut i) 0
        n (slice-len s)]
    (loop
      (if (primitive/icmp-ge (primitive/load i) n)
          (break)
          (do (primitive/store! h (primitive/imul (primitive/ixor (primitive/load h) (primitive/cast :i64 (slice-get s (primitive/load i))))
                              1099511628211))
              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load h)))

;; Lexicographic byte comparison: negative if a<b, 0 if equal, positive if a>b.
;; Compares byte-by-byte over the shared prefix, then breaks the tie by length —
;; the ordering `str-eq`/`str-hash` are the equality/hash for, and what the `Ord`
;; impl below (so `<`/`sort` on strings) is built over.
(defn str-cmp [(a (slice u8)) (b (slice u8))] (-> :i64)
  (let [la (slice-len a)
        lb (slice-len b)
        n  (if (primitive/icmp-lt la lb) la lb)
        (mut i) 0
        (mut d) 0]
    (loop
      (if (primitive/icmp-ge (primitive/load i) n)
          (break)
          (let [ca (primitive/cast :i64 (slice-get a (primitive/load i)))
                cb (primitive/cast :i64 (slice-get b (primitive/load i)))]
            (if (primitive/icmp-ne ca cb)
                (do (primitive/store! d (primitive/isub ca cb)) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (if (primitive/icmp-ne (primitive/load d) 0) (primitive/load d) (primitive/isub la lb))))

(defn starts-with [(s (slice u8)) (prefix (slice u8))] (-> bool)
  (let [lp (slice-len prefix)]
    (if (primitive/icmp-gt lp (slice-len s))
        false
        (str-eq (subslice s 0 lp) prefix))))

;; First index of `needle` in `hay`, or `(None)` — tail-recursive (TCO'd to a loop).
(defn str-find-from [(hay (slice u8)) (needle (slice u8)) (i :i64)] (-> (Option :i64))
  (if (primitive/icmp-gt (primitive/iadd i (slice-len needle)) (slice-len hay))
      (None)
      (if (str-eq (subslice hay i (primitive/iadd i (slice-len needle))) needle)
          (Some i)
          (str-find-from hay needle (primitive/iadd i 1)))))
(defn str-find [(hay (slice u8)) (needle (slice u8))] (-> (Option :i64))
  (str-find-from hay needle 0))

; ---- trimming, parsing, splitting ------------------------------------------
;; ASCII whitespace test (space, tab, newline, carriage return, vertical tab, form feed).
(defn str-ws? [(b :u8)] (-> bool)
  (let [c (primitive/cast :i64 b)]
    (any (primitive/icmp-eq c \space) (primitive/icmp-eq c \tab) (primitive/icmp-eq c \newline)
         (primitive/icmp-eq c \return) (primitive/icmp-eq c 11) (primitive/icmp-eq c \formfeed))))

;; A VIEW with leading/trailing ASCII whitespace removed (no copy; shares storage).
(defn str-trim [(s (slice u8))] (-> (slice u8))
  (let [(mut lo) 0
        (mut hi) (slice-len s)]
    (loop (if (and (primitive/icmp-lt (primitive/load lo) (primitive/load hi)) (str-ws? (slice-get s (primitive/load lo))))
              (primitive/store! lo (primitive/iadd (primitive/load lo) 1)) (break)))
    (loop (if (and (primitive/icmp-lt (primitive/load lo) (primitive/load hi)) (str-ws? (slice-get s (primitive/isub (primitive/load hi) 1))))
              (primitive/store! hi (primitive/isub (primitive/load hi) 1)) (break)))
    (subslice s (primitive/load lo) (primitive/load hi))))

;; Parse a base-10 signed integer, `(Some n)` or `(None)` on any non-digit / empty /
;; lone-sign input. No allocation, no overflow check (wraps like the metal `imul`).
(defn str-parse-int [(s (slice u8))] (-> (Option :i64))
  (let [n (slice-len s)]
    (if (primitive/icmp-eq n 0)
        (None)
        (let [neg (primitive/icmp-eq (primitive/cast :i64 (slice-get s 0)) 45)   ; 45 = '-'
              (mut i) (if neg 1 0)
              (mut acc) 0
              (mut ok) (primitive/icmp-lt (if neg 1 0) n)]             ; a lone "-" is invalid
          (loop
            (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (let [c (primitive/cast :i64 (slice-get s (primitive/load i)))]
                  (if (and (primitive/icmp-ge c \0) (primitive/icmp-le c \9))
                      (do (primitive/store! acc (primitive/iadd (primitive/imul (primitive/load acc) 10) (primitive/isub c \0)))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                      (do (primitive/store! ok false) (break))))))
          (if (primitive/load ok)
              (Some (if neg (primitive/isub 0 (primitive/load acc)) (primitive/load acc)))
              (None))))))

;; Split `s` on every (non-overlapping) occurrence of `sep`, returning an
;; `(ArrayList (slice u8))` of the pieces (each a VIEW into `s`). An empty `sep`
;; yields the whole string as one piece. The caller owns the list — `al-free!` it
;; (the piece slices alias `s`, so `s` must outlive them). Allocator-aware.
(defn str-split [(a (ptr Allocator)) (s (slice u8)) (sep (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (al-new [(slice u8)] a)
        sl (slice-len sep)
        n  (slice-len s)]
    (if (primitive/icmp-eq sl 0)
        (do (al-push! (mut out) s) 0)
        (let [(mut start) 0]
          (loop
            (match (str-find (subslice s (primitive/load start) n) sep)
              (None []
                (do (al-push! (mut out) (subslice s (primitive/load start) n)) (break)))
              (Some [rel]
                (let [idx (primitive/iadd (primitive/load start) rel)]
                  (al-push! (mut out) (subslice s (primitive/load start) idx))
                  (primitive/store! start (primitive/iadd idx sl))))))))
    (primitive/load out)))

;; Concatenate into freshly-allocated bytes; `(None)` on OOM. The result owns its
;; buffer (allocated from `a`); free it with the same allocator when done.
(defn str-concat [(a (ptr Allocator)) (x (slice u8)) (y (slice u8))] (-> (Option (slice u8)))
  (let [lx (slice-len x) ly (slice-len y)]
    (match (raw-alloc a (primitive/iadd lx ly) 1)
      (None [] (None))
      (Some [buf]
        (let [p (primitive/cast (ptr u8) buf)]
          (mem-copy [u8] p (slice-data x) lx)
          (mem-copy [u8] (primitive/index p lx) (slice-data y) ly)
          (Some (slice-new p (primitive/iadd lx ly))))))))

; ---- string-keyed HashMap: a KeyOps whose hash/eq read the slice's bytes ----
;; The map stores the (slice u8) key value in its slot; these deref that slot to
;; the fat pointer, then hash/compare the pointed-to CONTENT (not the 16 raw bytes
;; of the fat pointer, which would compare addresses).
(defn str-key-hash [(slot (ptr i8)) (n :i64)] (-> :i64)
  (str-hash (primitive/load (primitive/cast (ptr (slice u8)) slot))))
(defn str-key-eq [(a (ptr i8)) (b (ptr i8)) (n :i64)] (-> bool)
  (str-eq (primitive/load (primitive/cast (ptr (slice u8)) a)) (primitive/load (primitive/cast (ptr (slice u8)) b))))

;; std-3 — take ownership of a string key IN PLACE: read the (borrowed) slice at
;; `slot`, allocate a private copy of its bytes from `a`, and overwrite the slot with
;; a slice VIEW onto that owned copy. An empty key needs no storage (its data pointer
;; is never dereferenced — str-eq/str-hash short-circuit on length 0), so it is left
;; as-is. OOM aborts (the same descriptive-not-safe contract as the rest of src/stdlib/str).
(defn str-key-copy [(a (ptr Allocator)) (slot (ptr i8))] (-> :i64)
  (let [s (primitive/load (primitive/cast (ptr (slice u8)) slot))
        n (slice-len s)]
    (if (primitive/icmp-gt n 0)
        (let [p (primitive/cast (ptr u8) (unwrap-ptr [i8] (raw-alloc a n 1)))]
          (if (primitive/icmp-eq (primitive/cast :i64 p) 0)
              (oom-at c"str-key-copy" n)
              (do (mem-copy [u8] p (slice-data s) n)
                  (primitive/store! (primitive/cast (ptr (slice u8)) slot) (slice-new p n))
                  0)))
        0)
    0))
;; Release an owned string key's bytes. Mirrors str-key-copy: an empty key owns no
;; storage, so it is skipped (never frees the borrowed pointer of a length-0 slice).
(defn str-key-free [(a (ptr Allocator)) (slot (ptr i8))] (-> :i64)
  (let [s (primitive/load (primitive/cast (ptr (slice u8)) slot))
        n (slice-len s)]
    (if (primitive/icmp-gt n 0)
        (raw-free a (primitive/cast (ptr i8) (slice-data s)) n 1)
        0)))

;; The default string KeyOps now OWNS its keys (std-3): every inserted key is copied
;; into the map's allocator and freed on remove/clear/free, so a key never aliases
;; caller storage. This is the safe default — reach for `str-keyops-borrowed` only
;; when you can guarantee the key bytes outlive the map (e.g. static literals).
(defn str-keyops [] (-> (ptr KeyOps))
  (let [o (alloc/static KeyOps)]
    (primitive/store! (primitive/field o hash) (primitive/fnptr-of str-key-hash))
    (primitive/store! (primitive/field o eq)   (primitive/fnptr-of str-key-eq))
    (primitive/store! (primitive/field o size) (primitive/sizeof (slice u8)))
    (primitive/store! (primitive/field o copy) (primitive/fnptr-of str-key-copy))
    (primitive/store! (primitive/field o free) (primitive/fnptr-of str-key-free))
    (primitive/store! (primitive/field o owns) 1)
    o))

;; OPT-IN, UNSAFE: keys are BORROWED — the map stores the (slice u8) view verbatim
;; and never copies or frees the pointed-to bytes. The caller MUST guarantee every
;; key's storage outlives the map and is not mutated for the map's lifetime; two keys
;; built over one reused buffer will alias (the std-3 footgun). Correct for keys that
;; are static literals or otherwise pinned. `copy`/`free`/`owns` are left zero (the
;; alloc-static zero-init), so `ko-owns?` is false and no ownership hook ever runs.
(defn str-keyops-borrowed [] (-> (ptr KeyOps))
  (let [o (alloc/static KeyOps)]
    (primitive/store! (primitive/field o hash) (primitive/fnptr-of str-key-hash))
    (primitive/store! (primitive/field o eq)   (primitive/fnptr-of str-key-eq))
    (primitive/store! (primitive/field o size) (primitive/sizeof (slice u8)))
    o))

; ---- owned, growable string: a LIBRARY over ArrayList<u8> ------------------
;; `StrBuf` is just an `(ArrayList u8)`; appending pushes bytes, and `sb-str` hands
;; back a `(slice u8)` VIEW over the current contents (no copy, invalidated by a
;; later growth that moves the buffer — same contract as al-slice).
(defstruct StrBuf [(bytes (ArrayList u8))])

(defn sb-new [(a (ptr Allocator))] (-> StrBuf)
  (let [(mut sb) (primitive/zeroed StrBuf)]
    (primitive/store! (primitive/field sb bytes) (al-new [u8] a))
    (primitive/load sb)))

;; Append a (slice u8); returns the new length.
(defn sb-push-str! [(sb (mut StrBuf)) (s (slice u8))] (-> :i64)
  (let [(mut i) 0 n (slice-len s)]
    (loop
      (if (primitive/icmp-ge (primitive/load i) n)
          (break)
          (do (al-push! (mut (primitive/field sb bytes)) (slice-get s (primitive/load i)))
              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (al-len (primitive/field sb bytes))))

(defn sb-push-byte! [(sb (mut StrBuf)) (b :u8)] (-> :i64)
  (al-push! (mut (primitive/field sb bytes)) b))

;; A (slice u8) view over the current contents (shares storage with the StrBuf).
(defn sb-str [(sb StrBuf)] (-> (slice u8))
  (al-slice (primitive/field sb bytes)))

(defn sb-free! [(sb (mut StrBuf))] (-> :i64)
  (al-free! (mut (primitive/field sb bytes))))

;; Finish building: hand back an OWNING `(slice u8)` shrunk to the exact length, and
;; reset the StrBuf to empty. Unlike `sb-str` (a borrowed view that a later push can
;; invalidate), the returned slice owns a right-sized buffer the caller frees with the
;; same allocator — no use-after-free, no dangling capacity. Over `al-into-slice`.
(defn sb-finish! [(sb (mut StrBuf))] (-> (slice u8))
  (al-into-slice (mut (primitive/field sb bytes))))

; ---- the core collection traits (coil.core) ---------------------------------
; Strings are `(slice u8)` — so equality (`=`/`case`), ordering (`< <= > >=`, hence
; `sort`), and hashing (a HashMap key) come from these impls over the byte content.
; (The generic `Len`/`Get`/`Set` for any `(slice T)` live in src/stdlib/slice.coil.)
(impl Eq (slice u8)
  (= [(a (slice u8)) (b (slice u8))] (-> bool) (str-eq a b)))
(impl Ord (slice u8)
  (<  [(a (slice u8)) (b (slice u8))] (-> bool) (primitive/icmp-lt (str-cmp a b) 0))
  (<= [(a (slice u8)) (b (slice u8))] (-> bool) (primitive/icmp-le (str-cmp a b) 0))
  (>  [(a (slice u8)) (b (slice u8))] (-> bool) (primitive/icmp-gt (str-cmp a b) 0))
  (>= [(a (slice u8)) (b (slice u8))] (-> bool) (primitive/icmp-ge (str-cmp a b) 0)))
(impl Hash (slice u8)
  (hash [(x (slice u8))] (-> i64) (str-hash x)))

; A StrBuf is a byte collection: `(len sb)` / `(get sb i)` / `(push! (mut sb) b)`.
; (Strings themselves are (slice u8) — their Len/Get impls are src/stdlib/slice.coil's.)
(impl Len StrBuf
  (len [(sb StrBuf)] (-> i64) (al-len (primitive/load (primitive/field sb bytes)))))
(impl Get StrBuf
  (get [(sb StrBuf) (i i64)] (-> :u8) (al-get (primitive/load (primitive/field sb bytes)) i)))
(impl Push StrBuf
  (push! [(sb (mut StrBuf)) (b :u8)] (-> i64) (sb-push-byte! (mut sb) b)))
