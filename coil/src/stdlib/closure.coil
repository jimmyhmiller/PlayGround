(module coil.closure)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
; Closure library — written entirely in Coil macros. `(import "src/stdlib/closure.coil")`
; then `(defclosure NAME [captures] [params] RET body...)` to get a heap closure
; with NAME-new / NAME-call / NAME-free. Nothing in the compiler knows about it.

;; Stage-3 comptime helpers (recurse by index over Code vectors of (name type) pairs).
(defn cl--param-types [(ps Code) (i i64)] (-> Code)
  (if (primitive/icmp-eq i (primitive/code-count ps)) `()
    `(~(primitive/code-nth (primitive/code-nth ps i) 1) ~@(cl--param-types ps (primitive/iadd i 1)))))
(defn cl--param-names [(ps Code) (i i64)] (-> Code)
  (if (primitive/icmp-eq i (primitive/code-count ps)) `()
    `(~(primitive/code-nth (primitive/code-nth ps i) 0) ~@(cl--param-names ps (primitive/iadd i 1)))))
;; let-bindings that load each capture out of the env: name (primitive/load (primitive/field __self name)) …
(defn cl--cap-loads [(caps Code) (i i64)] (-> Code)
  (if (primitive/icmp-eq i (primitive/code-count caps)) `()
    (let [nm (primitive/code-nth (primitive/code-nth caps i) 0)]
      `(~nm (primitive/load (primitive/field __self ~nm)) ~@(cl--cap-loads caps (primitive/iadd i 1))))))
(defn cl--cap-stores [(caps Code) (i i64)] (-> Code)
  (if (primitive/icmp-eq i (primitive/code-count caps)) `()
    (let [nm (primitive/code-nth (primitive/code-nth caps i) 0)]
      `((primitive/store! (primitive/field __e ~nm) ~nm) ~@(cl--cap-stores caps (primitive/iadd i 1))))))

(defn defclosure [(name Code) (caps Code) (params Code) (ret Code) & (body Code)] (-> Code)
  (let [env-name  (primitive/code-symbol name "-env")
        code-name (primitive/code-symbol name "-code")
        new-name  (primitive/code-symbol name "-new")
        call-name (primitive/code-symbol name "-call")
        free-name (primitive/code-symbol name "-free")]
    `(do
       (defstruct ~env-name [~@caps])
       (defn ~code-name [(__self (ptr ~env-name)) ~@params] (-> ~ret)
         (let [~@(cl--cap-loads caps 0)] ~@body))
       (defstruct ~name
         [(code (fnptr c [(ptr ~env-name) ~@(cl--param-types params 0)] ~ret))
          (env (ptr ~env-name))])
       (defn ~new-name [~@caps] (-> (ptr ~name))
         (let [__e (coil.alloc/heap ~env-name)
               __c (coil.alloc/heap ~name)]
           ~@(cl--cap-stores caps 0)
           (primitive/store! (primitive/field __c code) (primitive/fnptr-of ~code-name))
           (primitive/store! (primitive/field __c env) __e)
           __c))
       (defn ~call-name [(__c (ptr ~name)) ~@params] (-> ~ret)
         (primitive/call-ptr (primitive/load (primitive/field __c code)) (primitive/load (primitive/field __c env)) ~@(cl--param-names params 0)))
       (defn ~free-name [(__c (ptr ~name))] (-> i64)
         (do (primitive/free (primitive/load (primitive/field __c env))) (primitive/free __c))))))
