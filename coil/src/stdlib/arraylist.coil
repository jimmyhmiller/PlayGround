(module coil.arraylist)
(import "primitive.coil" :as primitive)
; A growable array — `ArrayList T` — built on slices + the allocator-as-value
; interface (src/stdlib/alloc.coil). Like everything else, an ORDINARY generic struct +
; functions/macros; the compiler has no notion of it, and there is no ambient
; heap: an ArrayList carries the `(ptr Allocator)` it grows with.
;
;   (import "src/stdlib/arraylist.coil" :use *)
;   (let [a (malloc-allocator) (mut xs) (al-new [i64] a)]
;     (al-push! (mut xs) 10) (al-for [v xs] …) (al-free! (mut xs)))
;
; Mutating ops take `(mut (ArrayList T))` — pass `(mut xs)`. Reads take it by
; value. `al-push!` grows by doubling (initial cap 4); it tries the allocator's
; in-place `resize`, else allocates-copies-frees (so arena allocators work too),
; and HARD-ABORTS on genuine OOM (never a silent-wrong value). Bounds are not
; checked (debug bounds-checks are Phase-2 safety work).

(import "alloc.coil"  :use *)   ; Allocator, raw-*, alloc-slice, malloc-allocator
(import "result.coil" :use *)   ; Option/Some/None for the allocator's results
(import "slice.coil"  :use *)   ; (slice T) / slice-new, for al-slice + al-for
(import "mem.coil"    :use *)   ; mem-copy, for the bulk al-extend! append
; OOM hard-fail routes through alloc's `oom` (a shared defn) rather than a local
; `abort` extern, so ArrayList + HashMap can be imported together (Coil doesn't
; dedup identical extern decls across modules).

(defstruct ArrayList [T]
  [(data (ptr T)) (len i64) (cap i64) (alc (ptr Allocator))])

;; An empty list that will grow with allocator `a` (no allocation until first push).
(defn al-new [T] [(a (ptr Allocator))] (-> (ArrayList T))
  (let [(mut l) (primitive/zeroed (ArrayList T))]
    (primitive/store! (primitive/field l alc) a)
    (primitive/load l)))

(defn al-len [T] [(l (ArrayList T))] (-> i64) (primitive/load (primitive/field l len)))
(defn al-cap [T] [(l (ArrayList T))] (-> i64) (primitive/load (primitive/field l cap)))
(defn al-empty? [T] [(l (ArrayList T))] (-> bool) (primitive/icmp-eq (primitive/load (primitive/field l len)) 0))

(defn al-get [T] [(l (ArrayList T)) (i i64)] (-> T)
  (primitive/load (primitive/index (primitive/load (primitive/field l data)) i)))
(defn al-set! [T] [(l (mut (ArrayList T))) (i i64) (v T)] (-> i64)
  (primitive/store! (primitive/index (primitive/load (primitive/field l data)) i) v)
  0)

;; Grow capacity to at least `newcap`. Tries in-place resize; on failure (e.g. an
;; arena, which never resizes) allocates fresh, copies, frees the old block; a
;; genuine allocation failure aborts.
(defn al-reserve! [T] [(l (mut (ArrayList T))) (newcap i64)] (-> i64)
  (let [oldcap (primitive/load (primitive/field l cap))
        a      (primitive/load (primitive/field l alc))]
    (if (primitive/icmp-le newcap oldcap)
        0
        (match (raw-resize a (primitive/cast (ptr i8) (primitive/load (primitive/field l data)))
                           (primitive/imul oldcap (primitive/sizeof T)) (primitive/imul newcap (primitive/sizeof T)) (primitive/alignof T))
          (Some [p] (do (primitive/store! (primitive/field l data) (primitive/cast (ptr T) p))
                        (primitive/store! (primitive/field l cap) newcap)
                        0))
          (None []
            (match (alloc-slice [T] a newcap)
              ; out of memory — hard fail, no silent wrong. `oom-at` names the site and
              ; the request so an exhausted arena says so instead of exiting 134 silently.
              (None [] (do (oom-at c"arraylist al-reserve!" (primitive/imul newcap (primitive/sizeof T))) -1))
              (Some [np]
                (do
                  (let [(mut i) 0]
                    (loop
                      (if (primitive/icmp-ge (primitive/load i) (primitive/load (primitive/field l len)))
                          (break)
                          (do (primitive/store! (primitive/index np (primitive/load i))
                                      (primitive/load (primitive/index (primitive/load (primitive/field l data)) (primitive/load i))))
                              (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
                  (if (primitive/icmp-gt oldcap 0)
                      (raw-free a (primitive/cast (ptr i8) (primitive/load (primitive/field l data)))
                                (primitive/imul oldcap (primitive/sizeof T)) (primitive/alignof T))
                      0)
                  (primitive/store! (primitive/field l data) np)
                  (primitive/store! (primitive/field l cap) newcap)
                  0))))))))

;; Append v; grows (doubling, first allocation 2) if full. Returns the new length.
;;
;; The first allocation is 2 elements, not 4. Most lists are SHORT, and a first block of 4
;; overshoots them by 2 slots of `sizeof T` that are never used — which for a big T is not
;; a rounding error. Measured on the compiler (`check src/compiler/main.coil`, ~5.8M
;; allocations): the two commonest allocation sizes in the whole process were a 4-slot
;; `(ArrayList Expr)` at 672 bytes (360k of them, 231 MiB) and a 4-slot `(ArrayList Sexp)`
;; at 256 bytes (917k, 224 MiB), while 4->8 growths were rarer than 4-slot allocations by
;; more than 20x. Almost nothing was outgrowing the first block; it was simply too big.
;;
;; Dropping it to 2 took peak RSS from 1022 MiB to 841 MiB (-18%) AND the run from 0.530s
;; to 0.495s (-30 ms, faster in 9 of 12 paired runs) — less memory touched is also less
;; memory to fault in and miss on. 1 was tried too: 811 MiB but slower than 2, so the
;; extra growth step stops paying there.
(defn al-push! [T] [(l (mut (ArrayList T))) (v T)] (-> i64)
  (let [n (primitive/load (primitive/field l len))]
    (if (primitive/icmp-ge n (primitive/load (primitive/field l cap)))
        (al-reserve! (mut l)
                     (if (primitive/icmp-eq (primitive/load (primitive/field l cap)) 0) 2 (primitive/imul (primitive/load (primitive/field l cap)) 2)))
        0)
    (primitive/store! (primitive/index (primitive/load (primitive/field l data)) n) v)
    (primitive/store! (primitive/field l len) (primitive/iadd n 1))
    (primitive/iadd n 1)))

;; Append n elements from `src` in one shot. Reserves the whole run up front and block
;; copies it — the equivalent `al-push!` loop costs a call plus a capacity test per
;; element and a realloc-and-copy at every doubling, where this pays one growth and one
;; `mem-copy`. `src` must not point into this list's own buffer (the copy is memcpy, and
;; a growth moves the buffer anyway). Returns the new length.
(defn al-extend! [T] [(l (mut (ArrayList T))) (src (ptr T)) (n i64)] (-> i64)
  (let [old  (primitive/load (primitive/field l len))
        need (primitive/iadd old n)]
    (if (primitive/icmp-gt need (primitive/load (primitive/field l cap)))
        (al-reserve! (mut l) need)
        0)
    (mem-copy [T] (primitive/index (primitive/load (primitive/field l data)) old) src n)
    (primitive/store! (primitive/field l len) need)
    need))

;; Remove and return the last element as (Some v); (None) if empty.
(defn al-pop! [T] [(l (mut (ArrayList T)))] (-> (Option T))
  (let [n (primitive/load (primitive/field l len))]
    (if (primitive/icmp-eq n 0)
        (None)
        (let [v (primitive/load (primitive/index (primitive/load (primitive/field l data)) (primitive/isub n 1)))]
          (primitive/store! (primitive/field l len) (primitive/isub n 1))
          (Some v)))))

;; A slice view over the current elements (shares storage; invalidated by a later
;; grow that moves the buffer).
(defn al-slice [T] [(l (ArrayList T))] (-> (slice T))
  (slice-new (primitive/load (primitive/field l data)) (primitive/load (primitive/field l len))))

;; Free the backing buffer and reset to empty (the allocator itself is untouched).
(defn al-free! [T] [(l (mut (ArrayList T)))] (-> i64)
  (if (primitive/icmp-gt (primitive/load (primitive/field l cap)) 0)
      (raw-free (primitive/load (primitive/field l alc)) (primitive/cast (ptr i8) (primitive/load (primitive/field l data)))
                (primitive/imul (primitive/load (primitive/field l cap)) (primitive/sizeof T)) (primitive/alignof T))
      0)
  (primitive/store! (primitive/field l data) (primitive/cast (ptr T) 0))
  (primitive/store! (primitive/field l len) 0)
  (primitive/store! (primitive/field l cap) 0)
  0)

;; Reset to empty WITHOUT freeing the buffer — length becomes 0 but the capacity is
;; kept for reuse (the elements are logically gone; a later push overwrites them). Use
;; `al-free!` to also release the storage.
(defn al-clear! [T] [(l (mut (ArrayList T)))] (-> i64)
  (primitive/store! (primitive/field l len) 0)
  0)

;; Hand over ownership of the elements as a right-sized `(slice T)`, resetting the list
;; to empty. The buffer is shrunk to exactly `len` (via the allocator's resize) so the
;; returned slice owns a freeable, dangling-capacity-free block — free it with
;; `(raw-free a (primitive/cast (ptr i8) (slice-data s)) (* (slice-len s) (primitive/sizeof T)) (primitive/alignof T))`.
;; This is the safe hand-off `al-slice` is NOT: `al-slice` returns a borrowed view that
;; the next `al-push!` can invalidate by moving the buffer, whereas this transfers the
;; storage out of the list entirely. On an empty list the result is an empty slice.
(defn al-into-slice [T] [(l (mut (ArrayList T)))] (-> (slice T))
  (let [a    (primitive/load (primitive/field l alc))
        n    (primitive/load (primitive/field l len))
        cap  (primitive/load (primitive/field l cap))
        data (primitive/load (primitive/field l data))
        final (if (and (primitive/icmp-gt cap n) (primitive/icmp-gt n 0))
                  ; shrink to exactly n; if the allocator can't, keep the full block
                  ; (the extra capacity is leaked, never a use-after-free).
                  (match (raw-resize a (primitive/cast (ptr i8) data)
                                     (primitive/imul cap (primitive/sizeof T)) (primitive/imul n (primitive/sizeof T)) (primitive/alignof T))
                    (Some [p] (primitive/cast (ptr T) p))
                    (None []  data))
                  data)]
    (primitive/store! (primitive/field l data) (primitive/cast (ptr T) 0))
    (primitive/store! (primitive/field l len) 0)
    (primitive/store! (primitive/field l cap) 0)
    (slice-new final n)))

;; `(al-for [x xs] body...)` — iterate the list's elements. A thin alias for the
;; unified iterator protocol `(for x (iter xs))` (gen-1): it expands to
;; `(for-in [x (iter xs)])`, driving the list's `Iterator` impl (a `SliceIter` over
;; its `al-slice` view). Kept as a convenience spelling.
(defn al-for [(binding Code) & (body Code)] (-> Code)
  (if (not (primitive/icmp-eq (primitive/code-count binding) 2))
      (primitive/error "al-for: binding must be [x arraylist]")
      `(for-in [~(primitive/code-nth binding 0) (iter ~(primitive/code-nth binding 1))] ~@body)))

; ---- the core collection traits (coil.core) ---------------------------------
; `(len xs)` / `(get xs i)` / `(set! (mut xs) i v)` / `(push! (mut xs) v)` /
; `(pop! (mut xs))` on any (ArrayList T) — the al-* functions remain the named
; API these delegate to.
(impl [T] Len (ArrayList T)
  (len [(xs (ArrayList T))] (-> i64) (al-len xs)))
(impl [T] Get (ArrayList T)
  (get [(xs (ArrayList T)) (i i64)] (-> T) (al-get xs i)))
(impl [T] Set (ArrayList T)
  (set! [(xs (mut (ArrayList T))) (i i64) (v T)] (-> i64) (al-set! (mut xs) i v)))
(impl [T] Push (ArrayList T)
  (push! [(xs (mut (ArrayList T))) (v T)] (-> i64) (al-push! (mut xs) v)))
(impl [T] Pop (ArrayList T)
  (pop! [(xs (mut (ArrayList T)))] (-> (Option T)) (al-pop! (mut xs))))

; ---- iteration (coil.core Iterable) -----------------------------------------
; A list iterates through a `(SliceIter T)` over its `al-slice` view — the same
; iterator slices use — so `(for x (iter xs))` and `(al-for [x xs] …)` walk the
; elements identically. The view is valid for the duration of a read-only walk
; (don't push/pop the list mid-iteration, exactly as `al-slice` already warns).
(impl [T] Iterable (ArrayList T)
  (iter [(xs (ArrayList T))] (-> (SliceIter T)) (iter (al-slice xs))))
