(module benchmark.float)
(import "primitive.coil" :as primitive)
; Harmonic sum -- double-precision divide+add throughput (no FMA fusion).
(extern printf :cc c [(ptr i8) ...] (-> i32))
(defn hsum [(i :i64) (n :i64) (s :f64)] (-> :f64)
  (if (primitive/icmp-gt i n) s (hsum (primitive/iadd i 1) n (primitive/fadd s (primitive/fdiv 1.0 (primitive/cast :f64 i))))))
(defn main [] (-> :i64) (do (printf c"%.12f\n" (hsum 1 200000000 0.0)) 0))
