; ── DIALECT: gc ───────────────────────────────────────────────────────────
; A precise, non-moving, stop-the-world mark-sweep GC — built entirely as a
; metaprogram + runtime library over the C-level core. The core knows nothing
; about GC.
;   • implicit allocation  — `new` injects an ambient heap; no Allocator value
;   • implicit reclamation  — no `free`; the collector sweeps unreachable objects
;   • precise roots         — a shadow stack the `gc-let` binding form maintains
;   • precise tracing       — each type's tracer is GENERATED from field
;                             reflection (`gctype T`), so object graphs are
;                             followed without the core knowing any layout
(module gc)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)

(extern malloc :cc c [:i64]     (-> (ptr u8)))
(extern free   :cc c [(ptr u8)] (-> :i64))

; Object header: intrusive all-objects list + mark bit + the type's tracer.
(defstruct GcHeader
  [(next  (ptr GcHeader))
   (mark  :i64)
   (size  :i64)
   (trace (fnptr c [(ptr u8)] :i64))])

; ── global singletons (alloc/static returns the same cell every call) ──
(defn g-list  [] (-> (ptr (ptr GcHeader)))          (alloc/static (ptr GcHeader)))
(defn g-roots [] (-> (ptr (array (ptr u8) 8192)))   (alloc/static (array (ptr u8) 8192)))
(defn g-rtop  [] (-> (ptr :i64)) (alloc/static :i64))
(defn g-live  [] (-> (ptr :i64)) (alloc/static :i64))
(defn g-peak  [] (-> (ptr :i64)) (alloc/static :i64))
(defn g-ncol  [] (-> (ptr :i64)) (alloc/static :i64))
(defn g-total [] (-> (ptr :i64)) (alloc/static :i64))   ; objects ever allocated

(defn null-ptr? [(p (ptr u8))]      (-> bool) (primitive/icmp-eq (primitive/cast i64 p) 0))
(defn hnull?    [(p (ptr GcHeader))] (-> bool) (primitive/icmp-eq (primitive/cast i64 p) 0))
(defn hdr-of [(payload (ptr u8))] (-> (ptr GcHeader))
  (primitive/cast (ptr GcHeader) (primitive/isub (primitive/cast i64 payload) (primitive/sizeof GcHeader))))

; ── roots (shadow stack) ──
(defn gc-root-push [(p (ptr u8))] (-> :i64)
  (let [t (primitive/load (g-rtop))]
    (primitive/store! (primitive/index (g-roots) t) p)
    (primitive/store! (g-rtop) (primitive/iadd t 1))
    0))
(defn gc-root-pop [] (-> :i64)
  (primitive/store! (g-rtop) (primitive/isub (primitive/load (g-rtop)) 1))
  0)

; ── marking: set the mark, then follow the object's own tracer (recursively).
;    The mark check makes cyclic graphs terminate.
(defn gc-mark [(payload (ptr u8))] (-> :i64)
  (if (null-ptr? payload)
      0
      (let [h (hdr-of payload)]
        (if (primitive/icmp-eq (primitive/load (primitive/field h mark)) 1)
            0
            (do
              (primitive/store! (primitive/field h mark) 1)
              (primitive/call-ptr (primitive/load (primitive/field h trace)) payload))))))

; ── collection: mark reachable-from-roots, sweep the rest ──
(defn gc-collect [] (-> :i64)
  (let [(mut i) 0]                                     ; mark from every root
    (loop
      (if (primitive/icmp-ge (primitive/load i) (primitive/load (g-rtop)))
          (break 0)
          (do
            (gc-mark (primitive/load (primitive/index (g-roots) (primitive/load i))))
            (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (let [(mut cur) (primitive/load (g-list))                      ; sweep, rebuild from survivors
        (mut newhead) (primitive/cast (ptr GcHeader) 0)]
    (loop
      (if (hnull? (primitive/load cur))
          (break 0)
          (let [nxt (primitive/load (primitive/field (primitive/load cur) next))]
            (if (primitive/icmp-eq (primitive/load (primitive/field (primitive/load cur) mark)) 1)
                (do
                  (primitive/store! (primitive/field (primitive/load cur) mark) 0)
                  (primitive/store! (primitive/field (primitive/load cur) next) (primitive/load newhead))
                  (primitive/store! newhead (primitive/load cur))
                  0)
                (do
                  (primitive/free (primitive/cast (ptr u8) (primitive/load cur)))
                  (primitive/store! (g-live) (primitive/isub (primitive/load (g-live)) 1))
                  0))
            (primitive/store! cur nxt))))
    (primitive/store! (g-list) (primitive/load newhead)))
  (primitive/store! (g-ncol) (primitive/iadd (primitive/load (g-ncol)) 1))
  0)

; ── allocation (implicit ambient heap; collects when the live set gets big) ──
(defn gc-alloc [(size :i64) (tr (fnptr c [(ptr u8)] :i64))] (-> (ptr u8))
  (if (primitive/icmp-ge (primitive/load (g-live)) 32) (gc-collect) 0)
  (let [raw (malloc (primitive/iadd (primitive/sizeof GcHeader) size))
        h   (primitive/cast (ptr GcHeader) raw)]
    (primitive/store! (primitive/field h next)  (primitive/load (g-list)))
    (primitive/store! (primitive/field h mark)  0)
    (primitive/store! (primitive/field h size)  size)
    (primitive/store! (primitive/field h trace) tr)
    (primitive/store! (g-list) h)
    (primitive/store! (g-total) (primitive/iadd (primitive/load (g-total)) 1))
    (primitive/store! (g-live) (primitive/iadd (primitive/load (g-live)) 1))
    (if (primitive/icmp-gt (primitive/load (g-live)) (primitive/load (g-peak)))
        (primitive/store! (g-peak) (primitive/load (g-live))) 0)
    (primitive/cast (ptr u8) (primitive/iadd (primitive/cast i64 raw) (primitive/sizeof GcHeader)))))

; ── the dialect vocabulary (macros) ──
(defn new  [(t Code)]                   (-> Code)
  `(primitive/cast (ptr ~t) (gc-alloc (primitive/sizeof ~t) (primitive/fnptr-of ~(primitive/code-symbol t "-trace")))))
(defn fset [(p Code) (f Code) (v Code)] (-> Code) `(primitive/store! (primitive/field ~p ~f) ~v))
(defn fget [(p Code) (f Code)]          (-> Code) `(primitive/load  (primitive/field ~p ~f)))

; gc-let: bind a GC pointer AND root it for the duration of the body.
(defn gc-let [(name Code) (init Code) & (body Code)] (-> Code)
  (let [r (primitive/gensym)]
    `(let [~name ~init]
       (gc-root-push (primitive/cast (ptr u8) ~name))
       (let [~r (do ~@body)]
         (gc-root-pop)
         ~r))))

; ── gctype: GENERATE a struct's tracer from field reflection ──
; For each field whose kind is 5 (pointer), emit a (gc-mark …) that follows it.
; kind tags (from src/stdlib/derive.coil): 0=int 1=float 2=bool 3=struct 4=sum 5=ptr …
(defn gc--trace-fields [(T Code) (p Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-eq i n)
      `0
      (let [rest (gc--trace-fields T p (primitive/iadd i 1) n)]
        (if (primitive/icmp-eq (primitive/code-field-kind T i) 5)
            `(do (gc-mark (primitive/cast (ptr u8) (primitive/load (primitive/field ~p ~(primitive/code-field-name T i))))) ~rest)
            rest))))

(defn gctype [(tname Code)] (-> Code)
  (let [p (primitive/gensym)]
    `(defn ~(primitive/code-symbol tname "-trace") [(pp (ptr u8))] (-> :i64)
       (let [~p (primitive/cast (ptr ~tname) pp)]
         ~(gc--trace-fields tname p 0 (primitive/code-field-count tname))))))

; observability
(defn peak-live       [] (-> :i64) (primitive/load (g-peak)))
(defn num-collections [] (-> :i64) (primitive/load (g-ncol)))
(defn live-now        [] (-> :i64) (primitive/load (g-live)))
(defn objects-ever    [] (-> :i64) (primitive/load (g-total)))
