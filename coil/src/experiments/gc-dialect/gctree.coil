(module app)
(import "primitive.coil" :as primitive)
(import "io.coil"  :use *)
(import "fmt.coil" :use *)
(import "gc.coil"  :use *)

(defstruct Node [(val :i64) (next (ptr Node))])
(gctype Node)                          ; tracer generated from reflection: follows `next`

; Build a k-node list (values 0..k-1). Recursive: each frame roots the growing
; tail (via gc-let) while it allocates its node, so a collection mid-build must
; follow `next` pointers to keep the tail alive — that's the tracing test.
(defn build-list [(k :i64) (i :i64)] (-> (ptr Node))
  (if (primitive/icmp-ge i k)
      (primitive/cast (ptr Node) 0)
      (gc-let rest (build-list k (primitive/iadd i 1))
        (let [node (new Node)]
          (fset node val i)
          (primitive/store! (primitive/field node next) rest)
          node))))

(defn sum-list [(h (ptr Node))] (-> :i64)
  (let [(mut cur) h (mut acc) 0]
    (loop
      (if (primitive/icmp-eq (primitive/cast i64 (primitive/load cur)) 0)
          (break (primitive/load acc))
          (do
            (primitive/store! acc (primitive/iadd (primitive/load acc) (primitive/load (primitive/field (primitive/load cur) val))))
            (primitive/store! cur (primitive/load (primitive/field (primitive/load cur) next))))))))

(defn once [(k :i64)] (-> :i64)
  (gc-let head (build-list k 0)
    (sum-list head)))

(defn main [] (-> :i64)
  (let [(mut total) 0 (mut m) 0]
    (loop
      (if (primitive/icmp-ge (primitive/load m) 2000)
          (break 0)
          (do
            (primitive/store! total (primitive/iadd (primitive/load total) (once 50)))
            (primitive/store! m (primitive/iadd (primitive/load m) 1)))))
    (fmt (stdout) "graph: lists=2000 len=50  total_sum={d} (expect 2450000)  peak_live={d}  collections={d}\n"
         (primitive/load total) (peak-live) (num-collections))
    0))
