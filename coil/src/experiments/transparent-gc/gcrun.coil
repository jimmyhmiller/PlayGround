(module gcrun)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
; The runtime a GC'd program ASSUMES exists — cons/car/cdr/nil over a precise
; mark-sweep heap. User code never sees any of this; it just writes cons-lists.
; Pointers, allocation, and rooting are the transform's job (gcauto.coil).
(import "control.coil" :use *)
(extern malloc :cc c [i64] (-> (ptr u8)))
(extern free   :cc c [(ptr u8)] (-> i64))

; a cons cell: car is a value, cdr is a managed reference
(defstruct Pair [(car i64) (cdr (ptr Pair))])

(defstruct GcHeader [(next (ptr GcHeader)) (mark i64)])
(defn g-list [] (-> (ptr (ptr GcHeader))) (alloc/static (ptr GcHeader)))
(defn g-roots [] (-> (ptr (array (ptr u8) 65536))) (alloc/static (array (ptr u8) 65536)))
(defn g-rtop [] (-> (ptr i64)) (alloc/static i64))
(defn g-live [] (-> (ptr i64)) (alloc/static i64))
(defn g-peak [] (-> (ptr i64)) (alloc/static i64))
(defn g-ncol [] (-> (ptr i64)) (alloc/static i64))
(defn g-total [] (-> (ptr i64)) (alloc/static i64))

(defn hdr-of [(payload (ptr u8))] (-> (ptr GcHeader))
  (primitive/cast (ptr GcHeader) (- (primitive/cast i64 payload) (primitive/sizeof GcHeader))))

; --- the root stack primitives the TRANSFORM emits ---
(defn gc-sp [] (-> i64) (primitive/load (g-roots-top)))
(defn g-roots-top [] (-> (ptr i64)) (g-rtop))
(defn gc-sp-set [(n i64)] (-> i64) (primitive/store! (g-rtop) n) 0)
(defn gc-root [(p (ptr Pair))] (-> i64)
  (let [t (primitive/load (g-rtop))]
    (primitive/store! (primitive/index (g-roots) t) (primitive/cast (ptr u8) p))
    (primitive/store! (g-rtop) (+ t 1)) 0))

; --- mark / sweep ---
(defn gc-mark [(payload (ptr u8))] (-> i64)
  (if (= (primitive/cast i64 payload) 0) 0
    (let [h (hdr-of payload)]
      (if (= (primitive/load (primitive/field h mark)) 1) 0
        (do (primitive/store! (primitive/field h mark) 1)
            (gc-mark (primitive/cast (ptr u8) (primitive/load (primitive/field (primitive/cast (ptr Pair) payload) cdr)))))))))
(defn gc-collect [] (-> i64)
  (let [top (primitive/load (g-rtop))]
    (for [i 0 top] (gc-mark (primitive/load (primitive/index (g-roots) i)))))
  ; sweep: rebuild the all-objects list from the survivors. `cur`/`newhead` are
  ; pointer muts, so cast/field/store take (primitive/load …) explicitly (mut auto-deref is
  ; only for clean operators and function args, not these special forms).
  (let [(mut cur) (primitive/load (g-list)) (mut newhead) (primitive/cast (ptr GcHeader) 0)]
    (loop
      (if (= (primitive/cast i64 (primitive/load cur)) 0) (break)
        (let [nxt (primitive/load (primitive/field (primitive/load cur) next))]
          (if (= (primitive/load (primitive/field (primitive/load cur) mark)) 1)
              (do (primitive/store! (primitive/field (primitive/load cur) mark) 0)
                  (primitive/store! (primitive/field (primitive/load cur) next) (primitive/load newhead))
                  (primitive/store! newhead (primitive/load cur)) 0)
            (do (primitive/free (primitive/cast (ptr u8) (primitive/load cur)))
                (primitive/store! (g-live) (- (primitive/load (g-live)) 1)) 0))
          (primitive/store! cur nxt))))
    (primitive/store! (g-list) (primitive/load newhead)))
  (primitive/store! (g-ncol) (+ (primitive/load (g-ncol)) 1)) 0)

; --- the prims a Scheme-ish program uses (allocation is IMPLICIT in cons) ---
(defn nil [] (-> (ptr Pair)) (primitive/cast (ptr Pair) 0))
(defn nil? [(p (ptr Pair))] (-> bool) (= (primitive/cast i64 p) 0))
(defn cons [(a i64) (d (ptr Pair))] (-> (ptr Pair))
  (if (>= (primitive/load (g-live)) 32) (gc-collect) 0)
  (let [raw (malloc (+ (primitive/sizeof GcHeader) (primitive/sizeof Pair)))
        h (primitive/cast (ptr GcHeader) raw)
        p (primitive/cast (ptr Pair) (+ (primitive/cast i64 raw) (primitive/sizeof GcHeader)))]
    (primitive/store! (primitive/field h next) (primitive/load (g-list)))
    (primitive/store! (primitive/field h mark) 0)
    (primitive/store! (g-list) h)
    (primitive/store! (g-total) (+ (primitive/load (g-total)) 1))
    (primitive/store! (g-live) (+ (primitive/load (g-live)) 1))
    (if (> (primitive/load (g-live)) (primitive/load (g-peak))) (primitive/store! (g-peak) (primitive/load (g-live))) 0)
    (primitive/store! (primitive/field p car) a)
    (primitive/store! (primitive/field p cdr) d)
    p))
(defn car [(p (ptr Pair))] (-> i64) (primitive/load (primitive/field p car)))
(defn cdr [(p (ptr Pair))] (-> (ptr Pair)) (primitive/load (primitive/field p cdr)))

(defn gc-peak [] (-> i64) (primitive/load (g-peak)))
(defn gc-collections [] (-> i64) (primitive/load (g-ncol)))
(defn gc-total [] (-> i64) (primitive/load (g-total)))
