; todomvc.coil -- TodoMVC in Coil, compiled to wasm32, over `externref`.
;
; DOM nodes/events flow as externref (real JS values held by the wasm runtime, GC'd);
; the transient nodes built while rendering are collected automatically. The Coil
; MODEL is fixed-capacity `alloc-static` storage (no malloc); the few refs it must
; keep across events (the list, the counter, each <li>) are `retain`ed to a
; memory-storable i32 index and `unretain`ed when the todo is deleted.
(module todomvc)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "slice.coil" :use *)
(import "js.coil" :use *)
(import "dom.coil" :use *)

(defstruct Todo [(used i32) (done i32) (li i32)])  ; li = retain index of the <li>
(defstruct Store [(todos (array Todo 512)) (nslots i32) (ul i32) (counter i32)])  ; ul/counter = retain indices
(defn store [] (-> (ptr Store)) (alloc/static Store))
(defn slot [(i i32)] (-> (ptr Todo)) (primitive/index (primitive/field (store) todos) (primitive/cast i64 i)))

(defn active-count [] (-> i32)
  (let [(mut n) (primitive/cast i32 0) (mut i) (primitive/cast i32 0) ns (primitive/load (primitive/field (store) nslots))]
    (loop (if (primitive/icmp-ge (primitive/load i) ns)
            (break)
            (do
              (let [t (slot (primitive/load i))]
                (if (and (primitive/icmp-ne (primitive/load (primitive/field t used)) (primitive/cast i32 0))
                         (primitive/icmp-eq (primitive/load (primitive/field t done)) (primitive/cast i32 0)))
                  (primitive/store! n (primitive/iadd (primitive/load n) (primitive/cast i32 1)))
                  0))
              (primitive/store! i (primitive/iadd (primitive/load i) (primitive/cast i32 1))))))
    (primitive/load n)))

(defn update-count! [] (-> i32)
  (set-text-ref! (deref (primitive/load (primitive/field (store) counter))) (js-num (active-count))))

(defn free-slot [] (-> i32)
  (let [ns (primitive/load (primitive/field (store) nslots)) (mut i) (primitive/cast i32 0) (mut found) (primitive/cast i32 -1)]
    (loop (if (or (primitive/icmp-ge (primitive/load i) ns) (primitive/icmp-ne (primitive/load found) (primitive/cast i32 -1)))
            (break)
            (do
              (if (primitive/icmp-eq (primitive/load (primitive/field (slot (primitive/load i)) used)) (primitive/cast i32 0)) (primitive/store! found (primitive/load i)) 0)
              (primitive/store! i (primitive/iadd (primitive/load i) (primitive/cast i32 1))))))
    (if (primitive/icmp-ne (primitive/load found) (primitive/cast i32 -1))
      (primitive/load found)
      (do (primitive/store! (primitive/field (store) nslots) (primitive/iadd ns (primitive/cast i32 1))) ns))))

; title-ref is a JS string (the trimmed input value); it becomes the label text.
(defn add-todo [(title-ref externref)] (-> i32)
  (let [i (free-slot)
        t (slot i)
        li (create "li")
        toggle (create "input")
        label (create "label")
        destroy (create "button")]
    (set-attr! toggle "type" "checkbox")
    (add-class! toggle "toggle")
    (set-text-ref! label title-ref)
    (add-class! destroy "destroy")
    (set-text! destroy "×")
    (append! li toggle)
    (append! li label)
    (append! li destroy)
    (add-listener! toggle "change" (make-cb "on_toggle" i))
    (add-listener! destroy "click" (make-cb "on_destroy" i))
    (primitive/store! (primitive/field t used) (primitive/cast i32 1))
    (primitive/store! (primitive/field t done) (primitive/cast i32 0))
    (primitive/store! (primitive/field t li) (retain li))
    (append! (deref (primitive/load (primitive/field (store) ul))) li)
    (update-count!)))

(defn drop-slot! [(t (ptr Todo))] (-> i32)
  (remove! (deref (primitive/load (primitive/field t li))))
  (unretain (primitive/load (primitive/field t li)))
  (primitive/store! (primitive/field t used) (primitive/cast i32 0))
  (primitive/cast i32 0))    ; store! yields unit since std-12; return an explicit i32 (callers ignore it)

; ---- exported event handlers (userdata:i32, event:externref) ----
(defn on-new [(userdata i32) (evt externref)] (-> i64)
  (if (primitive/icmp-eq (prop-int evt "keyCode") (primitive/cast i32 13))
    (let [input (js-get evt "target")
          val (js-call (js-get input "value") "trim")  ; input.value.trim()
          len (js-int (js-get val "length"))]
      (if (primitive/icmp-gt len (primitive/cast i32 0)) (do (add-todo val) (set-value! input "") 0) 0))
    0)
  0)

(defn on-toggle [(idx i32) (evt externref)] (-> i64)
  (let [t (slot idx) li (deref (primitive/load (primitive/field t li)))]
    (primitive/store! (primitive/field t done) (primitive/ixor (primitive/load (primitive/field t done)) (primitive/cast i32 1)))
    (if (primitive/icmp-ne (primitive/load (primitive/field t done)) (primitive/cast i32 0))
      (add-class! li "completed")
      (remove-class! li "completed")))
  (update-count!)
  0)

(defn on-destroy [(idx i32) (evt externref)] (-> i64) (drop-slot! (slot idx)) (update-count!) 0)

(defn on-filter [(mode i32) (evt externref)] (-> i64)
  (let [ul (deref (primitive/load (primitive/field (store) ul)))]
    (if (primitive/icmp-eq mode (primitive/cast i32 0))
      (set-class! ul "todo-list")
      (if (primitive/icmp-eq mode (primitive/cast i32 1))
        (set-class! ul "todo-list filtered-active")
        (set-class! ul "todo-list filtered-completed"))))
  0)

(defn on-clear [(userdata i32) (evt externref)] (-> i64)
  (let [(mut i) (primitive/cast i32 0) ns (primitive/load (primitive/field (store) nslots))]
    (loop (if (primitive/icmp-ge (primitive/load i) ns)
            (break)
            (do
              (let [t (slot (primitive/load i))]
                (if (and (primitive/icmp-ne (primitive/load (primitive/field t used)) (primitive/cast i32 0))
                         (primitive/icmp-ne (primitive/load (primitive/field t done)) (primitive/cast i32 0)))
                  (drop-slot! t)
                  0))
              (primitive/store! i (primitive/iadd (primitive/load i) (primitive/cast i32 1)))))))
  (update-count!)
  0)

; ---- one-shot page construction ----
(defn mk-filter [(parent externref) (label (slice u8)) (mode i32)] (-> externref)
  (let [li (create "li") a (create "a")]
    (set-text! a label)
    (set-attr! a "href" "#")
    (append! li a)
    (append! parent li)
    (on! a "click" "on_filter" mode)))

(defn main [] (-> i64)
  (let [root (body)
        app (create "section")
        header (create "header")
        h1 (create "h1")
        input (create "input")
        main-sec (create "section")
        ul (create "ul")
        footer (create "footer")
        cnt (create "span")
        counter (create "strong")
        suffix (create "span")
        filters (create "ul")
        clear (create "button")]
    (add-class! app "todoapp")
    (append! root app)
    (add-class! header "header")
    (append! app header)
    (set-text! h1 "todos")
    (append! header h1)
    (add-class! input "new-todo")
    (set-attr! input "placeholder" "What needs to be done?")
    (append! header input)
    (on! input "keydown" "on_new" (primitive/cast i32 0))
    (add-class! main-sec "main")
    (append! app main-sec)
    (add-class! ul "todo-list")
    (append! main-sec ul)
    (add-class! footer "footer")
    (append! app footer)
    (add-class! cnt "todo-count")
    (append! footer cnt)
    (set-text! counter "0")
    (append! cnt counter)
    (set-text! suffix " items left")
    (append! cnt suffix)
    (add-class! filters "filters")
    (append! footer filters)
    (mk-filter filters "All" (primitive/cast i32 0))
    (mk-filter filters "Active" (primitive/cast i32 1))
    (mk-filter filters "Completed" (primitive/cast i32 2))
    (add-class! clear "clear-completed")
    (set-text! clear "Clear completed")
    (append! footer clear)
    (on! clear "click" "on_clear" (primitive/cast i32 0))
    ; persist the refs the handlers reach for later
    (primitive/store! (primitive/field (store) ul) (retain ul))
    (primitive/store! (primitive/field (store) counter) (retain counter))
    (primitive/store! (primitive/field (store) nslots) (primitive/cast i32 0))
    0))

(export-c [on-new :as "on_new"]
          [on-toggle :as "on_toggle"]
          [on-destroy :as "on_destroy"]
          [on-filter :as "on_filter"]
          [on-clear :as "on_clear"])
