; clox.coil — a port of clox (Crafting Interpreters, Part III bytecode VM) to Coil.
; Single file: clox has circular deps (value<->object<->table, memory<->all), so
; one module sidesteps import cycles. Build with the SELF-HOSTED build/bin/coil (char lits).
;
; Observable behavior is byte-identical to the reference C clox. All program output
; goes through libc write(1)/write(2) + snprintf("%g", ...) so numbers, errors, and
; stdout/stderr separation match exactly.
(module app)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)

; ============================ libc FFI ======================================
(extern write :cc c [i32 (ptr i8) isize] (-> isize))
(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))
(extern strlen :cc c [(ptr i8)] (-> i64))
(extern memcpy :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))
(extern malloc :cc c [i64] (-> (ptr i8)))
(extern realloc :cc c [(ptr i8) i64] (-> (ptr i8)))
(extern free :cc c [(ptr i8)] (-> void))
(extern strtod :cc c [(ptr i8) (ptr (ptr i8))] (-> f64))
(extern exit :cc c [i32] (-> void))
(extern clock :cc c [] (-> i64))

; ============================ output helpers ================================
; fd 1 = stdout, fd 2 = stderr. All program output funnels through these.
(defn w-bytes [(fd i64) (p (ptr u8)) (n i64)] (-> i64) (write (primitive/cast i32 fd) (primitive/cast (ptr i8) p) n) 0)
(defn w-cstr [(fd i64) (s (ptr i8))] (-> i64) (write (primitive/cast i32 fd) s (strlen s)) 0)
(defn w-num [(fd i64) (x f64)] (-> i64)
  (let [buf (alloc/stack (array u8 32))
        n (snprintf (primitive/cast (ptr i8) (primitive/index buf 0)) 32 c"%g" x)]
    (write (primitive/cast i32 fd) (primitive/cast (ptr i8) (primitive/index buf 0)) (primitive/cast i64 n))
    0))
(defn w-int [(fd i64) (v i64)] (-> i64)
  (let [buf (alloc/stack (array u8 32))
        n (snprintf (primitive/cast (ptr i8) (primitive/index buf 0)) 32 c"%d" (primitive/cast i32 v))]
    (write (primitive/cast i32 fd) (primitive/cast (ptr i8) (primitive/index buf 0)) (primitive/cast i64 n))
    0))

; ============================ opcodes =======================================
(const OP_CONSTANT 0)
(const OP_NIL 1)
(const OP_TRUE 2)
(const OP_FALSE 3)
(const OP_POP 4)
(const OP_GET_LOCAL 5)
(const OP_SET_LOCAL 6)
(const OP_GET_GLOBAL 7)
(const OP_DEFINE_GLOBAL 8)
(const OP_SET_GLOBAL 9)
(const OP_GET_UPVALUE 10)
(const OP_SET_UPVALUE 11)
(const OP_GET_PROPERTY 12)
(const OP_SET_PROPERTY 13)
(const OP_GET_SUPER 14)
(const OP_EQUAL 15)
(const OP_GREATER 16)
(const OP_LESS 17)
(const OP_ADD 18)
(const OP_SUBTRACT 19)
(const OP_MULTIPLY 20)
(const OP_DIVIDE 21)
(const OP_NOT 22)
(const OP_NEGATE 23)
(const OP_PRINT 24)
(const OP_JUMP 25)
(const OP_JUMP_IF_FALSE 26)
(const OP_LOOP 27)
(const OP_CALL 28)
(const OP_INVOKE 29)
(const OP_SUPER_INVOKE 30)
(const OP_CLOSURE 31)
(const OP_CLOSE_UPVALUE 32)
(const OP_RETURN 33)
(const OP_CLASS 34)
(const OP_INHERIT 35)
(const OP_METHOD 36)

; ============================ obj types =====================================
(const OBJ_BOUND_METHOD 0)
(const OBJ_CLASS 1)
(const OBJ_CLOSURE 2)
(const OBJ_FUNCTION 3)
(const OBJ_INSTANCE 4)
(const OBJ_NATIVE 5)
(const OBJ_STRING 6)
(const OBJ_UPVALUE 7)

(const UINT8_COUNT 256)
(const FRAMES_MAX 64)
(const STACK_MAX 16384)  ; FRAMES_MAX * UINT8_COUNT
(const U32_MASK 4294967295)

; ============================ core data types ===============================
(defstruct Obj [(kind i64) (is-marked bool) (next (ptr Obj))])

; Value is NaN-boxed into a single 64-bit word — exactly clox's representation
; (typedef uint64_t Value). A quiet-NaN with tag bits encodes nil/bool/obj;
; any other bit pattern is an IEEE double. Keeps Value at 8 bytes (vs 16 for a
; tagged union), so the stack and every push/pop move half the memory.
(const QNAN 0x7ffc000000000000)
(const SIGN_BIT 0x8000000000000000)
(const QNAN_SIGN 0xfffc000000000000)  ; QNAN | SIGN_BIT
(const NOT_QNAN_SIGN 0x0003ffffffffffff)  ; ~(QNAN | SIGN_BIT)
(const NIL_VAL 0x7ffc000000000001)  ; QNAN | 1
(const FALSE_VAL 0x7ffc000000000002)  ; QNAN | 2
(const TRUE_VAL 0x7ffc000000000003)  ; QNAN | 3

; f64<->i64 bit reinterpret (NOT a numeric cast). Uses a static scratch cell so
; it never allocas (safe to inline into the VM loop, unlike alloc-stack).
(defn bc-cell [] (-> (ptr i64)) (alloc/static i64))
(defn f64-to-bits [(x f64)] (-> i64) (primitive/store! (primitive/cast (ptr f64) (bc-cell)) x) (primitive/load (bc-cell)))
(defn bits-to-f64 [(b i64)] (-> f64) (primitive/store! (bc-cell) b) (primitive/load (primitive/cast (ptr f64) (bc-cell))))

(defn VNil [] (-> i64) NIL_VAL)
(defn VBool [(b bool)] (-> i64) (if b TRUE_VAL FALSE_VAL))
(defn VNumber [(n f64)] (-> i64) (f64-to-bits n))
(defn VObj [(o (ptr Obj))] (-> i64) (| SIGN_BIT (| QNAN (primitive/cast i64 o))))

(defstruct ValueArray [(capacity i64) (count i64) (values (ptr i64))])
(defstruct Chunk [(count i64) (capacity i64) (code (ptr u8)) (lines (ptr i64)) (constants ValueArray)])

(defstruct Entry [(key (ptr ObjString)) (value i64)])
(defstruct Table [(count i64) (capacity i64) (entries (ptr Entry))])

(defstruct ObjString [(obj Obj) (length i64) (chars (ptr u8)) (hash i64)])
(defstruct ObjFunction [(obj Obj) (arity i64) (upvalue-count i64) (chunk Chunk) (name (ptr ObjString))])
(defstruct ObjNative [(obj Obj) (function (fnptr c [i64 (ptr i64)] i64))])
(defstruct ObjUpvalue [(obj Obj) (location (ptr i64)) (closed i64) (next (ptr ObjUpvalue))])
(defstruct ObjClosure [(obj Obj) (function (ptr ObjFunction)) (upvalues (ptr (ptr ObjUpvalue))) (upvalue-count i64)])
(defstruct ObjClass [(obj Obj) (name (ptr ObjString)) (methods Table)])
(defstruct ObjInstance [(obj Obj) (klass (ptr ObjClass)) (fields Table)])
(defstruct ObjBoundMethod [(obj Obj) (receiver i64) (method (ptr ObjClosure))])

(defstruct CallFrame [(closure (ptr ObjClosure)) (ip (ptr u8)) (slots (ptr i64))])
(defstruct VM
  [(frames (array CallFrame 64))
   (frame-count i64)
   (stack (array i64 16384))
   (stack-top (ptr i64))
   (globals Table)
   (strings Table)
   (init-string (ptr ObjString))
   (open-upvalues (ptr ObjUpvalue))
   (bytes-allocated i64)
   (next-gc i64)
   (objects (ptr Obj))
   (gray-count i64)
   (gray-capacity i64)
   (gray-stack (ptr (ptr Obj)))])

; The one global VM (clox's `VM vm;`). alloc-static -> one stable global cell.
(defn vm [] (-> (ptr VM)) (alloc/static VM))

; ============================ Value helpers =================================
(defn null-obj [] (-> (ptr Obj)) (primitive/cast (ptr Obj) 0))
(defn is-bool [(v i64)] (-> bool) (= (| v 1) TRUE_VAL))
(defn is-nil [(v i64)] (-> bool) (= v NIL_VAL))
(defn is-number [(v i64)] (-> bool) (!= (& v QNAN) QNAN))
(defn is-obj [(v i64)] (-> bool) (= (& v QNAN_SIGN) QNAN_SIGN))
(defn as-bool [(v i64)] (-> bool) (= v TRUE_VAL))
(defn as-number [(v i64)] (-> f64) (bits-to-f64 v))
(defn as-obj [(v i64)] (-> (ptr Obj)) (primitive/cast (ptr Obj) (& v NOT_QNAN_SIGN)))

(defn obj-kind [(v i64)] (-> i64) (primitive/load (primitive/field (as-obj v) kind)))
(defn is-obj-kind [(v i64) (k i64)] (-> bool) (if (is-obj v) (= (obj-kind v) k) false))
(defn is-string [(v i64)] (-> bool) (is-obj-kind v OBJ_STRING))
(defn as-string [(v i64)] (-> (ptr ObjString)) (primitive/cast (ptr ObjString) (as-obj v)))

; ============================ memory ========================================
(defn grow-capacity [(c i64)] (-> i64) (if (< c 8) 8 (* c 2)))

(defn gc-stress-cell [] (-> (ptr i64)) (alloc/static i64))  ; DEBUG_STRESS_GC toggle
(const GC_HEAP_GROW_FACTOR 2)

; clox reallocate(pointer, oldSize, newSize) — with GC trigger.
(defn reallocate [(pointer (ptr i8)) (old-size i64) (new-size i64)] (-> (ptr i8))
  (primitive/store! (primitive/field (vm) bytes-allocated) (+ (primitive/load (primitive/field (vm) bytes-allocated)) (- new-size old-size)))
  (if (> new-size old-size)
    (if (or (!= (primitive/load (gc-stress-cell)) 0) (> (primitive/load (primitive/field (vm) bytes-allocated)) (primitive/load (primitive/field (vm) next-gc))))
      (collect-garbage)
      0)
    0)
  (if (= new-size 0)
    (do (primitive/free pointer) (primitive/cast (ptr i8) 0))
    (let [result (realloc pointer new-size)]
      (if (= (primitive/cast i64 result) 0) (do (exit (primitive/cast i32 1)) result) result))))

(defn allocate-object [(size i64) (otype i64)] (-> (ptr Obj))
  (let [object (primitive/cast (ptr Obj) (reallocate (primitive/cast (ptr i8) 0) 0 size))]
    (primitive/store! (primitive/field object kind) otype)
    (primitive/store! (primitive/field object is-marked) false)
    (primitive/store! (primitive/field object next) (primitive/load (primitive/field (vm) objects)))
    (primitive/store! (primitive/field (vm) objects) object)
    object))

; ============================ ValueArray ====================================
(defn init-value-array [(array (ptr ValueArray))] (-> i64)
  (primitive/store! (primitive/field array values) (primitive/cast (ptr i64) 0))
  (primitive/store! (primitive/field array capacity) 0)
  (primitive/store! (primitive/field array count) 0)
  0)
(defn write-value-array [(array (ptr ValueArray)) (value i64)] (-> i64)
  (if (< (primitive/load (primitive/field array capacity)) (+ (primitive/load (primitive/field array count)) 1))
    (let [old-cap (primitive/load (primitive/field array capacity)) new-cap (grow-capacity old-cap)]
      (primitive/store! (primitive/field array capacity) new-cap)
      (primitive/store! (primitive/field array values)
              (primitive/cast (ptr i64)
                    (reallocate (primitive/cast (ptr i8) (primitive/load (primitive/field array values)))
                                (* (primitive/sizeof i64) old-cap)
                                (* (primitive/sizeof i64) new-cap))))
      0)
    0)
  (primitive/store! (primitive/index (primitive/load (primitive/field array values)) (primitive/load (primitive/field array count))) value)
  (primitive/store! (primitive/field array count) (+ (primitive/load (primitive/field array count)) 1))
  0)
(defn free-value-array [(array (ptr ValueArray))] (-> i64)
  (reallocate (primitive/cast (ptr i8) (primitive/load (primitive/field array values))) (* (primitive/sizeof i64) (primitive/load (primitive/field array capacity))) 0)
  (init-value-array array))

; ============================ Chunk =========================================
(defn init-chunk [(chunk (ptr Chunk))] (-> i64)
  (primitive/store! (primitive/field chunk count) 0)
  (primitive/store! (primitive/field chunk capacity) 0)
  (primitive/store! (primitive/field chunk code) (primitive/cast (ptr u8) 0))
  (primitive/store! (primitive/field chunk lines) (primitive/cast (ptr i64) 0))
  (init-value-array (primitive/field chunk constants))
  0)
(defn free-chunk [(chunk (ptr Chunk))] (-> i64)
  (reallocate (primitive/cast (ptr i8) (primitive/load (primitive/field chunk code))) (primitive/load (primitive/field chunk capacity)) 0)
  (reallocate (primitive/cast (ptr i8) (primitive/load (primitive/field chunk lines))) (* (primitive/sizeof i64) (primitive/load (primitive/field chunk capacity))) 0)
  (free-value-array (primitive/field chunk constants))
  (init-chunk chunk))
(defn write-chunk [(chunk (ptr Chunk)) (byte i64) (line i64)] (-> i64)
  (if (< (primitive/load (primitive/field chunk capacity)) (+ (primitive/load (primitive/field chunk count)) 1))
    (let [old-cap (primitive/load (primitive/field chunk capacity)) new-cap (grow-capacity old-cap)]
      (primitive/store! (primitive/field chunk capacity) new-cap)
      (primitive/store! (primitive/field chunk code)
              (primitive/cast (ptr u8) (reallocate (primitive/cast (ptr i8) (primitive/load (primitive/field chunk code))) old-cap new-cap)))
      (primitive/store! (primitive/field chunk lines)
              (primitive/cast (ptr i64)
                    (reallocate (primitive/cast (ptr i8) (primitive/load (primitive/field chunk lines)))
                                (* (primitive/sizeof i64) old-cap)
                                (* (primitive/sizeof i64) new-cap))))
      0)
    0)
  (primitive/store! (primitive/index (primitive/load (primitive/field chunk code)) (primitive/load (primitive/field chunk count))) (primitive/cast u8 byte))
  (primitive/store! (primitive/index (primitive/load (primitive/field chunk lines)) (primitive/load (primitive/field chunk count))) line)
  (primitive/store! (primitive/field chunk count) (+ (primitive/load (primitive/field chunk count)) 1))
  0)
(defn add-constant [(chunk (ptr Chunk)) (value i64)] (-> i64)
  (push value)
  (write-value-array (primitive/field chunk constants) value)
  (pop)
  (- (primitive/load (primitive/field (primitive/field chunk constants) count)) 1))

; ============================ stack =========================================
(defn push [(value i64)] (-> i64)
  (primitive/store! (primitive/load (primitive/field (vm) stack-top)) value)
  (primitive/store! (primitive/field (vm) stack-top) (primitive/index (primitive/load (primitive/field (vm) stack-top)) 1))
  0)
(defn pop [] (-> i64)
  (primitive/store! (primitive/field (vm) stack-top) (primitive/index (primitive/load (primitive/field (vm) stack-top)) -1))
  (primitive/load (primitive/load (primitive/field (vm) stack-top))))
(defn peek [(distance i64)] (-> i64)
  (primitive/load (primitive/index (primitive/load (primitive/field (vm) stack-top)) (- -1 distance))))
(defn reset-stack [] (-> i64)
  (primitive/store! (primitive/field (vm) stack-top) (primitive/index (primitive/field (vm) stack) 0))
  (primitive/store! (primitive/field (vm) frame-count) 0)
  (primitive/store! (primitive/field (vm) open-upvalues) (primitive/cast (ptr ObjUpvalue) 0))
  0)

; ============================ Table =========================================
(defn init-table [(table (ptr Table))] (-> i64)
  (primitive/store! (primitive/field table count) 0)
  (primitive/store! (primitive/field table capacity) 0)
  (primitive/store! (primitive/field table entries) (primitive/cast (ptr Entry) 0))
  0)
(defn free-table [(table (ptr Table))] (-> i64)
  (reallocate (primitive/cast (ptr i8) (primitive/load (primitive/field table entries))) (* (primitive/sizeof Entry) (primitive/load (primitive/field table capacity))) 0)
  (init-table table))

(defn find-entry [(entries (ptr Entry)) (capacity i64) (key (ptr ObjString))] (-> (ptr Entry))
  (let [(mut index) (& (primitive/load (primitive/field key hash)) (- capacity 1))
        (mut tombstone) (primitive/cast (ptr Entry) 0)
        (mut result) (primitive/cast (ptr Entry) 0)]
    (loop (let [entry (primitive/index entries (primitive/load index))]
            (if (= (primitive/cast i64 (primitive/load (primitive/field entry key))) 0)
              (if (is-nil (primitive/load (primitive/field entry value)))
                (do (primitive/store! result (if (= (primitive/cast i64 (primitive/load tombstone)) 0) entry (primitive/load tombstone))) (break))
                (do
                  (if (= (primitive/cast i64 (primitive/load tombstone)) 0) (do (primitive/store! tombstone entry) 0) 0)
                  (primitive/store! index (& (+ (primitive/load index) 1) (- capacity 1)))))
              (if (= (primitive/cast i64 (primitive/load (primitive/field entry key))) (primitive/cast i64 key))
                (do (primitive/store! result entry) (break))
                (primitive/store! index (& (+ (primitive/load index) 1) (- capacity 1)))))))
    (primitive/load result)))

(defn table-get [(table (ptr Table)) (key (ptr ObjString)) (value (ptr i64))] (-> bool)
  (if (= (primitive/load (primitive/field table count)) 0)
    false
    (let [entry (find-entry (primitive/load (primitive/field table entries)) (primitive/load (primitive/field table capacity)) key)]
      (if (= (primitive/cast i64 (primitive/load (primitive/field entry key))) 0)
        false
        (do (primitive/store! value (primitive/load (primitive/field entry value))) true)))))

(defn adjust-capacity [(table (ptr Table)) (capacity i64)] (-> i64)
  (let [entries (primitive/cast (ptr Entry) (reallocate (primitive/cast (ptr i8) 0) 0 (* (primitive/sizeof Entry) capacity))) (mut i) 0]
    (loop (if (>= (primitive/load i) capacity)
            (break)
            (do
              (primitive/store! (primitive/field (primitive/index entries (primitive/load i)) key) (primitive/cast (ptr ObjString) 0))
              (primitive/store! (primitive/field (primitive/index entries (primitive/load i)) value) (VNil))
              (primitive/store! i (+ (primitive/load i) 1)))))
    (primitive/store! (primitive/field table count) 0)
    (primitive/store! i 0)
    (loop (if (>= (primitive/load i) (primitive/load (primitive/field table capacity)))
            (break)
            (let [entry (primitive/index (primitive/load (primitive/field table entries)) (primitive/load i))]
              (if (= (primitive/cast i64 (primitive/load (primitive/field entry key))) 0)
                (primitive/store! i (+ (primitive/load i) 1))
                (let [dest (find-entry entries capacity (primitive/load (primitive/field entry key)))]
                  (primitive/store! (primitive/field dest key) (primitive/load (primitive/field entry key)))
                  (primitive/store! (primitive/field dest value) (primitive/load (primitive/field entry value)))
                  (primitive/store! (primitive/field table count) (+ (primitive/load (primitive/field table count)) 1))
                  (primitive/store! i (+ (primitive/load i) 1)))))))
    (reallocate (primitive/cast (ptr i8) (primitive/load (primitive/field table entries))) (* (primitive/sizeof Entry) (primitive/load (primitive/field table capacity))) 0)
    (primitive/store! (primitive/field table entries) entries)
    (primitive/store! (primitive/field table capacity) capacity)
    0))

(defn table-set [(table (ptr Table)) (key (ptr ObjString)) (value i64)] (-> bool)
  (if (> (* (+ (primitive/load (primitive/field table count)) 1) 4) (* (primitive/load (primitive/field table capacity)) 3))
    (adjust-capacity table (grow-capacity (primitive/load (primitive/field table capacity))))
    0)
  (let [entry (find-entry (primitive/load (primitive/field table entries)) (primitive/load (primitive/field table capacity)) key)
        is-new-key (= (primitive/cast i64 (primitive/load (primitive/field entry key))) 0)]
    (if (and is-new-key (is-nil (primitive/load (primitive/field entry value))))
      (primitive/store! (primitive/field table count) (+ (primitive/load (primitive/field table count)) 1))
      0)
    (primitive/store! (primitive/field entry key) key)
    (primitive/store! (primitive/field entry value) value)
    is-new-key))

(defn table-delete [(table (ptr Table)) (key (ptr ObjString))] (-> bool)
  (if (= (primitive/load (primitive/field table count)) 0)
    false
    (let [entry (find-entry (primitive/load (primitive/field table entries)) (primitive/load (primitive/field table capacity)) key)]
      (if (= (primitive/cast i64 (primitive/load (primitive/field entry key))) 0)
        false
        (do
          (primitive/store! (primitive/field entry key) (primitive/cast (ptr ObjString) 0))
          (primitive/store! (primitive/field entry value) (VBool true))
          true)))))

(defn table-add-all [(from (ptr Table)) (to (ptr Table))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (primitive/load i) (primitive/load (primitive/field from capacity)))
            (break)
            (let [entry (primitive/index (primitive/load (primitive/field from entries)) (primitive/load i))]
              (if (!= (primitive/cast i64 (primitive/load (primitive/field entry key))) 0)
                (do (table-set to (primitive/load (primitive/field entry key)) (primitive/load (primitive/field entry value))) 0)
                0)
              (primitive/store! i (+ (primitive/load i) 1))))))
  0)

(defn table-find-string [(table (ptr Table)) (chars (ptr u8)) (length i64) (hash i64)] (-> (ptr ObjString))
  (if (= (primitive/load (primitive/field table count)) 0)
    (primitive/cast (ptr ObjString) 0)
    (let [(mut index) (& hash (- (primitive/load (primitive/field table capacity)) 1)) (mut result) (primitive/cast (ptr ObjString) 0) (mut go) true]
      (loop (let [entry (primitive/index (primitive/load (primitive/field table entries)) (primitive/load index))]
              (if (= (primitive/cast i64 (primitive/load (primitive/field entry key))) 0)
                (if (is-nil (primitive/load (primitive/field entry value))) (do (primitive/store! result (primitive/cast (ptr ObjString) 0)) (break)) 0)
                (let [k (primitive/load (primitive/field entry key))]
                  (if (and (= (primitive/load (primitive/field k length)) length)
                           (and (= (primitive/load (primitive/field k hash)) hash)
                                (= (mem-cmp (primitive/load (primitive/field k chars)) chars length) 0)))
                    (do (primitive/store! result k) (break))
                    0)))
              (primitive/store! index (& (+ (primitive/load index) 1) (- (primitive/load (primitive/field table capacity)) 1)))))
      (primitive/load result))))

; memcmp returning 0 iff equal over length bytes
(defn mem-cmp [(a (ptr u8)) (b (ptr u8)) (length i64)] (-> i64)
  (let [(mut i) 0 (mut d) 0]
    (loop (if (>= (primitive/load i) length)
            (break)
            (let [ca (primitive/cast i64 (primitive/load (primitive/index a (primitive/load i)))) cb (primitive/cast i64 (primitive/load (primitive/index b (primitive/load i))))]
              (if (!= ca cb) (do (primitive/store! d (- ca cb)) (break)) (primitive/store! i (+ (primitive/load i) 1))))))
    (primitive/load d)))

; ============================ strings / interning ===========================
(defn hash-string [(key (ptr u8)) (length i64)] (-> i64)
  (let [(mut h) 2166136261 (mut i) 0]
    (loop (if (>= (primitive/load i) length)
            (break)
            (do
              (primitive/store! h (& (^ (primitive/load h) (primitive/cast i64 (primitive/load (primitive/index key (primitive/load i))))) U32_MASK))
              (primitive/store! h (& (* (primitive/load h) 16777619) U32_MASK))
              (primitive/store! i (+ (primitive/load i) 1)))))
    (primitive/load h)))

(defn allocate-string [(chars (ptr u8)) (length i64) (hash i64)] (-> (ptr ObjString))
  (let [string (primitive/cast (ptr ObjString) (allocate-object (primitive/sizeof ObjString) OBJ_STRING))]
    (primitive/store! (primitive/field string length) length)
    (primitive/store! (primitive/field string chars) chars)
    (primitive/store! (primitive/field string hash) hash)
    (push (VObj (primitive/cast (ptr Obj) string)))
    (table-set (primitive/field (vm) strings) string (VNil))
    (pop)
    string))

(defn take-string [(chars (ptr u8)) (length i64)] (-> (ptr ObjString))
  (let [hash (hash-string chars length)
        interned (table-find-string (primitive/field (vm) strings) chars length hash)]
    (if (!= (primitive/cast i64 interned) 0)
      (do (reallocate (primitive/cast (ptr i8) chars) (+ length 1) 0) interned)
      (allocate-string chars length hash))))

(defn copy-string [(chars (ptr u8)) (length i64)] (-> (ptr ObjString))
  (let [hash (hash-string chars length)
        interned (table-find-string (primitive/field (vm) strings) chars length hash)]
    (if (!= (primitive/cast i64 interned) 0)
      interned
      (let [heap-chars (primitive/cast (ptr u8) (reallocate (primitive/cast (ptr i8) 0) 0 (+ length 1)))]
        (memcpy (primitive/cast (ptr i8) heap-chars) (primitive/cast (ptr i8) chars) length)
        (primitive/store! (primitive/index heap-chars length) (primitive/cast u8 0))
        (allocate-string heap-chars length hash)))))

; ============================ object constructors ===========================
(defn new-function [] (-> (ptr ObjFunction))
  (let [function (primitive/cast (ptr ObjFunction) (allocate-object (primitive/sizeof ObjFunction) OBJ_FUNCTION))]
    (primitive/store! (primitive/field function arity) 0)
    (primitive/store! (primitive/field function upvalue-count) 0)
    (primitive/store! (primitive/field function name) (primitive/cast (ptr ObjString) 0))
    (init-chunk (primitive/field function chunk))
    function))
(defn new-native [(fn (fnptr c [i64 (ptr i64)] i64))] (-> (ptr ObjNative))
  (let [native (primitive/cast (ptr ObjNative) (allocate-object (primitive/sizeof ObjNative) OBJ_NATIVE))]
    (primitive/store! (primitive/field native function) fn)
    native))
(defn new-upvalue [(slot (ptr i64))] (-> (ptr ObjUpvalue))
  (let [upvalue (primitive/cast (ptr ObjUpvalue) (allocate-object (primitive/sizeof ObjUpvalue) OBJ_UPVALUE))]
    (primitive/store! (primitive/field upvalue closed) (VNil))
    (primitive/store! (primitive/field upvalue location) slot)
    (primitive/store! (primitive/field upvalue next) (primitive/cast (ptr ObjUpvalue) 0))
    upvalue))
(defn new-closure [(function (ptr ObjFunction))] (-> (ptr ObjClosure))
  (let [upvalues
          (primitive/cast (ptr (ptr ObjUpvalue))
                (reallocate (primitive/cast (ptr i8) 0) 0 (* (primitive/sizeof (ptr ObjUpvalue)) (primitive/load (primitive/field function upvalue-count)))))
        (mut i) 0]
    (loop (if (>= (primitive/load i) (primitive/load (primitive/field function upvalue-count)))
            (break)
            (do (primitive/store! (primitive/index upvalues (primitive/load i)) (primitive/cast (ptr ObjUpvalue) 0)) (primitive/store! i (+ (primitive/load i) 1)))))
    (let [closure (primitive/cast (ptr ObjClosure) (allocate-object (primitive/sizeof ObjClosure) OBJ_CLOSURE))]
      (primitive/store! (primitive/field closure function) function)
      (primitive/store! (primitive/field closure upvalues) upvalues)
      (primitive/store! (primitive/field closure upvalue-count) (primitive/load (primitive/field function upvalue-count)))
      closure)))
(defn new-class [(name (ptr ObjString))] (-> (ptr ObjClass))
  (let [klass (primitive/cast (ptr ObjClass) (allocate-object (primitive/sizeof ObjClass) OBJ_CLASS))]
    (primitive/store! (primitive/field klass name) name)
    (init-table (primitive/field klass methods))
    klass))
(defn new-instance [(klass (ptr ObjClass))] (-> (ptr ObjInstance))
  (let [instance (primitive/cast (ptr ObjInstance) (allocate-object (primitive/sizeof ObjInstance) OBJ_INSTANCE))]
    (primitive/store! (primitive/field instance klass) klass)
    (init-table (primitive/field instance fields))
    instance))
(defn new-bound-method [(receiver i64) (method (ptr ObjClosure))] (-> (ptr ObjBoundMethod))
  (let [bound (primitive/cast (ptr ObjBoundMethod) (allocate-object (primitive/sizeof ObjBoundMethod) OBJ_BOUND_METHOD))]
    (primitive/store! (primitive/field bound receiver) receiver)
    (primitive/store! (primitive/field bound method) method)
    bound))

; ============================ printing ======================================
(defn print-function [(fd i64) (function (ptr ObjFunction))] (-> i64)
  (if (= (primitive/cast i64 (primitive/load (primitive/field function name))) 0)
    (w-cstr fd c"<script>")
    (do
      (w-cstr fd c"<fn ")
      (w-bytes fd (primitive/load (primitive/field (primitive/load (primitive/field function name)) chars)) (primitive/load (primitive/field (primitive/load (primitive/field function name)) length)))
      (w-cstr fd c">"))))

(defn print-object [(fd i64) (value i64)] (-> i64)
  (let [k (obj-kind value)]
    (cond (= k OBJ_BOUND_METHOD)
            (print-function fd (primitive/load (primitive/field (primitive/load (primitive/field (primitive/cast (ptr ObjBoundMethod) (as-obj value)) method)) function)))
          (= k OBJ_CLASS)
            (let [nm (primitive/load (primitive/field (primitive/cast (ptr ObjClass) (as-obj value)) name))]
              (w-bytes fd (primitive/load (primitive/field nm chars)) (primitive/load (primitive/field nm length))))
          (= k OBJ_CLOSURE) (print-function fd (primitive/load (primitive/field (primitive/cast (ptr ObjClosure) (as-obj value)) function)))
          (= k OBJ_FUNCTION) (print-function fd (primitive/cast (ptr ObjFunction) (as-obj value)))
          (= k OBJ_INSTANCE)
            (let [nm (primitive/load (primitive/field (primitive/load (primitive/field (primitive/cast (ptr ObjInstance) (as-obj value)) klass)) name))]
              (do (w-bytes fd (primitive/load (primitive/field nm chars)) (primitive/load (primitive/field nm length))) (w-cstr fd c" instance")))
          (= k OBJ_NATIVE) (w-cstr fd c"<native fn>")
          (= k OBJ_STRING) (let [s (as-string value)] (w-bytes fd (primitive/load (primitive/field s chars)) (primitive/load (primitive/field s length))))
          (= k OBJ_UPVALUE) (w-cstr fd c"upvalue")
          (w-cstr fd c"?"))))

(defn print-value [(fd i64) (value i64)] (-> i64)
  (cond (is-bool value) (if (as-bool value) (w-cstr fd c"true") (w-cstr fd c"false"))
        (is-nil value) (w-cstr fd c"nil")
        (is-number value) (w-num fd (as-number value))
        (print-object fd value)))

; NaN-boxed valuesEqual: numbers compared as f64 (so nan != nan), else bit-equal.
(defn values-equal [(a i64) (b i64)] (-> bool)
  (if (and (is-number a) (is-number b))
    (primitive/fcmp-eq (as-number a) (as-number b))
    (= a b)))

; ============================ token types ===================================
(const TOKEN_LEFT_PAREN 0)
(const TOKEN_RIGHT_PAREN 1)
(const TOKEN_LEFT_BRACE 2)
(const TOKEN_RIGHT_BRACE 3)
(const TOKEN_COMMA 4)
(const TOKEN_DOT 5)
(const TOKEN_MINUS 6)
(const TOKEN_PLUS 7)
(const TOKEN_SEMICOLON 8)
(const TOKEN_SLASH 9)
(const TOKEN_STAR 10)
(const TOKEN_BANG 11)
(const TOKEN_BANG_EQUAL 12)
(const TOKEN_EQUAL 13)
(const TOKEN_EQUAL_EQUAL 14)
(const TOKEN_GREATER 15)
(const TOKEN_GREATER_EQUAL 16)
(const TOKEN_LESS 17)
(const TOKEN_LESS_EQUAL 18)
(const TOKEN_IDENTIFIER 19)
(const TOKEN_STRING 20)
(const TOKEN_NUMBER 21)
(const TOKEN_AND 22)
(const TOKEN_CLASS 23)
(const TOKEN_ELSE 24)
(const TOKEN_FALSE 25)
(const TOKEN_FOR 26)
(const TOKEN_FUN 27)
(const TOKEN_IF 28)
(const TOKEN_NIL 29)
(const TOKEN_OR 30)
(const TOKEN_PRINT 31)
(const TOKEN_RETURN 32)
(const TOKEN_SUPER 33)
(const TOKEN_THIS 34)
(const TOKEN_TRUE 35)
(const TOKEN_VAR 36)
(const TOKEN_WHILE 37)
(const TOKEN_ERROR 38)
(const TOKEN_EOF 39)

; ============================ scanner =======================================
(defstruct Token [(kind i64) (start (ptr u8)) (length i64) (line i64)])
(defstruct Scanner [(start (ptr u8)) (current (ptr u8)) (line i64)])
(defn scn [] (-> (ptr Scanner)) (alloc/static Scanner))

(defn init-scanner [(source (ptr u8))] (-> i64)
  (primitive/store! (primitive/field (scn) start) source)
  (primitive/store! (primitive/field (scn) current) source)
  (primitive/store! (primitive/field (scn) line) 1)
  0)

(defn is-alpha [(c i64)] (-> bool)
  (or (and (>= c \a) (<= c \z)) (or (and (>= c \A) (<= c \Z)) (= c \_))))
(defn is-digit [(c i64)] (-> bool) (and (>= c \0) (<= c \9)))

(defn scan-peek [] (-> i64) (primitive/cast i64 (primitive/load (primitive/load (primitive/field (scn) current)))))
(defn scan-peek-next [] (-> i64)
  (if (= (scan-peek) 0) 0 (primitive/cast i64 (primitive/load (primitive/index (primitive/load (primitive/field (scn) current)) 1)))))
(defn scan-at-end [] (-> bool) (= (scan-peek) 0))
(defn scan-advance [] (-> i64)
  (primitive/store! (primitive/field (scn) current) (primitive/index (primitive/load (primitive/field (scn) current)) 1))
  (primitive/cast i64 (primitive/load (primitive/index (primitive/load (primitive/field (scn) current)) -1))))
(defn scan-match [(expected i64)] (-> bool)
  (if (scan-at-end)
    false
    (if (!= (scan-peek) expected)
      false
      (do (primitive/store! (primitive/field (scn) current) (primitive/index (primitive/load (primitive/field (scn) current)) 1)) true))))

(defn make-token [(kind i64)] (-> Token)
  (let [(mut t) (primitive/zeroed Token)]
    (primitive/store! (primitive/field t kind) kind)
    (primitive/store! (primitive/field t start) (primitive/load (primitive/field (scn) start)))
    (primitive/store! (primitive/field t length) (- (primitive/cast i64 (primitive/load (primitive/field (scn) current))) (primitive/cast i64 (primitive/load (primitive/field (scn) start)))))
    (primitive/store! (primitive/field t line) (primitive/load (primitive/field (scn) line)))
    (primitive/load t)))
(defn error-token [(message (ptr u8))] (-> Token)
  (let [(mut t) (primitive/zeroed Token)]
    (primitive/store! (primitive/field t kind) TOKEN_ERROR)
    (primitive/store! (primitive/field t start) message)
    (primitive/store! (primitive/field t length) (strlen (primitive/cast (ptr i8) message)))
    (primitive/store! (primitive/field t line) (primitive/load (primitive/field (scn) line)))
    (primitive/load t)))

(defn skip-whitespace [] (-> i64)
  (loop (let [c (scan-peek)]
          (cond (= c \space) (do (scan-advance) 0)
                (= c \return) (do (scan-advance) 0)
                (= c \tab) (do (scan-advance) 0)
                (= c \newline) (do (primitive/store! (primitive/field (scn) line) (+ (primitive/load (primitive/field (scn) line)) 1)) (scan-advance) 0)
                (= c \/)
                  (if (= (scan-peek-next) \/)
                    (do (loop (if (and (!= (scan-peek) \newline) (not (scan-at-end))) (do (scan-advance) 0) (break))) 0)
                    (break))
                (break))))
  0)

(defn check-keyword [(start i64) (length i64) (rest (ptr u8)) (kind i64)] (-> i64)
  (if (and (= (- (primitive/cast i64 (primitive/load (primitive/field (scn) current))) (primitive/cast i64 (primitive/load (primitive/field (scn) start)))) (+ start length))
           (= (mem-cmp (primitive/index (primitive/load (primitive/field (scn) start)) start) rest length) 0))
    kind
    TOKEN_IDENTIFIER))

(defn cur-minus-start [] (-> i64)
  (- (primitive/cast i64 (primitive/load (primitive/field (scn) current))) (primitive/cast i64 (primitive/load (primitive/field (scn) start)))))
(defn start-char [(i i64)] (-> i64) (primitive/cast i64 (primitive/load (primitive/index (primitive/load (primitive/field (scn) start)) i))))

(defn identifier-type [] (-> i64)
  (let [c0 (start-char 0)]
    (cond (= c0 \a) (check-keyword 1 2 (primitive/cast (ptr u8) c"nd") TOKEN_AND)
          (= c0 \c) (check-keyword 1 4 (primitive/cast (ptr u8) c"lass") TOKEN_CLASS)
          (= c0 \e) (check-keyword 1 3 (primitive/cast (ptr u8) c"lse") TOKEN_ELSE)
          (= c0 \f)
            (if (> (cur-minus-start) 1)
              (let [c1 (start-char 1)]
                (cond (= c1 \a) (check-keyword 2 3 (primitive/cast (ptr u8) c"lse") TOKEN_FALSE)
                      (= c1 \o) (check-keyword 2 1 (primitive/cast (ptr u8) c"r") TOKEN_FOR)
                      (= c1 \u) (check-keyword 2 1 (primitive/cast (ptr u8) c"n") TOKEN_FUN)
                      TOKEN_IDENTIFIER))
              TOKEN_IDENTIFIER)
          (= c0 \i) (check-keyword 1 1 (primitive/cast (ptr u8) c"f") TOKEN_IF)
          (= c0 \n) (check-keyword 1 2 (primitive/cast (ptr u8) c"il") TOKEN_NIL)
          (= c0 \o) (check-keyword 1 1 (primitive/cast (ptr u8) c"r") TOKEN_OR)
          (= c0 \p) (check-keyword 1 4 (primitive/cast (ptr u8) c"rint") TOKEN_PRINT)
          (= c0 \r) (check-keyword 1 5 (primitive/cast (ptr u8) c"eturn") TOKEN_RETURN)
          (= c0 \s) (check-keyword 1 4 (primitive/cast (ptr u8) c"uper") TOKEN_SUPER)
          (= c0 \t)
            (if (> (cur-minus-start) 1)
              (let [c1 (start-char 1)]
                (cond (= c1 \h) (check-keyword 2 2 (primitive/cast (ptr u8) c"is") TOKEN_THIS)
                      (= c1 \r) (check-keyword 2 2 (primitive/cast (ptr u8) c"ue") TOKEN_TRUE)
                      TOKEN_IDENTIFIER))
              TOKEN_IDENTIFIER)
          (= c0 \v) (check-keyword 1 2 (primitive/cast (ptr u8) c"ar") TOKEN_VAR)
          (= c0 \w) (check-keyword 1 4 (primitive/cast (ptr u8) c"hile") TOKEN_WHILE)
          TOKEN_IDENTIFIER)))

(defn scan-identifier [] (-> Token)
  (loop (if (or (is-alpha (scan-peek)) (is-digit (scan-peek))) (do (scan-advance) 0) (break)))
  (make-token (identifier-type)))
(defn scan-number [] (-> Token)
  (loop (if (is-digit (scan-peek)) (do (scan-advance) 0) (break)))
  (if (and (= (scan-peek) \.) (is-digit (scan-peek-next)))
    (do (scan-advance) (loop (if (is-digit (scan-peek)) (do (scan-advance) 0) (break))))
    0)
  (make-token TOKEN_NUMBER))
(defn scan-string [] (-> Token)
  (loop (if (and (!= (scan-peek) \") (not (scan-at-end)))
          (do
            (if (= (scan-peek) \newline) (primitive/store! (primitive/field (scn) line) (+ (primitive/load (primitive/field (scn) line)) 1)) 0)
            (scan-advance)
            0)
          (break)))
  (if (scan-at-end)
    (error-token (primitive/cast (ptr u8) c"Unterminated string."))
    (do (scan-advance) (make-token TOKEN_STRING))))

(defn scan-token [] (-> Token)
  (skip-whitespace)
  (primitive/store! (primitive/field (scn) start) (primitive/load (primitive/field (scn) current)))
  (if (scan-at-end)
    (make-token TOKEN_EOF)
    (let [c (scan-advance)]
      (cond (is-alpha c) (scan-identifier)
            (is-digit c) (scan-number)
            (= c \() (make-token TOKEN_LEFT_PAREN)
            (= c \)) (make-token TOKEN_RIGHT_PAREN)
            (= c \{) (make-token TOKEN_LEFT_BRACE)
            (= c \}) (make-token TOKEN_RIGHT_BRACE)
            (= c \;) (make-token TOKEN_SEMICOLON)
            (= c \,) (make-token TOKEN_COMMA)
            (= c \.) (make-token TOKEN_DOT)
            (= c \-) (make-token TOKEN_MINUS)
            (= c \+) (make-token TOKEN_PLUS)
            (= c \/) (make-token TOKEN_SLASH)
            (= c \*) (make-token TOKEN_STAR)
            (= c \!) (make-token (if (scan-match \=) TOKEN_BANG_EQUAL TOKEN_BANG))
            (= c \=) (make-token (if (scan-match \=) TOKEN_EQUAL_EQUAL TOKEN_EQUAL))
            (= c \<) (make-token (if (scan-match \=) TOKEN_LESS_EQUAL TOKEN_LESS))
            (= c \>) (make-token (if (scan-match \=) TOKEN_GREATER_EQUAL TOKEN_GREATER))
            (= c \") (scan-string)
            (error-token (primitive/cast (ptr u8) c"Unexpected character."))))))

; ============================ compiler ======================================
(const PREC_NONE 0)
(const PREC_ASSIGNMENT 1)
(const PREC_OR 2)
(const PREC_AND 3)
(const PREC_EQUALITY 4)
(const PREC_COMPARISON 5)
(const PREC_TERM 6)
(const PREC_FACTOR 7)
(const PREC_UNARY 8)
(const PREC_CALL 9)
(const PREC_PRIMARY 10)

(const TYPE_FUNCTION 0)
(const TYPE_INITIALIZER 1)
(const TYPE_METHOD 2)
(const TYPE_SCRIPT 3)

(defstruct Parser [(current Token) (previous Token) (had-error bool) (panic-mode bool)])
(defstruct Local [(name Token) (depth i64) (is-captured bool)])
(defstruct CompUpvalue [(index i64) (is-local bool)])
(defstruct Compiler
  [(enclosing (ptr Compiler))
   (function (ptr ObjFunction))
   (kind i64)
   (locals (array Local 256))
   (local-count i64)
   (upvalues (array CompUpvalue 256))
   (scope-depth i64)])
(defstruct ClassCompiler [(enclosing (ptr ClassCompiler)) (has-superclass bool)])

(defn parser [] (-> (ptr Parser)) (alloc/static Parser))
(defn cur-comp-cell [] (-> (ptr (ptr Compiler))) (alloc/static (ptr Compiler)))
(defn cur-class-cell [] (-> (ptr (ptr ClassCompiler))) (alloc/static (ptr ClassCompiler)))
(defn ccomp [] (-> (ptr Compiler)) (primitive/load (cur-comp-cell)))
(defn cclass [] (-> (ptr ClassCompiler)) (primitive/load (cur-class-cell)))
(defn current-chunk [] (-> (ptr Chunk)) (primitive/field (primitive/load (primitive/field (ccomp) function)) chunk))

; forward-referenced (Coil resolves forward refs within a file)
(defn expression [] (-> i64) (parse-precedence PREC_ASSIGNMENT))

; ---- errors ----
(defn error-at [(token (ptr Token)) (message (ptr u8))] (-> i64)
  (if (primitive/load (primitive/field (parser) panic-mode))
    0
    (do
      (primitive/store! (primitive/field (parser) panic-mode) true)
      (w-cstr 2 c"[line ")
      (w-int 2 (primitive/load (primitive/field token line)))
      (w-cstr 2 c"] Error")
      (cond (= (primitive/load (primitive/field token kind)) TOKEN_EOF) (w-cstr 2 c" at end")
            (= (primitive/load (primitive/field token kind)) TOKEN_ERROR) 0
            (do (w-cstr 2 c" at '") (w-bytes 2 (primitive/load (primitive/field token start)) (primitive/load (primitive/field token length))) (w-cstr 2 c"'")))
      (w-cstr 2 c": ")
      (w-cstr 2 (primitive/cast (ptr i8) message))
      (w-cstr 2 c"\n")
      (primitive/store! (primitive/field (parser) had-error) true)
      0)))
(defn compile-error [(message (ptr u8))] (-> i64) (error-at (primitive/field (parser) previous) message))
(defn error-at-current [(message (ptr u8))] (-> i64) (error-at (primitive/field (parser) current) message))

(defn advance- [] (-> i64)
  (primitive/store! (primitive/field (parser) previous) (primitive/load (primitive/field (parser) current)))
  (loop (primitive/store! (primitive/field (parser) current) (scan-token))
    (if (!= (primitive/load (primitive/field (primitive/field (parser) current) kind)) TOKEN_ERROR)
      (break)
      (error-at-current (primitive/load (primitive/field (primitive/field (parser) current) start)))))
  0)
(defn consume [(kind i64) (message (ptr u8))] (-> i64)
  (if (= (primitive/load (primitive/field (primitive/field (parser) current) kind)) kind) (advance-) (error-at-current message)))
(defn check- [(kind i64)] (-> bool) (= (primitive/load (primitive/field (primitive/field (parser) current) kind)) kind))
(defn match- [(kind i64)] (-> bool) (if (check- kind) (do (advance-) true) false))

; ---- emit ----
(defn emit-byte [(byte i64)] (-> i64) (write-chunk (current-chunk) byte (primitive/load (primitive/field (primitive/field (parser) previous) line))))
(defn emit-bytes [(b1 i64) (b2 i64)] (-> i64) (emit-byte b1) (emit-byte b2))
(defn emit-loop [(loop-start i64)] (-> i64)
  (emit-byte OP_LOOP)
  (let [offset (+ (- (primitive/load (primitive/field (current-chunk) count)) loop-start) 2)]
    (if (> offset 65535) (compile-error (primitive/cast (ptr u8) c"Loop body too large.")) 0)
    (emit-byte (& (>> offset 8) 255))
    (emit-byte (& offset 255))))
(defn emit-jump [(instruction i64)] (-> i64)
  (emit-byte instruction)
  (emit-byte 255)
  (emit-byte 255)
  (- (primitive/load (primitive/field (current-chunk) count)) 2))
(defn emit-return [] (-> i64)
  (if (= (primitive/load (primitive/field (ccomp) kind)) TYPE_INITIALIZER) (emit-bytes OP_GET_LOCAL 0) (emit-byte OP_NIL))
  (emit-byte OP_RETURN))
(defn make-constant [(value i64)] (-> i64)
  (let [constant (add-constant (current-chunk) value)]
    (if (> constant 255) (do (compile-error (primitive/cast (ptr u8) c"Too many constants in one chunk.")) 0) constant)))
(defn emit-constant [(value i64)] (-> i64) (emit-bytes OP_CONSTANT (make-constant value)))
(defn patch-jump [(offset i64)] (-> i64)
  (let [jump (- (- (primitive/load (primitive/field (current-chunk) count)) offset) 2)]
    (if (> jump 65535) (compile-error (primitive/cast (ptr u8) c"Too much code to jump over.")) 0)
    (primitive/store! (primitive/index (primitive/load (primitive/field (current-chunk) code)) offset) (primitive/cast u8 (& (>> jump 8) 255)))
    (primitive/store! (primitive/index (primitive/load (primitive/field (current-chunk) code)) (+ offset 1)) (primitive/cast u8 (& jump 255)))
    0))

; ---- compiler state ----
(defn init-compiler [(compiler (ptr Compiler)) (kind i64)] (-> i64)
  (primitive/store! (primitive/field compiler enclosing) (ccomp))
  (primitive/store! (primitive/field compiler function) (primitive/cast (ptr ObjFunction) 0))
  (primitive/store! (primitive/field compiler kind) kind)
  (primitive/store! (primitive/field compiler local-count) 0)
  (primitive/store! (primitive/field compiler scope-depth) 0)
  (primitive/store! (primitive/field compiler function) (new-function))
  (primitive/store! (cur-comp-cell) compiler)
  (if (!= kind TYPE_SCRIPT)
    (do
      (primitive/store! (primitive/field (primitive/load (primitive/field compiler function)) name)
              (copy-string (primitive/load (primitive/field (primitive/field (parser) previous) start))
                           (primitive/load (primitive/field (primitive/field (parser) previous) length))))
      0)
    0)
  (let [local (primitive/index (primitive/field compiler locals) (primitive/load (primitive/field compiler local-count)))]
    (primitive/store! (primitive/field compiler local-count) (+ (primitive/load (primitive/field compiler local-count)) 1))
    (primitive/store! (primitive/field local depth) 0)
    (primitive/store! (primitive/field local is-captured) false)
    (if (!= kind TYPE_FUNCTION)
      (do
        (primitive/store! (primitive/field (primitive/field local name) start) (primitive/cast (ptr u8) c"this"))
        (primitive/store! (primitive/field (primitive/field local name) length) 4))
      (do (primitive/store! (primitive/field (primitive/field local name) start) (primitive/cast (ptr u8) c"")) (primitive/store! (primitive/field (primitive/field local name) length) 0))))
  0)
(defn end-compiler [] (-> (ptr ObjFunction))
  (emit-return)
  (let [function (primitive/load (primitive/field (ccomp) function))]
    (primitive/store! (cur-comp-cell) (primitive/load (primitive/field (ccomp) enclosing)))
    function))
(defn begin-scope [] (-> i64) (primitive/store! (primitive/field (ccomp) scope-depth) (+ (primitive/load (primitive/field (ccomp) scope-depth)) 1)))
(defn end-scope [] (-> i64)
  (primitive/store! (primitive/field (ccomp) scope-depth) (- (primitive/load (primitive/field (ccomp) scope-depth)) 1))
  (loop (if (and (> (primitive/load (primitive/field (ccomp) local-count)) 0)
                 (> (primitive/load (primitive/field (primitive/index (primitive/field (ccomp) locals) (- (primitive/load (primitive/field (ccomp) local-count)) 1)) depth))
                    (primitive/load (primitive/field (ccomp) scope-depth))))
          (do
            (if (primitive/load (primitive/field (primitive/index (primitive/field (ccomp) locals) (- (primitive/load (primitive/field (ccomp) local-count)) 1)) is-captured))
              (emit-byte OP_CLOSE_UPVALUE)
              (emit-byte OP_POP))
            (primitive/store! (primitive/field (ccomp) local-count) (- (primitive/load (primitive/field (ccomp) local-count)) 1)))
          (break)))
  0)

; ---- names / locals / upvalues ----
(defn identifier-constant [(name (ptr Token))] (-> i64)
  (make-constant (VObj (primitive/cast (ptr Obj) (copy-string (primitive/load (primitive/field name start)) (primitive/load (primitive/field name length)))))))
(defn identifiers-equal [(a (ptr Token)) (b (ptr Token))] (-> bool)
  (if (!= (primitive/load (primitive/field a length)) (primitive/load (primitive/field b length)))
    false
    (= (mem-cmp (primitive/load (primitive/field a start)) (primitive/load (primitive/field b start)) (primitive/load (primitive/field a length))) 0)))
(defn resolve-local [(compiler (ptr Compiler)) (name (ptr Token))] (-> i64)
  (let [(mut i) (- (primitive/load (primitive/field compiler local-count)) 1) (mut found) -1]
    (loop (if (< (primitive/load i) 0)
            (break)
            (let [local (primitive/index (primitive/field compiler locals) (primitive/load i))]
              (if (identifiers-equal name (primitive/field local name))
                (do
                  (if (= (primitive/load (primitive/field local depth)) -1)
                    (compile-error (primitive/cast (ptr u8) c"Can't read local variable in its own initializer."))
                    0)
                  (primitive/store! found (primitive/load i))
                  (break))
                (primitive/store! i (- (primitive/load i) 1))))))
    (primitive/load found)))
(defn add-upvalue [(compiler (ptr Compiler)) (index-val i64) (is-local bool)] (-> i64)
  (let [upvalue-count (primitive/load (primitive/field (primitive/load (primitive/field compiler function)) upvalue-count)) (mut i) 0 (mut found) -1]
    (loop (if (>= (primitive/load i) upvalue-count)
            (break)
            (let [upvalue (primitive/index (primitive/field compiler upvalues) (primitive/load i))]
              (if (and (= (primitive/load (primitive/field upvalue index)) index-val) (= (primitive/load (primitive/field upvalue is-local)) is-local))
                (do (primitive/store! found (primitive/load i)) (break))
                (primitive/store! i (+ (primitive/load i) 1))))))
    (if (>= (primitive/load found) 0)
      (primitive/load found)
      (if (= upvalue-count 256)
        (do (compile-error (primitive/cast (ptr u8) c"Too many closure variables in function.")) 0)
        (do
          (primitive/store! (primitive/field (primitive/index (primitive/field compiler upvalues) upvalue-count) is-local) is-local)
          (primitive/store! (primitive/field (primitive/index (primitive/field compiler upvalues) upvalue-count) index) index-val)
          (primitive/store! (primitive/field (primitive/load (primitive/field compiler function)) upvalue-count) (+ upvalue-count 1))
          upvalue-count)))))
(defn resolve-upvalue [(compiler (ptr Compiler)) (name (ptr Token))] (-> i64)
  (if (= (primitive/cast i64 (primitive/load (primitive/field compiler enclosing))) 0)
    -1
    (let [local (resolve-local (primitive/load (primitive/field compiler enclosing)) name)]
      (if (!= local -1)
        (do
          (primitive/store! (primitive/field (primitive/index (primitive/field (primitive/load (primitive/field compiler enclosing)) locals) local) is-captured) true)
          (add-upvalue compiler local true))
        (let [upvalue (resolve-upvalue (primitive/load (primitive/field compiler enclosing)) name)]
          (if (!= upvalue -1) (add-upvalue compiler upvalue false) -1))))))
(defn add-local [(name Token)] (-> i64)
  (if (= (primitive/load (primitive/field (ccomp) local-count)) 256)
    (compile-error (primitive/cast (ptr u8) c"Too many local variables in function."))
    (let [local (primitive/index (primitive/field (ccomp) locals) (primitive/load (primitive/field (ccomp) local-count)))]
      (primitive/store! (primitive/field (ccomp) local-count) (+ (primitive/load (primitive/field (ccomp) local-count)) 1))
      (primitive/store! (primitive/field local name) name)
      (primitive/store! (primitive/field local depth) -1)
      (primitive/store! (primitive/field local is-captured) false)
      0)))
(defn declare-variable [] (-> i64)
  (if (= (primitive/load (primitive/field (ccomp) scope-depth)) 0)
    0
    (let [name (primitive/field (parser) previous) (mut i) (- (primitive/load (primitive/field (ccomp) local-count)) 1) (mut stop) false]
      (loop (if (or (< (primitive/load i) 0) (primitive/load stop))
              (break)
              (let [local (primitive/index (primitive/field (ccomp) locals) (primitive/load i))]
                (if (and (!= (primitive/load (primitive/field local depth)) -1)
                         (< (primitive/load (primitive/field local depth)) (primitive/load (primitive/field (ccomp) scope-depth))))
                  (do (primitive/store! stop true) 0)
                  (do
                    (if (identifiers-equal name (primitive/field local name))
                      (compile-error (primitive/cast (ptr u8) c"Already a variable with this name in this scope."))
                      0)
                    (primitive/store! i (- (primitive/load i) 1)))))))
      (add-local (primitive/load name)))))
(defn parse-variable [(error-message (ptr u8))] (-> i64)
  (consume TOKEN_IDENTIFIER error-message)
  (declare-variable)
  (if (> (primitive/load (primitive/field (ccomp) scope-depth)) 0) 0 (identifier-constant (primitive/field (parser) previous))))
(defn mark-initialized [] (-> i64)
  (if (= (primitive/load (primitive/field (ccomp) scope-depth)) 0)
    0
    (primitive/store! (primitive/field (primitive/index (primitive/field (ccomp) locals) (- (primitive/load (primitive/field (ccomp) local-count)) 1)) depth)
            (primitive/load (primitive/field (ccomp) scope-depth)))))
(defn define-variable [(global i64)] (-> i64)
  (if (> (primitive/load (primitive/field (ccomp) scope-depth)) 0)
    (do (mark-initialized) 0)
    (emit-bytes OP_DEFINE_GLOBAL global)))
(defn argument-list [] (-> i64)
  (let [(mut arg-count) 0]
    (if (not (check- TOKEN_RIGHT_PAREN))
      (loop (expression)
        (if (= (primitive/load arg-count) 255) (compile-error (primitive/cast (ptr u8) c"Can't have more than 255 arguments.")) 0)
        (primitive/store! arg-count (+ (primitive/load arg-count) 1))
        (if (match- TOKEN_COMMA) 0 (break)))
      0)
    (consume TOKEN_RIGHT_PAREN (primitive/cast (ptr u8) c"Expect ')' after arguments."))
    (primitive/load arg-count)))

; ---- expressions (Pratt) ----
(defn p-and [(can-assign bool)] (-> i64)
  (let [end-jump (emit-jump OP_JUMP_IF_FALSE)]
    (emit-byte OP_POP)
    (parse-precedence PREC_AND)
    (patch-jump end-jump)))
(defn p-or [(can-assign bool)] (-> i64)
  (let [else-jump (emit-jump OP_JUMP_IF_FALSE) end-jump (emit-jump OP_JUMP)]
    (patch-jump else-jump)
    (emit-byte OP_POP)
    (parse-precedence PREC_OR)
    (patch-jump end-jump)))
(defn p-binary [(can-assign bool)] (-> i64)
  (let [operator-type (primitive/load (primitive/field (primitive/field (parser) previous) kind))]
    (parse-precedence (+ (rule-prec operator-type) 1))
    (cond (= operator-type TOKEN_BANG_EQUAL) (emit-bytes OP_EQUAL OP_NOT)
          (= operator-type TOKEN_EQUAL_EQUAL) (emit-byte OP_EQUAL)
          (= operator-type TOKEN_GREATER) (emit-byte OP_GREATER)
          (= operator-type TOKEN_GREATER_EQUAL) (emit-bytes OP_LESS OP_NOT)
          (= operator-type TOKEN_LESS) (emit-byte OP_LESS)
          (= operator-type TOKEN_LESS_EQUAL) (emit-bytes OP_GREATER OP_NOT)
          (= operator-type TOKEN_PLUS) (emit-byte OP_ADD)
          (= operator-type TOKEN_MINUS) (emit-byte OP_SUBTRACT)
          (= operator-type TOKEN_STAR) (emit-byte OP_MULTIPLY)
          (= operator-type TOKEN_SLASH) (emit-byte OP_DIVIDE)
          0)))
(defn p-call [(can-assign bool)] (-> i64)
  (let [arg-count (argument-list)] (emit-bytes OP_CALL arg-count)))
(defn p-dot [(can-assign bool)] (-> i64)
  (consume TOKEN_IDENTIFIER (primitive/cast (ptr u8) c"Expect property name after '.'."))
  (let [name (identifier-constant (primitive/field (parser) previous))]
    (cond (and can-assign (match- TOKEN_EQUAL)) (do (expression) (emit-bytes OP_SET_PROPERTY name))
          (match- TOKEN_LEFT_PAREN) (let [arg-count (argument-list)] (emit-bytes OP_INVOKE name) (emit-byte arg-count))
          (emit-bytes OP_GET_PROPERTY name))))
(defn p-literal [(can-assign bool)] (-> i64)
  (cond (= (primitive/load (primitive/field (primitive/field (parser) previous) kind)) TOKEN_FALSE) (emit-byte OP_FALSE)
        (= (primitive/load (primitive/field (primitive/field (parser) previous) kind)) TOKEN_NIL) (emit-byte OP_NIL)
        (= (primitive/load (primitive/field (primitive/field (parser) previous) kind)) TOKEN_TRUE) (emit-byte OP_TRUE)
        0))
(defn p-grouping [(can-assign bool)] (-> i64)
  (expression)
  (consume TOKEN_RIGHT_PAREN (primitive/cast (ptr u8) c"Expect ')' after expression.")))
(defn p-number [(can-assign bool)] (-> i64)
  (let [value (strtod (primitive/cast (ptr i8) (primitive/load (primitive/field (primitive/field (parser) previous) start))) (primitive/cast (ptr (ptr i8)) 0))]
    (emit-constant (VNumber value))))
(defn p-string [(can-assign bool)] (-> i64)
  (emit-constant (VObj (primitive/cast (ptr Obj)
                             (copy-string (primitive/index (primitive/load (primitive/field (primitive/field (parser) previous) start)) 1)
                                          (- (primitive/load (primitive/field (primitive/field (parser) previous) length)) 2))))))
(defn named-variable [(name Token) (can-assign bool)] (-> i64)
  (let [np (alloc/stack Token)]
    (primitive/store! np name)
    (let [(mut get-op) 0 (mut set-op) 0 (mut arg) (resolve-local (ccomp) np)]
      (if (!= (primitive/load arg) -1)
        (do (primitive/store! get-op OP_GET_LOCAL) (primitive/store! set-op OP_SET_LOCAL))
        (do
          (primitive/store! arg (resolve-upvalue (ccomp) np))
          (if (!= (primitive/load arg) -1)
            (do (primitive/store! get-op OP_GET_UPVALUE) (primitive/store! set-op OP_SET_UPVALUE))
            (do
              (primitive/store! arg (identifier-constant np))
              (primitive/store! get-op OP_GET_GLOBAL)
              (primitive/store! set-op OP_SET_GLOBAL)))))
      (if (and can-assign (match- TOKEN_EQUAL))
        (do (expression) (emit-bytes (primitive/load set-op) (primitive/load arg)))
        (emit-bytes (primitive/load get-op) (primitive/load arg))))))
(defn p-variable [(can-assign bool)] (-> i64) (named-variable (primitive/load (primitive/field (parser) previous)) can-assign))
(defn synthetic-token [(text (ptr u8)) (len i64)] (-> Token)
  (let [(mut t) (primitive/zeroed Token)] (primitive/store! (primitive/field t start) text) (primitive/store! (primitive/field t length) len) (primitive/load t)))
(defn p-super [(can-assign bool)] (-> i64)
  (cond (= (primitive/cast i64 (cclass)) 0) (compile-error (primitive/cast (ptr u8) c"Can't use 'super' outside of a class."))
        (not (primitive/load (primitive/field (cclass) has-superclass)))
          (compile-error (primitive/cast (ptr u8) c"Can't use 'super' in a class with no superclass."))
        0)
  (consume TOKEN_DOT (primitive/cast (ptr u8) c"Expect '.' after 'super'."))
  (consume TOKEN_IDENTIFIER (primitive/cast (ptr u8) c"Expect superclass method name."))
  (let [name (identifier-constant (primitive/field (parser) previous))]
    (named-variable (synthetic-token (primitive/cast (ptr u8) c"this") 4) false)
    (if (match- TOKEN_LEFT_PAREN)
      (let [arg-count (argument-list)]
        (named-variable (synthetic-token (primitive/cast (ptr u8) c"super") 5) false)
        (emit-bytes OP_SUPER_INVOKE name)
        (emit-byte arg-count))
      (do
        (named-variable (synthetic-token (primitive/cast (ptr u8) c"super") 5) false)
        (emit-bytes OP_GET_SUPER name)))))
(defn p-this [(can-assign bool)] (-> i64)
  (if (= (primitive/cast i64 (cclass)) 0)
    (do (compile-error (primitive/cast (ptr u8) c"Can't use 'this' outside of a class.")) 0)
    (p-variable false)))
(defn p-unary [(can-assign bool)] (-> i64)
  (let [operator-type (primitive/load (primitive/field (primitive/field (parser) previous) kind))]
    (parse-precedence PREC_UNARY)
    (cond (= operator-type TOKEN_BANG) (emit-byte OP_NOT)
          (= operator-type TOKEN_MINUS) (emit-byte OP_NEGATE)
          0)))

; ---- parse rule dispatch (replaces clox's rules[] table) ----
(defn rule-prec [(t i64)] (-> i64)
  (cond (= t TOKEN_LEFT_PAREN) PREC_CALL
        (= t TOKEN_DOT) PREC_CALL
        (= t TOKEN_MINUS) PREC_TERM
        (= t TOKEN_PLUS) PREC_TERM
        (= t TOKEN_SLASH) PREC_FACTOR
        (= t TOKEN_STAR) PREC_FACTOR
        (= t TOKEN_BANG_EQUAL) PREC_EQUALITY
        (= t TOKEN_EQUAL_EQUAL) PREC_EQUALITY
        (= t TOKEN_GREATER) PREC_COMPARISON
        (= t TOKEN_GREATER_EQUAL) PREC_COMPARISON
        (= t TOKEN_LESS) PREC_COMPARISON
        (= t TOKEN_LESS_EQUAL) PREC_COMPARISON
        (= t TOKEN_AND) PREC_AND
        (= t TOKEN_OR) PREC_OR
        PREC_NONE))
(defn prefix-null? [(t i64)] (-> bool)
  (not (or (= t TOKEN_LEFT_PAREN)
           (or (= t TOKEN_MINUS)
               (or (= t TOKEN_BANG)
                   (or (= t TOKEN_IDENTIFIER)
                       (or (= t TOKEN_STRING)
                           (or (= t TOKEN_NUMBER)
                               (or (= t TOKEN_FALSE)
                                   (or (= t TOKEN_NIL)
                                       (or (= t TOKEN_TRUE)
                                           (or (= t TOKEN_SUPER) (= t TOKEN_THIS)))))))))))))
(defn call-prefix [(t i64) (can-assign bool)] (-> i64)
  (cond (= t TOKEN_LEFT_PAREN) (p-grouping can-assign)
        (= t TOKEN_MINUS) (p-unary can-assign)
        (= t TOKEN_BANG) (p-unary can-assign)
        (= t TOKEN_IDENTIFIER) (p-variable can-assign)
        (= t TOKEN_STRING) (p-string can-assign)
        (= t TOKEN_NUMBER) (p-number can-assign)
        (= t TOKEN_FALSE) (p-literal can-assign)
        (= t TOKEN_NIL) (p-literal can-assign)
        (= t TOKEN_TRUE) (p-literal can-assign)
        (= t TOKEN_SUPER) (p-super can-assign)
        (= t TOKEN_THIS) (p-this can-assign)
        0))
(defn call-infix [(t i64) (can-assign bool)] (-> i64)
  (cond (= t TOKEN_LEFT_PAREN) (p-call can-assign)
        (= t TOKEN_DOT) (p-dot can-assign)
        (= t TOKEN_AND) (p-and can-assign)
        (= t TOKEN_OR) (p-or can-assign)
        (p-binary can-assign)))
(defn parse-precedence [(precedence i64)] (-> i64)
  (advance-)
  (if (prefix-null? (primitive/load (primitive/field (primitive/field (parser) previous) kind)))
    (compile-error (primitive/cast (ptr u8) c"Expect expression."))
    (let [can-assign (<= precedence PREC_ASSIGNMENT)]
      (call-prefix (primitive/load (primitive/field (primitive/field (parser) previous) kind)) can-assign)
      (loop (if (<= precedence (rule-prec (primitive/load (primitive/field (primitive/field (parser) current) kind))))
              (do (advance-) (call-infix (primitive/load (primitive/field (primitive/field (parser) previous) kind)) can-assign))
              (break)))
      (if (and can-assign (match- TOKEN_EQUAL)) (compile-error (primitive/cast (ptr u8) c"Invalid assignment target.")) 0))))

; ---- statements / declarations ----
(defn compile-block [] (-> i64)
  (loop (if (and (not (check- TOKEN_RIGHT_BRACE)) (not (check- TOKEN_EOF))) (declaration) (break)))
  (consume TOKEN_RIGHT_BRACE (primitive/cast (ptr u8) c"Expect '}' after block.")))
(defn p-function-decl [(kind i64)] (-> i64)
  (let [compiler (alloc/stack Compiler)]
    (init-compiler compiler kind)
    (begin-scope)
    (consume TOKEN_LEFT_PAREN (primitive/cast (ptr u8) c"Expect '(' after function name."))
    (if (not (check- TOKEN_RIGHT_PAREN))
      (loop (primitive/store! (primitive/field (primitive/load (primitive/field (ccomp) function)) arity)
                    (+ (primitive/load (primitive/field (primitive/load (primitive/field (ccomp) function)) arity)) 1))
        (if (> (primitive/load (primitive/field (primitive/load (primitive/field (ccomp) function)) arity)) 255)
          (error-at-current (primitive/cast (ptr u8) c"Can't have more than 255 parameters."))
          0)
        (let [constant (parse-variable (primitive/cast (ptr u8) c"Expect parameter name."))] (define-variable constant))
        (if (match- TOKEN_COMMA) 0 (break)))
      0)
    (consume TOKEN_RIGHT_PAREN (primitive/cast (ptr u8) c"Expect ')' after parameters."))
    (consume TOKEN_LEFT_BRACE (primitive/cast (ptr u8) c"Expect '{' before function body."))
    (compile-block)
    (let [function (end-compiler)]
      (emit-bytes OP_CLOSURE (make-constant (VObj (primitive/cast (ptr Obj) function))))
      (let [(mut i) 0]
        (loop (if (>= (primitive/load i) (primitive/load (primitive/field function upvalue-count)))
                (break)
                (do
                  (emit-byte (if (primitive/load (primitive/field (primitive/index (primitive/field compiler upvalues) (primitive/load i)) is-local)) 1 0))
                  (emit-byte (primitive/load (primitive/field (primitive/index (primitive/field compiler upvalues) (primitive/load i)) index)))
                  (primitive/store! i (+ (primitive/load i) 1))))))
      0)))
(defn method [] (-> i64)
  (consume TOKEN_IDENTIFIER (primitive/cast (ptr u8) c"Expect method name."))
  (let [constant (identifier-constant (primitive/field (parser) previous))
        (mut kind) TYPE_METHOD]
    (if (and (= (primitive/load (primitive/field (primitive/field (parser) previous) length)) 4)
             (= (mem-cmp (primitive/load (primitive/field (primitive/field (parser) previous) start)) (primitive/cast (ptr u8) c"init") 4) 0))
      (primitive/store! kind TYPE_INITIALIZER)
      0)
    (p-function-decl (primitive/load kind))
    (emit-bytes OP_METHOD constant)))
(defn class-declaration [] (-> i64)
  (consume TOKEN_IDENTIFIER (primitive/cast (ptr u8) c"Expect class name."))
  (let [class-name (alloc/stack Token)]
    (primitive/store! class-name (primitive/load (primitive/field (parser) previous)))
    (let [name-constant (identifier-constant (primitive/field (parser) previous))]
      (declare-variable)
      (emit-bytes OP_CLASS name-constant)
      (define-variable name-constant)
      (let [class-compiler (alloc/stack ClassCompiler)]
        (primitive/store! (primitive/field class-compiler has-superclass) false)
        (primitive/store! (primitive/field class-compiler enclosing) (cclass))
        (primitive/store! (cur-class-cell) class-compiler)
        (if (match- TOKEN_LESS)
          (do
            (consume TOKEN_IDENTIFIER (primitive/cast (ptr u8) c"Expect superclass name."))
            (p-variable false)
            (if (identifiers-equal class-name (primitive/field (parser) previous))
              (compile-error (primitive/cast (ptr u8) c"A class can't inherit from itself."))
              0)
            (begin-scope)
            (add-local (synthetic-token (primitive/cast (ptr u8) c"super") 5))
            (define-variable 0)
            (named-variable (primitive/load class-name) false)
            (emit-byte OP_INHERIT)
            (primitive/store! (primitive/field class-compiler has-superclass) true)
            0)
          0)
        (named-variable (primitive/load class-name) false)
        (consume TOKEN_LEFT_BRACE (primitive/cast (ptr u8) c"Expect '{' before class body."))
        (loop (if (and (not (check- TOKEN_RIGHT_BRACE)) (not (check- TOKEN_EOF))) (method) (break)))
        (consume TOKEN_RIGHT_BRACE (primitive/cast (ptr u8) c"Expect '}' after class body."))
        (emit-byte OP_POP)
        (if (primitive/load (primitive/field class-compiler has-superclass)) (end-scope) 0)
        (primitive/store! (cur-class-cell) (primitive/load (primitive/field (cclass) enclosing))))
      0)))
(defn fun-declaration [] (-> i64)
  (let [global (parse-variable (primitive/cast (ptr u8) c"Expect function name."))]
    (mark-initialized)
    (p-function-decl TYPE_FUNCTION)
    (define-variable global)))
(defn var-declaration [] (-> i64)
  (let [global (parse-variable (primitive/cast (ptr u8) c"Expect variable name."))]
    (if (match- TOKEN_EQUAL) (expression) (emit-byte OP_NIL))
    (consume TOKEN_SEMICOLON (primitive/cast (ptr u8) c"Expect ';' after variable declaration."))
    (define-variable global)))
(defn expression-statement [] (-> i64)
  (expression)
  (consume TOKEN_SEMICOLON (primitive/cast (ptr u8) c"Expect ';' after expression."))
  (emit-byte OP_POP))
(defn for-statement [] (-> i64)
  (begin-scope)
  (consume TOKEN_LEFT_PAREN (primitive/cast (ptr u8) c"Expect '(' after 'for'."))
  (cond (match- TOKEN_SEMICOLON) 0
        (match- TOKEN_VAR) (var-declaration)
        (expression-statement))
  (let [(mut loop-start) (primitive/load (primitive/field (current-chunk) count)) (mut exit-jump) -1]
    (if (not (match- TOKEN_SEMICOLON))
      (do
        (expression)
        (consume TOKEN_SEMICOLON (primitive/cast (ptr u8) c"Expect ';' after loop condition."))
        (primitive/store! exit-jump (emit-jump OP_JUMP_IF_FALSE))
        (emit-byte OP_POP))
      0)
    (if (not (match- TOKEN_RIGHT_PAREN))
      (let [body-jump (emit-jump OP_JUMP) increment-start (primitive/load (primitive/field (current-chunk) count))]
        (expression)
        (emit-byte OP_POP)
        (consume TOKEN_RIGHT_PAREN (primitive/cast (ptr u8) c"Expect ')' after for clauses."))
        (emit-loop (primitive/load loop-start))
        (primitive/store! loop-start increment-start)
        (patch-jump body-jump))
      0)
    (statement)
    (emit-loop (primitive/load loop-start))
    (if (!= (primitive/load exit-jump) -1) (do (patch-jump (primitive/load exit-jump)) (emit-byte OP_POP)) 0)
    (end-scope)))
(defn if-statement [] (-> i64)
  (consume TOKEN_LEFT_PAREN (primitive/cast (ptr u8) c"Expect '(' after 'if'."))
  (expression)
  (consume TOKEN_RIGHT_PAREN (primitive/cast (ptr u8) c"Expect ')' after condition."))
  (let [then-jump (emit-jump OP_JUMP_IF_FALSE)]
    (emit-byte OP_POP)
    (statement)
    (let [else-jump (emit-jump OP_JUMP)]
      (patch-jump then-jump)
      (emit-byte OP_POP)
      (if (match- TOKEN_ELSE) (statement) 0)
      (patch-jump else-jump))))
(defn print-statement [] (-> i64)
  (expression)
  (consume TOKEN_SEMICOLON (primitive/cast (ptr u8) c"Expect ';' after value."))
  (emit-byte OP_PRINT))
(defn return-statement [] (-> i64)
  (if (= (primitive/load (primitive/field (ccomp) kind)) TYPE_SCRIPT)
    (compile-error (primitive/cast (ptr u8) c"Can't return from top-level code."))
    0)
  (if (match- TOKEN_SEMICOLON)
    (emit-return)
    (do
      (if (= (primitive/load (primitive/field (ccomp) kind)) TYPE_INITIALIZER)
        (compile-error (primitive/cast (ptr u8) c"Can't return a value from an initializer."))
        0)
      (expression)
      (consume TOKEN_SEMICOLON (primitive/cast (ptr u8) c"Expect ';' after return value."))
      (emit-byte OP_RETURN))))
(defn while-statement [] (-> i64)
  (let [loop-start (primitive/load (primitive/field (current-chunk) count))]
    (consume TOKEN_LEFT_PAREN (primitive/cast (ptr u8) c"Expect '(' after 'while'."))
    (expression)
    (consume TOKEN_RIGHT_PAREN (primitive/cast (ptr u8) c"Expect ')' after condition."))
    (let [exit-jump (emit-jump OP_JUMP_IF_FALSE)]
      (emit-byte OP_POP)
      (statement)
      (emit-loop loop-start)
      (patch-jump exit-jump)
      (emit-byte OP_POP))))
(defn synchronize [] (-> i64)
  (primitive/store! (primitive/field (parser) panic-mode) false)
  (loop (if (= (primitive/load (primitive/field (primitive/field (parser) current) kind)) TOKEN_EOF)
          (break)
          (if (= (primitive/load (primitive/field (primitive/field (parser) previous) kind)) TOKEN_SEMICOLON)
            (break)
            (let [k (primitive/load (primitive/field (primitive/field (parser) current) kind))]
              (if (or (= k TOKEN_CLASS)
                      (or (= k TOKEN_FUN)
                          (or (= k TOKEN_VAR)
                              (or (= k TOKEN_FOR)
                                  (or (= k TOKEN_IF) (or (= k TOKEN_WHILE) (or (= k TOKEN_PRINT) (= k TOKEN_RETURN))))))))
                (break)
                (advance-))))))
  0)
(defn declaration [] (-> i64)
  (cond (match- TOKEN_CLASS) (class-declaration)
        (match- TOKEN_FUN) (fun-declaration)
        (match- TOKEN_VAR) (var-declaration)
        (statement))
  (if (primitive/load (primitive/field (parser) panic-mode)) (synchronize) 0))
(defn statement [] (-> i64)
  (cond (match- TOKEN_PRINT) (print-statement)
        (match- TOKEN_FOR) (for-statement)
        (match- TOKEN_IF) (if-statement)
        (match- TOKEN_RETURN) (return-statement)
        (match- TOKEN_WHILE) (while-statement)
        (match- TOKEN_LEFT_BRACE) (do (begin-scope) (compile-block) (end-scope))
        (expression-statement)))

(defn compile [(source (ptr u8))] (-> (ptr ObjFunction))
  (init-scanner source)
  (let [compiler (alloc/stack Compiler)]
    (primitive/store! (cur-comp-cell) (primitive/cast (ptr Compiler) 0))
    (init-compiler compiler TYPE_SCRIPT)
    (primitive/store! (primitive/field (parser) had-error) false)
    (primitive/store! (primitive/field (parser) panic-mode) false)
    (advance-)
    (loop (if (match- TOKEN_EOF) (break) (declaration)))
    (let [function (end-compiler)]
      (if (primitive/load (primitive/field (parser) had-error)) (primitive/cast (ptr ObjFunction) 0) function))))

; ============================ VM ============================================
(const INTERPRET_OK 0)
(const INTERPRET_COMPILE_ERROR 1)
(const INTERPRET_RUNTIME_ERROR 2)

(defn frame-fn [(frame (ptr CallFrame))] (-> (ptr ObjFunction)) (primitive/load (primitive/field (primitive/load (primitive/field frame closure)) function)))
(defn frame-chunk [(frame (ptr CallFrame))] (-> (ptr Chunk)) (primitive/field (frame-fn frame) chunk))

; runtimeError: print message parts to stderr, then the stack trace, then reset.
(defn runtime-error-trace [] (-> i64)
  (w-cstr 2 c"\n")
  (let [(mut i) (- (primitive/load (primitive/field (vm) frame-count)) 1)]
    (loop (if (< (primitive/load i) 0)
            (break)
            (let [frame (primitive/index (primitive/field (vm) frames) (primitive/load i))
                  function (frame-fn frame)
                  instruction
                    (- (- (primitive/cast i64 (primitive/load (primitive/field frame ip))) (primitive/cast i64 (primitive/load (primitive/field (frame-chunk frame) code)))) 1)]
              (w-cstr 2 c"[line ")
              (w-int 2 (primitive/load (primitive/index (primitive/load (primitive/field (frame-chunk frame) lines)) instruction)))
              (w-cstr 2 c"] in ")
              (if (= (primitive/cast i64 (primitive/load (primitive/field function name))) 0)
                (w-cstr 2 c"script\n")
                (do
                  (w-bytes 2
                           (primitive/load (primitive/field (primitive/load (primitive/field function name)) chars))
                           (primitive/load (primitive/field (primitive/load (primitive/field function name)) length)))
                  (w-cstr 2 c"()\n")))
              (primitive/store! i (- (primitive/load i) 1))))))
  (reset-stack)
  0)
(defn runtime-error [(message (ptr u8))] (-> i64) (w-cstr 2 (primitive/cast (ptr i8) message)) (runtime-error-trace))

(defn clock-native [(arg-count i64) (args (ptr i64))] (-> i64) (VNumber (/ (primitive/cast f64 (clock)) 1000000.0)))
(defn define-native [(name (ptr u8)) (function (fnptr c [i64 (ptr i64)] i64))] (-> i64)
  (push (VObj (primitive/cast (ptr Obj) (copy-string name (strlen (primitive/cast (ptr i8) name))))))
  (push (VObj (primitive/cast (ptr Obj) (new-native function))))
  (table-set (primitive/field (vm) globals) (as-string (primitive/load (primitive/index (primitive/field (vm) stack) 0))) (primitive/load (primitive/index (primitive/field (vm) stack) 1)))
  (pop)
  (pop)
  0)

(defn is-falsey [(value i64)] (-> bool) (or (is-nil value) (and (is-bool value) (not (as-bool value)))))
(defn concatenate [] (-> i64)
  (let [b (as-string (peek 0))
        a (as-string (peek 1))
        length (+ (primitive/load (primitive/field a length)) (primitive/load (primitive/field b length)))
        chars (primitive/cast (ptr u8) (reallocate (primitive/cast (ptr i8) 0) 0 (+ length 1)))]
    (memcpy (primitive/cast (ptr i8) chars) (primitive/cast (ptr i8) (primitive/load (primitive/field a chars))) (primitive/load (primitive/field a length)))
    (memcpy (primitive/cast (ptr i8) (primitive/index chars (primitive/load (primitive/field a length))))
            (primitive/cast (ptr i8) (primitive/load (primitive/field b chars)))
            (primitive/load (primitive/field b length)))
    (primitive/store! (primitive/index chars length) (primitive/cast u8 0))
    (let [result (take-string chars length)]
      (pop)
      (pop)
      (push (VObj (primitive/cast (ptr Obj) result)))
      0)))

; call machinery — each returns bool (success). Failures call runtimeError.
(defn call-closure [(closure (ptr ObjClosure)) (arg-count i64)] (-> bool)
  (cond (!= arg-count (primitive/load (primitive/field (primitive/load (primitive/field closure function)) arity)))
          (do
            (w-cstr 2 c"Expected ")
            (w-int 2 (primitive/load (primitive/field (primitive/load (primitive/field closure function)) arity)))
            (w-cstr 2 c" arguments but got ")
            (w-int 2 arg-count)
            (w-cstr 2 c".")
            (runtime-error-trace)
            false)
        (= (primitive/load (primitive/field (vm) frame-count)) 64) (do (runtime-error (primitive/cast (ptr u8) c"Stack overflow.")) false)
        (let [frame (primitive/index (primitive/field (vm) frames) (primitive/load (primitive/field (vm) frame-count)))]
          (primitive/store! (primitive/field (vm) frame-count) (+ (primitive/load (primitive/field (vm) frame-count)) 1))
          (primitive/store! (primitive/field frame closure) closure)
          (primitive/store! (primitive/field frame ip) (primitive/load (primitive/field (primitive/field (primitive/load (primitive/field closure function)) chunk) code)))
          (primitive/store! (primitive/field frame slots) (primitive/index (primitive/load (primitive/field (vm) stack-top)) (- 0 (+ arg-count 1))))
          true)))
(defn call-value [(callee i64) (arg-count i64)] (-> bool)
  (if (is-obj callee)
    (let [k (obj-kind callee)]
      (cond (= k OBJ_BOUND_METHOD)
              (let [bound (primitive/cast (ptr ObjBoundMethod) (as-obj callee))]
                (primitive/store! (primitive/index (primitive/load (primitive/field (vm) stack-top)) (- 0 (+ arg-count 1))) (primitive/load (primitive/field bound receiver)))
                (call-closure (primitive/load (primitive/field bound method)) arg-count))
            (= k OBJ_CLASS)
              (let [klass (primitive/cast (ptr ObjClass) (as-obj callee)) initializer (alloc/stack i64)]
                (primitive/store! (primitive/index (primitive/load (primitive/field (vm) stack-top)) (- 0 (+ arg-count 1)))
                        (VObj (primitive/cast (ptr Obj) (new-instance klass))))
                (if (table-get (primitive/field klass methods) (primitive/load (primitive/field (vm) init-string)) initializer)
                  (call-closure (primitive/cast (ptr ObjClosure) (as-obj (primitive/load initializer))) arg-count)
                  (if (!= arg-count 0)
                    (do
                      (w-cstr 2 c"Expected 0 arguments but got ")
                      (w-int 2 arg-count)
                      (w-cstr 2 c".")
                      (runtime-error-trace)
                      false)
                    true)))
            (= k OBJ_CLOSURE) (call-closure (primitive/cast (ptr ObjClosure) (as-obj callee)) arg-count)
            (= k OBJ_NATIVE)
              (let [native (primitive/load (primitive/field (primitive/cast (ptr ObjNative) (as-obj callee)) function))
                    result (primitive/call-ptr native arg-count (primitive/index (primitive/load (primitive/field (vm) stack-top)) (- 0 arg-count)))]
                (primitive/store! (primitive/field (vm) stack-top) (primitive/index (primitive/load (primitive/field (vm) stack-top)) (- 0 (+ arg-count 1))))
                (push result)
                true)
            (do (runtime-error (primitive/cast (ptr u8) c"Can only call functions and classes.")) false)))
    (do (runtime-error (primitive/cast (ptr u8) c"Can only call functions and classes.")) false)))
(defn invoke-from-class [(klass (ptr ObjClass)) (name (ptr ObjString)) (arg-count i64)] (-> bool)
  (let [method (alloc/stack i64)]
    (if (not (table-get (primitive/field klass methods) name method))
      (do
        (w-cstr 2 c"Undefined property '")
        (w-bytes 2 (primitive/load (primitive/field name chars)) (primitive/load (primitive/field name length)))
        (w-cstr 2 c"'.")
        (runtime-error-trace)
        false)
      (call-closure (primitive/cast (ptr ObjClosure) (as-obj (primitive/load method))) arg-count))))
(defn invoke [(name (ptr ObjString)) (arg-count i64)] (-> bool)
  (let [receiver (peek arg-count)]
    (if (not (is-obj-kind receiver OBJ_INSTANCE))
      (do (runtime-error (primitive/cast (ptr u8) c"Only instances have methods.")) false)
      (let [instance (primitive/cast (ptr ObjInstance) (as-obj receiver)) value (alloc/stack i64)]
        (if (table-get (primitive/field instance fields) name value)
          (do
            (primitive/store! (primitive/index (primitive/load (primitive/field (vm) stack-top)) (- 0 (+ arg-count 1))) (primitive/load value))
            (call-value (primitive/load value) arg-count))
          (invoke-from-class (primitive/load (primitive/field instance klass)) name arg-count))))))
(defn bind-method [(klass (ptr ObjClass)) (name (ptr ObjString))] (-> bool)
  (let [method (alloc/stack i64)]
    (if (not (table-get (primitive/field klass methods) name method))
      (do
        (w-cstr 2 c"Undefined property '")
        (w-bytes 2 (primitive/load (primitive/field name chars)) (primitive/load (primitive/field name length)))
        (w-cstr 2 c"'.")
        (runtime-error-trace)
        false)
      (let [bound (new-bound-method (peek 0) (primitive/cast (ptr ObjClosure) (as-obj (primitive/load method))))]
        (pop)
        (push (VObj (primitive/cast (ptr Obj) bound)))
        true))))
(defn capture-upvalue [(local (ptr i64))] (-> (ptr ObjUpvalue))
  (let [(mut prev-upvalue) (primitive/cast (ptr ObjUpvalue) 0) (mut upvalue) (primitive/load (primitive/field (vm) open-upvalues))]
    (loop (if (and (!= (primitive/cast i64 (primitive/load upvalue)) 0)
                   (> (primitive/cast i64 (primitive/load (primitive/field (primitive/load upvalue) location))) (primitive/cast i64 local)))
            (do (primitive/store! prev-upvalue (primitive/load upvalue)) (primitive/store! upvalue (primitive/load (primitive/field (primitive/load upvalue) next))))
            (break)))
    (if (and (!= (primitive/cast i64 (primitive/load upvalue)) 0) (= (primitive/cast i64 (primitive/load (primitive/field (primitive/load upvalue) location))) (primitive/cast i64 local)))
      (primitive/load upvalue)
      (let [created-upvalue (new-upvalue local)]
        (primitive/store! (primitive/field created-upvalue next) (primitive/load upvalue))
        (if (= (primitive/cast i64 (primitive/load prev-upvalue)) 0)
          (primitive/store! (primitive/field (vm) open-upvalues) created-upvalue)
          (primitive/store! (primitive/field (primitive/load prev-upvalue) next) created-upvalue))
        created-upvalue))))
(defn close-upvalues [(last (ptr i64))] (-> i64)
  (loop (if (and (!= (primitive/cast i64 (primitive/load (primitive/field (vm) open-upvalues))) 0)
                 (>= (primitive/cast i64 (primitive/load (primitive/field (primitive/load (primitive/field (vm) open-upvalues)) location))) (primitive/cast i64 last)))
          (let [upvalue (primitive/load (primitive/field (vm) open-upvalues))]
            (primitive/store! (primitive/field upvalue closed) (primitive/load (primitive/load (primitive/field upvalue location))))
            (primitive/store! (primitive/field upvalue location) (primitive/field upvalue closed))
            (primitive/store! (primitive/field (vm) open-upvalues) (primitive/load (primitive/field upvalue next))))
          (break)))
  0)
(defn define-method [(name (ptr ObjString))] (-> i64)
  (let [method (peek 0) klass (primitive/cast (ptr ObjClass) (as-obj (peek 1)))]
    (table-set (primitive/field klass methods) name method)
    (pop)
    0))

; ---- READ_* helpers over the current frame ----
(defn read-byte [(frame (ptr CallFrame))] (-> i64)
  (let [b (primitive/cast i64 (primitive/load (primitive/load (primitive/field frame ip))))]
    (primitive/store! (primitive/field frame ip) (primitive/index (primitive/load (primitive/field frame ip)) 1))
    b))
(defn read-short [(frame (ptr CallFrame))] (-> i64)
  (primitive/store! (primitive/field frame ip) (primitive/index (primitive/load (primitive/field frame ip)) 2))
  (| (<< (primitive/cast i64 (primitive/load (primitive/index (primitive/load (primitive/field frame ip)) -2))) 8) (primitive/cast i64 (primitive/load (primitive/index (primitive/load (primitive/field frame ip)) -1)))))
(defn read-constant [(frame (ptr CallFrame))] (-> i64)
  (primitive/load (primitive/index (primitive/load (primitive/field (primitive/field (frame-chunk frame) constants) values)) (read-byte frame))))
(defn read-string [(frame (ptr CallFrame))] (-> (ptr ObjString)) (as-string (read-constant frame)))

(defn both-numbers [] (-> bool) (and (is-number (peek 0)) (is-number (peek 1))))
; upvalue at slot of the current frame's closure
(defn frame-upvalue [(frame (ptr CallFrame)) (slot i64)] (-> (ptr ObjUpvalue))
  (primitive/load (primitive/index (primitive/load (primitive/field (primitive/load (primitive/field frame closure)) upvalues)) slot)))
; advance the current frame's ip by delta elements
(defn jump-ip [(frame (ptr CallFrame)) (delta i64)] (-> i64)
  (primitive/store! (primitive/field frame ip) (primitive/index (primitive/load (primitive/field frame ip)) delta))
  0)

(defn run [] (-> i64)
  ; tmp-val is a reusable out-param slot, hoisted OUT of the loop: alloc-stack is
  ; alloca, and an alloca inside the dispatch loop would leak the C stack per
  ; instruction (millions of iterations -> stack overflow).
  (let [(mut frame) (primitive/index (primitive/field (vm) frames) (- (primitive/load (primitive/field (vm) frame-count)) 1))
        (mut result) -1
        tmp-val (alloc/stack i64)]
    (loop (let [instruction (read-byte (primitive/load frame))]
            (cond (= instruction OP_CONSTANT) (do (push (read-constant (primitive/load frame))) 0)
                  (= instruction OP_NIL) (do (push (VNil)) 0)
                  (= instruction OP_TRUE) (do (push (VBool true)) 0)
                  (= instruction OP_FALSE) (do (push (VBool false)) 0)
                  (= instruction OP_POP) (do (pop) 0)
                  (= instruction OP_GET_LOCAL)
                    (let [slot (read-byte (primitive/load frame))] (push (primitive/load (primitive/index (primitive/load (primitive/field (primitive/load frame) slots)) slot))) 0)
                  (= instruction OP_SET_LOCAL)
                    (let [slot (read-byte (primitive/load frame))]
                      (primitive/store! (primitive/index (primitive/load (primitive/field (primitive/load frame) slots)) slot) (peek 0))
                      0)
                  (= instruction OP_GET_GLOBAL)
                    (let [name (read-string (primitive/load frame)) value tmp-val]
                      (if (not (table-get (primitive/field (vm) globals) name value))
                        (do
                          (w-cstr 2 c"Undefined variable '")
                          (w-bytes 2 (primitive/load (primitive/field name chars)) (primitive/load (primitive/field name length)))
                          (w-cstr 2 c"'.")
                          (runtime-error-trace)
                          (primitive/store! result INTERPRET_RUNTIME_ERROR)
                          (break))
                        (do (push (primitive/load value)) 0)))
                  (= instruction OP_DEFINE_GLOBAL)
                    (let [name (read-string (primitive/load frame))] (table-set (primitive/field (vm) globals) name (peek 0)) (pop) 0)
                  (= instruction OP_SET_GLOBAL)
                    (let [name (read-string (primitive/load frame))]
                      (if (table-set (primitive/field (vm) globals) name (peek 0))
                        (do
                          (table-delete (primitive/field (vm) globals) name)
                          (w-cstr 2 c"Undefined variable '")
                          (w-bytes 2 (primitive/load (primitive/field name chars)) (primitive/load (primitive/field name length)))
                          (w-cstr 2 c"'.")
                          (runtime-error-trace)
                          (primitive/store! result INTERPRET_RUNTIME_ERROR)
                          (break))
                        0))
                  (= instruction OP_GET_UPVALUE)
                    (let [slot (read-byte (primitive/load frame))]
                      (push (primitive/load (primitive/load (primitive/field (frame-upvalue (primitive/load frame) slot) location))))
                      0)
                  (= instruction OP_SET_UPVALUE)
                    (let [slot (read-byte (primitive/load frame))]
                      (primitive/store! (primitive/load (primitive/field (frame-upvalue (primitive/load frame) slot) location)) (peek 0))
                      0)
                  (= instruction OP_GET_PROPERTY)
                    (if (not (is-obj-kind (peek 0) OBJ_INSTANCE))
                      (do
                        (runtime-error (primitive/cast (ptr u8) c"Only instances have properties."))
                        (primitive/store! result INTERPRET_RUNTIME_ERROR)
                        (break))
                      (let [instance (primitive/cast (ptr ObjInstance) (as-obj (peek 0)))
                            name (read-string (primitive/load frame))
                            value tmp-val]
                        (if (table-get (primitive/field instance fields) name value)
                          (do (pop) (push (primitive/load value)) 0)
                          (if (not (bind-method (primitive/load (primitive/field instance klass)) name))
                            (do (primitive/store! result INTERPRET_RUNTIME_ERROR) (break))
                            0))))
                  (= instruction OP_SET_PROPERTY)
                    (if (not (is-obj-kind (peek 1) OBJ_INSTANCE))
                      (do
                        (runtime-error (primitive/cast (ptr u8) c"Only instances have fields."))
                        (primitive/store! result INTERPRET_RUNTIME_ERROR)
                        (break))
                      (let [instance (primitive/cast (ptr ObjInstance) (as-obj (peek 1)))]
                        (table-set (primitive/field instance fields) (read-string (primitive/load frame)) (peek 0))
                        (let [value (pop)] (pop) (push value))
                        0))
                  (= instruction OP_GET_SUPER)
                    (let [name (read-string (primitive/load frame)) superclass (primitive/cast (ptr ObjClass) (as-obj (pop)))]
                      (if (not (bind-method superclass name)) (do (primitive/store! result INTERPRET_RUNTIME_ERROR) (break)) 0))
                  (= instruction OP_EQUAL) (let [b (pop) a (pop)] (push (VBool (values-equal a b))) 0)
                  (= instruction OP_GREATER)
                    (if (not (both-numbers))
                      (do
                        (runtime-error (primitive/cast (ptr u8) c"Operands must be numbers."))
                        (primitive/store! result INTERPRET_RUNTIME_ERROR)
                        (break))
                      (let [b (as-number (pop)) a (as-number (pop))] (push (VBool (> a b))) 0))
                  (= instruction OP_LESS)
                    (if (not (both-numbers))
                      (do
                        (runtime-error (primitive/cast (ptr u8) c"Operands must be numbers."))
                        (primitive/store! result INTERPRET_RUNTIME_ERROR)
                        (break))
                      (let [b (as-number (pop)) a (as-number (pop))] (push (VBool (< a b))) 0))
                  (= instruction OP_ADD)
                    (cond (and (is-string (peek 0)) (is-string (peek 1))) (do (concatenate) 0)
                          (both-numbers) (let [b (as-number (pop)) a (as-number (pop))] (push (VNumber (+ a b))) 0)
                          (do
                            (runtime-error (primitive/cast (ptr u8) c"Operands must be two numbers or two strings."))
                            (primitive/store! result INTERPRET_RUNTIME_ERROR)
                            (break)))
                  (= instruction OP_SUBTRACT)
                    (if (not (both-numbers))
                      (do
                        (runtime-error (primitive/cast (ptr u8) c"Operands must be numbers."))
                        (primitive/store! result INTERPRET_RUNTIME_ERROR)
                        (break))
                      (let [b (as-number (pop)) a (as-number (pop))] (push (VNumber (- a b))) 0))
                  (= instruction OP_MULTIPLY)
                    (if (not (both-numbers))
                      (do
                        (runtime-error (primitive/cast (ptr u8) c"Operands must be numbers."))
                        (primitive/store! result INTERPRET_RUNTIME_ERROR)
                        (break))
                      (let [b (as-number (pop)) a (as-number (pop))] (push (VNumber (* a b))) 0))
                  (= instruction OP_DIVIDE)
                    (if (not (both-numbers))
                      (do
                        (runtime-error (primitive/cast (ptr u8) c"Operands must be numbers."))
                        (primitive/store! result INTERPRET_RUNTIME_ERROR)
                        (break))
                      (let [b (as-number (pop)) a (as-number (pop))] (push (VNumber (/ a b))) 0))
                  (= instruction OP_NOT) (do (push (VBool (is-falsey (pop)))) 0)
                  (= instruction OP_NEGATE)
                    (if (not (is-number (peek 0)))
                      (do
                        (runtime-error (primitive/cast (ptr u8) c"Operand must be a number."))
                        (primitive/store! result INTERPRET_RUNTIME_ERROR)
                        (break))
                      (do (push (VNumber (* -1.0 (as-number (pop))))) 0))
                  (= instruction OP_PRINT) (do (print-value 1 (pop)) (w-cstr 1 c"\n") 0)
                  (= instruction OP_JUMP) (let [offset (read-short (primitive/load frame))] (jump-ip (primitive/load frame) offset))
                  (= instruction OP_JUMP_IF_FALSE)
                    (let [offset (read-short (primitive/load frame))] (if (is-falsey (peek 0)) (jump-ip (primitive/load frame) offset) 0))
                  (= instruction OP_LOOP) (let [offset (read-short (primitive/load frame))] (jump-ip (primitive/load frame) (- 0 offset)))
                  (= instruction OP_CALL)
                    (let [arg-count (read-byte (primitive/load frame))]
                      (if (not (call-value (peek arg-count) arg-count))
                        (do (primitive/store! result INTERPRET_RUNTIME_ERROR) (break))
                        (do (primitive/store! frame (primitive/index (primitive/field (vm) frames) (- (primitive/load (primitive/field (vm) frame-count)) 1))) 0)))
                  (= instruction OP_INVOKE)
                    (let [method (read-string (primitive/load frame)) arg-count (read-byte (primitive/load frame))]
                      (if (not (invoke method arg-count))
                        (do (primitive/store! result INTERPRET_RUNTIME_ERROR) (break))
                        (do (primitive/store! frame (primitive/index (primitive/field (vm) frames) (- (primitive/load (primitive/field (vm) frame-count)) 1))) 0)))
                  (= instruction OP_SUPER_INVOKE)
                    (let [method (read-string (primitive/load frame))
                          arg-count (read-byte (primitive/load frame))
                          superclass (primitive/cast (ptr ObjClass) (as-obj (pop)))]
                      (if (not (invoke-from-class superclass method arg-count))
                        (do (primitive/store! result INTERPRET_RUNTIME_ERROR) (break))
                        (do (primitive/store! frame (primitive/index (primitive/field (vm) frames) (- (primitive/load (primitive/field (vm) frame-count)) 1))) 0)))
                  (= instruction OP_CLOSURE)
                    (let [function (primitive/cast (ptr ObjFunction) (as-obj (read-constant (primitive/load frame))))
                          closure (new-closure function)]
                      (push (VObj (primitive/cast (ptr Obj) closure)))
                      (let [(mut i) 0]
                        (loop (if (>= (primitive/load i) (primitive/load (primitive/field closure upvalue-count)))
                                (break)
                                (let [is-local (read-byte (primitive/load frame)) index-val (read-byte (primitive/load frame))]
                                  (if (!= is-local 0)
                                    (primitive/store! (primitive/index (primitive/load (primitive/field closure upvalues)) (primitive/load i))
                                            (capture-upvalue (primitive/index (primitive/load (primitive/field (primitive/load frame) slots)) index-val)))
                                    (primitive/store! (primitive/index (primitive/load (primitive/field closure upvalues)) (primitive/load i))
                                            (frame-upvalue (primitive/load frame) index-val)))
                                  (primitive/store! i (+ (primitive/load i) 1))))))
                      0)
                  (= instruction OP_CLOSE_UPVALUE)
                    (do (close-upvalues (primitive/index (primitive/load (primitive/field (vm) stack-top)) -1)) (pop) 0)
                  (= instruction OP_RETURN)
                    (let [res (pop)]
                      (close-upvalues (primitive/load (primitive/field (primitive/load frame) slots)))
                      (primitive/store! (primitive/field (vm) frame-count) (- (primitive/load (primitive/field (vm) frame-count)) 1))
                      (if (= (primitive/load (primitive/field (vm) frame-count)) 0)
                        (do (pop) (primitive/store! result INTERPRET_OK) (break))
                        (do
                          (primitive/store! (primitive/field (vm) stack-top) (primitive/load (primitive/field (primitive/load frame) slots)))
                          (push res)
                          (primitive/store! frame (primitive/index (primitive/field (vm) frames) (- (primitive/load (primitive/field (vm) frame-count)) 1)))
                          0)))
                  (= instruction OP_CLASS) (do (push (VObj (primitive/cast (ptr Obj) (new-class (read-string (primitive/load frame)))))) 0)
                  (= instruction OP_INHERIT)
                    (let [superclass (peek 1)]
                      (if (not (is-obj-kind superclass OBJ_CLASS))
                        (do
                          (runtime-error (primitive/cast (ptr u8) c"Superclass must be a class."))
                          (primitive/store! result INTERPRET_RUNTIME_ERROR)
                          (break))
                        (let [subclass (primitive/cast (ptr ObjClass) (as-obj (peek 0)))]
                          (table-add-all (primitive/field (primitive/cast (ptr ObjClass) (as-obj superclass)) methods)
                                         (primitive/field subclass methods))
                          (pop)
                          0)))
                  (= instruction OP_METHOD) (do (define-method (read-string (primitive/load frame))) 0)
                  0)))
    (primitive/load result)))

(defn interpret [(source (ptr u8))] (-> i64)
  (let [function (compile source)]
    (if (= (primitive/cast i64 function) 0)
      INTERPRET_COMPILE_ERROR
      (do
        (push (VObj (primitive/cast (ptr Obj) function)))
        (let [closure (new-closure function)]
          (pop)
          (push (VObj (primitive/cast (ptr Obj) closure)))
          (call-closure closure 0))
        (run)))))

; ============================ garbage collection ============================
(defn mark-object [(object (ptr Obj))] (-> i64)
  (if (= (primitive/cast i64 object) 0)
    0
    (if (primitive/load (primitive/field object is-marked))
      0
      (do
        (primitive/store! (primitive/field object is-marked) true)
        (if (< (primitive/load (primitive/field (vm) gray-capacity)) (+ (primitive/load (primitive/field (vm) gray-count)) 1))
          (do
            (primitive/store! (primitive/field (vm) gray-capacity) (grow-capacity (primitive/load (primitive/field (vm) gray-capacity))))
            (primitive/store! (primitive/field (vm) gray-stack)
                    (primitive/cast (ptr (ptr Obj))
                          (realloc (primitive/cast (ptr i8) (primitive/load (primitive/field (vm) gray-stack)))
                                   (* (primitive/sizeof (ptr Obj)) (primitive/load (primitive/field (vm) gray-capacity))))))
            0)
          0)
        (primitive/store! (primitive/index (primitive/load (primitive/field (vm) gray-stack)) (primitive/load (primitive/field (vm) gray-count))) object)
        (primitive/store! (primitive/field (vm) gray-count) (+ (primitive/load (primitive/field (vm) gray-count)) 1))
        0))))
(defn mark-value [(value i64)] (-> i64) (if (is-obj value) (mark-object (as-obj value)) 0))
(defn mark-array [(array (ptr ValueArray))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (primitive/load i) (primitive/load (primitive/field array count)))
            (break)
            (do (mark-value (primitive/load (primitive/index (primitive/load (primitive/field array values)) (primitive/load i)))) (primitive/store! i (+ (primitive/load i) 1))))))
  0)
(defn mark-table [(table (ptr Table))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (primitive/load i) (primitive/load (primitive/field table capacity)))
            (break)
            (let [entry (primitive/index (primitive/load (primitive/field table entries)) (primitive/load i))]
              (mark-object (primitive/cast (ptr Obj) (primitive/load (primitive/field entry key))))
              (mark-value (primitive/load (primitive/field entry value)))
              (primitive/store! i (+ (primitive/load i) 1))))))
  0)
(defn table-remove-white [(table (ptr Table))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (primitive/load i) (primitive/load (primitive/field table capacity)))
            (break)
            (let [entry (primitive/index (primitive/load (primitive/field table entries)) (primitive/load i))]
              (if (and (!= (primitive/cast i64 (primitive/load (primitive/field entry key))) 0)
                       (not (primitive/load (primitive/field (primitive/cast (ptr Obj) (primitive/load (primitive/field entry key))) is-marked))))
                (do (table-delete table (primitive/load (primitive/field entry key))) 0)
                0)
              (primitive/store! i (+ (primitive/load i) 1))))))
  0)

(defn blacken-object [(object (ptr Obj))] (-> i64)
  (let [k (primitive/load (primitive/field object kind))]
    (cond (= k OBJ_BOUND_METHOD)
            (let [bound (primitive/cast (ptr ObjBoundMethod) object)]
              (mark-value (primitive/load (primitive/field bound receiver)))
              (mark-object (primitive/cast (ptr Obj) (primitive/load (primitive/field bound method)))))
          (= k OBJ_CLASS)
            (let [klass (primitive/cast (ptr ObjClass) object)]
              (mark-object (primitive/cast (ptr Obj) (primitive/load (primitive/field klass name))))
              (mark-table (primitive/field klass methods)))
          (= k OBJ_CLOSURE)
            (let [closure (primitive/cast (ptr ObjClosure) object) (mut i) 0]
              (mark-object (primitive/cast (ptr Obj) (primitive/load (primitive/field closure function))))
              (loop (if (>= (primitive/load i) (primitive/load (primitive/field closure upvalue-count)))
                      (break)
                      (do
                        (mark-object (primitive/cast (ptr Obj) (primitive/load (primitive/index (primitive/load (primitive/field closure upvalues)) (primitive/load i)))))
                        (primitive/store! i (+ (primitive/load i) 1)))))
              0)
          (= k OBJ_FUNCTION)
            (let [function (primitive/cast (ptr ObjFunction) object)]
              (mark-object (primitive/cast (ptr Obj) (primitive/load (primitive/field function name))))
              (mark-array (primitive/field (primitive/field function chunk) constants)))
          (= k OBJ_INSTANCE)
            (let [instance (primitive/cast (ptr ObjInstance) object)]
              (mark-object (primitive/cast (ptr Obj) (primitive/load (primitive/field instance klass))))
              (mark-table (primitive/field instance fields)))
          (= k OBJ_UPVALUE) (mark-value (primitive/load (primitive/field (primitive/cast (ptr ObjUpvalue) object) closed)))
          0)))

(defn free-object [(object (ptr Obj))] (-> i64)
  (let [k (primitive/load (primitive/field object kind))]
    (cond (= k OBJ_BOUND_METHOD) (do (reallocate (primitive/cast (ptr i8) object) (primitive/sizeof ObjBoundMethod) 0) 0)
          (= k OBJ_CLASS)
            (do
              (free-table (primitive/field (primitive/cast (ptr ObjClass) object) methods))
              (reallocate (primitive/cast (ptr i8) object) (primitive/sizeof ObjClass) 0)
              0)
          (= k OBJ_CLOSURE)
            (let [closure (primitive/cast (ptr ObjClosure) object)]
              (reallocate (primitive/cast (ptr i8) (primitive/load (primitive/field closure upvalues)))
                          (* (primitive/sizeof (ptr ObjUpvalue)) (primitive/load (primitive/field closure upvalue-count)))
                          0)
              (reallocate (primitive/cast (ptr i8) object) (primitive/sizeof ObjClosure) 0)
              0)
          (= k OBJ_FUNCTION)
            (let [function (primitive/cast (ptr ObjFunction) object)]
              (free-chunk (primitive/field function chunk))
              (reallocate (primitive/cast (ptr i8) object) (primitive/sizeof ObjFunction) 0)
              0)
          (= k OBJ_INSTANCE)
            (do
              (free-table (primitive/field (primitive/cast (ptr ObjInstance) object) fields))
              (reallocate (primitive/cast (ptr i8) object) (primitive/sizeof ObjInstance) 0)
              0)
          (= k OBJ_NATIVE) (do (reallocate (primitive/cast (ptr i8) object) (primitive/sizeof ObjNative) 0) 0)
          (= k OBJ_STRING)
            (let [string (primitive/cast (ptr ObjString) object)]
              (reallocate (primitive/cast (ptr i8) (primitive/load (primitive/field string chars))) (+ (primitive/load (primitive/field string length)) 1) 0)
              (reallocate (primitive/cast (ptr i8) object) (primitive/sizeof ObjString) 0)
              0)
          (= k OBJ_UPVALUE) (do (reallocate (primitive/cast (ptr i8) object) (primitive/sizeof ObjUpvalue) 0) 0)
          0)))

(defn mark-compiler-roots [] (-> i64)
  (let [(mut compiler) (ccomp)]
    (loop (if (= (primitive/cast i64 (primitive/load compiler)) 0)
            (break)
            (do
              (mark-object (primitive/cast (ptr Obj) (primitive/load (primitive/field (primitive/load compiler) function))))
              (primitive/store! compiler (primitive/load (primitive/field (primitive/load compiler) enclosing)))))))
  0)
(defn mark-roots [] (-> i64)
  (let [(mut slot) (primitive/index (primitive/field (vm) stack) 0)]
    (loop (if (< (primitive/cast i64 (primitive/load slot)) (primitive/cast i64 (primitive/load (primitive/field (vm) stack-top))))
            (do (mark-value (primitive/load (primitive/load slot))) (primitive/store! slot (primitive/index (primitive/load slot) 1)))
            (break))))
  (let [(mut i) 0]
    (loop (if (>= (primitive/load i) (primitive/load (primitive/field (vm) frame-count)))
            (break)
            (do
              (mark-object (primitive/cast (ptr Obj) (primitive/load (primitive/field (primitive/index (primitive/field (vm) frames) (primitive/load i)) closure))))
              (primitive/store! i (+ (primitive/load i) 1))))))
  (let [(mut upvalue) (primitive/load (primitive/field (vm) open-upvalues))]
    (loop (if (!= (primitive/cast i64 (primitive/load upvalue)) 0)
            (do (mark-object (primitive/cast (ptr Obj) (primitive/load upvalue))) (primitive/store! upvalue (primitive/load (primitive/field (primitive/load upvalue) next))))
            (break))))
  (mark-table (primitive/field (vm) globals))
  (mark-compiler-roots)
  (mark-object (primitive/cast (ptr Obj) (primitive/load (primitive/field (vm) init-string))))
  0)
(defn trace-references [] (-> i64)
  (loop (if (> (primitive/load (primitive/field (vm) gray-count)) 0)
          (do
            (primitive/store! (primitive/field (vm) gray-count) (- (primitive/load (primitive/field (vm) gray-count)) 1))
            (blacken-object (primitive/load (primitive/index (primitive/load (primitive/field (vm) gray-stack)) (primitive/load (primitive/field (vm) gray-count))))))
          (break)))
  0)
(defn sweep [] (-> i64)
  (let [(mut previous) (primitive/cast (ptr Obj) 0) (mut object) (primitive/load (primitive/field (vm) objects))]
    (loop (if (= (primitive/cast i64 (primitive/load object)) 0)
            (break)
            (if (primitive/load (primitive/field (primitive/load object) is-marked))
              (do
                (primitive/store! (primitive/field (primitive/load object) is-marked) false)
                (primitive/store! previous (primitive/load object))
                (primitive/store! object (primitive/load (primitive/field (primitive/load object) next)))
                0)
              (let [unreached (primitive/load object)]
                (primitive/store! object (primitive/load (primitive/field (primitive/load object) next)))
                (if (!= (primitive/cast i64 (primitive/load previous)) 0)
                  (primitive/store! (primitive/field (primitive/load previous) next) (primitive/load object))
                  (primitive/store! (primitive/field (vm) objects) (primitive/load object)))
                (free-object unreached))))))
  0)
(defn collect-garbage [] (-> i64)
  (mark-roots)
  (trace-references)
  (table-remove-white (primitive/field (vm) strings))
  (sweep)
  (primitive/store! (primitive/field (vm) next-gc) (* (primitive/load (primitive/field (vm) bytes-allocated)) GC_HEAP_GROW_FACTOR))
  0)
(defn free-objects [] (-> i64)
  (let [(mut object) (primitive/load (primitive/field (vm) objects))]
    (loop (if (= (primitive/cast i64 (primitive/load object)) 0)
            (break)
            (let [next (primitive/load (primitive/field (primitive/load object) next))]
              (free-object (primitive/load object))
              (primitive/store! object next)))))
  (primitive/free (primitive/cast (ptr i8) (primitive/load (primitive/field (vm) gray-stack))))
  0)

; ============================ init / main ===================================
(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))
(defn init-vm [] (-> i64)
  (reset-stack)
  (primitive/store! (primitive/field (vm) objects) (primitive/cast (ptr Obj) 0))
  (primitive/store! (primitive/field (vm) bytes-allocated) 0)
  (primitive/store! (primitive/field (vm) next-gc) 1048576)
  (primitive/store! (primitive/field (vm) gray-count) 0)
  (primitive/store! (primitive/field (vm) gray-capacity) 0)
  (primitive/store! (primitive/field (vm) gray-stack) (primitive/cast (ptr (ptr Obj)) 0))
  (init-table (primitive/field (vm) globals))
  (init-table (primitive/field (vm) strings))
  (primitive/store! (primitive/field (vm) init-string) (primitive/cast (ptr ObjString) 0))
  (primitive/store! (primitive/field (vm) init-string) (copy-string (primitive/cast (ptr u8) c"init") 4))
  (define-native (primitive/cast (ptr u8) c"clock") (primitive/fnptr-of clock-native))
  0)

(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern fseek :cc c [(ptr i8) i64 i32] (-> i32))
(extern ftell :cc c [(ptr i8)] (-> i64))
(extern rewind :cc c [(ptr i8)] (-> void))
(extern fread :cc c [(ptr i8) i64 i64 (ptr i8)] (-> i64))
(extern fclose :cc c [(ptr i8)] (-> i32))

(defn read-file [(path (ptr i8))] (-> (ptr u8))
  (let [file (fopen path c"rb")]
    (if (= (primitive/cast i64 file) 0)
      (do (w-cstr 2 c"Could not open file.\n") (exit (primitive/cast i32 74)) (primitive/cast (ptr u8) 0))
      (do
        (fseek file 0 (primitive/cast i32 2))  ; SEEK_END
        (let [file-size (ftell file)]
          (rewind file)
          (let [buffer (primitive/cast (ptr u8) (malloc (+ file-size 1)))]
            (if (= (primitive/cast i64 buffer) 0)
              (do (w-cstr 2 c"Not enough memory to read file.\n") (exit (primitive/cast i32 74)) (primitive/cast (ptr u8) 0))
              (let [bytes-read (fread (primitive/cast (ptr i8) buffer) 1 file-size file)]
                (primitive/store! (primitive/index buffer bytes-read) (primitive/cast u8 0))
                (fclose file)
                buffer))))))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (primitive/store! (gc-stress-cell) (if (= (primitive/cast i64 (getenv c"CLOX_GC_STRESS")) 0) 0 1))
  (init-vm)
  (let [n (primitive/cast i64 argc)]
    (if (= n 2)
      (let [source (read-file (primitive/load (primitive/index argv 1)))
            result (interpret source)]
        (cond (= result INTERPRET_COMPILE_ERROR) 65
              (= result INTERPRET_RUNTIME_ERROR) 70
              0))
      (do (w-cstr 2 c"Usage: clox [path]\n") 64))))
