; ============================================================================
; cputest.coil — run a CP/M .COM diagnostic on the i8080 core and print its
; BDOS output. Mirrors src/apps/invaders/ref/cputest.c (the golden harness): load at
; 0x0100, PC=0x0100, intercept CALL 5 (C_WRITESTR / C_WRITE) and a return to 0.
;   coil run cputest.coil -- /path/to/CPUTEST.COM
; ============================================================================
(module app)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "i8080.coil"   :use *)
(import "control.coil" :use *)   ; while / cond

(extern putchar :cc c [:i32] (-> :i32))

; BDOS call at 0x0005: C=9 => print $-terminated string at DE; C=2 => print char E.
(defn bdos [(s (ptr Cpu))] (-> i64)
  (let [c (reg s 1)]
    (cond
      (= c 9)
        (let [p (alloc/stack i64)]
          (do (primitive/store! p (| (<< (reg s 2) 8) (reg s 3)))
              (while (!= (rb s (primitive/load p)) 0x24)
                (putchar (primitive/cast :i32 (rb s (primitive/load p))))
                (primitive/store! p (+ (primitive/load p) 1)))
              0))
      (= c 2) (do (putchar (primitive/cast :i32 (reg s 3))) 0)
      0)))

(defn run [(s (ptr Cpu))] (-> i64)
  (do (while (!= (rpc s) 0)
        (cond
          (= (rpc s) 5) (do (bdos s) (spc s (pop16 s)))   ; handle + manual RET
          (emulate s)))
      (putchar (primitive/cast :i32 10))     ; trailing newline, like the C harness
      0))

(defn main [(argc :i32) (argv (ptr (ptr i8)))] (-> :i64)
  (let [s (alloc/stack Cpu)]
    (if (< (primitive/cast :i64 argc) 2)
        1
        (do (init s)
            (if (< (load-com s (primitive/load (primitive/index argv 1)) 0x100) 0)
                1
                (do (spc s 0x100) (run s) 0))))))
