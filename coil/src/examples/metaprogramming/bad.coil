(module app)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "checker.coil" :use *)
(defstruct Node [(val :i64)])
(defn use-bad [(p (ptr Node))] (-> :i64)
  (check-uaf
    (primitive/store! (primitive/field p val) 7)
    (primitive/free p)                 ; freed here
    (primitive/load (primitive/field p val))))   ; ← USE AFTER FREE
(defn main [] (-> :i64)
  (let [n (alloc/heap Node)] (use-bad n)))
