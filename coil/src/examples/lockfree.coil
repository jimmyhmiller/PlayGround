; Concurrency dogfood, stage 2: a genuinely LOCK-FREE stack (Treiber stack) via
; compare-and-swap — NO mutex, only `atomic-cas` (src/stdlib/atomic.coil, pure llvm-ir). N
; threads concurrently PUSH M distinct pre-allocated nodes onto a shared stack
; (contending on the head pointer via CAS); then a single thread drains it and counts
; → exactly N·M, proving no push was lost under contention.
;
; ABA — handled honestly (not faked): the classic ABA hazard needs a node to be freed
; and REUSED while another thread holds a stale pointer to it. This dogfood SIDESTEPS
; ABA by construction — nodes are pre-allocated once, never freed, and each thread
; pushes a DISJOINT range (no reuse, no concurrent pop during the push phase). A
; PRODUCTION lock-free stack with concurrent push/pop + reclamation needs tagged
; pointers / hazard pointers / epoch reclamation; this is a bounded demonstration, not
; that. It IS genuinely lock-free (CAS only, no hidden lock).
;   coil run src/examples/lockfree.coil; echo $?   => 0   (all 4*1000 pushes survived)
(module app)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "src/stdlib/atomic.coil" :use *)
(import "src/stdlib/thread.coil" :use *)

(extern malloc :cc c [i64] (-> (ptr i8)))

(defstruct Node  [(val i64) (next i64)])               ; next = node address as i64 (0 = null)
(defstruct WArgs [(head (ptr i64)) (pool (ptr Node)) (start i64) (count i64)])

; push node at address `na` onto the stack whose head-cell is `head` (CAS retry loop).
(defn lf-push [(head (ptr i64)) (na i64)] (-> i64)
  (let [node (primitive/cast (ptr Node) na)]
    (loop
      (let [old (atomic-load head)]
        (primitive/store! (primitive/field node next) old)                 ; node.next = current head
        (if (primitive/icmp-eq (atomic-cas head old na) old)     ; CAS head: old -> na
            (break)
            0))))
  0)

; pop the top node (returns its address, or 0 if empty).
(defn lf-pop [(head (ptr i64))] (-> i64)
  (let [result (alloc/stack i64)]
    (loop
      (let [old (atomic-load head)]
        (if (primitive/icmp-eq old 0)
            (do (primitive/store! result 0) (break))
            (let [nxt (primitive/load (primitive/field (primitive/cast (ptr Node) old) next))]
              (if (primitive/icmp-eq (atomic-cas head old nxt) old)
                  (do (primitive/store! result old) (break))
                  0)))))
    (primitive/load result)))

(defn worker [(arg (ptr i8))] (-> (ptr i8))
  (let [w (primitive/cast (ptr WArgs) arg) (mut i) 0]
    (loop
      (if (primitive/icmp-ge (primitive/load i) (primitive/load (primitive/field w count)))
          (break)
          (do
            (let [k  (primitive/iadd (primitive/load (primitive/field w start)) (primitive/load i))
                  na (primitive/cast i64 (primitive/cast (ptr i8) (primitive/index (primitive/load (primitive/field w pool)) k)))]
              (primitive/store! (primitive/field (primitive/cast (ptr Node) na) val) k)   ; tag the node with its index
              (lf-push (primitive/load (primitive/field w head)) na))
            (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (primitive/cast (ptr i8) 0))

(defn main [] (-> :i64)
  (let [head    (alloc/stack i64)
        pool    (primitive/cast (ptr Node) (malloc (primitive/imul 4000 16)))   ; 4000 pre-allocated nodes
        wargs   (alloc/stack (array WArgs 4))
        threads (alloc/stack (array Thread 4))
        (mut i) 0]
    (primitive/store! head 0)
    ; spawn 4 workers, each pushing its disjoint 1000-node range onto the shared stack
    (loop
      (if (primitive/icmp-ge (primitive/load i) 4)
          (break)
          (do (primitive/store! (primitive/field (primitive/index wargs (primitive/load i)) head)  head)
              (primitive/store! (primitive/field (primitive/index wargs (primitive/load i)) pool)  pool)
              (primitive/store! (primitive/field (primitive/index wargs (primitive/load i)) start) (primitive/imul (primitive/load i) 1000))
              (primitive/store! (primitive/field (primitive/index wargs (primitive/load i)) count) 1000)
              (thread-spawn (primitive/index threads (primitive/load i)) (primitive/fnptr-of worker)
                            (primitive/cast (ptr i8) (primitive/index wargs (primitive/load i))))
              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    ; join all
    (primitive/store! i 0)
    (loop
      (if (primitive/icmp-ge (primitive/load i) 4)
          (break)
          (do (thread-join (primitive/index threads (primitive/load i)))
              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    ; drain the stack single-threaded and count — must be exactly 4000.
    (let [(mut count) 0 (mut na) (lf-pop head)]
      (loop
        (if (primitive/icmp-eq (primitive/load na) 0)
            (break)
            (do (primitive/store! count (primitive/iadd (primitive/load count) 1))
                (primitive/store! na (lf-pop head)))))
      (primitive/isub (primitive/load count) 4000))))   ; 0 iff every concurrent CAS-push survived
