; src/stdlib/mem.coil — typed low-level memory ops over libc (copy/move/zero/fill/eql).
;   coil run src/examples/mem.coil; echo $?   => 107
(module app)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "src/stdlib/mem.coil" :use *)

(defn main [] (-> :i64)
  (let [src (alloc/stack (array i64 4))
        dst (alloc/stack (array i64 4))]
    (mem-fill (primitive/index src 0) 7 4)                 ; src = [7 7 7 7]
    (mem-copy (primitive/index dst 0) (primitive/index src 0) 4)     ; dst = [7 7 7 7]
    (primitive/iadd (primitive/load (primitive/index dst 3))                    ; 7
          (if (mem-eql (primitive/index src 0) (primitive/index dst 0) 4) 100 0))))   ; + 100 = 107
