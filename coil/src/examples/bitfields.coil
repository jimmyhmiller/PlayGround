(module example.bitfields)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
; Bitfields: a :layout bits struct packs sub-byte fields into one backing int.
; Fields are accessed by value with bit-get/bit-set! (bits have no address), and each
; field reads/writes as its uN type -- composing with the arbitrary-width ints.
;   coil run src/examples/bitfields.coil; echo $?   => 42

; An RGB565 colour packed into 16 bits.
(defstruct Rgb565 :layout bits :backing :i16
  [(b :bits 5)     ; bits 0-4
   (g :bits 6)     ; bits 5-10
   (r :bits 5)])   ; bits 11-15

(static-assert (primitive/icmp-eq (primitive/sizeof Rgb565) 2) "RGB565 is exactly 16 bits")

(defn main [] (-> :i64)
  (let [c (alloc/stack Rgb565)]
    (primitive/bit-set! c r (primitive/cast :u5 20))
    (primitive/bit-set! c g (primitive/cast :u6 10))     ; setting g must not disturb r
    (primitive/bit-set! c b (primitive/cast :u5 12))
    (primitive/iadd (primitive/imul (primitive/cast :i64 (primitive/bit-get c r)) 1)    ; 20
          (primitive/iadd (primitive/cast :i64 (primitive/bit-get c g))       ; 10
                (primitive/cast :i64 (primitive/bit-get c b))))))    ; 12  -> 42
