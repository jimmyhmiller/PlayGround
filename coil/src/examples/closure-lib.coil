; Use the closure library via the module system.
;   coil run src/examples/closure-lib.coil; echo $?   => 42
(module app)
(import "primitive.coil" :as primitive)
(import "src/stdlib/closure.coil" :use *); brings the `defclosure` macro into scope

(defclosure adder  [(n :i64)] [(x :i64)] :i64 (primitive/iadd n x))
(defclosure scaler [(k :i64)] [(x :i64)] :i64 (primitive/imul k x))

(defn main [] (-> :i64)
  (let [a (adder-new 5) s (scaler-new 3)]
    (let [r (primitive/iadd (adder-call a 37) (primitive/isub (scaler-call s 14) 42))]
      (adder-free a) (scaler-free s)
      r)))
