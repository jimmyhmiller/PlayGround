; ======================================================================
; everything.coil -- one program exercising every feature Coil supports
; today. Each `feat-*` returns a value the harness in `main` checks; if any
; check fails, `main` returns that check's number (1..24) instead of 42, so
; the exit code names the broken feature. Success => exit 42 (plus some
; printed output from the IO / extern demos).
;   coil run src/examples/everything.coil; echo $?     => 42
;
; Run from the project root so the (import "src/stdlib/...") paths resolve.
; ======================================================================

; --- Modules: pull in the userland allocator, IO, and closure libraries.
;     `import` loads another module; `:use *` brings its names in unqualified
;     (`result.coil` arrives once, via the load-once guard).
(module app)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "src/stdlib/alloc.coil" :use *)   ; Allocator vtable, malloc + arena, create/destroy
(import "src/stdlib/io.coil" :use *)      ; Writer/Reader capability, print-int/str, FixBuf
(import "src/stdlib/result.coil" :use *)  ; Option/Result/Some/None/Ok/Err
(import "src/stdlib/closure.coil" :use *); the `defclosure` macro

; --- C interop: extern declarations (convention + signature, link-time symbol).
(extern printf  :cc c [(ptr i8) ...] (-> i32))   ; variadic
(extern putchar :cc c [:i64] (-> :i64))
(extern puts    :cc c [(ptr i8)] (-> :i32))
(extern div     [:i32 :i32] (-> DivT))           ; returns a struct BY VALUE (SysV/AAPCS64)

; ======================================================================
; Types: structs, arrays, nested structs, sums, generic struct, layouts
; ======================================================================
(defstruct Point  [(x :i64) (y :i64)])
(defstruct Rect   [(lo Point) (hi Point)])              ; nested structs by value
(defstruct DivT   [(quot :i32) (rem :i32)])             ; libc div_t
(defstruct Pair   [A B] [(fst A) (snd B)])              ; generic struct
(defstruct Px     [(r :u8) (g :u8)])                    ; arbitrary-width int fields
(defstruct Flags  [(on bool) (off bool)])              ; real bool fields

(defsum Shape                                           ; non-generic sum type
  (Circle [(r :i64)])
  (Rect2  [(w :i64) (h :i64)]))

; Layout control (the dual of calling conventions), pinned with static-assert:
(defstruct Header :layout packed                        ; :packed = no padding
  [(magic :u16) (version :u8) (flags :u8) (length :u32)])
(static-assert (primitive/icmp-eq (primitive/sizeof Header) 8)            "packed header is 8 bytes")
(static-assert (primitive/icmp-eq (primitive/offsetof Header length) 4)   "length at byte 4")

(defstruct Line :layout (align 16) [(a :i64) (b :i64)]) ; over-aligned (alloca gets align 16)
(static-assert (primitive/icmp-eq (primitive/alignof :i64) 8)             "i64 aligns to 8")

(defstruct Reg :layout explicit :size 16 :align 8       ; :explicit = exact offsets
  [(status :u32         :at 0)
   (sbytes (array u8 4) :at 0)     ; same :at as status => an intentional union
   (data   :i64         :at 8)])   ; bytes 4..7 are explicit padding
(static-assert (primitive/icmp-eq (primitive/sizeof Reg) 16)              "Reg is 16 bytes")
(static-assert (primitive/icmp-eq (primitive/offsetof Reg data) 8)        "data at byte 8")

(defstruct Rgb565 :layout bits :backing :i16            ; :bits = sub-byte fields
  [(b :bits 5) (g :bits 6) (r :bits 5)])
(static-assert (primitive/icmp-eq (primitive/sizeof Rgb565) 2)            "RGB565 packs into 16 bits")

; ======================================================================
; User macros: a real compile-time Lisp (quasiquote/unquote/splice, & rest,
; recursion, helper lambdas, gensym hygiene, emitting top-level defs)
; ======================================================================
(defn when2 [(c Code) & (body Code)] (-> Code) `(if ~c (do ~@body) 0))   ; & rest + ~@ splice
(defn inc1 [(x Code)] (-> Code) `(primitive/iadd ~x 1))
(defn cond2-arms [(cs Code)] (-> Code)                   ; recursive Code-list helper
  (if (primitive/icmp-eq (primitive/code-count cs) 0) `0
    (if (primitive/icmp-eq (primitive/code-count cs) 1) (primitive/code-nth cs 0)
      `(if ~(primitive/code-nth cs 0) ~(primitive/code-nth cs 1) ~(cond2-arms (primitive/code-rest (primitive/code-rest cs)))))))
(defn cond2 [& (cs Code)] (-> Code) (cond2-arms cs))     ; variadic recursive macro
(defn powf [(x Code) (n i64)] (-> Code)                  ; compile-time helper fn
  (if (primitive/icmp-eq n 0) `1 `(primitive/imul ~x ~(powf x (primitive/isub n 1)))))
(defn pow2 [(x Code) (n Code)] (-> Code) (powf x (primitive/code-int n)))  ; unrolls to nested imuls
(defn dbl [(x Code)] (-> Code) (let [t (primitive/gensym)] `(let [~t ~x] (primitive/iadd ~t ~t))))  ; gensym hygiene
(defn defconst [(name Code) (v Code)] (-> Code) `(defn ~name [] (-> :i64) ~v))  ; emits a top-level defn
(defconst three 3)

; The check harness, itself a macro:
(defn chk [(got Code) (want Code) (code Code) (rest Code)] (-> Code) `(if (primitive/icmp-eq ~got ~want) ~rest ~code))

; ======================================================================
; Calling conventions (convention as type)
; ======================================================================
; :native -> a real LLVM calling convention (fastcc) on the fn and call sites.
(defcc fast2 :params [rax rdx] :ret rax :clobber [rax rdx rcx] :preserve [rbx rbp]
  :native fast)
(defn cadd :cc fast2 [(a :i64) (b :i64)] (-> :i64) (primitive/iadd a b))

; :lower shim -> a register layout LLVM's CC enum can't express; realized with a
; naked trampoline. Registers are load-bearing, so pick them per target arch.
(defn def-shimcc [(name Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-arch) `x86_64)
      `(defcc ~name :params [rax rdx] :ret rax
         :clobber [rax rdx rcx rsi rdi r8 r9 r10 r11] :lower shim)
      `(defcc ~name :params [x9 x10] :ret x9
         :clobber [x9 x10 x11 x12 x13 x14 x15] :lower shim)))
(def-shimcc shimcc)
(defn ssub :cc shimcc [(a :i64) (b :i64)] (-> :i64) (primitive/isub a b))

; ======================================================================
; Feature demos
; ======================================================================

; 1. Recursion, the `c` convention, integer arithmetic, `if`, comparisons.
(defn fib :cc c [(n :i64)] (-> :i64)
  (if (primitive/icmp-le n 1) n (primitive/iadd (fib (primitive/isub n 1)) (fib (primitive/isub n 2)))))
(defn feat-fib [] (-> :i64) (fib 10))                    ; => 55

; 2. A user convention lowering to fastcc.
(defn feat-conv [] (-> :i64) (cadd 20 22))               ; => 42

; 3. A shim convention (exotic registers) + per-arch macro selection.
(defn feat-shim [] (-> :i64) (let [x (primitive/iadd 40 10)] (ssub x 8)))   ; 50-8 => 42

; 4. Allocation as an operation: stack / static / heap + free (region-less ptrs).
(defn make-heap [(v :i64)] (-> (ptr i64))
  (let [p (alloc/heap i64)] (primitive/store! p v) p))             ; heap ptr crosses the boundary
(defn feat-alloc [] (-> :i64)
  (let [h (make-heap 10) s (alloc/static i64) f (alloc/stack i64)]
    (primitive/store! s 30) (primitive/store! f 2)
    (let [sum (primitive/iadd (primitive/load h) (primitive/iadd (primitive/load s) (primitive/load f)))]
      (primitive/free h) sum)))                                    ; 10+30+2 => 42

; 5. Allocators as values (Zig-style): the SAME code under malloc and an arena.
;    `create`/`destroy` are the typed generic layer (size/align via sizeof/alignof).
(defn boxed-add [(a (ptr Allocator)) (x :i64) (y :i64)] (-> :i64)
  (match (create [i64] a)                                ; (Option (ptr i64))
    (None []  0)
    (Some [p] (do (primitive/store! p (primitive/iadd x y))
                  (let [v (primitive/load p)] (destroy a p) v)))))
(defn feat-allocators [] (-> :i64)
  (let [gpa (malloc-allocator) arena (arena-allocator 1024)]
    (primitive/iadd (boxed-add gpa 30 5) (boxed-add arena 5 2))))  ; 35+7 => 42

; 6. IO as a capability value (Writer) composing with the allocator: an allocator
;    hands out a buffer, a fixed-buffer Writer formats into it, we flush to stdout.
(defn greet [(w (ptr Writer)) (n :i64)] (-> (Result :i64 IoError))
  (do (print-str w "answer=") (print-int w n) (write-byte w (primitive/cast :u8 10))))
(defn feat-io [] (-> :i64)
  (let [a   (malloc-allocator)
        buf (unwrap-ptr (alloc-slice [i8] a 64))
        fb  (alloc/static FixBuf)]
    (primitive/store! (primitive/field fb data) buf)
    (primitive/store! (primitive/field fb cap) 64)
    (greet (fixed-buffer-writer (alloc/stack Writer) fb) 42)                  ; format into the buffer
    (match (write-all (stdout) (primitive/load (primitive/field fb data)) (primitive/load (primitive/field fb len)))
      (Ok  [n] 42)
      (Err [e] 1))))                                     ; prints "answer=42" => 42

; 7. extern C interop: variadic printf, putchar, string literals.
(defn feat-extern [] (-> :i64)
  (do (printf c"coil: %d+%d=%d (%s)\n" 20 22 42 c"ok")
      (putchar 33) (putchar 10)                          ; '!' then newline
      42))

; 8. Struct-by-value across the C ABI: libc div() returns div_t by value.
(defn feat-structabi [] (-> :i64)
  (let [d (div 47 5)]                                    ; { quot:9, rem:2 }
    (primitive/iadd (primitive/imul (primitive/cast :i64 (primitive/load (primitive/field d quot))) 10)
          (primitive/cast :i64 (primitive/load (primitive/field d rem))))))            ; 9*10+2 => 92

; 9. Floats: f32/f64, fadd/fsub/fmul/fdiv/frem, ordered compares, int<->float cast.
(defn feat-floats [] (-> :i64)
  (let [base (primitive/fmul 3.0 14.0)                             ; 42.0
        adj  (primitive/fadd (primitive/fsub 5.0 5.0) (primitive/fdiv 0.0 2.0))]       ; 0.0
    (if (and (primitive/fcmp-lt 1.5 2.5) (primitive/fcmp-ge (primitive/frem 85.0 43.0) 41.0))
        (primitive/cast :i64 (primitive/cast :f32 (primitive/fadd base adj)))          ; f64 -> f32 -> i64
        0)))                                             ; => 42

; 10. Bitwise / shift ops (logical vs arithmetic shift by signedness).
(defn feat-bitwise [] (-> :i64)
  (let [hi (primitive/iand 255 (primitive/ior (primitive/ishl 1 5) 8))                 ; (32|8) & 255 = 40
        lo (primitive/ixor 3 1)                                    ; 2
        sh (primitive/cast :i64 (primitive/ishr (primitive/cast :u8 200) 2))           ; unsigned 200>>2 = 50
        nt (primitive/cast :i64 (primitive/iand (primitive/cast :u8 255) (primitive/inot (primitive/cast :u8 7))))]  ; ~7 & 255 = 248
    (primitive/iadd (primitive/isub (primitive/iadd hi lo) (primitive/isub sh 50))               ; 42
          (primitive/isub nt 248))))                               ; + 0 => 42

; 11. bool: literals, short-circuiting and/or/not, comparisons return bool.
(defn feat-bool [] (-> :i64)
  (let [(mut f) (primitive/zeroed Flags)]
    (primitive/store! (primitive/field f on) true)
    (primitive/store! (primitive/field f off) false)
    (if (and (primitive/load (primitive/field f on)) (not (primitive/load (primitive/field f off))))
        (if (or false true) 42 0)
        0)))

; 12. Arbitrary-width integers with real unsigned semantics (udiv, wrap).
(defn feat-widths [] (-> :i64)
  (let [a (primitive/cast :u8 200) b (primitive/cast :u8 50)]
    (primitive/iadd (primitive/imul (primitive/cast :i64 (primitive/idiv a b)) 10)               ; unsigned 200/50 = 4 -> 40
          (primitive/cast :i64 (primitive/cast :u2 6)))))                     ; 6 mod 4 = 2 => 42

; 13. Literal inference: bare literals adopt the iN/uN of their context.
(defn channel [(base :u8)] (-> :u8) (primitive/iadd base 1))        ; `1` infers u8
(defn feat-inference [] (-> :i64)
  (let [px (alloc/stack Px)]
    (primitive/store! (primitive/field px r) 40)                             ; 40 adopts u8 from (ptr u8)
    (primitive/store! (primitive/field px g) (channel 1))                    ; arg 1 adopts u8 -> 2
    (primitive/iadd (primitive/cast :i64 (primitive/load (primitive/field px r))) (primitive/cast :i64 (primitive/load (primitive/field px g))))))  ; => 42

; 14. Structs + arrays: field/index give pointers, then load/store!.
(defn feat-structs [] (-> :i64)
  (let [p (alloc/stack Point) a (alloc/stack (array i64 3))]
    (primitive/store! (primitive/field p x) 30) (primitive/store! (primitive/field p y) 4)
    (primitive/store! (primitive/index a 0) 1) (primitive/store! (primitive/index a 1) 2) (primitive/store! (primitive/index a 2) 5)
    (primitive/iadd (primitive/iadd (primitive/load (primitive/field p x)) (primitive/load (primitive/field p y)))
          (primitive/iadd (primitive/load (primitive/index a 0)) (primitive/iadd (primitive/load (primitive/index a 1)) (primitive/load (primitive/index a 2)))))))

; 15. References & mutability: immutable ref, `(mut T)`, `let` stack place, `(mut place)`.
(defn rect-area [(r Rect)] (-> :i64)                      ; immutable ref: reads only
  (primitive/imul (primitive/isub (primitive/load (primitive/field (primitive/field r hi) x)) (primitive/load (primitive/field (primitive/field r lo) x)))
        (primitive/isub (primitive/load (primitive/field (primitive/field r hi) y)) (primitive/load (primitive/field (primitive/field r lo) y)))))
(defn translate [(p (mut Point)) (dx :i64) (dy :i64)] (-> :i64)   ; mutable ref
  (do (primitive/store! (primitive/field p x) (primitive/iadd (primitive/load (primitive/field p x)) dx))
      (primitive/store! (primitive/field p y) (primitive/iadd (primitive/load (primitive/field p y)) dy)) 0))
(defn feat-refs [] (-> :i64)
  (let [(mut r) (primitive/zeroed Rect)]                            ; stack place of value type
    (primitive/store! (primitive/field (primitive/field r hi) x) 5)
    (primitive/store! (primitive/field (primitive/field r hi) y) 5)
    (translate (mut (primitive/field r hi)) 1 2)                    ; mutably borrow a nested place
    (rect-area r)))                                       ; hi now (6,7): 6*7 => 42

; 16. Generics by monomorphization, with inferred type arguments.
(defn id [T] [(x T)] (-> T) x)
(defn pair-sum [T] [(p (ptr (Pair T T)))] (-> T)
  (primitive/iadd (primitive/load (primitive/field p fst)) (primitive/load (primitive/field p snd))))
(defn feat-generics [] (-> :i64)
  (let [p (alloc/stack (Pair i64 i64))]
    (primitive/store! (primitive/field p fst) (id 40))                       ; T inferred = i64
    (primitive/store! (primitive/field p snd) 2)
    (pair-sum p)))                                        ; => 42

; 17. Sum types + match.
(defn area [(s Shape)] (-> :i64)
  (match s (Circle [r] (primitive/imul 3 (primitive/imul r r))) (Rect2 [w h] (primitive/imul w h))))
(defn feat-sum [] (-> :i64)
  (primitive/iadd (area (Circle 2)) (area (Rect2 5 6))))            ; 12 + 30 => 42

; 18. Closures as a LIBRARY (the `defclosure` macro): env struct + code + new/call/free.
(defclosure adder  [(n :i64)] [(x :i64)] :i64 (primitive/iadd n x))
(defclosure scaler [(k :i64)] [(x :i64)] :i64 (primitive/imul k x))
(defn feat-closure [] (-> :i64)
  (let [a (adder-new 5) s (scaler-new 3)]
    (let [res (primitive/iadd (adder-call a 37) (primitive/isub (scaler-call s 14) 42))]
      (adder-free a) (scaler-free s) res)))              ; (5+37)+(42-42) => 42

; 19. Function pointers + a vtable (array of fnptr), fnptr-of, call-ptr.
(defn op-add [(a :i64) (b :i64)] (-> :i64) (primitive/iadd a b))
(defn op-mul [(a :i64) (b :i64)] (-> :i64) (primitive/imul a b))
(defn feat-vtable [] (-> :i64)
  (let [vt (alloc/stack (array (fnptr c [:i64 :i64] :i64) 2))]
    (primitive/store! (primitive/index vt 0) (primitive/fnptr-of op-add))
    (primitive/store! (primitive/index vt 1) (primitive/fnptr-of op-mul))
    (primitive/iadd (primitive/call-ptr (primitive/load (primitive/index vt 0)) 20 20)           ; 40
          (primitive/call-ptr (primitive/load (primitive/index vt 1)) 1 2))))          ; 2 => 42

; 20. Bitfields: by-value get/set! on a packed backing integer.
(defn feat-bits [] (-> :i64)
  (let [c (alloc/stack Rgb565)]
    (primitive/bit-set! c r (primitive/cast :u5 20)) (primitive/bit-set! c g (primitive/cast :u6 10)) (primitive/bit-set! c b (primitive/cast :u5 12))
    (primitive/iadd (primitive/cast :i64 (primitive/bit-get c r)) (primitive/iadd (primitive/cast :i64 (primitive/bit-get c g)) (primitive/cast :i64 (primitive/bit-get c b))))))

; 21. Explicit layout + union: byte-offset field access into a blob.
(defn feat-explicit [] (-> :i64)
  (let [rg (alloc/stack Reg)]
    (primitive/store! (primitive/field rg status) (primitive/cast :u32 2))             ; 32-bit word
    (primitive/store! (primitive/field rg data) 40)
    (primitive/iadd (primitive/cast :i64 (primitive/load (primitive/index (primitive/field rg sbytes) 0))) ; low byte of status (union) = 2
          (primitive/load (primitive/field rg data)))))                      ; 40 => 42

; 22. Packed/aligned layout + sizeof/offsetof/alignof (asserted above).
(defn feat-packed [] (-> :i64)
  (let [h (alloc/stack Header) ln (alloc/stack Line)]    ; Line exercises (align 16)
    (primitive/store! (primitive/field ln a) 0) (primitive/store! (primitive/field ln b) 0)
    (primitive/store! (primitive/field h length) (primitive/cast :u32 40))
    (primitive/store! (primitive/field h version) (primitive/cast :u8 2))
    (primitive/iadd (primitive/cast :i64 (primitive/load (primitive/field h length))) (primitive/cast :i64 (primitive/load (primitive/field h version))))))

; 23. The user macros above, exercised together.
(defn classify [(n :i64)] (-> :i64)
  (cond2 (primitive/icmp-lt n 0) 100 (primitive/icmp-eq n 0) 200 300))       ; recursive cond macro
(defn feat-macros [] (-> :i64)
  (when2 (primitive/icmp-eq (classify 0) 200)                      ; when + & rest
    (primitive/iadd (pow2 (three) 3)                               ; compile-time pow: 3^3 = 27
          (dbl (inc1 6)))))                              ; (6+1)*2 = 14 => 41

; 24. Typed pointers: c"…" (ptr i8) string literal, sizeof, int<->ptr cast, index/load.
(defn feat-ptr [] (-> :i64)
  (let [s c"coil" p (alloc/stack (array i64 2))]
    (primitive/store! (primitive/index p 0) 10) (primitive/store! (primitive/index p 1) 19)
    (let [nullp (primitive/cast (ptr i8) 0)
          isnull (if (primitive/icmp-eq (primitive/cast :i64 nullp) 0) 1 0)]
      (primitive/iadd (primitive/sizeof i64)                                 ; 8
            (primitive/iadd (strlen s)                             ; "coil" -> 4
                  (primitive/iadd isnull                           ; null is 0 -> 1
                        (primitive/iadd (primitive/load (primitive/index p 0)) (primitive/load (primitive/index p 1)))))))))  ; 29 => 42

; ======================================================================
; main: C entry taking argc/argv; runs every check. Exit 42 iff all pass,
; else the failing check's number.
; ======================================================================
(defn main [(argc :i32) (argv (ptr (ptr i8)))] (-> :i64)
  (do
    (printf c"coil/everything.coil (argc=%d), running 24 checks:\n" argc)
    (puts (primitive/load (primitive/index argv 0)))                          ; argv[0] = program path
    (chk (feat-fib)        55  1
    (chk (feat-conv)       42  2
    (chk (feat-shim)       42  3
    (chk (feat-alloc)      42  4
    (chk (feat-allocators) 42  5
    (chk (feat-io)         42  6
    (chk (feat-extern)     42  7
    (chk (feat-structabi)  92  8
    (chk (feat-floats)     42  9
    (chk (feat-bitwise)    42 10
    (chk (feat-bool)       42 11
    (chk (feat-widths)     42 12
    (chk (feat-inference)  42 13
    (chk (feat-structs)    42 14
    (chk (feat-refs)       42 15
    (chk (feat-generics)   42 16
    (chk (feat-sum)        42 17
    (chk (feat-closure)    42 18
    (chk (feat-vtable)     42 19
    (chk (feat-bits)       42 20
    (chk (feat-explicit)   42 21
    (chk (feat-packed)     42 22
    (chk (feat-macros)     41 23
    (chk (feat-ptr)        42 24
      42))))))))))))))))))))))))))
