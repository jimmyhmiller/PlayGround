; Control-flow sugar from src/stdlib/control.coil — all pure macros, nothing in the
; compiler knows about them.
;   coil run src/examples/control.coil; echo $?   => 46
(module app)
(import "primitive.coil" :as primitive)
(import "src/stdlib/control.coil" :use *)

(defn main [] (-> :i64)
  (let [(mut acc) 0]
    ; `inline-for` fully unrolls at compile time: i = 0,1,2,3 as literals.
    (inline-for [i 0 4] (primitive/store! acc (primitive/iadd (primitive/load acc) i)))            ; 0+1+2+3 = 6
    ; `when` / `unless` desugar to `if` over `do`.
    (when   (primitive/icmp-eq (primitive/load acc) 6) (primitive/store! acc (primitive/iadd (primitive/load acc) 10))) ; -> 16
    (unless (primitive/icmp-eq (primitive/load acc) 0) (primitive/store! acc (primitive/iadd (primitive/load acc) 5)))  ; -> 21
    ; `cond` desugars to nested `if`s; a lone trailing clause is the else.
    (let [c (cond (primitive/icmp-lt (primitive/load acc) 10) 1
                  (primitive/icmp-lt (primitive/load acc) 30) 2
                  3)]                                                 ; 21 -> 2
      (primitive/iadd (primitive/imul (primitive/iadd (primitive/load acc) 1) 2) c))))                        ; (21+1)*2 + 2 = 46
