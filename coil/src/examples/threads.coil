; Concurrency dogfood: N worker threads each do M atomic increments on a SHARED
; counter. The result is exactly N·M — race-free — proving the atomic library (over
; llvm-ir, zero core feature) genuinely synchronizes across real threads. A plain
; load+add+store would race and lose updates (shown in tests/threads.rs as a
; demonstration — non-deterministic, so NOT an asserted test).
;   coil run src/examples/threads.coil; echo $?   => 0   (counter == 4 * 100000)
(module app)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "src/stdlib/atomic.coil" :use *)
(import "src/stdlib/thread.coil" :use *)

(defn worker [(arg (ptr i8))] (-> (ptr i8))
  (let [counter (primitive/cast (ptr i64) arg) (mut i) 0]
    (loop
      (if (primitive/icmp-ge (primitive/load i) 100000)
          (break)
          (do (atomic-add counter 1)               ; the atomic fetch-add
              (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (primitive/cast (ptr i8) 0))

(defn main [] (-> :i64)
  (let [counter (alloc/stack i64)
        threads (alloc/stack (array Thread 4))
        (mut i) 0]
    (primitive/store! counter 0)
    ; spawn 4 workers, all sharing `counter`
    (loop
      (if (primitive/icmp-ge (primitive/load i) 4)
          (break)
          (do (thread-spawn (primitive/index threads (primitive/load i)) (primitive/fnptr-of worker) (primitive/cast (ptr i8) counter))
              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    ; join them all
    (primitive/store! i 0)
    (loop
      (if (primitive/icmp-ge (primitive/load i) 4)
          (break)
          (do (thread-join (primitive/index threads (primitive/load i)))
              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/isub (primitive/load counter) 400000)))   ; 0 iff race-free (4 threads x 100k)
