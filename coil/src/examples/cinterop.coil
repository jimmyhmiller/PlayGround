; C-interop dogfood — battle-tests "as low as Zig/C: lives in the C ecosystem" by
; calling REAL C library functions across the C ABI #5 built, AT SCALE:
;   - qsort with a Coil COMPARATOR CALLBACK — C calls BACK into Coil (the headline:
;     Coil functions are callable from C via fnptr-of + the c convention);
;   - libm sqrt/pow — the FLOAT C ABI (f64 args + return);
;   - libc div — a struct (div_t) returned BY VALUE across the ABI;
;   - libc strtol — a (ptr i8)/c"…" argument.
; All four independently compute/confirm 42; main returns 42 iff they all agree.
;   coil run src/examples/cinterop.coil; echo $?   => 42
(module app)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "src/stdlib/control.coil" :use *)   ; `all` (variadic and)

; ---- externs (real libc / libm) --------------------------------------------
; void qsort(void* base, size_t n, size_t size, int(*cmp)(const void*,const void*))
(extern qsort  :cc c [(ptr i8) i64 i64 (fnptr c [(ptr i8) (ptr i8)] i32)] (-> void))
(extern sqrt   :cc c [f64] (-> f64))
(extern pow    :cc c [f64 f64] (-> f64))
(extern strtol :cc c [(ptr i8) (ptr i8) i32] (-> i64))
(defstruct DivT [(quot i32) (rem i32)])
(extern div    :cc c [i32 i32] (-> DivT))         ; div_t div(int, int), returned by value

; ---- a Coil comparator that C's qsort calls back into ----------------------
(defn i64-cmp [(a (ptr i8)) (b (ptr i8))] (-> i32)
  (let [x (primitive/load (primitive/cast (ptr i64) a)) y (primitive/load (primitive/cast (ptr i64) b))]
    (if (primitive/icmp-lt x y) (primitive/cast i32 -1) (if (primitive/icmp-gt x y) (primitive/cast i32 1) (primitive/cast i32 0)))))

(defn sorted? [(arr (ptr i64)) (n i64)] (-> bool)
  (let [(mut i) 1 (mut ok) 1]
    (loop
      (if (primitive/icmp-ge (primitive/load i) n)
          (break)
          (do (if (primitive/icmp-gt (primitive/load (primitive/index arr (primitive/isub (primitive/load i) 1))) (primitive/load (primitive/index arr (primitive/load i))))
                  (primitive/store! ok 0) 0)
              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/icmp-eq (primitive/load ok) 1)))

(defn main [] (-> :i64)
  (let [arr (alloc/stack (array i64 6))]
    (primitive/store! (primitive/index arr 0) 30) (primitive/store! (primitive/index arr 1) 10) (primitive/store! (primitive/index arr 2) 50)
    (primitive/store! (primitive/index arr 3) 42) (primitive/store! (primitive/index arr 4) 20) (primitive/store! (primitive/index arr 5) 40)
    ; C qsort, with our Coil comparator as the callback
    (qsort (primitive/cast (ptr i8) (primitive/index arr 0)) 6 8 (primitive/fnptr-of i64-cmp))
    (let [s   (primitive/cast i64 (sqrt 1764.0))                 ; libm: sqrt(1764) = 42.0
          p   (primitive/cast i64 (pow 6.0 1.0))                 ; libm: pow(6,1)  = 6.0  -> *7 = 42
          n   (strtol c"42" (primitive/cast (ptr i8) 0) 10)      ; libc: parse "42" = 42
          d   (div 84 2)]                              ; libc: 84/2 = {quot 42, rem 0}
      ; all four agree on 42, and qsort placed 42 at index 3 of the sorted array.
      (if (all (sorted? (primitive/index arr 0) 6)
               (primitive/icmp-eq (primitive/load (primitive/index arr 4)) 42)       ; sorted [10 20 30 40 42 50]: 42 at idx 4
               (primitive/icmp-eq s 42)
               (primitive/icmp-eq (primitive/imul p 7) 42)
               (primitive/icmp-eq n 42)
               (primitive/icmp-eq (primitive/cast i64 (primitive/load (primitive/field d quot))) 42))
          42
          0))))
