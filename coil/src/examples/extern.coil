(module example.extern)
(import "primitive.coil" :as primitive)
; C interop via `extern`: declare a foreign function's convention + signature,
; and the type checker enforces calls to it. Links against libc.
;   coil run src/examples/extern.coil   prints: 12345

(extern putchar :cc c [:i64] (-> :i64))   ; int putchar(int?)

; Print a non-negative integer in decimal, most-significant digit first.
(defn print-int [(n :i64)] (-> :i64)
  (if (primitive/icmp-lt n 10)
      (putchar (primitive/iadd n 48))                       ; '0' + n
      (do (print-int (primitive/idiv n 10))                 ; higher digits first
          (putchar (primitive/iadd (primitive/irem n 10) 48)))))

(defn main [] (-> :i64)
  (do (print-int 12345)
      (putchar 10)                                ; newline
      0))
