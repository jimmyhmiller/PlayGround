; src/compiler/formatter/dump.coil — validate the CST reader: print the node tree, indented, with
; each node's kind, nl-before, and raw text.
;   ./target/release/coil run src/compiler/formatter/dump.coil <file.coil>
(module app)
(import "../../stdlib/primitive.coil" :as primitive)
(import "../../stdlib/alloc.coil"     :use *)
(import "slice.coil"     :use *)
(import "str.coil"       :use *)
(import "arraylist.coil" :use *)
(import "io.coil"        :use *)
(import "cst.coil"   :use *)

(extern open  :cc c [(ptr i8) i32] (-> i32))
(extern close :cc c [i32] (-> i32))

(defn read-file [(a (ptr Allocator)) (path (ptr i8))] (-> (slice u8))
  (let [fd (open path 0) buf (unwrap-ptr [i8] (raw-alloc a 65536 1)) (mut bytes) (al-new [u8] a)]
    (loop
      (let [n (read fd buf 65536)]
        (if (primitive/icmp-le n 0) (break)
          (let [(mut i) 0]
            (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
                (do (al-push! (mut bytes) (primitive/cast u8 (primitive/load (primitive/index buf (primitive/load i)))))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))))
    (close fd)
    (al-slice [u8] (primitive/load bytes))))

(defn indent [(w (ptr Writer)) (d i64)] (-> i64)
  (let [(mut i) 0] (loop (if (primitive/icmp-ge (primitive/load i) d) (break)
    (do (print-str w "  ") (primitive/store! i (primitive/iadd (primitive/load i) 1)))))) 0)

(defn dump-node [(w (ptr Writer)) (n (ptr Node)) (d i64)] (-> i64)
  (indent w d)
  (print-str w "[nl=") (print-int w (node-nl n)) (print-str w "] ")
  (if (node-comment? n)
      (do (print-str w "COMMENT ") (print-str w (node-raw n)) (print-str w "\n") 0)
    (if (node-atom? n)
        (do (print-str w "ATOM ") (print-str w (node-raw n)) (print-str w "\n") 0)
      (if (node-list? n)
          (do (print-str w (if (primitive/icmp-eq (node-open n) 40) "( LIST\n" "[ VEC\n"))
              (let [(mut i) 0 c (node-count n)]
                (loop (if (primitive/icmp-ge (primitive/load i) c) (break)
                  (do (dump-node w (node-nth n (primitive/load i)) (primitive/iadd d 1))
                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))) 0)
        (do (print-str w "PREFIX\n") 0))))
  0)

(defn main [(argc :i32) (argv (ptr (ptr i8)))] (-> :i64)
  (let [a (malloc-allocator) w (stdout)]
    (if (primitive/icmp-lt (primitive/cast i64 argc) 2)
        (do (print-str w "usage: dump <file.coil>\n") 1)
      (let [src (read-file a (primitive/load (primitive/index argv 1)))
            doc (read-doc a src)
            n (al-len [(ptr Node)] (primitive/load doc)) (mut i) 0]
        (print-str w "forms: ") (print-int w n) (print-str w "\n")
        (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
          (do (dump-node w (al-get [(ptr Node)] (primitive/load doc) (primitive/load i)) 0)
              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
        0))))
