; src/compiler/formatter/cst.coil — Concrete Syntax Tree for the Coil formatter.
;
; A byte-level recursive reader that, unlike the compiler's reader, preserves the
; things a formatter must never lose: comments (as first-class nodes, so they keep
; their position in a form), blank lines (an nl-before count on every node), and
; the verbatim text of every atom/string (we never reformat a number or string's
; insides). Delimiters (), [] are kept distinct. Prefix reader macros ' ` ~ ~@ are
; nodes that wrap their target so they print glued to it.
(module cst)
(import "../../stdlib/primitive.coil" :as primitive)
(import "../../stdlib/alloc.coil" :as alloc     :use *)
(import "slice.coil"     :use *)
(import "str.coil"       :use *)
(import "arraylist.coil" :use *)

; ---- node model ------------------------------------------------------------
; NAtom    — any verbatim token: int, float, symbol, keyword, "string", c"cstr".
; NList    — open is the delimiter byte: 40 '(' or 91 '['. items are children in
;            source order (comments interleaved).
; NComment — a "; ..." line, verbatim (trailing spaces trimmed, no newline).
; NPrefix  — a reader-macro glyph glued to the form it wraps.
(defsum NodeKind
  (NAtom    [(raw (slice u8))])
  (NList    [(open i64) (items (ptr (ArrayList (ptr Node))))])
  (NComment [(raw (slice u8))])
  (NPrefix  [(op (slice u8)) (inner (ptr Node))]))

; nl-before: count of newlines between the previous token and this node's start.
;   0   => same line as the previous node
;   1   => next line
;   >=2 => blank line(s) before it (we later preserve exactly one)
(defstruct Node [(kind NodeKind) (nl-before i64)])

(defn box-node [(a (ptr Allocator)) (k NodeKind) (nl i64)] (-> (ptr Node))
  (let [p (unwrap-ptr [Node] (create [Node] a))]
    (primitive/store! (primitive/field p kind) k) (primitive/store! (primitive/field p nl-before) nl)
    p))

; ---- reader cursor ---------------------------------------------------------
(defstruct Rdr [(src (slice u8)) (pos i64) (a (ptr Allocator))])

(defn r-end? [(r (ptr Rdr))] (-> bool)
  (primitive/icmp-ge (primitive/load (primitive/field r pos)) (slice-len (primitive/load (primitive/field r src)))))
(defn r-peek [(r (ptr Rdr))] (-> i64)
  (if (r-end? r) -1 (primitive/cast i64 (slice-get (primitive/load (primitive/field r src)) (primitive/load (primitive/field r pos))))))
(defn r-peek2 [(r (ptr Rdr))] (-> i64)
  (let [p (primitive/iadd (primitive/load (primitive/field r pos)) 1)]
    (if (primitive/icmp-ge p (slice-len (primitive/load (primitive/field r src)))) -1
        (primitive/cast i64 (slice-get (primitive/load (primitive/field r src)) p)))))
(defn r-adv [(r (ptr Rdr))] (-> i64)
  (primitive/store! (primitive/field r pos) (primitive/iadd (primitive/load (primitive/field r pos)) 1)) 0)

; ---- character classes -----------------------------------------------------
(defn is-ws [(c i64)] (-> bool)
  (or (primitive/icmp-eq c 32) (or (primitive/icmp-eq c 9) (or (primitive/icmp-eq c 10)
      (or (primitive/icmp-eq c 13) (or (primitive/icmp-eq c 11) (primitive/icmp-eq c 12)))))))

; a byte that ends an atom run: whitespace, any delimiter, comment, string, or a
; reader-macro glyph, or EOF.
(defn is-atom-delim [(c i64)] (-> bool)
  (if (or (primitive/icmp-eq c -1) (is-ws c))
      true
      (or (primitive/icmp-eq c 40) (or (primitive/icmp-eq c 41) (or (primitive/icmp-eq c 91) (or (primitive/icmp-eq c 93)
          (or (primitive/icmp-eq c 59) (or (primitive/icmp-eq c 34) (or (primitive/icmp-eq c 39)
          (or (primitive/icmp-eq c 96) (primitive/icmp-eq c 126)))))))))))

; ---- whitespace ------------------------------------------------------------
; skip spaces/tabs/newlines (NOT comments — those are nodes); return newline count.
(defn skip-ws [(r (ptr Rdr))] (-> i64)
  (let [(mut nl) 0]
    (loop
      (let [c (r-peek r)]
        (if (is-ws c)
            (do (when (primitive/icmp-eq c 10) (primitive/store! nl (primitive/iadd (primitive/load nl) 1))) (r-adv r))
            (break))))
    (primitive/load nl)))

; trim trailing spaces/tabs off a slice (used for comment text)
(defn trim-trailing [(s (slice u8))] (-> (slice u8))
  (let [(mut n) (slice-len s)]
    (loop
      (if (primitive/icmp-le (primitive/load n) 0) (break)
        (let [c (primitive/cast i64 (slice-get s (primitive/isub (primitive/load n) 1)))]
          (if (or (primitive/icmp-eq c 32) (primitive/icmp-eq c 9)) (primitive/store! n (primitive/isub (primitive/load n) 1)) (break)))))
    (subslice s 0 (primitive/load n))))

; ---- token readers ---------------------------------------------------------
; a "; ..." comment, verbatim to end of line (newline not consumed).
(defn read-comment [(r (ptr Rdr))] (-> (slice u8))
  (let [start (primitive/load (primitive/field r pos))]
    (loop
      (let [c (r-peek r)]
        (if (or (primitive/icmp-eq c -1) (primitive/icmp-eq c 10)) (break) (r-adv r))))
    (trim-trailing (subslice (primitive/load (primitive/field r src)) start (primitive/load (primitive/field r pos))))))

; a "..."/c"..." string literal, verbatim INCLUDING the quotes (and any leading c).
(defn read-string [(r (ptr Rdr)) (start i64)] (-> (slice u8))
  (r-adv r)  ; consume opening quote
  (loop
    (let [c (r-peek r)]
      (if (primitive/icmp-eq c -1) (break)
        (do (r-adv r)
            (if (primitive/icmp-eq c 92)                       ; backslash: skip escaped char
                (when (primitive/icmp-ne (r-peek r) -1) (r-adv r))
              (when (primitive/icmp-eq c 34) (break)))))))       ; closing quote
  (subslice (primitive/load (primitive/field r src)) start (primitive/load (primitive/field r pos))))

; a run of non-delimiter bytes; folds the c"..." case (a lone `c` before a quote).
(defn read-atom [(r (ptr Rdr))] (-> (slice u8))
  (let [start (primitive/load (primitive/field r pos))]
    (loop (if (is-atom-delim (r-peek r)) (break) (r-adv r)))
    (let [end (primitive/load (primitive/field r pos))]
      (if (and (primitive/icmp-eq (primitive/isub end start) 1)
               (and (primitive/icmp-eq (primitive/cast i64 (slice-get (primitive/load (primitive/field r src)) start)) 99)
                    (primitive/icmp-eq (r-peek r) 34)))
          (read-string r start)                        ; c"..." — extend over the string
          (subslice (primitive/load (primitive/field r src)) start end)))))

; a `\c` / `\)` / `\newline` character literal, captured VERBATIM: a backslash,
; then one char; if that char is a letter it's a name run (\newline, \space, …).
(defn cl-alpha [(c i64)] (-> bool)
  (or (and (primitive/icmp-ge c 97) (primitive/icmp-le c 122)) (and (primitive/icmp-ge c 65) (primitive/icmp-le c 90))))
(defn cl-alnum [(c i64)] (-> bool)
  (or (cl-alpha c) (and (primitive/icmp-ge c 48) (primitive/icmp-le c 57))))
(defn read-char-lit [(r (ptr Rdr))] (-> (slice u8))
  (let [start (primitive/load (primitive/field r pos))]
    (r-adv r)                                     ; consume backslash
    (when (primitive/icmp-ne (r-peek r) -1)
          (let [first (r-peek r)]
            (r-adv r)                               ; consume the char after backslash
            (when (cl-alpha first) (loop (if (cl-alnum (r-peek r)) (r-adv r) (break))) 0)))
    (subslice (primitive/load (primitive/field r src)) start (primitive/load (primitive/field r pos)))))

; ---- node reader -----------------------------------------------------------
; Read one node. Returns a null (ptr Node) at EOF or when the next byte is a close
; delimiter (the caller consumes the close). nl-before is stamped from the run of
; whitespace skipped just before the node.
(defn read-node [(r (ptr Rdr))] (-> (ptr Node))
  (let [nl (skip-ws r) c (r-peek r) a (primitive/load (primitive/field r a))]
    (cond (primitive/icmp-eq c -1) (primitive/cast (ptr Node) 0)
          (or (primitive/icmp-eq c 41) (primitive/icmp-eq c 93)) (primitive/cast (ptr Node) 0)
          ; close delim
          (primitive/icmp-eq c 59) (box-node a (NComment (read-comment r)) nl)
          (or (primitive/icmp-eq c 40) (primitive/icmp-eq c 91)) (box-node a (read-list r c) nl)
          (or (primitive/icmp-eq c 39) (or (primitive/icmp-eq c 96) (primitive/icmp-eq c 126))) (box-node a (read-prefix r c) nl)
          (primitive/icmp-eq c 34) (box-node a (NAtom (read-string r (primitive/load (primitive/field r pos)))) nl)
          (primitive/icmp-eq c 92) (box-node a (NAtom (read-char-lit r)) nl)
          :else (box-node a (NAtom (read-atom r)) nl))))

(defn read-prefix [(r (ptr Rdr)) (c i64)] (-> NodeKind)
  (let [a (primitive/load (primitive/field r a))]
    (r-adv r)
    (let [op (cond (primitive/icmp-eq c 39) "'"
                   (primitive/icmp-eq c 96) "`"
                   (and (primitive/icmp-eq c 126) (primitive/icmp-eq (r-peek r) 64)) (do (r-adv r) "~@")
                   :else "~")
          inner (read-node r)]
      (NPrefix op (if (primitive/icmp-eq (primitive/cast i64 inner) 0)
                      (box-node a (NAtom "") 0)   ; dangling prefix (best-effort)
                      inner)))))

(defn read-list [(r (ptr Rdr)) (open i64)] (-> NodeKind)
  (let [a (primitive/load (primitive/field r a)) close (if (primitive/icmp-eq open 40) 41 93)
        (mut items) (al-new [(ptr Node)] a)]
    (r-adv r)  ; consume open
    (loop
      (let [child (read-node r)]
        (if (primitive/icmp-ne (primitive/cast i64 child) 0)
            (al-push! (mut items) child)
          (let [c (r-peek r)]
            (if (primitive/icmp-eq c close) (do (r-adv r) (break))
              (if (primitive/icmp-eq c -1) (break)            ; unterminated — tolerate
                (do (r-adv r) (break))))))))          ; mismatched — tolerate
    (NList open (let [p (unwrap-ptr [(ArrayList (ptr Node))]
                                    (create [(ArrayList (ptr Node))] a))]
                  (primitive/store! p (primitive/load items)) p))))

; ---- entry point -----------------------------------------------------------
; Parse the whole source into a top-level list of nodes (forms + comments), in
; order, each carrying nl-before.
(defn read-doc [(a (ptr Allocator)) (src (slice u8))] (-> (ptr (ArrayList (ptr Node))))
  (let [r (alloc/stack Rdr) (mut forms) (al-new [(ptr Node)] a)]
    (primitive/store! (primitive/field r src) src) (primitive/store! (primitive/field r pos) 0) (primitive/store! (primitive/field r a) a)
    (loop
      (let [f (read-node r)]
        (if (primitive/icmp-ne (primitive/cast i64 f) 0) (al-push! (mut forms) f)
          (if (primitive/icmp-eq (r-peek r) -1) (break)
            (r-adv r)))))                             ; skip stray close delim
    (let [p (unwrap-ptr [(ArrayList (ptr Node))] (create [(ArrayList (ptr Node))] a))]
      (primitive/store! p (primitive/load forms)) p)))

; ---- accessors -------------------------------------------------------------
(defn node-kind [(n (ptr Node))] (-> NodeKind) (primitive/load (primitive/field n kind)))
(defn node-nl [(n (ptr Node))] (-> i64) (primitive/load (primitive/field n nl-before)))

(defn node-atom? [(n (ptr Node))] (-> bool)
  (match (node-kind n) (NAtom [_] true) (NList [_ _] false) (NComment [_] false) (NPrefix [_ _] false)))
(defn node-list? [(n (ptr Node))] (-> bool)
  (match (node-kind n) (NList [_ _] true) (NAtom [_] false) (NComment [_] false) (NPrefix [_ _] false)))
(defn node-comment? [(n (ptr Node))] (-> bool)
  (match (node-kind n) (NComment [_] true) (NAtom [_] false) (NList [_ _] false) (NPrefix [_ _] false)))

(defn node-raw [(n (ptr Node))] (-> (slice u8))
  (match (node-kind n) (NAtom [s] s) (NComment [s] s) (NList [_ _] "") (NPrefix [_ _] "")))
(defn node-items [(n (ptr Node))] (-> (ptr (ArrayList (ptr Node))))
  (match (node-kind n) (NList [_ items] items)
    (NAtom [_] (primitive/cast (ptr (ArrayList (ptr Node))) 0))
    (NComment [_] (primitive/cast (ptr (ArrayList (ptr Node))) 0))
    (NPrefix [_ _] (primitive/cast (ptr (ArrayList (ptr Node))) 0))))
(defn node-open [(n (ptr Node))] (-> i64)
  (match (node-kind n) (NList [o _] o) (NAtom [_] 40) (NComment [_] 40) (NPrefix [_ _] 40)))
(defn node-count [(n (ptr Node))] (-> i64)
  (when (node-list? n) (al-len [(ptr Node)] (primitive/load (node-items n)))))
(defn node-nth [(n (ptr Node)) (i i64)] (-> (ptr Node))
  (al-get [(ptr Node)] (primitive/load (node-items n)) i))

; head symbol of a list: raw text of item 0 if it is an atom, else "".
(defn head-sym [(n (ptr Node))] (-> (slice u8))
  (if (primitive/icmp-le (node-count n) 0) ""
    (let [h (node-nth n 0)] (if (node-atom? h) (node-raw h) ""))))
