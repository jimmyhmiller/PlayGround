; src/compiler/formatter/rules.coil — lower a CST into a Doc, applying Clojure-style layout.
;
; The one distinction that drives Lisp layout (per the Clojure style guide):
;   * function calls    → arguments align under the FIRST argument
;                           (some-fn arg1
;                                    arg2)
;   * macros / bodies   → a fixed 2-space body indent
;                           (when test
;                             body)
; Both are the same shape: keep K leading elements on the head line, then put the
; rest one-per-line at some indentation. K and the indentation are all that differ,
; so one `layout` handles lists, vectors, calls, blocks, and defn.
(module rules)
(import "../../stdlib/primitive.coil" :as primitive)
(import "../../stdlib/alloc.coil" :as alloc     :use *)
(import "slice.coil"     :use *)
(import "str.coil"       :use *)
(import "arraylist.coil" :use *)
(import "cst.coil"   :use *)
(import "doc.coil"   :use *)

; ---- rule table ------------------------------------------------------------
; style: 0 = CALL (align under first arg), 1 = BLOCK n, 2 = DEFN
(defstruct Rule [(style i64) (n i64)])
(defn mk-rule [(style i64) (n i64)] (-> Rule)
  (let [p (alloc/stack Rule)] (primitive/store! (primitive/field p style) style) (primitive/store! (primitive/field p n) n) (primitive/load p)))

(defn is [(h (slice u8)) (lit (slice u8))] (-> bool) (str-eq h lit))

; The def* family: name stays on the head line, body indents +2 (Clojure's
; :inner-0 shape). When a parameter vector is present it (and an optional (-> …)
; return) join the head line too — see the DEFN branch of list->doc.
(defn is-def-family [(h (slice u8))] (-> bool)
  (or (is h "defn") (or (is h "defn-") (or (is h "defmacro") (or (is h "defmethod")
      (or (is h "def") (or (is h "defonce") (is h "defmulti"))))))))

; Look up the layout rule for a list whose head symbol is `h`.
(defn list-rule [(h (slice u8))] (-> Rule)
  (cond (is-def-family h) (mk-rule 2 0)
        (is h "do") (mk-rule 1 0)
        (or (is h "let") (or (is h "loop") (or (is h "binding") (is h "let*")))) (mk-rule 1 1)
        (or (is h "when") (or (is h "when-not") (or (is h "unless") (or (is h "while") (is h "when-let")))))
          (mk-rule 1 1)
        (is h "if") (mk-rule 0 0)
        ; align then/else under the condition
        (is h "fn") (mk-rule 1 1)
        (or (is h "cond") (or (is h "case") (is h "condp"))) (mk-rule 3 0)
        (is h "match") (mk-rule 1 1)
        :else (mk-rule 0 0)))   ; default: function call
; (defstruct/defsum/deftrait/defenum/impl are dispatched ahead of this table, in
;  list->doc — their head line depends on the shape of the form, not just the head
;  symbol, so a fixed Rule cannot express them. Each admits an optional leading
;  [type-params] vector, which shifts every later element by one.)

; ---- predicates over a node ------------------------------------------------
(defn any-child-multiline [(n (ptr Node))] (-> bool)
  (let [c (node-count n) (mut i) 1 (mut f) false]   ; child 0 (head) nl is about the list itself
    (loop (if (primitive/icmp-ge (primitive/load i) c) (break)
      (do (when (primitive/icmp-gt (node-nl (node-nth n (primitive/load i))) 0) (primitive/store! f true) 0)
          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load f)))
(defn any-child-comment [(n (ptr Node))] (-> bool)
  (let [c (node-count n) (mut i) 0 (mut f) false]
    (loop (if (primitive/icmp-ge (primitive/load i) c) (break)
      (do (when (node-comment? (node-nth n (primitive/load i))) (primitive/store! f true) 0)
          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load f)))

; ---- separators ------------------------------------------------------------
; The doc placed BEFORE a body child, honoring blank lines and trailing comments.
(defn body-sep [(a (ptr Allocator)) (child (ptr Node))] (-> (ptr Doc))
  (if (and (node-comment? child) (primitive/icmp-eq (node-nl child) 0))
      (d-text a "  ")                              ; trailing comment: keep on the line
    (if (primitive/icmp-ge (node-nl child) 2)
        (let [dl (dl-new a)]                       ; preserve one blank line
          (dl-push! dl (d-hardline a)) (dl-push! dl (d-line a)) (dl-done a dl))
        (d-line a))))

; ---- core layout -----------------------------------------------------------
; wrap an assembled child-doc list as a delimited, self-anchoring group.
(defn seal [(a (ptr Allocator)) (dl (ptr (ArrayList (ptr Doc)))) (forced bool)] (-> (ptr Doc))
  (let [inner (d-align a 0 (dl-done a dl))]
    (if forced (d-group-forced a inner) (d-group a inner))))

; push elements [lo, hi) onto dl, each preceded by a single space (stay inline).
(defn inline-into [(a (ptr Allocator)) (dl (ptr (ArrayList (ptr Doc)))) (n (ptr Node)) (lo i64) (hi i64)] (-> i64)
  (let [(mut i) lo]
    (loop (if (primitive/icmp-ge (primitive/load i) hi) (break)
      (do (dl-push! dl (d-text a " "))
          (dl-push! dl (node->doc a (node-nth n (primitive/load i))))
          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))) 0)

; the nested body doc for elements [start, cnt): each on its own line when broken.
(defn body-doc [(a (ptr Allocator)) (n (ptr Node)) (start i64) (nest-amt i64)] (-> (ptr Doc))
  (let [cnt (node-count n)]
    (if (primitive/icmp-ge start cnt) (d-nil a)
      (let [body (dl-new a) (mut j) start]
        (loop (if (primitive/icmp-ge (primitive/load j) cnt) (break)
          (do (dl-push! body (body-sep a (node-nth n (primitive/load j))))
              (dl-push! body (node->doc a (node-nth n (primitive/load j))))
              (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
        (d-nest a nest-amt (dl-done a body))))))

; The first index in [lo, hi) that is a comment, else hi. Keeps a comment (and
; everything after it) out of a space-joined inline run, where it would swallow
; the following code onto its line.
(defn clamp-before-comment [(n (ptr Node)) (lo i64) (hi i64)] (-> i64)
  (let [(mut i) lo (mut r) hi]
    (loop (if (primitive/icmp-ge (primitive/load i) hi) (break)
      (if (node-comment? (node-nth n (primitive/load i)))
          (do (primitive/store! r (primitive/load i)) (break))
          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

; open/close: delimiter bytes. inline-n: how many elements after the head stay on
; the head line. nest-amt: body indentation past the open delimiter. Element 0 is
; the "head" (a list's operator, or a vector's first element).
(defn layout [(a (ptr Allocator)) (n (ptr Node)) (open i64) (close i64)
              (inline-n i64) (nest-amt i64) (force bool)] (-> (ptr Doc))
  (let [cnt (node-count n)]
    (if (primitive/icmp-le cnt 0)
        (d-text a (if (primitive/icmp-eq open 40) "()" "[]"))
      (let [dl (dl-new a)
            forced (or force (or (any-child-multiline n) (any-child-comment n)))
            inline-hi (clamp-before-comment n 1 (let [h (primitive/iadd 1 inline-n)] (if (primitive/icmp-gt h cnt) cnt h)))]
        (dl-push! dl (d-text a (if (primitive/icmp-eq open 40) "(" "[")))
        (dl-push! dl (node->doc a (node-nth n 0)))                ; head
        (inline-into a dl n 1 inline-hi)
        (dl-push! dl (body-doc a n inline-hi nest-amt))
        (dl-push! dl (d-text a (if (primitive/icmp-eq open 40) ")" "]")))
        (seal a dl forced)))))

; ---- binding-vector layout (let/loop/for/...): elements laid out in PAIRS -----
; [k1 v1 k2 v2] breaks to
;   [k1 v1
;    k2 v2]
; Comments become their own row; a same-line (trailing) comment sticks to its row.
(defn layout-binding-vec [(a (ptr Allocator)) (n (ptr Node))] (-> (ptr Doc))
  (let [cnt (node-count n)]
    (if (primitive/icmp-le cnt 0) (d-text a "[]")
      (let [rows (build-pair-rows a n 0)
            ; a binding vector with 2+ rows (pairs) ALWAYS breaks one-per-line — even
            ; if it would fit flat — so `let`/`loop` bindings line up in a column.
            forced (or (primitive/icmp-gt (al-len [(ptr Doc)] (primitive/load rows)) 1)
                       (or (any-child-multiline n) (any-child-comment n)))
            dl (dl-new a) rn (al-len [(ptr Doc)] (primitive/load rows))]
        ; row 0 on the "[" line, the rest each on their own line at +1
        (dl-push! dl (d-text a "["))
        (when (primitive/icmp-gt rn 0) (dl-push! dl (al-get [(ptr Doc)] (primitive/load rows) 0)))
        (dl-push! dl (d-nest a 1 (rows-lines a rows 1)))
        (dl-push! dl (d-text a "]"))
        (seal a dl forced)))))

; concat of (line row) for rows [start, end) — the "one per line when broken" tail.
(defn rows-lines [(a (ptr Allocator)) (rows (ptr (ArrayList (ptr Doc)))) (start i64)] (-> (ptr Doc))
  (let [rn (al-len [(ptr Doc)] (primitive/load rows)) rest (dl-new a) (mut k) start]
    (loop (if (primitive/icmp-ge (primitive/load k) rn) (break)
      (do (dl-push! rest (d-line a))
          (dl-push! rest (al-get [(ptr Doc)] (primitive/load rows) (primitive/load k)))
          (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    (dl-done a rest)))

(defn trailing-comment? [(ch (ptr Node))] (-> bool)
  (and (node-comment? ch) (primitive/icmp-eq (node-nl ch) 0)))

; One key/value clause as a single row-doc. The value hangs +2 under the key when
; the clause has a comment between key and value, or when it doesn't fit:
;   key  ; comment          key value          key
;     value                                       value   (too long)
; A comment between key and value forces the hang (nothing may share its line); a
; comment trailing the value just rides at the end of the line.
(defn make-pair [(a (ptr Allocator)) (key (ptr Doc)) (keycom (ptr Doc))
                 (hasval bool) (val (ptr Doc)) (valcom (ptr Doc))] (-> (ptr Doc))
  (let [dl (dl-new a) (mut forced) false]
    (dl-push! dl key)
    (when (primitive/icmp-ne (primitive/cast i64 keycom) 0) (dl-push! dl (d-text a "  ")) (dl-push! dl keycom) (primitive/store! forced true) 0)
    (when hasval
          (let [inner (dl-new a)]
            (dl-push! inner (d-line a)) (dl-push! inner val)
            (dl-push! dl (d-nest a 2 (dl-done a inner))))
          (when (primitive/icmp-ne (primitive/cast i64 valcom) 0) (dl-push! dl (d-text a "  ")) (dl-push! dl valcom) 0))
    (let [body (d-align a 0 (dl-done a dl))]   ; anchor the +2 hang to the key column
      (if (primitive/load forced) (d-group-forced a body) (d-group a body)))))

; Walk elements [start, cnt) into clause rows. Each clause is key + optional
; same-line comment + value (+ optional same-line comment); a standalone comment
; is its own row. Comments never shift the key/value cadence.
(defn build-pair-rows [(a (ptr Allocator)) (n (ptr Node)) (start i64)] (-> (ptr (ArrayList (ptr Doc))))
  (let [cnt (node-count n) rows (dl-new a) (mut i) start]
    (loop (if (primitive/icmp-ge (primitive/load i) cnt) (break)
      (let [ch (node-nth n (primitive/load i))]
        (if (node-comment? ch)
            (do (dl-push! rows (node->doc a ch)) (primitive/store! i (primitive/iadd (primitive/load i) 1)))   ; standalone comment row
          (let [key (node->doc a ch) (mut keycom) (primitive/cast (ptr Doc) 0)
                (mut val) (primitive/cast (ptr Doc) 0) (mut hasval) false (mut valcom) (primitive/cast (ptr Doc) 0)]
            (primitive/store! i (primitive/iadd (primitive/load i) 1))
            (when (and (primitive/icmp-lt (primitive/load i) cnt) (trailing-comment? (node-nth n (primitive/load i))))
                  (primitive/store! keycom (node->doc a (node-nth n (primitive/load i))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))
                  0)
            (when (and (primitive/icmp-lt (primitive/load i) cnt) (not (node-comment? (node-nth n (primitive/load i)))))
                  (primitive/store! val (node->doc a (node-nth n (primitive/load i))))
                  (primitive/store! hasval true)
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))
                  (when (and (primitive/icmp-lt (primitive/load i) cnt) (trailing-comment? (node-nth n (primitive/load i))))
                        (primitive/store! valcom (node->doc a (node-nth n (primitive/load i))))
                        (primitive/store! i (primitive/iadd (primitive/load i) 1))
                        0))
            (dl-push! rows (make-pair a key (primitive/load keycom) (primitive/load hasval) (primitive/load val) (primitive/load valcom))))))))
    rows))

; cond / case: clauses laid out in PAIRS, aligned under the first clause.
;   (cond test1 res1
;         test2 res2
;         else)
(defn layout-clauses [(a (ptr Allocator)) (n (ptr Node))] (-> (ptr Doc))
  (let [cnt (node-count n)]
    (if (primitive/icmp-le cnt 1) (layout a n 40 41 0 2 false)
      (let [rows (build-pair-rows a n 1)
            forced (or (any-child-multiline n) (any-child-comment n))
            headlen (slice-len (node-raw-flat a (node-nth n 0)))
            dl (dl-new a) rn (al-len [(ptr Doc)] (primitive/load rows))]
        (dl-push! dl (d-text a "("))
        (dl-push! dl (node->doc a (node-nth n 0)))               ; head
        (when (primitive/icmp-gt rn 0)
              (dl-push! dl (d-text a " "))
              ; first clause on head line
              (dl-push! dl (al-get [(ptr Doc)] (primitive/load rows) 0)))
        (dl-push! dl (d-nest a (primitive/iadd headlen 2) (rows-lines a rows 1)))
        (dl-push! dl (d-text a ")"))
        (seal a dl forced)))))


; binding forms: head, a binding vector, then a body indented +2.
(defn is-binding-form [(h (slice u8))] (-> bool)
  (or (is h "let") (or (is h "loop") (or (is h "binding") (or (is h "let*")
      (or (is h "when-let") (or (is h "if-let") (or (is h "for") (is h "doseq")))))))))

(defn layout-binding-form [(a (ptr Allocator)) (n (ptr Node))] (-> (ptr Doc))
  (let [cnt (node-count n) bv (node-nth n 1)]
    (if (or (primitive/icmp-lt cnt 2) (not (and (node-list? bv) (primitive/icmp-eq (node-open bv) 91))))
        (layout a n 40 41 1 2 false)                    ; no binding vector: fall back
      (let [dl (dl-new a)
            forced (or (any-child-multiline n) (any-child-comment n))]
        (dl-push! dl (d-text a "("))
        (dl-push! dl (node->doc a (node-nth n 0)))       ; head (let/loop/…)
        (dl-push! dl (d-text a " "))
        ; `for` binds a numeric range [var lo hi] — NOT key/value pairs — so lay it
        ; out as a plain vector; every other binding form (let/loop/doseq/…) pairs.
        (dl-push! dl (if (is (head-sym n) "for")
                         (node->doc a bv)
                         (layout-binding-vec a bv)))
        (dl-push! dl (body-doc a n 2 2))                 ; body +2
        (dl-push! dl (d-text a ")"))
        (seal a dl forced)))))

; A keyword atom: an NAtom whose text begins with ':' (58). defn signature options
; like `:cc c` are written as such a keyword followed by its value.
(defn kw-atom? [(n (ptr Node))] (-> bool)
  (and (node-atom? n)
       (let [s (node-raw n)]
         (and (primitive/icmp-gt (slice-len s) 0) (primitive/icmp-eq (primitive/cast i64 (slice-get s 0)) 58)))))

; The inline element count for a defn signature: how many children after the
; head (the name) stay on the head line. A defn signature is the name, any leading
; keyword-option pairs (e.g. `:cc c`), the parameter vector(s) — a *generic* defn
; writes a [type-params] vector before the [params] vector — plus an optional
; (-> ret). The body starts after that.
; Returns 0 when there is no leading vector at all (def / defmulti / multi-arity
; defn), which the caller treats as "name inline, don't force the body".
(defn defn-sig-end [(n (ptr Node))] (-> i64)
  ; index 0 is the head (defn), index 1 is the name; signature options and the
  ; parameter vector(s) start at index 2. First skip leading `:kw value` option
  ; pairs (like `:cc c`), then consume the contiguous leading [...] vectors.
  (let [cnt (node-count n) (mut base) 2]
    (loop (if (and (primitive/icmp-lt (primitive/iadd (primitive/load base) 1) cnt) (kw-atom? (node-nth n (primitive/load base))))
              (primitive/store! base (primitive/iadd (primitive/load base) 2))
              (break)))
    (let [(mut i) (primitive/load base)]
      (loop (if (primitive/icmp-ge (primitive/load i) cnt) (break)
        (let [ch (node-nth n (primitive/load i))]
          (if (and (node-list? ch) (primitive/icmp-eq (node-open ch) 91))
              (primitive/store! i (primitive/iadd (primitive/load i) 1))
              (break)))))
      (unless (primitive/icmp-le (primitive/load i) (primitive/load base))
              ; no param vector
              ; include a trailing (-> ret); else stop at the last vector
              (if (and (primitive/icmp-lt (primitive/load i) cnt) (list-head-is n (primitive/load i) "->"))
                  (primitive/load i)
                  (primitive/isub (primitive/load i) 1))))))

; A defstruct's signature — name, optional [type-params], and any :layout/:size/…
; keyword options — all stay on the head line; only the final field vector is the
; (breakable) body. So keep every child inline except the last one. Returns the
; inline count (elements after the head), never below 1.
(defn defstruct-inline-n [(n (ptr Node))] (-> i64)
  (let [cnt (node-count n)]
    (if (primitive/icmp-lt (primitive/isub cnt 2) 1) 1 (primitive/isub cnt 2))))

; A defsum/deftrait/defenum signature — the name plus an optional [type-params]
; vector — stays on the head line; the variants (or trait methods) after it are the
; body, one per line. Unlike defstruct there may be many body elements, so the
; count is not "all but the last": it is 2 when child 2 is a [...] vector
;   (defsum Option [T]        (deftrait Eq [Self]
;     (None) …)                 (= [(a Self) (b Self)] (-> bool)))
; and 1 when there are no type params and child 2 is already a variant
;   (defsum CtVal
;     (CInt [(v i64)]) …)
(defn defsum-inline-n [(n (ptr Node))] (-> i64)
  (if (primitive/icmp-le (node-count n) 2) 1
    (let [ch (node-nth n 2)]
      (if (and (node-list? ch) (primitive/icmp-eq (node-open ch) 91)) 2 1))))

; An impl header — `(impl [type-params]? Trait Type …)` — stays on the head line;
; the method definitions are the body. Same optional-[type-params] shift as above,
; one position earlier because impl has no name:
;   (impl BitOr i64 …)        -> 2   (Trait, Type)
;   (impl [T] Eq (ptr T) …)   -> 3   ([T], Trait, Type)
(defn impl-inline-n [(n (ptr Node))] (-> i64)
  (if (primitive/icmp-le (node-count n) 1) 1
    (let [ch (node-nth n 1)]
      (if (and (node-list? ch) (primitive/icmp-eq (node-open ch) 91)) 3 2))))

; ---- list dispatch ---------------------------------------------------------
(defn list->doc [(a (ptr Allocator)) (n (ptr Node))] (-> (ptr Doc))
  (if (primitive/icmp-eq (node-open n) 91)
      (layout a n 91 93 0 1 false)                              ; vector: align under first elem
    (let [cnt (node-count n)]
      (if (primitive/icmp-le cnt 0) (d-text a "()")
        (let [h (head-sym n) rp (alloc/stack Rule)]
          (primitive/store! rp (list-rule h))
          (let [style (primitive/load (primitive/field rp style)) rn (primitive/load (primitive/field rp n))]
          (cond (is-binding-form h) (layout-binding-form a n)
                (is h "defstruct")  ; name + [type-params] + :layout/:size/… options inline; field vector body.
                  (layout a n 40 41 (defstruct-inline-n n) 2 false)
                (or (is h "defsum") (or (is h "deftrait") (is h "defenum")))  ; name + optional [type-params] inline; variants/methods are the body.
                  (layout a n 40 41 (defsum-inline-n n) 2 false)
                (is h "impl")  ; optional [type-params] + Trait + Type inline; methods are the body.
                  (layout a n 40 41 (impl-inline-n n) 2 false)
                (primitive/icmp-eq style 3) (layout-clauses a n)
                (primitive/icmp-eq style 0)  ; CALL: arg1 inline, rest align under it (nest = headlen + 2)
                  (let [headlen (slice-len (node-raw-flat a (node-nth n 0)))]
                    (layout a n 40 41 1 (primitive/iadd headlen 2) false))
                (primitive/icmp-eq style 2)  ; DEFN: signature = up to the param vector (+ optional (-> ...)), body +2.
                  ; With no param vector (def, defmulti, multi-arity defn): just the
                  ; name on the head line, body +2 — never function-call alignment.
                  (let [sig-end (defn-sig-end n)]
                    (if (primitive/icmp-eq sig-end 0)
                        (layout a n 40 41 1 2 false)
                      ; force the body onto its own line(s): a defn signature is
                      ; never joined with its body, even when it would fit flat.
                      (layout a n 40 41 sig-end 2 true)))
                :else  ; BLOCK n
                  (layout a n 40 41 rn 2 false))))))))

; true if child `i` is a list whose head symbol equals `lit`.
(defn list-head-is [(n (ptr Node)) (i i64) (lit (slice u8))] (-> bool)
  (let [ch (node-nth n i)]
    (if (node-list? ch) (str-eq (head-sym ch) lit) false)))

; A flat-text approximation of a node's head, for computing alignment width.
(defn node-raw-flat [(a (ptr Allocator)) (n (ptr Node))] (-> (slice u8))
  (if (node-atom? n) (node-raw n) "x"))   ; non-atom head: nominal width 1

; ---- node dispatch ---------------------------------------------------------
(defn node->doc [(a (ptr Allocator)) (n (ptr Node))] (-> (ptr Doc))
  (cond (node-atom? n) (d-text a (node-raw n))
        (node-comment? n) (d-text a (node-raw n))
        (node-list? n) (list->doc a n)
        :else  ; prefix: op glued to inner
          (match (node-kind n)
            (NPrefix [op inner]
              (let [dl (dl-new a)]
                (dl-push! dl (d-text a op)) (dl-push! dl (node->doc a inner)) (dl-done a dl)))
            (NAtom [_] (d-text a ""))
            (NList [_ _] (d-text a ""))
            (NComment [_] (d-text a "")))))

; ---- document (top level) --------------------------------------------------
; The whole file: each top-level node on its own line(s), blank lines preserved.
(defn doc->doc [(a (ptr Allocator)) (nodes (ptr (ArrayList (ptr Node))))] (-> (ptr Doc))
  (let [cnt (al-len [(ptr Node)] (primitive/load nodes)) dl (dl-new a) (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) cnt) (break)
      (do (let [nd (al-get [(ptr Node)] (primitive/load nodes) (primitive/load i))]
            (when (primitive/icmp-gt (primitive/load i) 0)
                  (if (and (node-comment? nd) (primitive/icmp-eq (node-nl nd) 0))
                      (dl-push! dl (d-text a "  "))            ; trailing comment: same line
                    (do (dl-push! dl (d-hardline a))
                        (when (primitive/icmp-ge (node-nl nd) 2) (dl-push! dl (d-hardline a))))))
            (dl-push! dl (node->doc a nd)))
          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (dl-push! dl (d-hardline a))       ; trailing newline
    (d-group-forced a (dl-done a dl))))

; one-call entry: source text -> formatted source text (width cols).
(defn format-src [(a (ptr Allocator)) (src (slice u8)) (width i64)] (-> (slice u8))
  (render-doc a (doc->doc a (read-doc a src)) width))
