; src/compiler/codegen_x64.coil — the native x86-64 backend (zero LLVM).
; Consumes the SAME monomorphized Program as codegen.coil and lowers it
; directly to machine code in an ELF object. codegen.coil (the LLVM backend)
; is the behavioral spec: every lowering decision here mirrors its semantics —
; sum layout {i32 tag, [words x i64] payload}, slice fat pointers {ptr,i64},
; divergence discipline, C ABI (SysV AMD64) at every call.
;
; This is the x86-64 sibling of codegen_a64.coil and deliberately keeps the
; same structure, function names and lowering decisions, so the two can be
; diffed against each other. What genuinely differs:
;   - registers: rbx = slot base (callee-saved, like x28 on arm64); rax/rcx/rdx/
;     rsi/rdi/r8-r11 are caller-saved scratch; xmm0-15 for floats.
;   - the ABI is SysV AMD64, not AAPCS64: eightbyte classification with an
;     INTEGER/SSE merge rule rather than HFA; >16-byte aggregates go in memory;
;     variadic calls must set al = the number of SSE registers used.
;   - x86 is two-address and memory-capable, so many arm64 load/op/store trios
;     collapse into one instruction — but this stays a naive slot machine for
;     the same reason arm64 does: precise DWARF and fast compiles.
;
; Code generation model (debug backend — compile speed over code quality):
;  - every value lives by-value in an rbp-anchored stack slot; rbx = slot base
;  - scratch registers are only live within one expression
;  - one calling convention everywhere: SysV AMD64, incl. the variadic al rule
;
; Frame layout (grows down):     [caller frame | incoming stack args]
;   rbp -> saved rbp                          <- push rbp; mov rsp,rbp
;          saved rbx                          <- push rbx
;          slots (rbx = base, off 0..slotbytes)
;   rsp -> outgoing stack args (outbytes)
; the prologue `sub rsp` and `lea rbx,[rsp+outbytes]` are back-patched once the
; body is emitted and slotbytes/outbytes are known.
(module cgx64)

(import "alloc.coil" :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "match.coil" :use *)
(import "ast.coil" :use *)
(import "parser.coil" :use *)
(import "layoutdb.coil" :use *)
(import "x64.coil" :use *)
(import "elf.coil" :use *)
(import "dwarf.coil" :use *)

; file-writing externs (creat is NOT variadic, unlike open-with-O_CREAT)
(extern cgx64.creat [(ptr i8) i64] (-> i64))
(extern cgx64.write [i32 (ptr i8) isize] (-> isize))  ; C write's fd is int (i32); matches io/cimport write (isize=i64 native, i32 wasm)
(extern cgx64.close [i32] (-> i32))  ; C `close(int)` returns int, not long — matches ffi.close/cimport.close (return is discarded)
(extern cgx64.exit [i32] (-> i64))

; ============================ state ==========================================
(defstruct GSig  ; one callable (function or extern)
  [(name (slice u8))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (variadic bool)
   (symidx i64)
   (shim bool)
   (implsym i64)  ; :shim conventions (trampoline realization)
   (shimregs (ptr (ArrayList i64)))
   (shimret i64)
   ; true for an (extern … :cc c …): calls to it cross the C boundary and so
   ; follow the SysV by-value aggregate rules. Coil-to-Coil calls do not — this
   ; backend passes aggregates by pointer internally, same as arm64.
   (isc bool)])
(defstruct GLoop
  [(label (Option (slice u8)))
   (contlabel i64)
   (breaklabel i64)
   (resslot i64)
   (resty Type)
   (has_res bool)])
(defstruct GStr [(s (slice u8)) (symidx i64)])  ; interned string literal

; a lowered value: kind 0 = int/ptr immediate, 1 = slot (by-value), 2 = f64 imm bits
(defstruct AVal [(kind i64) (v i64) (ty Type)])

(defsum GScope
  (GNil [])
  (GBind [(name (slice u8)) (av AVal) (rest (ptr GScope))]))

(defstruct Cga
  [(a (ptr Allocator))
   (layouts LayoutDb)
   (sigs (ArrayList GSig))  ; funcs + externs, keyed by name
   (obj EObj)
   (text i64)
   (constsec i64)
   (datasec i64)  ; section ordinals
   (asm XAsm)
   (strs (ArrayList GStr))  ; interned EStr/ECStr globals
   (nglob i64)  ; g.N counter
   ; ---- per-function state ----
   (frame i64)  ; next free slot offset
   (env (ptr GScope))
   (loops (ArrayList GLoop))
   (terminated bool)
   (retty Type)
   (sretslot i64)  ; slot holding incoming x8, -1 = none
   (epilabel i64)
   (outbytes i64)  ; max outgoing stack-arg bytes of any call
   (fnstart i64)  ; text offset of current function start
   ; ---- DWARF collection ----
   (dwtys (ArrayList DwTy))
   (dwfns (ArrayList DwFn))
   (dwvars (ArrayList DwVar))
   (dwevs (ArrayList DwLineEv))
   (dwcursrc i64)
   (dwcurlo i64)
   (convs (ptr (ArrayList Convention)))])

; hard error helper — no silent fallbacks anywhere in this backend.
(defn cgx-fail [(msg (slice u8))] (-> i64)
  (print-str (stderr) "cgx64: ")
  (print-str (stderr) msg)
  (write-byte (stderr) (cast u8 10))
  (abort)
  0)
(defn cgx-fail2 [(msg (slice u8)) (what (slice u8))] (-> i64)
  (print-str (stderr) "cgx64: ")
  (print-str (stderr) msg)
  (print-str (stderr) what)
  (write-byte (stderr) (cast u8 10))
  (abort)
  0)

(defn mk-aval [(kind i64) (v i64) (ty Type)] (-> AVal)
  (let [p (alloc-stack AVal)]
    (store! (field p kind) kind)
    (store! (field p v) v)
    (store! (field p ty) ty)
    (load p)))
(defn av-kind [(x AVal)] (-> i64)
  (let [p (alloc-stack AVal)] (store! p x) (load (field p kind))))
(defn av-v [(x AVal)] (-> i64)
  (let [p (alloc-stack AVal)] (store! p x) (load (field p v))))
(defn av-ty [(x AVal)] (-> Type)
  (let [p (alloc-stack AVal)] (store! p x) (load (field p ty))))

(defn gscope-nil [(a (ptr Allocator))] (-> (ptr GScope))
  (let [p (unwrap-ptr [GScope] (create [GScope] a))] (store! p (GNil)) p))
(defn gscope-put [(a (ptr Allocator)) (s (ptr GScope)) (name (slice u8)) (av AVal)] (-> (ptr GScope))
  (let [p (unwrap-ptr [GScope] (create [GScope] a))] (store! p (GBind name av s)) p))
(defn gscope-get [(s (ptr GScope)) (name (slice u8))] (-> (Option AVal))
  (match (load s)
    (GNil [] (None [AVal]))
    (GBind [n av rest] (if (str-eq n name) (Some [AVal] av) (gscope-get rest name)))))

; ---- shared type layout ----------------------------------------------------
(defn g-struct-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (struct-index (field g layouts) name))
(defn g-sum-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (sum-index (field g layouts) name))
(defn g-sig-idx [(g (ptr Cga)) (name (slice u8))] (-> i64)
  (let [n (al-len [GSig] (load (field g sigs)))
        (mut i) 0
        (mut found) -1]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (when (str-eq (load (field (xal-at [GSig] (field g sigs) (load i)) name)) name)
                  (store! found (load i))
                  (break))
                (store! i (iadd (load i) 1)))))
    (load found)))
(defn ty-align [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (align (field g layouts) t))
(defn ty-size [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (size (field g layouts) t))
(defn g-field-off [(g (ptr Cga)) (si i64) (fi i64)] (-> i64)
  (field-offset (field g layouts) si fi))
(defn g-field-idx [(g (ptr Cga)) (si i64) (name (slice u8))] (-> i64)
  (field-number (field g layouts) si name))
(defn g-type-bytes [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (type-bytes (field g layouts) t))
(defn g-sum-words-def [(g (ptr Cga)) (variants (ptr (ArrayList Variant)))] (-> i64)
  (sum-words (field g layouts) variants))
(defn g-natural-off [(g (ptr Cga)) (fields (ptr (ArrayList Field))) (fi i64)] (-> i64)
  (natural-offset (field g layouts) fields fi))
(defn g-variant-idx [(g (ptr Cga)) (su i64) (name (slice u8))] (-> i64)
  (variant-number (field g layouts) su name))
(defn g-register-types! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (store! (field g layouts) (LayoutDb::new (load (field g a)) mp "cgx64"))
  0)
; ============================ program registration ===========================
; extern "io.write" links against C symbol "write" (last dot component; ELF adds no underscore).
(defn g-last-component [(nm (slice u8))] (-> (slice u8))
  (let [n (slice-len nm)
        (mut dot) -1
        (mut i) 0]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (when (icmp-eq (cast i64 (slice-get nm (load i))) 46) (store! dot (load i)))
                (store! i (iadd (load i) 1)))))
    (if (icmp-ge (load dot) 0) (subslice nm (iadd (load dot) 1) n) nm)))

; The assembly-level name of a Coil/C symbol. Mach-O prefixes every C symbol
; with an underscore; ELF does NOT — `main` is `main`, `write` is `write`. So
; unlike codegen_a64's g-mangle this is the identity, and it stays a named
; function purely so the two backends line up call-site for call-site.
(defn g-mangle [(g (ptr Cga)) (nm (slice u8))] (-> (slice u8))
  nm)

; the C symbol a function is exported under, or None. Mirrors codegen.coil's
; cg-export-find: an (export-c …) entry pins the function's public symbol. On this
; AAPCS64-native backend no thunk is needed — the function itself is emitted under
; this symbol with external linkage (see g-register-sigs!). ExportC.symbol is always
; Some by codegen time (check.coil fills the default bare-name symbol when :as is
; omitted).
(defn g-export-c-sym [(mp (ptr Program)) (name (slice u8))] (-> (Option (slice u8)))
  (let [es (load (field mp exports))
        n (al-len [ExportC] (load es))
        (mut i) 0
        (mut r) (None [(slice u8)])]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (when (str-eq (load (field (xal-at [ExportC] es (load i)) name)) name)
                      (store! r (load (field (xal-at [ExportC] es (load i)) symbol)))
                      (break))
                (store! i (iadd (load i) 1)))))
    (load r)))
; a by-value STRUCT param (type-tag 6) is the one C-export case this reference-model
; backend passes differently from C (by pointer, not in registers) — it would need a
; C-ABI marshaling thunk. Mirrors codegen.coil::cg-export-needs-thunk. Scalar/pointer
; params, struct RETURNS (sret / x0-x1, which already match C), and the metaprogram
; entries (Code = pointer args, empty ExportC params) are all thunk-free.
(defn g-export-needs-thunk [(e (ptr ExportC))] (-> bool)
  (let [ps (load (field e params))
        n (al-len [Type] (load ps))
        (mut i) 0
        (mut r) false]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (match-else (load (xal-at [Type] ps (load i)))
                            (TStruct [nm] (do (store! r true) 0))
                            (_ 0))
                (store! i (iadd (load i) 1)))))
    (load r)))
; register every extern + func as a GSig with a Mach-O symbol.
(defn g-register-sigs! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (let [es (load (field mp externs))
        n (al-len [Extern] (load es))
        (mut i) 0]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (let [ed (xal-at [Extern] es (load i))
                      sym
                        (eobj-add-sym! (mut (field g obj))
                                       (g-mangle g (g-last-component (load (field ed name))))
                                       0
                                       0
                                       true)
                      e (alloc-stack GSig)]
                  (store! (field e name) (load (field ed name)))
                  (store! (field e params) (load (field ed params)))
                  (store! (field e ret) (load (field ed ret)))
                  (store! (field e variadic) (load (field ed variadic)))
                  (store! (field e symidx) sym)
                  (store! (field e shim) false)
                  (store! (field e implsym) -1)
                  (store! (field e shimregs) (box-al [i64] (load (field g a)) (al-new [i64] (load (field g a)))))
                  (store! (field e shimret) 0)
                  (store! (field e isc) true)
                  ; duplicate extern declarations across modules are expected; keep the first
                  (when (icmp-lt (g-sig-idx g (load (field ed name))) 0) (al-push! (mut (field g sigs)) (load e))))
                (store! i (iadd (load i) 1))))))
  (let [fs (load (field mp funcs))
        n (al-len [Func] (load fs))
        (mut i) 0]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (let [fd (xal-at [Func] fs (load i))
                      expsym (g-export-c-sym mp (load (field fd name)))
                      ; an exported function is emitted directly under its C symbol with
                      ; external linkage; otherwise the mangled Coil name, external only for main.
                      ext
                        (or (str-eq (load (field fd name)) "main")
                            (match expsym (Some [s] true) (None [] false)))
                      symname (match expsym (Some [s] s) (None [] (load (field fd name))))
                      sym
                        (eobj-add-sym! (mut (field g obj))
                                       (g-mangle g symname)
                                       (load (field g text))
                                       0
                                       ext)
                      (mut ptys) (al-new [Type] (load (field g a)))
                      e (alloc-stack GSig)]
                  (let [ps (load (field fd params))
                        np (al-len [Param] (load ps))
                        (mut j) 0]
                    (loop (if (icmp-ge (load j) np)
                              (break)
                              (do
                                (al-push! (mut ptys) (load (field (xal-at [Param] ps (load j)) ty)))
                                (store! j (iadd (load j) 1))))))
                  (store! (field e name) (load (field fd name)))
                  (store! (field e params) (box-al [Type] (load (field g a)) (load ptys)))
                  (store! (field e ret) (load (field fd ret)))
                  (store! (field e variadic) false)
                  (store! (field e symidx) sym)
                  (store! (field e shim) false)
                  (store! (field e implsym) -1)
                  (store! (field e shimregs) (box-al [i64] (load (field g a)) (al-new [i64] (load (field g a)))))
                  (store! (field e shimret) 0)
                  (store! (field e isc) false)
                  ; a :shim-convention function is realized as <name>__impl + trampoline
                  (let [ci (g-conv-idx g (load (field fd cc)))]
                    (when (icmp-ge ci 0)
                          (match (load (field (xal-at [Convention] (load (field g convs)) ci) lowering))
                                 (LShim []
                                        (let [cv (xal-at [Convention] (load (field g convs)) ci)
                                              (mut regs) (al-new [i64] (load (field g a)))
                                              prs (load (field cv params))
                                              npr (al-len [(slice u8)] (load prs))
                                              (mut j) 0]
                                          (loop (if (icmp-ge (load j) npr)
                                                    (break)
                                                    (do
                                                      (al-push! (mut regs)
                                                                (g-parse-xreg g
                                                                              (al-get [(slice u8)]
                                                                                      (load prs)
                                                                                      (load j))))
                                                      (store! j (iadd (load j) 1)))))
                                          (store! (field e shim) true)
                                          (store! (field e shimregs) (box-al [i64] (load (field g a)) (load regs)))
                                          (store! (field e shimret)
                                                  (match (load (field cv ret))
                                                    (Some [r] (g-parse-xreg g r))
                                                    (None [] 0)))
                                          (store! (field e implsym)
                                                  (eobj-add-sym! (mut (field g obj))
                                                                 (g-mangle g
                                                                           (sconcat (load (field g a))
                                                                                    (load (field fd name))
                                                                                    "__impl"))
                                                                 (load (field g text))
                                                                 0
                                                                 false))
                                          0))
                                 (LNative [$g2840] 0))))
                  (al-push! (mut (field g sigs)) (load e)))
                (store! i (iadd (load i) 1))))))
  0)

(defn g-conv-idx [(g (ptr Cga)) (nm (slice u8))] (-> i64)
  (let [cs (load (field g convs))
        n (al-len [Convention] (load cs))
        (mut i) 0
        (mut r) -1]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (when (str-eq (load (field (xal-at [Convention] cs (load i)) name)) nm) (store! r (load i)))
                (store! i (iadd (load i) 1)))))
    (load r)))

; ":shim" conventions pin arguments to named machine registers. On x86-64 the
; names are the architectural ones ("rdi", "r10", ...), NOT arm64's xN — a
; convention written for arm64 must fail loudly here rather than silently pick
; a register with the same number, so an xN name is rejected outright. The
; checker emits the same "not a general-purpose register on the target
; architecture" diagnostic the LLVM backend does for the reverse case.
(defn g-parse-xreg [(g (ptr Cga)) (r (slice u8))] (-> i64)
  (cond (str-eq r "rax") 0
        (str-eq r "rcx") 1
        (str-eq r "rdx") 2
        (str-eq r "rsi") 6
        (str-eq r "rdi") 7
        (str-eq r "r8") 8
        (str-eq r "r9") 9
        (str-eq r "r10") 10
        (str-eq r "r11") 11
        (str-eq r "r12") 12
        (str-eq r "r13") 13
        (str-eq r "r14") 14
        (str-eq r "r15") 15
        ; rbx is the slot base and rbp/rsp are the frame — pinning an argument
        ; to one of them would corrupt the frame mid-call.
        (or (str-eq r "rbx") (or (str-eq r "rbp") (str-eq r "rsp")))
          (cgx-fail2 "shim register collides with backend-reserved registers: " r)
        :else
          (cgx-fail2 "not a general-purpose register on the target architecture: " r)))

; (elf.coil already provides eobj-set-sym! / eobj-set-sym-size!.)


; ============================ frame / slots ==================================
; Slots are rbx-relative. rbx is callee-saved, so it survives calls without any
; save/restore dance around each one, and it is set once in the prologue to
; rsp+outbytes — above the outgoing-argument area, so pushing call arguments
; can never disturb a live slot.
(defn slot-new! [(g (ptr Cga)) (size i64) (align i64)] (-> i64)
  ; every slot is 8-aligned and 8-rounded (16 for 16-aligned types): stores of
  ; full 64-bit words into small slots can never clobber a neighbor.
  (let [al (if (icmp-lt align 8) 8 align)
        sz (imul (idiv (iadd (if (icmp-lt size 1) 1 size) 7) 8) 8)
        off (imul (idiv (iadd (load (field g frame)) (isub al 1)) al) al)]
    (store! (field g frame) (iadd off sz))
    off))
(defn slot-for-ty! [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (slot-new! g (ty-size g t) (ty-align g t)))

; Scratch registers. x86 has far fewer than arm64, and several instructions
; pin specific ones (idiv wants rdx:rax, variable shifts want cl), so the
; scratch set is deliberately small, explicit, and never live across a call.
(defn x-scratch0 [] (-> i64) 0)   ; rax — primary temp / return value
(defn x-scratch1 [] (-> i64) 10)  ; r10 — secondary temp
(defn x-scratch2 [] (-> i64) 11)  ; r11 — address temp
(defn x-slotbase [] (-> i64) 3)   ; rbx

; lea reg, [rbx + off] — the address of a slot.
(defn emit-slot-addr! [(g (ptr Cga)) (reg i64) (off i64)] (-> i64)
  (x64-lea! (mut (field g asm)) reg (x-slotbase) off))

; load an int/ptr/bool slot into `reg`, extending per width+signedness.
; Unlike arm64 there is no reach limit: every displacement fits in disp32,
; so the offset never needs to be materialized into a register first.
(defn emit-load-int! [(g (ptr Cga)) (reg i64) (base i64) (off i64) (bytes i64) (signed bool)] (-> i64)
  (let [s (field g asm)]
    (cond (icmp-eq bytes 1)
            (if signed (x64-movsx8-rm! (mut s) reg base off) (x64-movzx8-rm! (mut s) reg base off))
          (icmp-eq bytes 2)
            (if signed (x64-movsx16-rm! (mut s) reg base off) (x64-movzx16-rm! (mut s) reg base off))
          (icmp-eq bytes 4)
            ; the unsigned form is a plain 32-bit mov: writing a 32-bit register
            ; zero-extends to 64 bits for free.
            (if signed (x64-movsx32-rm! (mut s) reg base off) (x64-mov32-rm! (mut s) reg base off))
          :else (x64-mov-rm! (mut s) reg base off))))

; store `reg` into a slot, truncating to the slot width.
(defn emit-store-int! [(g (ptr Cga)) (reg i64) (base i64) (off i64) (bytes i64)] (-> i64)
  (let [s (field g asm)]
    (cond (icmp-eq bytes 1) (x64-mov8-mr! (mut s) base off reg)
          (icmp-eq bytes 2) (x64-mov16-mr! (mut s) base off reg)
          (icmp-eq bytes 4) (x64-mov32-mr! (mut s) base off reg)
          :else (x64-mov-mr! (mut s) base off reg))))

; float slot <-> xmm register
(defn emit-load-fp! [(g (ptr Cga)) (xreg i64) (base i64) (off i64) (bytes i64)] (-> i64)
  (x64-movs-rm! (mut (field g asm)) (icmp-eq bytes 8) xreg base off))
(defn emit-store-fp! [(g (ptr Cga)) (xreg i64) (base i64) (off i64) (bytes i64)] (-> i64)
  (x64-movs-mr! (mut (field g asm)) (icmp-eq bytes 8) base off xreg))

; is a type an int-like scalar (lives in GPRs)? floats live in xmm.
(defn ty-is-float [(t (ptr Type))] (-> bool)
  (match-else (load t) (TFloat [_] true) (_ false)))
(defn ty-float-bytes [(t (ptr Type))] (-> i64)
  (match-else (load t) (TFloat [bits] (idiv bits 8)) (_ 8)))
(defn ty-is-scalar [(t (ptr Type))] (-> bool)
  (match-else (load t)
              (TInt [_ _] true)
              (TBool [] true)
              (TPtr [_] true)
              (TRef [_ _] true)
              (TFn [_ _ _] true)
              (TNever [] true)
              (TFloat [_] true)
              (TStruct [nm] false)
              (_ false)))
(defn ty-int-info [(g (ptr Cga)) (t (ptr Type)) (bytesp (ptr i64)) (signedp (ptr bool))] (-> i64)
  (match-else (load t)
              (TInt [bits sg]
                    (do
                      (store! bytesp (cond (icmp-le bits 8) 1 (icmp-le bits 16) 2 (icmp-le bits 32) 4 :else 8))
                      (store! signedp sg)
                      0))
              (TBool [] (do (store! bytesp 1) (store! signedp false) 0))
              (_ (do (store! bytesp 8) (store! signedp false) 0))))

; load an AVal into GPR `reg` (int-like values only).
(defn av-to-x! [(g (ptr Cga)) (av AVal) (reg i64)] (-> i64)
  (let [k (av-kind av)
        t (alloc-stack Type)]
    (store! t (av-ty av))
    (if (or (icmp-eq k 0) (icmp-eq k 2))
        (x64-mov-imm! (mut (field g asm)) reg (av-v av))
        (let [bytes (alloc-stack i64)
              signed (alloc-stack bool)]
          (ty-int-info g t bytes signed)
          (if (ty-is-float t)
              (emit-load-int! g reg (x-slotbase) (av-v av) (ty-float-bytes t) false)
              (emit-load-int! g reg (x-slotbase) (av-v av) (load bytes) (load signed)))))))

; load an AVal into xmm reg `xreg` (float values only).
(defn av-to-d! [(g (ptr Cga)) (av AVal) (xreg i64)] (-> i64)
  (let [k (av-kind av)
        t (alloc-stack Type)]
    (store! t (av-ty av))
    (if (icmp-eq k 2)
        ; a float immediate is carried as raw bits: materialize into a GPR and
        ; move the bit pattern across, never through a conversion.
        (do
          (x64-mov-imm! (mut (field g asm)) (x-scratch1) (av-v av))
          (x64-movq-xr! (mut (field g asm)) xreg (x-scratch1))
          0)
        (if (icmp-eq k 1)
            (emit-load-fp! g xreg (x-slotbase) (av-v av) (ty-float-bytes t))
            (cgx-fail "av-to-d!: int immediate where float expected")))))

; materialize an AVal into a slot; returns the slot offset.
(defn av-slot! [(g (ptr Cga)) (av AVal)] (-> i64)
  (if (icmp-eq (av-kind av) 1)
      (av-v av)
      (let [t (alloc-stack Type)]
        (store! t (av-ty av))
        (let [off (slot-for-ty! g t)]
          (x64-mov-imm! (mut (field g asm)) (x-scratch0) (av-v av))
          (emit-store-int! g (x-scratch0) (x-slotbase) off (ty-size g t))
          off))))

; ============================ copies =========================================
; copy `size` bytes between slots (rbx-relative), through a scratch register.
; Unrolled words for small sizes, a byte loop for huge ones — same shape as the
; arm64 backend, so aggregate copies stay comparable between the two.
(defn emit-copy! [(g (ptr Cga)) (dst i64) (src i64) (size i64)] (-> i64)
  (let [s (field g asm)]
    (if (icmp-le size 256)
        (let [(mut k) 0]
          (loop (if (icmp-gt (iadd (load k) 8) size)
                    (break)
                    (do
                      (emit-load-int! g (x-scratch0) (x-slotbase) (iadd src (load k)) 8 false)
                      (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 8)
                      (store! k (iadd (load k) 8)))))
          (when (icmp-le (iadd (load k) 4) size)
                (emit-load-int! g (x-scratch0) (x-slotbase) (iadd src (load k)) 4 false)
                (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 4)
                (store! k (iadd (load k) 4))
                0)
          (when (icmp-le (iadd (load k) 2) size)
                (emit-load-int! g (x-scratch0) (x-slotbase) (iadd src (load k)) 2 false)
                (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 2)
                (store! k (iadd (load k) 2))
                0)
          (when (icmp-le (iadd (load k) 1) size)
                (emit-load-int! g (x-scratch0) (x-slotbase) (iadd src (load k)) 1 false)
                (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 1)
                (store! k (iadd (load k) 1))
                0)
          0)
        ; big: byte loop. r10 = index, r11 = src addr, rax = scratch byte.
        (do
          (emit-slot-addr! g (x-scratch2) src)
          (x64-mov-imm! (mut s) (x-scratch1) 0)
          (let [ltop (x64-new-label (mut s))
                lend (x64-new-label (mut s))]
            (x64-bind-label! (mut s) ltop)
            (x64-cmp-ri! (mut s) (x-scratch1) size)
            (x64-jcc-label! (mut s) (x64-cc-ge) lend)
            ; rax = src[i]; then store to dst[i] — both addresses are formed by
            ; adding the running index into a scratch address register.
            (x64-mov-rr! (mut s) (x-scratch0) (x-scratch2))
            (x64-add-rr! (mut s) (x-scratch0) (x-scratch1))
            (x64-movzx8-rm! (mut s) (x-scratch0) (x-scratch0) 0)
            (emit-slot-addr! g 2 dst)  ; rdx = &dst
            (x64-add-rr! (mut s) 2 (x-scratch1))
            (x64-mov8-mr! (mut s) 2 0 (x-scratch0))
            (x64-add-ri! (mut s) (x-scratch1) 1)
            (x64-jmp-label! (mut s) ltop)
            (x64-bind-label! (mut s) lend))
          0))))

; copy from a slot to the memory pointed at by `dstreg`.
; The value scratch must not BE `dstreg`: the first load would overwrite the
; destination pointer and every subsequent store would go through garbage
; (this produced a literal `mov %rax,(%rax)`). When the caller hands us the
; primary scratch, move the pointer somewhere safe first.
(defn emit-copy-to-mem! [(g (ptr Cga)) (dstreg0 i64) (src i64) (size i64)] (-> i64)
  (let [s (field g asm)
        dstreg (if (icmp-eq dstreg0 (x-scratch0))
                   (do (x64-mov-rr! (mut s) (x-scratch2) dstreg0) (x-scratch2))
                   dstreg0)
        (mut k) 0]
    (loop (if (icmp-gt (iadd (load k) 8) size)
              (break)
              (do
                (emit-load-int! g (x-scratch0) (x-slotbase) (iadd src (load k)) 8 false)
                (x64-mov-mr! (mut s) dstreg (load k) (x-scratch0))
                (store! k (iadd (load k) 8)))))
    (when (icmp-le (iadd (load k) 4) size)
          (emit-load-int! g (x-scratch0) (x-slotbase) (iadd src (load k)) 4 false)
          (x64-mov32-mr! (mut s) dstreg (load k) (x-scratch0))
          (store! k (iadd (load k) 4))
          0)
    (when (icmp-le (iadd (load k) 2) size)
          (emit-load-int! g (x-scratch0) (x-slotbase) (iadd src (load k)) 2 false)
          (x64-mov16-mr! (mut s) dstreg (load k) (x-scratch0))
          (store! k (iadd (load k) 2))
          0)
    (when (icmp-le (iadd (load k) 1) size)
          (emit-load-int! g (x-scratch0) (x-slotbase) (iadd src (load k)) 1 false)
          (x64-mov8-mr! (mut s) dstreg (load k) (x-scratch0))
          (store! k (iadd (load k) 1))
          0)
    0))

; copy from the memory pointed at by `srcreg` into a slot. Same aliasing hazard
; as emit-copy-to-mem!: the loaded value would clobber the source pointer.
(defn emit-copy-from-mem! [(g (ptr Cga)) (dst i64) (srcreg0 i64) (size i64)] (-> i64)
  (let [s (field g asm)
        srcreg (if (icmp-eq srcreg0 (x-scratch0))
                   (do (x64-mov-rr! (mut s) (x-scratch2) srcreg0) (x-scratch2))
                   srcreg0)
        (mut k) 0]
    (loop (if (icmp-gt (iadd (load k) 8) size)
              (break)
              (do
                (x64-mov-rm! (mut s) (x-scratch0) srcreg (load k))
                (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 8)
                (store! k (iadd (load k) 8)))))
    (when (icmp-le (iadd (load k) 4) size)
          (x64-mov32-rm! (mut s) (x-scratch0) srcreg (load k))
          (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 4)
          (store! k (iadd (load k) 4))
          0)
    (when (icmp-le (iadd (load k) 2) size)
          (x64-movzx16-rm! (mut s) (x-scratch0) srcreg (load k))
          (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 2)
          (store! k (iadd (load k) 2))
          0)
    (when (icmp-le (iadd (load k) 1) size)
          (x64-movzx8-rm! (mut s) (x-scratch0) srcreg (load k))
          (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 1)
          (store! k (iadd (load k) 1))
          0)
    0))

; ============================ zeroing ========================================
(defn emit-zero! [(g (ptr Cga)) (dst i64) (size i64)] (-> i64)
  (let [s (field g asm)]
    (x64-mov-imm! (mut s) (x-scratch0) 0)
    (if (icmp-le size 256)
        (let [(mut k) 0]
          (loop (if (icmp-gt (iadd (load k) 8) size)
                    (break)
                    (do
                      (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 8)
                      (store! k (iadd (load k) 8)))))
          (when (icmp-le (iadd (load k) 4) size)
                (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 4)
                (store! k (iadd (load k) 4))
                0)
          (when (icmp-le (iadd (load k) 2) size)
                (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 2)
                (store! k (iadd (load k) 2))
                0)
          (when (icmp-le (iadd (load k) 1) size)
                (emit-store-int! g (x-scratch0) (x-slotbase) (iadd dst (load k)) 1)
                (store! k (iadd (load k) 1))
                0)
          0)
        (do
          (emit-slot-addr! g (x-scratch2) dst)
          (x64-mov-imm! (mut s) (x-scratch1) 0)
          (let [ltop (x64-new-label (mut s))
                lend (x64-new-label (mut s))]
            (x64-bind-label! (mut s) ltop)
            (x64-cmp-ri! (mut s) (x-scratch1) size)
            (x64-jcc-label! (mut s) (x64-cc-ge) lend)
            (x64-mov-rr! (mut s) 2 (x-scratch2))
            (x64-add-rr! (mut s) 2 (x-scratch1))
            (x64-mov8-mr! (mut s) 2 0 (x-scratch0))
            (x64-add-ri! (mut s) (x-scratch1) 1)
            (x64-jmp-label! (mut s) ltop)
            (x64-bind-label! (mut s) lend))
          0))))

; ============================ ABI classification =============================
; SysV AMD64. Classes here are chosen to mirror the arm64 backend's AbiInfo
; shape so the call/param code stays structurally identical, but the MEANING is
; the SysV one:
;   0 = int-like scalar (one GPR)
;   1 = float scalar (one SSE reg)
;   2 = aggregate <= 8 bytes  -> ONE register, whose class is eb0
;   3 = aggregate <= 16 bytes -> TWO registers, classes eb0 and eb1
;   4 = aggregate > 16 bytes  -> MEMORY (passed on the stack; returned via a
;                                hidden pointer in rdi, returned in rax)
; eb0/eb1 are the per-eightbyte classes: 1 = INTEGER, 2 = SSE.
;
; There is no HFA rule on x86-64 (that is an AAPCS64 concept). What replaces it
; is the eightbyte merge: each byte of the aggregate gets a class, bytes are
; merged into 8-byte groups, and INTEGER dominates SSE within a group. So
; `struct {float a,b;}` is ONE eightbyte of class SSE (passed in one xmm as two
; packed floats), while `struct {float a; long b;}` is two eightbytes, SSE then
; INTEGER. Getting this wrong is invisible on simple tests and catastrophic on
; real C interop, which is why the adversarial ABI test exists.
(defstruct AbiInfo [(cls i64) (eb0 i64) (eb1 i64)])

(defn abi-cls [(x AbiInfo)] (-> i64)
  (let [p (alloc-stack AbiInfo)] (store! p x) (load (field p cls))))
(defn abi-eb0 [(x AbiInfo)] (-> i64)
  (let [p (alloc-stack AbiInfo)] (store! p x) (load (field p eb0))))
(defn abi-eb1 [(x AbiInfo)] (-> i64)
  (let [p (alloc-stack AbiInfo)] (store! p x) (load (field p eb1))))
(defn mk-abi-scalar [] (-> AbiInfo)
  (let [r (alloc-stack AbiInfo)]
    (store! (field r cls) 0)
    (store! (field r eb0) 0)
    (store! (field r eb1) 0)
    (load r)))

; The SysV class merge for two classes covering the same byte:
; INTEGER (1) dominates SSE (2) dominates NONE (0).
(defn abi-merge [(x i64) (y i64)] (-> i64)
  (cond (or (icmp-eq x 1) (icmp-eq y 1)) 1
        (or (icmp-eq x 2) (icmp-eq y 2)) 2
        :else 0))

; Walk a type and paint each byte it covers with its class, into `bytes`.
; `base` is the type's byte offset within the enclosing aggregate. This is the
; faithful port of codegen.coil's abi-flatten-type, but driven by the native
; layout tables here rather than by LLVM's.
(defn g-abi-paint! [(g (ptr Cga)) (t (ptr Type)) (base i64) (bytes (mut (ArrayList i64)))] (-> i64)
  (let [n (al-len [i64] (load bytes))]
    (match-else (load t)
      (TFloat [bits]
              (let [sz (idiv bits 8)
                    (mut i) 0]
                (loop (if (icmp-ge (load i) sz)
                          (break)
                          (do
                            (when (icmp-lt (iadd base (load i)) n)
                                  (al-set! (mut bytes)
                                           (iadd base (load i))
                                           (abi-merge (al-get [i64] (load bytes) (iadd base (load i))) 2))
                                  0)
                            (store! i (iadd (load i) 1)))))
                0))
      (TArray [elem cnt]
              (let [esz (ty-size g elem)
                    (mut i) 0]
                (loop (if (icmp-ge (load i) cnt)
                          (break)
                          (do
                            (g-abi-paint! g elem (iadd base (imul (load i) esz)) (mut bytes))
                            (store! i (iadd (load i) 1)))))
                0))
      (TStruct [nm]
               (let [si (g-struct-idx g nm)]
                 (if (icmp-ge si 0)
                     (let [fs (load (field (struct-at (field g layouts) si) fields))
                           nf (al-len [Field] (load fs))
                           (mut i) 0]
                       (loop (if (icmp-ge (load i) nf)
                                 (break)
                                 (do
                                   (g-abi-paint! g
                                                 (field (xal-at [Field] fs (load i)) ty)
                                                 (iadd base (g-field-off g si (load i)))
                                                 (mut bytes))
                                   (store! i (iadd (load i) 1)))))
                       0)
                     ; a sum: tag + payload words, all INTEGER
                     (let [sz (ty-size g t)
                           (mut i) 0]
                       (loop (if (icmp-ge (load i) sz)
                                 (break)
                                 (do
                                   (when (icmp-lt (iadd base (load i)) n)
                                         (al-set! (mut bytes)
                                                  (iadd base (load i))
                                                  (abi-merge (al-get [i64] (load bytes) (iadd base (load i))) 1))
                                         0)
                                   (store! i (iadd (load i) 1)))))
                       0))))
      ; everything else (ints, bools, pointers, refs, fnptrs, slices) is INTEGER
      (_ (let [sz (ty-size g t)
               (mut i) 0]
           (loop (if (icmp-ge (load i) sz)
                     (break)
                     (do
                       (when (icmp-lt (iadd base (load i)) n)
                             (al-set! (mut bytes)
                                      (iadd base (load i))
                                      (abi-merge (al-get [i64] (load bytes) (iadd base (load i))) 1))
                             0)
                       (store! i (iadd (load i) 1)))))
           0)))))

; class of one eightbyte: merge every painted byte in [lo, lo+8).
(defn g-abi-eightbyte [(bytes (ptr (ArrayList i64))) (lo i64) (size i64)] (-> i64)
  (let [(mut i) 0
        (mut c) 0]
    (loop (if (or (icmp-ge (load i) 8) (icmp-ge (iadd lo (load i)) size))
              (break)
              (do
                (store! c (abi-merge (load c) (al-get [i64] (load bytes) (iadd lo (load i)))))
                (store! i (iadd (load i) 1)))))
    ; an eightbyte with no painted bytes still occupies a register; treat it as
    ; INTEGER so padding-only tails never silently vanish from the arg list.
    (if (icmp-eq (load c) 0) 1 (load c))))

(defn g-abi-info [(g (ptr Cga)) (t (ptr Type))] (-> AbiInfo)
  (let [r (alloc-stack AbiInfo)]
    (store! (field r eb0) 0)
    (store! (field r eb1) 0)
    (if (ty-is-scalar t)
        (do (store! (field r cls) (if (ty-is-float t) 1 0)) 0)
        (let [sz (ty-size g t)]
          (if (icmp-gt sz 16)
              (do (store! (field r cls) 4) 0)
              (let [a (load (field g a))
                    (mut bytes) (al-new [i64] a)
                    (mut i) 0]
                (loop (if (icmp-ge (load i) sz)
                          (break)
                          (do (al-push! (mut bytes) 0) (store! i (iadd (load i) 1)))))
                (g-abi-paint! g t 0 (mut bytes))
                (store! (field r eb0) (g-abi-eightbyte (mut bytes) 0 sz))
                (if (icmp-le sz 8)
                    (do (store! (field r cls) 2) 0)
                    (do
                      (store! (field r cls) 3)
                      (store! (field r eb1) (g-abi-eightbyte (mut bytes) 8 sz))
                      0))))))
    (load r)))

; The SysV argument registers, in order.
(defn x-argreg [(i i64)] (-> i64)
  (cond (icmp-eq i 0) 7   ; rdi
        (icmp-eq i 1) 6   ; rsi
        (icmp-eq i 2) 2   ; rdx
        (icmp-eq i 3) 1   ; rcx
        (icmp-eq i 4) 8   ; r8
        (icmp-eq i 5) 9   ; r9
        :else (cgx-fail "x-argreg: more than 6 integer argument registers")))

; ============================ calls ==========================================
; One unified SysV AMD64 call emitter for direct calls (symidx >= 0) and
; indirect calls through a function-pointer AVal (symidx < 0).
; `params` = the callee's declared param types (named args); args beyond that
; are variadic.
;
; The SysV sequence, in the order it must happen:
;   1. classify every argument, assigning integer regs (rdi rsi rdx rcx r8 r9),
;      SSE regs (xmm0-7), or stack slots. An argument that does not fit in the
;      remaining registers goes on the stack — and once one does, ALL later
;      arguments of that class do too.
;   2. write stack arguments to [rsp + n] (the outgoing area rbx sits above).
;   3. load register arguments LAST, so nothing we emit while computing an
;      argument can clobber a register already loaded.
;   4. for a variadic callee, set al = the number of SSE registers used. libc
;      varargs functions read it; getting it wrong corrupts printf("%f").
;   5. call; then spill the return value into a fresh slot.
; `cabi` selects the SysV by-value aggregate rules. It must be true ONLY for
; calls that really cross the C boundary. Internal calls (including dyn
; dispatch, whose trait signatures declare aggregate params BY VALUE while the
; call site passes references) keep this backend's own convention of handing
; aggregates around by pointer, and turning that into a stack copy corrupts the
; callee's view of its arguments.
(defn emit-call-abi! [(g (ptr Cga))
                      (symidx i64)
                      (fpav (ptr AVal))
                      (params (ptr (ArrayList Type)))
                      (variadic bool)
                      (ret Type)
                      (avs (ptr (ArrayList AVal)))
                      (cabi bool)] (-> AVal)
  (let [s (field g asm)
        a (load (field g a))
        nargs (al-len [AVal] (load avs))
        nparams (al-len [Type] (load params))
        retp (alloc-stack Type)]
    (store! retp ret)
    (let [retvoid (match-else ret (TVoid [] true) (_ false))
          retinfo (if retvoid (mk-abi-scalar) (g-abi-info g retp))
          resslot (if retvoid -1 (slot-for-ty! g retp))
          ; kinds: 0 int-reg, 1 sse-reg, 2 two-reg pair, 3 stack, 4 indirect(memory)
          (mut pkind) (al-new [i64] a)
          (mut pr0) (al-new [i64] a)   ; first register (or stack offset)
          (mut pr1) (al-new [i64] a)   ; second register for pairs
          (mut pslot) (al-new [i64] a)
          (mut gp) 0
          (mut fp) 0
          (mut stk) 0]
      ; a >16B return is passed as a hidden first INTEGER argument (rdi)
      (when (icmp-eq (abi-cls retinfo) 4) (store! gp 1) 0)
      ; ---- 1. classify
      (let [(mut i) 0]
        (loop (if (icmp-ge (load i) nargs)
                  (break)
                  (do
                    (let [av (al-get [AVal] (load avs) (load i))
                          t (alloc-stack Type)]
                      ; Classify by the callee's DECLARED parameter type, not by
                      ; the argument's own type. Internally this backend hands
                      ; aggregates around as references, so an argument whose
                      ; declared type is a by-value struct arrives here as a
                      ; (ref S) — which would classify as a plain pointer and be
                      ; passed in one register. That is right for AAPCS64 (which
                      ; really does pass >16B indirectly) but WRONG for SysV,
                      ; where the caller must place a COPY on the stack. Beyond
                      ; the declared params the args are variadic, and variadic
                      ; arguments are never by-value aggregates here, so the
                      ; argument's own type is the right answer there.
                      (store! t (if (and cabi (icmp-lt (load i) nparams))
                                    (al-get [Type] (load params) (load i))
                                    (av-ty av)))
                      (let [info (g-abi-info g t)
                            cls (abi-cls info)
                            ; A by-value aggregate arrives as a reference, so the
                            ; bytes to copy live at the address the slot HOLDS,
                            ; not in the slot itself.
                            ; the value arrives indirectly whenever the declared
                            ; type is an aggregate but the ARGUMENT is a pointer
                            ; or reference to it (how this backend moves
                            ; aggregates internally).
                            byref (and cabi
                                       (and (icmp-ge (abi-cls info) 2)
                                            (match-else (av-ty av)
                                                        (TRef [_m _i] true)
                                                        (TPtr [_i2] true)
                                                        (_ false))))
                            slot (if byref
                                     (let [tmp (slot-for-ty! g t)]
                                       (av-to-x! g av (x-scratch2))
                                       (emit-copy-from-mem! g tmp (x-scratch2) (ty-size g t))
                                       tmp)
                                     (av-slot! g av))]
                        (al-push! (mut pslot) slot)
                        (cond
                          ; ---- scalar float
                          (icmp-eq cls 1)
                            (if (icmp-lt (load fp) 8)
                                (do (al-push! (mut pkind) 1) (al-push! (mut pr0) (load fp))
                                    (al-push! (mut pr1) 0)
                                    (store! fp (iadd (load fp) 1)) 0)
                                (do (al-push! (mut pkind) 3) (al-push! (mut pr0) (load stk))
                                    (al-push! (mut pr1) 0)
                                    (store! stk (iadd (load stk) 8)) 0))
                          ; ---- scalar int/ptr
                          (icmp-eq cls 0)
                            (if (icmp-lt (load gp) 6)
                                (do (al-push! (mut pkind) 0) (al-push! (mut pr0) (load gp))
                                    (al-push! (mut pr1) 0)
                                    (store! gp (iadd (load gp) 1)) 0)
                                (do (al-push! (mut pkind) 3) (al-push! (mut pr0) (load stk))
                                    (al-push! (mut pr1) 0)
                                    (store! stk (iadd (load stk) 8)) 0))
                          ; ---- aggregate <= 8B: one register, class from eb0
                          (icmp-eq cls 2)
                            (let [sse (icmp-eq (abi-eb0 info) 2)]
                              (if (if sse (icmp-lt (load fp) 8) (icmp-lt (load gp) 6))
                                  (do (al-push! (mut pkind) (if sse 1 0))
                                      (al-push! (mut pr0) (if sse (load fp) (load gp)))
                                      (al-push! (mut pr1) 0)
                                      (if sse (store! fp (iadd (load fp) 1)) (store! gp (iadd (load gp) 1)))
                                      0)
                                  (do (al-push! (mut pkind) 3) (al-push! (mut pr0) (load stk))
                                      (al-push! (mut pr1) 0)
                                      (store! stk (iadd (load stk) 8)) 0)))
                          ; ---- aggregate <= 16B: two registers, one per eightbyte
                          (icmp-eq cls 3)
                            (let [s0 (icmp-eq (abi-eb0 info) 2)
                                  s1 (icmp-eq (abi-eb1 info) 2)
                                  needg (iadd (if s0 0 1) (if s1 0 1))
                                  needf (iadd (if s0 1 0) (if s1 1 0))]
                              ; both eightbytes must fit, or the whole thing goes on the stack
                              (if (and (icmp-le (iadd (load gp) needg) 6)
                                       (icmp-le (iadd (load fp) needf) 8))
                                  (let [r0 (if s0 (load fp) (load gp))]
                                    (if s0 (store! fp (iadd (load fp) 1)) (store! gp (iadd (load gp) 1)))
                                    (let [r1 (if s1 (load fp) (load gp))]
                                      (if s1 (store! fp (iadd (load fp) 1)) (store! gp (iadd (load gp) 1)))
                                      ; encode the two classes alongside the two registers:
                                      ; kind 2 means "pair"; the SSE-ness rides in pr0/pr1's
                                      ; high bit so the emit pass knows which file to use.
                                      (al-push! (mut pkind) 2)
                                      (al-push! (mut pr0) (ior r0 (if s0 256 0)))
                                      (al-push! (mut pr1) (ior r1 (if s1 256 0)))
                                      0))
                                  ; Both eightbytes go on the stack. This is kind 4
                                  ; (a by-value memory argument of a known size), NOT
                                  ; kind 3 — kind 3 writes a single 8-byte slot, which
                                  ; would leave the callee's second eightbyte reading
                                  ; whatever happened to be on the stack.
                                  (do (al-push! (mut pkind) 4) (al-push! (mut pr0) (load stk))
                                      (al-push! (mut pr1) 16)
                                      (store! stk (iadd (load stk) 16)) 0)))
                          ; ---- > 16B: passed in memory, by value, on the stack
                          :else
                            (let [sz (ty-size g t)
                                  asz (imul (idiv (iadd sz 7) 8) 8)]
                              (al-push! (mut pkind) 4)
                              (al-push! (mut pr0) (load stk))
                              (al-push! (mut pr1) asz)
                              (store! stk (iadd (load stk) asz))
                              0))))
                    (store! i (iadd (load i) 1))))))
      ; the outgoing area must be big enough for this call, and 16-byte aligned
      ; so the callee sees the ABI's alignment guarantee at its entry.
      (let [need (imul (idiv (iadd (load stk) 15) 16) 16)]
        (when (icmp-gt need (load (field g outbytes))) (store! (field g outbytes) need) 0))

      ; ---- 2. stack arguments first (they may need scratch registers)
      (let [(mut i) 0]
        (loop (if (icmp-ge (load i) nargs)
                  (break)
                  (do
                    (let [k (al-get [i64] (load pkind) (load i))
                          off (al-get [i64] (load pr0) (load i))
                          slot (al-get [i64] (load pslot) (load i))]
                      (cond (icmp-eq k 3)
                              (do (emit-load-int! g (x-scratch0) (x-slotbase) slot 8 false)
                                  (x64-mov-mr! (mut s) 4 off (x-scratch0))
                                  0)
                            (icmp-eq k 4)
                              ; by-value memory argument: copy the whole aggregate
                              ; into the outgoing area.
                              (let [sz (al-get [i64] (load pr1) (load i))
                                    (mut j) 0]
                                (loop (if (icmp-ge (load j) sz)
                                          (break)
                                          (do
                                            (emit-load-int! g (x-scratch0) (x-slotbase) (iadd slot (load j)) 8 false)
                                            (x64-mov-mr! (mut s) 4 (iadd off (load j)) (x-scratch0))
                                            (store! j (iadd (load j) 8)))))
                                0)
                            :else 0))
                    (store! i (iadd (load i) 1))))))

      ; ---- 3. register arguments last
      (let [(mut i) 0]
        (loop (if (icmp-ge (load i) nargs)
                  (break)
                  (do
                    (let [k (al-get [i64] (load pkind) (load i))
                          r0 (al-get [i64] (load pr0) (load i))
                          r1 (al-get [i64] (load pr1) (load i))
                          slot (al-get [i64] (load pslot) (load i))
                          av (al-get [AVal] (load avs) (load i))
                          t (alloc-stack Type)]
                      (store! t (av-ty av))
                      (cond (icmp-eq k 0)
                              ; a scalar is loaded at its own width; an aggregate
                              ; eightbyte is always a full 8-byte load.
                              (if (ty-is-scalar t)
                                  (let [bytes (alloc-stack i64)
                                        signed (alloc-stack bool)]
                                    (ty-int-info g t bytes signed)
                                    (emit-load-int! g (x-argreg r0) (x-slotbase) slot (load bytes) (load signed))
                                    0)
                                  (emit-load-int! g (x-argreg r0) (x-slotbase) slot 8 false))
                            (icmp-eq k 1)
                              (emit-load-fp! g r0 (x-slotbase) slot
                                             (if (ty-is-scalar t) (ty-float-bytes t) 8))
                            (icmp-eq k 2)
                              (do
                                (if (icmp-ne (iand r0 256) 0)
                                    (emit-load-fp! g (iand r0 255) (x-slotbase) slot 8)
                                    (emit-load-int! g (x-argreg (iand r0 255)) (x-slotbase) slot 8 false))
                                (if (icmp-ne (iand r1 256) 0)
                                    (emit-load-fp! g (iand r1 255) (x-slotbase) (iadd slot 8) 8)
                                    (emit-load-int! g (x-argreg (iand r1 255)) (x-slotbase) (iadd slot 8) 8 false))
                                0)
                            :else 0))
                    (store! i (iadd (load i) 1))))))

      ; hidden sret pointer goes in rdi, after everything else has been placed
      (when (icmp-eq (abi-cls retinfo) 4) (emit-slot-addr! g 7 resslot) 0)

      ; ---- 4. variadic: al = number of SSE registers used
      (when variadic (x64-mov-imm! (mut s) (x-scratch0) (load fp)) 0)

      ; ---- 5. the call
      (if (icmp-ge symidx 0)
          (let [off (x64-call-rel32! (mut s))]
            (eobj-add-reloc! (mut (field g obj)) (load (field g text)) off symidx (r-x86-64-plt32) -4)
            0)
          (do
            ; the target must not be one of the argument registers, and r11 is
            ; the one scratch guaranteed free at a call boundary.
            (av-to-x! g (load fpav) (x-scratch2))
            (x64-call-r! (mut s) (x-scratch2))
            0))

      ; ---- result
      (if retvoid
          (mk-aval 0 0 (TInt 64 true))
          (let [cls (abi-cls retinfo)]
            (cond (icmp-eq cls 0)
                    (do (emit-store-int! g 0 (x-slotbase) resslot (ty-size g retp))
                        (mk-aval 1 resslot ret))
                  (icmp-eq cls 1)
                    (do (emit-store-fp! g 0 (x-slotbase) resslot (ty-float-bytes retp))
                        (mk-aval 1 resslot ret))
                  (icmp-eq cls 2)
                    (do (if (icmp-eq (abi-eb0 retinfo) 2)
                            (emit-store-fp! g 0 (x-slotbase) resslot 8)
                            (emit-store-int! g 0 (x-slotbase) resslot (ty-size g retp)))
                        (mk-aval 1 resslot ret))
                  (icmp-eq cls 3)
                    ; two eightbytes come back in (rax,rdx) / (xmm0,xmm1) / a mix,
                    ; each file numbered independently.
                    (let [s0 (icmp-eq (abi-eb0 retinfo) 2)
                          s1 (icmp-eq (abi-eb1 retinfo) 2)
                          rem (isub (ty-size g retp) 8)]
                      (if s0
                          (emit-store-fp! g 0 (x-slotbase) resslot 8)
                          (emit-store-int! g 0 (x-slotbase) resslot 8))
                      (if s1
                          ; second SSE eightbyte is xmm1 if the first was SSE, else xmm0
                          (emit-store-fp! g (if s0 1 0) (x-slotbase) (iadd resslot 8)
                                          (if (icmp-ge rem 8) 8 rem))
                          ; second INTEGER eightbyte is rdx if the first was INTEGER, else rax
                          (emit-store-int! g (if s0 0 2) (x-slotbase) (iadd resslot 8)
                                           (if (icmp-ge rem 8) 8 rem)))
                      (mk-aval 1 resslot ret))
                  :else  ; cls 4: the callee wrote through the hidden pointer
                    (mk-aval 1 resslot ret)))))))

; The internal convention: aggregates travel by pointer, exactly as on arm64.
(defn emit-call! [(g (ptr Cga))
                  (symidx i64)
                  (fpav (ptr AVal))
                  (params (ptr (ArrayList Type)))
                  (variadic bool)
                  (ret Type)
                  (avs (ptr (ArrayList AVal)))] (-> AVal)
  (emit-call-abi! g symidx fpav params variadic ret avs false))

; ============================ globals / strings ==============================
; intern an EStr/ECStr payload as a private const-section global; returns symidx.
; `nul` appends a trailing NUL (ECStr); EStr arrays are exactly the bytes.
(defn g-intern-str! [(g (ptr Cga)) (sv (slice u8)) (nul bool)] (-> i64)
  (let [n (al-len [GStr] (load (field g strs)))
        (mut i) 0
        (mut found) -1]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (let [e (xal-at [GStr] (field g strs) (load i))]
                  ; entries are stored with a 1-byte kind prefix (0=str,1=cstr)
                  (let [es (load (field e s))]
                    (when (and (icmp-eq (cast i64 (slice-get es 0)) (when nul 1))
                               (str-eq (subslice es 1 (slice-len es)) sv))
                          (store! found (load (field e symidx)))
                          0)))
                (store! i (iadd (load i) 1)))))
    (if (icmp-ge (load found) 0)
        (load found)
        (let [a (load (field g a))
              buf (eobj-sect-buf (mut (field g obj)) (load (field g constsec)))
              off (al-len [u8] (load buf))
              ; ".L" is the ELF convention for a local label the linker may drop
              ; from the final symbol table; "l_" is the Mach-O one.
              nm (sconcat a (if nul ".Lcstr." ".Lstr.") (i64->str a (load (field g nglob))))]
          (store! (field g nglob) (iadd (load (field g nglob)) 1))
          (xb-bytes! (mut buf) sv)
          (when nul (xb-u8! (mut buf) 0))
          (let [sym (eobj-add-sym! (mut (field g obj)) nm (load (field g constsec)) off false)
                e (alloc-stack GStr)
                (mut tagged) (sb-new a)]
            (sb-push-byte! (mut tagged) (cast u8 (when nul 1)))
            (sb-push-str! (mut tagged) sv)
            (store! (field e s) (sb-str (load tagged)))
            (store! (field e symidx) sym)
            (al-push! (mut (field g strs)) (load e))
            sym)))))

; a zero-initialized global in .data; returns symidx.
(defn g-zero-global! [(g (ptr Cga)) (size i64) (align i64)] (-> i64)
  (let [a (load (field g a))
        buf (eobj-sect-buf (mut (field g obj)) (load (field g datasec)))]
    (xb-align! (mut buf) (if (icmp-lt align 8) 8 align))
    (let [off (al-len [u8] (load buf))
          nm (sconcat a ".Lg." (i64->str a (load (field g nglob))))]
      (store! (field g nglob) (iadd (load (field g nglob)) 1))
      (xb-zeros! (mut buf) size)
      (eobj-add-sym! (mut (field g obj)) nm (load (field g datasec)) off false))))

; reg = address of a symbol. On x86-64 this is a single RIP-relative lea with
; one PC32 relocation — no adrp/add pair. The addend is -4 because the
; displacement is measured from the end of the instruction but the field starts
; 4 bytes before it.
(defn emit-sym-addr! [(g (ptr Cga)) (reg i64) (symidx i64)] (-> i64)
  (let [s (field g asm)]
    (x64-lea-rip! (mut s) reg 0)
    (eobj-add-reloc! (mut (field g obj))
                     (load (field g text))
                     (isub (x64-off (mut s)) 4)
                     symidx
                     (r-x86-64-pc32)
                     -4)
    0))

; store an AVal into a slot (any type).
(defn emit-store-av! [(g (ptr Cga)) (av AVal) (dst i64)] (-> i64)
  (let [t (alloc-stack Type)]
    (store! t (av-ty av))
    (if (ty-is-scalar t)
        (if (ty-is-float t)
            (do (av-to-d! g av 0)
                (emit-store-fp! g 0 (x-slotbase) dst (ty-float-bytes t))
                0)
            (do (av-to-x! g av (x-scratch0))
                (emit-store-int! g (x-scratch0) (x-slotbase) dst (ty-size g t))
                0))
        (emit-copy! g dst (av-slot! g av) (ty-size g t)))))

; pointee type of a TPtr/TRef value
(defn ty-pointee [(t (ptr Type))] (-> Type)
  (match-else (load t)
              (TPtr [inner] (load inner))
              (TRef [_m inner] (load inner))
              (_ (do (cgx-fail "load/store through a non-pointer") (TInt 64 true)))))

; ============================ expression emission ============================
(defn emit-body [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [n (al-len [Expr] (load body))
        (mut i) 0
        (mut last) (mk-aval 0 0 (TInt 64 true))]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (when (load (field g terminated)) (break))
                (store! last (emit-expr g (xal-at [Expr] body (load i))))
                (store! i (iadd (load i) 1)))))
    (load last)))
(defn emit-binds [(g (ptr Cga)) (binds (ptr (ArrayList Bind)))] (-> i64)
  (let [n (al-len [Bind] (load binds))
        (mut i) 0
        (mut a) (load (field g a))]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (let [b (xal-at [Bind] binds (load i))
                      av (emit-expr g (field b value))]
                  (if (load (field b mutable))
                      ; mutable: give the value a stable slot and bind the NAME to a
                      ; pointer to it (the checker reads it via (load name)).
                      (let [t (alloc-stack Type)]
                        (store! t (av-ty av))
                        (let [vslot (av-slot! g av)
                              pslot (slot-new! g 8 8)]
                          (emit-slot-addr! g (x-scratch0) vslot)
                          (emit-store-int! g (x-scratch0) (x-slotbase) pslot 8)
                          (dw-note-var! g
                                        (load (field b name))
                                        t
                                        pslot
                                        true
                                        false
                                        (load (field (field b value) source))
                                        (load (field (field b value) lo)))
                          (store! (field g env)
                                  (gscope-put (load a)
                                              (load (field g env))
                                              (load (field b name))
                                              (mk-aval 1 pslot (TPtr (box-type (load a) (av-ty av))))))
                          0))
                      (do
                        (when (icmp-eq (av-kind av) 1)
                              (dw-note-bind! g
                                             (load (field b name))
                                             av
                                             (load (field (field b value) source))
                                             (load (field (field b value) lo))))
                        (store! (field g env)
                                (gscope-put (load a) (load (field g env)) (load (field b name)) av))
                        0)))
                (store! i (iadd (load i) 1))))))
  0)

(defn emit-stmts [(g (ptr Cga)) (body (ptr (ArrayList Expr)))] (-> i64)
  (let [n (al-len [Expr] (load body))
        (mut i) 0]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (when (load (field g terminated)) (break))
                (emit-expr g (xal-at [Expr] body (load i)))
                (store! i (iadd (load i) 1))))))
  0)

; find the target loop index (labeled search from innermost, else innermost).

(defn g-loop-index [(g (ptr Cga)) (label (Option (slice u8)))] (-> i64)
  (let [n (al-len [GLoop] (load (field g loops)))]
    (match label
      (None []
            (do
              (when (icmp-eq n 0) (cgx-fail "break/continue outside a loop"))
              (isub n 1)))
      (Some [want]
            (let [(mut i) (isub n 1)
                  (mut r) -1]
              (loop (if (icmp-lt (load i) 0)
                        (break)
                        (do
                          (match (load (field (xal-at [GLoop] (field g loops) (load i)) label))
                            (None [] 0)
                            (Some [have]
                                  (when (and (icmp-lt (load r) 0) (str-eq have want)) (store! r (load i)) 0)))
                          (store! i (isub (load i) 1)))))
              (when (icmp-lt (load r) 0) (cgx-fail2 "no such loop label: " want))
              (load r))))))

; ---- memory access through a pointer register -------------------------------
(defn emit-load-from-mem! [(g (ptr Cga)) (reg i64) (addrreg i64) (bytes i64)] (-> i64)
  (let [s (field g asm)]
    (cond (icmp-eq bytes 1) (x64-movzx8-rm! (mut s) reg addrreg 0)
          (icmp-eq bytes 2) (x64-movzx16-rm! (mut s) reg addrreg 0)
          (icmp-eq bytes 4) (x64-mov32-rm! (mut s) reg addrreg 0)
          :else (x64-mov-rm! (mut s) reg addrreg 0))))
(defn emit-store-to-mem! [(g (ptr Cga)) (reg i64) (addrreg i64) (bytes i64)] (-> i64)
  (let [s (field g asm)]
    (cond (icmp-eq bytes 1) (x64-mov8-mr! (mut s) addrreg 0 reg)
          (icmp-eq bytes 2) (x64-mov16-mr! (mut s) addrreg 0 reg)
          (icmp-eq bytes 4) (x64-mov32-mr! (mut s) addrreg 0 reg)
          :else (x64-mov-mr! (mut s) addrreg 0 reg))))

; Canonicalize a narrow integer in `reg` to its declared width: shift left to
; drop the high garbage, then shift back — arithmetically when signed, so the
; sign bit replicates. Widths of 8/16/32 could use movsx/movzx, but odd widths
; (u2, i3, u7, u11 …) exist in this language and only the shift pair handles
; them, so one uniform path keeps the semantics identical for every width.
(defn emit-canon-int! [(g (ptr Cga)) (reg i64) (bits i64) (signed bool)] (-> i64)
  (let [s (field g asm)
        sh (isub 64 bits)]
    (when (icmp-gt sh 0)
          (x64-shl-imm! (mut s) reg sh)
          (if signed (x64-sar-imm! (mut s) reg sh) (x64-shr-imm! (mut s) reg sh))
          0)
    0))

; ---- binary arithmetic ------------------------------------------------------
; x86 is two-address (dst op= src), so the pattern is: lhs into rax, rhs into
; r10, operate into rax, spill. Division is the awkward one: idiv/div take the
; dividend in rdx:rax implicitly and write the quotient to rax and remainder to
; rdx, so rdx must be prepared (cqo for signed, zeroed for unsigned) and the
; divisor must live somewhere that is not rax or rdx — hence r10.
(defn emit-bin [(g (ptr Cga)) (op i64) (lhs (ptr Expr)) (rhs (ptr Expr))] (-> AVal)
  (let [lav (emit-expr g lhs)
        rav (emit-expr g rhs)
        t (alloc-stack Type)
        s (field g asm)]
    (store! t (av-ty lav))
    (if (ty-is-float t)
        ; float ops: 0 add 1 sub 2 mul 3 div 4 rem (via libm fmod)
        (let [fb (ty-float-bytes t)
              dbl (icmp-eq fb 8)]
          (av-to-d! g lav 0)
          (av-to-d! g rav 1)
          (cond (icmp-eq op 0) (x64-adds! (mut s) dbl 0 1)
                (icmp-eq op 1) (x64-subs! (mut s) dbl 0 1)
                (icmp-eq op 2) (x64-muls! (mut s) dbl 0 1)
                (icmp-eq op 3) (x64-divs! (mut s) dbl 0 1)
                (icmp-eq op 4)
                  ; frem: libm fmod(xmm0, xmm1) — the args are already in place,
                  ; and it is a variadic-free call, but al must still be sane.
                  (let [fsym (g-runtime-sym! g (if dbl "fmod" "fmodf"))
                        off (do (x64-mov-imm! (mut s) (x-scratch0) 0) (x64-call-rel32! (mut s)))]
                    (eobj-add-reloc! (mut (field g obj)) (load (field g text)) off fsym (r-x86-64-plt32) -4)
                    0)
                :else (cgx-fail "unsupported float binary op"))
          (let [slot (slot-for-ty! g t)]
            (emit-store-fp! g 0 (x-slotbase) slot fb)
            (mk-aval 1 slot (av-ty lav))))
        ; integer ops
        (let [signed (match-else (load t) (TInt [_b sg] sg) (_ false))]
          (av-to-x! g lav (x-scratch0))
          (av-to-x! g rav (x-scratch1))
          (cond (icmp-eq op 0) (x64-add-rr! (mut s) (x-scratch0) (x-scratch1))
                (icmp-eq op 1) (x64-sub-rr! (mut s) (x-scratch0) (x-scratch1))
                (icmp-eq op 2) (x64-imul-rr! (mut s) (x-scratch0) (x-scratch1))
                ; signed division: cqo sign-extends rax into rdx:rax first.
                (icmp-eq op 3)
                  (if signed
                      (do (x64-cqo! (mut s)) (x64-idiv! (mut s) (x-scratch1)))
                      (do (x64-mov-imm! (mut s) 2 0) (x64-div! (mut s) (x-scratch1))))
                ; signed remainder: the result is in rdx, so move it back to rax.
                (icmp-eq op 4)
                  (do
                    (if signed
                        (do (x64-cqo! (mut s)) (x64-idiv! (mut s) (x-scratch1)))
                        (do (x64-mov-imm! (mut s) 2 0) (x64-div! (mut s) (x-scratch1))))
                    (x64-mov-rr! (mut s) (x-scratch0) 2))
                ; ops 5/6 are the explicitly-unsigned div/rem
                (icmp-eq op 5)
                  (do (x64-mov-imm! (mut s) 2 0) (x64-div! (mut s) (x-scratch1)))
                (icmp-eq op 6)
                  (do (x64-mov-imm! (mut s) 2 0)
                      (x64-div! (mut s) (x-scratch1))
                      (x64-mov-rr! (mut s) (x-scratch0) 2))
                (icmp-eq op 7) (x64-and-rr! (mut s) (x-scratch0) (x-scratch1))
                (icmp-eq op 8) (x64-or-rr! (mut s) (x-scratch0) (x-scratch1))
                (icmp-eq op 9) (x64-xor-rr! (mut s) (x-scratch0) (x-scratch1))
                ; variable shifts read the count from cl and nowhere else.
                (icmp-eq op 10)
                  (do (x64-mov-rr! (mut s) 1 (x-scratch1)) (x64-shl-cl! (mut s) (x-scratch0)))
                (icmp-eq op 11)
                  (do (x64-mov-rr! (mut s) 1 (x-scratch1))
                      (if signed (x64-sar-cl! (mut s) (x-scratch0)) (x64-shr-cl! (mut s) (x-scratch0))))
                :else (cgx-fail "unknown integer binary op"))
          (match-else (load t)
                      (TInt [bits sg] (emit-canon-int! g (x-scratch0) bits sg))
                      (_ 0))
          (let [slot (slot-for-ty! g t)]
            (emit-store-int! g (x-scratch0) (x-slotbase) slot (ty-size g t))
            (mk-aval 1 slot (av-ty lav)))))))

; ---- comparisons ------------------------------------------------------------
; cmp sets the flags; setcc materializes a 0/1 byte; movzx widens it. The
; signed/unsigned distinction lives entirely in the condition code, and getting
; it wrong is the classic silent miscompile (the arm64 gate proved its teeth by
; catching exactly that), so the two families are spelled out separately.
(defn emit-cmp [(g (ptr Cga)) (op i64) (lhs (ptr Expr)) (rhs (ptr Expr))] (-> AVal)
  (let [lav (emit-expr g lhs)
        rav (emit-expr g rhs)
        t (alloc-stack Type)
        s (field g asm)]
    (store! t (av-ty lav))
    (if (ty-is-float t)
        ; ucomis sets CF/ZF/PF; unordered (NaN) sets PF. The ordered predicates
        ; must therefore also require PF clear, or a NaN compares as "equal".
        (let [dbl (icmp-eq (ty-float-bytes t) 8)]
          (av-to-d! g lav 0)
          (av-to-d! g rav 1)
          ; OEQ/ONE compare in the natural operand order; the inequalities below
          ; re-issue the compare with whichever order lets them use a/ae.
          (x64-ucomis! (mut s) dbl 0 1)
          (cond
            ; OEQ: equal AND ordered  -> sete && setnp
            (icmp-eq op 4)
              (do (x64-setcc-bool! (mut s) (x64-cc-e) (x-scratch0))
                  (x64-setcc-bool! (mut s) (x64-cc-np) (x-scratch1))
                  (x64-and-rr! (mut s) (x-scratch0) (x-scratch1))
                  0)
            ; ONE: not-equal AND ordered -> setne && setnp
            (icmp-eq op 5)
              (do (x64-setcc-bool! (mut s) (x64-cc-ne) (x-scratch0))
                  (x64-setcc-bool! (mut s) (x64-cc-np) (x-scratch1))
                  (x64-and-rr! (mut s) (x-scratch0) (x-scratch1))
                  0)
            ; The ordered inequalities. An UNORDERED compare (either operand
            ; NaN) leaves CF=ZF=PF=1, which makes `b` and `be` TRUE — so
            ; `setb` for OLT would answer true for NaN < 1.0, which is wrong:
            ; every ordered predicate must be false when unordered. Only `a`
            ; and `ae` are false in the unordered case, so OLT/OLE are emitted
            ; with the OPERANDS SWAPPED and tested with a/ae instead:
            ;     a  <  b   ==   b  >  a   -> ucomis b, a ; seta
            ;     a  <= b   ==   b >= a    -> ucomis b, a ; setae
            ; (the compare above put lhs in xmm0 and rhs in xmm1, so the swap
            ; is just which register goes first in the ucomis.)
            :else
              (do (if (or (icmp-eq op 0) (icmp-eq op 1))
                      (x64-ucomis! (mut s) dbl 1 0)
                      (x64-ucomis! (mut s) dbl 0 1))
                  (x64-setcc-bool! (mut s)
                                   (cond (icmp-eq op 0) (x64-cc-a)
                                         (icmp-eq op 1) (x64-cc-ae)
                                         (icmp-eq op 2) (x64-cc-a)
                                         :else (x64-cc-ae))
                                   (x-scratch0))
                  0))
          (let [slot (slot-new! g 8 8)]
            (emit-store-int! g (x-scratch0) (x-slotbase) slot 1)
            (mk-aval 1 slot (TBool))))
        (let [signed (match-else (load t) (TInt [_b sg] sg) (TBool [] false) (_ true))]
          (av-to-x! g lav (x-scratch0))
          (av-to-x! g rav (x-scratch1))
          (x64-cmp-rr! (mut s) (x-scratch0) (x-scratch1))
          (x64-setcc-bool! (mut s)
                           (cond (icmp-eq op 0) (if signed (x64-cc-l) (x64-cc-b))
                                 (icmp-eq op 1) (if signed (x64-cc-le) (x64-cc-be))
                                 (icmp-eq op 2) (if signed (x64-cc-g) (x64-cc-a))
                                 (icmp-eq op 3) (if signed (x64-cc-ge) (x64-cc-ae))
                                 (icmp-eq op 4) (x64-cc-e)
                                 :else (x64-cc-ne))
                           (x-scratch0))
          (let [slot (slot-new! g 8 8)]
            (emit-store-int! g (x-scratch0) (x-slotbase) slot 1)
            (mk-aval 1 slot (TBool)))))))

(defn emit-if [(g (ptr Cga)) (cnd (ptr Expr)) (thn (ptr Expr)) (els (ptr Expr))] (-> AVal)
  (let [cav (emit-expr g cnd)
        s (field g asm)
        lelse (x64-new-label (mut (field g asm)))
        lend (x64-new-label (mut (field g asm)))]
    (av-to-x! g cav (x-scratch0))
    (do (x64-test-rr! (mut (field g asm)) (x-scratch0) (x-scratch0))
        (x64-jcc-label! (mut (field g asm)) (x64-cc-e) lelse))
    (let [thnav (emit-expr g thn)
          thnterm (load (field g terminated))
          (mut rslot) -1
          (mut rty) (TInt 64 true)]
      (unless thnterm
              (let [tt (alloc-stack Type)]
                (store! tt (av-ty thnav))
                (store! rslot (slot-for-ty! g tt))
                (store! rty (av-ty thnav))
                (emit-store-av! g thnav (load rslot)))
              (x64-jmp-label! (mut (field g asm)) lend)
              0)
      (store! (field g terminated) false)
      (x64-bind-label! (mut (field g asm)) lelse)
      (let [elsav (emit-expr g els)
            elsterm (load (field g terminated))]
        (unless elsterm
                (let [et (alloc-stack Type)]
                  (store! et (av-ty elsav))
                  (when (icmp-lt (load rslot) 0) (store! rslot (slot-for-ty! g et)) (store! rty (av-ty elsav)) 0)
                  (emit-store-av! g elsav (load rslot)))
                0)
        (x64-bind-label! (mut (field g asm)) lend)
        (store! (field g terminated) (and thnterm elsterm))
        (if (icmp-ge (load rslot) 0)
            (mk-aval 1 (load rslot) (load rty))
            (mk-aval 0 0 (TInt 64 true)))))))

(defn emit-loop [(g (ptr Cga)) (label (Option (slice u8))) (body (ptr (ArrayList Expr)))] (-> AVal)
  (let [s (field g asm)
        contlabel (x64-new-label (mut (field g asm)))
        breaklabel (x64-new-label (mut (field g asm)))
        gl (alloc-stack GLoop)]
    (store! (field gl label) label)
    (store! (field gl contlabel) contlabel)
    (store! (field gl breaklabel) breaklabel)
    (store! (field gl resslot) -1)
    (store! (field gl resty) (TInt 64 true))
    (store! (field gl has_res) false)
    (al-push! (mut (field g loops)) (load gl))
    (x64-bind-label! (mut (field g asm)) contlabel)
    (emit-stmts g body)
    (unless (load (field g terminated)) (x64-jmp-label! (mut (field g asm)) contlabel) 0)
    ; pop the loop frame and read its break results
    (let [n (al-len [GLoop] (load (field g loops)))
          fin (al-get [GLoop] (load (field g loops)) (isub n 1))
          fp (alloc-stack GLoop)]
      (store! fp fin)
      (store! (field (field g loops) len) (isub n 1))
      (x64-bind-label! (mut (field g asm)) breaklabel)
      (if (load (field fp has_res))
          (do
            (store! (field g terminated) false)
            (mk-aval 1 (load (field fp resslot)) (load (field fp resty))))
          (do
            (store! (field g terminated) true)
            (mk-aval 0 0 (TInt 64 true)))))))

(defn emit-break [(g (ptr Cga)) (label (Option (slice u8))) (value (Option (ptr Expr)))] (-> AVal)
  (if (load (field g terminated))
      (mk-aval 0 0 (TInt 64 true))
      (let [av
              (match value
                (Some [ve] (emit-expr g ve))
                (None [] (mk-aval 0 0 (TInt 64 true))))
            li (g-loop-index g label)
            lp (xal-at [GLoop] (field g loops) li)]
        (when (icmp-lt (load (field lp resslot)) 0)
              (let [t (alloc-stack Type)]
                (store! t (av-ty av))
                (store! (field lp resslot) (slot-for-ty! g t))
                (store! (field lp resty) (av-ty av))
                (store! (field lp has_res) true))
              0)
        (emit-store-av! g av (load (field lp resslot)))
        (x64-jmp-label! (mut (field g asm)) (load (field lp breaklabel)))
        (store! (field g terminated) true)
        (mk-aval 0 0 (TInt 64 true)))))

; ---- casts ------------------------------------------------------------------
; The awkward corner on x86-64 is UNSIGNED 64-bit <-> float: the hardware only
; has signed conversions (cvtsi2sd / cvttsd2si operate on a signed i64), so a
; u64 whose top bit is set has to be handled explicitly rather than fed
; straight to the instruction. Both directions below do that, and both are
; exercised by the int-edges gate.
(defn emit-cast [(g (ptr Cga)) (t Type) (inner (ptr Expr))] (-> AVal)
  (let [av (emit-expr g inner)
        st (alloc-stack Type)
        dt (alloc-stack Type)
        s (field g asm)]
    (store! st (av-ty av))
    (store! dt t)
    (match-else t
                (TInt [dbits dsigned]
                      (if (ty-is-float st)
                          ; float -> int, truncating toward zero.
                          (let [dbl (icmp-eq (ty-float-bytes st) 8)
                                slot (slot-for-ty! g dt)]
                            (av-to-d! g av 0)
                            (if (and (not dsigned) (icmp-ge dbits 64))
                                ; u64 target: values below 2^63 convert directly;
                                ; at or above it, subtract 2^63, convert, and put
                                ; the bit back. cvttsd2si would otherwise saturate
                                ; to 0x8000000000000000 for the whole upper half.
                                (let [lbig (x64-new-label (mut s))
                                      ldone (x64-new-label (mut s))]
                                  ; xmm1 = (double)2^63, built as 2^62 + 2^62 so the
                                  ; constant itself only ever passes through a SIGNED
                                  ; conversion (2^63 has no signed i64 representation).
                                  (x64-mov-imm64! (mut s) (x-scratch1) 4611686018427387904)
                                  (x64-cvtsi2s! (mut s) dbl 1 (x-scratch1))
                                  (x64-adds! (mut s) dbl 1 1)
                                  (x64-ucomis! (mut s) dbl 0 1)
                                  (x64-jcc-label! (mut s) (x64-cc-ae) lbig)
                                  (x64-cvtts2si! (mut s) dbl (x-scratch0) 0)
                                  (x64-jmp-label! (mut s) ldone)
                                  (x64-bind-label! (mut s) lbig)
                                  (x64-subs! (mut s) dbl 0 1)
                                  (x64-cvtts2si! (mut s) dbl (x-scratch0) 0)
                                  (x64-mov-imm64! (mut s) (x-scratch1) -9223372036854775808)
                                  (x64-xor-rr! (mut s) (x-scratch0) (x-scratch1))
                                  (x64-bind-label! (mut s) ldone)
                                  0)
                                (do (x64-cvtts2si! (mut s) dbl (x-scratch0) 0)
                                    (emit-canon-int! g (x-scratch0) dbits dsigned)
                                    0))
                            (emit-store-int! g (x-scratch0) (x-slotbase) slot (ty-size g dt))
                            (mk-aval 1 slot t))
                          ; int/ptr -> int: canonicalize to the destination width
                          (let [slot (slot-for-ty! g dt)]
                            (av-to-x! g av (x-scratch0))
                            (emit-canon-int! g (x-scratch0) dbits dsigned)
                            (emit-store-int! g (x-scratch0) (x-slotbase) slot (ty-size g dt))
                            (mk-aval 1 slot t))))
                (TFloat [dbits]
                        (let [ddbl (icmp-eq dbits 64)
                              slot (slot-for-ty! g dt)]
                          (if (ty-is-float st)
                              (do
                                (av-to-d! g av 0)
                                ; cvts2s' prefix names the SOURCE width
                                (unless (icmp-eq (ty-float-bytes st) (idiv dbits 8))
                                        (x64-cvts2s! (mut s) (icmp-eq (ty-float-bytes st) 8) 0 0))
                                (emit-store-fp! g 0 (x-slotbase) slot (idiv dbits 8))
                                0)
                              ; int -> float, signedness of the SOURCE
                              (let [ssigned (match-else (load st) (TInt [_b sg] sg) (_ true))
                                    sbits (match-else (load st) (TInt [b _sg] b) (_ 64))]
                                (av-to-x! g av (x-scratch0))
                                (if (and (not ssigned) (icmp-ge sbits 64))
                                    ; u64 source: if the top bit is clear the signed
                                    ; conversion is already exact. Otherwise halve
                                    ; (with the low bit preserved so nothing rounds
                                    ; away), convert, and double back.
                                    (let [lbig (x64-new-label (mut s))
                                          ldone (x64-new-label (mut s))]
                                      (x64-cmp-ri! (mut s) (x-scratch0) 0)
                                      (x64-jcc-label! (mut s) (x64-cc-l) lbig)
                                      (x64-cvtsi2s! (mut s) ddbl 0 (x-scratch0))
                                      (x64-jmp-label! (mut s) ldone)
                                      (x64-bind-label! (mut s) lbig)
                                      (x64-mov-rr! (mut s) (x-scratch1) (x-scratch0))
                                      (x64-shr-imm! (mut s) (x-scratch1) 1)
                                      (x64-mov-rr! (mut s) (x-scratch2) (x-scratch0))
                                      (x64-and-ri! (mut s) (x-scratch2) 1)
                                      (x64-or-rr! (mut s) (x-scratch1) (x-scratch2))
                                      (x64-cvtsi2s! (mut s) ddbl 0 (x-scratch1))
                                      (x64-adds! (mut s) ddbl 0 0)
                                      (x64-bind-label! (mut s) ldone)
                                      0)
                                    (do (x64-cvtsi2s! (mut s) ddbl 0 (x-scratch0)) 0))
                                (emit-store-fp! g 0 (x-slotbase) slot (idiv dbits 8))
                                0))
                          (mk-aval 1 slot t)))
                (_  ; ptr / fnptr targets: bit-identical 8-byte move
                   (let [slot (slot-for-ty! g dt)]
                     (av-to-x! g av (x-scratch0))
                     (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                     (mk-aval 1 slot t))))))

(defn emit-construct [(g (ptr Cga)) (sum (slice u8)) (variant (slice u8)) (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [su (g-sum-idx g sum)]
    (when (icmp-lt su 0) (cgx-fail2 "construct of unknown sum: " sum))
    (let [vidx (g-variant-idx g su variant)
          sumty (alloc-stack Type)]
      (store! sumty (TStruct sum))
      (let [slot (slot-for-ty! g sumty)
            vs (load (field (sum-at (field g layouts) su) variants))
            vfields (load (field (xal-at [Variant] vs vidx) fields))
            n (al-len [Expr] (load args))
            (mut i) 0]
        ; tag (i32 at offset 0)
        (x64-mov-imm! (mut (field g asm)) (x-scratch0) vidx)
        (emit-store-int! g (x-scratch0) (x-slotbase) slot 4)
        ; payload fields at their natural offsets within the variant struct
        (loop (if (icmp-ge (load i) n)
                  (break)
                  (do
                    (let [av (emit-expr g (xal-at [Expr] args (load i)))
                          off (g-natural-off g vfields (load i))]
                      (emit-store-av-at! g av (iadd (iadd slot 8) off)))
                    (store! i (iadd (load i) 1)))))
        (mk-aval 1 slot (TStruct sum))))))

; store an AVal at an absolute slot byte offset (may be unaligned-in-slot for
; sub-slot fields — offsets are still 1/2/4/8-aligned by construction).

(defn emit-store-av-at! [(g (ptr Cga)) (av AVal) (dst i64)] (-> i64)
  (let [t (alloc-stack Type)]
    (store! t (av-ty av))
    (if (ty-is-scalar t)
        (do
          (av-to-x! g av (x-scratch0))
          (emit-store-int! g (x-scratch0) (x-slotbase) dst (ty-size g t))
          0)
        (emit-copy! g dst (av-slot! g av) (ty-size g t)))))

(defn g-runtime-sym! [(g (ptr Cga)) (nm (slice u8))] (-> i64)
  (let [n (al-len [ESym] (load (field (field g obj) syms)))
        (mut i) 0
        (mut r) -1]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (when (str-eq (load (field (xal-at [ESym] (field (field g obj) syms) (load i)) name)) nm)
                      (store! r (load i)))
                (store! i (iadd (load i) 1)))))
    (if (icmp-ge (load r) 0)
        (load r)
        (eobj-add-sym! (mut (field g obj)) nm 0 0 true))))

; memory load/store with a dynamic address register (widths 1/2/4/8)

(defn emit-match [(g (ptr Cga)) (scrut (ptr Expr)) (arms (ptr (ArrayList Arm)))] (-> AVal)
  (let [sav (emit-expr g scrut)
        t (alloc-stack Type)
        s (field g asm)
        a (load (field g a))]
    (store! t (av-ty sav))
    (let [sumname (match-else (load t) (TStruct [nm] nm) (_ ""))
          su (g-sum-idx g sumname)]
      (when (icmp-lt su 0) (cgx-fail2 "match on non-sum: " sumname))
      (let [sslot (av-slot! g sav)
            vs (load (field (sum-at (field g layouts) su) variants))
            narms (al-len [Arm] (load arms))
            lend (x64-new-label (mut (field g asm)))
            (mut armlabels) (al-new [i64] a)
            (mut rslot) -1
            (mut rty) (TInt 64 true)
            (mut anylive) false]
        ; tag -> x9, then the compare/branch chain
        (emit-load-int! g (x-scratch0) (x-slotbase) sslot 4 false)
        (let [(mut i) 0]
          (loop (if (icmp-ge (load i) narms)
                    (break)
                    (do
                      (let [arm (xal-at [Arm] arms (load i))
                            vidx (g-variant-idx g su (load (field arm variant)))
                            lab (x64-new-label (mut (field g asm)))]
                        (al-push! (mut armlabels) lab)
                        (x64-mov-imm! (mut (field g asm)) (x-scratch1) vidx)
                        (x64-cmp-rr! (mut s) (x-scratch0) (x-scratch1))
                        (x64-jcc-label! (mut (field g asm)) (x64-cc-e) lab))
                      (store! i (iadd (load i) 1))))))
        ; no arm matched: unreachable (mirrors the LLVM switch default)
        (x64-ud2! (mut s))
        ; arms
        (let [(mut i) 0]
          (loop (if (icmp-ge (load i) narms)
                    (break)
                    (do
                      (let [arm (xal-at [Arm] arms (load i))
                            vidx (g-variant-idx g su (load (field arm variant)))
                            vfields (load (field (xal-at [Variant] vs vidx) fields))
                            saved (load (field g env))]
                        (x64-bind-label! (mut (field g asm)) (al-get [i64] (load armlabels) (load i)))
                        (store! (field g terminated) false)
                        ; bind payload fields BY VALUE into fresh slots
                        (let [binds (load (field arm binds))
                              nb (al-len [(slice u8)] (load binds))
                              (mut j) 0]
                          (loop (if (icmp-ge (load j) nb)
                                    (break)
                                    (do
                                      (let [fty (load (field (xal-at [Field] vfields (load j)) ty))
                                            ftp (alloc-stack Type)]
                                        (store! ftp fty)
                                        (let [foff (g-natural-off g vfields (load j))
                                              bslot (slot-for-ty! g ftp)]
                                          (emit-copy! g bslot (iadd (iadd sslot 8) foff) (ty-size g ftp))
                                          (store! (field g env)
                                                  (gscope-put a
                                                              (load (field g env))
                                                              (al-get [(slice u8)] (load binds) (load j))
                                                              (mk-aval 1 bslot fty)))))
                                      (store! j (iadd (load j) 1))))))
                        (let [bav (emit-expr g (field arm body))]
                          (store! (field g env) saved)
                          (unless (load (field g terminated))
                                  (when (icmp-lt (load rslot) 0)
                                        (let [bt (alloc-stack Type)]
                                          (store! bt (av-ty bav))
                                          (store! rslot (slot-for-ty! g bt))
                                          (store! rty (av-ty bav)))
                                        0)
                                  (emit-store-av! g bav (load rslot))
                                  (store! anylive true)
                                  (x64-jmp-label! (mut (field g asm)) lend)
                                  0)))
                      (store! i (iadd (load i) 1))))))
        (x64-bind-label! (mut (field g asm)) lend)
        (if (load anylive)
            (do
              (store! (field g terminated) false)
              (mk-aval 1 (load rslot) (load rty)))
            (do
              (store! (field g terminated) true)
              (mk-aval 0 0 (TInt 64 true))))))))

(defn emit-call-named [(g (ptr Cga)) (func (slice u8)) (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [si (g-sig-idx g func)]
    (when (icmp-lt si 0) (cgx-fail2 "call to unknown function: " func))
    (let [e (xal-at [GSig] (field g sigs) si)
          (mut avs) (al-new [AVal] (load (field g a)))
          n (al-len [Expr] (load args))
          (mut i) 0
          dummy (alloc-stack AVal)]
      (loop (if (icmp-ge (load i) n)
                (break)
                (do
                  (al-push! (mut avs) (emit-expr g (xal-at [Expr] args (load i))))
                  (store! i (iadd (load i) 1)))))
      (store! dummy (mk-aval 0 0 (TInt 64 true)))
      (if (load (field e shim))
          ; register-constrained call: args in the convention's registers,
          ; result read back from its return register.
          (let [s (field g asm)
                regs (load (field e shimregs))
                (mut slots) (al-new [i64] (load (field g a)))
                (mut j) 0]
            (loop (if (icmp-ge (load j) n)
                      (break)
                      (do
                        (al-push! (mut slots) (av-slot! g (al-get [AVal] (load avs) (load j))))
                        (store! j (iadd (load j) 1)))))
            (store! j 0)
            (loop (if (icmp-ge (load j) n)
                      (break)
                      (do
                        (emit-load-int! g
                                        (al-get [i64] (load regs) (load j))
                                        (x-slotbase)
                                        (al-get [i64] (load slots) (load j))
                                        8
                                        false)
                        (store! j (iadd (load j) 1)))))
            (let [coff (x64-call-rel32! (mut s))]
              (eobj-add-reloc! (mut (field g obj))
                               (load (field g text))
                               coff
                               (load (field e symidx))
                               (r-x86-64-plt32)
                               -4))
            (let [retp (alloc-stack Type)]
              (store! retp (load (field e ret)))
              (if (match-else (load (field e ret)) (TVoid [] true) (_ false))
                  (mk-aval 0 0 (TInt 64 true))
                  (let [slot (slot-for-ty! g retp)]
                    (emit-store-int! g (load (field e shimret)) (x-slotbase) slot (ty-size g retp))
                    (mk-aval 1 slot (load (field e ret)))))))
          ; an extern call crosses the C boundary, so it takes the SysV
          ; by-value aggregate rules; a Coil-to-Coil call does not.
          (emit-call-abi! g
                          (load (field e symidx))
                          dummy
                          (load (field e params))
                          (load (field e variadic))
                          (load (field e ret))
                          (box-al [AVal] (load (field g a)) (load avs))
                          (load (field e isc)))))))

(defn emit-bitget [(g (ptr Cga)) (p (ptr Expr)) (fname (slice u8))] (-> AVal)
  (let [av (emit-expr g p)
        t (alloc-stack Type)
        s (field g asm)]
    (store! t (av-ty av))
    (let [pt (alloc-stack Type)]
      (store! pt (ty-pointee t))
      (match-else (load pt)
                  (TStruct [nm]
                           (let [low (alloc-stack i64)
                                 width (alloc-stack i64)
                                 signed (alloc-stack bool)
                                 back (alloc-stack i64)]
                             (g-bits-info g nm fname low width signed back)
                             (av-to-x! g av (x-scratch0))
                             (emit-load-from-mem! g (x-scratch0) (x-scratch0) (idiv (load back) 8))
                             (when (icmp-gt (load low) 0) (x64-shr-imm! (mut s) (x-scratch0) (load low)))
                             ; mask/sign-extend to the field width via a shift pair:
                             ; left to drop the high bits, then right — arithmetically
                             ; when the field is signed so the sign bit replicates.
                             (when (icmp-lt (load width) 64)
                                   (x64-shl-imm! (mut s) (x-scratch0) (isub 64 (load width)))
                                   (if (load signed)
                                       (x64-sar-imm! (mut s) (x-scratch0) (isub 64 (load width)))
                                       (x64-shr-imm! (mut s) (x-scratch0) (isub 64 (load width))))
                                   0)
                             (let [fty (if (icmp-eq (load width) 1) (TBool) (TInt (load width) (load signed)))
                                   ftp (alloc-stack Type)]
                               (store! ftp fty)
                               (let [slot (slot-for-ty! g ftp)]
                                 (emit-store-int! g (x-scratch0) (x-slotbase) slot (ty-size g ftp))
                                 (mk-aval 1 slot fty)))))
                  (_ (do (cgx-fail "bit-get through non-struct pointer") (mk-aval 0 0 (TInt 64 true))))))))

(defn emit-bitset [(g (ptr Cga)) (p (ptr Expr)) (fname (slice u8)) (val (ptr Expr))] (-> AVal)
  (let [pav (emit-expr g p)
        vav (emit-expr g val)
        t (alloc-stack Type)
        s (field g asm)]
    (store! t (av-ty pav))
    (let [pt (alloc-stack Type)]
      (store! pt (ty-pointee t))
      (match-else (load pt)
                  (TStruct [nm]
                           (let [low (alloc-stack i64)
                                 width (alloc-stack i64)
                                 signed (alloc-stack bool)
                                 back (alloc-stack i64)]
                             (g-bits-info g nm fname low width signed back)
                             ; r11 = container address, r10 = the container word,
                             ; rax/rcx = the mask and value temporaries. The container
                             ; address must survive the whole sequence, so it lives in
                             ; r11 (never touched by the mask arithmetic below).
                             (av-to-x! g pav (x-scratch2))
                             (emit-load-from-mem! g (x-scratch1) (x-scratch2) (idiv (load back) 8))
                             (let [fieldmask (if (icmp-ge (load width) 64) -1 (isub (ishl 1 (load width)) 1))]
                               ; rax = ~(fieldmask << low); clear the field in place
                               (x64-mov-imm! (mut s) (x-scratch0) (ishl fieldmask (load low)))
                               (x64-not! (mut s) (x-scratch0))
                               (x64-and-rr! (mut s) (x-scratch1) (x-scratch0))
                               ; rcx = (value & fieldmask) << low
                               (av-to-x! g vav 1)
                               (x64-mov-imm! (mut s) (x-scratch0) fieldmask)
                               (x64-and-rr! (mut s) 1 (x-scratch0))
                               (when (icmp-gt (load low) 0) (x64-shl-imm! (mut s) 1 (load low)))
                               (x64-or-rr! (mut s) (x-scratch1) 1)
                               (emit-store-to-mem! g (x-scratch1) (x-scratch2) (idiv (load back) 8))
                               vav)))
                  (_ (do (cgx-fail "bit-set through non-struct pointer") (mk-aval 0 0 (TInt 64 true))))))))

(defn emit-make-dyn [(g (ptr Cga))
                     (ds (slice u8))
                     (_vt (slice u8))
                     (methods (ptr (ArrayList (slice u8))))
                     (inner (ptr Expr))] (-> AVal)
  (let [a (load (field g a))
        buf (eobj-sect-buf (mut (field g obj)) (load (field g datasec)))]
    ; the vtable: one 8-byte relocated function pointer per method
    (xb-align! (mut buf) 8)
    (let [vtoff (al-len [u8] (load buf))
          nm (sconcat a "l_vtable." (i64->str a (load (field g nglob))))]
      (store! (field g nglob) (iadd (load (field g nglob)) 1))
      (let [n (al-len [(slice u8)] (load methods))
            (mut i) 0]
        (loop (if (icmp-ge (load i) n)
                  (break)
                  (do
                    (let [mnm (al-get [(slice u8)] (load methods) (load i))
                          msi (g-sig-idx g mnm)]
                      (when (icmp-lt msi 0) (cgx-fail2 "make-dyn: unknown method " mnm))
                      ; a vtable slot is an absolute 64-bit pointer to the method,
                      ; so it takes an R_X86_64_64 with a zero addend.
                      (eobj-add-reloc! (mut (field g obj))
                                       (load (field g datasec))
                                       (al-len [u8] (load buf))
                                       (load (field (xal-at [GSig] (field g sigs) msi) symidx))
                                       (r-x86-64-64)
                                       0)
                      (xb-u64! (mut buf) 0))
                    (store! i (iadd (load i) 1))))))
      (let [vtsym (eobj-add-sym! (mut (field g obj)) nm (load (field g datasec)) vtoff false)
            iav (emit-expr g inner)
            slot (slot-new! g 16 8)]
        ; dyn object { data, vtable } by value
        (av-to-x! g iav (x-scratch0))
        (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
        (emit-sym-addr! g (x-scratch0) vtsym)
        (emit-store-int! g (x-scratch0) (x-slotbase) (iadd slot 8) 8)
        (mk-aval 1 slot (TStruct ds))))))

(defn emit-dyn-dispatch [(g (ptr Cga))
                         (_ds (slice u8))
                         (_vt (slice u8))
                         (mi i64)
                         (_cc (slice u8))
                         (params (ptr (ArrayList Type)))
                         (ret Type)
                         (recv (ptr Expr))
                         (args (ptr (ArrayList Expr)))] (-> AVal)
  (let [a (load (field g a))
        rav (emit-expr g recv)
        rslot (av-slot! g rav)
        ; fnptr = vtable[mi]
        fpslot (slot-new! g 8 8)
        dataslot (slot-new! g 8 8)]
    ; data ptr
    (emit-load-int! g (x-scratch0) (x-slotbase) rslot 8 false)
    (emit-store-int! g (x-scratch0) (x-slotbase) dataslot 8)
    ; vtable -> method fnptr
    (emit-load-int! g (x-scratch0) (x-slotbase) (iadd rslot 8) 8 false)
    (x64-mov-rm! (mut (field g asm)) (x-scratch0) (x-scratch0) (imul mi 8))
    (emit-store-int! g (x-scratch0) (x-slotbase) fpslot 8)
    ; assemble [data, args...] and the full param list [ptr, params...]
    (let [(mut avs) (al-new [AVal] a)
          (mut ptys) (al-new [Type] a)
          fpav (alloc-stack AVal)]
      (al-push! (mut ptys) (TPtr (box-type a (TInt 8 true))))
      (let [np (al-len [Type] (load params))
            (mut i) 0]
        (loop (if (icmp-ge (load i) np)
                  (break)
                  (do
                    (al-push! (mut ptys) (al-get [Type] (load params) (load i)))
                    (store! i (iadd (load i) 1))))))
      (al-push! (mut avs) (mk-aval 1 dataslot (TPtr (box-type a (TInt 8 true)))))
      (let [na (al-len [Expr] (load args))
            (mut i) 0]
        (loop (if (icmp-ge (load i) na)
                  (break)
                  (do
                    (al-push! (mut avs) (emit-expr g (xal-at [Expr] args (load i))))
                    (store! i (iadd (load i) 1))))))
      (store! fpav (mk-aval 1 fpslot (TFn "c" (box-al [Type] a (load ptys)) (box-type a ret))))
      (emit-call! g
                  -1
                  fpav
                  (box-al [Type] a (load ptys))
                  false
                  ret
                  (box-al [AVal] a (load avs))))))

; parse a (possibly negative) decimal integer token — llvm-ir literals.
(defn emit-expr [(g (ptr Cga)) (e (ptr Expr))] (-> AVal)
  (dw-note-span! g e)
  (match (load (field e kind))
    (EInt [v] (mk-aval 0 v (TInt 64 true)))
    (EFloat [bits] (mk-aval 2 bits (TFloat 64)))
    (EBool [b] (mk-aval 0 (when b 1) (TBool)))
    (EStr [sv]
          (let [sym (g-intern-str! g sv true)  ; NUL-terminate the backing bytes (slice len below is separate)
                a (load (field g a))
                slot (slot-new! g 16 8)]
            (emit-sym-addr! g (x-scratch0) sym)
            (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
            (x64-mov-imm! (mut (field g asm)) (x-scratch0) (slice-len sv))
            (emit-store-int! g (x-scratch0) (x-slotbase) (iadd slot 8) 8)
            (mk-aval 1 slot (TSlice (box-type a (TInt 8 false))))))
    (ECStr [sv]
           (let [sym (g-intern-str! g sv true)
                 a (load (field g a))
                 slot (slot-new! g 8 8)]
             (emit-sym-addr! g (x-scratch0) sym)
             (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
             (mk-aval 1 slot (TPtr (box-type a (TInt 8 true))))))
    (EVar [name]
          (match (gscope-get (load (field g env)) name)
            (Some [av] av)
            (None [] (do (cgx-fail2 "unbound variable: " name) (mk-aval 0 0 (TInt 64 true))))))
    (EZeroed [t]
             (let [tp (alloc-stack Type)]
               (store! tp t)
               (let [slot (slot-for-ty! g tp)]
                 (emit-zero! g slot (ty-size g tp))
                 (mk-aval 1 slot t))))
    (EBorrow [_m place] (emit-expr g place))
    (ESpillRef [inner]
               (let [av (emit-expr g inner)
                     a (load (field g a))
                     vslot (av-slot! g av)
                     pslot (slot-new! g 8 8)]
                 (emit-slot-addr! g (x-scratch0) vslot)
                 (emit-store-int! g (x-scratch0) (x-slotbase) pslot 8)
                 (mk-aval 1 pslot (TPtr (box-type a (av-ty av))))))
    (ELet [binds body]
          (let [saved (load (field g env))]
            (emit-binds g binds)
            (let [r (emit-body g body)]
              (store! (field g env) saved)
              r)))
    (EDo [body] (emit-body g body))
    (EBin [op lhs rhs] (emit-bin g op lhs rhs))
    (ECmp [op lhs rhs] (emit-cmp g op lhs rhs))
    (ENot [inner]
          (let [av (emit-expr g inner)
                t (alloc-stack Type)]
            (store! t (av-ty av))
            (av-to-x! g av (x-scratch0))
            (if (match-else (load t) (TBool [] true) (_ false))
                (do
                  (x64-mov-imm! (mut (field g asm)) (x-scratch1) 1)
                  (x64-xor-rr! (mut (field g asm)) (x-scratch0) (x-scratch1))
                  0)
                (do (x64-not! (mut (field g asm)) (x-scratch0)) 0))
            (let [slot (slot-for-ty! g t)]
              (emit-store-int! g (x-scratch0) (x-slotbase) slot (ty-size g t))
              (mk-aval 1 slot (av-ty av)))))
    (EIf [cnd thn els] (emit-if g cnd thn els))
    (ELoop [label body] (emit-loop g label body))
    (EBreak [label value] (emit-break g label value))
    (EContinue [label]
               (do
                 (let [li (g-loop-index g label)]
                   (x64-jmp-label! (mut (field g asm)) (load (field (xal-at [GLoop] (field g loops) li) contlabel)))
                   (store! (field g terminated) true))
                 (mk-aval 0 0 (TInt 64 true))))
    (ECall [func _targs args] (emit-call-named g func args))
    (ECallPtr [fp args]
              (let [fpav (alloc-stack AVal)]
                (store! fpav (emit-expr g fp))
                (let [t (alloc-stack Type)]
                  (store! t (av-ty (load fpav)))
                  (match-else (load t)
                              (TFn [_cc params ret]
                                   (let [(mut avs) (al-new [AVal] (load (field g a)))
                                         n (al-len [Expr] (load args))
                                         (mut i) 0]
                                     (loop (if (icmp-ge (load i) n)
                                               (break)
                                               (do
                                                 (al-push! (mut avs) (emit-expr g (xal-at [Expr] args (load i))))
                                                 (store! i (iadd (load i) 1)))))
                                     (emit-call! g
                                                 -1
                                                 fpav
                                                 params
                                                 false
                                                 (load ret)
                                                 (box-al [AVal] (load (field g a)) (load avs)))))
                              (_ (do
                                   (cgx-fail "call-ptr on non-fnptr value")
                                   (mk-aval 0 0 (TInt 64 true))))))))
    (EAlloc [storage t]
            (let [a (load (field g a))
                  tp (alloc-stack Type)]
              (store! tp t)
              (if (icmp-eq storage 0)
                  ; stack: a per-function-execution frame slot
                  (let [slot (slot-for-ty! g tp)
                        pslot (slot-new! g 8 8)]
                    (emit-slot-addr! g (x-scratch0) slot)
                    (emit-store-int! g (x-scratch0) (x-slotbase) pslot 8)
                    (mk-aval 1 pslot (TPtr (box-type a t))))
                  (if (icmp-eq storage 2)
                      ; heap: call malloc(size)
                      ; ELF/Linux libc symbols carry no leading underscore
                      ; (that is the Mach-O convention), and the size argument
                      ; goes in rdi under SysV.
                      (let [msym (g-runtime-sym! g "malloc")
                            slot (slot-new! g 8 8)]
                        (x64-mov-imm! (mut (field g asm)) 7 (ty-size g tp))
                        (let [coff (x64-call-rel32! (mut (field g asm)))]
                          (eobj-add-reloc! (mut (field g obj))
                                           (load (field g text))
                                           coff
                                           msym
                                           (r-x86-64-plt32)
                                           -4))
                        (emit-store-int! g 0 (x-slotbase) slot 8)
                        (mk-aval 1 slot (TPtr (box-type a t))))
                      ; static: zeroed global
                      (let [sym (g-zero-global! g (ty-size g tp) (ty-align g tp))
                            pslot (slot-new! g 8 8)]
                        (emit-sym-addr! g (x-scratch0) sym)
                        (emit-store-int! g (x-scratch0) (x-slotbase) pslot 8)
                        (mk-aval 1 pslot (TPtr (box-type a t))))))))
    (EField [p fname]
            (let [av (emit-expr g p)
                  a (load (field g a))
                  t (alloc-stack Type)]
              (store! t (av-ty av))
              (let [pt (alloc-stack Type)]
                (store! pt (ty-pointee t))
                (match-else (load pt)
                            (TStruct [nm]
                                     (let [si (g-struct-idx g nm)]
                                       (when (icmp-lt si 0) (cgx-fail2 "field access on non-struct: " nm))
                                       (let [fi (g-field-idx g si fname)
                                             off (g-field-off g si fi)
                                             fty
                                               (load (field (xal-at [Field]
                                                                   (load (field (struct-at (field g layouts) si)
                                                                                fields))
                                                                   fi)
                                                            ty))
                                             slot (slot-new! g 8 8)]
                                         (av-to-x! g av (x-scratch0))
                                         (if (icmp-le off 4095)
                                             (x64-add-ri! (mut (field g asm)) (x-scratch0) off)
                                             (do
                                               (x64-mov-imm! (mut (field g asm)) (x-scratch1) off)
                                               (x64-add-rr! (mut (field g asm)) (x-scratch0) (x-scratch1))
                                               0))
                                         (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                                         (mk-aval 1 slot (TPtr (box-type a fty))))))
                            (_ (do
                                 (cgx-fail "field access through non-struct pointer")
                                 (mk-aval 0 0 (TInt 64 true))))))))
    (ELoad [inner]
           (let [av (emit-expr g inner)
                 a (load (field g a))
                 t (alloc-stack Type)]
             (store! t (av-ty av))
             (let [pt (alloc-stack Type)]
               (store! pt (ty-pointee t))
               (let [sz (ty-size g pt)
                     slot (slot-for-ty! g pt)]
                 (av-to-x! g av (x-scratch0))
                 (if (icmp-le sz 8)
                     (do
                       (emit-load-from-mem! g (x-scratch1) (x-scratch0) sz)
                       (emit-store-int! g (x-scratch1) (x-slotbase) slot sz)
                       0)
                     (emit-copy-from-mem! g slot (x-scratch0) sz))
                 (mk-aval 1 slot (load pt))))))
    (EStore [p val]
            (let [pav (emit-expr g p)
                  vav (emit-expr g val)
                  t (alloc-stack Type)]
              (store! t (av-ty vav))
              (let [sz (ty-size g t)]
                (if (ty-is-scalar t)
                    (do
                      (av-to-x! g vav (x-scratch1))
                      (av-to-x! g pav (x-scratch0))
                      (emit-store-to-mem! g (x-scratch1) (x-scratch0) sz)
                      0)
                    (do
                      (av-to-x! g pav (x-scratch0))
                      (emit-copy-to-mem! g (x-scratch0) (av-slot! g vav) sz)
                      0))
                ; std-12: store! yields unit (canonical i64 0), matching its checked type.
                (mk-aval 0 0 (TInt 64 true)))))
    (EIndex [p idx]
            (let [pav (emit-expr g p)
                  iav (emit-expr g idx)
                  a (load (field g a))
                  t (alloc-stack Type)]
              (store! t (av-ty pav))
              (let [pt (alloc-stack Type)]
                (store! pt (ty-pointee t))
                ; pointer-to-array indexes elements of the array; otherwise the pointee
                (let [ep (alloc-stack Type)]
                  (match-else (load pt)
                              (TArray [elem _n] (store! ep (load elem)))
                              (_ (store! ep (load pt))))
                  (let [esz (ty-size g ep)
                        slot (slot-new! g 8 8)]
                    (av-to-x! g pav (x-scratch0))
                    (av-to-x! g iav (x-scratch1))
                    (x64-mov-imm! (mut (field g asm)) (x-scratch2) esz)
                    (do (x64-imul-rr! (mut (field g asm)) (x-scratch1) (x-scratch2))
                         (x64-add-rr! (mut (field g asm)) (x-scratch0) (x-scratch1)) 0)
                    (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                    (mk-aval 1 slot (TPtr (box-type a (load ep)))))))))
    (ECast [t inner] (emit-cast g t inner))
    (ESizeOf [t]
             (let [tp (alloc-stack Type)] (store! tp t) (mk-aval 0 (ty-size g tp) (TInt 64 true))))
    (EAlignOf [t]
              (let [tp (alloc-stack Type)] (store! tp t) (mk-aval 0 (ty-align g tp) (TInt 64 true))))
    (EOffsetOf [t fname]
               (let [tp (alloc-stack Type)]
                 (store! tp t)
                 (match-else t
                             (TStruct [nm]
                                      (let [si (g-struct-idx g nm)]
                                        (when (icmp-lt si 0) (cgx-fail2 "offset-of on non-struct: " nm))
                                        (mk-aval 0 (g-field-off g si (g-field-idx g si fname)) (TInt 64 true))))
                             (_ (do (cgx-fail "offset-of on non-struct type") (mk-aval 0 0 (TInt 64 true)))))))
    (EFree [inner]
           (let [av (emit-expr g inner)
                 fsym (g-runtime-sym! g "free")]
             ; SysV passes the pointer in rdi, not x0.
             (av-to-x! g av 7)
             (let [coff (x64-call-rel32! (mut (field g asm)))]
               (eobj-add-reloc! (mut (field g obj))
                                (load (field g text))
                                coff
                                fsym
                                (r-x86-64-plt32)
                                -4))
             (mk-aval 0 0 (TInt 64 true))))
    (EConstruct [sum variant args] (emit-construct g sum variant args))
    (EMatch [scrut arms] (emit-match g scrut arms))
    (EFnPtrOf [name]
              (let [si (g-sig-idx g name)]
                (when (icmp-lt si 0) (cgx-fail2 "fnptr-of unknown function: " name))
                (let [e (xal-at [GSig] (field g sigs) si)
                      slot (slot-new! g 8 8)]
                  (emit-sym-addr! g (x-scratch0) (load (field e symidx)))
                  (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                  (mk-aval 1
                           slot
                           (TFn "c" (load (field e params)) (box-type (load (field g a)) (load (field e ret))))))))
    (EBitGet [p fname] (emit-bitget g p fname))
    (EBitSet [p fname val] (emit-bitset g p fname val))
    (ELlvmIr [result args body] (emit-llvmir g result args body))
    (EMakeDyn [ds vt methods inner] (emit-make-dyn g ds vt methods inner))
    (EDynDispatch [ds vt mi cc params ret recv args] (emit-dyn-dispatch g ds vt mi cc params ret recv args))
    (EStaticRef [name]
                (do
                  (cgx-fail2 "static-ref unsupported (statics are never populated): " name)
                  (mk-aval 0 0 (TInt 64 true))))
    (EErase [_t _i] (do (cgx-fail "EErase reached codegen (checker bug)") (mk-aval 0 0 (TInt 64 true))))
    (ETraitCall [_a _b _c _d] (do (cgx-fail "ETraitCall reached codegen (mono bug)") (mk-aval 0 0 (TInt 64 true))))
    (EComptime [_] (do (cgx-fail "EComptime reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (EAscribe [_t _i]
              (do
                (cgx-fail "EAscribe reached codegen (checker should have lowered (: v t) to its coerced value)")
                (mk-aval 0 0 (TInt 64 true))))
    (ETypeQuery [_q _t] (do (cgx-fail "ETypeQuery reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (EFieldMeta [_m _t _i] (do (cgx-fail "EFieldMeta reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (EFieldIndex [_t _n] (do (cgx-fail "EFieldIndex reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (EQuote [_] (do (cgx-fail "EQuote reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (ECodeOp [_o _a] (do (cgx-fail "ECodeOp reached codegen") (mk-aval 0 0 (TInt 64 true))))
    (EQuasi [_] (do (cgx-fail "EQuasi reached codegen") (mk-aval 0 0 (TInt 64 true))))))

; lazily-declared runtime symbols (malloc/free used by EAlloc heap / EFree).

(defn g-bits-info [(g (ptr Cga))
                   (nm (slice u8))
                   (fname (slice u8))
                   (lowp (ptr i64))
                   (widthp (ptr i64))
                   (signedp (ptr bool))
                   (backp (ptr i64))] (-> i64)
  (let [si (g-struct-idx g nm)]
    (when (icmp-lt si 0) (cgx-fail2 "bit access on unknown struct: " nm))
    (let [e (struct-at (field g layouts) si)]
      (match-else (load (field e layout))
                  (LBits [backing offs]
                         (let [fi (g-field-idx g si fname)]
                           (store! lowp (al-get [i64] (load offs) fi))
                           (store! backp backing)
                           (match-else (load (field (xal-at [Field] (load (field e fields)) fi) ty))
                                       (TInt [bits sg] (do (store! widthp bits) (store! signedp sg) 0))
                                       (TBool [] (do (store! widthp 1) (store! signedp false) 0))
                                       (_ (cgx-fail "bit-struct field with non-int type")))))
                  (_ (cgx-fail2 "bit access on non-bits struct: " nm))))))

(defn dw-ty-of! [(g (ptr Cga)) (t (ptr Type))] (-> i64)
  (let [a (load (field g a))
        nm (dw-ty-name g t)
        hit (dw-find-ty g nm)]
    (if (icmp-ge hit 0)
        hit
        (match-else (load t)
                    (TInt [bits sg]
                          (let [e (alloc-stack DwTy)]
                            (store! (field e kind) 0)
                            (store! (field e name) nm)
                            (store! (field e size) (ty-size g t))
                            (store! (field e enc) (if sg 5 7))
                            (store! (field e to) -1)
                            (store! (field e count) 0)
                            (store! (field e off) 0)
                            (store! (field e fields) (al-new [DwField] a))
                            (al-push! (mut (field g dwtys)) (load e))
                            (isub (al-len [DwTy] (load (field g dwtys))) 1)))
                    (TBool []
                           (let [e (alloc-stack DwTy)]
                             (store! (field e kind) 0)
                             (store! (field e name) nm)
                             (store! (field e size) 1)
                             (store! (field e enc) 2)
                             (store! (field e to) -1)
                             (store! (field e count) 0)
                             (store! (field e off) 0)
                             (store! (field e fields) (al-new [DwField] a))
                             (al-push! (mut (field g dwtys)) (load e))
                             (isub (al-len [DwTy] (load (field g dwtys))) 1)))
                    (TFloat [bits]
                            (let [e (alloc-stack DwTy)]
                              (store! (field e kind) 0)
                              (store! (field e name) nm)
                              (store! (field e size) (idiv bits 8))
                              (store! (field e enc) 4)
                              (store! (field e to) -1)
                              (store! (field e count) 0)
                              (store! (field e off) 0)
                              (store! (field e fields) (al-new [DwField] a))
                              (al-push! (mut (field g dwtys)) (load e))
                              (isub (al-len [DwTy] (load (field g dwtys))) 1)))
                    (TPtr [inner]
                          (let [ti (dw-ty-of! g inner)
                                e (alloc-stack DwTy)]
                            (store! (field e kind) 1)
                            (store! (field e name) nm)
                            (store! (field e size) 8)
                            (store! (field e enc) 0)
                            (store! (field e to) ti)
                            (store! (field e count) 0)
                            (store! (field e off) 0)
                            (store! (field e fields) (al-new [DwField] a))
                            (al-push! (mut (field g dwtys)) (load e))
                            (isub (al-len [DwTy] (load (field g dwtys))) 1)))
                    (TRef [_m inner]
                          (let [ti (dw-ty-of! g inner)
                                e (alloc-stack DwTy)]
                            (store! (field e kind) 1)
                            (store! (field e name) nm)
                            (store! (field e size) 8)
                            (store! (field e enc) 0)
                            (store! (field e to) ti)
                            (store! (field e count) 0)
                            (store! (field e off) 0)
                            (store! (field e fields) (al-new [DwField] a))
                            (al-push! (mut (field g dwtys)) (load e))
                            (isub (al-len [DwTy] (load (field g dwtys))) 1)))
                    (TSlice [elem]
                            (let [ep (alloc-stack Type)]
                              (store! ep (TPtr elem))
                              (let [pi (dw-ty-of! g ep)
                                    li (dw-ty-of! g (box-type a (TInt 64 true)))
                                    e (alloc-stack DwTy)
                                    (mut fs) (al-new [DwField] a)
                                    f0 (alloc-stack DwField)
                                    f1 (alloc-stack DwField)]
                                (store! (field f0 name) "data")
                                (store! (field f0 tyidx) pi)
                                (store! (field f0 off) 0)
                                (store! (field f1 name) "len")
                                (store! (field f1 tyidx) li)
                                (store! (field f1 off) 8)
                                (al-push! (mut fs) (load f0))
                                (al-push! (mut fs) (load f1))
                                (store! (field e kind) 2)
                                (store! (field e name) nm)
                                (store! (field e size) 16)
                                (store! (field e enc) 0)
                                (store! (field e to) -1)
                                (store! (field e count) 0)
                                (store! (field e off) 0)
                                (store! (field e fields) (load fs))
                                (al-push! (mut (field g dwtys)) (load e))
                                (isub (al-len [DwTy] (load (field g dwtys))) 1))))
                    (TArray [elem n]
                            (let [ei (dw-ty-of! g elem)]
                              (if (icmp-lt ei 0)
                                  -1
                                  (let [e (alloc-stack DwTy)]
                                    (store! (field e kind) 3)
                                    (store! (field e name) nm)
                                    (store! (field e size) (ty-size g t))
                                    (store! (field e enc) 0)
                                    (store! (field e to) ei)
                                    (store! (field e count) n)
                                    (store! (field e off) 0)
                                    (store! (field e fields) (al-new [DwField] a))
                                    (al-push! (mut (field g dwtys)) (load e))
                                    (isub (al-len [DwTy] (load (field g dwtys))) 1)))))
                    (TStruct [snm]
                             (let [si (g-struct-idx g snm)]
                               (if (icmp-lt si 0)
                                   -1  ; sums: deliberately undescribed
                                   (let [sp (struct-at (field g layouts) si)]
                                     (match-else (load (field sp layout))
                                                 (LC []
                                                     ; reserve the entry FIRST (recursion through pointers)
                                                     (let [e (alloc-stack DwTy)]
                                                       (store! (field e kind) 2)
                                                       (store! (field e name) nm)
                                                       (store! (field e size) (load (field sp size)))
                                                       (store! (field e enc) 0)
                                                       (store! (field e to) -1)
                                                       (store! (field e count) 0)
                                                       (store! (field e off) 0)
                                                       (store! (field e fields) (al-new [DwField] a))
                                                       (al-push! (mut (field g dwtys)) (load e))
                                                       (let [idx (isub (al-len [DwTy] (load (field g dwtys))) 1)
                                                             fs (load (field sp fields))
                                                             nf (al-len [Field] (load fs))
                                                             (mut i) 0]
                                                         (loop (if (icmp-ge (load i) nf)
                                                                   (break)
                                                                   (do
                                                                     (let [fp (xal-at [Field] fs (load i))
                                                                           fi (dw-ty-of! g (field fp ty))]
                                                                       (when (icmp-ge fi 0)
                                                                             (let [f (alloc-stack DwField)]
                                                                               (store! (field f name)
                                                                                       (load (field fp name)))
                                                                               (store! (field f tyidx) fi)
                                                                               (store! (field f off)
                                                                                       (g-field-off g si (load i)))
                                                                               (al-push! (mut (field (xal-at [DwTy]
                                                                                                            (field g
                                                                                                                   dwtys)
                                                                                                            idx)
                                                                                                     fields))
                                                                                         (load f))
                                                                               0)))
                                                                     (store! i (iadd (load i) 1)))))
                                                         ; refresh size (fields may have been dropped; header stays right)
                                                         idx)))
                                                 (LBits [backing _o]
                                                        (let [e (alloc-stack DwTy)]
                                                          (store! (field e kind) 0)
                                                          (store! (field e name) nm)
                                                          (store! (field e size) (idiv backing 8))
                                                          (store! (field e enc) 7)
                                                          (store! (field e to) -1)
                                                          (store! (field e count) 0)
                                                          (store! (field e off) 0)
                                                          (store! (field e fields) (al-new [DwField] a))
                                                          (al-push! (mut (field g dwtys)) (load e))
                                                          (isub (al-len [DwTy] (load (field g dwtys))) 1)))
                                                 (_ -1))))))
                    (_ -1)))))

; record a line-table row if the source position moved

(defn dw-note-var! [(g (ptr Cga))
                    (name (slice u8))
                    (t (ptr Type))
                    (slot i64)
                    (indirect bool)
                    (param bool)
                    (src i64)
                    (lo i64)] (-> i64)
  (let [ti (dw-ty-of! g t)]
    (unless (or (icmp-lt ti 0) (or (icmp-lt src 0) (icmp-lt lo 0)))
            (let [v (alloc-stack DwVar)]
              (store! (field v name) name)
              (store! (field v tyidx) ti)
              (store! (field v slot) slot)
              (store! (field v indirect) indirect)
              (store! (field v param) param)
              (store! (field v source) src)
              (store! (field v lo) lo)
              (al-push! (mut (field g dwvars)) (load v))
              0))))

(defn dw-note-bind! [(g (ptr Cga)) (name (slice u8)) (av AVal) (src i64) (lo i64)] (-> i64)
  (let [n (slice-len name)
        t (alloc-stack Type)]
    (store! t (av-ty av))
    (unless (and (icmp-ge n 5) (str-eq (subslice name (isub n 5) n) ".slot"))
            (let [slotname (sconcat (load (field g a)) name ".slot")]
              (match (gscope-get (load (field g env)) slotname)
                (Some [_sl]
                      ; mut variable: value lives behind the pointer
                      (match-else (load t)
                                  (TPtr [inner]
                                        (dw-note-var! g name inner (av-v av) true false src lo))
                                  (_ (dw-note-var! g name t (av-v av) false false src lo))))
                (None []
                      (dw-note-var! g name t (av-v av) false false src lo)))))))

; record a variable/parameter DIE for the current function

(defn dw-note-span! [(g (ptr Cga)) (e (ptr Expr))] (-> i64)
  (let [src (load (field e source))
        lo (load (field e lo))]
    (unless (or (or (icmp-lt src 0) (icmp-lt lo 0))
                (and (icmp-eq src (load (field g dwcursrc))) (icmp-eq lo (load (field g dwcurlo)))))
            (let [ev (alloc-stack DwLineEv)]
              (store! (field ev textoff) (x64-off (mut (field g asm))))
              (store! (field ev source) src)
              (store! (field ev lo) lo)
              (store! (field ev pe) false)
              (al-push! (mut (field g dwevs)) (load ev))
              (store! (field g dwcursrc) src)
              (store! (field g dwcurlo) lo)
              0))))

; DWARF note for a let bind. `(mut x)` desugars to `x.slot` (the alloc) plus
; `x` (a pointer to it): skip the internal `.slot` name and describe `x` as an
; indirect variable of the POINTEE type (location: fbreg off, deref).

(defn dw-ty-name [(g (ptr Cga)) (t (ptr Type))] (-> (slice u8))
  (let [a (load (field g a))]
    (match-else (load t)
                (TInt [bits sg] (sconcat a (if sg "i" "u") (i64->str a bits)))
                (TBool [] "bool")
                (TFloat [bits] (sconcat a "f" (i64->str a bits)))
                (TPtr [inner] (sconcat a "*" (dw-ty-name g inner)))
                (TRef [_m inner] (sconcat a "*" (dw-ty-name g inner)))
                (TSlice [elem] (sconcat a "slice$" (dw-ty-name g elem)))
                (TStruct [nm] nm)
                (TArray [elem n] (sconcat a (sconcat a "arr" (i64->str a n)) (sconcat a "$" (dw-ty-name g elem))))
                (_ "?"))))

(defn str->i64 [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        neg (and (icmp-gt n 0) (icmp-eq (cast i64 (slice-get s 0)) 45))
        (mut i) (when neg 1)
        (mut v) 0]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (let [c (cast i64 (slice-get s (load i)))]
                  (if (or (icmp-lt c 48) (icmp-gt c 57))
                      (cgx-fail2 "not an integer token: " s)
                      (store! v (iadd (imul (load v) 10) (isub c 48)))))
                (store! i (iadd (load i) 1)))))
    (if neg (isub 0 (load v)) (load v))))

(defn ir-tokens [(a (ptr Allocator)) (line (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut toks) (al-new [(slice u8)] a)
        n (slice-len line)
        (mut i) 0
        (mut start) -1]
    (loop (if (icmp-ge (load i) n)
              (do
                (when (icmp-ge (load start) 0) (al-push! (mut toks) (subslice line (load start) n)))
                (break))
              (do
                (let [c (cast i64 (slice-get line (load i)))]
                  (if (or (or (icmp-eq c 32) (icmp-eq c 9)) (icmp-eq c 44))
                      (do
                        (when (icmp-ge (load start) 0) (al-push! (mut toks) (subslice line (load start) (load i))) 0)
                        (store! start -1)
                        0)
                      (if (or (or (or (icmp-eq c 123) (icmp-eq c 125))
                                  (or (icmp-eq c 40) (icmp-eq c 41)))
                              (or (icmp-eq c 60) (icmp-eq c 62)))
                          (do
                            (when (icmp-ge (load start) 0)
                                  (al-push! (mut toks) (subslice line (load start) (load i)))
                                  0)
                            (al-push! (mut toks) (subslice line (load i) (iadd (load i) 1)))
                            (store! start -1)
                            0)
                          (do (when (icmp-lt (load start) 0) (store! start (load i))) 0))))
                (store! i (iadd (load i) 1)))))
    (box-al [(slice u8)] a (load toks))))

; parse an IR type token in the context of (result type, arg types).
; tokp = index of the first token of the type; returns the Type and advances
; *tokp past it. Handles $ret/$tN/i1/i8/i16/i32/i64/float/double/ptr and
; "{ ... }" / "< N x T >" forms (mapped to synthetic Coil types).

(defn ir-parse-type [(g (ptr Cga))
                     (result Type)
                     (argtys (ptr (ArrayList Type)))
                     (toks (ptr (ArrayList (slice u8))))
                     (tokp (ptr i64))] (-> Type)
  (let [a (load (field g a))
        tk (al-get [(slice u8)] (load toks) (load tokp))]
    (store! tokp (iadd (load tokp) 1))
    (cond (str-eq tk "$ret") result
          (str-eq tk "i64") (TInt 64 true)
          (str-eq tk "i32") (TInt 32 true)
          (str-eq tk "i16") (TInt 16 true)
          (str-eq tk "i8") (TInt 8 true)
          (str-eq tk "i1") (TBool)
          (str-eq tk "ptr") (TPtr (box-type a (TInt 8 true)))
          (str-eq tk "float") (TFloat 32)
          (str-eq tk "double") (TFloat 64)
          (str-eq tk "{")  ; consume a literal struct type; used only for cmpxchg
          ; results ({i64,i1}/{ptr,i1}) — treat as 16-byte pair
          (let [t0 (ir-parse-type g result argtys toks tokp)
                t1 (ir-parse-type g result argtys toks tokp)]
            ; skip the closing }
            (store! tokp (iadd (load tokp) 1))
            ; a synthetic slice-shaped pair: elem 0 = t0, elem 1 = t1
            (TSlice (box-type a t0)))
            (str-eq tk "<")
          (let [nstr (al-get [(slice u8)] (load toks) (load tokp))]
            (store! tokp (iadd (load tokp) 1))  ; N
            (store! tokp (iadd (load tokp) 1))  ; x
            (let [elem (ir-parse-type g result argtys toks tokp)]
              (store! tokp (iadd (load tokp) 1))  ; >
              (TVec (box-type a elem) (str->i64 nstr))))
            (and (icmp-ge (slice-len tk) 3)
                 (and (icmp-eq (cast i64 (slice-get tk 0)) 36)
                      (icmp-eq (cast i64 (slice-get tk 1)) 116)))  ; $tN
          (al-get [Type]
                  (load argtys)
                  (str->i64 (subslice tk 2 (slice-len tk))))
            :else
          (do
            (cgx-fail2 "llvm-ir: unsupported type token: " tk)
            (TInt 64 true)))))

; aggregate element info for extractvalue/insertvalue: given the agg type and
; element index, produce (offset, element type).

(defn ir-agg-elem [(g (ptr Cga)) (t (ptr Type)) (idx i64) (offp (ptr i64))] (-> Type)
  (match-else (load t)
              (TSlice [elem]
                      (if (icmp-eq idx 0)
                          (do (store! offp 0) (TPtr elem))
                          (do (store! offp 8) (TInt 64 true))))
              (TStruct [nm]
                       (let [si (g-struct-idx g nm)]
                         (when (icmp-lt si 0) (cgx-fail2 "llvm-ir: extract from unknown struct " nm))
                         (store! offp (g-field-off g si idx))
                         (load (field (xal-at [Field] (load (field (struct-at (field g layouts) si) fields)) idx)
                                      ty))))
              (_ (do
                   (cgx-fail "llvm-ir: extract/insert on unsupported aggregate")
                   (TInt 64 true)))))

; resolve a VALUE token: %name (env), $N (arg), integer literal, undef/zeroinitializer.

(defn ir-value [(g (ptr Cga))
                (env (ptr GScope))
                (avs (ptr (ArrayList AVal)))
                (tk (slice u8))
                (t Type)] (-> AVal)
  (let [tp (alloc-stack Type)]
    (store! tp t)
    (cond (icmp-eq (cast i64 (slice-get tk 0)) 37)  ; %
            (match (gscope-get env tk)
              (Some [av] av)
              (None [] (do (cgx-fail2 "llvm-ir: undefined value " tk) (mk-aval 0 0 (TInt 64 true)))))
          (icmp-eq (cast i64 (slice-get tk 0)) 36)  ; $N
            (al-get [AVal] (load avs) (str->i64 (subslice tk 1 (slice-len tk))))
          (str-eq tk "undef") (mk-aval 1 (slot-for-ty! g tp) t)
          ; fresh, uninitialized slot
          (str-eq tk "zeroinitializer")
            (let [slot (slot-for-ty! g tp)]
              (emit-zero! g slot (ty-size g tp))
              (mk-aval 1 slot t))
          :else  ; integer literal (also covers negative)
            (mk-aval 0 (str->i64 tk) t))))

(defn dw-find-ty [(g (ptr Cga)) (nm (slice u8))] (-> i64)
  (let [n (al-len [DwTy] (load (field g dwtys)))
        (mut i) 0
        (mut r) -1]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (when (str-eq (load (field (xal-at [DwTy] (field g dwtys) (load i)) name)) nm) (store! r (load i)))
                (store! i (iadd (load i) 1)))))
    (load r)))

; type -> DwTy index, or -1 when we deliberately don't describe it (sums,
; fnptrs, vecs, non-C struct layouts — mirrors the DI-type policy:
; never a wrong type).

(defn emit-llvmir [(g (ptr Cga)) (result Type) (args (ptr (ArrayList Expr))) (body (slice u8))] (-> AVal)
  (let [a (load (field g a))
        (mut avs) (al-new [AVal] a)
        (mut argtys) (al-new [Type] a)
        n (al-len [Expr] (load args))
        (mut i) 0]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (let [av (emit-expr g (xal-at [Expr] args (load i)))]
                  (al-push! (mut avs) av)
                  (al-push! (mut argtys) (av-ty av)))
                (store! i (iadd (load i) 1)))))
    (let [avsp (box-al [AVal] a (load avs))
          argtysp (box-al [Type] a (load argtys))
          envp (alloc-stack (ptr GScope))
          retp (alloc-stack AVal)
          donep (alloc-stack bool)
          blen (slice-len body)
          (mut pos) 0]
      (store! envp (gscope-nil a))
      (store! retp (mk-aval 0 0 (TInt 64 true)))
      (store! donep false)
      (loop (if (icmp-ge (load pos) blen)
                (break)
                (do
                  (let [(mut eol) (load pos)]
                    (loop (if (or (icmp-ge (load eol) blen)
                                  (icmp-eq (cast i64 (slice-get body (load eol))) 10))
                              (break)
                              (store! eol (iadd (load eol) 1))))
                    (let [line (subslice body (load pos) (load eol))]
                      (store! pos (iadd (load eol) 1))
                      (unless (icmp-eq (slice-len line) 0)
                              (if (load donep)
                                  (cgx-fail2 "llvm-ir: code after ret: " line)
                                  (emit-ir-line! g envp avsp argtysp result retp donep line)))))
                  0)))
      (unless (load donep) (cgx-fail "llvm-ir: body did not ret"))
      (load retp))))

; per-lane float op over vector slots: op 0 add, 1 sub, 2 mul.

; vector float binop, lane by lane. Scalarizing keeps the IEEE result exact and
; identical to the LLVM backend's, which is what the corpus gate compares.
(defn emit-vec-fbin! [(g (ptr Cga)) (op i64) (dst i64) (asrc i64) (bsrc i64) (lanes i64) (lb i64)] (-> i64)
  (let [s (field g asm)
        dbl (icmp-eq lb 8)
        (mut k) 0]
    (loop (if (icmp-ge (load k) lanes)
              (break)
              (do
                (emit-load-fp! g 0 (x-slotbase) (iadd asrc (imul (load k) lb)) lb)
                (emit-load-fp! g 1 (x-slotbase) (iadd bsrc (imul (load k) lb)) lb)
                (cond (icmp-eq op 0) (x64-adds! (mut s) dbl 0 1)
                      (icmp-eq op 1) (x64-subs! (mut s) dbl 0 1)
                      :else (x64-muls! (mut s) dbl 0 1))
                (emit-store-fp! g 0 (x-slotbase) (iadd dst (imul (load k) lb)) lb)
                (store! k (iadd (load k) 1)))))
    0))

(defn emit-ir-line! [(g (ptr Cga))
                     (envp (ptr (ptr GScope)))
                     (avsp (ptr (ArrayList AVal)))
                     (argtysp (ptr (ArrayList Type)))
                     (result Type)
                     (retp (ptr AVal))
                     (donep (ptr bool))
                     (line (slice u8))] (-> i64)
  (let [a (load (field g a))
        s (field g asm)
        toks (ir-tokens a line)
        ntk (al-len [(slice u8)] (load toks))]
    (unless (icmp-eq ntk 0)
            (let [t0 (al-get [(slice u8)] (load toks) 0)]
              (cond (str-eq t0 "declare") 0
                    ; hoisted intrinsic declaration — the ops lower structurally
                    (str-eq t0 "ret")
                      (let [tokp (alloc-stack i64)]
                        (store! tokp 1)
                        (let [rt (ir-parse-type g result argtysp toks tokp)
                              av
                                (ir-value g
                                          (load envp)
                                          avsp
                                          (al-get [(slice u8)] (load toks) (load tokp))
                                          rt)]
                          (store! retp (mk-aval (av-kind av) (av-v av) result))
                          (store! donep true)
                          0))
                    (str-eq t0 "store")  ; store atomic TYPE VAL, ptr PTR seq_cst, align N
                      (if (and (icmp-ge ntk 7) (str-eq (al-get [(slice u8)] (load toks) 1) "atomic"))
                          (let [tokp (alloc-stack i64)]
                            (store! tokp 2)
                            (let [vt (ir-parse-type g result argtysp toks tokp)
                                  vav
                                    (ir-value g
                                              (load envp)
                                              avsp
                                              (al-get [(slice u8)] (load toks) (load tokp))
                                              vt)
                                  pav
                                    (ir-value g
                                              (load envp)
                                              avsp
                                              (al-get [(slice u8)] (load toks) (iadd (load tokp) 2))
                                              (TPtr (box-type a (TInt 8 true))))]
                              ; a seq_cst store is an xchg: implicitly locked, so it
                              ; both stores and carries the full barrier.
                              (av-to-x! g vav (x-scratch1))
                              (av-to-x! g pav (x-scratch0))
                              (x64-xchg-mr! (mut s) (x-scratch0) 0 (x-scratch1))
                              0))
                          (cgx-fail2 "llvm-ir: unsupported store line: " line))
                    (and (icmp-ge ntk 3) (icmp-eq (cast i64 (slice-get t0 0)) 37))
                      (let [op (al-get [(slice u8)] (load toks) 2)]
                        (cond (str-eq op "extractvalue")
                                (let [tokp (alloc-stack i64)]
                                  (store! tokp 3)
                                  (let [aggty (ir-parse-type g result argtysp toks tokp)
                                        vtk (al-get [(slice u8)] (load toks) (load tokp))
                                        idx (str->i64 (al-get [(slice u8)] (load toks) (iadd (load tokp) 1)))
                                        av (ir-value g (load envp) avsp vtk aggty)
                                        atp (alloc-stack Type)]
                                    (store! atp aggty)
                                    (let [offp (alloc-stack i64)
                                          ety (ir-agg-elem g atp idx offp)
                                          etp (alloc-stack Type)]
                                      (store! etp ety)
                                      (let [eslot (slot-for-ty! g etp)]
                                        (emit-copy! g eslot (iadd (av-slot! g av) (load offp)) (ty-size g etp))
                                        (store! envp (gscope-put a (load envp) t0 (mk-aval 1 eslot ety)))
                                        0))))
                              (str-eq op "insertvalue")
                                (let [tokp (alloc-stack i64)]
                                  (store! tokp 3)
                                  (let [aggty (ir-parse-type g result argtysp toks tokp)
                                        aggtk (al-get [(slice u8)] (load toks) (load tokp))]
                                    (store! tokp (iadd (load tokp) 1))
                                    (let [aggav (ir-value g (load envp) avsp aggtk aggty)
                                          elty (ir-parse-type g result argtysp toks tokp)
                                          eltk (al-get [(slice u8)] (load toks) (load tokp))
                                          idx (str->i64 (al-get [(slice u8)] (load toks) (iadd (load tokp) 1)))
                                          eav (ir-value g (load envp) avsp eltk elty)
                                          atp (alloc-stack Type)]
                                      (store! atp aggty)
                                      (let [dslot (slot-for-ty! g atp)
                                            offp (alloc-stack i64)]
                                        (emit-copy! g dslot (av-slot! g aggav) (ty-size g atp))
                                        (ir-agg-elem g atp idx offp)
                                        (emit-store-av-at! g eav (iadd dslot (load offp)))
                                        (store! envp (gscope-put a (load envp) t0 (mk-aval 1 dslot aggty)))
                                        0))))
                              (str-eq op "atomicrmw")  ; %old = atomicrmw SUB ptr PTR, TYPE VAL seq_cst
                                (let [sub (al-get [(slice u8)] (load toks) 3)
                                      pav
                                        (ir-value g
                                                  (load envp)
                                                  avsp
                                                  (al-get [(slice u8)] (load toks) 5)
                                                  (TPtr (box-type a (TInt 8 true))))
                                      tokp (alloc-stack i64)]
                                  (store! tokp 6)
                                  (let [vt (ir-parse-type g result argtysp toks tokp)
                                        vav
                                          (ir-value g
                                                    (load envp)
                                                    avsp
                                                    (al-get [(slice u8)] (load toks) (load tokp))
                                                    vt)
                                        vtp (alloc-stack Type)]
                                    (store! vtp vt)
                                    (av-to-x! g pav (x-scratch0))
                                    (av-to-x! g vav (x-scratch1))
                                    (cond (str-eq sub "add") 0
                                          (str-eq sub "sub") (do (x64-neg! (mut s) (x-scratch1)) 0)
                                          (str-eq sub "xchg") 0
                                          :else (cgx-fail2 "llvm-ir: unsupported atomicrmw op: " sub))
                                    ; both xchg and xadd return the OLD value in the
                                    ; source register, so the value is copied into r11
                                    ; and r11 is what gets read back afterwards.
                                    (if (str-eq sub "xchg")
                                        (do (x64-mov-rr! (mut s) (x-scratch2) (x-scratch1))
                                            (x64-xchg-mr! (mut s) (x-scratch0) 0 (x-scratch2)))
                                        (do (x64-mov-rr! (mut s) (x-scratch2) (x-scratch1))
                                            (x64-lock-xadd! (mut s) (x-scratch0) 0 (x-scratch2))))
                                    (let [slot (slot-for-ty! g vtp)]
                                      (emit-store-int! g (x-scratch2) (x-slotbase) slot (ty-size g vtp))
                                      (store! envp (gscope-put a (load envp) t0 (mk-aval 1 slot vt)))
                                      0)))
                              (str-eq op "cmpxchg")  ; %r = cmpxchg ptr PTR, TYPE EXP, TYPE NEW seq_cst seq_cst
                                (let [pav
                                        (ir-value g
                                                  (load envp)
                                                  avsp
                                                  (al-get [(slice u8)] (load toks) 4)
                                                  (TPtr (box-type a (TInt 8 true))))
                                      tokp (alloc-stack i64)]
                                  (store! tokp 5)
                                  (let [et (ir-parse-type g result argtysp toks tokp)
                                        eav
                                          (ir-value g
                                                    (load envp)
                                                    avsp
                                                    (al-get [(slice u8)] (load toks) (load tokp))
                                                    et)]
                                    (store! tokp (iadd (load tokp) 1))
                                    (let [nt (ir-parse-type g result argtysp toks tokp)
                                          nav
                                            (ir-value g
                                                      (load envp)
                                                      avsp
                                                      (al-get [(slice u8)] (load toks) (load tokp))
                                                      nt)]
                                      ; cmpxchg PINS rax as the expected value and
                                      ; overwrites it with the old value, so neither
                                      ; the pointer nor the new value may live there:
                                      ; rcx = pointer, rax = expected, r11 = new.
                                      (av-to-x! g pav 1)
                                      (av-to-x! g nav (x-scratch2))
                                      (av-to-x! g eav 0)
                                      (x64-mov-rr! (mut s) (x-scratch1) 0)  ; keep the expected value to compare after
                                      (x64-lock-cmpxchg! (mut s) 1 0 (x-scratch2))
                                      ; pair {old, success}: old at +0, success bit at +8.
                                      ; rax now holds the OLD value either way.
                                      (let [slot (slot-new! g 16 8)]
                                        (emit-store-int! g 0 (x-slotbase) slot 8)
                                        (x64-cmp-rr! (mut s) 0 (x-scratch1))
                                        (x64-setcc-bool! (mut s) (x64-cc-e) 2)
                                        (emit-store-int! g 2 (x-slotbase) (iadd slot 8) 8)
                                        (store! envp
                                                (gscope-put a
                                                            (load envp)
                                                            t0
                                                            (mk-aval 1 slot (TSlice (box-type a et)))))
                                        0))))
                              (str-eq op "load")  ; %v = load atomic TYPE, ptr PTR seq_cst, align N
                                (if (str-eq (al-get [(slice u8)] (load toks) 3) "atomic")
                                    (let [tokp (alloc-stack i64)]
                                      (store! tokp 4)
                                      (let [vt (ir-parse-type g result argtysp toks tokp)
                                            vtp (alloc-stack Type)]
                                        (store! vtp vt)
                                        ; skip the "ptr" token
                                        (let [pav
                                                (ir-value g
                                                          (load envp)
                                                          avsp
                                                          (al-get [(slice u8)]
                                                                  (load toks)
                                                                  (iadd (load tokp) 1))
                                                          (TPtr (box-type a (TInt 8 true))))]
                                          (av-to-x! g pav (x-scratch0))
                                          (x64-mov-rm! (mut s) (x-scratch1) (x-scratch0) 0)  ; x86 loads are acquire
                                          (let [slot (slot-for-ty! g vtp)]
                                            (emit-store-int! g (x-scratch1) (x-slotbase) slot (ty-size g vtp))
                                            (store! envp
                                                    (gscope-put a (load envp) t0 (mk-aval 1 slot vt)))
                                            0))))
                                    (cgx-fail2 "llvm-ir: unsupported load line: " line))
                              (str-eq op "insertelement")  ; %v = insertelement <N x T> AGG, ET EV, i32 K
                                (let [tokp (alloc-stack i64)]
                                  (store! tokp 3)
                                  (let [vty (ir-parse-type g result argtysp toks tokp)
                                        aggtk (al-get [(slice u8)] (load toks) (load tokp))]
                                    (store! tokp (iadd (load tokp) 1))
                                    (let [aggav (ir-value g (load envp) avsp aggtk vty)
                                          elty (ir-parse-type g result argtysp toks tokp)
                                          eav
                                            (ir-value g
                                                      (load envp)
                                                      avsp
                                                      (al-get [(slice u8)] (load toks) (load tokp))
                                                      elty)
                                          k
                                            (str->i64 (al-get [(slice u8)]
                                                              (load toks)
                                                              (iadd (load tokp) 2)))
                                          vtp (alloc-stack Type)
                                          etp (alloc-stack Type)]
                                      (store! vtp vty)
                                      (store! etp elty)
                                      (let [lb (ty-size g etp)
                                            dslot (slot-for-ty! g vtp)]
                                        (emit-copy! g dslot (av-slot! g aggav) (ty-size g vtp))
                                        (av-to-d! g eav 0)
                                        (emit-store-fp! g 0 (x-slotbase) (iadd dslot (imul k lb)) lb)
                                        (store! envp
                                                (gscope-put a (load envp) t0 (mk-aval 1 dslot vty)))
                                        0))))
                              (str-eq op "shufflevector")  ; splat: %r = shufflevector <..> V, <..> undef, <4 x i32> zeroinitializer
                                (let [tokp (alloc-stack i64)]
                                  (store! tokp 3)
                                  (let [vty (ir-parse-type g result argtysp toks tokp)
                                        vav
                                          (ir-value g
                                                    (load envp)
                                                    avsp
                                                    (al-get [(slice u8)]
                                                            (load toks)
                                                            (load tokp))
                                                    vty)]
                                    (store! tokp (iadd (load tokp) 1))
                                    (ir-parse-type g result argtysp toks tokp)  ; second operand type
                                    (store! tokp (iadd (load tokp) 1))  ; undef
                                    (ir-parse-type g result argtysp toks tokp)  ; mask type
                                    (unless (str-eq (al-get [(slice u8)] (load toks) (load tokp))
                                                    "zeroinitializer")
                                            (cgx-fail2 "llvm-ir: only splat shuffles supported: "
                                                       line))
                                    (let [vtp (alloc-stack Type)]
                                      (store! vtp vty)
                                      (match-else vty
                                                  (TVec [elem lanes]
                                                        (let [lb (ty-size g elem)
                                                              src (av-slot! g vav)
                                                              dslot (slot-for-ty! g vtp)
                                                              (mut k) 0]
                                                          (emit-load-fp! g 0 (x-slotbase) src lb)
                                                          (loop (if (icmp-ge (load k) lanes)
                                                                    (break)
                                                                    (do
                                                                      (emit-store-fp! g
                                                                                      0
                                                                                      (x-slotbase)
                                                                                      (iadd dslot
                                                                                            (imul (load k)
                                                                                                  lb))
                                                                                      lb)
                                                                      (store! k
                                                                              (iadd (load k) 1)))))
                                                          (store! envp
                                                                  (gscope-put a
                                                                              (load envp)
                                                                              t0
                                                                              (mk-aval 1
                                                                                       dslot
                                                                                       vty)))
                                                          0))
                                                  (_ (cgx-fail "llvm-ir: shufflevector on non-vector"))))))
                              (or (or (str-eq op "fadd") (str-eq op "fsub"))
                                  (str-eq op "fmul"))
                                (let [tokp (alloc-stack i64)
                                      opn
                                        (unless (str-eq op "fadd") (if (str-eq op "fsub") 1 2))]
                                  (store! tokp 3)
                                  (let [vty (ir-parse-type g result argtysp toks tokp)
                                        aav
                                          (ir-value g
                                                    (load envp)
                                                    avsp
                                                    (al-get [(slice u8)]
                                                            (load toks)
                                                            (load tokp))
                                                    vty)
                                        bav
                                          (ir-value g
                                                    (load envp)
                                                    avsp
                                                    (al-get [(slice u8)]
                                                            (load toks)
                                                            (iadd (load tokp) 1))
                                                    vty)
                                        vtp (alloc-stack Type)]
                                    (store! vtp vty)
                                    (match-else vty
                                                (TVec [elem lanes]
                                                      (let [lb (ty-size g elem)
                                                            dslot (slot-for-ty! g vtp)]
                                                        (emit-vec-fbin! g
                                                                        opn
                                                                        dslot
                                                                        (av-slot! g aav)
                                                                        (av-slot! g bav)
                                                                        lanes
                                                                        lb)
                                                        (store! envp
                                                                (gscope-put a
                                                                            (load envp)
                                                                            t0
                                                                            (mk-aval 1
                                                                                     dslot
                                                                                     vty)))
                                                        0))
                                                (TFloat [bits]
                                                        (let [dbl (icmp-eq bits 64)
                                                              dslot (slot-for-ty! g vtp)]
                                                          (av-to-d! g aav 0)
                                                          (av-to-d! g bav 1)
                                                          (cond (icmp-eq opn 0) (x64-adds! (mut s) dbl 0 1)
                                                                (icmp-eq opn 1) (x64-subs! (mut s) dbl 0 1)
                                                                :else (x64-muls! (mut s) dbl 0 1))
                                                          (emit-store-fp! g
                                                                          0
                                                                          (x-slotbase)
                                                                          dslot
                                                                          (idiv bits 8))
                                                          (store! envp
                                                                  (gscope-put a
                                                                              (load envp)
                                                                              t0
                                                                              (mk-aval 1
                                                                                       dslot
                                                                                       vty)))
                                                          0))
                                                (_ (cgx-fail "llvm-ir: float op on unsupported type")))))
                              (str-eq op "call") (emit-ir-call! g envp avsp argtysp result toks t0 line)
                              :else (cgx-fail2 "llvm-ir: unsupported op: " op)))
                    :else (cgx-fail2 "llvm-ir: unsupported line: " line))))))

; intrinsic calls: @llvm.fma.v4f32 and @llvm.vector.reduce.fadd.v4f32
(defn emit-ir-call! [(g (ptr Cga))
                     (envp (ptr (ptr GScope)))
                     (avsp (ptr (ArrayList AVal)))
                     (argtysp (ptr (ArrayList Type)))
                     (result Type)
                     (toks (ptr (ArrayList (slice u8))))
                     (t0 (slice u8))
                     (line (slice u8))] (-> i64)
  (let [a (load (field g a))
        s (field g asm)
        tokp (alloc-stack i64)]
    (store! tokp 3)
    (let [rty (ir-parse-type g result argtysp toks tokp)
          callee (al-get [(slice u8)] (load toks) (load tokp))]
      (if (str-eq callee "@llvm.fma.v4f32")
          ; ( $t0 $0 $t1 $1 $t2 $2 ) -> per-lane single-rounding fmadd
          (let [rtp (alloc-stack Type)]
            (store! rtp rty)
            (store! tokp (iadd (load tokp) 2))  ; skip "("
            (let [t1 (ir-parse-type g result argtysp toks tokp)
                  aav (ir-value g (load envp) avsp (al-get [(slice u8)] (load toks) (load tokp)) t1)]
              (store! tokp (iadd (load tokp) 1))
              (let [t2 (ir-parse-type g result argtysp toks tokp)
                    bav (ir-value g (load envp) avsp (al-get [(slice u8)] (load toks) (load tokp)) t2)]
                (store! tokp (iadd (load tokp) 1))
                (let [t3 (ir-parse-type g result argtysp toks tokp)
                      cav (ir-value g (load envp) avsp (al-get [(slice u8)] (load toks) (load tokp)) t3)]
                  (match-else rty
                              (TVec [elem lanes]
                                    (let [lb (ty-size g elem)
                                          asrc (av-slot! g aav)
                                          bsrc (av-slot! g bav)
                                          csrc (av-slot! g cav)
                                          dslot (slot-for-ty! g rtp)
                                          (mut k) 0]
                                      (loop (if (icmp-ge (load k) lanes)
                                                (break)
                                                (do
                                                  (emit-load-fp! g 0 (x-slotbase) (iadd asrc (imul (load k) lb)) lb)
                                                  (emit-load-fp! g 1 (x-slotbase) (iadd bsrc (imul (load k) lb)) lb)
                                                  (emit-load-fp! g 2 (x-slotbase) (iadd csrc (imul (load k) lb)) lb)
                                                  ; SSE2 has no fused multiply-add, so this is mul-then-add: it rounds
                                                  ; TWICE where a real FMA rounds once. llvm.fma lowers the same
                                                  ; way when the target lacks FMA, so the corpus still matches.
                                                  (x64-muls! (mut s) (icmp-eq lb 8) 0 1)
                                                  (x64-adds! (mut s) (icmp-eq lb 8) 0 2)
                                                  (emit-store-fp! g 0 (x-slotbase) (iadd dslot (imul (load k) lb)) lb)
                                                  (store! k (iadd (load k) 1)))))
                                      (store! envp (gscope-put a (load envp) t0 (mk-aval 1 dslot rty)))
                                      0))
                              (_ (cgx-fail "llvm-ir: fma on non-vector")))))))
          (if (str-eq callee "@llvm.vector.reduce.fadd.v4f32")
              ; ( float 0.0 $t0 $0 ) -> strict sequential reduce from 0.0
              (let [rtp (alloc-stack Type)]
                (store! rtp rty)
                (store! tokp (iadd (load tokp) 2))  ; skip "("
                (ir-parse-type g result argtysp toks tokp)  ; float
                (unless (str-eq (al-get [(slice u8)] (load toks) (load tokp)) "0.0")
                        (cgx-fail2 "llvm-ir: reduce.fadd start must be 0.0: " line))
                (store! tokp (iadd (load tokp) 1))
                (let [vt (ir-parse-type g result argtysp toks tokp)
                      vav (ir-value g (load envp) avsp (al-get [(slice u8)] (load toks) (load tokp)) vt)]
                  (match-else vt
                              (TVec [elem lanes]
                                    (let [lb (ty-size g elem)
                                          src (av-slot! g vav)
                                          dslot (slot-for-ty! g rtp)
                                          (mut k) 0]
                                      ; s0 = +0.0 (all-zero bits)
                                      (x64-xorps! (mut s) 0 0)
                                      (loop (if (icmp-ge (load k) lanes)
                                                (break)
                                                (do
                                                  (emit-load-fp! g 1 (x-slotbase) (iadd src (imul (load k) lb)) lb)
                                                  (x64-adds! (mut s) (icmp-eq lb 8) 0 1)
                                                  (store! k (iadd (load k) 1)))))
                                      (emit-store-fp! g 0 (x-slotbase) dslot lb)
                                      (store! envp (gscope-put a (load envp) t0 (mk-aval 1 dslot rty)))
                                      0))
                              (_ (cgx-fail "llvm-ir: reduce on non-vector")))))
              (cgx-fail2 "llvm-ir: unsupported intrinsic: " callee))))))

; ============================ function emission ==============================
; Frame, in the order the prologue builds it:
;     push rbp            ; rbp chain intact => backtraces work with no eh_frame
;     mov  rsp, rbp
;     push rbx            ; rbx is callee-saved and holds the slot base
;     sub  rsp, total     ; patched once slotbytes/outbytes are known
;     lea  rbx, [rsp+out] ; slots start above the outgoing-argument area
; SysV requires rsp ≡ 0 (mod 16) at every CALL. At function entry the call
; instruction has already pushed the return address, so rsp ≡ 8. `push rbp`
; brings it to 0 and `push rbx` back to 8 — an ODD number of pushes — so the
; frame subtraction must be 8 (mod 16), not a multiple of 16, to land back on
; 0. Getting this wrong does not fault here: it faults deep inside libc, when
; something like printf executes a movaps against a misaligned stack.
;
; Incoming stack arguments live at [rbp+16] and up: +0 is the saved rbp, +8 the
; return address.
(defn emit-func! [(g (ptr Cga)) (fd (ptr Func))] (-> i64)
  (store! (field g frame) 0)
  (store! (field g dwcursrc) -1)
  (store! (field g dwcurlo) -1)
  (store! (field g env) (gscope-nil (load (field g a))))
  (store! (field (field g loops) len) 0)
  (store! (field g terminated) false)
  (store! (field g retty) (load (field fd ret)))
  (store! (field g sretslot) -1)
  (store! (field g outbytes) 0)
  (let [s (field g asm)
        a (load (field g a))
        si (g-sig-idx g (load (field fd name)))]
    (when (icmp-lt si 0) (cgx-fail2 "emit-func!: unregistered function " (load (field fd name))))
    (eobj-set-sym! (mut (field g obj))
                   (if (load (field (xal-at [GSig] (field g sigs) si) shim))
                       (load (field (xal-at [GSig] (field g sigs) si) implsym))
                       (load (field (xal-at [GSig] (field g sigs) si) symidx)))
                   (load (field g text))
                   (x64-off (mut s)))
    (store! (field g fnstart) (x64-off (mut s)))
    (when (icmp-ge (load (field fd source)) 0)
          (let [ev (alloc-stack DwLineEv)]
            (store! (field ev textoff) (x64-off (mut s)))
            (store! (field ev source) (load (field fd source)))
            (store! (field ev lo) (unless (icmp-lt (load (field fd lo)) 0) (load (field fd lo))))
            (store! (field ev pe) false)
            (al-push! (mut (field g dwevs)) (load ev))
            (store! (field g dwcursrc) (load (field fd source)))
            (store! (field g dwcurlo) (load (field ev lo)))
            0))
    (let [dwvarlo (al-len [DwVar] (load (field g dwvars)))
          dwfnlo (load (field fd lo))
          dwfnsrc (load (field fd source))]
      ; ---- prologue
      (x64-push! (mut s) 5)                     ; push rbp
      (x64-mov-rr! (mut s) 5 4)                 ; mov rsp, rbp
      (x64-push! (mut s) (x-slotbase))          ; push rbx
      (let [p1 (x64-off (mut s))]
        ; two placeholders, patched below: `sub rsp, imm32` (7 bytes) and
        ; `lea rbx, [rsp+imm32]` (8 bytes). Both are emitted at their maximum
        ; width so the patch never has to move code.
        (x64-sub-ri32! (mut s) 4 0)
        (x64-lea32! (mut s) (x-slotbase) 4 0)
        (let [retp (alloc-stack Type)]
          (store! retp (load (field fd ret)))
          (let [retvoid (match-else (load (field fd ret)) (TVoid [] true) (_ false))
                retinfo (if retvoid (mk-abi-scalar) (g-abi-info g retp))]
            ; incoming hidden sret pointer (rdi) for a >16B return
            (when (icmp-eq (abi-cls retinfo) 4)
                  (let [ss (slot-new! g 8 8)]
                    (emit-store-int! g 7 (x-slotbase) ss 8)
                    (store! (field g sretslot) ss))
                  0)
            (let [ps (load (field fd params))
                  np (al-len [Param] (load ps))
                  (mut gp) (if (icmp-eq (abi-cls retinfo) 4) 1 0)
                  (mut fp) 0
                  (mut stk) 0
                  (mut i) 0]
              (loop (if (icmp-ge (load i) np)
                        (break)
                        (do
                          (let [prm (xal-at [Param] ps (load i))
                                t (field prm ty)
                                info (g-abi-info g t)
                                cls (abi-cls info)
                                slot (slot-for-ty! g t)
                                sz (ty-size g t)]
                            (cond
                              ; ---- int-like scalar
                              (icmp-eq cls 0)
                                (if (icmp-lt (load gp) 6)
                                    (do (emit-store-int! g (x-argreg (load gp)) (x-slotbase) slot sz)
                                        (store! gp (iadd (load gp) 1)) 0)
                                    (do (emit-load-int! g (x-scratch0) 5 (iadd 16 (load stk)) 8 false)
                                        (emit-store-int! g (x-scratch0) (x-slotbase) slot sz)
                                        (store! stk (iadd (load stk) 8)) 0))
                              ; ---- float scalar
                              (icmp-eq cls 1)
                                (if (icmp-lt (load fp) 8)
                                    (do (emit-store-fp! g (load fp) (x-slotbase) slot (ty-float-bytes t))
                                        (store! fp (iadd (load fp) 1)) 0)
                                    (do (emit-load-int! g (x-scratch0) 5 (iadd 16 (load stk)) 8 false)
                                        (emit-store-int! g (x-scratch0) (x-slotbase) slot sz)
                                        (store! stk (iadd (load stk) 8)) 0))
                              ; ---- aggregate <= 8B, one register of class eb0
                              (icmp-eq cls 2)
                                (let [sse (icmp-eq (abi-eb0 info) 2)]
                                  (if (if sse (icmp-lt (load fp) 8) (icmp-lt (load gp) 6))
                                      (do (if sse
                                              (emit-store-fp! g (load fp) (x-slotbase) slot 8)
                                              (emit-store-int! g (x-argreg (load gp)) (x-slotbase) slot 8))
                                          (if sse (store! fp (iadd (load fp) 1)) (store! gp (iadd (load gp) 1)))
                                          0)
                                      (do (emit-load-int! g (x-scratch0) 5 (iadd 16 (load stk)) 8 false)
                                          (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                                          (store! stk (iadd (load stk) 8)) 0)))
                              ; ---- aggregate <= 16B, one register per eightbyte
                              (icmp-eq cls 3)
                                (let [s0 (icmp-eq (abi-eb0 info) 2)
                                      s1 (icmp-eq (abi-eb1 info) 2)
                                      needg (iadd (if s0 0 1) (if s1 0 1))
                                      needf (iadd (if s0 1 0) (if s1 1 0))]
                                  (if (and (icmp-le (iadd (load gp) needg) 6)
                                           (icmp-le (iadd (load fp) needf) 8))
                                      (do
                                        (if s0
                                            (do (emit-store-fp! g (load fp) (x-slotbase) slot 8)
                                                (store! fp (iadd (load fp) 1)) 0)
                                            (do (emit-store-int! g (x-argreg (load gp)) (x-slotbase) slot 8)
                                                (store! gp (iadd (load gp) 1)) 0))
                                        (if s1
                                            (do (emit-store-fp! g (load fp) (x-slotbase) (iadd slot 8) 8)
                                                (store! fp (iadd (load fp) 1)) 0)
                                            (do (emit-store-int! g (x-argreg (load gp)) (x-slotbase) (iadd slot 8) 8)
                                                (store! gp (iadd (load gp) 1)) 0))
                                        0)
                                      (do
                                        (emit-load-int! g (x-scratch0) 5 (iadd 16 (load stk)) 8 false)
                                        (emit-store-int! g (x-scratch0) (x-slotbase) slot 8)
                                        (emit-load-int! g (x-scratch0) 5 (iadd 24 (load stk)) 8 false)
                                        (emit-store-int! g (x-scratch0) (x-slotbase) (iadd slot 8) 8)
                                        (store! stk (iadd (load stk) 16)) 0)))
                              ; ---- > 16B: the caller placed a copy on the stack;
                              ; copy it into this function's own slot.
                              :else
                                (let [asz (imul (idiv (iadd sz 7) 8) 8)
                                      (mut kk) 0]
                                  (loop (if (icmp-ge (load kk) asz)
                                            (break)
                                            (do
                                              (emit-load-int! g (x-scratch0) 5
                                                              (iadd 16 (iadd (load stk) (load kk))) 8 false)
                                              (emit-store-int! g (x-scratch0) (x-slotbase)
                                                               (iadd slot (load kk)) 8)
                                              (store! kk (iadd (load kk) 8)))))
                                  (store! stk (iadd (load stk) asz))
                                  0))
                            (dw-note-var! g
                                          (load (field prm name))
                                          t
                                          slot
                                          false
                                          true
                                          (load (field fd source))
                                          (load (field fd lo)))
                            (store! (field g env)
                                    (gscope-put a
                                                (load (field g env))
                                                (load (field prm name))
                                                (mk-aval 1 slot (load t)))))
                          (store! i (iadd (load i) 1))))))
            ; ---- prologue complete: the prologue_end row, so a debugger's
            ; breakpoint lands after the parameters are spilled and frame
            ; variables are valid.
            (when (icmp-ge (load (field fd source)) 0)
                  (let [ev (alloc-stack DwLineEv)]
                    (store! (field ev textoff) (x64-off (mut s)))
                    (store! (field ev source) (load (field fd source)))
                    (store! (field ev lo) (unless (icmp-lt (load (field fd lo)) 0) (load (field fd lo))))
                    (store! (field ev pe) true)
                    (al-push! (mut (field g dwevs)) (load ev))
                    0))
            ; ---- body
            (let [bav (emit-body g (load (field fd body)))]
              (unless (load (field g terminated))
                      (unless retvoid
                              (let [cls (abi-cls retinfo)]
                                (cond (icmp-eq cls 0) (av-to-x! g bav 0)
                                      (icmp-eq cls 1) (av-to-d! g bav 0)
                                      (icmp-eq cls 2)
                                        (if (icmp-eq (abi-eb0 retinfo) 2)
                                            (emit-load-fp! g 0 (x-slotbase) (av-slot! g bav) 8)
                                            (emit-load-int! g 0 (x-slotbase) (av-slot! g bav) (ty-size g retp) false))
                                      (icmp-eq cls 3)
                                        ; two eightbytes leave in (rax,rdx) / (xmm0,xmm1)
                                        ; / a mix, each file numbered independently.
                                        (let [bs (av-slot! g bav)
                                              s0 (icmp-eq (abi-eb0 retinfo) 2)
                                              s1 (icmp-eq (abi-eb1 retinfo) 2)]
                                          (if s0
                                              (emit-load-fp! g 0 (x-slotbase) bs 8)
                                              (emit-load-int! g 0 (x-slotbase) bs 8 false))
                                          (if s1
                                              (emit-load-fp! g (if s0 1 0) (x-slotbase) (iadd bs 8) 8)
                                              (emit-load-int! g (if s0 0 2) (x-slotbase) (iadd bs 8) 8 false))
                                          0)
                                      :else
                                        ; cls 4: copy into *sret, and SysV also
                                        ; requires the pointer to come back in rax.
                                        (do
                                          (emit-load-int! g (x-scratch2) (x-slotbase) (load (field g sretslot)) 8 false)
                                          (emit-copy-to-mem! g (x-scratch2) (av-slot! g bav) (ty-size g retp))
                                          (emit-load-int! g 0 (x-slotbase) (load (field g sretslot)) 8 false)
                                          0))))
                      0)
              ; ---- epilogue: restore rbx from just below rbp, then leave/ret.
              (x64-mov-rm! (mut s) (x-slotbase) 5 -8)
              (x64-leave! (mut s))
              (x64-ret! (mut s))
              ; ---- resolve labels, patch the frame size
              (x64-resolve-fixups! (mut s))
              (let [slotbytes (imul (idiv (iadd (load (field g frame)) 15) 16) 16)
                    out (load (field g outbytes))
                    ; two pushes precede this, so rsp is 8 (mod 16) here; add the
                    ; odd 8 to bring it back to 0 for the callees.
                    total (iadd (iadd slotbytes out) 8)]
                (when (icmp-gt total 2147483647) (cgx-fail "frame too large"))
                (x64-patch-sub-ri32! (mut s) p1 total)
                (x64-patch-lea32! (mut s) (iadd p1 7) out)
                (let [df (alloc-stack DwFn)]
                  (store! (field df name) (load (field fd name)))
                  (store! (field df symidx) (load (field (xal-at [GSig] (field g sigs) si) symidx)))
                  (store! (field df source) (unless (icmp-lt dwfnsrc 0) dwfnsrc))
                  (store! (field df lo) (unless (icmp-lt dwfnlo 0) dwfnlo))
                  (store! (field df textoff) (load (field g fnstart)))
                  (store! (field df len) (isub (x64-off (mut s)) (load (field g fnstart))))
                  (store! (field df slotbytes) slotbytes)
                  (store! (field df varlo) dwvarlo)
                  (store! (field df varhi) (al-len [DwVar] (load (field g dwvars))))
                  (al-push! (mut (field g dwfns)) (load df)))
                ; :shim: the Coil-named symbol is a trampoline that moves the
                ; convention's registers into the C argument registers, calls
                ; __impl, and moves rax back into the convention's return register.
                (when (load (field (xal-at [GSig] (field g sigs) si) shim))
                      (let [e (xal-at [GSig] (field g sigs) si)
                            regs (load (field e shimregs))
                            nr (al-len [i64] (load regs))]
                        (eobj-set-sym! (mut (field g obj))
                                       (load (field e symidx))
                                       (load (field g text))
                                       (x64-off (mut s)))
                        (x64-push! (mut s) 5)
                        (x64-mov-rr! (mut s) 5 4)
                        (let [(mut j) 0]
                          (loop (if (icmp-ge (load j) nr)
                                    (break)
                                    (do
                                      (x64-mov-rr! (mut s) (x-argreg (load j)) (al-get [i64] (load regs) (load j)))
                                      (store! j (iadd (load j) 1))))))
                        (let [coff (x64-call-rel32! (mut s))]
                          (eobj-add-reloc! (mut (field g obj))
                                           (load (field g text))
                                           coff
                                           (load (field e implsym))
                                           (r-x86-64-plt32)
                                           -4))
                        (when (icmp-ne (load (field e shimret)) 0)
                              (x64-mov-rr! (mut s) (load (field e shimret)) 0))
                        (x64-leave! (mut s))
                        (x64-ret! (mut s))
                        0))
                0)))))))
  0)

; compile-time constant evaluation for (static-assert ...): a faithful port of
; codegen.coil's const-eval, with LLVM size/align/offset queries replaced by
; this backend's own layout tables — which give the same natural-layout answers.
(defstruct GCEval [(v i64) (uns bool)])
(defn mk-gcev [(v i64) (u bool)] (-> GCEval)
  (let [p (alloc-stack GCEval)] (store! (field p v) v) (store! (field p uns) u) (load p)))

(defn gcev-v [(c GCEval)] (-> i64)
  (let [p (alloc-stack GCEval)] (store! p c) (load (field p v))))

(defn gcev-u [(c GCEval)] (-> bool)
  (let [p (alloc-stack GCEval)] (store! p c) (load (field p uns))))

(defn g-user-fail [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (print-str w "error: ") (print-str w msg) (write-byte w (cast u8 10)) (cgx64.exit (cast i32 1)) 0))

(defn g-const-bin [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> GCEval)
  (let [uns (or lu ru)]
    (mk-gcev (cond (icmp-eq op 0) (iadd l r)
                   (icmp-eq op 1) (isub l r)
                   (icmp-eq op 2) (imul l r)
                   (icmp-eq op 7) (iand l r)
                   (icmp-eq op 8) (ior l r)
                   (icmp-eq op 9) (ixor l r)
                   (icmp-eq op 10) (ishl l r)
                   (icmp-eq op 11) (if uns (cast i64 (ishr (cast u64 l) (cast u64 r))) (ishr l r))
                   (icmp-eq op 3)
                     (if (icmp-eq r 0)
                         (do (g-user-fail "static-assert: divide/mod by zero") 0)
                         (if uns (udiv l r) (idiv l r)))
                   (icmp-eq op 4)
                     (if (icmp-eq r 0)
                         (do (g-user-fail "static-assert: divide/mod by zero") 0)
                         (if uns (urem l r) (irem l r)))
                   (icmp-eq op 5)
                     (if (icmp-eq r 0)
                         (do (g-user-fail "static-assert: divide/mod by zero") 0)
                         (udiv l r))
                   (icmp-eq r 0) (do (g-user-fail "static-assert: divide/mod by zero") 0)
                   :else (urem l r))
             uns)))

(defn g-const-cmp [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> GCEval)
  (let [b
          (cond (or lu ru)
                  (let [lx (cast u64 l)
                        rx (cast u64 r)]
                    (cond (icmp-eq op 0) (icmp-lt lx rx)
                          (icmp-eq op 1) (icmp-le lx rx)
                          (icmp-eq op 2) (icmp-gt lx rx)
                          (icmp-eq op 3) (icmp-ge lx rx)
                          (icmp-eq op 4) (icmp-eq lx rx)
                          :else (icmp-ne lx rx)))
                (icmp-eq op 0) (icmp-lt l r)
                (icmp-eq op 1) (icmp-le l r)
                (icmp-eq op 2) (icmp-gt l r)
                (icmp-eq op 3) (icmp-ge l r)
                (icmp-eq op 4) (icmp-eq l r)
                :else (icmp-ne l r))]
    (mk-gcev (when b 1) false)))

(defn g-const-eval [(g (ptr Cga)) (e (ptr Expr))] (-> GCEval)
  (let [a (load (field g a))]
    (match-else (load (field e kind))
                (EInt [v] (mk-gcev v false))
                (EBool [b] (mk-gcev (when b 1) false))
                (EIf [c thn els] (if (icmp-ne (gcev-v (g-const-eval g c)) 0) (g-const-eval g thn) (g-const-eval g els)))
                (ESizeOf [t] (mk-gcev (ty-size g (box-type a t)) false))
                (EAlignOf [t] (mk-gcev (ty-align g (box-type a t)) false))
                (EOffsetOf [t fname]
                           (match-else t
                                       (TStruct [nm]
                                                (let [si (g-struct-idx g nm)]
                                                  (when (icmp-lt si 0) (cgx-fail2 "offset-of on unknown struct: " nm))
                                                  (mk-gcev (g-field-off g si (g-field-idx g si fname)) false)))
                                       (_ (do (g-user-fail "static-assert: offset-of on non-struct") (mk-gcev 0 false)))))
                (ECast [t inner]
                       (mk-gcev (gcev-v (g-const-eval g inner)) (match-else t (TInt [bits s] (not s)) (_ false))))
                (EBin [op lhs rhs]
                      (let [lc (g-const-eval g lhs)
                            rc (g-const-eval g rhs)]
                        (g-const-bin op (gcev-v lc) (gcev-u lc) (gcev-v rc) (gcev-u rc))))
                (ECmp [op lhs rhs]
                      (let [lc (g-const-eval g lhs)
                            rc (g-const-eval g rhs)]
                        (g-const-cmp op (gcev-v lc) (gcev-u lc) (gcev-v rc) (gcev-u rc))))
                (_ (do
                     (g-user-fail "static-assert: only int literals, sizeof/alignof/offsetof, casts, arithmetic and comparisons are allowed")
                     (mk-gcev 0 false))))))

(defn g-eval-asserts! [(g (ptr Cga)) (mp (ptr Program))] (-> i64)
  (let [asserts (load (field mp asserts))
        n (al-len [StaticAssert] (load asserts))
        (mut i) 0]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (let [sa (xal-at [StaticAssert] asserts (load i))]
                  (when (icmp-eq (gcev-v (g-const-eval g (field sa cnd))) 0)
                        (let [w (stderr)]
                          (print-str w "error: static assertion failed: ")
                          (print-str w (load (field sa msg)))
                          (write-byte w (cast u8 10))
                          (cgx64.exit (cast i32 1))
                          0)))
                (store! i (iadd (load i) 1))))))
  0)

; ============================ driver =========================================
; Build the program's ELF object IN MEMORY. Serializing it to a file (the AOT
; path) is a thin wrapper over this, so the codegen happens exactly once, here.
(defn cgx64-build-eobj [(a (ptr Allocator))
                        (mp (ptr Program))
                        (mainpath (slice u8))
                        (compdir (slice u8))
                        (paths (ptr (ArrayList (slice u8))))
                        (texts (ptr (ArrayList (slice u8))))
                        (emit-dwarf bool)] (-> EObj)
  (let [g (alloc-stack Cga)]
    (store! (field g a) a)
    (store! (field g sigs) (al-new [GSig] a))
    (store! (field g obj) (eobj-new a))
    (store! (field g asm) (xasm-new a))
    (store! (field g strs) (al-new [GStr] a))
    (store! (field g nglob) 0)
    (store! (field g loops) (al-new [GLoop] a))
    (store! (field g env) (gscope-nil a))
    (store! (field g frame) 0)
    (store! (field g terminated) false)
    (store! (field g sretslot) -1)
    (store! (field g outbytes) 0)
    (store! (field g fnstart) 0)
    (store! (field g retty) (TInt 64 true))
    (store! (field g epilabel) 0)
    (store! (field g dwtys) (al-new [DwTy] a))
    (store! (field g dwfns) (al-new [DwFn] a))
    (store! (field g dwvars) (al-new [DwVar] a))
    (store! (field g dwevs) (al-new [DwLineEv] a))
    (store! (field g dwcursrc) -1)
    (store! (field g dwcurlo) -1)
    (store! (field g convs) (load (field mp conventions)))
    ; sections: ordinals are 1-based in push order.
    (store! (field g text)
            (eobj-add-sect! (mut (field g obj)) ".text" 16 (sht-progbits)
                            (ior (shf-alloc) (shf-execinstr))))
    (store! (field g constsec)
            (eobj-add-sect! (mut (field g obj)) ".rodata" 8 (sht-progbits) (shf-alloc)))
    (store! (field g datasec)
            (eobj-add-sect! (mut (field g obj)) ".data" 8 (sht-progbits)
                            (ior (shf-alloc) (shf-write))))
    ; without this the linker gives the whole program an executable stack
    (eobj-mark-nonexec-stack! (mut (field g obj)))
    (let [es (load (field mp exports))
          ne (al-len [ExportC] (load es))
          (mut ei) 0]
      (loop (if (icmp-ge (load ei) ne)
                (break)
                (do
                  (when (g-export-needs-thunk (xal-at [ExportC] es (load ei)))
                        (cgx-fail2 "export-c with a by-value struct parameter isn't supported by the x86-64 backend yet (it needs a C-ABI marshaling thunk); scalar/pointer params and struct returns work: "
                                   (load (field (xal-at [ExportC] es (load ei)) name))))
                  (store! ei (iadd (load ei) 1))))))
    (g-register-types! g mp)
    (g-eval-asserts! g mp)
    (g-register-sigs! g mp)
    (let [fs (load (field mp funcs))
          n (al-len [Func] (load fs))
          (mut i) 0]
      (loop (if (icmp-ge (load i) n)
                (break)
                (do
                  (emit-func! g (xal-at [Func] fs (load i)))
                  (store! i (iadd (load i) 1))))))
    ; move the emitted code into .text
    (xb-bytes! (mut (eobj-sect-buf (mut (field g obj)) (load (field g text))))
               (al-slice [u8] (load (field (field g asm) buf))))
    ; ---- DWARF
    (when emit-dwarf
          (let [ltmp (eobj-add-sym! (mut (field g obj)) ".Ltext0" (load (field g text)) 0 false)
                dw
                  (dw-build! a
                             mainpath
                             compdir
                             paths
                             texts
                             (mut (field g dwtys))
                             (mut (field g dwfns))
                             (mut (field g dwvars))
                             (mut (field g dwevs))
                             (al-len [u8] (load (field (field g asm) buf)))
                             ltmp
                             ; DWARF register 6 is rbp on x86-64.
                             6
                             ; A slot at offset k lives at rbx+k, and
                             ;   rbx = rsp + outbytes = (rbp - 8 - total) + outbytes
                             ; where total = slotbytes + outbytes + 8. So
                             ;   rbx + k = rbp - 16 - slotbytes + k
                             ; and dwarf.coil computes  k - (bias + slotbytes),
                             ; which is exactly right with bias = 16.
                             16)
                ; debug sections are not SHF_ALLOC: they exist in the file but are
                ; never loaded into the process image.
                sline (eobj-add-sect! (mut (field g obj)) ".debug_line" 1 (sht-progbits) 0)
                sinfo (eobj-add-sect! (mut (field g obj)) ".debug_info" 1 (sht-progbits) 0)
                sabbr (eobj-add-sect! (mut (field g obj)) ".debug_abbrev" 1 (sht-progbits) 0)
                sstr (eobj-add-sect! (mut (field g obj)) ".debug_str" 1 (sht-progbits) 0)]
            (xb-bytes! (mut (eobj-sect-buf (mut (field g obj)) sline)) (al-slice [u8] (load (load (field dw line)))))
            (xb-bytes! (mut (eobj-sect-buf (mut (field g obj)) sinfo)) (al-slice [u8] (load (load (field dw info)))))
            (xb-bytes! (mut (eobj-sect-buf (mut (field g obj)) sabbr)) (al-slice [u8] (load (load (field dw abbrev)))))
            (xb-bytes! (mut (eobj-sect-buf (mut (field g obj)) sstr)) (al-slice [u8] (load (load (field dw strs)))))
            ; Unlike the Mach-O path (where debug sections carry no relocations
            ; and ld64's debug map does the translation), ELF debug sections hold
            ; REAL relocations against .text: an absolute 64-bit address whose
            ; addend is the text offset the emitter recorded.
            (let [rl (load (field dw relocs))
                  nr (al-len [DwReloc] (load rl))
                  (mut i) 0]
              (loop (if (icmp-ge (load i) nr)
                        (break)
                        (do
                          (let [r (xal-at [DwReloc] rl (load i))
                                sect (if (icmp-eq (load (field r sect)) 1) sinfo sline)
                                buf (eobj-sect-buf (mut (field g obj)) sect)
                                ; the emitter left the text offset in the slot; it
                                ; becomes the relocation's addend and the slot is
                                ; zeroed so the linker writes the final address.
                                addend (ior (cast i64 (al-get [u8] (load buf) (load (field r off))))
                                            (ior (ishl (cast i64 (al-get [u8] (load buf) (iadd (load (field r off)) 1))) 8)
                                                 (ior (ishl (cast i64 (al-get [u8] (load buf) (iadd (load (field r off)) 2))) 16)
                                                      (ishl (cast i64 (al-get [u8] (load buf) (iadd (load (field r off)) 3))) 24))))]
                            (eobj-add-reloc! (mut (field g obj))
                                             sect
                                             (load (field r off))
                                             ltmp
                                             (r-x86-64-64)
                                             addend))
                          (store! i (iadd (load i) 1))))))))
    (load (field g obj))))

; serialize a built object to disk — the AOT path.
(defn cgx64-build-object [(a (ptr Allocator))
                          (mp (ptr Program))
                          (objpath (ptr i8))
                          (mainpath (slice u8))
                          (compdir (slice u8))
                          (paths (ptr (ArrayList (slice u8))))
                          (texts (ptr (ArrayList (slice u8))))
                          (emit-dwarf bool)] (-> i64)
  (let [(mut o) (cgx64-build-eobj a mp mainpath compdir paths texts emit-dwarf)
        bytes (elf-write (mut o))
        fd (cgx64.creat objpath 420)]
    (when (icmp-lt fd 0) (cgx-fail "cannot create object file"))
    (let [total (al-len [u8] (load bytes))
          (mut off) 0]
      (loop (if (icmp-ge (load off) total)
                (break)
                (do
                  (let [wrote
                          (cgx64.write (cast i32 fd)
                                       (cast (ptr i8) (index (slice-data (al-slice [u8] (load bytes))) (load off)))
                                       (cast isize (isub total (load off))))]
                    (when (icmp-le wrote 0) (cgx-fail "object write failed"))
                    (store! off (iadd (load off) (cast i64 wrote))))))))
    (cgx64.close (cast i32 fd))
    0))
