; src/compiler/macho.coil — Mach-O MH_OBJECT (.o) writer for the arm64 backend.
; Zero dependencies: composes the object file byte-by-byte.
;
; Model: the caller builds sections (byte buffers), a symbol list, and a
; relocation list, then `macho-write` lays out and serializes the object.
;  - symbols reference sections by ORDINAL (1-based, in push order; 0 = undefined)
;  - relocations reference symbols by index into the caller's symbol list;
;    the writer sorts symbols into (local, external-defined, undefined) order
;    as LC_DYSYMTAB requires and remaps relocation symbol numbers.
(module macho)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "match.coil" :use *)
(import "a64.coil" :use *)

; arm64 relocation types (r_type)
(defn reloc-unsigned [] (-> i64)
  0)  ; 8-byte absolute pointer
(defn reloc-branch26 [] (-> i64)
  2)  ; bl/b imm26
(defn reloc-page21 [] (-> i64)
  3)  ; adrp
(defn reloc-pageoff12 [] (-> i64)
  4)  ; add/ldr :lo12:

(defstruct MSect
  [(segname (slice u8))
   (sectname (slice u8))
   (buf (ArrayList u8))
   (align i64)
   (flags i64)])
(defstruct MSym
  [(name (slice u8)) (sect i64) (off i64) (ext bool)])
(defstruct MReloc
  [(sect i64)  ; section ordinal the fixup lives in (1-based)
   (off i64)  ; byte offset of the fixup within that section
   (sym i64)  ; caller symbol index
   (rtype i64)
   (pcrel bool)
   (len i64)])  ; len: 2 = 4 bytes, 3 = 8 bytes

(defstruct MObj
  [(sects (ArrayList MSect))
   (syms (ArrayList MSym))
   (relocs (ArrayList MReloc))
   (a (ptr Allocator))])

(defn mobj-new [(a (ptr Allocator))] (-> MObj)
  (let [p (alloc/stack MObj)]
    (primitive/store! (primitive/field p sects) (al-new [MSect] a))
    (primitive/store! (primitive/field p syms) (al-new [MSym] a))
    (primitive/store! (primitive/field p relocs) (al-new [MReloc] a))
    (primitive/store! (primitive/field p a) a)
    (primitive/load p)))

; add a section; returns its 1-based ordinal.
(defn mobj-add-sect! [(o (mut MObj)) (seg (slice u8)) (sect (slice u8)) (align i64) (flags i64)] (-> i64)
  (let [s (alloc/stack MSect)]
    (primitive/store! (primitive/field s segname) seg)
    (primitive/store! (primitive/field s sectname) sect)
    (primitive/store! (primitive/field s buf) (al-new [u8] (primitive/load (primitive/field o a))))
    (primitive/store! (primitive/field s align) align)
    (primitive/store! (primitive/field s flags) flags)
    (al-push! (mut (primitive/field o sects)) (primitive/load s))
    (al-len [MSect] (primitive/load (primitive/field o sects)))))

; add a symbol; returns its index (caller-side numbering used by relocs).
(defn mobj-add-sym! [(o (mut MObj)) (name (slice u8)) (sect i64) (off i64) (ext bool)] (-> i64)
  (let [s (alloc/stack MSym)]
    (primitive/store! (primitive/field s name) name)
    (primitive/store! (primitive/field s sect) sect)
    (primitive/store! (primitive/field s off) off)
    (primitive/store! (primitive/field s ext) ext)
    (al-push! (mut (primitive/field o syms)) (primitive/load s))
    (primitive/isub (al-len [MSym] (primitive/load (primitive/field o syms))) 1)))

(defn mobj-add-reloc! [(o (mut MObj)) (sect i64) (off i64) (sym i64) (rtype i64) (pcrel bool) (len i64)] (-> i64)
  (let [r (alloc/stack MReloc)]
    (primitive/store! (primitive/field r sect) sect)
    (primitive/store! (primitive/field r off) off)
    (primitive/store! (primitive/field r sym) sym)
    (primitive/store! (primitive/field r rtype) rtype)
    (primitive/store! (primitive/field r pcrel) pcrel)
    (primitive/store! (primitive/field r len) len)
    (al-push! (mut (primitive/field o relocs)) (primitive/load r))
    0))

; pointer to the byte buffer of section `ord` (1-based) — the caller emits into it.
(defn mobj-sect-buf [(o (mut MObj)) (ord i64)] (-> (ptr (ArrayList u8)))
  (primitive/field (al-at [MSect] (primitive/field o sects) (primitive/isub ord 1)) buf))
(defn mobj-sect-len [(o (mut MObj)) (ord i64)] (-> i64)
  (al-len [u8] (primitive/load (primitive/field (al-at [MSect] (primitive/field o sects) (primitive/isub ord 1)) buf))))

; write a fixed-width (16-byte, NUL-padded) segment/section name
(defn mo-name16! [(b (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) 16)
              (break)
              (do
                (if (primitive/icmp-lt (primitive/load i) n)
                    (al-push! (mut b) (slice-get s (primitive/load i)))
                    (al-push! (mut b) (primitive/cast u8 0)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)

(defn align-up [(v i64) (align i64)] (-> i64)
  (let [rem (primitive/urem v align)]
    (if (primitive/icmp-eq rem 0) v (primitive/iadd v (primitive/isub align rem)))))
(defn pow2 [(n i64)] (-> i64)
  (primitive/ishl 1 n))

; ============================ serialization ==================================
; Layout:  header | segment cmd (+sections) | build-version | symtab | dysymtab
;          | section contents | relocations | nlist symtab | string table
(defn macho-write [(o (mut MObj))] (-> (ptr (ArrayList u8)))
  (let [a (primitive/load (primitive/field o a))
        nsect (al-len [MSect] (primitive/load (primitive/field o sects)))
        nsym (al-len [MSym] (primitive/load (primitive/field o syms)))
        nrel (al-len [MReloc] (primitive/load (primitive/field o relocs)))
        ; ---- symbol permutation: locals, then external defined, then undefined.
        ; order[i] = caller index of the i-th nlist entry; perm[caller] = nlist idx.
        (mut order) (al-new [i64] a)
        (mut perm) (al-new [i64] a)
        (mut nlocal) 0
        (mut nextdef) 0
        (mut nundef) 0]
    (let [(mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) nsym)
                (break)
                (do (al-push! (mut perm) 0) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    ; pass 1: locals (defined, not ext)
    (let [(mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) nsym)
                (break)
                (do
                  (let [sp (al-at [MSym] (primitive/field o syms) (primitive/load i))]
                    (when (and (primitive/icmp-ne (primitive/load (primitive/field sp sect)) 0) (not (primitive/load (primitive/field sp ext))))
                          (al-set! (mut perm) (primitive/load i) (al-len [i64] (primitive/load order)))
                          (al-push! (mut order) (primitive/load i))
                          (primitive/store! nlocal (primitive/iadd (primitive/load nlocal) 1))
                          0))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    ; pass 2: external defined
    (let [(mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) nsym)
                (break)
                (do
                  (let [sp (al-at [MSym] (primitive/field o syms) (primitive/load i))]
                    (when (and (primitive/icmp-ne (primitive/load (primitive/field sp sect)) 0) (primitive/load (primitive/field sp ext)))
                          (al-set! (mut perm) (primitive/load i) (al-len [i64] (primitive/load order)))
                          (al-push! (mut order) (primitive/load i))
                          (primitive/store! nextdef (primitive/iadd (primitive/load nextdef) 1))
                          0))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    ; pass 3: undefined
    (let [(mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) nsym)
                (break)
                (do
                  (let [sp (al-at [MSym] (primitive/field o syms) (primitive/load i))]
                    (when (primitive/icmp-eq (primitive/load (primitive/field sp sect)) 0)
                          (al-set! (mut perm) (primitive/load i) (al-len [i64] (primitive/load order)))
                          (al-push! (mut order) (primitive/load i))
                          (primitive/store! nundef (primitive/iadd (primitive/load nundef) 1))
                          0))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    ; ---- addresses: sections are laid out consecutively from vmaddr 0.
    (let [(mut addrs) (al-new [i64] a)
          (mut vm) 0]
      (let [(mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) nsect)
                  (break)
                  (do
                    (let [sp (al-at [MSect] (primitive/field o sects) (primitive/load i))]
                      (primitive/store! vm (align-up (primitive/load vm) (pow2 (primitive/load (primitive/field sp align)))))
                      (al-push! (mut addrs) (primitive/load vm))
                      (primitive/store! vm (primitive/iadd (primitive/load vm) (al-len [u8] (primitive/load (primitive/field sp buf))))))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
      ; ---- file offsets
      (let [ncmds 4
            sizeofcmds (primitive/iadd (primitive/iadd 72 (primitive/imul 80 nsect)) (primitive/iadd 24 (primitive/iadd 24 80)))
            hdrend (primitive/iadd 32 sizeofcmds)
            (mut foffs) (al-new [i64] a)
            (mut fo) hdrend]
        (let [(mut i) 0]
          (loop (if (primitive/icmp-ge (primitive/load i) nsect)
                    (break)
                    (do
                      (let [sp (al-at [MSect] (primitive/field o sects) (primitive/load i))]
                        (primitive/store! fo (align-up (primitive/load fo) (pow2 (primitive/load (primitive/field sp align)))))
                        (al-push! (mut foffs) (primitive/load fo))
                        (primitive/store! fo (primitive/iadd (primitive/load fo) (al-len [u8] (primitive/load (primitive/field sp buf))))))
                      (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
        ; relocations: grouped per section, 8-byte aligned
        (primitive/store! fo (align-up (primitive/load fo) 8))
        (let [(mut reloffs) (al-new [i64] a)
              (mut nrelocs) (al-new [i64] a)]
          (let [(mut si) 0]
            (loop (if (primitive/icmp-ge (primitive/load si) nsect)
                      (break)
                      (do
                        (let [(mut cnt) 0
                              (mut ri) 0]
                          (loop (if (primitive/icmp-ge (primitive/load ri) nrel)
                                    (break)
                                    (do
                                      (when (primitive/icmp-eq (primitive/load (primitive/field (al-at [MReloc] (primitive/field o relocs) (primitive/load ri)) sect))
                                                     (primitive/iadd (primitive/load si) 1))
                                            (primitive/store! cnt (primitive/iadd (primitive/load cnt) 1)))
                                      (primitive/store! ri (primitive/iadd (primitive/load ri) 1)))))
                          (al-push! (mut reloffs) (when (primitive/icmp-gt (primitive/load cnt) 0) (primitive/load fo)))
                          (al-push! (mut nrelocs) (primitive/load cnt))
                          (primitive/store! fo (primitive/iadd (primitive/load fo) (primitive/imul 8 (primitive/load cnt)))))
                        (primitive/store! si (primitive/iadd (primitive/load si) 1))))))
          (let [symoff (align-up (primitive/load fo) 8)
                stroff (primitive/iadd symoff (primitive/imul 16 nsym))
                ; ---- string table (primitive/index 0 = NUL)
                (mut strtab) (al-new [u8] a)
                (mut strx) (al-new [i64] a)]
            (al-push! (mut strtab) (primitive/cast u8 0))
            ; strx is per NLIST order
            (let [(mut i) 0]
              (loop (if (primitive/icmp-ge (primitive/load i) nsym)
                        (break)
                        (do
                          (let [ci (al-get [i64] (primitive/load order) (primitive/load i))
                                sp (al-at [MSym] (primitive/field o syms) ci)]
                            (al-push! (mut strx) (al-len [u8] (primitive/load strtab)))
                            (b-bytes! (mut strtab) (primitive/load (primitive/field sp name)))
                            (al-push! (mut strtab) (primitive/cast u8 0)))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
            (let [strsize (al-len [u8] (primitive/load strtab))
                  (mut out) (al-new [u8] a)]
              ; ================= header =================
              (b-u32! (mut out) 4277009103)  ; MH_MAGIC_64 0xFEEDFACF
              (b-u32! (mut out) 16777228)  ; CPU_TYPE_ARM64
              (b-u32! (mut out) 0)  ; CPU_SUBTYPE_ARM64_ALL
              (b-u32! (mut out) 1)  ; MH_OBJECT
              (b-u32! (mut out) ncmds)
              (b-u32! (mut out) sizeofcmds)
              (b-u32! (mut out) 8192)  ; MH_SUBSECTIONS_VIA_SYMBOLS
              (b-u32! (mut out) 0)  ; reserved
              ; ================= LC_SEGMENT_64 =================
              (b-u32! (mut out) 25)  ; LC_SEGMENT_64
              (b-u32! (mut out) (primitive/iadd 72 (primitive/imul 80 nsect)))
              (mo-name16! (mut out) "")  ; segname (unnamed in objects)
              (b-u64! (mut out) 0)  ; vmaddr
              (b-u64! (mut out) (primitive/load vm))  ; vmsize
              (b-u64! (mut out) (if (primitive/icmp-gt nsect 0) (al-get [i64] (primitive/load foffs) 0) hdrend))  ; fileoff
              ; filesize = end of the last section's contents - fileoff (relocs excluded)
              (b-u64! (mut out)
                      (when (primitive/icmp-gt nsect 0)
                            (primitive/isub (primitive/iadd (al-get [i64] (primitive/load foffs) (primitive/isub nsect 1))
                                        (al-len [u8] (primitive/load (primitive/field (al-at [MSect] (primitive/field o sects) (primitive/isub nsect 1)) buf))))
                                  (al-get [i64] (primitive/load foffs) 0))))
              (b-u32! (mut out) 7)  ; maxprot rwx
              (b-u32! (mut out) 7)  ; initprot rwx
              (b-u32! (mut out) nsect)
              (b-u32! (mut out) 0)  ; flags
              ; section headers
              (let [(mut i) 0]
                (loop (if (primitive/icmp-ge (primitive/load i) nsect)
                          (break)
                          (do
                            (let [sp (al-at [MSect] (primitive/field o sects) (primitive/load i))]
                              (mo-name16! (mut out) (primitive/load (primitive/field sp sectname)))
                              (mo-name16! (mut out) (primitive/load (primitive/field sp segname)))
                              (b-u64! (mut out) (al-get [i64] (primitive/load addrs) (primitive/load i)))
                              (b-u64! (mut out) (al-len [u8] (primitive/load (primitive/field sp buf))))
                              (b-u32! (mut out) (al-get [i64] (primitive/load foffs) (primitive/load i)))
                              (b-u32! (mut out) (primitive/load (primitive/field sp align)))
                              (b-u32! (mut out) (al-get [i64] (primitive/load reloffs) (primitive/load i)))
                              (b-u32! (mut out) (al-get [i64] (primitive/load nrelocs) (primitive/load i)))
                              (b-u32! (mut out) (primitive/load (primitive/field sp flags)))
                              (b-u32! (mut out) 0)
                              (b-u32! (mut out) 0)
                              (b-u32! (mut out) 0))
                            (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
              ; ================= LC_BUILD_VERSION =================
              (b-u32! (mut out) 50)  ; LC_BUILD_VERSION
              (b-u32! (mut out) 24)
              (b-u32! (mut out) 1)  ; PLATFORM_MACOS
              (b-u32! (mut out) 720896)  ; minos 11.0.0
              (b-u32! (mut out) 0)  ; sdk
              (b-u32! (mut out) 0)  ; ntools
              ; ================= LC_SYMTAB =================
              (b-u32! (mut out) 2)  ; LC_SYMTAB
              (b-u32! (mut out) 24)
              (b-u32! (mut out) symoff)
              (b-u32! (mut out) nsym)
              (b-u32! (mut out) stroff)
              (b-u32! (mut out) strsize)
              ; ================= LC_DYSYMTAB =================
              (b-u32! (mut out) 11)  ; LC_DYSYMTAB
              (b-u32! (mut out) 80)
              (b-u32! (mut out) 0)  ; ilocalsym
              (b-u32! (mut out) (primitive/load nlocal))  ; nlocalsym
              (b-u32! (mut out) (primitive/load nlocal))  ; iextdefsym
              (b-u32! (mut out) (primitive/load nextdef))  ; nextdefsym
              (b-u32! (mut out) (primitive/iadd (primitive/load nlocal) (primitive/load nextdef)))  ; iundefsym
              (b-u32! (mut out) (primitive/load nundef))  ; nundefsym
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              ; ================= section contents =================
              (let [(mut i) 0]
                (loop (if (primitive/icmp-ge (primitive/load i) nsect)
                          (break)
                          (do
                            (let [sp (al-at [MSect] (primitive/field o sects) (primitive/load i))]
                              (b-zeros! (mut out) (primitive/isub (al-get [i64] (primitive/load foffs) (primitive/load i)) (al-len [u8] (primitive/load out))))
                              (b-bytes! (mut out) (al-slice [u8] (primitive/load (primitive/field sp buf)))))
                            (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
              ; ================= relocations (grouped per section) =================
              (b-zeros! (mut out) (primitive/isub (align-up (al-len [u8] (primitive/load out)) 8) (al-len [u8] (primitive/load out))))
              (let [(mut si) 0]
                (loop (if (primitive/icmp-ge (primitive/load si) nsect)
                          (break)
                          (do
                            (let [(mut ri) 0]
                              (loop (if (primitive/icmp-ge (primitive/load ri) nrel)
                                        (break)
                                        (do
                                          (let [rp (al-at [MReloc] (primitive/field o relocs) (primitive/load ri))]
                                            (when (primitive/icmp-eq (primitive/load (primitive/field rp sect)) (primitive/iadd (primitive/load si) 1))
                                                  (b-u32! (mut out) (primitive/load (primitive/field rp off)))
                                                  ; sym < 0 is a SECTION relocation (r_extern = 0):
                                                  ; symbolnum is the target SECTION ordinal (-sym), not
                                                  ; a symbol index — the DWARF-address scheme dsymutil
                                                  ; wants. sym >= 0 is the usual extern symbol reloc.
                                                  (let [secreloc (primitive/icmp-lt (primitive/load (primitive/field rp sym)) 0)
                                                        snum
                                                          (if secreloc
                                                              (primitive/isub 0 (primitive/load (primitive/field rp sym)))
                                                              (al-get [i64] (primitive/load perm) (primitive/load (primitive/field rp sym))))]
                                                    (b-u32! (mut out)
                                                            (primitive/ior (primitive/iand snum 16777215)
                                                                 (primitive/ior (primitive/ishl (when (primitive/load (primitive/field rp pcrel)) 1) 24)
                                                                      (primitive/ior (primitive/ishl (primitive/load (primitive/field rp len)) 25)
                                                                           (primitive/ior (primitive/ishl (unless secreloc 1) 27)  ; r_extern
                                                                                (primitive/ishl (primitive/load (primitive/field rp rtype)) 28)))))))
                                                  0))
                                          (primitive/store! ri (primitive/iadd (primitive/load ri) 1))))))
                            (primitive/store! si (primitive/iadd (primitive/load si) 1))))))
              ; ================= nlist symbol table =================
              (b-zeros! (mut out) (primitive/isub symoff (al-len [u8] (primitive/load out))))
              (let [(mut i) 0]
                (loop (if (primitive/icmp-ge (primitive/load i) nsym)
                          (break)
                          (do
                            (let [ci (al-get [i64] (primitive/load order) (primitive/load i))
                                  sp (al-at [MSym] (primitive/field o syms) ci)]
                              (b-u32! (mut out) (al-get [i64] (primitive/load strx) (primitive/load i)))
                              (if (primitive/icmp-eq (primitive/load (primitive/field sp sect)) 0)
                                  (do
                                    (b-u8! (mut out) 1)  ; N_UNDF | N_EXT
                                    (b-u8! (mut out) 0)  ; NO_SECT
                                    (b-u16! (mut out) 0)  ; n_desc
                                    (b-u64! (mut out) 0)
                                    0)
                                  (do
                                    (b-u8! (mut out) (primitive/ior 14 (when (primitive/load (primitive/field sp ext)) 1)))  ; N_SECT (|N_EXT)
                                    (b-u8! (mut out) (primitive/load (primitive/field sp sect)))
                                    (b-u16! (mut out) 0)
                                    (b-u64! (mut out)
                                            (primitive/iadd (al-get [i64] (primitive/load addrs) (primitive/isub (primitive/load (primitive/field sp sect)) 1))
                                                  (primitive/load (primitive/field sp off))))
                                    0)))
                            (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
              ; ================= string table =================
              (b-bytes! (mut out) (al-slice [u8] (primitive/load strtab)))
              (let [bp (unwrap-ptr [(ArrayList u8)] (create [(ArrayList u8)] a))]
                (primitive/store! bp (primitive/load out))
                bp))))))))
