; src/compiler/reader.coil — self-host Coil compiler, reader module.
(module reader)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ffi.coil" :use *)
(import "ast.coil" :use *)

(defsum SexpKind
  (KInt [(v i64)])
  (KFloat [(bits i64)])
  (KSym [(s (slice u8))])
  (KKw [(s (slice u8))])
  (KStr [(s (slice u8))])
  (KCStr [(s (slice u8))])
  (KList [(items (ptr (ArrayList Sexp)))])
  (KVec [(items (ptr (ArrayList Sexp)))]))

; `nid` = a stable, unique NODE ID assigned at construction (see next-nid / mk-sexp).
; It is NEVER emitted by the canonical dumper, so the oracle stays byte-exact; it lets
; a metaprogram key on node IDENTITY (exact `type-of`) rather than the source span,
; which macro-duplicated subtrees can share.
(defstruct Sexp [(kind SexpKind) (lo i64) (hi i64) (source i64) (ctxt i64) (nid i64)])

(defsum TokKind
  (TOpen [(c i64)])
  (TClose [(c i64)])
  (TPrefix [(s (slice u8))])
  (TStr [(s (slice u8))])
  (TCStr [(s (slice u8))])
  (TChar [(v i64)])
  (TAtom [(s (slice u8))]))

(defstruct Tok [(kind TokKind) (lo i64) (hi i64)])
(defstruct Parser [(toks (ptr (ArrayList Tok))) (pos i64)])
(defstruct StrRead [(s (slice u8)) (end i64)])

; ============================ AST representation =============================
; Mirrors. Recursion goes through (ptr Expr) / (ptr Type) (single
; box) and (ptr (ArrayList X)) (a sequence), like reader.coil/Sexp. Spans live as
; raw i64 lo/hi (dummy = -1), exactly as the reader stores them.

; Type — 14 constructable variants.
(defn looks-numeric [(s (slice u8))] (-> bool)
  (let [n (slice-len s)]
    (if (primitive/icmp-eq n 0)
        false
        (let [c0 (primitive/cast i64 (slice-get s 0))]
          (if (and (primitive/icmp-ge c0 48) (primitive/icmp-le c0 57))
              true
              (if (and (or (primitive/icmp-eq c0 45) (or (primitive/icmp-eq c0 43) (primitive/icmp-eq c0 46))) (primitive/icmp-ge n 2))
                  (let [c1 (primitive/cast i64 (slice-get s 1))] (and (primitive/icmp-ge c1 48) (primitive/icmp-le c1 57)))
                  false))))))

(defn parse-int [(s (slice u8))] (-> (Option i64))
  (let [n (slice-len s)]
    (let [dec
            (if (primitive/icmp-eq n 0)
                (None [i64])
                (let [(mut i) 0
                      (mut neg) false]
                  (let [c0 (primitive/cast i64 (slice-get s 0))]
                    (if (primitive/icmp-eq c0 45)
                        (do (primitive/store! neg true) (primitive/store! i 1))
                        (when (primitive/icmp-eq c0 43) (primitive/store! i 1))))
                  (if (primitive/icmp-ge (primitive/load i) n)
                      (None [i64])
                      (let [(mut mag) 0
                            (mut ok) true
                            (mut overflow) false
                            maxrem (if (primitive/load neg) 8 7)]
                        (loop (if (primitive/icmp-ge (primitive/load i) n)
                                  (break)
                                  (let [c (primitive/cast i64 (slice-get s (primitive/load i)))]
                                    (if (and (primitive/icmp-ge c 48) (primitive/icmp-le c 57))
                                        (let [d (primitive/isub c 48)]
                                          (if (or (primitive/icmp-gt (primitive/load mag) 922337203685477580)
                                                  (and (primitive/icmp-eq (primitive/load mag) 922337203685477580) (primitive/icmp-gt d maxrem)))
                                              (do (primitive/store! overflow true) (break))
                                              (do
                                                (primitive/store! mag (primitive/iadd (primitive/imul (primitive/load mag) 10) d))
                                                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                                        (do (primitive/store! ok false) (break))))))
                        (if (or (not (primitive/load ok)) (primitive/load overflow))
                            (None [i64])
                            (Some (if (primitive/load neg) (primitive/isub 0 (primitive/load mag)) (primitive/load mag))))))))]
      (match dec
        (Some [v] (Some v))
        (None []
              (if (primitive/icmp-eq n 0)
                  (None [i64])
                  (let [(mut neg2) false
                        (mut bstart) 0]
                    (let [c0 (primitive/cast i64 (slice-get s 0))]
                      (if (primitive/icmp-eq c0 45)
                          (do (primitive/store! neg2 true) (primitive/store! bstart 1))
                          (when (primitive/icmp-eq c0 43) (primitive/store! bstart 1))))
                    (let [blen (primitive/isub n (primitive/load bstart))
                          (mut radix) 0
                          (mut dstart) (primitive/load bstart)]
                      (when (and (primitive/icmp-ge blen 2) (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/load bstart))) 48))
                            (let [c1 (primitive/cast i64 (slice-get s (primitive/iadd (primitive/load bstart) 1)))]
                              (cond (or (primitive/icmp-eq c1 120) (primitive/icmp-eq c1 88))
                                      (do (primitive/store! radix 16) (primitive/store! dstart (primitive/iadd (primitive/load bstart) 2)))
                                    (or (primitive/icmp-eq c1 98) (primitive/icmp-eq c1 66))
                                      (do (primitive/store! radix 2) (primitive/store! dstart (primitive/iadd (primitive/load bstart) 2)))
                                    (or (primitive/icmp-eq c1 111) (primitive/icmp-eq c1 79))
                                      (do (primitive/store! radix 8) (primitive/store! dstart (primitive/iadd (primitive/load bstart) 2)))
                                    :else 0)))
                      (when (primitive/icmp-eq (primitive/load radix) 0)
                            (let [body (subslice s (primitive/load bstart) n)
                                  has-us
                                    (do
                                      (let [(mut f) false
                                            (mut j) (primitive/load bstart)]
                                        (loop (if (primitive/icmp-ge (primitive/load j) n)
                                                  (break)
                                                  (do
                                                    (when (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/load j))) 95)
                                                          (primitive/store! f true)
                                                          0)
                                                    (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                                        (primitive/load f)))]
                              (when (and has-us (looks-numeric body)) (primitive/store! radix 10) (primitive/store! dstart (primitive/load bstart)))))
                      (if (primitive/icmp-eq (primitive/load radix) 0)
                          (None [i64])
                          (let [(mut mag) 0
                                (mut count) 0
                                (mut bad) false
                                (mut ovf) false
                                (mut j) (primitive/load dstart)
                                rr (primitive/load radix)]
                            (loop (if (primitive/icmp-ge (primitive/load j) n)
                                      (break)
                                      (let [c (primitive/cast i64 (slice-get s (primitive/load j)))]
                                        (primitive/store! j (primitive/iadd (primitive/load j) 1))
                                        (unless (primitive/icmp-eq c 95)
                                                (let [dv
                                                        (let [v0
                                                                (cond (and (primitive/icmp-ge c 48) (primitive/icmp-le c 57)) (primitive/isub c 48)
                                                                      (and (primitive/icmp-ge c 97) (primitive/icmp-le c 122))
                                                                        (primitive/iadd (primitive/isub c 97) 10)
                                                                      (and (primitive/icmp-ge c 65) (primitive/icmp-le c 90))
                                                                        (primitive/iadd (primitive/isub c 65) 10)
                                                                      :else -1)]
                                                          (if (or (primitive/icmp-lt v0 0) (primitive/icmp-ge v0 rr)) -1 v0))]
                                                  (if (primitive/icmp-lt dv 0)
                                                      (do (primitive/store! bad true) (break))
                                                      (let [maxdiv (primitive/udiv -1 rr)
                                                            maxrem (primitive/urem -1 rr)]
                                                        (if (or (primitive/icmp-gt (primitive/cast u64 (primitive/load mag)) (primitive/cast u64 maxdiv))
                                                                (and (primitive/icmp-eq (primitive/load mag) maxdiv)
                                                                     (primitive/icmp-gt (primitive/cast u64 dv) (primitive/cast u64 maxrem))))
                                                            (do (primitive/store! ovf true) (break))
                                                            (do
                                                              (primitive/store! mag (primitive/iadd (primitive/imul (primitive/load mag) rr) dv))
                                                              (primitive/store! count (primitive/iadd (primitive/load count) 1)))))))))))
                            (if (or (primitive/load bad) (or (primitive/load ovf) (primitive/icmp-eq (primitive/load count) 0)))
                                (None [i64])
                                (Some (if (primitive/load neg2) (primitive/isub 0 (primitive/load mag)) (primitive/load mag))))))))))))))

; Takes the caller's allocator rather than grabbing `malloc-allocator` itself: the
; `slice->cstr` below is a per-token scratch C string for `strtod`, so it belongs to
; whatever allocator the compile is running on. Grabbing the global one here put it on
; malloc no matter what the pipeline was threading.
(defn atom [(a (ptr Allocator)) (s (slice u8))] (-> SexpKind)
  (let [n (slice-len s)]
    (if (and (primitive/icmp-gt n 0) (primitive/icmp-eq (primitive/cast i64 (slice-get s 0)) 58))
        (KKw (subslice s 1 n))
        (match (parse-int s)
          (Some [v] (KInt v))
          (None []
                (if (and (looks-numeric s)
                         (do
                           (let [(mut f) false
                                 (mut j) 0]
                             (loop (if (primitive/icmp-ge (primitive/load j) n)
                                       (break)
                                       (do
                                         (let [c (primitive/cast i64 (slice-get s (primitive/load j)))]
                                           (when (or (primitive/icmp-eq c 46) (or (primitive/icmp-eq c 101) (primitive/icmp-eq c 69)))
                                                 (primitive/store! f true)
                                                 0))
                                         (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                             (primitive/load f))))
                    (let [buf (slice->cstr a s)
                          ep (alloc/stack (ptr i8))
                          x (strtod buf ep)
                          consumed (primitive/isub (primitive/cast i64 (primitive/load ep)) (primitive/cast i64 buf))]
                      (if (and (primitive/icmp-gt n 0) (primitive/icmp-eq consumed n)) (KFloat (f64-bits x)) (KSym s)))
                    (KSym s)))))))

(defn read-string-body [(a (ptr Allocator)) (src (slice u8)) (open-off i64) (i i64)] (-> (Result StrRead Diag))
  (let [n (slice-len src)
        (mut buf) (al-new [u8] a)
        (mut k) i
        (mut out) (primitive/zeroed (Result StrRead Diag))]
    (loop (if (primitive/icmp-ge (primitive/load k) n)
              (do (primitive/store! out (Err (mk-diag open-off n "unterminated string literal"))) (break))
              (let [c (primitive/cast i64 (slice-get src (primitive/load k)))]
                (primitive/store! k (primitive/iadd (primitive/load k) 1))
                (if (primitive/icmp-eq c 34)
                    (do (primitive/store! out (Ok (mk-strread (al-slice [u8] (primitive/load buf)) (primitive/load k)))) (break))
                    (if (primitive/icmp-eq c 92)
                        (if (primitive/icmp-ge (primitive/load k) n)
                            (do (primitive/store! out (Err (mk-diag open-off n "unterminated string escape"))) (break))
                            (let [e (primitive/cast i64 (slice-get src (primitive/load k)))]
                              (primitive/store! k (primitive/iadd (primitive/load k) 1))
                              (al-push! (mut buf)
                                        (primitive/cast u8
                                              (cond (primitive/icmp-eq e 110) 10
                                                    (primitive/icmp-eq e 116) 9
                                                    (primitive/icmp-eq e 34) 34
                                                    (primitive/icmp-eq e 92) 92
                                                    :else e)))))
                        (al-push! (mut buf) (primitive/cast u8 c)))))))
    (primitive/load out)))

; ---- character literals: \a \) \newline \space \tab A -------------------
; A `\` starts a char literal. A single char after it (\a, \), \") is that byte;
; an alphabetic run is a name (\newline \space \tab \return \nul \backspace
; \formfeed) or \uHEX. Lexes to a plain integer literal (KInt), so it is just
; sugar: `(= (primitive/cast i64 byte) \a)` needs no new type machinery.
(defn sh-is-alpha [(c i64)] (-> bool)
  (or (and (primitive/icmp-ge c 97) (primitive/icmp-le c 122)) (and (primitive/icmp-ge c 65) (primitive/icmp-le c 90))))
(defn sh-is-alnum [(c i64)] (-> bool)
  (or (sh-is-alpha c) (and (primitive/icmp-ge c 48) (primitive/icmp-le c 57))))
(defn sh-hex-digit [(c i64)] (-> i64)
  (cond (and (primitive/icmp-ge c 48) (primitive/icmp-le c 57)) (primitive/isub c 48)
        (and (primitive/icmp-ge c 97) (primitive/icmp-le c 102)) (primitive/iadd (primitive/isub c 97) 10)
        (and (primitive/icmp-ge c 65) (primitive/icmp-le c 70)) (primitive/iadd (primitive/isub c 65) 10)
        :else -1))
(defn char-name-code [(s (slice u8))] (-> i64)
  (cond (str-eq s "space") 32
        (str-eq s "newline") 10
        (str-eq s "tab") 9
        (str-eq s "return") 13
        (str-eq s "nul") 0
        (str-eq s "null") 0
        (str-eq s "backspace") 8
        (str-eq s "formfeed") 12
        :else  ; \uHEX
          (let [n (slice-len s)]
            (if (and (primitive/icmp-ge n 2) (primitive/icmp-eq (primitive/cast i64 (slice-get s 0)) 117))
                (let [(mut v) 0
                      (mut j) 1
                      (mut ok) true]
                  (loop (if (primitive/icmp-ge (primitive/load j) n)
                            (break)
                            (let [d (sh-hex-digit (primitive/cast i64 (slice-get s (primitive/load j))))]
                              (if (primitive/icmp-lt d 0)
                                  (do (primitive/store! ok false) (break))
                                  (do
                                    (primitive/store! v (primitive/iadd (primitive/imul (primitive/load v) 16) d))
                                    (primitive/store! j (primitive/iadd (primitive/load j) 1)))))))
                  (if (primitive/load ok) (primitive/load v) -1))
                -1))))

(defn tokenize [(a (ptr Allocator)) (src (slice u8))] (-> (Result (ptr (ArrayList Tok)) Diag))
  (let [n (slice-len src)
        (mut toks) (al-new [Tok] a)
        (mut i) 0
        (mut out) (primitive/zeroed (Result (ptr (ArrayList Tok)) Diag))
        (mut done) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get src (primitive/load i)))]
                (cond (or (primitive/icmp-eq c 32)
                          (or (primitive/icmp-eq c 9) (or (primitive/icmp-eq c 10) (or (primitive/icmp-eq c 13) (or (primitive/icmp-eq c 11) (primitive/icmp-eq c 12))))))
                        (primitive/store! i (primitive/iadd (primitive/load i) 1))
                      (primitive/icmp-eq c 59)
                        (loop (if (primitive/icmp-ge (primitive/load i) n)
                                  (break)
                                  (let [ch (primitive/cast i64 (slice-get src (primitive/load i)))]
                                    (primitive/store! i (primitive/iadd (primitive/load i) 1))
                                    (when (primitive/icmp-eq ch 10) (break)))))
                      (or (primitive/icmp-eq c 40) (primitive/icmp-eq c 91))
                        (do
                          (al-push! (mut toks) (mk-tok (TOpen c) (primitive/load i) (primitive/iadd (primitive/load i) 1)))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                      (or (primitive/icmp-eq c 41) (primitive/icmp-eq c 93))
                        (do
                          (al-push! (mut toks) (mk-tok (TClose c) (primitive/load i) (primitive/iadd (primitive/load i) 1)))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                      (primitive/icmp-eq c 39)
                        (do
                          (al-push! (mut toks) (mk-tok (TPrefix "quote") (primitive/load i) (primitive/iadd (primitive/load i) 1)))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                      (primitive/icmp-eq c 96)
                        (do
                          (al-push! (mut toks)
                                    (mk-tok (TPrefix "quasiquote") (primitive/load i) (primitive/iadd (primitive/load i) 1)))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                      (primitive/icmp-eq c 126)
                        (let [istart (primitive/load i)]
                          (primitive/store! i (primitive/iadd (primitive/load i) 1))
                          (if (and (primitive/icmp-lt (primitive/load i) n)
                                   (primitive/icmp-eq (primitive/cast i64 (slice-get src (primitive/load i))) 64))
                              (do
                                (al-push! (mut toks)
                                          (mk-tok (TPrefix "unquote-splicing")
                                                  istart
                                                  (primitive/iadd (primitive/load i) 1)))
                                (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                              (al-push! (mut toks)
                                        (mk-tok (TPrefix "unquote") istart (primitive/iadd istart 1)))))
                      (primitive/icmp-eq c 92)
                        (let [cstart (primitive/load i)]
                          (primitive/store! i (primitive/iadd (primitive/load i) 1))
                          (if (primitive/icmp-ge (primitive/load i) n)
                              (do
                                (primitive/store! out
                                        (Err (mk-diag cstart n "unterminated character literal")))
                                (primitive/store! done true)
                                (break))
                              (let [first (primitive/cast i64 (slice-get src (primitive/load i)))]
                                (primitive/store! i (primitive/iadd (primitive/load i) 1))
                                (let [(mut nend) (primitive/load i)]
                                  (when (sh-is-alpha first)
                                        (loop (if (primitive/icmp-ge (primitive/load i) n)
                                                  (break)
                                                  (let [cc (primitive/cast i64 (slice-get src (primitive/load i)))]
                                                    (if (sh-is-alnum cc)
                                                        (do
                                                          (primitive/store! i (primitive/iadd (primitive/load i) 1))
                                                          (primitive/store! nend (primitive/load i)))
                                                        (break))))))
                                  (let [nlen (primitive/isub (primitive/load nend) (primitive/iadd cstart 1))
                                        v
                                          (if (primitive/icmp-eq nlen 1)
                                              first
                                              (char-name-code (subslice src
                                                                        (primitive/iadd cstart 1)
                                                                        (primitive/load nend))))]
                                    (if (primitive/icmp-lt v 0)
                                        (do
                                          (primitive/store! out
                                                  (Err (mk-diag cstart
                                                                (primitive/load nend)
                                                                "unknown character literal")))
                                          (primitive/store! done true)
                                          (break))
                                        (al-push! (mut toks)
                                                  (mk-tok (TChar v) cstart (primitive/load nend)))))))))
                      (primitive/icmp-eq c 34)
                        (let [istart (primitive/load i)]
                          (primitive/store! i (primitive/iadd (primitive/load i) 1))
                          (match (read-string-body a src istart (primitive/load i))
                            (Err [d] (do (primitive/store! out (Err d)) (primitive/store! done true) (break)))
                            (Ok [sr]
                                (let [srp (alloc/stack StrRead)]
                                  (primitive/store! srp sr)
                                  (al-push! (mut toks)
                                            (mk-tok (TStr (primitive/load (primitive/field srp s)))
                                                    istart
                                                    (primitive/load (primitive/field srp end))))
                                  (primitive/store! i (primitive/load (primitive/field srp end)))))))
                      :else
                        (let [start (primitive/load i)
                              (mut end) (primitive/load i)]
                          (loop (if (primitive/icmp-ge (primitive/load i) n)
                                    (break)
                                    (let [cc (primitive/cast i64 (slice-get src (primitive/load i)))]
                                      (if (or (or (primitive/icmp-eq cc 32)
                                                  (or (primitive/icmp-eq cc 9)
                                                      (or (primitive/icmp-eq cc 10)
                                                          (or (primitive/icmp-eq cc 13)
                                                              (or (primitive/icmp-eq cc 11)
                                                                  (primitive/icmp-eq cc 12))))))
                                              (or (primitive/icmp-eq cc 40)
                                                  (or (primitive/icmp-eq cc 41)
                                                      (or (primitive/icmp-eq cc 91)
                                                          (or (primitive/icmp-eq cc 93)
                                                              (or (primitive/icmp-eq cc 59)
                                                                  (or (primitive/icmp-eq cc 39)
                                                                      (or (primitive/icmp-eq cc 96)
                                                                          (or (primitive/icmp-eq cc
                                                                                       126)
                                                                              (primitive/icmp-eq cc
                                                                                       34))))))))))
                                          (break)
                                          (do
                                            (primitive/store! i (primitive/iadd (primitive/load i) 1))
                                            (primitive/store! end (primitive/load i)))))))
                          (let [stok (subslice src start (primitive/load end))]
                            (if (and (and (primitive/icmp-eq (primitive/isub (primitive/load end) start) 1)
                                          (primitive/icmp-eq (primitive/cast i64 (slice-get src start)) 99))
                                     (and (primitive/icmp-lt (primitive/load i) n)
                                          (primitive/icmp-eq (primitive/cast i64 (slice-get src (primitive/load i))) 34)))
                                (do
                                  (primitive/store! i (primitive/iadd (primitive/load i) 1))
                                  (match (read-string-body a src start (primitive/load i))
                                    (Err [d]
                                         (do
                                           (primitive/store! out (Err d))
                                           (primitive/store! done true)
                                           (break)))
                                    (Ok [sr]
                                        (let [srp (alloc/stack StrRead)]
                                          (primitive/store! srp sr)
                                          (al-push! (mut toks)
                                                    (mk-tok (TCStr (primitive/load (primitive/field srp s)))
                                                            start
                                                            (primitive/load (primitive/field srp end))))
                                          (primitive/store! i (primitive/load (primitive/field srp end)))))))
                                (al-push! (mut toks) (mk-tok (TAtom stok) start (primitive/load end))))))))))
    (if (primitive/load done)
        (primitive/load out)
        (Ok (let [bp (unwrap-ptr [(ArrayList Tok)] (create [(ArrayList Tok)] a))] (primitive/store! bp (primitive/load toks)) bp)))))

(defn parse-one [(p (ptr Parser)) (a (ptr Allocator))] (-> (Result Sexp Diag))
  (let [toks (primitive/load (primitive/field p toks))
        ntok (al-len [Tok] (primitive/load toks))
        pos (primitive/load (primitive/field p pos))]
    (if (primitive/icmp-ge pos ntok)
        (Err (mk-diag -1 -1 "unexpected end of input"))
        (let [tok (alloc/stack Tok)]
          (primitive/store! tok (al-get [Tok] (primitive/load toks) pos))
          (primitive/store! (primitive/field p pos) (primitive/iadd pos 1))
          (let [tlo (primitive/load (primitive/field tok lo))
                thi (primitive/load (primitive/field tok hi))]
            (match (primitive/load (primitive/field tok kind))
              (TStr [s] (Ok (mk-sexp (KStr s) tlo thi)))
              (TCStr [s] (Ok (mk-sexp (KCStr s) tlo thi)))
              (TChar [v] (Ok (mk-sexp (KInt v) tlo thi)))
              (TAtom [s] (Ok (mk-sexp (atom a s) tlo thi)))
              (TClose [c]
                      (let [cs
                              (slice-new [u8]
                                         (let [cb (primitive/cast (ptr u8) (unwrap-ptr [i8] (raw-alloc a 1 1)))]
                                           (primitive/store! (primitive/index cb 0) (primitive/cast u8 c))
                                           cb)
                                         1)
                            m1 (match (str-concat a "unexpected '" cs) (Some [v] v) (None [] ""))
                            m2 (match (str-concat a m1 "'") (Some [v] v) (None [] ""))]
                        (Err (mk-diag tlo thi m2))))
              (TPrefix [sym]
                       (match (parse-one p a)
                         (Err [d] (Err d))
                         (Ok [inner]
                             (let [ip (alloc/stack Sexp)]
                               (primitive/store! ip inner)
                               (let [ihi (primitive/load (primitive/field ip hi))
                                     (mut kids) (al-new [Sexp] a)]
                                 (al-push! (mut kids) (mk-sexp (KSym sym) tlo thi))
                                 (al-push! (mut kids) (primitive/load ip))
                                 (Ok (mk-sexp (KList (box-items a (primitive/load kids))) tlo ihi)))))))
              (TOpen [open]
                     (let [close (if (primitive/icmp-eq open 40) 41 93)
                           (mut items) (al-new [Sexp] a)
                           (mut out) (primitive/zeroed (Result Sexp Diag))]
                       (loop (let [cpos (primitive/load (primitive/field p pos))]
                               (if (primitive/icmp-ge cpos ntok)
                                   (do
                                     (let [cs
                                             (slice-new [u8]
                                                        (let [cb (primitive/cast (ptr u8) (unwrap-ptr [i8] (raw-alloc a 1 1)))]
                                                          (primitive/store! (primitive/index cb 0) (primitive/cast u8 open))
                                                          cb)
                                                        1)
                                           m1 (match (str-concat a "unclosed '" cs) (Some [v] v) (None [] ""))
                                           m2 (match (str-concat a m1 "'") (Some [v] v) (None [] ""))]
                                       (primitive/store! out (Err (mk-diag tlo thi m2))))
                                     (break))
                                   (let [nt (alloc/stack Tok)]
                                     (primitive/store! nt (al-get [Tok] (primitive/load toks) cpos))
                                     (let [cdelim
                                             (match (primitive/load (primitive/field nt kind))
                                               (TClose [cc] cc)
                                               (TOpen [_] -1)
                                               (TPrefix [_] -1)
                                               (TStr [_] -1)
                                               (TCStr [_] -1)
                                               (TChar [_] -1)
                                               (TAtom [_] -1))]
                                       (if (primitive/icmp-ge cdelim 0)
                                           (if (primitive/icmp-ne cdelim close)
                                               (do
                                                 (let [os
                                                         (slice-new [u8]
                                                                    (let [cb
                                                                            (primitive/cast (ptr u8)
                                                                                  (unwrap-ptr [i8] (raw-alloc a 1 1)))]
                                                                      (primitive/store! (primitive/index cb 0) (primitive/cast u8 open))
                                                                      cb)
                                                                    1)
                                                       ds
                                                         (slice-new [u8]
                                                                    (let [cb
                                                                            (primitive/cast (ptr u8)
                                                                                  (unwrap-ptr [i8] (raw-alloc a 1 1)))]
                                                                      (primitive/store! (primitive/index cb 0) (primitive/cast u8 cdelim))
                                                                      cb)
                                                                    1)
                                                       m1
                                                         (match (str-concat a "mismatched delimiters: '" os)
                                                           (Some [v] v)
                                                           (None [] ""))
                                                       m2 (match (str-concat a m1 "' .. '") (Some [v] v) (None [] ""))
                                                       m3 (match (str-concat a m2 ds) (Some [v] v) (None [] ""))
                                                       m4 (match (str-concat a m3 "'") (Some [v] v) (None [] ""))]
                                                   (primitive/store! out
                                                           (Err (mk-diag (primitive/load (primitive/field nt lo)) (primitive/load (primitive/field nt hi)) m4))))
                                                 (break))
                                               (do
                                                 (primitive/store! (primitive/field p pos) (primitive/iadd cpos 1))
                                                 (primitive/store! out
                                                         (Ok (mk-sexp (if (primitive/icmp-eq open 40)
                                                                          (KList (box-items a (primitive/load items)))
                                                                          (KVec (box-items a (primitive/load items))))
                                                                      tlo
                                                                      (primitive/load (primitive/field nt hi)))))
                                                 (break)))
                                           (match (parse-one p a)
                                             (Ok [child] (do (al-push! (mut items) child) 0))
                                             (Err [d] (do (primitive/store! out (Err d)) (break))))))))))
                       (primitive/load out)))))))))

; Recursively stamp `source` on a node + descendants (int place); ctxt untouched.
(defn stamp-source-list [(items (ptr (ArrayList Sexp))) (source i64)] (-> i64)
  (let [n (al-len [Sexp] (primitive/load items))
        (mut i) 0
        data (primitive/load (primitive/field items data))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (stamp-source-node (primitive/index data (primitive/load i)) source) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn stamp-source-node [(x (ptr Sexp)) (source i64)] (-> i64)
  (primitive/store! (primitive/field x source) source)
  (match (primitive/load (primitive/field x kind))
    (KList [items] (stamp-source-list items source))
    (KVec [items] (stamp-source-list items source))
    (KInt [v] 0)
    (KFloat [b] 0)
    (KSym [s] 0)
    (KKw [s] 0)
    (KStr [s] 0)
    (KCStr [s] 0))
  0)
(defn diag-with-source [(d Diag) (source i64)] (-> Diag)
  (let [p (alloc/stack Diag)]
    (primitive/store! p d)
    (when (primitive/icmp-ge (primitive/load (primitive/field p lo)) 0) (primitive/store! (primitive/field p source) source))
    (primitive/load p)))

(defn read-all [(a (ptr Allocator)) (src (slice u8)) (source i64)] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (match (tokenize a src)
    (Err [d] (Err (diag-with-source d source)))
    (Ok [toks]
        (let [p (alloc/stack Parser)
              (mut out) (al-new [Sexp] a)
              (mut err) (primitive/zeroed Diag)
              (mut failed) false]
          (primitive/store! (primitive/field p toks) toks)
          (primitive/store! (primitive/field p pos) 0)
          (loop (if (primitive/icmp-ge (primitive/load (primitive/field p pos)) (al-len [Tok] (primitive/load toks)))
                    (break)
                    (match (parse-one p a)
                      (Ok [s] (do (al-push! (mut out) s) 0))
                      (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break))))))
          (if (primitive/load failed)
              (Err (diag-with-source (primitive/load err) source))
              (let [forms (box-items a (primitive/load out))] (stamp-source-list forms source) (Ok forms)))))))

; ============================ canonical dump entry ==========================
; Emits the `(error@source:lo:hi:ctxt "msg")` shape on a read/parse error.
