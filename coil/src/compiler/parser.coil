; src/compiler/parser.coil — self-host Coil compiler, parser module.
(module parser)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ffi.coil" :use *)
(import "ast.coil" :use *)
(import "astdump.coil" :use *)
(import "comptime.coil" :use *)
(import "reader.coil" :use *)

(defn unimplemented [(who (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "UNIMPLEMENTED: ") (ps w who) (wb w 10))
  (abort)
  0)

; Primitive dispatch is supplied by module resolution. An empty table means that no
; source name denotes a primitive; the parser itself owns no primitive namespace.
(defstruct PrimitiveBindingsBox
  [(bindings (ptr (ArrayList PrimitiveBinding)))])
(defn primitive-bindings-box [] (-> (ptr PrimitiveBindingsBox))
  (alloc/static PrimitiveBindingsBox))
(defn parser-set-primitive-bindings! [(bindings (ptr (ArrayList PrimitiveBinding)))] (-> i64)
  (primitive/store! (primitive/field (primitive-bindings-box) bindings) bindings)
  0)
(defn primitive-dispatch-head [(head (slice u8))] (-> (Option (slice u8)))
  (let [bindings (primitive/load (primitive/field (primitive-bindings-box) bindings))]
    (if (primitive/icmp-eq (primitive/cast i64 bindings) 0)
        (None [(slice u8)])
        (let [n (al-len [PrimitiveBinding] (primitive/load bindings))
              (mut i) 0
              (mut out) (None [(slice u8)])]
          (loop (if (primitive/icmp-ge (primitive/load i) n)
                    (break)
                    (let [bp (primitive/index (primitive/load (primitive/field bindings data)) (primitive/load i))]
                      (if (str-eq (primitive/load (primitive/field bp source_name)) head)
                          (do (primitive/store! out (Some (primitive/load (primitive/field bp opcode)))) (break))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
          (primitive/load out)))))

; ---- generic boxing + string helpers ----
(defn box-al [T] [(a (ptr Allocator)) (l (ArrayList T))] (-> (ptr (ArrayList T)))
  (let [p (unwrap-ptr [(ArrayList T)] (create [(ArrayList T)] a))] (primitive/store! p l) p))
(defn sconcat [(a (ptr Allocator)) (x (slice u8)) (y (slice u8))] (-> (slice u8))
  (match (str-concat a x y) (Some [v] v) (None [] "")))
(defn sconcat3 [(a (ptr Allocator)) (x (slice u8)) (y (slice u8)) (z (slice u8))] (-> (slice u8))
  (sconcat a (sconcat a x y) z))
(defn push-mag [(buf (mut (ArrayList u8))) (n i64)] (-> i64)
  (if (primitive/icmp-lt n 10)
      (al-push! (mut buf) (primitive/cast u8 (primitive/iadd n 48)))
      (do (push-mag (mut buf) (primitive/udiv n 10)) (al-push! (mut buf) (primitive/cast u8 (primitive/iadd (primitive/urem n 10) 48))))))
(defn i64->str [(a (ptr Allocator)) (n i64)] (-> (slice u8))
  (let [(mut buf) (al-new [u8] a)]
    (if (primitive/icmp-lt n 0) (do (al-push! (mut buf) (primitive/cast u8 45)) (push-mag (mut buf) (primitive/isub 0 n))) (push-mag (mut buf) n))
    (al-slice [u8] (primitive/load buf))))
(defn char1 [(a (ptr Allocator)) (c i64)] (-> (slice u8))
  (slice-new [u8] (let [cb (primitive/cast (ptr u8) (unwrap-ptr [i8] (raw-alloc a 1 1)))] (primitive/store! (primitive/index cb 0) (primitive/cast u8 c)) cb) 1))

; ---- Sexp inspection (one match -> a flat info struct) ----
(defstruct SxInfo [(tag i64) (ival i64) (sval (slice u8)) (items (ptr (ArrayList Sexp)))])
(defn sx-info [(s Sexp)] (-> SxInfo)
  (let [sp (alloc/stack Sexp)
        p (alloc/stack SxInfo)]
    (primitive/store! sp s)
    (primitive/store! (primitive/field p ival) 0)
    (primitive/store! (primitive/field p sval) "")
    (primitive/store! (primitive/field p items) (primitive/zeroed (ptr (ArrayList Sexp))))
    (match (primitive/load (primitive/field sp kind))
      (KInt [v] (do (primitive/store! (primitive/field p tag) 0) (primitive/store! (primitive/field p ival) v) 0))
      (KFloat [b] (do (primitive/store! (primitive/field p tag) 1) (primitive/store! (primitive/field p ival) b) 0))
      (KSym [x] (do (primitive/store! (primitive/field p tag) 2) (primitive/store! (primitive/field p sval) x) 0))
      (KKw [x] (do (primitive/store! (primitive/field p tag) 3) (primitive/store! (primitive/field p sval) x) 0))
      (KStr [x] (do (primitive/store! (primitive/field p tag) 4) (primitive/store! (primitive/field p sval) x) 0))
      (KCStr [x] (do (primitive/store! (primitive/field p tag) 5) (primitive/store! (primitive/field p sval) x) 0))
      (KList [it] (do (primitive/store! (primitive/field p tag) 6) (primitive/store! (primitive/field p items) it) 0))
      (KVec [it] (do (primitive/store! (primitive/field p tag) 7) (primitive/store! (primitive/field p items) it) 0)))
    (primitive/load p)))
(defn sx-tag [(s Sexp)] (-> i64)
  (let [p (alloc/stack SxInfo)] (primitive/store! p (sx-info s)) (primitive/load (primitive/field p tag))))
(defn sx-ival [(s Sexp)] (-> i64)
  (let [p (alloc/stack SxInfo)] (primitive/store! p (sx-info s)) (primitive/load (primitive/field p ival))))
(defn sx-sval [(s Sexp)] (-> (slice u8))
  (let [p (alloc/stack SxInfo)] (primitive/store! p (sx-info s)) (primitive/load (primitive/field p sval))))
(defn sx-items [(s Sexp)] (-> (ptr (ArrayList Sexp)))
  (let [p (alloc/stack SxInfo)] (primitive/store! p (sx-info s)) (primitive/load (primitive/field p items))))
(defn sx-lo [(s Sexp)] (-> i64)
  (let [p (alloc/stack Sexp)] (primitive/store! p s) (primitive/load (primitive/field p lo))))
(defn sx-hi [(s Sexp)] (-> i64)
  (let [p (alloc/stack Sexp)] (primitive/store! p s) (primitive/load (primitive/field p hi))))
(defn sx-source [(s Sexp)] (-> i64)
  (let [p (alloc/stack Sexp)] (primitive/store! p s) (primitive/load (primitive/field p source))))
(defn sx-ctxt [(s Sexp)] (-> i64)
  (let [p (alloc/stack Sexp)] (primitive/store! p s) (primitive/load (primitive/field p ctxt))))
(defn sx-nid [(s Sexp)] (-> i64)
  (let [p (alloc/stack Sexp)] (primitive/store! p s) (primitive/load (primitive/field p nid))))
(defn sx-len [(l (ptr (ArrayList Sexp)))] (-> i64)
  (al-len [Sexp] (primitive/load l)))
(defn sx-at [(l (ptr (ArrayList Sexp))) (i i64)] (-> Sexp)
  (al-get [Sexp] (primitive/load l) i))
(defn sx-get [(l (ptr (ArrayList Sexp))) (i i64)] (-> (Option Sexp))
  (if (or (primitive/icmp-lt i 0) (primitive/icmp-ge i (sx-len l))) (None [Sexp]) (Some (sx-at l i))))
(defn rest-from [(a (ptr Allocator)) (l (ptr (ArrayList Sexp))) (start i64)] (-> (ptr (ArrayList Sexp)))
  (let [(mut out) (al-new [Sexp] a)
        n (sx-len l)
        (mut i) start]
    (loop (if (primitive/icmp-ge (primitive/load i) n) (break) (do (al-push! (mut out) (sx-at l (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Sexp] a (primitive/load out))))

; small Option<Sexp> predicates
(defn opt-is-vec [(o (Option Sexp))] (-> bool)
  (match o (Some [s] (primitive/icmp-eq (sx-tag s) 7)) (None [] false)))
(defn opt-get [(o (Option Sexp))] (-> Sexp)
  (match o (Some [s] s) (None [] (primitive/zeroed Sexp))))
(defn opt-is-kw [(o (Option Sexp)) (name (slice u8))] (-> bool)
  (match o (Some [s] (and (primitive/icmp-eq (sx-tag s) 3) (str-eq (sx-sval s) name))) (None [] false)))
(defn opt-is-pos-int [(o (Option Sexp))] (-> bool)
  (match o (Some [s] (and (primitive/icmp-eq (sx-tag s) 0) (primitive/icmp-gt (sx-ival s) 0))) (None [] false)))
(defn opt-int [(o (Option Sexp))] (-> i64)
  (match o (Some [s] (sx-ival s)) (None [] 0)))
(defn opt-is-str [(o (Option Sexp))] (-> bool)
  (match o (Some [s] (primitive/icmp-eq (sx-tag s) 4)) (None [] false)))
(defn opt-str-val [(o (Option Sexp))] (-> (slice u8))
  (match o (Some [s] (sx-sval s)) (None [] "")))

; The DISPLAY escaper for Str/CStr, used by sexp-display. Differs from the DUMP
; escaper (esc-write, which emits `\xNN`): Display renders NUL as `\0` and any
; other control byte as `\u{hex}` (minimal lowercase hex).
(defn dbg-hexnum [(a (ptr Allocator)) (b i64)] (-> (slice u8))
  (if (primitive/icmp-lt b 16)
      (char1 a (hexd b))
      (sconcat a (char1 a (hexd (primitive/udiv b 16))) (char1 a (hexd (primitive/urem b 16))))))
(defn dbg-escape [(a (ptr Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut acc) ""
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [b (primitive/cast i64 (slice-get s (primitive/load i)))]
                  (primitive/store! acc
                          (sconcat a
                                   (primitive/load acc)
                                   (cond (primitive/icmp-eq b 34) "\\\""
                                         (primitive/icmp-eq b 92) "\\\\"
                                         (primitive/icmp-eq b 10) "\\n"
                                         (primitive/icmp-eq b 13) "\\r"
                                         (primitive/icmp-eq b 9) "\\t"
                                         (primitive/icmp-eq b 0) "\\0"
                                         (or (primitive/icmp-lt b 32) (primitive/icmp-eq b 127))
                                           (sconcat a (sconcat a "\\u{" (dbg-hexnum a b)) "}")
                                         :else (char1 a b)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load acc)))
; CStr Debug — used by the llvm-ir parse-error path, where
; An LLVM error string renders as `{:?}` over a `CStr`. Unlike str
; Debug (dbg-escape), CStr Debug is `ascii::escape_default` per byte: it escapes `'`
; as `\'` and renders any non-printable byte as `\xHH` (two lowercase hex digits),
; NOT `\u{…}`. Distinct helper so dbg-escape's str-Debug callers stay unchanged.
(defn cstr-dbg-escape [(a (ptr Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut acc) ""
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [b (primitive/cast i64 (slice-get s (primitive/load i)))]
                  (primitive/store! acc
                          (sconcat a
                                   (primitive/load acc)
                                   (cond (primitive/icmp-eq b 9) "\\t"
                                         (primitive/icmp-eq b 13) "\\r"
                                         (primitive/icmp-eq b 10) "\\n"
                                         (primitive/icmp-eq b 92) "\\\\"
                                         (primitive/icmp-eq b 39) "\\'"
                                         (primitive/icmp-eq b 34) "\\\""
                                         (and (primitive/icmp-ge b 32) (primitive/icmp-le b 126)) (char1 a b)
                                         :else
                                           (sconcat a
                                                    "\\x"
                                                    (sconcat a
                                                             (char1 a (hexd (primitive/iand (primitive/ishr b 4) 15)))
                                                             (char1 a (hexd (primitive/iand b 15)))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load acc)))
; ---- f64 Debug, for error interpolation of float literals ----
; A string of `n` ASCII '0' characters.
(defn nzeros [(a (ptr Allocator)) (n i64)] (-> (slice u8))
  (let [(mut acc) ""
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (primitive/store! acc (sconcat a (primitive/load acc) "0")) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load acc)))
; Render an f64 as the SHORTEST decimal that round-trips. Input is the raw f64 bit
; pattern (a KFloat carries bits, not a decimal). Strategy: libc gives correctly
; rounded p-significant-digit decimals; we search p=1..17 for the SHORTEST p whose
; `%.*e` output parses back (strtod) to the identical f64 — this is exactly the
; shortest-round-trip Ryū would find. We then re-render (sign, digits, exponent) as
; fixed notation with a mandatory `.0`, switching to exponential iff
; `abs < 1e-4 || abs >= 1e16` (equivalently the leading-digit exponent
; E < -4 || E >= 16).
(defn f64-debug [(a (ptr Allocator)) (bits i64)] (-> (slice u8))
  (let [absbits (primitive/iand bits 9223372036854775807)
        sign (primitive/icmp-eq (primitive/cast i64 (primitive/ishr (primitive/cast u64 bits) 63)) 1)
        expfield (primitive/iand (primitive/cast i64 (primitive/ishr (primitive/cast u64 bits) 52)) 2047)
        mant (primitive/iand bits 4503599627370495)]
    (if (primitive/icmp-eq expfield 2047)
        (if (primitive/icmp-ne mant 0) "NaN" (if sign "-inf" "inf"))
        (if (primitive/icmp-eq absbits 0)
            (if sign "-0.0" "0.0")
            (let [absx (bits->f64 absbits)
                  buf (alloc/stack (array u8 64))
                  bp (primitive/cast (ptr i8) buf)
                  ep (alloc/stack (ptr i8))
                  (mut p) 1
                  (mut done) false]
              ; shortest p whose %.*e round-trips
              (loop (if (or (primitive/load done) (primitive/icmp-gt (primitive/load p) 17))
                        (break)
                        (do
                          (snprintf bp 64 c"%.*e" (primitive/cast i32 (primitive/isub (primitive/load p) 1)) absx)
                          (if (primitive/icmp-eq (f64-bits (strtod bp ep)) absbits)
                              (do (primitive/store! done true) 0)
                              (do (primitive/store! p (primitive/iadd (primitive/load p) 1)) 0)))))
              ; buf now holds "d[.ddd]e±XX" for the shortest p; parse into digits + E
              (let [(mut ei) 0]
                (loop (if (primitive/icmp-eq (primitive/cast i64 (primitive/load (primitive/index bp (primitive/load ei)))) 101)
                          (break)
                          (primitive/store! ei (primitive/iadd (primitive/load ei) 1))))
                (let [(mut ds) (char1 a (primitive/cast i64 (primitive/load (primitive/index bp 0))))]
                  (when (primitive/icmp-gt (primitive/load ei) 1)
                        (let [(mut k) 2]
                          (loop (if (primitive/icmp-ge (primitive/load k) (primitive/load ei))
                                    (break)
                                    (do
                                      (primitive/store! ds (sconcat a (primitive/load ds) (char1 a (primitive/cast i64 (primitive/load (primitive/index bp (primitive/load k)))))))
                                      (primitive/store! k (primitive/iadd (primitive/load k) 1)))))))
                  (let [(mut ecur) (primitive/iadd (primitive/load ei) 2)
                        (mut emag) 0]
                    (loop (let [c (primitive/cast i64 (primitive/load (primitive/index bp (primitive/load ecur))))]
                            (if (primitive/icmp-eq c 0)
                                (break)
                                (do
                                  (primitive/store! emag (primitive/iadd (primitive/imul (primitive/load emag) 10) (primitive/isub c 48)))
                                  (primitive/store! ecur (primitive/iadd (primitive/load ecur) 1))))))
                    (let [esignc (primitive/cast i64 (primitive/load (primitive/index bp (primitive/iadd (primitive/load ei) 1))))
                          ee (if (primitive/icmp-eq esignc 45) (primitive/isub 0 (primitive/load emag)) (primitive/load emag))
                          ; strip trailing zeros from the significand
                          (mut dlen) (slice-len (primitive/load ds))]
                      (loop (if (primitive/icmp-le (primitive/load dlen) 1)
                                (break)
                                (if (primitive/icmp-eq (primitive/cast i64 (slice-get (primitive/load ds) (primitive/isub (primitive/load dlen) 1))) 48)
                                    (primitive/store! dlen (primitive/isub (primitive/load dlen) 1))
                                    (break))))
                      (let [dg (subslice (primitive/load ds) 0 (primitive/load dlen))
                            k (primitive/load dlen)
                            point (primitive/iadd ee 1)
                            body
                              (cond (or (primitive/icmp-lt ee -4) (primitive/icmp-ge ee 16))  ; exponential: d1[.rest]e<E>
                                      (sconcat a
                                               (sconcat a
                                                        (if (primitive/icmp-gt k 1)
                                                            (sconcat a
                                                                     (sconcat a (subslice dg 0 1) ".")
                                                                     (subslice dg 1 k))
                                                            (subslice dg 0 1))
                                                        "e")
                                               (if (primitive/icmp-lt ee 0)
                                                   (sconcat a "-" (i64->str a (primitive/isub 0 ee)))
                                                   (i64->str a ee)))
                                    ; fixed: always at least one fractional digit
                                    (primitive/icmp-le point 0) (sconcat a (sconcat a "0." (nzeros a (primitive/isub 0 point))) dg)
                                    (primitive/icmp-ge point k) (sconcat a (sconcat a dg (nzeros a (primitive/isub point k))) ".0")
                                    :else (sconcat a (sconcat a (subslice dg 0 point) ".") (subslice dg point k)))]
                        (if sign (sconcat a "-" body) body)))))))))))
; ---- Sexp Display, for error interpolation ----
(defn sexp-display [(a (ptr Allocator)) (s Sexp)] (-> (slice u8))
  (let [tg (sx-tag s)]
    (cond (primitive/icmp-eq tg 0) (i64->str a (sx-ival s))
          (primitive/icmp-eq tg 2) (sx-sval s)
          (primitive/icmp-eq tg 3) (sconcat a ":" (sx-sval s))
          (primitive/icmp-eq tg 4) (sconcat a (sconcat a "\"" (dbg-escape a (sx-sval s))) "\"")
          (primitive/icmp-eq tg 5) (sconcat a (sconcat a "c\"" (dbg-escape a (sx-sval s))) "\"")
          (primitive/icmp-eq tg 6) (seq-display a (sx-items s) 40 41)
          (primitive/icmp-eq tg 7) (seq-display a (sx-items s) 91 93)
          :else  ; Float (tag 1) Display is the shortest-round-trip f64 decimal.
          ; The KFloat carries the raw bit pattern (sx-ival); f64-debug reproduces it.
          (f64-debug a (sx-ival s)))))
(defn seq-display [(a (ptr Allocator)) (items (ptr (ArrayList Sexp))) (open i64) (close i64)] (-> (slice u8))
  (let [(mut acc) (char1 a open)
        n (sx-len items)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (primitive/store! acc (sconcat a (primitive/load acc) " ")) 0)
                (primitive/store! acc (sconcat a (primitive/load acc) (sexp-display a (sx-at items (primitive/load i)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (sconcat a (primitive/load acc) (char1 a close))))

; ---- diagnostics ----
(defn derr [(msg (slice u8))] (-> Diag)
  (mk-diag -1 -1 msg))
(defn derr-at [(lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (mk-diag lo hi msg))
(defn derr-at-src [(source i64) (lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (mk-diag-src source lo hi msg))
; Fill in whatever the inner diagnostic left unset, from the enclosing node.
; Span and source are INDEPENDENT: `derr-at` pins a precise span but cannot know
; which file it is in, so a diag with a real span still needs its source stamped.
; Guarding the source store on `lo < 0` would leave those attributed to nothing.
(defn dwspan [(d Diag) (source i64) (lo i64) (hi i64) (ctxt i64)] (-> Diag)
  (let [p (alloc/stack Diag)]
    (primitive/store! p d)
    (when (primitive/icmp-lt (primitive/load (primitive/field p lo)) 0)
          (primitive/store! (primitive/field p lo) lo)
          (primitive/store! (primitive/field p hi) hi)
          (primitive/store! (primitive/field p ctxt) ctxt))
    (when (primitive/icmp-lt (primitive/load (primitive/field p source)) 0) (primitive/store! (primitive/field p source) source))
    (primitive/load p)))

; ---- Option -> Result with a message (mirrors `.ok_or(msg)?`) ----
(defn need [T] [(o (Option T)) (msg (slice u8))] (-> (Result T Diag))
  (match o (Some [v] (Ok v)) (None [] (Err (derr msg)))))

; ---- matchers ----
(defn as-list [(s Sexp) (msg (slice u8))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (if (primitive/icmp-eq (sx-tag s) 6) (Ok (sx-items s)) (Err (derr-at (sx-lo s) (sx-hi s) msg))))
(defn head-sym [(a (ptr Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result (slice u8) Diag))
  (if (primitive/icmp-eq (sx-len items) 0)
      (Err (derr "empty list"))
      (let [h (sx-at items 0)]
        (if (primitive/icmp-eq (sx-tag h) 2)
            (Ok (sx-sval h))
            (Err (derr-at (sx-lo h) (sx-hi h) (sconcat a "expected a symbol head, got " (sexp-display a h))))))))
(defn sym-of [(a (ptr Allocator)) (s Sexp) (what (slice u8))] (-> (Result (slice u8) Diag))
  (if (primitive/icmp-eq (sx-tag s) 2)
      (Ok (sx-sval s))
      (Err (derr-at (sx-lo s) (sx-hi s) (sconcat a what (sconcat a ": expected symbol, got " (sexp-display a s)))))))
(defn kw-of [(a (ptr Allocator)) (s Sexp) (what (slice u8))] (-> (Result (slice u8) Diag))
  (if (primitive/icmp-eq (sx-tag s) 3)
      (Ok (sx-sval s))
      (Err (derr-at (sx-lo s) (sx-hi s) (sconcat a what (sconcat a ": expected keyword, got " (sexp-display a s)))))))
(defn int-val [(a (ptr Allocator)) (s Sexp) (what (slice u8))] (-> (Result i64 Diag))
  (if (primitive/icmp-eq (sx-tag s) 0)
      (Ok (sx-ival s))
      (Err (derr-at (sx-lo s) (sx-hi s) (sconcat a what (sconcat a ": expected an integer, got " (sexp-display a s)))))))
(defn pow2 [(s (Option Sexp))] (-> (Result i64 Diag))
  (match s
    (Some [x]
          (if (and (primitive/icmp-eq (sx-tag x) 0) (let [n (sx-ival x)] (and (primitive/icmp-gt n 0) (primitive/icmp-eq (primitive/iand n (primitive/isub n 1)) 0))))
              (Ok (sx-ival x))
              (Err (derr "alignment must be a positive power of two"))))
    (None [] (Err (derr "alignment must be a positive power of two")))))
(defn sym-vec [(a (ptr Allocator)) (s Sexp) (what (slice u8))] (-> (Result (ptr (ArrayList (slice u8))) Diag))
  (if (primitive/icmp-eq (sx-tag s) 7)
      (try (let [items (sx-items s)
                 (mut out) (al-new [(slice u8)] a)
                 n (sx-len items)
                 (mut i) 0]
             (loop (if (primitive/icmp-ge (primitive/load i) n)
                       (break)
                       (do
                         (al-push! (mut out) (try! (sym-of a (sx-at items (primitive/load i)) what)))
                         (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
             (Ok (box-al [(slice u8)] a (primitive/load out)))))
      (Err [(ptr (ArrayList (slice u8))) Diag]
           (derr-at (sx-lo s) (sx-hi s) (sconcat a what (sconcat a ": expected vector, got " (sexp-display a s)))))))
(defn need-vec [(o (Option Sexp)) (msg (slice u8))] (-> (Result (ptr (ArrayList Sexp)) Diag))
  (match o (Some [s] (if (primitive/icmp-eq (sx-tag s) 7) (Ok (sx-items s)) (Err (derr msg)))) (None [] (Err (derr msg)))))
(defstruct Two [(x Sexp) (y Sexp)])
(defn need-two [(a (ptr Allocator)) (args (ptr (ArrayList Sexp))) (head (slice u8))] (-> (Result Two Diag))
  (if (primitive/icmp-ne (sx-len args) 2)
      (Err (derr (sconcat a head ": expects exactly 2 arguments")))
      (Ok (let [p (alloc/stack Two)] (primitive/store! (primitive/field p x) (sx-at args 0)) (primitive/store! (primitive/field p y) (sx-at args 1)) (primitive/load p)))))

; ---- types ----
(defn type-int-bits [(t Type)] (-> i64)
  (match t
    (TInt [b s] b)
    (TFloat [_] -1)
    (TBool [] -1)
    (TVoid [] -1)
    (TPtr [_] -1)
    (TRef [_ _] -1)
    (TStruct [_] -1)
    (TArray [_ _] -1)
    (TSlice [_] -1)
    (TVec [_ _] -1)
    (TFn [_ _ _] -1)
    (TApp [_ _] -1)
    (TNever [] -1)
    (TCode [] -1)
    (TExternRef [] -1)))
(defn not-int-diag [(a (ptr Allocator)) (name (slice u8))] (-> Diag)
  (derr (sconcat3 a "not an int type '" name "'")))
(defn int-type [(a (ptr Allocator)) (name (slice u8))] (-> (Result Type Diag))
  (let [n (slice-len name)]
    (if (primitive/icmp-eq n 0)
        (Err (not-int-diag a name))
        (let [c0 (primitive/cast i64 (slice-get name 0))
              signed (if (primitive/icmp-eq c0 105) 1 (unless (primitive/icmp-eq c0 117) -1))]
          (if (or (primitive/icmp-lt signed 0) (primitive/icmp-eq n 1))
              (Err (not-int-diag a name))
              (let [(mut bits) 0
                    (mut bad) false
                    (mut over) false
                    (mut i) 1]
                (loop (if (primitive/icmp-ge (primitive/load i) n)
                          (break)
                          (let [c (primitive/cast i64 (slice-get name (primitive/load i)))]
                            (if (and (primitive/icmp-ge c 48) (primitive/icmp-le c 57))
                                (do
                                  (primitive/store! bits (primitive/iadd (primitive/imul (primitive/load bits) 10) (primitive/isub c 48)))
                                  (when (primitive/icmp-gt (primitive/load bits) 4294967295) (primitive/store! over true) 0)
                                  (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                                (do (primitive/store! bad true) (break))))))
                (cond (primitive/load bad) (Err (not-int-diag a name))
                      (primitive/load over) (Err (derr (sconcat3 a "int width too large in '" name "'")))
                      (or (primitive/icmp-eq (primitive/load bits) 0) (primitive/icmp-gt (primitive/load bits) 65535))
                        (Err (derr (sconcat3 a "int width out of range in '" name "' (1..=65535)")))
                      :else (Ok (TInt (primitive/load bits) (primitive/icmp-eq signed 1))))))))))
; The C machine word: `size_t`/`ssize_t`/`long`/`intptr_t` — i32 on wasm32 (ILP32),
; i64 on LP64 (arm64/x86-64). Resolved HERE, at parse, because the target is fixed and
; already set (driver's set-target-arch! runs before the pipeline parses anything). So
; `usize`/`isize` are plain `TInt`s downstream — visible to generic instantiation and
; needing no backend/checker/mono change. On a 64-bit target `isize` == `:i64` exactly,
; so migrating the prelude's `:i64` size args to `isize` is byte-identical on native.
(defn target-word-bits [] (-> i64)
  (if (str-eq (target-arch-str) "wasm32") 32 64))
(defn prim-type [(a (ptr Allocator)) (name (slice u8))] (-> (Result Type Diag))
  (cond (str-eq name "f32") (Ok (TFloat 32))
        (str-eq name "f64") (Ok (TFloat 64))
        (str-eq name "bool") (Ok (TBool))
        (str-eq name "void") (Ok (TVoid))
        (str-eq name "externref") (Ok (TExternRef))
        (str-eq name "usize") (Ok (TInt (target-word-bits) false))
        (str-eq name "isize") (Ok (TInt (target-word-bits) true))
        :else (int-type a name)))
(defn parse-types [(a (ptr Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList Type)) Diag))
  (try (let [(mut out) (al-new [Type] a)
             n (sx-len items)
             (mut i) 0]
         (loop (if (primitive/icmp-ge (primitive/load i) n)
                   (break)
                   (do (al-push! (mut out) (try! (parse-type a (sx-at items (primitive/load i))))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
         (Ok (box-al [Type] a (primitive/load out))))))
(defn parse-type [(a (ptr Allocator)) (s Sexp)] (-> (Result Type Diag))
  (match (parse-type-inner a s)
    (Err [d] (Err (dwspan d (sx-source s) (sx-lo s) (sx-hi s) (sx-ctxt s))))
    (Ok [t] (Ok t))))
(defn parse-type-inner [(a (ptr Allocator)) (s Sexp)] (-> (Result Type Diag))
  (let [tg (sx-tag s)
        slo (sx-lo s)
        shi (sx-hi s)]
    (cond (primitive/icmp-eq tg 3) (prim-type a (sx-sval s))
          (primitive/icmp-eq tg 2)
            (let [k (sx-sval s)]
              (if (str-eq k "Code") (Ok (TCode)) (match (prim-type a k) (Ok [t] (Ok t)) (Err [_] (Ok (TStruct k))))))
          (primitive/icmp-eq tg 6) (parse-type-list a (sx-items s))
          :else (Err (derr-at slo shi (sconcat a "unsupported type: " (sexp-display a s)))))))
(defn parse-type-list [(a (ptr Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result Type Diag))
  (try (let [head (try! (head-sym a items))]
         (cond (str-eq head "mut")
                 (Ok (TRef true
                           (box-type a
                                     (try! (parse-type a
                                                       (try! (need [Sexp] (sx-get items 1) "mut: expects (mut TYPE)")))))))
               (str-eq head "ref")
                 (Ok (TRef false
                           (box-type a
                                     (try! (parse-type a
                                                       (try! (need [Sexp] (sx-get items 1) "ref: expects (ref TYPE)")))))))
               (str-eq head "ptr")
                 (Ok (TPtr (box-type a
                                     (match (sx-get items 1)
                                       (Some [t] (try! (parse-type a t)))
                                       (None [] (TInt 64 true))))))
               (str-eq head "array")
                 (let [elem
                         (box-type a
                                   (try! (parse-type a
                                                     (try! (need [Sexp]
                                                                 (sx-get items 1)
                                                                 "array type: missing element type")))))]
                   (match (sx-get items 2)
                     (None []
                           (Err [Type Diag]
                                (derr "array type: missing length; write (array T N) with N a literal integer")))
                     (Some [ls]
                           (if (primitive/icmp-ne (sx-tag ls) 0)
                               (Err [Type Diag]
                                    (derr "array length must be a literal integer (const generics are not supported)"))
                               (if (primitive/icmp-le (sx-ival ls) 0)
                                   (Err [Type Diag] (derr "array type: expected a positive length"))
                                   (Ok (TArray elem (sx-ival ls))))))))
               (str-eq head "slice")
                 (Ok (TSlice (box-type a
                                       (try! (parse-type a
                                                         (try! (need [Sexp]
                                                                     (sx-get items 1)
                                                                     "slice type: missing element type")))))))
               (str-eq head "vec")
                 (let [elem
                         (box-type a
                                   (try! (parse-type a
                                                     (try! (need [Sexp]
                                                                 (sx-get items 1)
                                                                 "vec type: missing element type")))))
                       nn (if (opt-is-pos-int (sx-get items 2)) (opt-int (sx-get items 2)) -1)]
                   (if (primitive/icmp-lt nn 0)
                       (Err [Type Diag] (derr "vec type: expected a positive lane count"))
                       (Ok (TVec elem nn))))
               (str-eq head "struct")
                 (Ok (TStruct (try! (sym-of a
                                            (try! (need [Sexp]
                                                        (sx-get items 1)
                                                        "struct type: missing name"))
                                            "struct name"))))
               (str-eq head "dyn")
                 (Ok (TStruct (sconcat a
                                       (try! (sym-of a
                                                     (try! (need [Sexp]
                                                                 (sx-get items 1)
                                                                 "dyn type: expected (dyn Trait)"))
                                                     "dyn trait name"))
                                       "-dyn")))
               (str-eq head "fnptr")
                 (let [cc
                         (try! (sym-of a
                                       (try! (need [Sexp]
                                                   (sx-get items 1)
                                                   "fnptr type: missing convention"))
                                       "fnptr cc"))
                       pv
                         (try! (need-vec (sx-get items 2)
                                         "fnptr type: expected a vector of parameter types"))
                       params (try! (parse-types a pv))
                       ret
                         (box-type a
                                   (try! (parse-type a
                                                     (try! (need [Sexp]
                                                                 (sx-get items 3)
                                                                 "fnptr type: missing return type")))))]
                   (Ok (TFn cc params ret)))
               :else (Ok (TApp head (try! (parse-types a (rest-from a items 1)))))))))

; ---- type parameters ----
; ONE type-parameter entry: a bare `T`, or `(T Trait…)` carrying bounds. Shared by
; `defn`'s `[T (U Ord)]` vector and `impl`'s, so the two spellings cannot drift apart.
(defstruct TPEntry [(name (slice u8)) (traits (ptr (ArrayList (slice u8))))])
(defn mk-tpentry [(a (ptr Allocator)) (nm (slice u8)) (traits (ptr (ArrayList (slice u8))))] (-> TPEntry)
  (let [r (alloc/stack TPEntry)] (primitive/store! (primitive/field r name) nm) (primitive/store! (primitive/field r traits) traits) (primitive/load r)))
(defn parse-tparam-entry [(a (ptr Allocator)) (entry Sexp)] (-> (Result TPEntry Diag))
  (try (if (primitive/icmp-eq (sx-tag entry) 2)
           (Ok (mk-tpentry a (sx-sval entry) (box-al [(slice u8)] a (al-new [(slice u8)] a))))
           (if (primitive/icmp-eq (sx-tag entry) 6)
               (let [eitems (sx-items entry)
                     pname
                       (try! (sym-of a
                                     (try! (need [Sexp] (sx-get eitems 0) "type parameter: empty () bound"))
                                     "type parameter"))
                     (mut traits) (al-new [(slice u8)] a)
                     tn (sx-len eitems)
                     (mut ti) 1]
                 (loop (if (primitive/icmp-ge (primitive/load ti) tn)
                           (break)
                           (do
                             (al-push! (mut traits) (try! (sym-of a (sx-at eitems (primitive/load ti)) "bound trait")))
                             (primitive/store! ti (primitive/iadd (primitive/load ti) 1)))))
                 (Ok (mk-tpentry a pname (box-al [(slice u8)] a (primitive/load traits)))))
               (Err [TPEntry Diag]
                    (derr-at (sx-lo entry) (sx-hi entry) "type parameter must be a name or (name Trait…)"))))))

(defstruct TPResult [(params (ptr (ArrayList (slice u8)))) (bounds (ptr (ArrayList Bound))) (consumed bool)])
(defn parse-type-params [(a (ptr Allocator)) (rest (ptr (ArrayList Sexp))) (i i64)] (-> (Result TPResult Diag))
  (try (let [a0 (sx-get rest i)
             a1 (sx-get rest (primitive/iadd i 1))]
         (if (not (and (opt-is-vec a0) (opt-is-vec a1)))
             (Ok (let [r (alloc/stack TPResult)]
                   (primitive/store! (primitive/field r params) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
                   (primitive/store! (primitive/field r bounds) (box-al [Bound] a (al-new [Bound] a)))
                   (primitive/store! (primitive/field r consumed) false)
                   (primitive/load r)))
             (let [tp (sx-items (opt-get a0))
                   (mut params) (al-new [(slice u8)] a)
                   (mut bounds) (al-new [Bound] a)
                   n (sx-len tp)
                   (mut k) 0]
               (loop (if (primitive/icmp-ge (primitive/load k) n)
                         (break)
                         (let [entry (sx-at tp (primitive/load k))]
                           (primitive/store! k (primitive/iadd (primitive/load k) 1))
                           (let [ep (alloc/stack TPEntry)]
                             (primitive/store! ep (try! (parse-tparam-entry a entry)))
                             (al-push! (mut params) (primitive/load (primitive/field ep name)))
                             (when (primitive/icmp-gt (al-len [(slice u8)] (primitive/load (primitive/load (primitive/field ep traits)))) 0)
                                   (let [bp (alloc/stack Bound)]
                                     (primitive/store! (primitive/field bp name) (primitive/load (primitive/field ep name)))
                                     (primitive/store! (primitive/field bp traits) (primitive/load (primitive/field ep traits)))
                                     (al-push! (mut bounds) (primitive/load bp))
                                     0))))))
               (Ok (let [r (alloc/stack TPResult)]
                     (primitive/store! (primitive/field r params) (box-al [(slice u8)] a (primitive/load params)))
                     (primitive/store! (primitive/field r bounds) (box-al [Bound] a (primitive/load bounds)))
                     (primitive/store! (primitive/field r consumed) true)
                     (primitive/load r))))))))

; ---- quasiquote ----
(defn build-quasi-seq [(a (ptr Allocator)) (items (ptr (ArrayList Sexp))) (isvec bool)] (-> (Result Quasi Diag))
  (try (let [(mut out) (al-new [Quasi] a)
             n (sx-len items)
             (mut i) 0]
         (loop (if (primitive/icmp-ge (primitive/load i) n)
                   (break)
                   (do (al-push! (mut out) (try! (build-quasi a (sx-at items (primitive/load i))))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
         (Ok (if isvec (QVector (box-al [Quasi] a (primitive/load out))) (QList (box-al [Quasi] a (primitive/load out))))))))
(defn build-quasi [(a (ptr Allocator)) (s Sexp)] (-> (Result Quasi Diag))
  (let [tg (sx-tag s)]
    (if (primitive/icmp-eq tg 6)
        (let [items (sx-items s)]
          (if (primitive/icmp-eq (sx-len items) 2)
              (let [h (sx-at items 0)]
                (if (primitive/icmp-eq (sx-tag h) 2)
                    (let [hs (sx-sval h)]
                      (if (str-eq hs "unquote")
                          (match (parse-expr a (sx-at items 1))
                            (Err [d] (Err d))
                            (Ok [e] (Ok (QUnquote (box-expr a e)))))
                          (if (str-eq hs "unquote-splicing")
                              (match (parse-expr a (sx-at items 1))
                                (Err [d] (Err d))
                                (Ok [e] (Ok (QSplice (box-expr a e)))))
                              (build-quasi-seq a items false))))
                    (build-quasi-seq a items false)))
              (build-quasi-seq a items false)))
        (if (primitive/icmp-eq tg 7)
            (build-quasi-seq a (sx-items s) true)
            (Ok (QLit (box-sexp a s)))))))

; ---- expressions ----
(defn mk-bin [(a (ptr Allocator)) (args (ptr (ArrayList Sexp))) (head (slice u8)) (op i64)] (-> (Result ExprKind Diag))
  (try (let [tp (alloc/stack Two)]
         (primitive/store! tp (try! (need-two a args head)))
         (Ok (EBin op
                   (box-expr a (try! (parse-expr a (primitive/load (primitive/field tp x)))))
                   (box-expr a (try! (parse-expr a (primitive/load (primitive/field tp y))))))))))
(defn mk-cmp [(a (ptr Allocator)) (args (ptr (ArrayList Sexp))) (head (slice u8)) (op i64)] (-> (Result ExprKind Diag))
  (try (let [tp (alloc/stack Two)]
         (primitive/store! tp (try! (need-two a args head)))
         (Ok (ECmp op
                   (box-expr a (try! (parse-expr a (primitive/load (primitive/field tp x)))))
                   (box-expr a (try! (parse-expr a (primitive/load (primitive/field tp y))))))))))
(defn binop-of [(h (slice u8))] (-> i64)
  (cond (str-eq h "iadd") 0
        (str-eq h "isub") 1
        (str-eq h "imul") 2
        (str-eq h "idiv") 3
        (str-eq h "irem") 4
        (str-eq h "udiv") 5
        (str-eq h "urem") 6
        (str-eq h "iand") 7
        (str-eq h "ior") 8
        (str-eq h "ixor") 9
        (str-eq h "ishl") 10
        (str-eq h "ishr") 11
        (str-eq h "fadd") 0
        (str-eq h "fsub") 1
        (str-eq h "fmul") 2
        (str-eq h "fdiv") 3
        (str-eq h "frem") 4
        :else -1))
(defn cmpop-of [(h (slice u8))] (-> i64)
  (cond (str-eq h "fcmp-lt") 0
        (str-eq h "fcmp-le") 1
        (str-eq h "fcmp-gt") 2
        (str-eq h "fcmp-ge") 3
        (str-eq h "fcmp-eq") 4
        (str-eq h "fcmp-ne") 5
        (str-eq h "icmp-lt") 0
        (str-eq h "icmp-le") 1
        (str-eq h "icmp-gt") 2
        (str-eq h "icmp-ge") 3
        (str-eq h "icmp-eq") 4
        (str-eq h "icmp-ne") 5
        :else -1))
(defn codeop-of [(h (slice u8))] (-> i64)
  (cond (str-eq h "code-list?") 0
        (str-eq h "code-sym?") 1
        (str-eq h "code-int?") 2
        (str-eq h "code-count") 3
        (str-eq h "code-nth") 4
        (str-eq h "code-sym") 5
        (str-eq h "code-int") 6
        (str-eq h "code-rest") 7
        (str-eq h "code-eq") 10
        (str-eq h "code-keyword?") 11
        (str-eq h "code-symbol") 12
        (str-eq h "code-str") 13
        (str-eq h "code-field-count") 14
        (str-eq h "code-field-name") 15
        (str-eq h "code-field-kind") 16
        (str-eq h "code-field-type") 17
        (str-eq h "code-variant-sum") 18
        (str-eq h "code-variant-count") 19
        (str-eq h "code-variant-name") 20
        (str-eq h "code-variant-fields") 21
        (str-eq h
                "code-trait-method-count")
          22
        (str-eq h
                "code-trait-method-name")
          23
        (str-eq h
                "code-trait-arity")
          24
        (str-eq h
                "code-trait-param-name")
          25
        (str-eq h
                "code-trait-param-type")
          26
        (str-eq h
                "code-trait-ret-type")
          27
        (str-eq h
                "str-bytes")
          28
        (str-eq h
                "bytes->str")
          29
        (str-eq h
                "int->str")
          38
        :else -1))
(defn typequery-of [(h (slice u8))] (-> i64)
  (cond (str-eq h "field-count") 0
        (str-eq h "variant-count") 1
        (str-eq h "struct?") 2
        (str-eq h "sum?") 3
        (str-eq h "int?") 4
        (str-eq h "float?") 5
        (str-eq h "ptr?") 6
        (str-eq h "array?") 7
        :else -1))
(defn fieldmeta-of [(h (slice u8))] (-> i64)
  (cond (str-eq h "field-name") 0 (str-eq h "field-type-kind") 1 (str-eq h "field-type-name") 2 :else -1))
(defn alloc-form [(a (ptr Allocator)) (args (ptr (ArrayList Sexp))) (storage i64)] (-> (Result ExprKind Diag))
  (try (let [ty (match (sx-get args 0) (Some [t] (try! (parse-type a t))) (None [] (TInt 64 true)))]
         (Ok (EAlloc storage ty)))))
(defn parse-exprs [(a (ptr Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (let [(mut out) (al-new [Expr] a)
             n (sx-len items)
             (mut i) 0]
         (loop (if (primitive/icmp-ge (primitive/load i) n)
                   (break)
                   (do (al-push! (mut out) (try! (parse-expr a (sx-at items (primitive/load i))))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
         (Ok (box-al [Expr] a (primitive/load out))))))
; ---- recursion depth guard --------------------------------------------------
; The parser recurses once per nesting LEVEL, and each level is expensive (~75 KB of
; stack: parse-expr-inner is one big match whose per-branch allocas are all hoisted to
; the entry block, so every call pays for every branch). Deeply nested input therefore
; ran off the end of the stack and killed the compiler with a bare SIGBUS/SIGSEGV and
; ZERO output — no message, no location, nothing naming the construct.
;
; Macros make this ordinary rather than exotic: `cond` expands to nested ifs, so an
; 800-clause dispatch table is 800 levels deep, and a derive over a wide struct nests
; the same way. This is a compiler whose whole purpose is generating code, so the depth
; ceiling is a real limit and it must announce itself instead of crashing.
;
; The counter is process-global rather than threaded through every parse entry point:
; the pipeline parses on one thread at a time. The limit sits well under the measured
; stack cliff (see run-on-big-stack) so the diagnostic always wins the race.
(defn parse-depth-cell [] (-> (ptr i64))
  (alloc/static i64))
(defn parse-depth-limit [] (-> i64)
  2000)

(defn parse-expr [(a (ptr Allocator)) (s Sexp)] (-> (Result Expr Diag))
  (let [d (parse-depth-cell)]
    (primitive/store! d (primitive/iadd (primitive/load d) 1))
    (if (primitive/icmp-gt (primitive/load d) (parse-depth-limit))
        (do
          (primitive/store! d (primitive/isub (primitive/load d) 1))
          (Err (derr-at (sx-lo s)
                        (sx-hi s)
                        "expression nests more than 2000 levels deep — the parser recurses per level and would run out of stack. If this came from a macro, emit a flatter form (e.g. a jump table or a loop over a data table) instead of one deeply nested expression.")))
        ; the decrement is repeated per arm rather than hoisted into a `let`. gen-9 fixed
        ; the underlying inference hole — a returned let binding now takes the function's
        ; return type `(Result Expr Diag)`, so `(let [r (match …)] (primitive/store! d …) r)` would
        ; type-check under THIS compiler — but the self-host source must stay buildable by
        ; the committed pre-gen-9 seed (rebootstrap stage0), which cannot infer it. Keep the
        ; per-arm form until the seed is refreshed past this commit.
        (match (parse-expr-inner a s)
          (Err [dg]
               (do
                 (primitive/store! d (primitive/isub (primitive/load d) 1))
                 (Err (dwspan dg (sx-source s) (sx-lo s) (sx-hi s) (sx-ctxt s)))))
          (Ok [kind]
              (do
                (primitive/store! d (primitive/isub (primitive/load d) 1))
                (Ok (mk-expr-nid kind (sx-lo s) (sx-hi s) (sx-source s) (sx-ctxt s) (sx-nid s)))))))))
(defn parse-expr-inner [(a (ptr Allocator)) (s Sexp)] (-> (Result ExprKind Diag))
  (let [tg (sx-tag s)
        slo (sx-lo s)
        shi (sx-hi s)]
    (cond (primitive/icmp-eq tg 0) (Ok (EInt (sx-ival s)))
          (primitive/icmp-eq tg 1) (Ok (EFloat (sx-ival s)))
          (primitive/icmp-eq tg 2)
            (let [nm (sx-sval s)]
              (if (str-eq nm "true") (Ok (EBool true)) (if (str-eq nm "false") (Ok (EBool false)) (Ok (EVar nm)))))
          (primitive/icmp-eq tg 3)
            (Err (derr-at slo shi (sconcat a "unexpected keyword :" (sconcat a (sx-sval s) " in expression"))))
          (primitive/icmp-eq tg 4) (Ok (EStr (sx-sval s)))
          (primitive/icmp-eq tg 5) (Ok (ECStr (sx-sval s)))
          (primitive/icmp-eq tg 7) (Err (derr-at slo shi "unexpected vector in expression"))
          :else (parse-list-expr a (sx-items s) slo shi (sx-source s) (sx-ctxt s)))))

; A leading:label keyword.
(defstruct LabelSplit [(label (Option (slice u8))) (rest (ptr (ArrayList Sexp)))])
(defn split-label [(a (ptr Allocator)) (args (ptr (ArrayList Sexp)))] (-> LabelSplit)
  (let [r (alloc/stack LabelSplit)]
    (if (and (primitive/icmp-gt (sx-len args) 0) (primitive/icmp-eq (sx-tag (sx-at args 0)) 3))
        (do (primitive/store! (primitive/field r label) (Some (sx-sval (sx-at args 0)))) (primitive/store! (primitive/field r rest) (rest-from a args 1)))
        (do (primitive/store! (primitive/field r label) (None [(slice u8)])) (primitive/store! (primitive/field r rest) args)))
    (primitive/load r)))

; (let [binds...] body...) — `let` arm.
(defn parse-let [(a (ptr Allocator)) (args (ptr (ArrayList Sexp))) (slo i64) (shi i64)] (-> (Result ExprKind Diag))
  (try (let [bvo (sx-get args 0)]
         (when (not (opt-is-vec bvo))
               (break :try (Err [ExprKind Diag] (derr-at slo shi "let: expected binding vector"))))
         (let [bv (sx-items (opt-get bvo))
               nb (sx-len bv)]
           (when (not (primitive/icmp-eq (primitive/urem nb 2) 0))
                 (break :try (Err [ExprKind Diag] (derr-at slo shi "let: bindings must be name/value pairs"))))
           (let [(mut binds) (al-new [Bind] a)
                 (mut k) 0]
             (loop (if (primitive/icmp-ge (primitive/load k) nb)
                       (break)
                       (let [nmf (sx-at bv (primitive/load k))
                             vf (sx-at bv (primitive/iadd (primitive/load k) 1))]
                         (let [bp (alloc/stack Bind)]
                           (if (primitive/icmp-eq (sx-tag nmf) 2)
                               (do (primitive/store! (primitive/field bp name) (sx-sval nmf)) (primitive/store! (primitive/field bp mutable) false))
                               (if (and (primitive/icmp-eq (sx-tag nmf) 6)
                                        (and (primitive/icmp-eq (sx-len (sx-items nmf)) 2)
                                             (str-eq (try! (head-sym a (sx-items nmf))) "mut")))
                                   (do
                                     (primitive/store! (primitive/field bp name)
                                             (try! (sym-of a (sx-at (sx-items nmf) 1) "let binding name")))
                                     (primitive/store! (primitive/field bp mutable) true))
                                   (return-from :try
                                                (Err [ExprKind Diag]
                                                     (derr-at (sx-lo nmf)
                                                              (sx-hi nmf)
                                                              (sconcat3 a
                                                                        "let binding name must be `name` or `(mut name)`, got "
                                                                        (sexp-display a nmf)
                                                                        ""))))))
                           (primitive/store! (primitive/field bp value) (try! (parse-expr a vf)))
                           (al-push! (mut binds) (primitive/load bp)))
                         (primitive/store! k (primitive/iadd (primitive/load k) 2)))))
             (let [body (try! (parse-exprs a (rest-from a args 1)))]
               (when (primitive/icmp-eq (al-len [Expr] (primitive/load body)) 0)
                     (break :try (Err [ExprKind Diag] (derr-at slo shi "let: empty body"))))
               (Ok (ELet (box-al [Bind] a (primitive/load binds)) body))))))))

; (match scrut arms...) — `match` arm.
(defn parse-match [(a (ptr Allocator)) (args (ptr (ArrayList Sexp))) (slo i64) (shi i64)] (-> (Result ExprKind Diag))
  (try (let [scrut (box-expr a (try! (parse-expr a (try! (need [Sexp] (sx-get args 0) "match: missing scrutinee")))))
             (mut arms) (al-new [Arm] a)
             n (sx-len args)
             (mut i) 1]
         (loop (if (primitive/icmp-ge (primitive/load i) n)
                   (break)
                   (let [arm-s (sx-at args (primitive/load i))]
                     (primitive/store! i (primitive/iadd (primitive/load i) 1))
                     (let [al (try! (as-list arm-s "match arm must be (Variant [binds] body)"))
                           variant (try! (sym-of a (try! (need [Sexp] (sx-get al 0) "arm: missing variant")) "variant"))
                           bvo (sx-get al 1)]
                       (when (not (opt-is-vec bvo))
                             (break :try
                                    (Err [ExprKind Diag]
                                         (derr-at (sx-lo arm-s)
                                                  (sx-hi arm-s)
                                                  (sconcat3 a "arm '" variant "': expected a bind vector")))))
                       (let [bv (sx-items (opt-get bvo))
                             (mut binds) (al-new [(slice u8)] a)
                             nb (sx-len bv)
                             (mut bi) 0]
                         (loop (if (primitive/icmp-ge (primitive/load bi) nb)
                                   (break)
                                   (do
                                     (al-push! (mut binds) (try! (sym-of a (sx-at bv (primitive/load bi)) "bind")))
                                     (primitive/store! bi (primitive/iadd (primitive/load bi) 1)))))
                         (let [bodyf (try! (parse-exprs a (rest-from a al 2)))
                               nbody (al-len [Expr] (primitive/load bodyf))]
                           (let [body
                                   (if (primitive/icmp-eq nbody 0)
                                       (return-from :try
                                                    (Err [ExprKind Diag]
                                                         (derr-at (sx-lo arm-s)
                                                                  (sx-hi arm-s)
                                                                  (sconcat3 a "arm '" variant "': missing body"))))
                                       (if (primitive/icmp-eq nbody 1)
                                           (al-get [Expr] (primitive/load bodyf) 0)
                                           (mk-expr (EDo bodyf)
                                                    (sx-lo arm-s)
                                                    (sx-hi arm-s)
                                                    (sx-source arm-s)
                                                    (sx-ctxt arm-s))))]
                             (let [ap (alloc/stack Arm)]
                               (primitive/store! (primitive/field ap variant) variant)
                               (primitive/store! (primitive/field ap binds) (box-al [(slice u8)] a (primitive/load binds)))
                               (primitive/store! (primitive/field ap body) body)
                               (al-push! (mut arms) (primitive/load ap))))))))))
         (Ok (EMatch scrut (box-al [Arm] a (primitive/load arms)))))))

; (primitive/llvm-ir RESULT [operands] "BODY") — `llvm-ir` arm.
(defn parse-llvm-ir [(a (ptr Allocator)) (args (ptr (ArrayList Sexp))) (slo i64) (shi i64)] (-> (Result ExprKind Diag))
  (try (if (primitive/icmp-ne (sx-len args) 3)
           (Err [ExprKind Diag] (derr-at slo shi "llvm-ir: expects (primitive/llvm-ir RESULT-TYPE [operands...] \"BODY\")"))
           (let [result (try! (parse-type a (sx-at args 0)))
                 ov (sx-at args 1)]
             (when (not (primitive/icmp-eq (sx-tag ov) 7))
                   (break :try
                          (Err [ExprKind Diag]
                               (derr-at (sx-lo ov) (sx-hi ov) "llvm-ir: expected a [operand...] vector"))))
             (let [operands (try! (parse-exprs a (sx-items ov)))
                   bv (sx-at args 2)]
               (when (not (primitive/icmp-eq (sx-tag bv) 4))
                     (break :try
                            (Err [ExprKind Diag]
                                 (derr-at (sx-lo bv) (sx-hi bv) "llvm-ir: body must be a string literal"))))
               (Ok (ELlvmIr result operands (sx-sval bv))))))))

; Heads that are only ever valid at the top level — none of them is also an
; expression head (a definition never nests inside a value), so seeing one in
; expression position is unambiguous. Keep in sync with the top-level dispatch in
; parse-program and the loader's own (module/import/export/cimport) handling.
(defn toplevel-only-head? [(h (slice u8))] (-> bool)
  (cond (str-eq h "defn") true
        (str-eq h "defstruct") true
        (str-eq h "defsum") true
        (str-eq h "defcc") true
        (str-eq h "extern") true
        (str-eq h "export-c") true
        (str-eq h "const") true
        (str-eq h "deftrait") true
        (str-eq h "impl") true
        (str-eq h "static-assert") true
        (str-eq h "meta") true
        (str-eq h "module") true
        (str-eq h "import") true
        (str-eq h "export") true
        (str-eq h "cimport") true
        :else false))

; A top-level definition in expression position is never legal, and in practice it
; means an earlier form lost a ')' and swallowed this one. Say that, anchored at the
; swallowed definition. Without this the head falls through to the call path and the
; failure surfaces from its parameter list as "unexpected vector in expression" —
; a symptom several lines away from the missing paren, in a form that is itself fine.
(defn nested-toplevel-diag [(a (ptr Allocator)) (head (slice u8)) (args (ptr (ArrayList Sexp))) (slo i64) (shi i64)] (-> Diag)
  (let [named (if (primitive/icmp-eq (sx-len args) 0) false (primitive/icmp-eq (sx-tag (sx-at args 0)) 2))
        what (if named (sconcat3 a "'" head (sconcat3 a " " (sx-sval (sx-at args 0)) "'")) (sconcat3 a "'" head "'"))]
    (derr-at slo
             shi
             (sconcat a
                      what
                      " is a top-level definition, but it appears inside an expression — an enclosing form is missing a ')'"))))

; the big head dispatch.
; A bare `:` reads as an empty keyword (KKw ""), so a list whose head is one is the
; type-ascription form `(: value type)` — checked here BEFORE head-sym, which would
; otherwise reject the non-symbol head.
(defn ascribe-head? [(items (ptr (ArrayList Sexp)))] (-> bool)
  (and (primitive/icmp-gt (sx-len items) 0)
       (and (primitive/icmp-eq (sx-tag (sx-at items 0)) 3) (primitive/icmp-eq (slice-len (sx-sval (sx-at items 0))) 0))))
(defn parse-list-expr [(a (ptr Allocator)) (items (ptr (ArrayList Sexp))) (slo i64) (shi i64) (ssrc i64) (sctxt i64)] (-> (Result ExprKind
                                                                                                                                  Diag))
  (try (if (ascribe-head? items)
           (if (primitive/icmp-ne (sx-len items) 3)
               (Err [ExprKind Diag] (derr-at slo shi "type ascription: expects (: value type)"))
               (Ok (EAscribe (try! (parse-type a (sx-at items 2))) (box-expr a (try! (parse-expr a (sx-at items 1)))))))
           (let [source-head (try! (head-sym a items))
                 head (match (primitive-dispatch-head source-head) (Some [op] op) (None [] ""))
                 args (rest-from a items 1)
                 nargs (sx-len args)]
             (when (toplevel-only-head? source-head)
                   (break :try (Err [ExprKind Diag] (nested-toplevel-diag a source-head args slo shi))))
             (let [bop (binop-of head)]
               (if (primitive/icmp-ge bop 0)
                   (mk-bin a args head bop)
                   (let [cop (cmpop-of head)]
                     (cond (primitive/icmp-ge cop 0) (mk-cmp a args head cop)
                           (str-eq head "inot")
                             (if (primitive/icmp-ne nargs 1)
                                 (Err [ExprKind Diag] (derr-at slo shi "inot: expects (primitive/inot x)"))
                                 (Ok (ENot (box-expr a (try! (parse-expr a (sx-at args 0)))))))
                           (str-eq source-head "and")
                             (let [tp (alloc/stack Two)]
                               (primitive/store! tp (try! (need-two a args "and")))
                               (Ok (EIf (box-expr a (try! (parse-expr a (primitive/load (primitive/field tp x)))))
                                        (box-expr a (try! (parse-expr a (primitive/load (primitive/field tp y)))))
                                        (box-expr a (mk-expr (EBool false) slo shi ssrc sctxt)))))
                           (str-eq source-head "or")
                             (let [tp (alloc/stack Two)]
                               (primitive/store! tp (try! (need-two a args "or")))
                               (Ok (EIf (box-expr a (try! (parse-expr a (primitive/load (primitive/field tp x)))))
                                        (box-expr a (mk-expr (EBool true) slo shi ssrc sctxt))
                                        (box-expr a (try! (parse-expr a (primitive/load (primitive/field tp y))))))))
                           (str-eq source-head "not")
                             (if (primitive/icmp-ne nargs 1)
                                 (Err [ExprKind Diag] (derr-at slo shi "not: expects (not x)"))
                                 (Ok (EIf (box-expr a (try! (parse-expr a (sx-at args 0))))
                                          (box-expr a (mk-expr (EBool false) slo shi ssrc sctxt))
                                          (box-expr a (mk-expr (EBool true) slo shi ssrc sctxt)))))
                           (str-eq source-head "if")
                             (if (primitive/icmp-ne nargs 3)
                                 (Err [ExprKind Diag]
                                      (derr-at slo shi "if: expects (if cond then else)"))
                                 (Ok (EIf (box-expr a (try! (parse-expr a (sx-at args 0))))
                                          (box-expr a (try! (parse-expr a (sx-at args 1))))
                                          (box-expr a (try! (parse-expr a (sx-at args 2)))))))
                           (str-eq source-head "do") (Ok (EDo (try! (parse-exprs a args))))
                           (str-eq source-head "comptime")
                             (if (primitive/icmp-ne nargs 1)
                                 (Err [ExprKind Diag]
                                      (derr-at slo shi "comptime: expects (comptime expr)"))
                                 (Ok (EComptime (box-expr a
                                                          (try! (parse-expr a (sx-at args 0)))))))
                           (str-eq source-head "let") (parse-let a args slo shi)
                           (str-eq source-head "call")
                             (let [f
                                     (try! (sym-of a
                                                   (try! (need [Sexp]
                                                               (sx-get args 0)
                                                               "call: missing function"))
                                                   "call target"))]
                               (Ok (ECall f
                                          (box-al [Type] a (al-new [Type] a))
                                          (try! (parse-exprs a (rest-from a args 1))))))
                           (str-eq head "zeroed")
                             (if (primitive/icmp-ne nargs 1)
                                 (Err [ExprKind Diag]
                                      (derr-at slo
                                               shi
                                               "zeroed: expects (primitive/zeroed TYPE)"))
                                 (Ok (EZeroed (try! (parse-type a (sx-at args 0))))))
                           (str-eq source-head "mut")
                             (if (primitive/icmp-ne nargs 1)
                                 (Err [ExprKind Diag]
                                      (derr-at slo
                                               shi
                                               "mut: expects (mut PLACE)"))
                                 (Ok (EBorrow true
                                              (box-expr a
                                                        (try! (parse-expr a
                                                                          (sx-at args
                                                                                 0)))))))
                           (str-eq head "alloc-stack") (alloc-form a args 0)
                           (str-eq head "alloc-static") (alloc-form a args 1)
                           (str-eq head "alloc-heap") (alloc-form a args 2)
                           (str-eq head "field")
                             (Ok (EField (box-expr a
                                                   (try! (parse-expr a
                                                                     (try! (need [Sexp]
                                                                                 (sx-get args
                                                                                         0)
                                                                                 "field: missing pointer")))))
                                         (try! (sym-of a
                                                       (try! (need [Sexp]
                                                                   (sx-get args
                                                                           1)
                                                                   "field: missing field name"))
                                                       "field name"))))
                           (str-eq head "bit-get")
                             (Ok (EBitGet (box-expr a
                                                    (try! (parse-expr a
                                                                      (try! (need [Sexp]
                                                                                  (sx-get args
                                                                                          0)
                                                                                  "get: missing pointer")))))
                                          (try! (sym-of a
                                                        (try! (need [Sexp]
                                                                    (sx-get args
                                                                            1)
                                                                    "get: missing field name"))
                                                        "field name"))))
                           (str-eq head "bit-set!")
                             (Ok (EBitSet (box-expr a
                                                    (try! (parse-expr a
                                                                      (try! (need [Sexp]
                                                                                  (sx-get args
                                                                                          0)
                                                                                  "set!: missing pointer")))))
                                          (try! (sym-of a
                                                        (try! (need [Sexp]
                                                                    (sx-get args
                                                                            1)
                                                                    "set!: missing field name"))
                                                        "field name"))
                                          (box-expr a
                                                    (try! (parse-expr a
                                                                      (try! (need [Sexp]
                                                                                  (sx-get args
                                                                                          2)
                                                                                  "set!: missing value")))))))
                           (str-eq head
                                   "fnptr-of")
                             (if (primitive/icmp-ne nargs 1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "fnptr-of: expects (primitive/fnptr-of name)"))
                                 (Ok (EFnPtrOf (try! (sym-of a
                                                             (sx-at args
                                                                    0)
                                                             "function name")))))
                           (str-eq head
                                   "call-ptr")
                             (Ok (ECallPtr (box-expr a
                                                     (try! (parse-expr a
                                                                       (try! (need [Sexp]
                                                                                   (sx-get args
                                                                                           0)
                                                                                   "call-ptr: missing function pointer")))))
                                           (try! (parse-exprs a
                                                              (rest-from a
                                                                         args
                                                                         1)))))
                           (str-eq head
                                   "load")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "load: expects (primitive/load ptr)"))
                                 (Ok (ELoad (box-expr a
                                                      (try! (parse-expr a
                                                                        (sx-at args
                                                                               0)))))))
                           (str-eq head
                                   "store!")
                             (let [tp (alloc/stack Two)]
                               (primitive/store! tp
                                       (try! (need-two a
                                                       args
                                                       "store!")))
                               (Ok (EStore (box-expr a
                                                     (try! (parse-expr a
                                                                       (primitive/load (primitive/field tp
                                                                                    x)))))
                                           (box-expr a
                                                     (try! (parse-expr a
                                                                       (primitive/load (primitive/field tp
                                                                                    y))))))))
                           (str-eq head
                                   "free")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "free: expects (primitive/free ptr)"))
                                 (Ok (EFree (box-expr a
                                                      (try! (parse-expr a
                                                                        (sx-at args
                                                                               0)))))))
                           (str-eq head
                                   "make-dyn")
                             (if (primitive/icmp-ne nargs
                                          2)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "make-dyn: expects (primitive/make-dyn Trait expr)"))
                                 (Ok (EErase (try! (sym-of a
                                                           (sx-at args
                                                                  0)
                                                           "make-dyn trait name"))
                                             (box-expr a
                                                       (try! (parse-expr a
                                                                         (sx-at args
                                                                                1)))))))
                           (str-eq head
                                   "index")
                             (let [tp (alloc/stack Two)]
                               (primitive/store! tp
                                       (try! (need-two a
                                                       args
                                                       "index")))
                               (Ok (EIndex (box-expr a
                                                     (try! (parse-expr a
                                                                       (primitive/load (primitive/field tp
                                                                                    x)))))
                                           (box-expr a
                                                     (try! (parse-expr a
                                                                       (primitive/load (primitive/field tp
                                                                                    y))))))))
                           (str-eq head
                                   "cast")
                             (if (primitive/icmp-ne nargs
                                          2)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "cast: expects (primitive/cast :type expr)"))
                                 (Ok (ECast (try! (parse-type a
                                                              (sx-at args
                                                                     0)))
                                            (box-expr a
                                                      (try! (parse-expr a
                                                                        (sx-at args
                                                                               1)))))))
                           (str-eq source-head "match")
                             (parse-match a
                                          args
                                          slo
                                          shi)
                           (str-eq head
                                   "sizeof")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "sizeof: expects (primitive/sizeof TYPE)"))
                                 (Ok (ESizeOf (try! (parse-type a
                                                                (sx-at args
                                                                       0))))))
                           (str-eq head
                                   "alignof")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "alignof: expects (primitive/alignof TYPE)"))
                                 (Ok (EAlignOf (try! (parse-type a
                                                                 (sx-at args
                                                                        0))))))
                           (str-eq head
                                   "offsetof")
                             (if (primitive/icmp-ne nargs
                                          2)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "offsetof: expects (primitive/offsetof TYPE field)"))
                                 (Ok (EOffsetOf (try! (parse-type a
                                                                  (sx-at args
                                                                         0)))
                                                (try! (sym-of a
                                                              (sx-at args
                                                                     1)
                                                              "field")))))
                           (primitive/icmp-ge (typequery-of head)
                                    0)
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               (sconcat a
                                                        head
                                                        (sconcat a
                                                                 ": expects ("
                                                                 (sconcat a
                                                                          head
                                                                          " TYPE)")))))
                                 (Ok (ETypeQuery (typequery-of head)
                                                 (try! (parse-type a
                                                                   (sx-at args
                                                                          0))))))
                           (primitive/icmp-ge (fieldmeta-of head)
                                    0)
                             (if (primitive/icmp-ne nargs
                                          2)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               (sconcat a
                                                        head
                                                        (sconcat a
                                                                 ": expects ("
                                                                 (sconcat a
                                                                          head
                                                                          " TYPE index)")))))
                                 (Ok (EFieldMeta (fieldmeta-of head)
                                                 (try! (parse-type a
                                                                   (sx-at args
                                                                          0)))
                                                 (box-expr a
                                                           (try! (parse-expr a
                                                                             (sx-at args
                                                                                    1)))))))
                           (str-eq head
                                   "field-index")
                             (if (primitive/icmp-ne nargs
                                          2)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "field-index: expects (primitive/field-index TYPE name)"))
                                 (Ok (EFieldIndex (try! (parse-type a
                                                                    (sx-at args
                                                                           0)))
                                                  (box-expr a
                                                            (try! (parse-expr a
                                                                              (sx-at args
                                                                                     1)))))))
                           (str-eq source-head "quote")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "quote: expects (quote FORM)"))
                                 (Ok (EQuote (box-sexp a
                                                       (sx-at args
                                                              0)))))
                           (str-eq source-head "quasiquote")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "quasiquote: expects one template"))
                                 (Ok (EQuasi (try! (build-quasi a
                                                                (sx-at args
                                                                       0))))))
                           (str-eq source-head "unquote")
                             (Err [ExprKind
                                   Diag]
                                  (derr-at slo
                                           shi
                                           "unquote (~) is only valid inside a quasiquote (`)"))
                           (str-eq head
                                   "gensym")
                             (if (not (primitive/icmp-eq nargs
                                               0))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "gensym: expects (primitive/gensym)"))
                                 (Ok (ECodeOp 8
                                              (box-al [Expr]
                                                      a
                                                      (al-new [Expr]
                                                              a)))))
                           (str-eq head
                                   "target-arch")
                             (if (not (primitive/icmp-eq nargs
                                               0))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "target-arch: expects (primitive/target-arch)"))
                                 (Ok (ECodeOp 30
                                              (box-al [Expr]
                                                      a
                                                      (al-new [Expr]
                                                              a)))))
                           (str-eq head
                                   "target-os")
                             (if (not (primitive/icmp-eq nargs
                                               0))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "target-os: expects (primitive/target-os)"))
                                 (Ok (ECodeOp 46
                                              (box-al [Expr]
                                                      a
                                                      (al-new [Expr]
                                                              a)))))
                           (str-eq head
                                   "debug-checks?")
                             (if (not (primitive/icmp-eq nargs
                                               0))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "debug-checks?: expects (primitive/debug-checks?)"))
                                 (Ok (ECodeOp 39
                                              (box-al [Expr]
                                                      a
                                                      (al-new [Expr]
                                                              a)))))
                           (str-eq head
                                   "error")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "error: expects (primitive/error MSG)"))
                                 (Ok (ECodeOp 9
                                              (try! (parse-exprs a
                                                                 args)))))
                           (str-eq head
                                   "report")
                             (if (primitive/icmp-ne nargs
                                          2)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "report: expects (primitive/report NODE MSG)"))
                                 (Ok (ECodeOp 31
                                              (try! (parse-exprs a
                                                                 args)))))
                           (or (str-eq head
                                       "warn")
                               (str-eq head
                                       "suggest"))  ; `suggest` is `warn` plus the rewrite it proposes — op 44, docs/archive/AUTOFIX.md
                             (if (primitive/icmp-ne nargs
                                          (if (str-eq head
                                                      "warn")
                                              2
                                              3))
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               (if (str-eq head
                                                           "warn")
                                                   "warn: expects (primitive/warn NODE MSG)"
                                                   "suggest: expects (primitive/suggest NODE MSG REPLACEMENT)")))
                                 (Ok (ECodeOp (if (str-eq head
                                                          "warn")
                                                  32
                                                  44)
                                              (try! (parse-exprs a
                                                                 args)))))
                           (str-eq head
                                   "code-file")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "code-file: expects (primitive/code-file NODE)"))
                                 (Ok (ECodeOp 33
                                              (try! (parse-exprs a
                                                                 args)))))
                           (str-eq head
                                   "code-line")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "code-line: expects (primitive/code-line NODE)"))
                                 (Ok (ECodeOp 40
                                              (try! (parse-exprs a
                                                                 args)))))
                           (str-eq head
                                   "code-src")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "code-src: expects (primitive/code-src NODE)"))
                                 (Ok (ECodeOp 41
                                              (try! (parse-exprs a
                                                                 args)))))
                           (str-eq head
                                   "code-col")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "code-col: expects (primitive/code-col NODE)"))
                                 (Ok (ECodeOp 42
                                              (try! (parse-exprs a
                                                                 args)))))
                           (str-eq head
                                   "code-doc")
                             (if (primitive/icmp-ne nargs
                                          1)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "code-doc: expects (primitive/code-doc NODE)"))
                                 (Ok (ECodeOp 43
                                              (try! (parse-exprs a
                                                                 args)))))
                           (or (str-eq head
                                       "code-from-user?")
                               (str-eq head
                                       "code-macro?"))  ; two ORIGIN questions about a node: which FILE it came from (34) and whether a
                           ; macro produced it rather than a human typing it (45).
                           (if (primitive/icmp-ne nargs
                                        1)
                               (Err [ExprKind
                                     Diag]
                                    (derr-at slo
                                             shi
                                             (sconcat a
                                                      head
                                                      ": expects one Code node")))
                               (Ok (ECodeOp (if (str-eq head
                                                        "code-from-user?")
                                                34
                                                45)
                                            (try! (parse-exprs a
                                                               args)))))
                             (str-eq head
                                     "code-decl")
                           (if (primitive/icmp-ne nargs
                                        1)
                               (Err [ExprKind
                                     Diag]
                                    (derr-at slo
                                             shi
                                             "code-decl: expects (primitive/code-decl NODE)"))
                               (Ok (ECodeOp 35
                                            (try! (parse-exprs a
                                                               args)))))
                             (str-eq head
                                     "type-of")
                           (if (primitive/icmp-ne nargs
                                        1)
                               (Err [ExprKind
                                     Diag]
                                    (derr-at slo
                                             shi
                                             "type-of: expects (primitive/type-of NODE)"))
                               (Ok (ECodeOp 36
                                            (try! (parse-exprs a
                                                               args)))))
                             (str-eq head
                                     "binding-of")
                           (if (primitive/icmp-ne nargs
                                        1)
                               (Err [ExprKind
                                     Diag]
                                    (derr-at slo
                                             shi
                                             "binding-of: expects (primitive/binding-of NODE)"))
                               (Ok (ECodeOp 37
                                            (try! (parse-exprs a
                                                               args)))))
                             (primitive/icmp-ge (codeop-of head)
                                      0)
                           (Ok (ECodeOp (codeop-of head)
                                        (try! (parse-exprs a
                                                           args))))
                             (str-eq source-head "loop")
                           (let [lr (alloc/stack LabelSplit)]
                             (primitive/store! lr
                                     (split-label a
                                                  args))
                             (let [body
                                     (try! (parse-exprs a
                                                        (primitive/load (primitive/field lr
                                                                     rest))))]
                               (if (primitive/icmp-eq (al-len [Expr]
                                                    (primitive/load body))
                                            0)
                                   (Err [ExprKind
                                         Diag]
                                        (derr-at slo
                                                 shi
                                                 "loop: expects (loop [:label] body...)"))
                                   (Ok (ELoop (primitive/load (primitive/field lr
                                                           label))
                                              body)))))
                             (str-eq source-head "break")
                           (let [lr (alloc/stack LabelSplit)]
                             (primitive/store! lr
                                     (split-label a
                                                  args))
                             (let [r
                                     (primitive/load (primitive/field lr
                                                  rest))]
                               (if (primitive/icmp-gt (sx-len r)
                                            1)
                                   (Err [ExprKind
                                         Diag]
                                        (derr-at slo
                                                 shi
                                                 "break: expects (break [:label] [value])"))
                                   (Ok (EBreak (primitive/load (primitive/field lr
                                                            label))
                                               (match (sx-get r
                                                              0)
                                                 (Some [e]
                                                       (Some (box-expr a
                                                                       (try! (parse-expr a
                                                                                         e)))))
                                                 (None []
                                                       (None [(ptr Expr)]))))))))
                             (str-eq source-head "continue")
                           (let [lr (alloc/stack LabelSplit)]
                             (primitive/store! lr
                                     (split-label a
                                                  args))
                             (if (primitive/icmp-gt (sx-len (primitive/load (primitive/field lr
                                                               rest)))
                                          0)
                                 (Err [ExprKind
                                       Diag]
                                      (derr-at slo
                                               shi
                                               "continue: expects (continue [:label])"))
                                 (Ok (EContinue (primitive/load (primitive/field lr
                                                             label))))))
                             (str-eq head
                                     "llvm-ir")
                           (parse-llvm-ir a
                                          args
                                          slo
                                          shi)
                             :else
                           (let [fv
                                   (sx-get args
                                           0)]
                             (if (opt-is-vec fv)
                                 (Ok (ECall source-head
                                            (try! (parse-types a
                                                               (sx-items (opt-get fv))))
                                            (try! (parse-exprs a
                                                               (rest-from a
                                                                          args
                                                                          1)))))
                                 (Ok (ECall source-head
                                            (box-al [Type]
                                                    a
                                                    (al-new [Type]
                                                            a))
                                            (try! (parse-exprs a
                                                               args))))))))))))))
; ---- declaration parsers ----
(defn func-name [(f Func)] (-> (slice u8))
  (let [p (alloc/stack Func)] (primitive/store! p f) (primitive/load (primitive/field p name))))

; variant/struct fields: (name :type) -> Field.
(defn parse-fields [(a (ptr Allocator)) (fv (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList Field)) Diag))
  (try (let [(mut fs) (al-new [Field] a)
             n (sx-len fv)
             (mut i) 0]
         (loop (if (primitive/icmp-ge (primitive/load i) n)
                   (break)
                   (let [f (sx-at fv (primitive/load i))]
                     (primitive/store! i (primitive/iadd (primitive/load i) 1))
                     (let [fl (try! (as-list f "field must be (name :type)"))
                           fn0 (try! (sym-of a (sx-at fl 0) "field name"))
                           ft (try! (parse-type a (try! (need [Sexp] (sx-get fl 1) "field type"))))]
                       (let [fp (alloc/stack Field)]
                         (primitive/store! (primitive/field fp name) fn0)
                         (primitive/store! (primitive/field fp ty) ft)
                         (al-push! (mut fs) (primitive/load fp)))))))
         (Ok (box-al [Field] a (primitive/load fs))))))

(defn parse-const [(a (ptr Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result Const Diag))
  (try (let [name (try! (sym-of a (try! (need [Sexp] (sx-get rest 0) "const: missing name")) "const name"))
             nr (sx-len rest)]
         (if (primitive/icmp-eq nr 2)
             (let [value (try! (parse-expr a (sx-at rest 1)))]
               (Ok (let [c (alloc/stack Const)]
                     (primitive/store! (primitive/field c name) name)
                     (primitive/store! (primitive/field c ty) (None [Type]))
                     (primitive/store! (primitive/field c value) value)
                     (primitive/load c))))
             (if (primitive/icmp-eq nr 3)
                 (let [ty (try! (parse-type a (sx-at rest 1)))
                       value (try! (parse-expr a (sx-at rest 2)))]
                   (Ok (let [c (alloc/stack Const)]
                         (primitive/store! (primitive/field c name) name)
                         (primitive/store! (primitive/field c ty) (Some ty))
                         (primitive/store! (primitive/field c value) value)
                         (primitive/load c))))
                 (Err [Const Diag] (derr "const: expected (const NAME VALUE) or (const NAME TYPE VALUE)")))))))

(defn parse-defsum [(a (ptr Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result SumDef Diag))
  (try (let [name (try! (sym-of a (try! (need [Sexp] (sx-get rest 0) "defsum: missing name")) "sum name"))
             (mut i) 1
             (mut tps) (al-new [(slice u8)] a)
             (mut sbounds) (al-new [Bound] a)]
         ; type params may carry bounds — `(T Ord)` — via the SAME per-entry parser defn and
         ; defstruct use, so the three forms cannot drift apart. (This used to require a bare
         ; symbol and reject `(T Ord)` outright, the only form of the three that did.)
         (when (opt-is-vec (sx-get rest (primitive/load i)))
               (let [it (sx-items (opt-get (sx-get rest (primitive/load i))))
                     n (sx-len it)
                     (mut k) 0]
                 (loop (if (primitive/icmp-ge (primitive/load k) n)
                           (break)
                           (do
                             (let [ep (alloc/stack TPEntry)]
                               (primitive/store! ep (try! (parse-tparam-entry a (sx-at it (primitive/load k)))))
                               (al-push! (mut tps) (primitive/load (primitive/field ep name)))
                               (when (primitive/icmp-gt (al-len [(slice u8)] (primitive/load (primitive/load (primitive/field ep traits)))) 0)
                                     (let [bp (alloc/stack Bound)]
                                       (primitive/store! (primitive/field bp name) (primitive/load (primitive/field ep name)))
                                       (primitive/store! (primitive/field bp traits) (primitive/load (primitive/field ep traits)))
                                       (al-push! (mut sbounds) (primitive/load bp))
                                       0)))
                             (primitive/store! k (primitive/iadd (primitive/load k) 1))))))
               (primitive/store! i (primitive/iadd (primitive/load i) 1)))
         (let [(mut variants) (al-new [Variant] a)
               nr (sx-len rest)
               (mut vi) (primitive/load i)]
           (loop (if (primitive/icmp-ge (primitive/load vi) nr)
                     (break)
                     (let [v (sx-at rest (primitive/load vi))]
                       (primitive/store! vi (primitive/iadd (primitive/load vi) 1))
                       (let [vl (try! (as-list v "variant must be (Name [fields])"))
                             vname
                               (try! (sym-of a
                                             (try! (need [Sexp] (sx-get vl 0) "variant: missing name"))
                                             "variant name"))
                             fields
                               (if (opt-is-vec (sx-get vl 1))
                                   (try! (parse-fields a (sx-items (opt-get (sx-get vl 1)))))
                                   (match (sx-get vl 1)
                                     (Some [_]
                                           (return-from :try
                                                        (Err [SumDef Diag]
                                                             (derr-at (sx-lo v)
                                                                      (sx-hi v)
                                                                      (sconcat3 a
                                                                                "variant '"
                                                                                vname
                                                                                "': fields must be a vector")))))
                                     (None [] (box-al [Field] a (al-new [Field] a)))))]
                         (let [vp (alloc/stack Variant)]
                           (primitive/store! (primitive/field vp name) vname)
                           (primitive/store! (primitive/field vp fields) fields)
                           (al-push! (mut variants) (primitive/load vp)))))))
           (Ok (let [sd (alloc/stack SumDef)]
                 (primitive/store! (primitive/field sd name) name)
                 (primitive/store! (primitive/field sd type_params) (box-al [(slice u8)] a (primitive/load tps)))
                 (primitive/store! (primitive/field sd bounds) (box-al [Bound] a (primitive/load sbounds)))
                 (primitive/store! (primitive/field sd variants) (box-al [Variant] a (primitive/load variants)))
                 (primitive/load sd)))))))

(defn compute-backing [(a (ptr Allocator)) (name (slice u8)) (acc i64) (backing i64)] (-> (Result i64 Diag))
  (cond (primitive/icmp-ge backing 0)
          (if (primitive/icmp-ge backing acc)
              (Ok backing)
              (Err [i64 Diag]
                   (derr (sconcat a
                                  (sconcat3 a "defstruct '" name "': :backing i")
                                  (sconcat a
                                           (i64->str a backing)
                                           (sconcat a " too small for " (sconcat a (i64->str a acc) " bits")))))))
        (primitive/icmp-le acc 8) (Ok 8)
        (primitive/icmp-le acc 16) (Ok 16)
        (primitive/icmp-le acc 32) (Ok 32)
        (primitive/icmp-le acc 64) (Ok 64)
        :else
          (Err [i64 Diag]
               (derr (sconcat a
                              (sconcat3 a "defstruct '" name "': ")
                              (sconcat a (i64->str a acc) " bits needs an explicit :backing"))))))

(defstruct BitField [(fname (slice u8)) (width i64)])
(defn parse-bitfield [(a (ptr Allocator)) (f Sexp)] (-> (Result BitField Diag))
  (try (let [fl (try! (as-list f "bitfield must be (name :bits N)"))
             fname (try! (sym-of a (sx-at fl 0) "field name"))
             width (if (and (opt-is-kw (sx-get fl 1) "bits") (opt-is-pos-int (sx-get fl 2))) (opt-int (sx-get fl 2)) -1)]
         (if (primitive/icmp-lt width 0)
             (Err [BitField Diag] (derr-at (sx-lo f) (sx-hi f) (sconcat3 a "field '" fname "' must be (name :bits N)")))
             (Ok (let [b (alloc/stack BitField)] (primitive/store! (primitive/field b fname) fname) (primitive/store! (primitive/field b width) width) (primitive/load b)))))))

(defn finish-bits [(a (ptr Allocator))
                   (name (slice u8))
                   (tparams (ptr (ArrayList (slice u8))))
                   (bounds (ptr (ArrayList Bound)))
                   (backing i64)
                   (fields-items (ptr (ArrayList Sexp)))] (-> (Result StructDef Diag))
  (let [(mut fields) (al-new [Field] a)
        (mut offsets) (al-new [i64] a)
        (mut acc) 0
        n (sx-len fields-items)
        (mut fi) 0
        (mut out) (primitive/zeroed (Result StructDef Diag))
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load fi) n)
              (break)
              (let [f (sx-at fields-items (primitive/load fi))]
                (primitive/store! fi (primitive/iadd (primitive/load fi) 1))
                (match (parse-bitfield a f)
                  (Err [d] (do (primitive/store! out (Err d)) (primitive/store! failed true) (break)))
                  (Ok [fld]
                      (let [bp (alloc/stack BitField)]
                        (primitive/store! bp fld)
                        (let [fr (alloc/stack Field)]
                          (primitive/store! (primitive/field fr name) (primitive/load (primitive/field bp fname)))
                          (primitive/store! (primitive/field fr ty) (TInt (primitive/load (primitive/field bp width)) false))
                          (al-push! (mut fields) (primitive/load fr)))
                        (al-push! (mut offsets) (primitive/load acc))
                        (primitive/store! acc (primitive/iadd (primitive/load acc) (primitive/load (primitive/field bp width))))))))))
    (if (primitive/load failed)
        (primitive/load out)
        (match (compute-backing a name (primitive/load acc) backing)
          (Err [d] (Err d))
          (Ok [bk]
              (Ok (let [sd (alloc/stack StructDef)]
                    (primitive/store! (primitive/field sd name) name)
                    (primitive/store! (primitive/field sd type_params) tparams)
                    (primitive/store! (primitive/field sd bounds) bounds)
                    (primitive/store! (primitive/field sd layout) (LBits bk (box-al [i64] a (primitive/load offsets))))
                    (primitive/store! (primitive/field sd fields) (box-al [Field] a (primitive/load fields)))
                    (primitive/load sd))))))))

(defstruct NField [(fname (slice u8)) (fty Type) (at (Option i64))])
(defn parse-normal-field [(a (ptr Allocator)) (f Sexp)] (-> (Result NField Diag))
  (try (let [fl (try! (as-list f "field must be (name :type [:at N])"))
             fname (try! (sym-of a (sx-at fl 0) "field name"))
             fty (try! (parse-type a (try! (need [Sexp] (sx-get fl 1) "field missing type"))))
             (mut at) (None [i64])
             (mut j) 2
             fln (sx-len fl)
             (mut out) (primitive/zeroed (Result NField Diag))
             (mut bad) false]
         (loop (if (primitive/icmp-ge (primitive/load j) fln)
                   (break)
                   (let [fj (sx-at fl (primitive/load j))]
                     (if (and (primitive/icmp-eq (sx-tag fj) 3) (str-eq (sx-sval fj) "at"))
                         (do
                           (primitive/store! at
                                   (Some (try! (int-val a
                                                        (try! (need [Sexp]
                                                                    (sx-get fl (primitive/iadd (primitive/load j) 1))
                                                                    ":at missing value"))
                                                        "at"))))
                           (primitive/store! j (primitive/iadd (primitive/load j) 2)))
                         (do
                           (primitive/store! out
                                   (Err (derr-at (sx-lo fj)
                                                 (sx-hi fj)
                                                 (sconcat a "unknown field option " (sexp-display a fj)))))
                           (primitive/store! bad true)
                           (break))))))
         (if (primitive/load bad)
             (primitive/load out)
             (Ok (let [nf (alloc/stack NField)]
                   (primitive/store! (primitive/field nf fname) fname)
                   (primitive/store! (primitive/field nf fty) fty)
                   (primitive/store! (primitive/field nf at) (primitive/load at))
                   (primitive/load nf)))))))

(defn compute-layout [(a (ptr Allocator))
                      (name (slice u8))
                      (packed bool)
                      (explicit bool)
                      (aligned i64)
                      (exp-size i64)
                      (has-size bool)
                      (exp-align i64)
                      (anyat bool)
                      (ats (ptr (ArrayList (Option i64))))] (-> (Result Layout Diag))
  (cond (primitive/icmp-ge aligned 0) (Ok (LAligned aligned))
        (or explicit anyat)
          (let [(mut offs) (al-new [i64] a)
                na (al-len [(Option i64)] (primitive/load ats))
                (mut oi) 0
                (mut bad) false]
            (loop (if (primitive/icmp-ge (primitive/load oi) na)
                      (break)
                      (match (al-get [(Option i64)] (primitive/load ats) (primitive/load oi))
                        (Some [o] (do (al-push! (mut offs) o) (primitive/store! oi (primitive/iadd (primitive/load oi) 1))))
                        (None [] (do (primitive/store! bad true) (break))))))
            (if (primitive/load bad)
                (Err (derr (sconcat3 a "defstruct '" name "': explicit layout needs :at on every field")))
                (Ok (LExplicit (box-al [i64] a (primitive/load offs)) (if has-size (Some exp-size) (None [i64])) exp-align))))
        packed (Ok (LPacked))
        :else (Ok (LC))))

(defn finish-normal [(a (ptr Allocator))
                     (name (slice u8))
                     (tparams (ptr (ArrayList (slice u8))))
                     (bounds (ptr (ArrayList Bound)))
                     (packed bool)
                     (explicit bool)
                     (aligned i64)
                     (exp-size i64)
                     (has-size bool)
                     (exp-align i64)
                     (fields-items (ptr (ArrayList Sexp)))] (-> (Result StructDef Diag))
  (let [(mut fields) (al-new [Field] a)
        (mut ats) (al-new [(Option i64)] a)
        (mut anyat) false
        n (sx-len fields-items)
        (mut fi) 0
        (mut out) (primitive/zeroed (Result StructDef Diag))
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load fi) n)
              (break)
              (let [f (sx-at fields-items (primitive/load fi))]
                (primitive/store! fi (primitive/iadd (primitive/load fi) 1))
                (match (parse-normal-field a f)
                  (Err [d] (do (primitive/store! out (Err d)) (primitive/store! failed true) (break)))
                  (Ok [nf]
                      (let [np (alloc/stack NField)]
                        (primitive/store! np nf)
                        (let [fr (alloc/stack Field)]
                          (primitive/store! (primitive/field fr name) (primitive/load (primitive/field np fname)))
                          (primitive/store! (primitive/field fr ty) (primitive/load (primitive/field np fty)))
                          (al-push! (mut fields) (primitive/load fr)))
                        (match (primitive/load (primitive/field np at)) (Some [_] (do (primitive/store! anyat true) 0)) (None [] 0))
                        (al-push! (mut ats) (primitive/load (primitive/field np at)))))))))
    (if (primitive/load failed)
        (primitive/load out)
        (match (compute-layout a
                               name
                               packed
                               explicit
                               aligned
                               exp-size
                               has-size
                               exp-align
                               (primitive/load anyat)
                               (box-al [(Option i64)] a (primitive/load ats)))
          (Err [d] (Err d))
          (Ok [layout]
              (Ok (let [sd (alloc/stack StructDef)]
                    (primitive/store! (primitive/field sd name) name)
                    (primitive/store! (primitive/field sd type_params) tparams)
                    (primitive/store! (primitive/field sd bounds) bounds)
                    (primitive/store! (primitive/field sd layout) layout)
                    (primitive/store! (primitive/field sd fields) (box-al [Field] a (primitive/load fields)))
                    (primitive/load sd))))))))

(defstruct StructOpts
  [(packed bool)
   (explicit bool)
   (bits bool)
   (aligned i64)
   (exp-size i64)
   (has-size bool)
   (exp-align i64)
   (backing i64)
   (next i64)])
(defn parse-struct-opts [(a (ptr Allocator)) (rest (ptr (ArrayList Sexp))) (start i64)] (-> (Result StructOpts Diag))
  (let [(mut packed) false
        (mut explicit) false
        (mut bits) false
        (mut aligned) -1
        (mut exp-size) -1
        (mut has-size) false
        (mut exp-align) 0
        (mut backing) -1
        (mut i) start
        (mut out) (primitive/zeroed (Result StructOpts Diag))
        (mut failed) false]
    (loop (match (sx-get rest (primitive/load i))
            (None [] (break))
            (Some [kw]
                  (if (not (primitive/icmp-eq (sx-tag kw) 3))
                      (break)
                      (match (need [Sexp]
                                   (sx-get rest (primitive/iadd (primitive/load i) 1))
                                   (sconcat3 a "defstruct: ':" (sx-sval kw) "' missing value"))
                        (Err [d] (do (primitive/store! out (Err d)) (primitive/store! failed true) (break)))
                        (Ok [val]
                            (let [k (sx-sval kw)
                                  (mut stop) false]
                              (cond (str-eq k "layout")
                                      (if (primitive/icmp-eq (sx-tag val) 2)
                                          (let [vs (sx-sval val)]
                                            (cond (str-eq vs "c") 0
                                                  (str-eq vs "packed") (do (primitive/store! packed true) 0)
                                                  (str-eq vs "explicit") (do (primitive/store! explicit true) 0)
                                                  (str-eq vs "bits") (do (primitive/store! bits true) 0)
                                                  :else
                                                    (do
                                                      (primitive/store! out
                                                              (Err [StructOpts Diag]
                                                                   (derr-at (sx-lo val)
                                                                            (sx-hi val)
                                                                            "layout must be c, packed, explicit, bits, or (align N)")))
                                                      (primitive/store! failed true)
                                                      (primitive/store! stop true)
                                                      0)))
                                          (if (and (primitive/icmp-eq (sx-tag val) 6) (primitive/icmp-gt (sx-len (sx-items val)) 0))
                                              (let [vit (sx-items val)]
                                                (if (and (primitive/icmp-eq (sx-tag (sx-at vit 0)) 2)
                                                         (str-eq (sx-sval (sx-at vit 0)) "align"))
                                                    (match (pow2 (sx-get vit 1))
                                                      (Ok [v] (primitive/store! aligned v))
                                                      (Err [d]
                                                           (do
                                                             (primitive/store! out (Err d))
                                                             (primitive/store! failed true)
                                                             (primitive/store! stop true)
                                                             0)))
                                                    (do
                                                      (primitive/store! out
                                                              (Err [StructOpts Diag]
                                                                   (derr-at (sx-lo val)
                                                                            (sx-hi val)
                                                                            "layout must be c, packed, explicit, bits, or (align N)")))
                                                      (primitive/store! failed true)
                                                      (primitive/store! stop true)
                                                      0)))
                                              (do
                                                (primitive/store! out
                                                        (Err [StructOpts Diag]
                                                             (derr-at (sx-lo val)
                                                                      (sx-hi val)
                                                                      "layout must be c, packed, explicit, bits, or (align N)")))
                                                (primitive/store! failed true)
                                                (primitive/store! stop true)
                                                0)))
                                    (str-eq k "size")
                                      (match (int-val a val "size")
                                        (Ok [v] (do (primitive/store! exp-size v) (primitive/store! has-size true) 0))
                                        (Err [d] (do (primitive/store! out (Err d)) (primitive/store! failed true) (primitive/store! stop true) 0)))
                                    (str-eq k "align")
                                      (match (pow2 (sx-get rest (primitive/iadd (primitive/load i) 1)))
                                        (Ok [v] (primitive/store! exp-align v))
                                        (Err [d]
                                             (do (primitive/store! out (Err d)) (primitive/store! failed true) (primitive/store! stop true) 0)))
                                    (str-eq k "backing")
                                      (match (parse-type a val)
                                        (Err [d]
                                             (do (primitive/store! out (Err d)) (primitive/store! failed true) (primitive/store! stop true) 0))
                                        (Ok [bt]
                                            (let [bb (type-int-bits bt)]
                                              (if (primitive/icmp-lt bb 0)
                                                  (do
                                                    (primitive/store! out
                                                            (Err [StructOpts Diag]
                                                                 (derr-at (sx-lo val)
                                                                          (sx-hi val)
                                                                          ":backing must be an integer type")))
                                                    (primitive/store! failed true)
                                                    (primitive/store! stop true)
                                                    0)
                                                  (primitive/store! backing bb)))))
                                    :else (do (primitive/store! stop true) 0))
                              (if (primitive/load stop) (break) (primitive/store! i (primitive/iadd (primitive/load i) 2))))))))))
    (if (primitive/load failed)
        (primitive/load out)
        (Ok (let [o (alloc/stack StructOpts)]
              (primitive/store! (primitive/field o packed) (primitive/load packed))
              (primitive/store! (primitive/field o explicit) (primitive/load explicit))
              (primitive/store! (primitive/field o bits) (primitive/load bits))
              (primitive/store! (primitive/field o aligned) (primitive/load aligned))
              (primitive/store! (primitive/field o exp-size) (primitive/load exp-size))
              (primitive/store! (primitive/field o has-size) (primitive/load has-size))
              (primitive/store! (primitive/field o exp-align) (primitive/load exp-align))
              (primitive/store! (primitive/field o backing) (primitive/load backing))
              (primitive/store! (primitive/field o next) (primitive/load i))
              (primitive/load o))))))

(defn parse-defstruct [(a (ptr Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result StructDef Diag))
  (try (let [name (try! (sym-of a (try! (need [Sexp] (sx-get rest 0) "defstruct: missing name")) "struct name"))
             opts (alloc/stack StructOpts)]
         (primitive/store! opts (try! (parse-struct-opts a rest 1)))
         (let [tpr (alloc/stack TPResult)]
           (primitive/store! tpr (try! (parse-type-params a rest (primitive/load (primitive/field opts next)))))
           (let [i (if (primitive/load (primitive/field tpr consumed)) (primitive/iadd (primitive/load (primitive/field opts next)) 1) (primitive/load (primitive/field opts next)))
                 fields-items
                   (if (opt-is-vec (sx-get rest i))
                       (sx-items (opt-get (sx-get rest i)))
                       (primitive/zeroed (ptr (ArrayList Sexp))))]
             (if (primitive/icmp-eq (primitive/cast i64 fields-items) 0)
                 (Err [StructDef Diag] (derr (sconcat3 a "defstruct '" name "': expected a field vector")))
                 (if (primitive/load (primitive/field opts bits))
                     (finish-bits a
                                  name
                                  (primitive/load (primitive/field tpr params))
                                  (primitive/load (primitive/field tpr bounds))
                                  (primitive/load (primitive/field opts backing))
                                  fields-items)
                     (finish-normal a
                                    name
                                    (primitive/load (primitive/field tpr params))
                                    (primitive/load (primitive/field tpr bounds))
                                    (primitive/load (primitive/field opts packed))
                                    (primitive/load (primitive/field opts explicit))
                                    (primitive/load (primitive/field opts aligned))
                                    (primitive/load (primitive/field opts exp-size))
                                    (primitive/load (primitive/field opts has-size))
                                    (primitive/load (primitive/field opts exp-align))
                                    fields-items))))))))
(defn parse-extern [(a (ptr Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result Extern Diag))
  (try (let [name (try! (sym-of a (try! (need [Sexp] (sx-get rest 0) "extern: missing name")) "extern name"))
             (mut i) 1
             (mut cc) "c"]
         (match (sx-get rest (primitive/load i))
           (Some [k]
                 (when (and (primitive/icmp-eq (sx-tag k) 3) (str-eq (sx-sval k) "cc"))
                       (primitive/store! cc
                               (try! (sym-of a
                                             (try! (need [Sexp]
                                                         (sx-get rest (primitive/iadd (primitive/load i) 1))
                                                         "extern: ':cc' missing convention"))
                                             "cc name")))
                       (primitive/store! i (primitive/iadd (primitive/load i) 2))
                       0))
           (None [] 0))
         (let [params-items
                 (try! (need-vec (sx-get rest (primitive/load i))
                                 (sconcat3 a "extern '" name "': expected a vector of parameter types")))]
           (primitive/store! i (primitive/iadd (primitive/load i) 1))
           (let [pn (sx-len params-items)
                 variadic
                   (if (primitive/icmp-gt pn 0)
                       (let [last (sx-at params-items (primitive/isub pn 1))]
                         (and (primitive/icmp-eq (sx-tag last) 2) (str-eq (sx-sval last) "...")))
                       false)
                 fixed-n (if variadic (primitive/isub pn 1) pn)
                 (mut params) (al-new [Type] a)
                 (mut pi) 0]
             (loop (if (primitive/icmp-ge (primitive/load pi) fixed-n)
                       (break)
                       (do
                         (al-push! (mut params) (try! (parse-type a (sx-at params-items (primitive/load pi)))))
                         (primitive/store! pi (primitive/iadd (primitive/load pi) 1)))))
             (let [ret-l
                     (try! (as-list (try! (need [Sexp] (sx-get rest (primitive/load i)) "extern: missing (-> :type)"))
                                    "expected (-> :type)"))]
               (when (not (str-eq (try! (head-sym a ret-l)) "->"))
                     (break :try (Err [Extern Diag] (derr (sconcat3 a "extern '" name "': expected (-> :type)")))))
               (let [ret (try! (parse-type a (try! (need [Sexp] (sx-get ret-l 1) "(-> ) missing type"))))]
                 (Ok (let [e (alloc/stack Extern)]
                       (primitive/store! (primitive/field e name) name)
                       (primitive/store! (primitive/field e cc) (primitive/load cc))
                       (primitive/store! (primitive/field e params) (box-al [Type] a (primitive/load params)))
                       (primitive/store! (primitive/field e variadic) variadic)
                       (primitive/store! (primitive/field e ret) ret)
                       (primitive/load e))))))))))

(defn native-cc-parse [(s (slice u8))] (-> i64)
  (cond (or (str-eq s "c") (str-eq s "ccc")) 0
        (or (str-eq s "fast") (str-eq s "fastcc")) 1
        (or (str-eq s "cold") (str-eq s "coldcc")) 2
        :else -1))

(defn parse-defcc [(a (ptr Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result Convention Diag))
  (try (let [name (try! (sym-of a (try! (need [Sexp] (sx-get rest 0) "defcc: missing name")) "defcc name"))
             (mut params) (box-al [(slice u8)] a (al-new [(slice u8)] a))
             (mut ret) (None [(slice u8)])
             (mut clobber) (box-al [(slice u8)] a (al-new [(slice u8)] a))
             (mut preserve) (box-al [(slice u8)] a (al-new [(slice u8)] a))
             (mut native) -1
             (mut shim) false
             (mut i) 1
             nr (sx-len rest)]
         (loop (if (primitive/icmp-ge (primitive/load i) nr)
                   (break)
                   (let [kw (try! (kw-of a (sx-at rest (primitive/load i)) "defcc option"))
                         val
                           (try! (need [Sexp]
                                       (sx-get rest (primitive/iadd (primitive/load i) 1))
                                       (sconcat3 a "defcc: option ':" kw "' missing value")))]
                     (cond (str-eq kw "params") (do (primitive/store! params (try! (sym-vec a val "params"))) 0)
                           (str-eq kw "ret") (do (primitive/store! ret (Some (try! (sym-of a val "ret")))) 0)
                           (str-eq kw "clobber") (do (primitive/store! clobber (try! (sym-vec a val "clobber"))) 0)
                           (str-eq kw "preserve") (do (primitive/store! preserve (try! (sym-vec a val "preserve"))) 0)
                           (str-eq kw "native")
                             (let [nn (try! (sym-of a val "native"))
                                   code (native-cc-parse nn)]
                               (if (primitive/icmp-lt code 0)
                                   (return-from :try
                                                (Err [Convention Diag]
                                                     (derr-at (sx-lo val)
                                                              (sx-hi val)
                                                              (sconcat3 a
                                                                        "defcc: unknown native cc '"
                                                                        nn
                                                                        "'"))))
                                   (do (primitive/store! native code) 0)))
                           (str-eq kw "lower")
                             (when (str-eq (try! (sym-of a val "lower")) "shim") (primitive/store! shim true) 0)
                           :else
                             (break :try
                                    (Err [Convention Diag]
                                         (derr-at (sx-lo (sx-at rest (primitive/load i)))
                                                  (sx-hi (sx-at rest (primitive/load i)))
                                                  (sconcat3 a "defcc: unknown option ':" kw "'")))))
                     (primitive/store! i (primitive/iadd (primitive/load i) 2)))))
         (let [lowering
                 (if (primitive/icmp-ge (primitive/load native) 0)
                     (LNative (primitive/load native))
                     (if (primitive/load shim)
                         (LShim)
                         (return-from :try
                                      (Err [Convention Diag]
                                           (derr (sconcat3 a
                                                           "defcc '"
                                                           name
                                                           "': needs a lowering (:native <c|fast|cold> or :lower shim)"))))))]
           (Ok (let [c (alloc/stack Convention)]
                 (primitive/store! (primitive/field c name) name)
                 (primitive/store! (primitive/field c params) (primitive/load params))
                 (primitive/store! (primitive/field c ret) (primitive/load ret))
                 (primitive/store! (primitive/field c clobber) (primitive/load clobber))
                 (primitive/store! (primitive/field c preserve) (primitive/load preserve))
                 (primitive/store! (primitive/field c lowering) lowering)
                 (primitive/load c)))))))

; Would the parser intercept a call whose head is `name`? Uses the REAL dispatch
; (parse-list-expr) as the single source of truth — no parallel keyword list to
; drift out of sync: a plain user call `(name x)` parses to `ECall name …`, so any
; other outcome (a special form's own ExprKind, or a parse error) means `name` is a
; built-in form and a function of that name could never be *called* as `(name …)`.
; This is why shadowing `call`/`index`/`if`/… must be rejected at the definition.
(defn builtin-form-head? [(a (ptr Allocator)) (name (slice u8))] (-> bool)
  (let [(mut items) (al-new [Sexp] a)]
    (al-push! (mut items) (mk-sexp (KSym name) -1 -1))
    (al-push! (mut items) (mk-sexp (KSym "__coil_shadow_probe__") -1 -1))
    (match (parse-list-expr a (box-items a (primitive/load items)) -1 -1 -1 0)
      (Err [_] true)
      (Ok [k] (match-else k (ECall [f _ta _ar] (not (str-eq f name))) (_ true))))))

(defn parse-defn [(a (ptr Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result Func Diag))
  (try (let [namef (try! (need [Sexp] (sx-get rest 0) "defn: missing name"))
             name (try! (sym-of a namef "defn name"))
             (mut i) 1
             (mut cc) "c"]
         (when (builtin-form-head? a name)
               (break :try
                      (Err [Func Diag]
                           (derr-at (sx-lo namef)
                                    (sx-hi namef)
                                    (sconcat a
                                             (sconcat3 a
                                                       "cannot define '"
                                                       name
                                                       "': it is a built-in form and can never be called as (")
                                             (sconcat a name " …); rename the function"))))))
         (match (sx-get rest (primitive/load i))
           (Some [k]
                 (when (and (primitive/icmp-eq (sx-tag k) 3) (str-eq (sx-sval k) "cc"))
                       (primitive/store! cc
                               (try! (sym-of a
                                             (try! (need [Sexp]
                                                         (sx-get rest (primitive/iadd (primitive/load i) 1))
                                                         "defn: ':cc' missing convention name"))
                                             "cc name")))
                       (primitive/store! i (primitive/iadd (primitive/load i) 2))
                       0))
           (None [] 0))
         (let [tpr (alloc/stack TPResult)]
           (primitive/store! tpr (try! (parse-type-params a rest (primitive/load i))))
           (when (primitive/load (primitive/field tpr consumed)) (primitive/store! i (primitive/iadd (primitive/load i) 1)) 0)
           (let [params-items
                   (try! (need-vec (sx-get rest (primitive/load i)) (sconcat3 a "defn '" name "': expected parameter vector")))]
             (primitive/store! i (primitive/iadd (primitive/load i) 1))
             (let [(mut params) (al-new [Param] a)
                   (mut macrov) false
                   np (sx-len params-items)
                   (mut pi) 0]
               (loop (if (primitive/icmp-ge (primitive/load pi) np)
                         (break)
                         (let [p (sx-at params-items (primitive/load pi))]
                           (primitive/store! pi (primitive/iadd (primitive/load pi) 1))
                           (if (and (primitive/icmp-eq (sx-tag p) 2) (str-eq (sx-sval p) "&"))
                               (do (primitive/store! macrov true) 0)
                               (let [pl (try! (as-list p "parameter must be (name :type)"))
                                     pn (try! (sym-of a (sx-at pl 0) "param name"))
                                     pt (try! (parse-type a (try! (need [Sexp] (sx-get pl 1) "param missing type"))))]
                                 (let [pp (alloc/stack Param)]
                                   (primitive/store! (primitive/field pp name) pn)
                                   (primitive/store! (primitive/field pp ty) pt)
                                   (al-push! (mut params) (primitive/load pp))))))))
               (let [ret-l
                       (try! (as-list (try! (need [Sexp] (sx-get rest (primitive/load i)) "defn: missing (-> :type)"))
                                      "expected (-> :type)"))]
                 (when (not (str-eq (try! (head-sym a ret-l)) "->"))
                       (break :try (Err [Func Diag] (derr "defn: expected (-> :type) after params"))))
                 (let [ret (try! (parse-type a (try! (need [Sexp] (sx-get ret-l 1) "(-> ) missing type"))))]
                   (primitive/store! i (primitive/iadd (primitive/load i) 1))
                   (let [body (try! (parse-exprs a (rest-from a rest (primitive/load i))))]
                     (when (primitive/icmp-eq (al-len [Expr] (primitive/load body)) 0)
                           (break :try (Err [Func Diag] (derr (sconcat3 a "defn '" name "': empty body")))))
                     (Ok (let [f (alloc/stack Func)]
                           (primitive/store! (primitive/field f name) name)
                           (primitive/store! (primitive/field f type_params) (primitive/load (primitive/field tpr params)))
                           (primitive/store! (primitive/field f bounds) (primitive/load (primitive/field tpr bounds)))
                           (primitive/store! (primitive/field f cc) (primitive/load cc))
                           (primitive/store! (primitive/field f params) (box-al [Param] a (primitive/load params)))
                           (primitive/store! (primitive/field f ret) ret)
                           (primitive/store! (primitive/field f body) body)
                           (primitive/store! (primitive/field f macro_variadic) (primitive/load macrov))
                           (primitive/store! (primitive/field f lo) -1)
                           (primitive/store! (primitive/field f hi) -1)
                           (primitive/store! (primitive/field f source) -1)
                           (primitive/store! (primitive/field f ctxt) 0)
                           (primitive/load f))))))))))))

; ---- impl-target helpers ----
; The dispatch KEY a type carries an impl under: nominal types by (base) name,
; scalars by spelling, and each structural type by a pseudo-name ("slice", "ptr",
; "array", "vec", "fn") — so structural types are first-class impl targets, not
; second-class ones. "" = can't carry an impl (void/ref/never/code/externref).
;
; The key names only the head CONSTRUCTOR: `(Pair i64 i64)` and `(Pair A B)` both
; key to "Pair", and every pointer type keys to "ptr". So the key is an INDEX, not
; an identity — it narrows the candidates, and `check.coil::impl-match` then matches
; the receiver against the impl's own `self_type` pattern. Keep this in sync with
; `check.coil::type-impl-name`/`has-impl-name`, which mirror it on type tags.
(defn impl-base-name [(a (ptr Allocator)) (t (ptr Type))] (-> (slice u8))
  (match-else (primitive/load t)
              (TStruct [n] n)
              (TApp [n _args] n)
              (TInt [b s] (sconcat a (if s "i" "u") (i64->str a b)))
              (TBool [] "bool")
              (TFloat [b] (sconcat a "f" (i64->str a b)))
              (TSlice [_e] "slice")
              (TPtr [_e] "ptr")
              (TArray [_e _n] "array")
              (TVec [_e _n] "vec")
              (TFn [_cc _p _r] "fn")
              ; Code is a first-class value in the compiled metaprogram engine (checkers pass
              ; it around, store it in HashMaps), so it can carry impls like any other data
              ; type — e.g. `impl Display Code` for metaprogram diagnostics. Its methods take a
              ; Code param, so they are comptime-only functions dropped before mono
              ; (mono.coil::func-has-code) — no codegen impact. void/ref/never/externref stay
              ; impl-less: they are non-values, places, or opaque host handles.
              (TCode [] "code")
              (_ "")))

; Does `t` mention `nm` as a nominal type reference (a type parameter is a bare
; TStruct reference)?
(defn type-list-mentions-name [(v (ptr (ArrayList Type))) (nm (slice u8))] (-> bool)
  (let [n (al-len [Type] (primitive/load v))
        (mut i) 0
        (mut r) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [tv (alloc/stack Type)]
                  (primitive/store! tv (al-get [Type] (primitive/load v) (primitive/load i)))
                  (when (type-mentions-name tv nm) (primitive/store! r true) 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn type-mentions-name [(t (ptr Type)) (nm (slice u8))] (-> bool)
  (match-else (primitive/load t)
              (TStruct [n] (str-eq n nm))
              (TApp [n args] (or (str-eq n nm) (type-list-mentions-name args nm)))
              (TPtr [p] (type-mentions-name p nm))
              (TRef [_m p] (type-mentions-name p nm))
              (TSlice [p] (type-mentions-name p nm))
              (TArray [p _n] (type-mentions-name p nm))
              (TVec [p _n] (type-mentions-name p nm))
              (TFn [_cc ps r] (or (type-list-mentions-name ps nm) (type-mentions-name r nm)))
              (_ false)))

(defn parse-deftrait [(a (ptr Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result TraitDef Diag))
  (try (let [name (try! (sym-of a (try! (need [Sexp] (sx-get rest 0) "deftrait: missing name")) "trait name"))
             ; [Self …]: the first entry is Self; any further entries are EXTRA
             ; trait type parameters, determined by Self.
             tp-items
               (if (and (opt-is-vec (sx-get rest 1)) (primitive/icmp-gt (sx-len (sx-items (opt-get (sx-get rest 1)))) 0))
                   (sx-items (opt-get (sx-get rest 1)))
                   (return-from :try (Err [TraitDef Diag] (derr "deftrait: expected [Self …] after the name"))))
             self-param (try! (sym-of a (sx-at tp-items 0) "trait type parameter"))
             (mut type-params) (al-new [(slice u8)] a)
             (mut requires) (al-new [(slice u8)] a)
             ntp (sx-len tp-items)
             (mut tpi) 1
             (mut methods) (al-new [TraitMethod] a)
             nr (sx-len rest)
             (mut mi) 2]
         (loop (if (primitive/icmp-ge (primitive/load tpi) ntp)
                   (break)
                   (do
                     (al-push! (mut type-params) (try! (sym-of a (sx-at tp-items (primitive/load tpi)) "trait type parameter")))
                     (primitive/store! tpi (primitive/iadd (primitive/load tpi) 1)))))
         ; optional `:requires [Base …]` supertrait clause, sitting between the type-param
         ; vector and the methods (gen-8). It keeps supertraits OFF the `[Self …]` axis, which
         ; is for associated-type parameters — the two used to share one vector and silently
         ; mean different things. When present, methods start after it (primitive/index 4).
         (match (sx-get rest 2)
           (Some [k]
                 (when (and (primitive/icmp-eq (sx-tag k) 3) (str-eq (sx-sval k) "requires"))
                       (let [rv (try! (need [Sexp] (sx-get rest 3) "deftrait: ':requires' needs a [Base …] vector"))]
                         (when (not (primitive/icmp-eq (sx-tag rv) 7))
                               (break :try
                                      (Err [TraitDef Diag]
                                           (derr-at (sx-lo rv)
                                                    (sx-hi rv)
                                                    "deftrait: ':requires' needs a [Base …] vector"))))
                         (let [ri (sx-items rv)
                               nri (sx-len ri)
                               (mut rj) 0]
                           (loop (if (primitive/icmp-ge (primitive/load rj) nri)
                                     (break)
                                     (do
                                       (al-push! (mut requires) (try! (sym-of a (sx-at ri (primitive/load rj)) "supertrait name")))
                                       (primitive/store! rj (primitive/iadd (primitive/load rj) 1))))))
                         (primitive/store! mi 4)
                         0)))
           (None [] 0))
         (loop (if (primitive/icmp-ge (primitive/load mi) nr)
                   (break)
                   (let [m (sx-at rest (primitive/load mi))]
                     (primitive/store! mi (primitive/iadd (primitive/load mi) 1))
                     (let [ml (try! (as-list m "trait method must be (name [params] (-> ret))"))
                           mname
                             (try! (sym-of a
                                           (try! (need [Sexp] (sx-get ml 0) "trait method: missing name"))
                                           "method name"))
                           params-items
                             (if (opt-is-vec (sx-get ml 1))
                                 (sx-items (opt-get (sx-get ml 1)))
                                 (return-from :try
                                              (Err [TraitDef Diag]
                                                   (derr-at (sx-lo m)
                                                            (sx-hi m)
                                                            (sconcat3 a
                                                                      "trait method '"
                                                                      mname
                                                                      "': expected a param vector")))))
                           (mut params) (al-new [Param] a)
                           pnn (sx-len params-items)
                           (mut pi) 0]
                       (loop (if (primitive/icmp-ge (primitive/load pi) pnn)
                                 (break)
                                 (let [p (sx-at params-items (primitive/load pi))]
                                   (primitive/store! pi (primitive/iadd (primitive/load pi) 1))
                                   (let [pl (try! (as-list p "method param must be (name :type)"))
                                         pnm (try! (sym-of a (sx-at pl 0) "param name"))
                                         pty
                                           (try! (parse-type a
                                                             (try! (need [Sexp]
                                                                         (sx-get pl 1)
                                                                         "method param missing type"))))]
                                     (let [pp (alloc/stack Param)]
                                       (primitive/store! (primitive/field pp name) pnm)
                                       (primitive/store! (primitive/field pp ty) pty)
                                       (al-push! (mut params) (primitive/load pp)))))))
                       (let [ret-l
                               (try! (as-list (try! (need [Sexp] (sx-get ml 2) "trait method: missing (-> ret)"))
                                              "expected (-> ret)"))]
                         (when (not (str-eq (try! (head-sym a ret-l)) "->"))
                               (break :try
                                      (Err [TraitDef Diag]
                                           (derr-at (sx-lo m)
                                                    (sx-hi m)
                                                    (sconcat3 a "trait method '" mname "': expected (-> ret)")))))
                         (let [ret (try! (parse-type a (try! (need [Sexp] (sx-get ret-l 1) "(-> ) missing type"))))]
                           (let [mp (alloc/stack TraitMethod)]
                             (primitive/store! (primitive/field mp name) mname)
                             (primitive/store! (primitive/field mp params) (box-al [Param] a (primitive/load params)))
                             (primitive/store! (primitive/field mp ret) ret)
                             (al-push! (mut methods) (primitive/load mp)))))))))
         (Ok (let [t (alloc/stack TraitDef)]
               (primitive/store! (primitive/field t name) name)
               (primitive/store! (primitive/field t self_param) self-param)
               (primitive/store! (primitive/field t type_params) (box-al [(slice u8)] a (primitive/load type-params)))
               (primitive/store! (primitive/field t requires) (box-al [(slice u8)] a (primitive/load requires)))
               (primitive/store! (primitive/field t methods) (box-al [TraitMethod] a (primitive/load methods)))
               (primitive/load t))))))

; Dynamic-trait layouts are compiler-owned declarations.  Creating them while the
; trait itself is parsed makes `(dyn Trait)` available to every later type position,
; including while the metaprogram context is being assembled (before a source-level
; `defdyn` call could have expanded).  The names remain an internal lowering detail;
; resolution exposes them through the originating trait, not as separately exported
; declarations.
(defn dyn-vtable-fields [(a (ptr Allocator)) (td (ptr TraitDef))] (-> (ptr (ArrayList Field)))
  (let [methods (primitive/load (primitive/field td methods))
        n (al-len [TraitMethod] (primitive/load methods))
        (mut fields) (al-new [Field] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [mp (primitive/index (primitive/load (primitive/field methods data)) (primitive/load i))
                      ps (primitive/load (primitive/field mp params))
                      np (al-len [Param] (primitive/load ps))
                      (mut erased) (al-new [Type] a)
                      (mut j) 0]
                  (loop (if (primitive/icmp-ge (primitive/load j) np)
                            (break)
                            (do
                              (if (primitive/icmp-eq (primitive/load j) 0)
                                  (al-push! (mut erased) (TPtr (box-type a (TInt 8 false))))
                                  (al-push! (mut erased) (primitive/load (primitive/field (primitive/index (primitive/load (primitive/field ps data)) (primitive/load j)) ty))))
                              (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                  (let [fp (alloc/stack Field)]
                    (primitive/store! (primitive/field fp name) (primitive/load (primitive/field mp name)))
                    (primitive/store! (primitive/field fp ty)
                            (TFn "c"
                                 (box-al [Type] a (primitive/load erased))
                                 (box-type a (primitive/load (primitive/field mp ret)))))
                    (al-push! (mut fields) (primitive/load fp))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Field] a (primitive/load fields))))

(defn dyn-struct-def [(a (ptr Allocator)) (td (ptr TraitDef)) (vtable bool)] (-> StructDef)
  (let [name (primitive/load (primitive/field td name))
        vtname (sconcat a name "-vtable")
        (mut fields) (al-new [Field] a)]
    (if vtable
        (let [generated (dyn-vtable-fields a td)]
          (primitive/store! fields (primitive/load generated)))
        (let [dataf (alloc/stack Field)
              vtf (alloc/stack Field)]
          (primitive/store! (primitive/field dataf name) "data")
          (primitive/store! (primitive/field dataf ty) (TPtr (box-type a (TInt 8 false))))
          (al-push! (mut fields) (primitive/load dataf))
          (primitive/store! (primitive/field vtf name) "vtable")
          (primitive/store! (primitive/field vtf ty) (TPtr (box-type a (TStruct vtname))))
          (al-push! (mut fields) (primitive/load vtf))))
    (let [sd (alloc/stack StructDef)]
      (primitive/store! (primitive/field sd name) (if vtable vtname (sconcat a name "-dyn")))
      (primitive/store! (primitive/field sd type_params) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
      (primitive/store! (primitive/field sd bounds) (box-al [Bound] a (al-new [Bound] a)))
      (primitive/store! (primitive/field sd layout) (LC))
      (primitive/store! (primitive/field sd fields) (box-al [Field] a (primitive/load fields)))
      (primitive/load sd))))

(defn dyn-self-param? [(t (ptr Type)) (self-name (slice u8))] (-> bool)
  (match-else (primitive/load t)
              (TPtr [p] (match-else (primitive/load p) (TStruct [n] (str-eq n self-name)) (_ false)))
              (_ false)))

(defn trait-object-safe? [(td (ptr TraitDef))] (-> bool)
  (let [self-name (primitive/load (primitive/field td self_param))
        methods (primitive/load (primitive/field td methods))
        n (al-len [TraitMethod] (primitive/load methods))
        (mut i) 0
        (mut safe) true]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [mp (primitive/index (primitive/load (primitive/field methods data)) (primitive/load i))
                      ps (primitive/load (primitive/field mp params))
                      np (al-len [Param] (primitive/load ps))]
                  (if (or (primitive/icmp-eq np 0)
                          (not (dyn-self-param? (primitive/field (primitive/index (primitive/load (primitive/field ps data)) 0) ty) self-name)))
                      (primitive/store! safe false)
                      (let [(mut j) 1]
                        (loop (if (primitive/icmp-ge (primitive/load j) np)
                                  (break)
                                  (do
                                    (when (type-mentions-name (primitive/field (primitive/index (primitive/load (primitive/field ps data)) (primitive/load j)) ty) self-name)
                                          (primitive/store! safe false)
                                          (break))
                                    (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                        (when (type-mentions-name (primitive/field mp ret) self-name) (primitive/store! safe false) 0))))
                (when (not (primitive/load safe)) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load safe)))

; `(impl Trait Type …)` or the GENERIC form `(impl [T] Trait (ArrayList T) …)`:
; an optional leading type-parameter vector, then the
; full implementing type. Each method carries the impl's type params as its own
; (the lowered functions are ordinary generic functions); every declared param
; must appear in the implementing type (dispatch infers them from the receiver).
;
; An INHERENT impl omits the trait:
;   `(impl Point (length [(self Point)] (-> i64) …))`
;   `(impl [T] (Box T) (get [(self (ptr (Box T)))] (-> T) …))`
; It is unambiguous because the form after the target is a method: a list whose
; second item is a parameter vector and whose third item is `(-> Type)`. In the
; trait form, the item after the trait is a TYPE instead. `ImplKind` records the
; distinction explicitly; inherent methods are still lowered to ordinary Funcs.
(defn impl-method-form? [(o (Option Sexp))] (-> bool)
  (match o
    (None [] false)
    (Some [s]
      (if (primitive/icmp-ne (sx-tag s) 6)
          false
          (let [xs (sx-items s)]
            (if (primitive/icmp-lt (sx-len xs) 3)
                false
                (let [ps (sx-at xs 1)
                      rt (sx-at xs 2)]
                  (and (primitive/icmp-eq (sx-tag ps) 7)
                       (and (primitive/icmp-eq (sx-tag rt) 6)
                            (let [rs (sx-items rt)]
                              (and (primitive/icmp-gt (sx-len rs) 0)
                                   (and (primitive/icmp-eq (sx-tag (sx-at rs 0)) 2)
                                        (str-eq (sx-sval (sx-at rs 0)) "->")))))))))))))
(defn parse-impl [(a (ptr Allocator)) (rest0 (ptr (ArrayList Sexp))) (slo i64) (shi i64) (ssrc i64) (sctxt i64)] (-> (Result ImplDef
                                                                                                                             Diag))
  (try (let [has-tps (opt-is-vec (sx-get rest0 0))
             (mut type-params) (al-new [(slice u8)] a)
             (mut bounds) (al-new [Bound] a)
             base (when has-tps 1)]
         ; optional leading [T …] type-parameter vector; entries may carry bounds —
         ; `(impl [(T Eq)] Eq (Box T) …)` — parsed by the same entry parser `defn` uses.
         (when has-tps
               (let [v (sx-items (opt-get (sx-get rest0 0)))
                     nv (sx-len v)
                     (mut vi) 0]
                 (when (primitive/icmp-eq nv 0)
                       (break :try (Err [ImplDef Diag] (derr "impl: the type-parameter vector may not be empty"))))
                 (loop (if (primitive/icmp-ge (primitive/load vi) nv)
                           (break)
                           (do
                             (let [ep (alloc/stack TPEntry)]
                               (primitive/store! ep (try! (parse-tparam-entry a (sx-at v (primitive/load vi)))))
                               (al-push! (mut type-params) (primitive/load (primitive/field ep name)))
                               (when (primitive/icmp-gt (al-len [(slice u8)] (primitive/load (primitive/load (primitive/field ep traits)))) 0)
                                     (let [bp (alloc/stack Bound)]
                                       (primitive/store! (primitive/field bp name) (primitive/load (primitive/field ep name)))
                                       (primitive/store! (primitive/field bp traits) (primitive/load (primitive/field ep traits)))
                                       (al-push! (mut bounds) (primitive/load bp))
                                       0)))
                             (primitive/store! vi (primitive/iadd (primitive/load vi) 1)))))
                 0))
         (let [inherent (impl-method-form? (sx-get rest0 (primitive/iadd base 1)))
               trait-name
                 (if inherent
                     ""
                     (try! (sym-of a (try! (need [Sexp] (sx-get rest0 base) "impl: missing trait name")) "trait name")))
               target-idx (if inherent base (primitive/iadd base 1))
               target (try! (need [Sexp] (sx-get rest0 target-idx) "impl: missing implementing type"))
               self-type (try! (parse-type a target))
               stp (alloc/stack Type)]
           (primitive/store! stp self-type)
           (let [for-type (impl-base-name a stp)]
             (when (primitive/icmp-eq (slice-len for-type) 0)
                   (break :try
                          (Err [ImplDef Diag]
                               (derr-at (sx-lo target)
                                        (sx-hi target)
                                        "impl: this type can't carry an impl (name a struct, sum, scalar, generic instance, (slice T), (ptr T), array, vector, or fn type)"))))
             ; every impl type param must be inferable from the implementing type
             (let [ntp2 (al-len [(slice u8)] (primitive/load type-params))
                   (mut ck) 0]
               (loop (if (primitive/icmp-ge (primitive/load ck) ntp2)
                         (break)
                         (let [pn (al-get [(slice u8)] (primitive/load type-params) (primitive/load ck))]
                           (when (not (type-mentions-name stp pn))
                                 (break :try
                                        (Err [ImplDef Diag]
                                             (derr-at (sx-lo target)
                                                      (sx-hi target)
                                                      (sconcat3 a
                                                                "impl: type parameter '"
                                                                pn
                                                                "' must appear in the implementing type")))))
                           (primitive/store! ck (primitive/iadd (primitive/load ck) 1))))))
             (let [(mut methods) (al-new [Func] a)
                   nr (sx-len rest0)
                   (mut mi) (if inherent (primitive/iadd base 1) (primitive/iadd base 2))]
               (when (primitive/icmp-ge (primitive/load mi) nr)
                     (break :try
                            (Err [ImplDef Diag]
                                 (derr-at slo shi "inherent impl must define at least one method"))))
               (loop (if (primitive/icmp-ge (primitive/load mi) nr)
                         (break)
                         (let [m (sx-at rest0 (primitive/load mi))]
                           (primitive/store! mi (primitive/iadd (primitive/load mi) 1))
                           (let [ml (try! (as-list m "impl method must be (name [params] (-> ret) body…)"))
                                 f0 (try! (parse-defn a ml))]
                             (let [fp (alloc/stack Func)]
                               (primitive/store! fp f0)
                               (when (primitive/icmp-gt (al-len [(slice u8)] (primitive/load (primitive/load (primitive/field fp type_params)))) 0)
                                     (break :try
                                            (Err [ImplDef Diag]
                                                 (derr-at (sx-lo m)
                                                          (sx-hi m)
                                                          (sconcat3 a
                                                                    "impl method '"
                                                                    (primitive/load (primitive/field fp name))
                                                                    "': declare type parameters on the impl, not the method")))))
                               (primitive/store! (primitive/field fp type_params) (box-al [(slice u8)] a (primitive/load type-params)))
                               ; The impl's bounds become each lowered method's own bounds. Methods
                               ; are ordinary generic functions, so this is all it takes: the body
                               ; typechecks against the bound (cur_bounds), and every call site is
                               ; verified by the existing `ca-check-bounds` on the method's Sig.
                               (primitive/store! (primitive/field fp bounds) (box-al [Bound] a (primitive/load bounds)))
                               (primitive/store! (primitive/field fp lo) slo)
                               (primitive/store! (primitive/field fp hi) shi)
                               (primitive/store! (primitive/field fp source) ssrc)
                               (primitive/store! (primitive/field fp ctxt) sctxt)
                               (al-push! (mut methods) (primitive/load fp)))))))
               (Ok (let [im (alloc/stack ImplDef)]
                     (primitive/store! (primitive/field im kind) (if inherent (InherentImpl) (TraitImpl trait-name)))
                     (primitive/store! (primitive/field im for_type) for-type)
                     (primitive/store! (primitive/field im type_params) (box-al [(slice u8)] a (primitive/load type-params)))
                     (primitive/store! (primitive/field im self_type) self-type)
                     (primitive/store! (primitive/field im methods) (box-al [Func] a (primitive/load methods)))
                     (primitive/load im)))))))))

(defn parse-export-c [(a (ptr Allocator)) (rest (ptr (ArrayList Sexp)))] (-> (Result (ptr (ArrayList ExportC)) Diag))
  (try (let [(mut out) (al-new [ExportC] a)
             n (sx-len rest)
             (mut i) 0]
         (loop (if (primitive/icmp-ge (primitive/load i) n)
                   (break)
                   (let [item (sx-at rest (primitive/load i))]
                     (primitive/store! i (primitive/iadd (primitive/load i) 1))
                     (let [tg (sx-tag item)]
                       (if (primitive/icmp-eq tg 2)
                           (let [ep (alloc/stack ExportC)]
                             (primitive/store! (primitive/field ep name) (sx-sval item))
                             (primitive/store! (primitive/field ep symbol) (None [(slice u8)]))
                             (primitive/store! (primitive/field ep params) (box-al [Type] a (al-new [Type] a)))
                             (primitive/store! (primitive/field ep lo) (sx-lo item))
                             (primitive/store! (primitive/field ep hi) (sx-hi item))
                             (primitive/store! (primitive/field ep source) (sx-source item))
                             (primitive/store! (primitive/field ep ctxt) (sx-ctxt item))
                             (al-push! (mut out) (primitive/load ep)))
                           (if (primitive/icmp-eq tg 7)
                               (let [v (sx-items item)
                                     nm
                                       (if (and (primitive/icmp-gt (sx-len v) 0) (primitive/icmp-eq (sx-tag (sx-at v 0)) 2))
                                           (sx-sval (sx-at v 0))
                                           (return-from :try
                                                        (Err [(ptr (ArrayList ExportC)) Diag]
                                                             (derr-at (sx-lo item)
                                                                      (sx-hi item)
                                                                      "export-c: expected [name :as \"symbol\"]"))))
                                     sym0
                                       (if (and (opt-is-kw (sx-get v 1) "as") (opt-is-str (sx-get v 2)))
                                           (opt-str-val (sx-get v 2))
                                           (return-from :try
                                                        (Err [(ptr (ArrayList ExportC)) Diag]
                                                             (derr-at (sx-lo item)
                                                                      (sx-hi item)
                                                                      "export-c: expected [name :as \"symbol\"]"))))]
                                 (let [ep (alloc/stack ExportC)]
                                   (primitive/store! (primitive/field ep name) nm)
                                   (primitive/store! (primitive/field ep symbol) (Some sym0))
                                   (primitive/store! (primitive/field ep params) (box-al [Type] a (al-new [Type] a)))
                                   (primitive/store! (primitive/field ep lo) (sx-lo item))
                                   (primitive/store! (primitive/field ep hi) (sx-hi item))
                                   (primitive/store! (primitive/field ep source) (sx-source item))
                                   (primitive/store! (primitive/field ep ctxt) (sx-ctxt item))
                                   (al-push! (mut out) (primitive/load ep))))
                               (return-from :try
                                            (Err [(ptr (ArrayList ExportC)) Diag]
                                                 (derr-at (sx-lo item)
                                                          (sx-hi item)
                                                          "export-c: each entry is a function name or [name :as \"symbol\"]")))))))))
         (Ok (box-al [ExportC] a (primitive/load out))))))

(defn default-c-convention [(a (ptr Allocator))] (-> Convention)
  (let [c (alloc/stack Convention)]
    (primitive/store! (primitive/field c name) "c")
    (primitive/store! (primitive/field c params) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
    (primitive/store! (primitive/field c ret) (None [(slice u8)]))
    (primitive/store! (primitive/field c clobber) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
    (primitive/store! (primitive/field c preserve) (box-al [(slice u8)] a (al-new [(slice u8)] a)))
    (primitive/store! (primitive/field c lowering) (LNative 0))
    (primitive/load c)))

; `parse_program` in: fold the top-level forms into a Program.
(defn parse-program [(a (ptr Allocator)) (forms (ptr (ArrayList Sexp)))] (-> (Result Program Diag))
  (let [(mut convs) (al-new [Convention] a)
        (mut structs) (al-new [StructDef] a)
        (mut sums) (al-new [SumDef] a)
        (mut externs) (al-new [Extern] a)
        (mut funcs) (al-new [Func] a)
        (mut asserts) (al-new [StaticAssert] a)
        (mut consts) (al-new [Const] a)
        (mut traits) (al-new [TraitDef] a)
        (mut impls) (al-new [ImplDef] a)
        (mut metas) (al-new [Expr] a)
        (mut exports) (al-new [ExportC] a)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (al-push! (mut convs) (default-c-convention a))
    (let [nf (sx-len forms)
          (mut fi) 0]
      (loop (if (primitive/icmp-ge (primitive/load fi) nf)
                (break)
                (let [form (sx-at forms (primitive/load fi))
                      flo (sx-lo form)
                      fhi (sx-hi form)
                      fsrc (sx-source form)
                      fctxt (sx-ctxt form)]
                  (primitive/store! fi (primitive/iadd (primitive/load fi) 1))
                  (let [res
                          (match (as-list form "top-level form must be a list")
                            (Err [d] (Err [i64 Diag] d))
                            (Ok [items]
                                (match (head-sym a items)
                                  (Err [d] (Err [i64 Diag] d))
                                  (Ok [head]
                                      (let [rest (rest-from a items 1)]
                                        (cond (str-eq head "defcc")
                                                (match (parse-defcc a rest)
                                                  (Err [d] (Err [i64 Diag] d))
                                                  (Ok [c]
                                                      (let [cp (alloc/stack Convention)]
                                                        (primitive/store! cp c)
                                                        (let [nm (primitive/load (primitive/field cp name))
                                                              (mut found) -1
                                                              (mut ci) 0
                                                              cn (al-len [Convention] (primitive/load convs))]
                                                          (loop (if (primitive/icmp-ge (primitive/load ci) cn)
                                                                    (break)
                                                                    (do
                                                                      (when (str-eq (conv-name (al-get [Convention]
                                                                                                       (primitive/load convs)
                                                                                                       (primitive/load ci)))
                                                                                    nm)
                                                                            (primitive/store! found (primitive/load ci))
                                                                            0)
                                                                      (primitive/store! ci (primitive/iadd (primitive/load ci) 1)))))
                                                          (if (primitive/icmp-ge (primitive/load found) 0)
                                                              (if (str-eq nm "c")
                                                                  (do
                                                                    (al-set! [Convention]
                                                                             (mut convs)
                                                                             (primitive/load found)
                                                                             (primitive/load cp))
                                                                    (Ok [i64 Diag] 0))
                                                                  (Err [i64 Diag]
                                                                       (derr (sconcat3 a
                                                                                       "convention '"
                                                                                       nm
                                                                                       "' defined twice"))))
                                                              (do (al-push! (mut convs) (primitive/load cp)) (Ok [i64 Diag] 0)))))))
                                              (str-eq head "defstruct")
                                                (match (parse-defstruct a rest)
                                                  (Ok [sd] (do (al-push! (mut structs) sd) (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (str-eq head "defsum")
                                                (match (parse-defsum a rest)
                                                  (Ok [sd] (do (al-push! (mut sums) sd) (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (str-eq head "defn")
                                                (match (parse-defn a rest)
                                                  (Err [d] (Err [i64 Diag] d))
                                                  (Ok [f0]
                                                      (let [fp (alloc/stack Func)]
                                                        (primitive/store! fp f0)
                                                        (primitive/store! (primitive/field fp lo) flo)
                                                        (primitive/store! (primitive/field fp hi) fhi)
                                                        (primitive/store! (primitive/field fp source) fsrc)
                                                        (primitive/store! (primitive/field fp ctxt) fctxt)
                                                        (let [nm (primitive/load (primitive/field fp name))
                                                              (mut dup) false
                                                              (mut ci) 0
                                                              cn (al-len [Func] (primitive/load funcs))]
                                                          (loop (if (primitive/icmp-ge (primitive/load ci) cn)
                                                                    (break)
                                                                    (do
                                                                      (when (str-eq (func-name (al-get [Func]
                                                                                                       (primitive/load funcs)
                                                                                                       (primitive/load ci)))
                                                                                    nm)
                                                                            (primitive/store! dup true)
                                                                            0)
                                                                      (primitive/store! ci (primitive/iadd (primitive/load ci) 1)))))
                                                          (if (primitive/load dup)
                                                              (Err [i64 Diag]
                                                                   (derr (sconcat3 a
                                                                                   "function '"
                                                                                   nm
                                                                                   "' defined twice")))
                                                              (do
                                                                (al-push! (mut funcs) (primitive/load fp))
                                                                (Ok [i64 Diag] 0)))))))
                                              (str-eq head "extern")
                                                (match (parse-extern a rest)
                                                  (Ok [e] (do (al-push! (mut externs) e) (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (str-eq head "export-c")
                                                (match (parse-export-c a rest)
                                                  (Err [d] (Err [i64 Diag] d))
                                                  (Ok [es]
                                                      (do
                                                        (let [en (al-len [ExportC] (primitive/load es))
                                                              (mut ei) 0]
                                                          (loop (if (primitive/icmp-ge (primitive/load ei) en)
                                                                    (break)
                                                                    (do
                                                                      (al-push! (mut exports)
                                                                                (al-get [ExportC]
                                                                                        (primitive/load es)
                                                                                        (primitive/load ei)))
                                                                      (primitive/store! ei (primitive/iadd (primitive/load ei) 1))))))
                                                        (Ok [i64 Diag] 0))))
                                              (str-eq head "static-assert")
                                                (match (parse-static-assert a items)
                                                  (Ok [sa]
                                                      (do
                                                        (al-push! (mut asserts) sa)
                                                        (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (str-eq head "const")
                                                (match (parse-const a rest)
                                                  (Ok [c]
                                                      (do
                                                        (al-push! (mut consts) c)
                                                        (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (str-eq head "deftrait")
                                                (match (parse-deftrait a rest)
                                                  (Ok [t]
                                                      (let [tp (alloc/stack TraitDef)]
                                                        (primitive/store! tp t)
                                                        (al-push! (mut traits) t)
                                                        (when (trait-object-safe? tp)
                                                              (al-push! (mut structs) (dyn-struct-def a tp true))
                                                              (al-push! (mut structs) (dyn-struct-def a tp false))
                                                              0)
                                                        (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (str-eq head "defdyn-marker") (Ok [i64 Diag] 0)
                                              (str-eq head "impl")
                                                (match (parse-impl a
                                                                   rest
                                                                   flo
                                                                   fhi
                                                                   fsrc
                                                                   fctxt)
                                                  (Ok [im]
                                                      (do
                                                        (al-push! (mut impls) im)
                                                        (Ok [i64 Diag] 0)))
                                                  (Err [d] (Err [i64 Diag] d)))
                                              (str-eq head "meta")
                                                (if (not (primitive/icmp-eq (sx-len items) 2))
                                                    (Err [i64 Diag]
                                                         (derr "meta: expected (meta EXPR)"))
                                                    (match (parse-expr a
                                                                       (sx-at items
                                                                              1))
                                                      (Ok [e]
                                                          (do
                                                            (al-push! (mut metas) e)
                                                            (Ok [i64 Diag] 0)))
                                                      (Err [d] (Err [i64 Diag] d))))
                                              :else
                                                (Err [i64 Diag]
                                                     (derr (sconcat3 a
                                                                     "unknown top-level form '"
                                                                     head
                                                                     "'")))))))))]
                    (match res
                      (Ok [_] 0)
                      (Err [d] (do (primitive/store! err (dwspan d fsrc flo fhi fctxt)) (primitive/store! failed true) (break)))))))))
    (if (primitive/load failed)
        (Err (primitive/load err))
        (Ok (let [pp (alloc/stack Program)]
              (primitive/store! (primitive/field pp conventions) (box-al [Convention] a (primitive/load convs)))
              (primitive/store! (primitive/field pp structs) (box-al [StructDef] a (primitive/load structs)))
              (primitive/store! (primitive/field pp sums) (box-al [SumDef] a (primitive/load sums)))
              (primitive/store! (primitive/field pp externs) (box-al [Extern] a (primitive/load externs)))
              (primitive/store! (primitive/field pp funcs) (box-al [Func] a (primitive/load funcs)))
              (primitive/store! (primitive/field pp asserts) (box-al [StaticAssert] a (primitive/load asserts)))
              (primitive/store! (primitive/field pp consts) (box-al [Const] a (primitive/load consts)))
              (primitive/store! (primitive/field pp traits) (box-al [TraitDef] a (primitive/load traits)))
              (primitive/store! (primitive/field pp impls) (box-al [ImplDef] a (primitive/load impls)))
              (primitive/store! (primitive/field pp metas) (box-al [Expr] a (primitive/load metas)))
              (primitive/store! (primitive/field pp exports) (box-al [ExportC] a (primitive/load exports)))
              (primitive/load pp))))))

; static-assert: condition presence + message rule.
(defn assert-msg [(a (ptr Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result (slice u8) Diag))
  (match (sx-get items 2)
    (None [] (Ok "static assertion failed"))
    (Some [s] (if (primitive/icmp-eq (sx-tag s) 4) (Ok (sx-sval s)) (Err (derr "static-assert: message must be a string"))))))
(defn parse-static-assert [(a (ptr Allocator)) (items (ptr (ArrayList Sexp)))] (-> (Result StaticAssert Diag))
  (try (let [cond (try! (parse-expr a (try! (need [Sexp] (sx-get items 1) "static-assert: missing condition"))))
             msg (try! (assert-msg a items))]
         (Ok (let [ap (alloc/stack StaticAssert)] (primitive/store! (primitive/field ap cnd) cond) (primitive/store! (primitive/field ap msg) msg) (primitive/load ap))))))

; ============================ reused reader =================================
; Ported (and verified) in src/compiler/reader.coil — copied here so the parser can
; turn source into Sexp. Treat as already-correct.
