; src/compiler/check.coil — self-host Coil compiler, check module.
(module check)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ast.coil" :use *)
(import "astdump.coil" :use *)
(import "comptime.coil" :use *)
(import "loader.coil" :use *)
(import "parser.coil" :use *)
(import "resolve.coil" :use *)
(import "hashmap.coil" :use *)  ; the signature-name index (sig-find)

; the last `.`-separated component of a qualified name (the link/C symbol).
; Lives here (not in codegen.coil) so check has no codegen/LLVM dependency and
; the frontend can be built LLVM-free; codegen imports check and reuses it.
(defn last-component [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut i) (primitive/isub n 1)
        (mut start) 0]
    (loop (if (primitive/icmp-lt (primitive/load i) 0)
              (break)
              (if (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/load i))) 46)
                  (do (primitive/store! start (primitive/iadd (primitive/load i) 1)) (primitive/store! i -1))
                  (primitive/store! i (primitive/isub (primitive/load i) 1)))))
    (substr s (primitive/load start) n)))

(defstruct Sig
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (is_extern bool)
   (variadic bool)
   (cc (slice u8))
   (fnptr_ok bool)])
(defstruct StructInfo
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (fields (ptr (ArrayList Field)))
   (is_bits bool)])
(defstruct SumInfo
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (variants (ptr (ArrayList Variant)))])
(defstruct VtoS [(variant (slice u8)) (sum (slice u8))])
(defstruct ConstEntry [(name (slice u8)) (value Expr) (ty Type)])
(defstruct MethodEntry [(name (slice u8)) (trait (slice u8)) (self_idx i64)])
; NOTE: registered impls are stored as plain `ImplDef`s (see `Cx.impls`). There used to
; be a cut-down `ImplPair {trait, for_type, self_type, type_params}` here — a strict
; SUBSET of ImplDef — and having two record types for one concept forced two copies of
; everything that reasons about impls (specificity, selection), one per type. Mono
; already had `ImplDef`; check now uses it too, so those functions exist once and both
; phases share them.
(defstruct LoopFrame [(label (Option (slice u8))) (break_ty (Option Type)) (expected (Option Type))])
; `bid` is the local-binding identity (see comptime.coil binding-map): a fresh id
; per let-binding / parameter, so `(primitive/binding-of REF)` distinguishes shadows.
(defstruct EnvEntry [(name (slice u8)) (ty Type) (bid i64)])
(defstruct EvalPair [(e Expr) (t Type)])
(defstruct FBox [(items (ArrayList Func))])
(defstruct ImplBucket [(items (ArrayList i64))])

(defstruct Cx
  [(a (ptr Allocator))
   (sigs (ArrayList Sig))
   ; name -> index into `sigs` of the LAST signature declared under it; see sig-find
   (sigidx (HashMap (slice u8) i64))
   (structs (ArrayList StructInfo))
   (sums (ArrayList SumInfo))
   (variant_to_sum (ArrayList VtoS))
   (consts (ArrayList ConstEntry))
   (static_consts (ArrayList (slice u8)))
   (trait_defs (ArrayList TraitDef))
   (methods (ArrayList MethodEntry))
   (impls (ArrayList ImplDef))
   ; Candidate buckets contain indices into `impls`. Dispatch hashes directly to
   ; the relevant trait/type or method/type bucket instead of scanning every impl.
   (trait_impl_idx (HashMap (slice u8) (ptr ImplBucket)))
   (inherent_impl_idx (HashMap (slice u8) (ptr ImplBucket)))
   (inherent_name_idx (HashMap (slice u8) (ptr ImplBucket)))
   (imports (ptr (ArrayList ImpEntry)))
   (exports (ptr (ArrayList ExpEntry)))
   (conventions (ptr (ArrayList Convention)))
   (cur_bounds (ArrayList Bound))
   (loops (ArrayList LoopFrame))])

(defn mk-evalpair [(e Expr) (t Type)] (-> EvalPair)
  (let [p (alloc/stack EvalPair)] (primitive/store! (primitive/field p e) e) (primitive/store! (primitive/field p t) t) (primitive/load p)))
(defn env-new [(a (ptr Allocator))] (-> (ptr (ArrayList EnvEntry)))
  (box-al [EnvEntry] a (al-new [EnvEntry] a)))

; Length-prefix the left component so `(ab,c)` cannot alias `(a,bc)`.
(defn impl-index-key [(a (ptr Allocator)) (left (slice u8)) (right (slice u8))] (-> (slice u8))
  (sconcat a (sconcat3 a (i64->str a (slice-len left)) ":" left) right))
(defn impl-index-add! [(a (ptr Allocator))
                       (idx (mut (HashMap (slice u8) (ptr ImplBucket))))
                       (key (slice u8))
                       (value i64)] (-> i64)
  (match (hm-get [(slice u8) (ptr ImplBucket)] (primitive/load idx) key)
    (Some [bucket] (al-push! (mut (primitive/field bucket items)) value))
    (None []
      (let [bucket (unwrap-ptr [ImplBucket] (create [ImplBucket] a))]
        (primitive/store! (primitive/field bucket items) (al-new [i64] a))
        (al-push! (mut (primitive/field bucket items)) value)
        (hm-put! [(slice u8) (ptr ImplBucket)] (mut idx) key bucket))))
  0)
(defn impl-index-get [(idx (ptr (HashMap (slice u8) (ptr ImplBucket))))
                      (key (slice u8))] (-> (ptr ImplBucket))
  (match (hm-get [(slice u8) (ptr ImplBucket)] (primitive/load idx) key)
    (Some [bucket] bucket)
    (None [] (primitive/cast (ptr ImplBucket) 0))))

; ---- Cx table lookups (return a live (ptr T) or null) ----------------------
; Record that the signature just appended is the one `name` now resolves to. Overwriting
; is the point: on a duplicate name the LAST one declared wins, which is exactly what a
; map insert does — the behaviour the old scan spelled out by deliberately NOT breaking
; on a match and running to the end of the list every time.
(defn sig-index-put! [(cx (ptr Cx)) (name (slice u8))] (-> i64)
  (hm-put! [(slice u8) i64] (mut (primitive/field cx sigidx)) name (primitive/isub (al-len [Sig] (primitive/load (primitive/field cx sigs))) 1))
  0)

; The signature `name` resolves to, or null. This is asked once per CALL SITE against
; every signature in the program; as a str-eq scan that ran to completion (see above) it
; was O(calls × functions) — quadratic in program size, and the largest single cost left
; in `check`. The index gives the identical answer in one probe.
(defn sig-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr Sig))
  (match (hm-get [(slice u8) i64] (primitive/load (primitive/field cx sigidx)) name)
    (None [] (primitive/cast (ptr Sig) 0))
    (Some [i] (al-elem [Sig] (primitive/field cx sigs) i))))
; Levenshtein edit distance between two byte slices. Cold path (only computed
; when a call is already known-undefined), so a straightforward two-rolling-rows
; DP in scratch heap memory is fine.
(defn edit-dist [(a (ptr Allocator)) (s (slice u8)) (t (slice u8))] (-> i64)
  (let [m (slice-len s)
        n (slice-len t)]
    (if (primitive/icmp-eq m 0)
        n
        (if (primitive/icmp-eq n 0)
            m
            (let [prev (unwrap-ptr [i64] (alloc-slice [i64] a (primitive/iadd n 1)))
                  cur (unwrap-ptr [i64] (alloc-slice [i64] a (primitive/iadd n 1)))
                  (mut j) 0]
              (loop (if (primitive/icmp-gt (primitive/load j) n)
                        (break)
                        (do (primitive/store! (primitive/index prev (primitive/load j)) (primitive/load j)) (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
              (let [(mut i) 1]
                (loop (if (primitive/icmp-gt (primitive/load i) m)
                          (break)
                          (do
                            (primitive/store! (primitive/index cur 0) (primitive/load i))
                            (let [(mut jj) 1]
                              (loop (if (primitive/icmp-gt (primitive/load jj) n)
                                        (break)
                                        (let [cost
                                                (unless (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/isub (primitive/load i) 1)))
                                                                 (primitive/cast i64 (slice-get t (primitive/isub (primitive/load jj) 1))))
                                                        1)
                                              del (primitive/iadd (primitive/load (primitive/index prev (primitive/load jj))) 1)
                                              ins (primitive/iadd (primitive/load (primitive/index cur (primitive/isub (primitive/load jj) 1))) 1)
                                              sub (primitive/iadd (primitive/load (primitive/index prev (primitive/isub (primitive/load jj) 1))) cost)
                                              mn (if (primitive/icmp-lt del ins) del ins)
                                              best (if (primitive/icmp-lt mn sub) mn sub)]
                                          (do (primitive/store! (primitive/index cur (primitive/load jj)) best) (primitive/store! jj (primitive/iadd (primitive/load jj) 1)))))))
                            (let [(mut k) 0]
                              (loop (if (primitive/icmp-gt (primitive/load k) n)
                                        (break)
                                        (do
                                          (primitive/store! (primitive/index prev (primitive/load k)) (primitive/load (primitive/index cur (primitive/load k))))
                                          (primitive/store! k (primitive/iadd (primitive/load k) 1))))))
                            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                (primitive/load (primitive/index prev n))))))))

; The closest name in `cands` to `name` within a length-scaled edit budget (short
; names need a near-exact match, long names tolerate more), or None when even the
; nearest is too far to be a plausible typo. THE one "did you mean" ranking — both
; the check-time (`suggest-callable`) and resolve-time undefined-name hints route
; through it, so there is a single definition of what counts as a suggestion.
(defn nearest-name [(a (ptr Allocator)) (cands (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> (Option (slice u8)))
  (let [n (al-len [(slice u8)] (primitive/load cands))
        (mut i) 0
        (mut best) -1
        (mut bestnm) name
        budget
          (let [l (slice-len name)
                t (primitive/udiv l 3)]
            (if (primitive/icmp-lt t 1) 1 t))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [cand (last-component (al-get [(slice u8)] (primitive/load cands) (primitive/load i)))]
                  (unless (or (primitive/icmp-eq (slice-len cand) 0) (str-eq cand name))
                          (let [d (edit-dist a name cand)]
                            (when (or (primitive/icmp-lt (primitive/load best) 0) (primitive/icmp-lt d (primitive/load best)))
                                  (primitive/store! best d)
                                  (primitive/store! bestnm cand)
                                  0))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (and (primitive/icmp-ge (primitive/load best) 0) (primitive/icmp-le (primitive/load best) budget)) (Some (primitive/load bestnm)) (None [(slice u8)]))))

; A "did you mean" suggestion for an undefined call `name`: the closest surface
; name among all known signatures — the auto-referred core/stdlib (`println`/
; `print`/…) is always among them, so a typo of a bundled name gets a hint even
; with no explicit import.
(defn suggest-callable [(a (ptr Allocator)) (cx (ptr Cx)) (name (slice u8))] (-> (Option (slice u8)))
  (let [sigs (primitive/field cx sigs)
        n (al-len [Sig] (primitive/load sigs))
        (mut names) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut names) (primitive/load (primitive/field (al-elem [Sig] sigs (primitive/load i)) name)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (nearest-name a (box-al [(slice u8)] a (primitive/load names)) name)))

; The undefined-call message, plus a "; did you mean 'X'?" tail when a plausibly
; intended name exists. One definition, used by every call-check site below.
(defn undefined-call-msg [(a (ptr Allocator)) (cx (ptr Cx)) (fname (slice u8)) (func (slice u8))] (-> (slice u8))
  (let [base (sconcat3 a (sconcat3 a "in '" fname "': call to undefined function '") func "'")]
    (match (suggest-callable a cx func)
      (None [] base)
      (Some [s] (sconcat3 a base "; did you mean '" (sconcat a s "'?"))))))

(defn struct-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr StructInfo))
  (let [n (al-len [StructInfo] (primitive/load (primitive/field cx structs)))
        (mut i) 0
        (mut r) (primitive/cast (ptr StructInfo) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [StructInfo] (primitive/field cx structs) (primitive/load i)) name)) name)
                      (primitive/store! r (al-elem [StructInfo] (primitive/field cx structs) (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn sum-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr SumInfo))
  (let [n (al-len [SumInfo] (primitive/load (primitive/field cx sums)))
        (mut i) 0
        (mut r) (primitive/cast (ptr SumInfo) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [SumInfo] (primitive/field cx sums) (primitive/load i)) name)) name)
                      (primitive/store! r (al-elem [SumInfo] (primitive/field cx sums) (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn vts-find [(cx (ptr Cx)) (variant (slice u8))] (-> (ptr VtoS))
  (let [n (al-len [VtoS] (primitive/load (primitive/field cx variant_to_sum)))
        (mut i) 0
        (mut r) (primitive/cast (ptr VtoS) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [VtoS] (primitive/field cx variant_to_sum) (primitive/load i)) variant)) variant)
                      (primitive/store! r (al-elem [VtoS] (primitive/field cx variant_to_sum) (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn trait-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr TraitDef))
  (let [n (al-len [TraitDef] (primitive/load (primitive/field cx trait_defs)))
        (mut i) 0
        (mut r) (primitive/cast (ptr TraitDef) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [TraitDef] (primitive/field cx trait_defs) (primitive/load i)) name)) name)
                      (primitive/store! r (al-elem [TraitDef] (primitive/field cx trait_defs) (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn const-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr ConstEntry))
  (let [n (al-len [ConstEntry] (primitive/load (primitive/field cx consts)))
        (mut i) 0
        (mut r) (primitive/cast (ptr ConstEntry) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [ConstEntry] (primitive/field cx consts) (primitive/load i)) name)) name)
                      (primitive/store! r (al-elem [ConstEntry] (primitive/field cx consts) (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn impl-has [(cx (ptr Cx)) (tr (slice u8)) (forty (slice u8))] (-> bool)
  (primitive/icmp-ne (primitive/cast i64
                 (impl-index-get (primitive/field cx trait_impl_idx)
                                 (impl-index-key (primitive/load (primitive/field cx a)) tr forty)))
           0))

; ============================ pure type helpers ====================
(defn type-is-void [(t (ptr Type))] (-> bool)
  (match-else (primitive/load t) (TVoid [] true) (_ false)))
(defn type-is-never [(t (ptr Type))] (-> bool)
  (match-else (primitive/load t) (TNever [] true) (_ false)))
(defn type-is-int [(t (ptr Type))] (-> bool)
  (match-else (primitive/load t) (TInt [_ _] true) (_ false)))
(defn type-is-float [(t (ptr Type))] (-> bool)
  (match-else (primitive/load t) (TFloat [_] true) (_ false)))
(defn type-is-ptr [(t (ptr Type))] (-> bool)
  (match-else (primitive/load t) (TPtr [_] true) (_ false)))

; type_mentions
(defn type-list-mentions [(v (ptr (ArrayList Type))) (name (slice u8))] (-> bool)
  (let [n (al-len [Type] (primitive/load v))
        (mut i) 0
        (mut f) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (type-mentions (al-elem [Type] v (primitive/load i)) name) (primitive/store! f true) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load f)))
(defn type-mentions [(t (ptr Type)) (name (slice u8))] (-> bool)
  (match-else (primitive/load t)
              (TStruct [n] (str-eq n name))
              (TRef [m p] (type-mentions p name))
              (TPtr [p] (type-mentions p name))
              (TSlice [p] (type-mentions p name))
              (TArray [p k] (type-mentions p name))
              (TApp [n args] (type-list-mentions args name))
              (TFn [cc ps r] (or (type-list-mentions ps name) (type-mentions r name)))
              (_ false)))

; typename_to_type
(defn typename-to-type [(name (slice u8))] (-> Type)
  (cond (str-eq name "bool") (TBool)
        (str-eq name "externref") (TExternRef)
        (str-eq name "f32") (TFloat 32)
        (str-eq name "f64") (TFloat 64)
        :else
          (let [n (slice-len name)]
            (if (primitive/icmp-lt n 2)
                (TStruct name)
                (let [c0 (primitive/cast i64 (slice-get name 0))]
                  (if (or (primitive/icmp-eq c0 105) (primitive/icmp-eq c0 117))
                      (let [(mut ok) true
                            (mut val) 0
                            (mut j) 1]
                        (loop (if (primitive/icmp-ge (primitive/load j) n)
                                  (break)
                                  (do
                                    (let [ch (primitive/cast i64 (slice-get name (primitive/load j)))]
                                      (if (and (primitive/icmp-ge ch 48) (primitive/icmp-le ch 57))
                                          (do (primitive/store! val (primitive/iadd (primitive/imul (primitive/load val) 10) (primitive/isub ch 48))) 0)
                                          (do (primitive/store! ok false) (break))))
                                    (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                        (if (primitive/load ok) (TInt (primitive/load val) (primitive/icmp-eq c0 105)) (TStruct name)))
                      (TStruct name)))))))

; subst_self
(defn subst-self-list [(a (ptr Allocator)) (v (ptr (ArrayList Type))) (selfp (slice u8)) (concrete (ptr Type))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Type] (primitive/load v))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (subst-self a (al-elem [Type] v (primitive/load i)) selfp concrete))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))
(defn subst-self [(a (ptr Allocator)) (t (ptr Type)) (selfp (slice u8)) (concrete (ptr Type))] (-> Type)
  (match-else (primitive/load t)
              (TStruct [n] (if (str-eq n selfp) (primitive/load concrete) (TStruct n)))
              (TRef [m p] (TRef m (box-type a (subst-self a p selfp concrete))))
              (TPtr [p] (TPtr (box-type a (subst-self a p selfp concrete))))
              (TSlice [p] (TSlice (box-type a (subst-self a p selfp concrete))))
              (TArray [p k] (TArray (box-type a (subst-self a p selfp concrete)) k))
              (TApp [n args] (TApp n (subst-self-list a args selfp concrete)))
              (TFn [cc ps r]
                   (TFn cc (subst-self-list a ps selfp concrete) (box-type a (subst-self a r selfp concrete))))
              (_ (primitive/load t))))

; erase_refs
(defn erase-refs-list [(a (ptr Allocator)) (v (ptr (ArrayList Type)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Type] (primitive/load v))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (erase-refs a (al-elem [Type] v (primitive/load i))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))
(defn erase-refs [(a (ptr Allocator)) (t (ptr Type))] (-> Type)
  (match-else (primitive/load t)
              (TRef [m p] (TPtr (box-type a (erase-refs a p))))
              (TPtr [p] (TPtr (box-type a (erase-refs a p))))
              (TArray [e k] (TArray (box-type a (erase-refs a e)) k))
              (TFn [cc ps r] (TFn cc (erase-refs-list a ps) (box-type a (erase-refs a r))))
              (_ (primitive/load t))))

; param_ref_type
(defn is-aggregate-name [(cx (ptr Cx)) (name (slice u8)) (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (and (not (set-contains tps name))
       (or (primitive/icmp-ne (primitive/cast i64 (struct-find cx name)) 0) (primitive/icmp-ne (primitive/cast i64 (sum-find cx name)) 0))))
(defn param-ref-type [(cx (ptr Cx)) (t (ptr Type)) (tps (ptr (ArrayList (slice u8))))] (-> Type)
  (let [a (primitive/load (primitive/field cx a))]
    (match-else (primitive/load t)
                (TRef [m p] (primitive/load t))
                (TPtr [p] (primitive/load t))
                (TStruct [name] (if (is-aggregate-name cx name tps) (TRef false (box-type a (primitive/load t))) (primitive/load t)))
                (TApp [name args] (if (is-aggregate-name cx name tps) (TRef false (box-type a (primitive/load t))) (primitive/load t)))
                (TArray [e k] (TRef false (box-type a (primitive/load t))))
                (_ (primitive/load t)))))

; is_literal, is_literal_value (2827), numeric/is_cond/etc.
(defn al-last-expr [(v (ptr (ArrayList Expr)))] (-> (ptr Expr))
  (let [n (al-len [Expr] (primitive/load v))]
    (if (primitive/icmp-le n 0) (primitive/cast (ptr Expr) 0) (al-elem [Expr] v (primitive/isub n 1)))))
(defn is-literal [(e (ptr Expr))] (-> bool)
  (match-else (primitive/load (primitive/field e kind))
              (EInt [_] true)
              (EFloat [_] true)
              (EBin [op lhs rhs] (and (is-literal lhs) (is-literal rhs)))
              (EIf [cnd thn els] (and (is-literal thn) (is-literal els)))
              (EDo [body] (let [l (al-last-expr body)] (if (primitive/icmp-eq (primitive/cast i64 l) 0) false (is-literal l))))
              (ELet [binds body] (let [l (al-last-expr body)] (if (primitive/icmp-eq (primitive/cast i64 l) 0) false (is-literal l))))
              (_ false)))
(defn is-literal-value [(e (ptr Expr))] (-> bool)
  (match-else (primitive/load (primitive/field e kind)) (EInt [_] true) (EFloat [_] true) (EBool [_] true) (_ false)))
(defn numeric [(t (ptr Type)) (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (match-else (primitive/load t) (TInt [_ _] true) (TFloat [_] true) (TStruct [n] (set-contains tps n)) (_ false)))
(defn is-cond [(t (ptr Type))] (-> bool)
  (match-else (primitive/load t) (TBool [] true) (TInt [_ _] true) (_ false)))
(defn same-number-kind [(x (ptr Type)) (y (ptr Type))] (-> bool)
  (or (and (type-is-int x) (type-is-int y)) (and (type-is-float x) (type-is-float y))))
(defn arg-ok [(got (ptr Type)) (want (ptr Type)) (is_extern bool)] (-> bool)
  (if (type-eq got want) true (and is_extern (and (type-is-ptr got) (type-is-ptr want)))))
; fits
(defn fits [(n i64) (bits i64) (signed bool)] (-> bool)
  (cond (primitive/icmp-ge bits 64) true
        signed
          (let [lo (primitive/isub 0 (primitive/ishl 1 (primitive/isub bits 1)))
                hi (primitive/isub (primitive/ishl 1 (primitive/isub bits 1)) 1)]
            (and (primitive/icmp-ge n lo) (primitive/icmp-le n hi)))
        (primitive/icmp-ge bits 63) (primitive/icmp-ge n 0)
        :else (and (primitive/icmp-ge n 0) (primitive/icmp-lt n (primitive/ishl 1 bits)))))

(defn prefix-diag [(a (ptr Allocator)) (d Diag) (pre (slice u8))] (-> Diag)
  (let [dp (alloc/stack Diag)] (primitive/store! dp d) (derr (sconcat a pre (primitive/load (primitive/field dp msg))))))

; ============================ coerce =============================
; coerce_lit
(defn coerce-lit [(a (ptr Allocator)) (e Expr) (target (ptr Type)) (fname (slice u8))] (-> (Result Expr Diag))
  (let [ep (alloc/stack Expr)]
    (primitive/store! ep e)
    (let [wrap
            (mk-expr (ECast (primitive/load target) (box-expr a (primitive/load ep)))
                     (primitive/load (primitive/field ep lo))
                     (primitive/load (primitive/field ep hi))
                     (primitive/load (primitive/field ep source))
                     (primitive/load (primitive/field ep ctxt)))]
      (match-else (primitive/load (primitive/field ep kind))
                  (EInt [n]
                        (match-else (primitive/load target)
                                    (TInt [bits signed]
                                          (if (not (fits n bits signed))
                                              (Err [Expr Diag]
                                                   (derr (sconcat a
                                                                  (sconcat a
                                                                           (sconcat3 a "in '" fname "': literal ")
                                                                           (i64->str a n))
                                                                  (sconcat a " does not fit in " (ty-str a target)))))
                                              (Ok wrap)))
                                    (_ (Ok wrap))))
                  (_ (Ok wrap))))))
; coerce
(defn coerce-fail [(a (ptr Allocator)) (et (ptr Type)) (target (ptr Type)) (fname (slice u8)) (what (slice u8))] (-> (Result Expr
                                                                                                                             Diag))
  (Err [Expr Diag]
       (derr (sconcat a
                      (sconcat a
                               (sconcat a
                                        (sconcat a (sconcat3 a "in '" fname "': ") (sconcat a what " has type "))
                                        (ty-str a et))
                               " but expected ")
                      (ty-str a target)))))
(defn coerce [(a (ptr Allocator))
              (e Expr)
              (et (ptr Type))
              (target (ptr Type))
              (is_extern bool)
              (fname (slice u8))
              (what (slice u8))] (-> (Result Expr Diag))
  (let [ep (alloc/stack Expr)]
    (primitive/store! ep e)
    (cond (type-eq et target) (Ok (primitive/load ep))
          (type-is-void target) (Ok (primitive/load ep))
          (type-is-void et)
            (Err [Expr Diag]
                 (derr (sconcat a
                                (sconcat3 a "in '" fname "': ")
                                (sconcat a what " uses a void value (a (-> void) call yields nothing)"))))
          (type-is-never et) (Ok (primitive/load ep))
          (and (same-number-kind et target) (is-literal ep)) (coerce-lit a (primitive/load ep) target fname)
          (arg-ok et target is_extern) (Ok (primitive/load ep))
          :else
            (match (primitive/load et)
              (TRef [m inner]
                    (if (type-eq inner target)
                        (Ok (mk-expr (ELoad (box-expr a (primitive/load ep)))
                                     (primitive/load (primitive/field ep lo))
                                     (primitive/load (primitive/field ep hi))
                                     (primitive/load (primitive/field ep source))
                                     (primitive/load (primitive/field ep ctxt))))
                        (coerce-fail a et target fname what)))
              (TInt [$g2038 $g2039] (coerce-fail a et target fname what))
              (TFloat [$g2040] (coerce-fail a et target fname what))
              (TBool [] (coerce-fail a et target fname what))
              (TVoid [] (coerce-fail a et target fname what))
              (TPtr [$g2041] (coerce-fail a et target fname what))
              (TStruct [$g2042] (coerce-fail a et target fname what))
              (TArray [$g2043 $g2044] (coerce-fail a et target fname what))
              (TSlice [$g2045] (coerce-fail a et target fname what))
              (TVec [$g2046 $g2047] (coerce-fail a et target fname what))
              (TFn [$g2048 $g2049 $g2050] (coerce-fail a et target fname what))
              (TApp [$g2051 $g2052] (coerce-fail a et target fname what))
              (TNever [] (coerce-fail a et target fname what))
              (TCode [] (coerce-fail a et target fname what))
              (TExternRef [] (coerce-fail a et target fname what))))))

; const_entry
(defn const-entry [(a (ptr Allocator)) (cp (ptr Const))] (-> (Result EvalPair Diag))
  (let [nm (primitive/load (primitive/field cp name))]
    (match-else (primitive/load (primitive/field (primitive/field cp value) kind))
                (EInt [n]
                      (match (primitive/load (primitive/field cp ty))
                        (None [] (Ok (mk-evalpair (mk-expr (EInt n) -1 -1 -1 0) (TInt 64 true))))
                        (Some [wt]
                              (match-else wt
                                          (TInt [bits signed]
                                                (if (not (fits n bits signed))
                                                    (Err [EvalPair Diag]
                                                         (derr (sconcat a
                                                                        (sconcat a
                                                                                 (sconcat3 a "const '" nm "': literal ")
                                                                                 (i64->str a n))
                                                                        (sconcat a
                                                                                 " does not fit in "
                                                                                 (ty-str a (box-type a wt))))))
                                                    (Ok (mk-evalpair (mk-expr (EInt n) -1 -1 -1 0) (TInt bits signed)))))
                                          (_ (Err [EvalPair Diag]
                                                  (derr (sconcat a
                                                                 (sconcat3 a
                                                                           "const '"
                                                                           nm
                                                                           "': integer value cannot have type ")
                                                                 (ty-str a (box-type a wt))))))))))
                (EFloat [bits]
                        (match (primitive/load (primitive/field cp ty))
                          (None [] (Ok (mk-evalpair (mk-expr (EFloat bits) -1 -1 -1 0) (TFloat 64))))
                          (Some [wt]
                                (match-else wt
                                            (TFloat [b]
                                                    (Ok (mk-evalpair (mk-expr (EFloat bits) -1 -1 -1 0) (TFloat b))))
                                            (_ (Err [EvalPair Diag]
                                                    (derr (sconcat a
                                                                   (sconcat3 a
                                                                             "const '"
                                                                             nm
                                                                             "': float value cannot have type ")
                                                                   (ty-str a (box-type a wt))))))))))
                (EBool [b]
                       (match (primitive/load (primitive/field cp ty))
                         (None [] (Ok (mk-evalpair (mk-expr (EBool b) -1 -1 -1 0) (TBool))))
                         (Some [wt]
                               (match-else wt
                                           (TBool [] (Ok (mk-evalpair (mk-expr (EBool b) -1 -1 -1 0) (TBool))))
                                           (_ (Err [EvalPair Diag]
                                                   (derr (sconcat a
                                                                  (sconcat3 a
                                                                            "const '"
                                                                            nm
                                                                            "': boolean value cannot have type ")
                                                                  (ty-str a (box-type a wt))))))))))
                (_ (do
                     (unimplemented "check/const-entry called on non-literal (unreachable)")
                     (Err [EvalPair Diag] (derr "")))))))

; ============================ validate_type ========================
(defn validate-type-list [(v (ptr (ArrayList Type))) (cx (ptr Cx)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                   Diag))
  (let [n (al-len [Type] (primitive/load v))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (validate-type (al-elem [Type] v (primitive/load i)) cx tps)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn validate-struct-name [(a (ptr Allocator)) (cx (ptr Cx)) (name (slice u8)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                                Diag))
  (if (set-contains tps name)
      (Ok [i64 Diag] 0)
      (let [si (struct-find cx name)]
        (if (primitive/icmp-ne (primitive/cast i64 si) 0)
            (let [np (al-len [(slice u8)] (primitive/load (primitive/field si type_params)))]
              (if (primitive/icmp-eq np 0)
                  (Ok [i64 Diag] 0)
                  (Err [i64 Diag]
                       (derr (sconcat a
                                      (sconcat a (sconcat3 a "generic type '" name "' expects ") (i64->str a np))
                                      " type arguments, got 0")))))
            (let [su (sum-find cx name)]
              (if (primitive/icmp-ne (primitive/cast i64 su) 0)
                  (let [np (al-len [(slice u8)] (primitive/load (primitive/field su type_params)))]
                    (if (primitive/icmp-eq np 0)
                        (Ok [i64 Diag] 0)
                        (Err [i64 Diag]
                             (derr (sconcat a
                                            (sconcat a (sconcat3 a "generic type '" name "' expects ") (i64->str a np))
                                            " type arguments, got 0")))))
                  (Err [i64 Diag] (derr (sconcat3 a "unknown type '" name "'")))))))))
; index of `nm` in a name list, or -1.
(defn name-index [(lst (ptr (ArrayList (slice u8)))) (nm (slice u8))] (-> i64)
  (let [n (al-len [(slice u8)] (primitive/load lst))
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (al-get [(slice u8)] (primitive/load lst) (primitive/load i)) nm) (primitive/store! r (primitive/load i)) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

; Enforce the declared bounds of a generic struct/sum at a use site `(Box f64)`. The
; bound `[(T Eq)]` means every instantiation's T must implement Eq. Checked only when
; the argument is CONCRETE: inside a generic body `(Box T)` the argument is itself an
; in-scope type param (abstract) and cannot be checked here — that instantiation is
; verified when the enclosing generic is itself instantiated with a concrete type.
(defn tapp-arg-abstract? [(t (ptr Type)) (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (match-else (primitive/load t) (TStruct [nm] (set-contains tps nm)) (_ false)))

(defn check-app-bounds [(a (ptr Allocator))
                        (cx (ptr Cx))
                        (name (slice u8))
                        (bounds (ptr (ArrayList Bound)))
                        (params (ptr (ArrayList (slice u8))))
                        (args (ptr (ArrayList Type)))
                        (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [nb (al-len [Bound] (primitive/load bounds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) nb)
              (break)
              (do
                (let [bp (al-elem [Bound] bounds (primitive/load i))
                      idx (name-index params (primitive/load (primitive/field bp name)))]
                  (when (and (primitive/icmp-ge idx 0) (primitive/icmp-lt idx (al-len [Type] (primitive/load args))))
                        (let [arg (al-elem [Type] args idx)]
                          (unless (tapp-arg-abstract? arg tps)
                                  (let [trs (primitive/load (primitive/field bp traits))
                                        nt (al-len [(slice u8)] (primitive/load trs))
                                        (mut k) 0]
                                    (loop (if (primitive/icmp-ge (primitive/load k) nt)
                                              (break)
                                              (do
                                                (let [tr (al-get [(slice u8)] (primitive/load trs) (primitive/load k))]
                                                  (unless (impl-match a cx tr arg)
                                                          (primitive/store! err
                                                                  (derr (sconcat a
                                                                                 (sconcat a
                                                                                          (sconcat a
                                                                                                   (sconcat4 a
                                                                                                             "'"
                                                                                                             (ty-str a arg)
                                                                                                             "' does not implement '"
                                                                                                             (sconcat a
                                                                                                                      (display-name tr)
                                                                                                                      "' (required by '"))
                                                                                                   name)
                                                                                          "' bound on '")
                                                                                 (sconcat a (primitive/load (primitive/field bp name)) "')"))))
                                                          (primitive/store! failed true)
                                                          0))
                                                (if (primitive/load failed) (break) (primitive/store! k (primitive/iadd (primitive/load k) 1))))))))
                          0)))
                (if (primitive/load failed) (break) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (if (primitive/load failed) (Err [i64 Diag] (primitive/load err)) (Ok [i64 Diag] 0))))

(defn validate-app [(a (ptr Allocator))
                    (cx (ptr Cx))
                    (name (slice u8))
                    (args (ptr (ArrayList Type)))
                    (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (match (validate-type-list args cx tps)
    (Err [d] (Err [i64 Diag] d))
    (Ok [_]
        (let [si (struct-find cx name)
              su (sum-find cx name)
              (mut arity) -1]
          (if (primitive/icmp-ne (primitive/cast i64 si) 0)
              (do (primitive/store! arity (al-len [(slice u8)] (primitive/load (primitive/field si type_params)))) 0)
              (when (primitive/icmp-ne (primitive/cast i64 su) 0) (primitive/store! arity (al-len [(slice u8)] (primitive/load (primitive/field su type_params)))) 0))
          (if (primitive/icmp-lt (primitive/load arity) 0)
              (Err [i64 Diag] (derr (sconcat3 a "unknown generic type '" name "'")))
              (let [na (al-len [Type] (primitive/load args))]
                (cond (primitive/icmp-ne (primitive/load arity) na)
                        (Err [i64 Diag]
                             (derr (sconcat a
                                            (sconcat a
                                                     (sconcat a
                                                              (sconcat3 a "generic type '" name "' expects ")
                                                              (i64->str a (primitive/load arity)))
                                                     " type arguments, got ")
                                            (i64->str a na))))
                      ; arity ok — now enforce the type's declared bounds on concrete args.
                      (primitive/icmp-ne (primitive/cast i64 si) 0)
                        (check-app-bounds a cx name (primitive/load (primitive/field si bounds)) (primitive/load (primitive/field si type_params)) args tps)
                      (primitive/icmp-ne (primitive/cast i64 su) 0)
                        (check-app-bounds a cx name (primitive/load (primitive/field su bounds)) (primitive/load (primitive/field su type_params)) args tps)
                      :else (Ok [i64 Diag] 0))))))))
(defn validate-type [(t (ptr Type)) (cx (ptr Cx)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (primitive/load (primitive/field cx a))]
    (match (primitive/load t)
      (TNever [] (Ok [i64 Diag] 0))
      (TCode [] (Ok [i64 Diag] 0))
      (TExternRef [] (Ok [i64 Diag] 0))
      (TVoid [] (Err [i64 Diag] (derr "'void' is only valid as a return type")))
      (TInt [_ _] (Ok [i64 Diag] 0))
      (TFloat [_] (Ok [i64 Diag] 0))
      (TBool [] (Ok [i64 Diag] 0))
      (TPtr [p] (validate-type p cx tps))
      (TRef [m p] (validate-type p cx tps))
      (TArray [e k] (validate-type e cx tps))
      (TSlice [e] (validate-type e cx tps))
      (TVec [e k]
            (if (primitive/icmp-eq k 0)
                (Err [i64 Diag] (derr "vec must have a positive lane count"))
                (match-else (primitive/load e)
                            (TInt [_ _] (Ok [i64 Diag] 0))
                            (TFloat [_] (Ok [i64 Diag] 0))
                            (TStruct [p]
                                     (if (set-contains tps p)
                                         (Ok [i64 Diag] 0)
                                         (Err [i64 Diag]
                                              (derr (sconcat a
                                                             "vec element must be a scalar int/float, got "
                                                             (ty-str a e))))))
                            (_ (Err [i64 Diag]
                                    (derr (sconcat a "vec element must be a scalar int/float, got " (ty-str a e))))))))
      (TStruct [name] (validate-struct-name a cx name tps))
      (TFn [cc params ret]
           (match (validate-type-list params cx tps) (Err [d] (Err [i64 Diag] d)) (Ok [_] (validate-type ret cx tps))))
      (TApp [name args] (validate-app a cx name args tps)))))

; ============================ setup (Phase 1) ======================
(defn layout-is-bits [(l (ptr Layout))] (-> bool)
  (match-else (primitive/load l) (LBits [b o] true) (_ false)))
(defn conv-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr Convention))
  (let [cv (primitive/field cx conventions)
        n (al-len [Convention] (primitive/load (primitive/load (primitive/field cx conventions))))
        (mut i) 0
        (mut r) (primitive/cast (ptr Convention) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (conv-name (al-get [Convention] (primitive/load (primitive/load cv)) (primitive/load i))) name)
                      (primitive/store! r (al-elem [Convention] (primitive/load cv) (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn conv-is-shim [(c (ptr Convention))] (-> bool)
  (match-else (primitive/load (primitive/field c lowering)) (LShim [] true) (_ false)))
(defn conv-is-native [(cx (ptr Cx)) (name (slice u8))] (-> bool)
  (let [c (conv-find cx name)] (and (primitive/icmp-ne (primitive/cast i64 c) 0) (not (conv-is-shim c)))))
(defn conv-ret-none [(c (ptr Convention))] (-> bool)
  (match-else (primitive/load (primitive/field c ret)) (None [] true) (_ false)))
(defn conv-params-len [(c (ptr Convention))] (-> i64)
  (al-len [(slice u8)] (primitive/load (primitive/field c params))))

(defn cx-init-tables [(cx (ptr Cx)) (a (ptr Allocator))] (-> i64)
  (primitive/store! (primitive/field cx a) a)
  (primitive/store! (primitive/field cx sigs) (al-new [Sig] a))
  (primitive/store! (primitive/field cx sigidx) (hm-new [(slice u8) i64] a (str-keyops)))
  (primitive/store! (primitive/field cx structs) (al-new [StructInfo] a))
  (primitive/store! (primitive/field cx sums) (al-new [SumInfo] a))
  (primitive/store! (primitive/field cx variant_to_sum) (al-new [VtoS] a))
  (primitive/store! (primitive/field cx consts) (al-new [ConstEntry] a))
  (primitive/store! (primitive/field cx static_consts) (al-new [(slice u8)] a))
  (primitive/store! (primitive/field cx trait_defs) (al-new [TraitDef] a))
  (primitive/store! (primitive/field cx methods) (al-new [MethodEntry] a))
  (primitive/store! (primitive/field cx impls) (al-new [ImplDef] a))
  (primitive/store! (primitive/field cx trait_impl_idx) (hm-new [(slice u8) (ptr ImplBucket)] a (str-keyops)))
  (primitive/store! (primitive/field cx inherent_impl_idx) (hm-new [(slice u8) (ptr ImplBucket)] a (str-keyops)))
  (primitive/store! (primitive/field cx inherent_name_idx) (hm-new [(slice u8) (ptr ImplBucket)] a (str-keyops)))
  (primitive/store! (primitive/field cx cur_bounds) (al-new [Bound] a))
  (primitive/store! (primitive/field cx loops) (al-new [LoopFrame] a))
  0)

(defn setup-structs [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field prog structs))
        n (al-len [StructDef] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [sp (al-elem [StructDef] fs (primitive/load i))
                      nm (primitive/load (primitive/field sp name))]
                  (if (primitive/icmp-ne (primitive/cast i64 (struct-find cx nm)) 0)
                      (do (primitive/store! err (derr (sconcat3 a "struct '" nm "' defined twice"))) (primitive/store! failed true) (break))
                      (let [info (alloc/stack StructInfo)]
                        (primitive/store! (primitive/field info name) nm)
                        (primitive/store! (primitive/field info type_params) (primitive/load (primitive/field sp type_params)))
                        (primitive/store! (primitive/field info bounds) (primitive/load (primitive/field sp bounds)))
                        (primitive/store! (primitive/field info fields) (primitive/load (primitive/field sp fields)))
                        (primitive/store! (primitive/field info is_bits) (layout-is-bits (primitive/field sp layout)))
                        (al-push! (mut (primitive/field cx structs)) (primitive/load info)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn setup-sums [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field prog sums))
        n (al-len [SumDef] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [sp (al-elem [SumDef] fs (primitive/load i))
                      nm (primitive/load (primitive/field sp name))]
                  (if (primitive/icmp-ne (primitive/cast i64 (sum-find cx nm)) 0)
                      (do (primitive/store! err (derr (sconcat3 a "sum '" nm "' defined twice"))) (primitive/store! failed true) (break))
                      (do
                        (let [info (alloc/stack SumInfo)]
                          (primitive/store! (primitive/field info name) nm)
                          (primitive/store! (primitive/field info type_params) (primitive/load (primitive/field sp type_params)))
                          (primitive/store! (primitive/field info bounds) (primitive/load (primitive/field sp bounds)))
                          (primitive/store! (primitive/field info variants) (primitive/load (primitive/field sp variants)))
                          (al-push! (mut (primitive/field cx sums)) (primitive/load info)))
                        (let [vs (primitive/load (primitive/field sp variants))
                              vn (al-len [Variant] (primitive/load vs))
                              (mut j) 0]
                          (loop (if (primitive/icmp-ge (primitive/load j) vn)
                                    (break)
                                    (do
                                      (let [vp (al-elem [Variant] vs (primitive/load j))
                                            vnm (primitive/load (primitive/field vp name))]
                                        (if (primitive/icmp-ne (primitive/cast i64 (vts-find cx vnm)) 0)
                                            (do
                                              (primitive/store! err
                                                      (derr (sconcat3 a
                                                                      "variant '"
                                                                      vnm
                                                                      "' is declared in two sum types")))
                                              (primitive/store! failed true)
                                              (break))
                                            (let [ve (alloc/stack VtoS)]
                                              (primitive/store! (primitive/field ve variant) vnm)
                                              (primitive/store! (primitive/field ve sum) nm)
                                              (al-push! (mut (primitive/field cx variant_to_sum)) (primitive/load ve)))))
                                      (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                          (when (primitive/load failed) (break))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn trait-method-self-idx [(tp (ptr TraitMethod)) (selfp (slice u8))] (-> i64)
  (let [ps (primitive/load (primitive/field tp params))
        n (al-len [Param] (primitive/load ps))
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (type-mentions (primitive/field (al-elem [Param] ps (primitive/load i)) ty) selfp) (primitive/store! r (primitive/load i)) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn setup-traits [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [ts (primitive/load (primitive/field prog traits))
        n (al-len [TraitDef] (primitive/load ts))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [tp (al-elem [TraitDef] ts (primitive/load i))
                      tnm (primitive/load (primitive/field tp name))
                      selfp (primitive/load (primitive/field tp self_param))]
                  (let [ms (primitive/load (primitive/field tp methods))
                        mn (al-len [TraitMethod] (primitive/load ms))
                        (mut j) 0]
                    (loop (if (primitive/icmp-ge (primitive/load j) mn)
                              (break)
                              (do
                                (let [mp (al-elem [TraitMethod] ms (primitive/load j))
                                      mnm (primitive/load (primitive/field mp name))
                                      idx (trait-method-self-idx mp selfp)]
                                  (if (primitive/icmp-lt idx 0)
                                      (do
                                        (primitive/store! err
                                                (derr (sconcat a
                                                               (sconcat a
                                                                        (sconcat3 a "trait '" tnm "' method '")
                                                                        (sconcat3 a mnm "': needs a " selfp))
                                                               " (Self) parameter")))
                                        (primitive/store! failed true)
                                        (break))
                                      (let [me (alloc/stack MethodEntry)]
                                        (primitive/store! (primitive/field me name) mnm)
                                        (primitive/store! (primitive/field me trait) tnm)
                                        (primitive/store! (primitive/field me self_idx) idx)
                                        (al-push! (mut (primitive/field cx methods)) (primitive/load me)))))
                                (primitive/store! j (primitive/iadd (primitive/load j) 1))))))
                  (if (primitive/load failed)
                      (break)
                      (if (primitive/icmp-ne (primitive/cast i64 (trait-find cx tnm)) 0)
                          (do
                            (primitive/store! err (derr (sconcat3 a "trait '" tnm "' defined twice")))
                            (primitive/store! failed true)
                            (break))
                          (al-push! (mut (primitive/field cx trait_defs)) (primitive/load tp)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn copy-funcs [(a (ptr Allocator)) (fb (ptr FBox)) (prog (ptr Program))] (-> i64)
  (let [fs (primitive/load (primitive/field prog funcs))
        n (al-len [Func] (primitive/load fs))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut (primitive/field fb items)) (al-get [Func] (primitive/load fs) (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))
(defn tmfn [(a (ptr Allocator)) (tr (slice u8)) (ty (slice u8)) (m (slice u8))] (-> (slice u8))
  (sconcat3 a (sconcat3 a tr "$" ty) "$" m))
(defn inherent-fn-name [(a (ptr Allocator)) (im (ptr ImplDef)) (m (slice u8))] (-> (slice u8))
  (tmfn a "inherent" (impl-mangle-key a (primitive/field im self_type) (primitive/load (primitive/field im type_params))) m))

; ---- impl mangling: one symbol per IMPL, not per (trait, key) ----------------
; Several impls can now share a dispatch key — `(Pair A B)` and `(Pair i64 i64)` both
; key to "Pair" — so `Trait$key$method` no longer names a unique function. The `ty`
; passed to `tmfn` is therefore the IMPL's key (`impl-mangle-key`), not the bare
; dispatch key.
;
; A faithful, injective rendering of a Type. Deterministic and independent of
; declaration order, so the rebootstrap fixpoint holds.
(defn ty-mangle-list [(a (ptr Allocator)) (v (ptr (ArrayList Type)))] (-> (slice u8))
  (let [n (al-len [Type] (primitive/load v))
        (mut i) 0
        (mut s) ""]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (primitive/store! s (sconcat a (primitive/load s) ",")) 0)
                (primitive/store! s (sconcat a (primitive/load s) (ty-mangle a (al-elem [Type] v (primitive/load i)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load s)))
(defn ty-mangle [(a (ptr Allocator)) (t (ptr Type))] (-> (slice u8))
  (match-else (primitive/load t)
              (TInt [b s] (sconcat a (if s "i" "u") (i64->str a b)))
              (TFloat [b] (sconcat a "f" (i64->str a b)))
              (TBool [] "bool")
              (TVoid [] "void")
              (TStruct [n] n)
              (TApp [n args] (sconcat a n (sconcat3 a "<" (ty-mangle-list a args) ">")))
              (TPtr [i] (sconcat3 a "ptr<" (ty-mangle a i) ">"))
              (TSlice [i] (sconcat3 a "slice<" (ty-mangle a i) ">"))
              (TRef [m i] (sconcat3 a (if m "mut<" "ref<") (ty-mangle a i) ">"))
              (TArray [i n] (sconcat a "array<" (sconcat a (ty-mangle a i) (sconcat3 a "," (i64->str a n) ">"))))
              (TVec [i n] (sconcat a "vec<" (sconcat a (ty-mangle a i) (sconcat3 a "," (i64->str a n) ">"))))
              (TFn [cc ps r]
                   (sconcat a
                            "fn<"
                            (sconcat a
                                     cc
                                     (sconcat a
                                              ","
                                              (sconcat a
                                                       (ty-mangle-list a ps)
                                                       (sconcat3 a "," (ty-mangle a r) ">"))))))
              (_ "?")))

(defn is-tparam? [(t (ptr Type)) (params (ptr (ArrayList (slice u8))))] (-> bool)
  (if (primitive/icmp-eq (type-tag t) 6) (set-contains params (type-struct-name t)) false))
; every arg a type param, and no param used twice (so `(Pair A A)` is NOT general —
; it is a diagonal specialization of `(Pair A B)`)
(defn args-distinct-params? [(a (ptr Allocator)) (v (ptr (ArrayList Type))) (params (ptr (ArrayList (slice u8))))] (-> bool)
  (let [n (al-len [Type] (primitive/load v))
        (mut i) 0
        (mut ok) true]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (not (primitive/load ok)) (break))
                (let [e (al-elem [Type] v (primitive/load i))]
                  (if (not (is-tparam? e params))
                      (do (primitive/store! ok false) (break))
                      ; distinct: no EARLIER arg names the same param (all earlier args are
                      ; known tparams — we'd have bailed otherwise, so type-struct-name is safe)
                      (let [nm (type-struct-name e)
                            (mut j) 0]
                        (loop (if (primitive/icmp-ge (primitive/load j) (primitive/load i))
                                  (break)
                                  (do
                                    (when (str-eq (type-struct-name (al-elem [Type] v (primitive/load j))) nm)
                                          (primitive/store! ok false)
                                          (break))
                                    (primitive/store! j (primitive/iadd (primitive/load j) 1))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load ok)))
; Is this impl the CANONICAL GENERAL one for its key — the head constructor applied to
; distinct type params, with nothing concrete anywhere? Those keep the plain,
; undecorated key. That is what makes this change symbol-compatible: every impl that
; existed before (scalars, plain structs, `(slice T)`, `(ArrayList T)`, `(ptr T)`, …)
; is general, so its mangled name is byte-identical to before and the blessed IR
; snapshots still match. Only genuinely specialized impls get a decorated name.
(defn impl-general? [(a (ptr Allocator)) (t (ptr Type)) (params (ptr (ArrayList (slice u8))))] (-> bool)
  (match-else (primitive/load t)
              (TInt [_ _] true)
              (TFloat [_] true)
              (TBool [] true)
              (TStruct [n] (not (set-contains params n)))
              (TPtr [i] (is-tparam? i params))
              (TSlice [i] (is-tparam? i params))
              (TApp [_ args] (args-distinct-params? a args params))
              ; array/vec carry a length and fn a signature — always part of the pattern, so
              ; these are never "the general impl" and always get a decorated name.
              (_ false)))
(defn impl-mangle-key [(a (ptr Allocator)) (t (ptr Type)) (params (ptr (ArrayList (slice u8))))] (-> (slice u8))
  (if (impl-general? a t params) (impl-base-name a t) (ty-mangle a t)))
(defn impl-find-method [(im (ptr ImplDef)) (mname (slice u8))] (-> (ptr Func))
  (let [ms (primitive/load (primitive/field im methods))
        n (al-len [Func] (primitive/load ms))
        (mut i) 0
        (mut r) (primitive/cast (ptr Func) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (func-name (al-get [Func] (primitive/load ms) (primitive/load i))) mname)
                      (primitive/store! r (al-elem [Func] ms (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn subst-self-params [(a (ptr Allocator)) (tm (ptr TraitMethod)) (selfp (slice u8)) (cty (ptr Type))] (-> (ptr (ArrayList Type)))
  (let [ps (primitive/load (primitive/field tm params))
        (mut out) (al-new [Type] a)
        n (al-len [Param] (primitive/load ps))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (subst-self a (primitive/field (al-elem [Param] ps (primitive/load i)) ty) selfp cty))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))
(defn param-types [(a (ptr Allocator)) (ps (ptr (ArrayList Param)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Param] (primitive/load ps))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (primitive/load (primitive/field (al-elem [Param] ps (primitive/load i)) ty)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))
(defn impl-prefix [(a (ptr Allocator)) (tr (slice u8)) (forty (slice u8))] (-> (slice u8))
  (sconcat a (sconcat3 a "impl " tr " for ") (sconcat a forty ": ")))

; ---- trait-extras unification --------------
; Match a trait-declared type (`want`, the trait's EXTRA type parameters open)
; against an impl method's declared type (`got`): bind each extra on first
; sight, require consistency after; everything else must match exactly. The
; impl's own type params appear as plain nominal names on both sides.
(defn extras-has [(extras (ptr (ArrayList (slice u8)))) (n (slice u8))] (-> bool)
  (let [k (al-len [(slice u8)] (primitive/load extras))
        (mut i) 0
        (mut r) false]
    (loop (if (primitive/icmp-ge (primitive/load i) k)
              (break)
              (do
                (when (str-eq (al-get [(slice u8)] (primitive/load extras) (primitive/load i)) n) (primitive/store! r true) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn unify-extras-list [(a (ptr Allocator))
                         (w (ptr (ArrayList Type)))
                         (g (ptr (ArrayList Type)))
                         (extras (ptr (ArrayList (slice u8))))
                         (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [nw (al-len [Type] (primitive/load w))
        ng (al-len [Type] (primitive/load g))
        (mut i) 0
        (mut ok) (primitive/icmp-eq nw ng)]
    (loop (if (or (not (primitive/load ok)) (primitive/icmp-ge (primitive/load i) nw))
              (break)
              (do
                (unless (unify-trait-extras a (al-elem [Type] w (primitive/load i)) (al-elem [Type] g (primitive/load i)) extras binds)
                        (primitive/store! ok false)
                        0)
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load ok)))
(defn unify-trait-extras [(a (ptr Allocator))
                          (want (ptr Type))
                          (got (ptr Type))
                          (extras (ptr (ArrayList (slice u8))))
                          (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (match-else (primitive/load want)
              (TStruct [n]
                       (if (extras-has extras n)
                           (let [b (subst-get binds n)]
                             (if (primitive/icmp-eq (primitive/cast i64 b) 0)
                                 (do (subst-insert! binds n got) true)
                                 (type-eq b got)))
                           (type-eq want got)))
              (TRef [mw pw]
                    (match-else (primitive/load got)
                                (TRef [mg pg] (and (if mw mg (not mg)) (unify-trait-extras a pw pg extras binds)))
                                (_ false)))
              (TPtr [pw] (match-else (primitive/load got) (TPtr [pg] (unify-trait-extras a pw pg extras binds)) (_ false)))
              (TSlice [pw] (match-else (primitive/load got) (TSlice [pg] (unify-trait-extras a pw pg extras binds)) (_ false)))
              (TArray [pw nw]
                      (match-else (primitive/load got)
                                  (TArray [pg ng] (and (primitive/icmp-eq nw ng) (unify-trait-extras a pw pg extras binds)))
                                  (_ false)))
              (TVec [pw nw]
                    (match-else (primitive/load got)
                                (TVec [pg ng] (and (primitive/icmp-eq nw ng) (unify-trait-extras a pw pg extras binds)))
                                (_ false)))
              (TApp [nw aw]
                    (match-else (primitive/load got)
                                (TApp [ng ag] (and (str-eq nw ng) (unify-extras-list a aw ag extras binds)))
                                (_ false)))
              (TFn [cw pw rw]
                   (match-else (primitive/load got)
                               (TFn [cg pg rg]
                                    (and (str-eq cw cg)
                                         (and (unify-extras-list a pw pg extras binds)
                                              (unify-trait-extras a rw rg extras binds))))
                               (_ false)))
              (_ (type-eq want got))))
(defn unify-extras-params [(a (ptr Allocator))
                           (want (ptr (ArrayList Type)))
                           (m (ptr Func))
                           (extras (ptr (ArrayList (slice u8))))
                           (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [got (param-types a (primitive/load (primitive/field m params)))]
    (unify-extras-list a want got extras binds)))

(defn check-impl-methods [(a (ptr Allocator)) (cx (ptr Cx)) (im (ptr ImplDef)) (td (ptr TraitDef)) (cty (ptr Type))] (-> (Result i64
                                                                                                                                 Diag))
  (let [tr (impl-trait-name im)
        forty (primitive/load (primitive/field im for_type))
        selfp (primitive/load (primitive/field td self_param))
        extras (primitive/load (primitive/field td type_params))
        (mut binds) (al-new [SubstEntry] a)
        tms (primitive/load (primitive/field td methods))
        n (al-len [TraitMethod] (primitive/load tms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [tm (al-elem [TraitMethod] tms (primitive/load i))
                      tmn (primitive/load (primitive/field tm name))
                      m (impl-find-method im tmn)]
                  (if (primitive/icmp-eq (primitive/cast i64 m) 0)
                      (do
                        (primitive/store! err (derr (sconcat a (impl-prefix a tr forty) (sconcat3 a "missing method '" tmn "'"))))
                        (primitive/store! failed true)
                        (break))
                      (let [want (subst-self-params a tm selfp cty)
                            wantret (subst-self a (primitive/field tm ret) selfp cty)
                            ok-params (unify-extras-params a want m extras (mut binds))
                            ok-ret (unify-trait-extras a (box-type a wantret) (primitive/field m ret) extras (mut binds))]
                        (when (or (not ok-params) (not ok-ret))
                              (primitive/store! err
                                      (derr (sconcat a
                                                     (impl-prefix a tr forty)
                                                     (sconcat3 a "method '" tmn "' signature doesn't match the trait"))))
                              (primitive/store! failed true)
                              (break)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn append-impl-methods [(a (ptr Allocator)) (im (ptr ImplDef)) (fb (ptr FBox))] (-> i64)
  ; the IMPL's key, not the bare dispatch key — several impls can share the latter
  (let [tr (impl-trait-name im)
        forty (impl-mangle-key a (primitive/field im self_type) (primitive/load (primitive/field im type_params)))
        ms (primitive/load (primitive/field im methods))
        n (al-len [Func] (primitive/load ms))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [lf (alloc/stack Func)]
                  (primitive/store! lf (al-get [Func] (primitive/load ms) (primitive/load i)))
                  (primitive/store! (primitive/field lf name) (tmfn a tr forty (primitive/load (primitive/field lf name))))
                  (al-push! (mut (primitive/field fb items)) (primitive/load lf)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))
(defn append-inherent-methods [(a (ptr Allocator)) (im (ptr ImplDef)) (fb (ptr FBox))] (-> i64)
  (let [ms (primitive/load (primitive/field im methods))
        n (al-len [Func] (primitive/load ms))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [lf (alloc/stack Func)]
                  (primitive/store! lf (al-get [Func] (primitive/load ms) (primitive/load i)))
                  (primitive/store! (primitive/field lf name) (inherent-fn-name a im (primitive/load (primitive/field lf name))))
                  (al-push! (mut (primitive/field fb items)) (primitive/load lf)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))

(defn register-impl! [(a (ptr Allocator)) (cx (ptr Cx)) (im (ptr ImplDef))] (-> i64)
  (let [slot (al-len [ImplDef] (primitive/load (primitive/field cx impls)))]
    (al-push! (mut (primitive/field cx impls)) (primitive/load im))
    (if (impl-is-trait im)
        (impl-index-add! a
                         (mut (primitive/field cx trait_impl_idx))
                         (impl-index-key a (impl-trait-name im) (primitive/load (primitive/field im for_type)))
                         slot)
        (let [ms (primitive/load (primitive/field im methods))
              n (al-len [Func] (primitive/load ms))
              (mut i) 0]
          (loop (if (primitive/icmp-ge (primitive/load i) n)
                    (break)
                    (do
                      (let [name (primitive/load (primitive/field (al-elem [Func] ms (primitive/load i)) name))]
                        (impl-index-add! a
                                         (mut (primitive/field cx inherent_impl_idx))
                                         (impl-index-key a name (primitive/load (primitive/field im for_type)))
                                         slot)
                        (impl-index-add! a (mut (primitive/field cx inherent_name_idx)) name slot))
                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))
    0))

; An inherent method is receiver-dispatched when its first parameter, after
; peeling ptr/ref, is the impl target pattern. Otherwise it is an associated
; function and must be called as `Type::name` because no argument identifies its
; owner. Parameter names carry no semantics; `(db (ptr LayoutDb))` works as well
; as `(self (ptr LayoutDb))`.
(defn inherent-receiver? [(a (ptr Allocator)) (im (ptr ImplDef)) (m (ptr Func))] (-> bool)
  (let [ps (primitive/load (primitive/field m params))]
    (if (primitive/icmp-eq (al-len [Param] (primitive/load ps)) 0)
        false
        (let [pt (primitive/field (al-elem [Param] ps 0) ty)
              base (peel-ref-ptr pt)
              tps (primitive/load (primitive/field im type_params))]
          (or (and (pat-matches? a (primitive/field im self_type) tps pt)
                   (pat-matches? a pt tps (primitive/field im self_type)))
              (and (pat-matches? a (primitive/field im self_type) tps base)
                   (pat-matches? a base tps (primitive/field im self_type))))))))

(defn inherent-method-duplicate? [(a (ptr Allocator)) (cx (ptr Cx)) (im (ptr ImplDef)) (m (ptr Func))] (-> bool)
  (let [name (primitive/load (primitive/field m name))
        recv (inherent-receiver? a im m)
        bucket (impl-index-get (primitive/field cx inherent_impl_idx)
                               (impl-index-key a name (primitive/load (primitive/field im for_type))))
        n (if (primitive/icmp-eq (primitive/cast i64 bucket) 0) 0 (al-len [i64] (primitive/load (primitive/field bucket items))))
        (mut i) 0
        (mut dup) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [old (al-elem [ImplDef] (primitive/field cx impls) (al-get [i64] (primitive/load (primitive/field bucket items)) (primitive/load i)))
                      om (impl-find-method old name)]
                  (unless (primitive/icmp-eq (primitive/cast i64 om) 0)
                          (let [orecv (inherent-receiver? a old om)]
                                    ; Associated functions have no receiver to select a
                                    ; specialization, so one owner/name is the limit.
                                    ; Every exact-pattern duplicate collides after
                                    ; lowering, including receiver-vs-associated. Ordered
                                    ; receiver specializations remain legal.
                                    (when (or (and (pat-matches? a
                                                                (primitive/field old self_type)
                                                                (primitive/load (primitive/field old type_params))
                                                                (primitive/field im self_type))
                                                   (pat-matches? a
                                                                 (primitive/field im self_type)
                                                                 (primitive/load (primitive/field im type_params))
                                                                 (primitive/field old self_type)))
                                              (and (not recv)
                                                   (and (not orecv)
                                                        (str-eq (primitive/load (primitive/field old for_type))
                                                                (primitive/load (primitive/field im for_type))))) )
                                  (primitive/store! dup true)
                                  (break)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load dup)))

(defn setup-one-inherent [(a (ptr Allocator)) (cx (ptr Cx)) (im (ptr ImplDef)) (fb (ptr FBox))] (-> (Result i64 Diag))
  (try (do
         (let [ms (primitive/load (primitive/field im methods))
                 n (al-len [Func] (primitive/load ms))
                 (mut i) 0]
             (loop (if (primitive/icmp-ge (primitive/load i) n)
                       (break)
                       (do
                         (let [m (al-elem [Func] ms (primitive/load i))]
                           (let [(mut j) 0]
                             (loop (if (primitive/icmp-ge (primitive/load j) (primitive/load i))
                                       (break)
                                       (do
                                         (when (str-eq (primitive/load (primitive/field (al-elem [Func] ms (primitive/load j)) name))
                                                       (primitive/load (primitive/field m name)))
                                               (break :try
                                                      (Err [i64 Diag]
                                                           (derr (sconcat3 a
                                                                           "duplicate inherent method '"
                                                                           (primitive/load (primitive/field m name))
                                                                           "' in one impl")))))
                                         (primitive/store! j (primitive/iadd (primitive/load j) 1))))))
                           (when (inherent-method-duplicate? a cx im m)
                                 (break :try
                                        (Err [i64 Diag]
                                             (derr (sconcat a
                                                            (sconcat3 a "duplicate inherent method '" (primitive/load (primitive/field m name)) "' for '")
                                                            (sconcat a (ty-str a (primitive/field im self_type)) "'")))))))
                         (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
           (register-impl! a cx im)
           (append-inherent-methods a im fb)
           (Ok 0))))
(defn setup-one-impl [(a (ptr Allocator)) (cx (ptr Cx)) (im (ptr ImplDef)) (fb (ptr FBox))] (-> (Result i64 Diag))
  (if (impl-is-inherent im)
      (setup-one-inherent a cx im fb)
      (try (do
         (let [tr (impl-trait-name im)
               forty (primitive/load (primitive/field im for_type))]
           (when (primitive/icmp-eq (primitive/cast i64 (trait-find cx tr)) 0)
                 (break :try (Err [i64 Diag] (derr (sconcat3 a "impl: unknown trait '" tr "'")))))
           ; Several impls may share a dispatch key — `(Pair A B)` and `(Pair i64 i64)` both
           ; key to "Pair" — so a key clash is no longer a duplicate. Only two impls with the
           ; SAME PATTERN (each matching the other) are. Overlaps that are neither disjoint
           ; nor ordered (`(Pair i64 B)` vs `(Pair A bool)`) are reported at the use site
           ; that actually instantiates the overlap, not banned here.
           (when (impl-dup? a cx tr (primitive/field im self_type) (primitive/load (primitive/field im type_params)))
                 (break :try
                        (Err [i64 Diag]
                             (derr (sconcat a
                                            (sconcat3 a "duplicate impl of '" tr "' for '")
                                            (sconcat a (ty-str a (primitive/field im self_type)) "'"))))))
           (register-impl! a cx im)
           (let [td (trait-find cx tr)
                 cty (box-type a (primitive/load (primitive/field im self_type)))]
             (try! (check-impl-methods a cx im td cty)))
           (append-impl-methods a im fb)
           (Ok 0))))))
(defn setup-impls [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program)) (fb (ptr FBox))] (-> (Result i64 Diag))
  (let [is (primitive/load (primitive/field prog impls))
        n (al-len [ImplDef] (primitive/load is))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (setup-one-impl a cx (al-elem [ImplDef] is (primitive/load i)) fb)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
; gen-8 supertrait enforcement. A `(deftrait Derived [Self] :requires [Base …])` makes
; `Base` a SUPERTRAIT: every `(impl Derived T)` must be accompanied by an `(impl Base T)`
; for the same implementing type. Run this AFTER `setup-impls` has registered every impl,
; so the required impl may appear anywhere in source order (impl-match sees the whole set).
(defn check-supertraits [(a (ptr Allocator)) (cx (ptr Cx))] (-> (Result i64 Diag))
  (let [is (primitive/field cx impls)
        n (al-len [ImplDef] (primitive/load is))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [im (al-elem [ImplDef] is (primitive/load i))]
                  (when (impl-is-trait im)
                    (let [tr (impl-trait-name im)
                          td (trait-find cx tr)]
                      (when (primitive/icmp-ne (primitive/cast i64 td) 0)
                        (let [reqs (primitive/load (primitive/field td requires))
                              nr (al-len [(slice u8)] (primitive/load reqs))
                              (mut k) 0]
                          (loop (if (primitive/icmp-ge (primitive/load k) nr)
                                    (break)
                                    (do
                                      (let [req (al-get [(slice u8)] (primitive/load reqs) (primitive/load k))]
                                        (when (not (impl-match a cx req (primitive/field im self_type)))
                                          (primitive/store! err
                                                  (derr (sconcat a
                                                                 (impl-prefix a
                                                                              (display-name tr)
                                                                              (ty-str a (primitive/field im self_type)))
                                                                 (sconcat a
                                                                          "requires an impl of supertrait '"
                                                                          (sconcat a
                                                                                   (display-name req)
                                                                                   "' for the same type (declared by ':requires' on the trait)")))))
                                          (primitive/store! failed true)
                                          (break)))
                                      (if (primitive/load failed)
                                          (break)
                                          (primitive/store! k (primitive/iadd (primitive/load k) 1)))))))))))
                (if (primitive/load failed) (break) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn setup-one-sig [(a (ptr Allocator)) (cx (ptr Cx)) (fp (ptr Func))] (-> i64)
  (let [cc (primitive/load (primitive/field fp cc))
        tps (primitive/load (primitive/field fp type_params))
        native (conv-is-native cx cc)
        sg (alloc/stack Sig)]
    (primitive/store! (primitive/field sg name) (primitive/load (primitive/field fp name)))
    (primitive/store! (primitive/field sg type_params) tps)
    (primitive/store! (primitive/field sg bounds) (primitive/load (primitive/field fp bounds)))
    (primitive/store! (primitive/field sg params) (param-ref-types a cx (primitive/load (primitive/field fp params)) tps))
    (primitive/store! (primitive/field sg ret) (primitive/load (primitive/field fp ret)))
    (primitive/store! (primitive/field sg is_extern) false)
    (primitive/store! (primitive/field sg variadic) false)
    (primitive/store! (primitive/field sg cc) cc)
    (primitive/store! (primitive/field sg fnptr_ok) (and native (primitive/icmp-eq (al-len [(slice u8)] (primitive/load tps)) 0)))
    (al-push! (mut (primitive/field cx sigs)) (primitive/load sg))
    (sig-index-put! cx (primitive/load (primitive/field sg name)))
    0))
(defn param-ref-types [(a (ptr Allocator))
                       (cx (ptr Cx))
                       (ps (ptr (ArrayList Param)))
                       (tps (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Param] (primitive/load ps))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (param-ref-type cx (primitive/field (al-elem [Param] ps (primitive/load i)) ty) tps))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))
(defn setup-sigs [(a (ptr Allocator)) (cx (ptr Cx)) (allf (ptr (ArrayList Func)))] (-> i64)
  (let [n (al-len [Func] (primitive/load allf))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (setup-one-sig a cx (al-elem [Func] allf (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))
(defn setup-externs [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [es (primitive/load (primitive/field prog externs))
        n (al-len [Extern] (primitive/load es))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ep (al-elem [Extern] es (primitive/load i))
                      nm (primitive/load (primitive/field ep name))]
                  ; validate the signature's types up front, so an unknown type in an extern
                  ; declaration is a clean diagnostic instead of a later codegen crash.
                  (match (validate-type-list (primitive/load (primitive/field ep params)) cx (empty-strs a))
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) 0))
                    (Ok [_]
                        (unless (type-is-void (primitive/field ep ret))
                                ; void is valid in return position
                                (match (validate-type (primitive/field ep ret) cx (empty-strs a))
                                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) 0))
                                  (Ok [_] 0)))))
                  (if (primitive/load failed)
                      (break)
                      (if (primitive/icmp-ne (primitive/cast i64 (sig-find cx nm)) 0)
                          (do
                            (primitive/store! err (derr (sconcat3 a "'" nm "' is declared more than once")))
                            (primitive/store! failed true)
                            (break))
                          (let [c (conv-find cx (primitive/load (primitive/field ep cc)))]
                            (if (primitive/icmp-eq (primitive/cast i64 c) 0)
                                (do
                                  (primitive/store! err
                                          (derr (sconcat3 a
                                                          (sconcat3 a "extern '" nm "': unknown convention '")
                                                          (primitive/load (primitive/field ep cc))
                                                          "'")))
                                  (primitive/store! failed true)
                                  (break))
                                (if (conv-is-shim c)
                                    (do
                                      (primitive/store! err
                                              (derr (sconcat3 a
                                                              "extern '"
                                                              nm
                                                              "': shim conventions for externs are not supported yet")))
                                      (primitive/store! failed true)
                                      (break))
                                    (let [sg (alloc/stack Sig)]
                                      (primitive/store! (primitive/field sg name) nm)
                                      (primitive/store! (primitive/field sg type_params) (empty-strs a))
                                      (primitive/store! (primitive/field sg bounds) (box-al [Bound] a (al-new [Bound] a)))
                                      (primitive/store! (primitive/field sg params) (primitive/load (primitive/field ep params)))
                                      (primitive/store! (primitive/field sg ret) (primitive/load (primitive/field ep ret)))
                                      (primitive/store! (primitive/field sg is_extern) true)
                                      (primitive/store! (primitive/field sg variadic) (primitive/load (primitive/field ep variadic)))
                                      (primitive/store! (primitive/field sg cc) (primitive/load (primitive/field ep cc)))
                                      (primitive/store! (primitive/field sg fnptr_ok) true)
                                      (al-push! (mut (primitive/field cx sigs)) (primitive/load sg))
                                      (sig-index-put! cx (primitive/load (primitive/field sg name))))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn opt-type-some? [(o (ptr (Option Type)))] (-> bool)
  (match-else (primitive/load o) (Some [t] true) (_ false)))
(defn opt-type-val [(o (ptr (Option Type)))] (-> Type)
  (match-else (primitive/load o) (Some [t] t) (_ (TVoid))))
(defn type-is-aggregate-static [(t (ptr Type))] (-> bool)
  (match-else (primitive/load t) (TStruct [_] true) (TArray [_ _] true) (_ false)))
(defn compute-const-entry [(a (ptr Allocator)) (cx (ptr Cx)) (cp (ptr Const))] (-> (Result EvalPair Diag))
  (if (is-literal-value (primitive/field cp value))
      (const-entry a cp)
      ; non-literal const value = a compile-time computation:
      ; synth the value (fname "const <name>"), then—if the const declares a
      ; type—coerce to it; report (value, declared|synth type). A const reference
      ; later elaborates to `(comptime value)` for the fold pass (see synth EVar).
      (let [nm (primitive/load (primitive/field cp name))
            env (env-new a)
            tps (empty-strs a)
            expected (if (opt-type-some? (primitive/field cp ty)) (box-type a (opt-type-val (primitive/field cp ty))) (null-type))]
        (match (do-synth a (primitive/field cp value) expected env cx tps (sconcat a "const " nm))
          (Err [d] (Err [EvalPair Diag] d))
          (Ok [sp0]
              (let [sp (alloc/stack SynPair)]
                (primitive/store! sp sp0)
                (match (primitive/load (primitive/field cp ty))
                  (Some [want]
                        (let [wt (box-type a want)
                              tstr (ty-str a (primitive/load (primitive/field sp t)))]
                          (match (coerce a (primitive/load (primitive/load (primitive/field sp e))) (primitive/load (primitive/field sp t)) wt false nm "const value")
                            (Err [_]
                                 (Err [EvalPair Diag]
                                      (derr (sconcat a
                                                     (sconcat5 a
                                                               "const '"
                                                               nm
                                                               "': value has type "
                                                               tstr
                                                               " but declared ")
                                                     (ty-str a wt)))))
                            (Ok [ev] (Ok (mk-evalpair ev want))))))
                  (None [] (Ok (mk-evalpair (primitive/load (primitive/load (primitive/field sp e))) (primitive/load (primitive/load (primitive/field sp t)))))))))))))
(defn setup-consts [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [cs (primitive/load (primitive/field prog consts))
        n (al-len [Const] (primitive/load cs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [cp (al-elem [Const] cs (primitive/load i))
                      nm (primitive/load (primitive/field cp name))]
                  (if (or (primitive/icmp-ne (primitive/cast i64 (sig-find cx nm)) 0) (primitive/icmp-ne (primitive/cast i64 (const-find cx nm)) 0))
                      (do
                        (primitive/store! err (derr (sconcat3 a "'" nm "' is declared more than once")))
                        (primitive/store! failed true)
                        (break))
                      (match (compute-const-entry a cx cp)
                        (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                        (Ok [epv]
                            (let [ep (alloc/stack EvalPair)]
                              (primitive/store! ep epv)
                              (do
                                (when (type-is-aggregate-static (primitive/field ep t))
                                      (al-push! (mut (primitive/field cx static_consts)) nm)
                                      0)
                                (let [ce (alloc/stack ConstEntry)]
                                  (primitive/store! (primitive/field ce name) nm)
                                  (primitive/store! (primitive/field ce value) (primitive/load (primitive/field ep e)))
                                  (primitive/store! (primitive/field ce ty) (primitive/load (primitive/field ep t)))
                                  (al-push! (mut (primitive/field cx consts)) (primitive/load ce)))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn setup-validate-const-types [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [cs (primitive/load (primitive/field prog consts))
        n (al-len [Const] (primitive/load cs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [cp (al-elem [Const] cs (primitive/load i))
                      nm (primitive/load (primitive/field cp name))]
                  (when (opt-type-some? (primitive/field cp ty))
                        (match (validate-type (box-type a (opt-type-val (primitive/field cp ty))) cx (empty-strs a))
                          (Err [d]
                               (do
                                 (primitive/store! err (prefix-diag a d (sconcat3 a "const '" nm "': ")))
                                 (primitive/store! failed true)
                                 (break)))
                          (Ok [_] 0))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn validate-one-struct-fields [(a (ptr Allocator)) (cx (ptr Cx)) (sp (ptr StructDef))] (-> (Result i64 Diag))
  (let [nm (primitive/load (primitive/field sp name))
        tps (primitive/load (primitive/field sp type_params))
        fs (primitive/load (primitive/field sp fields))
        n (al-len [Field] (primitive/load fs))
        (mut i) 0
        (mut seen) (al-new [(slice u8)] a)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [fp (al-elem [Field] fs (primitive/load i))
                      fnm (primitive/load (primitive/field fp name))]
                  (if (set-contains (box-al [(slice u8)] a (primitive/load seen)) fnm)
                      (do
                        (primitive/store! err
                                (derr (sconcat a (sconcat3 a "struct '" nm "': duplicate field '") (sconcat a fnm "'"))))
                        (primitive/store! failed true)
                        (break))
                      (do
                        (al-push! (mut seen) fnm)
                        (match (validate-type (primitive/field fp ty) cx tps)
                          (Err [d]
                               (do
                                 (primitive/store! err
                                         (prefix-diag a
                                                      d
                                                      (sconcat a
                                                               (sconcat3 a "struct '" nm "' field '")
                                                               (sconcat a fnm "': "))))
                                 (primitive/store! failed true)
                                 (break)))
                          (Ok [_] 0)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn setup-validate-struct-fields [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field prog structs))
        n (al-len [StructDef] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (validate-one-struct-fields a cx (al-elem [StructDef] fs (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn validate-one-variant-fields [(a (ptr Allocator))
                                   (cx (ptr Cx))
                                   (sumnm (slice u8))
                                   (tps (ptr (ArrayList (slice u8))))
                                   (vp (ptr Variant))] (-> (Result i64 Diag))
  (let [vnm (primitive/load (primitive/field vp name))
        fs (primitive/load (primitive/field vp fields))
        n (al-len [Field] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [fp (al-elem [Field] fs (primitive/load i))
                      fnm (primitive/load (primitive/field fp name))]
                  (match (validate-type (primitive/field fp ty) cx tps)
                    (Err [d]
                         (do
                           (primitive/store! err
                                   (prefix-diag a
                                                d
                                                (sconcat a
                                                         (sconcat a
                                                                  (sconcat3 a "sum '" sumnm "' variant '")
                                                                  (sconcat3 a vnm "' field '" fnm))
                                                         "': ")))
                           (primitive/store! failed true)
                           (break)))
                    (Ok [_] 0)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn validate-one-sum-fields [(a (ptr Allocator)) (cx (ptr Cx)) (sp (ptr SumDef))] (-> (Result i64 Diag))
  (let [sumnm (primitive/load (primitive/field sp name))
        tps (primitive/load (primitive/field sp type_params))
        vs (primitive/load (primitive/field sp variants))
        n (al-len [Variant] (primitive/load vs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (validate-one-variant-fields a cx sumnm tps (al-elem [Variant] vs (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn setup-validate-sum-fields [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field prog sums))
        n (al-len [SumDef] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (validate-one-sum-fields a cx (al-elem [SumDef] fs (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))

(defn setup [(a (ptr Allocator))
             (cx (ptr Cx))
             (prog (ptr Program))
             (impb (ptr (ArrayList ImpEntry)))
             (expb (ptr (ArrayList ExpEntry)))] (-> (Result (ptr (ArrayList Func)) Diag))
  (try (do
         (cx-init-tables cx a)
         (primitive/store! (primitive/field cx imports) impb)
         (primitive/store! (primitive/field cx exports) expb)
         (primitive/store! (primitive/field cx conventions) (primitive/load (primitive/field prog conventions)))
         (try! (setup-structs a cx prog))
         (try! (setup-sums a cx prog))
         (try! (setup-traits a cx prog))
         (let [fb (unwrap-ptr [FBox] (create [FBox] a))]
           (primitive/store! (primitive/field fb items) (al-new [Func] a))
           (copy-funcs a fb prog)
           (try! (setup-impls a cx prog fb))
           (try! (check-supertraits a cx))
           (setup-sigs a cx (primitive/field fb items))
           (try! (setup-externs a cx prog))
           (try! (setup-consts a cx prog))
           (try! (setup-validate-const-types a cx prog))
           (try! (setup-validate-struct-fields a cx prog))
           (try! (setup-validate-sum-fields a cx prog))
           (Ok (primitive/field fb items))))))

; ============================ check_func (Phase 2) =================
(defn validate-params [(a (ptr Allocator))
                       (cx (ptr Cx))
                       (ps (ptr (ArrayList Param)))
                       (tps (ptr (ArrayList (slice u8))))
                       (fnm (slice u8))] (-> (Result i64 Diag))
  (let [n (al-len [Param] (primitive/load ps))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] ps (primitive/load i))
                      pnm (primitive/load (primitive/field pp name))]
                  (match (validate-type (primitive/field pp ty) cx tps)
                    (Err [d]
                         (do
                           (primitive/store! err
                                   (prefix-diag a
                                                d
                                                (sconcat a
                                                         (sconcat3 a "function '" fnm "' param '")
                                                         (sconcat a pnm "': "))))
                           (primitive/store! failed true)
                           (break)))
                    (Ok [_] 0)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn build-param-env [(a (ptr Allocator))
                       (cx (ptr Cx))
                       (ps (ptr (ArrayList Param)))
                       (tps (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList EnvEntry)))
  (let [(mut out) (al-new [EnvEntry] a)
        n (al-len [Param] (primitive/load ps))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] ps (primitive/load i))
                      ee (alloc/stack EnvEntry)]
                  (primitive/store! (primitive/field ee name) (primitive/load (primitive/field pp name)))
                  (primitive/store! (primitive/field ee ty) (param-ref-type cx (primitive/field pp ty) tps))
                  (primitive/store! (primitive/field ee bid) (next-bid))
                  (al-push! (mut out) (primitive/load ee)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [EnvEntry] a (primitive/load out))))
(defn erase-param-types [(a (ptr Allocator))
                         (cx (ptr Cx))
                         (ps (ptr (ArrayList Param)))
                         (tps (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList Param)))
  (let [(mut out) (al-new [Param] a)
        n (al-len [Param] (primitive/load ps))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] ps (primitive/load i))
                      np (alloc/stack Param)]
                  (primitive/store! (primitive/field np name) (primitive/load (primitive/field pp name)))
                  (primitive/store! (primitive/field np ty) (erase-refs a (box-type a (param-ref-type cx (primitive/field pp ty) tps))))
                  (al-push! (mut out) (primitive/load np)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Param] a (primitive/load out))))
; check one body, accumulator-style (NO return-from inside the loop — gotcha #1).
(defn check-body [(a (ptr Allocator))
                  (cx (ptr Cx))
                  (fp (ptr Func))
                  (env (ptr (ArrayList EnvEntry)))
                  (tps (ptr (ArrayList (slice u8))))
                  (fnm (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [body (primitive/load (primitive/field fp body))
        bn (al-len [Expr] (primitive/load body))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) bn)
              (break)
              (do
                (let [ep (al-elem [Expr] body (primitive/load i))
                      istail (primitive/icmp-eq (primitive/iadd (primitive/load i) 1) bn)]
                  (if istail
                      (match (synth a ep (primitive/field fp ret) env cx tps fnm)
                        (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                        (Ok [rv]
                            (let [r (alloc/stack EvalPair)]
                              (primitive/store! r rv)
                              (match (coerce a
                                             (primitive/load (primitive/field r e))
                                             (box-type a (primitive/load (primitive/field r t)))
                                             (primitive/field fp ret)
                                             false
                                             fnm
                                             "body")
                                ; point at the TAIL expression: `ep` is it, and its span was right
                                ; here unused. Without it the message names a type mismatch but not
                                ; which of a 60-line body's expressions is the offending tail —
                                ; exactly the question the reader is asking.
                                (Err [_]
                                     (do
                                       (primitive/store! err
                                               (dwspan (derr (sconcat a
                                                                      (sconcat a
                                                                               (sconcat a
                                                                                        (sconcat3 a
                                                                                                  "function '"
                                                                                                  fnm
                                                                                                  "': body has type ")
                                                                                        (ty-str a
                                                                                                (box-type a
                                                                                                          (primitive/load (primitive/field r
                                                                                                                       t)))))
                                                                               " but the declared return type is ")
                                                                      (ty-str a (primitive/field fp ret))))
                                                       (primitive/load (primitive/field ep source))
                                                       (primitive/load (primitive/field ep lo))
                                                       (primitive/load (primitive/field ep hi))
                                                       (primitive/load (primitive/field ep ctxt))))
                                       (primitive/store! failed true)
                                       (break)))
                                (Ok [ee] (al-push! (mut out) ee))))))
                      (match (synth a ep (primitive/cast (ptr Type) 0) env cx tps fnm)
                        (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                        (Ok [rv] (let [r (alloc/stack EvalPair)] (primitive/store! r rv) (al-push! (mut out) (primitive/load (primitive/field r e))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok (box-al [Expr] a (primitive/load out))))))
(defn check-func [(a (ptr Allocator)) (cx (ptr Cx)) (fp (ptr Func))] (-> (Result Func Diag))
  (try (do
         (let [tps (primitive/load (primitive/field fp type_params))
               fnm (primitive/load (primitive/field fp name))]
           (primitive/store! (primitive/field cx cur_bounds) (primitive/load (primitive/load (primitive/field fp bounds))))
           (let [conv (conv-find cx (primitive/load (primitive/field fp cc)))]
             (if (primitive/icmp-eq (primitive/cast i64 conv) 0)
                 (return-from :try
                              (Err [Func Diag]
                                   (derr (sconcat3 a
                                                   (sconcat3 a "function '" fnm "': unknown convention '")
                                                   (primitive/load (primitive/field fp cc))
                                                   "'"))))
                 (when (conv-is-shim conv)
                       (when (conv-ret-none conv)
                             (break :try
                                    (Err [Func Diag]
                                         (derr (sconcat3 a
                                                         (sconcat3 a "function '" fnm "': shim convention '")
                                                         (primitive/load (primitive/field fp cc))
                                                         "' needs a :ret register")))))
                       (when (primitive/icmp-lt (conv-params-len conv) (al-len [Param] (primitive/load (primitive/load (primitive/field fp params)))))
                             (break :try
                                    (Err [Func Diag]
                                         (derr (sconcat a
                                                        (sconcat a
                                                                 (sconcat a
                                                                          (sconcat a
                                                                                   (sconcat3 a
                                                                                             "function '"
                                                                                             fnm
                                                                                             "': convention '")
                                                                                   (sconcat a
                                                                                            (primitive/load (primitive/field fp cc))
                                                                                            "' provides "))
                                                                          (i64->str a (conv-params-len conv)))
                                                                 (sconcat a
                                                                          " param registers but the function has "
                                                                          (i64->str a
                                                                                    (al-len [Param]
                                                                                            (primitive/load (primitive/load (primitive/field fp
                                                                                                               params)))))))
                                                        " parameters"))))))))
           (try! (validate-params a cx (primitive/load (primitive/field fp params)) tps fnm))
           (unless (type-is-void (primitive/field fp ret))
                   (match (validate-type (primitive/field fp ret) cx tps)
                     (Err [d]
                          (return-from :try
                                       (Err [Func Diag] (prefix-diag a d (sconcat3 a "function '" fnm "' return type: ")))))
                     (Ok [_] 0)))
           (let [env (build-param-env a cx (primitive/load (primitive/field fp params)) tps)
                 body (primitive/load (primitive/field fp body))
                 bn (al-len [Expr] (primitive/load body))]
             (when (and (primitive/icmp-eq bn 0)
                        (and (not (type-eq (primitive/field fp ret) (box-type a (TInt 64 true))))
                             (not (type-is-void (primitive/field fp ret)))))
                   (break :try
                          (Err [Func Diag]
                               (derr (sconcat a
                                              (sconcat3 a
                                                        "function '"
                                                        fnm
                                                        "': body has type i64 but the declared return type is ")
                                              (ty-str a (primitive/field fp ret)))))))
             (let [out-body (try! (check-body a cx fp env (assoc-body-tps a cx (primitive/load (primitive/field fp bounds)) tps) fnm))
                   outf (alloc/stack Func)]
               (primitive/store! (primitive/field outf name) fnm)
               (primitive/store! (primitive/field outf type_params) tps)
               (primitive/store! (primitive/field outf bounds) (primitive/load (primitive/field fp bounds)))
               (primitive/store! (primitive/field outf cc) (primitive/load (primitive/field fp cc)))
               (primitive/store! (primitive/field outf params) (erase-param-types a cx (primitive/load (primitive/field fp params)) tps))
               (primitive/store! (primitive/field outf ret) (erase-refs a (primitive/field fp ret)))
               (primitive/store! (primitive/field outf body) out-body)
               (primitive/store! (primitive/field outf macro_variadic) (primitive/load (primitive/field fp macro_variadic)))
               (primitive/store! (primitive/field outf lo) (primitive/load (primitive/field fp lo)))
               (primitive/store! (primitive/field outf hi) (primitive/load (primitive/field fp hi)))
               (primitive/store! (primitive/field outf source) (primitive/load (primitive/field fp source)))
               (primitive/store! (primitive/field outf ctxt) (primitive/load (primitive/field fp ctxt)))
               (Ok (primitive/load outf))))))))

; ============================ synth helpers =======================
(defstruct SynPair [(e (ptr Expr)) (t (ptr Type))])
(defstruct SubstEntry [(name (slice u8)) (ty Type)])
(defstruct ArgSlot [(present bool) (e (ptr Expr)) (t (ptr Type))])
(defstruct Deferred [(idx i64) (err Diag)])
(defstruct SumVars [(found bool) (name (slice u8)) (variants (ptr (ArrayList Variant)))])
(defstruct TargsOpt [(found bool) (targs (ptr (ArrayList Type)))])
(defstruct Branch [(e (ptr Expr)) (t (ptr Type))])

(defn sconcat1 [(a (ptr Allocator)) (x (slice u8))] (-> (slice u8))
  x)
(defn sconcat4 [(a (ptr Allocator)) (w (slice u8)) (x (slice u8)) (y (slice u8)) (z (slice u8))] (-> (slice u8))
  (sconcat a (sconcat3 a w x y) z))
(defn sconcat5 [(a (ptr Allocator)) (v (slice u8)) (w (slice u8)) (x (slice u8)) (y (slice u8)) (z (slice u8))] (-> (slice u8))
  (sconcat a (sconcat4 a v w x y) z))
(defn mk-synpair [(a (ptr Allocator)) (e (ptr Expr)) (t (ptr Type))] (-> SynPair)
  (let [p (alloc/stack SynPair)] (primitive/store! (primitive/field p e) e) (primitive/store! (primitive/field p t) t) (primitive/load p)))
(defn ok-ep [(e Expr) (t Type)] (-> (Result EvalPair Diag))
  (Ok [EvalPair Diag] (mk-evalpair e t)))
(defn err-ep [(d Diag)] (-> (Result EvalPair Diag))
  (Err [EvalPair Diag] d))

(defn do-synth [(a (ptr Allocator))
                (e (ptr Expr))
                (expected (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))] (-> (Result SynPair Diag))
  (match (synth a e expected env cx tps fname)
    (Err [d] (Err [SynPair Diag] d))
    (Ok [rv]
        (let [r (alloc/stack EvalPair)]
          (primitive/store! r rv)
          ; S2: record this expression's inferred type, keyed by its NODE ID, so a
          ; metaprogram can ask `(primitive/type-of NODE)` for any expression's exact type.
          (type-map-record (primitive/load (primitive/field e nid)) (primitive/load (primitive/field r t)))
          ; The checked output node inherits the INPUT node's id (never dumped, so
          ; oracles are unaffected): metalower reads the type map through the
          ; checked AST, and without this every rebuilt node would be nid -1.
          (primitive/store! (primitive/field (primitive/field r e) nid) (primitive/load (primitive/field e nid)))
          ; S1: record a reference's RESOLVED entity (qualified name) by node id, so
          ; `(primitive/code-decl NODE)` answers with the exact function/variant/etc. it picked.
          (match-else (primitive/load (primitive/field e kind))
                      (ECall [func targs args] (res-map-record (primitive/load (primitive/field e nid)) func))
                      (EFnPtrOf [name] (res-map-record (primitive/load (primitive/field e nid)) name))
                      ; S3: record which LOCAL binding a reference resolves to, so
                      ; `(primitive/binding-of NODE)` distinguishes shadowed locals for a borrow checker.
                      (EVar [name] (bind-map-record (primitive/load (primitive/field e nid)) (env-get-bid env name)))
                      (_ 0))
          (Ok (mk-synpair a (box-expr a (primitive/load (primitive/field r e))) (box-type a (primitive/load (primitive/field r t)))))))))

(defn expected-some? [(expected (ptr Type))] (-> bool)
  (primitive/icmp-ne (primitive/cast i64 expected) 0))
(defn null-type [] (-> (ptr Type))
  (primitive/cast (ptr Type) 0))

; ---- env --------------------------------------------------------------------
(defn env-get [(env (ptr (ArrayList EnvEntry))) (name (slice u8))] (-> (ptr Type))
  (let [n (al-len [EnvEntry] (primitive/load env))
        (mut i) (primitive/isub n 1)
        (mut r) (primitive/cast (ptr Type) 0)]
    (loop (if (primitive/icmp-lt (primitive/load i) 0)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [EnvEntry] env (primitive/load i)) name)) name)
                      (primitive/store! r (primitive/field (al-elem [EnvEntry] env (primitive/load i)) ty))
                      (break))
                (primitive/store! i (primitive/isub (primitive/load i) 1)))))
    (primitive/load r)))
(defn env-insert! [(env (ptr (ArrayList EnvEntry))) (name (slice u8)) (ty (ptr Type))] (-> i64)
  (let [ee (alloc/stack EnvEntry)]
    (primitive/store! (primitive/field ee name) name)
    (primitive/store! (primitive/field ee ty) (primitive/load ty))
    (primitive/store! (primitive/field ee bid) (next-bid))
    (al-push! [EnvEntry] env (primitive/load ee))))
; the binding id a name resolves to in the current env (0 = not a local)
(defn env-get-bid [(env (ptr (ArrayList EnvEntry))) (name (slice u8))] (-> i64)
  (let [n (al-len [EnvEntry] (primitive/load env))
        (mut i) (primitive/isub n 1)
        (mut r) 0]
    (loop (if (primitive/icmp-lt (primitive/load i) 0)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [EnvEntry] env (primitive/load i)) name)) name)
                      (primitive/store! r (primitive/load (primitive/field (al-elem [EnvEntry] env (primitive/load i)) bid)))
                      (break))
                (primitive/store! i (primitive/isub (primitive/load i) 1)))))
    (primitive/load r)))
(defn env-truncate! [(env (ptr (ArrayList EnvEntry))) (newlen i64)] (-> i64)
  (primitive/store! (primitive/field env len) newlen)
  0)

; ---- substitution map -------------------------------------------------------
(defn subst-new [(a (ptr Allocator))] (-> (ptr (ArrayList SubstEntry)))
  (box-al [SubstEntry] a (al-new [SubstEntry] a)))
(defn subst-get [(s (ptr (ArrayList SubstEntry))) (name (slice u8))] (-> (ptr Type))
  (let [n (al-len [SubstEntry] (primitive/load s))
        (mut i) 0
        (mut r) (primitive/cast (ptr Type) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [SubstEntry] s (primitive/load i)) name)) name)
                      (primitive/store! r (primitive/field (al-elem [SubstEntry] s (primitive/load i)) ty))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn subst-has [(s (ptr (ArrayList SubstEntry))) (name (slice u8))] (-> bool)
  (primitive/icmp-ne (primitive/cast i64 (subst-get s name)) 0))
(defn subst-insert! [(s (ptr (ArrayList SubstEntry))) (name (slice u8)) (ty (ptr Type))] (-> i64)
  (let [se (alloc/stack SubstEntry)]
    (primitive/store! (primitive/field se name) name)
    (primitive/store! (primitive/field se ty) (primitive/load ty))
    (al-push! [SubstEntry] s (primitive/load se))))

; ---- pure type helpers ------------------------------------------------------
(defn after-last-dot [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] s)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (primitive/icmp-lt (primitive/load i) 0)
              (break)
              (do
                (when (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/load i))) 46) (primitive/store! at (primitive/load i)) (break))
                (primitive/store! i (primitive/isub (primitive/load i) 1)))))
    (if (primitive/icmp-lt (primitive/load at) 0) s (subslice [u8] s (primitive/iadd (primitive/load at) 1) n))))
(defn is-struct-or-app [(t (ptr Type))] (-> bool)
  (let [tg (type-tag t)] (or (primitive/icmp-eq tg 6) (primitive/icmp-eq tg 11))))
(defn struct-name [(t (ptr Type))] (-> (slice u8))
  (let [tg (type-tag t)] (if (primitive/icmp-eq tg 6) (type-struct-name t) (if (primitive/icmp-eq tg 11) (t-app-name t) ""))))
(defn place-pointee [(t (ptr Type))] (-> (ptr Type))
  (let [tg (type-tag t)] (if (or (primitive/icmp-eq tg 4) (primitive/icmp-eq tg 5)) (t-inner t) (primitive/cast (ptr Type) 0))))
(defn is-writable [(t (ptr Type))] (-> bool)
  (let [tg (type-tag t)] (or (primitive/icmp-eq tg 4) (and (primitive/icmp-eq tg 5) (t-ref-mut t)))))
(defn replace-pointee [(a (ptr Allocator)) (place (ptr Type)) (new (ptr Type))] (-> Type)
  (if (primitive/icmp-eq (type-tag place) 5) (TRef (t-ref-mut place) (box-type a (primitive/load new))) (TPtr (box-type a (primitive/load new)))))
(defn is-place-value-type [(t (ptr Type)) (cx (ptr Cx))] (-> bool)
  (let [tg (type-tag t)]
    (cond (primitive/icmp-eq tg 6) (primitive/icmp-ne (primitive/cast i64 (struct-find cx (type-struct-name t))) 0)
          (primitive/icmp-eq tg 11) (primitive/icmp-ne (primitive/cast i64 (struct-find cx (t-app-name t))) 0)
          (primitive/icmp-eq tg 7) true
          :else false)))
; The dispatch key. There is exactly ONE definition of it — `parser.coil::impl-base-name`
; — and check/mono both delegate here. This used to be three hand-synced copies (here,
; the parser, and `mono.coil::mono-impl-name`); adding pointers to two of the three
; shipped a compiler that type-checked `(!= p q)` and then died in mono. One key, one
; place. "" = the type can't carry an impl.
(defn type-impl-name [(a (ptr Allocator)) (t (ptr Type))] (-> (slice u8))
  (impl-base-name a t))
(defn has-impl-name [(a (ptr Allocator)) (t (ptr Type))] (-> bool)
  (primitive/icmp-ne (slice-len (impl-base-name a t)) 0))

; ---- impl selection ---------------------------------------------------------
; The key (type-impl-name) names only the head constructor, so a key hit alone would
; answer "yes" for EVERY instantiation of it — `impl Len (Pair i64 i64)` would claim
; `(Pair u8 bool)`, and the mismatch would only surface later as a confusing
; argument-type error rather than "does not implement Len". So the key merely narrows
; the candidates; selection then matches the receiver against each candidate's own
; self_type pattern, binding that impl's type params (unify-trait-extras).

; Does pattern `pt` (with variables `pp`) match the type `t`? One-way: only `pp`'s
; names bind. Used both to test a receiver and to compare two impls' generality.
(defn pat-matches? [(a (ptr Allocator)) (pt (ptr Type)) (pp (ptr (ArrayList (slice u8)))) (t (ptr Type))] (-> bool)
  (unify-trait-extras a pt t pp (subst-new a)))
; Is `x` at least as specific as `y`? Exactly: y's pattern matches x's self_type, so
; every type x accepts, y accepts too. `(Pair i64 i64)` <= `(Pair A B)` because
; `(Pair A B)` matches `(Pair i64 i64)` but not conversely. `(Pair A A)` <= `(Pair A B)`
; for the same reason (A binds twice, and the second binding must agree).
(defn impl-le? [(a (ptr Allocator)) (x (ptr ImplDef)) (y (ptr ImplDef))] (-> bool)
  (pat-matches? a (primitive/field y self_type) (primitive/load (primitive/field y type_params)) (primitive/field x self_type)))

; The impls of `tr` whose pattern accepts `recv`, reduced to the single most specific
; one. `ambiguous` = two candidates matched and neither is more specific than the other
; (e.g. `(Pair i64 B)` and `(Pair A bool)` at `(Pair i64 bool)`), which is reported at
; the use site rather than forbidden at definition — disjoint or ordered impls are fine,
; only an actually-instantiated overlap is an error.
(defstruct ImplSel [(ip (ptr ImplDef)) (ambiguous bool)])
; Does candidate `ip` of `tr` accept `recv`? (`key` narrows by head constructor first)
(defn impl-cand? [(a (ptr Allocator)) (tr (slice u8)) (key (slice u8)) (recv (ptr Type)) (ip (ptr ImplDef))] (-> bool)
  (and (and (and (impl-is-trait ip) (str-eq (impl-trait-name ip) tr)) (str-eq (primitive/load (primitive/field ip for_type)) key))
       (pat-matches? a (primitive/field ip self_type) (primitive/load (primitive/field ip type_params)) recv)))
; Takes an impl list plus its precomputed candidate bucket, so check and mono share
; one specificity algorithm without either phase scanning unrelated impls.
(defn impl-select-indexed [(a (ptr Allocator))
                           (impls (ptr (ArrayList ImplDef)))
                           (bucket (ptr ImplBucket))
                           (tr (slice u8))
                           (recv (ptr Type))] (-> ImplSel)
  (let [r (alloc/stack ImplSel)]
    (primitive/store! (primitive/field r ip) (primitive/cast (ptr ImplDef) 0))
    (primitive/store! (primitive/field r ambiguous) false)
    (if (not (has-impl-name a recv))
        (primitive/load r)
        (let [key (type-impl-name a recv)
              n (if (primitive/icmp-eq (primitive/cast i64 bucket) 0)
                    0
                    (al-len [i64] (primitive/load (primitive/field bucket items))))]
          ; pass 1 — greedy minimum under the specificity order
          (let [(mut i) 0]
            (loop (if (primitive/icmp-ge (primitive/load i) n)
                      (break)
                      (do
                        (let [ip (al-elem [ImplDef]
                                          impls
                                          (al-get [i64] (primitive/load (primitive/field bucket items)) (primitive/load i)))]
                          (when (impl-cand? a tr key recv ip)
                                (let [best (primitive/load (primitive/field r ip))]
                                  (when (or (primitive/icmp-eq (primitive/cast i64 best) 0) (impl-le? a ip best)) (primitive/store! (primitive/field r ip) ip) 0))))
                        (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
          ; pass 2 — the winner must be at least as specific as EVERY candidate, not just
          ; the ones it happened to be compared against. A single greedy scan would let
          ; `(Pair i64 B)` and `(Pair A bool)` at `(Pair i64 bool)` silently pick whichever
          ; came last instead of reporting the overlap.
          (let [best (primitive/load (primitive/field r ip))
                (mut j) 0]
            (unless (primitive/icmp-eq (primitive/cast i64 best) 0)
                    (loop (if (primitive/icmp-ge (primitive/load j) n)
                              (break)
                              (do
                                (let [ip (al-elem [ImplDef]
                                                  impls
                                                  (al-get [i64] (primitive/load (primitive/field bucket items)) (primitive/load j)))]
                                  (when (impl-cand? a tr key recv ip)
                                        (unless (impl-le? a best ip) (primitive/store! (primitive/field r ambiguous) true) (break))))
                                (primitive/store! j (primitive/iadd (primitive/load j) 1)))))))
          (primitive/load r)))))

(defn inherent-owner-matches? [(owner (slice u8)) (qual (slice u8))] (-> bool)
  (or (primitive/icmp-eq (slice-len qual) 0)
      (or (str-eq owner qual) (str-eq (after-last-dot owner) qual))))
(defn inherent-cand? [(a (ptr Allocator))
                      (name (slice u8))
                      (qual (slice u8))
                      (key (slice u8))
                      (recv (ptr Type))
                      (ip (ptr ImplDef))] (-> bool)
  (if (or (impl-is-trait ip)
          (or (not (str-eq (primitive/load (primitive/field ip for_type)) key))
              (not (inherent-owner-matches? (primitive/load (primitive/field ip for_type)) qual))))
      false
      (let [m (impl-find-method ip name)]
        (and (primitive/icmp-ne (primitive/cast i64 m) 0)
             (and (inherent-receiver? a ip m)
                  (pat-matches? a (primitive/field ip self_type) (primitive/load (primitive/field ip type_params)) recv))))))

; Receiver-method selection is the trait specialization order restricted to
; inherent impls that actually define `name`. A generic `(impl [T] (Box T) …)`
; and a concrete `(impl (Box i64) …)` may coexist; the concrete method wins for
; Box<i64>, while unordered overlaps are diagnosed at the call site.
(defn inherent-select [(a (ptr Allocator))
                       (cx (ptr Cx))
                       (name (slice u8))
                       (qual (slice u8))
                       (recv (ptr Type))] (-> ImplSel)
  (let [r (alloc/stack ImplSel)]
    (primitive/store! (primitive/field r ip) (primitive/cast (ptr ImplDef) 0))
    (primitive/store! (primitive/field r ambiguous) false)
    (if (not (has-impl-name a recv))
        (primitive/load r)
        (let [key (type-impl-name a recv)
              bucket (impl-index-get (primitive/field cx inherent_impl_idx) (impl-index-key a name key))
              n (if (primitive/icmp-eq (primitive/cast i64 bucket) 0)
                    0
                    (al-len [i64] (primitive/load (primitive/field bucket items))))
              (mut i) 0]
          (loop (if (primitive/icmp-ge (primitive/load i) n)
                    (break)
                    (do
                      (let [ip (al-elem [ImplDef]
                                        (primitive/field cx impls)
                                        (al-get [i64] (primitive/load (primitive/field bucket items)) (primitive/load i)))]
                        (when (inherent-cand? a name qual key recv ip)
                              (let [best (primitive/load (primitive/field r ip))]
                                (when (or (primitive/icmp-eq (primitive/cast i64 best) 0) (impl-le? a ip best))
                                      (primitive/store! (primitive/field r ip) ip)
                                      0))))
                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
          (let [best (primitive/load (primitive/field r ip))
                (mut j) 0]
            (unless (primitive/icmp-eq (primitive/cast i64 best) 0)
                    (loop (if (primitive/icmp-ge (primitive/load j) n)
                              (break)
                              (do
                                (let [ip (al-elem [ImplDef]
                                                  (primitive/field cx impls)
                                                  (al-get [i64] (primitive/load (primitive/field bucket items)) (primitive/load j)))]
                                  (when (inherent-cand? a name qual key recv ip)
                                        (unless (impl-le? a best ip)
                                                (primitive/store! (primitive/field r ambiguous) true)
                                                (break))))
                                (primitive/store! j (primitive/iadd (primitive/load j) 1)))))))
          (primitive/load r)))))

; Like trait autoderef, try the receiver's own type before peeling. This matters
; now that structural types can carry extension methods: an impl on `(ptr T)` must
; win over a method on T when the argument itself is a pointer.
(defn inherent-select-deref [(a (ptr Allocator))
                             (cx (ptr Cx))
                             (name (slice u8))
                             (qual (slice u8))
                             (recv0 (ptr Type))] (-> ImplSel)
  (let [out (alloc/stack ImplSel)
        (mut recv) recv0
        (mut done) false]
    (primitive/store! (primitive/field out ip) (primitive/cast (ptr ImplDef) 0))
    (primitive/store! (primitive/field out ambiguous) false)
    (loop (if (primitive/load done)
              (break)
              (let [one (alloc/stack ImplSel)]
                (primitive/store! one (inherent-select a cx name qual (primitive/load recv)))
                (if (or (primitive/load (primitive/field one ambiguous))
                        (primitive/icmp-ne (primitive/cast i64 (primitive/load (primitive/field one ip))) 0))
                    (do (primitive/store! out (primitive/load one)) (primitive/store! done true) 0)
                    (let [tg (type-tag (primitive/load recv))]
                      (if (or (primitive/icmp-eq tg 4) (primitive/icmp-eq tg 5))
                          (primitive/store! recv (t-inner (primitive/load recv)))
                          (primitive/store! done true)))))))
    (primitive/load out)))

; Associated functions have no receiver from which to choose a specialization.
; Setup rejects duplicate owner/name definitions, so more than one match here can
; only be a short-name ambiguity between modules and is reported as such.
(defn inherent-associated-select [(a (ptr Allocator))
                                  (cx (ptr Cx))
                                  (name (slice u8))
                                  (qual (slice u8))] (-> ImplSel)
  (let [r (alloc/stack ImplSel)
        bucket (impl-index-get (primitive/field cx inherent_name_idx) name)
        n (if (primitive/icmp-eq (primitive/cast i64 bucket) 0)
              0
              (al-len [i64] (primitive/load (primitive/field bucket items))))
        (mut i) 0]
    (primitive/store! (primitive/field r ip) (primitive/cast (ptr ImplDef) 0))
    (primitive/store! (primitive/field r ambiguous) false)
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ip (al-elem [ImplDef]
                                  (primitive/field cx impls)
                                  (al-get [i64] (primitive/load (primitive/field bucket items)) (primitive/load i)))]
                  (when (and (impl-is-inherent ip)
                             (inherent-owner-matches? (primitive/load (primitive/field ip for_type)) qual))
                        (let [m (impl-find-method ip name)]
                          (when (and (primitive/icmp-ne (primitive/cast i64 m) 0) (not (inherent-receiver? a ip m)))
                                (if (primitive/icmp-eq (primitive/cast i64 (primitive/load (primitive/field r ip))) 0)
                                    (primitive/store! (primitive/field r ip) ip)
                                    (primitive/store! (primitive/field r ambiguous) true))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

(defn inherent-has-name [(cx (ptr Cx)) (name (slice u8))] (-> bool)
  (primitive/icmp-ne (primitive/cast i64 (impl-index-get (primitive/field cx inherent_name_idx) name)) 0))
(defn cx-impl-select [(a (ptr Allocator)) (cx (ptr Cx)) (tr (slice u8)) (recv (ptr Type))] (-> ImplSel)
  (let [key (type-impl-name a recv)]
    (impl-select-indexed a
                         (primitive/field cx impls)
                         (impl-index-get (primitive/field cx trait_impl_idx) (impl-index-key a tr key))
                         tr
                         recv)))
(defn impl-match [(a (ptr Allocator)) (cx (ptr Cx)) (tr (slice u8)) (recv (ptr Type))] (-> bool)
  (let [s (alloc/stack ImplSel)]
    (primitive/store! s (cx-impl-select a cx tr recv))
    (primitive/icmp-ne (primitive/cast i64 (primitive/load (primitive/field s ip))) 0)))

; Is an impl of `tr` with this exact pattern already registered? Two patterns are the
; same iff each matches the other (`(Pair A B)` and `(Pair X Y)` are the same impl
; modulo renaming, and must still collide).
(defn impl-dup? [(a (ptr Allocator))
                 (cx (ptr Cx))
                 (tr (slice u8))
                 (st (ptr Type))
                 (params (ptr (ArrayList (slice u8))))] (-> bool)
  (let [forty (type-impl-name a st)
        bucket (impl-index-get (primitive/field cx trait_impl_idx) (impl-index-key a tr forty))
        n (if (primitive/icmp-eq (primitive/cast i64 bucket) 0) 0 (al-len [i64] (primitive/load (primitive/field bucket items))))
        (mut i) 0
        (mut f) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ip (al-elem [ImplDef]
                                  (primitive/field cx impls)
                                  (al-get [i64] (primitive/load (primitive/field bucket items)) (primitive/load i)))]
                  (when (and (pat-matches? a (primitive/field ip self_type) (primitive/load (primitive/field ip type_params)) st)
                             (pat-matches? a st params (primitive/field ip self_type)))
                        (primitive/store! f true)
                        (break)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load f)))

(defn subst-apply-list [(a (ptr Allocator)) (v (ptr (ArrayList Type))) (subst (ptr (ArrayList SubstEntry)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Type] (primitive/load v))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (subst-apply a (al-elem [Type] v (primitive/load i)) subst))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))
(defn subst-apply [(a (ptr Allocator)) (t (ptr Type)) (subst (ptr (ArrayList SubstEntry)))] (-> Type)
  (match-else (primitive/load t)
              (TPtr [p] (TPtr (box-type a (subst-apply a p subst))))
              (TRef [m p] (TRef m (box-type a (subst-apply a p subst))))
              (TArray [e k] (TArray (box-type a (subst-apply a e subst)) k))
              (TSlice [e] (TSlice (box-type a (subst-apply a e subst))))
              (TVec [e k] (TVec (box-type a (subst-apply a e subst)) k))
              (TStruct [n] (let [r (subst-get subst n)] (if (primitive/icmp-eq (primitive/cast i64 r) 0) (TStruct n) (primitive/load r))))
              (TApp [n args] (TApp n (subst-apply-list a args subst)))
              (TFn [cc ps r] (TFn cc (subst-apply-list a ps subst) (box-type a (subst-apply a r subst))))
              (_ (primitive/load t))))

(defn fields-subst [(a (ptr Allocator)) (si (ptr StructInfo)) (args (ptr (ArrayList Type)))] (-> (ptr (ArrayList Field)))
  (let [subst (subst-new a)
        tparams (primitive/load (primitive/field si type_params))
        np (al-len [(slice u8)] (primitive/load tparams))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) np)
              (break)
              (do
                (subst-insert! subst (al-get [(slice u8)] (primitive/load tparams) (primitive/load i)) (al-elem [Type] args (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (let [fs (primitive/load (primitive/field si fields))
          nf (al-len [Field] (primitive/load fs))
          (mut out) (al-new [Field] a)
          (mut j) 0]
      (loop (if (primitive/icmp-ge (primitive/load j) nf)
                (break)
                (do
                  (let [fp (al-elem [Field] fs (primitive/load j))
                        nf2 (alloc/stack Field)]
                    (primitive/store! (primitive/field nf2 name) (primitive/load (primitive/field fp name)))
                    (primitive/store! (primitive/field nf2 ty) (subst-apply a (primitive/field fp ty) subst))
                    (al-push! (mut out) (primitive/load nf2)))
                  (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
      (box-al [Field] a (primitive/load out)))))
(defn struct-fields [(a (ptr Allocator)) (t (ptr Type)) (cx (ptr Cx))] (-> (Result (ptr (ArrayList Field)) Diag))
  (let [tg (type-tag t)]
    (if (primitive/icmp-eq tg 6)
        (let [si (struct-find cx (type-struct-name t))]
          (if (primitive/icmp-eq (primitive/cast i64 si) 0)
              (Err [(ptr (ArrayList Field)) Diag] (derr (sconcat3 a "unknown struct '" (type-struct-name t) "'")))
              (Ok (primitive/load (primitive/field si fields)))))
        (if (primitive/icmp-eq tg 11)
            (let [si (struct-find cx (t-app-name t))]
              (if (primitive/icmp-eq (primitive/cast i64 si) 0)
                  (Err [(ptr (ArrayList Field)) Diag] (derr (sconcat3 a "unknown generic struct '" (t-app-name t) "'")))
                  (Ok (fields-subst a si (t-fn-params t)))))
            (Err [(ptr (ArrayList Field)) Diag] (derr (sconcat a "not a struct: " (ty-str a t))))))))

(defn mk-sumvars [(found bool) (name (slice u8)) (variants (ptr (ArrayList Variant)))] (-> SumVars)
  (let [p (alloc/stack SumVars)]
    (primitive/store! (primitive/field p found) found)
    (primitive/store! (primitive/field p name) name)
    (primitive/store! (primitive/field p variants) variants)
    (primitive/load p)))
(defn variants-subst [(a (ptr Allocator)) (si (ptr SumInfo)) (args (ptr (ArrayList Type)))] (-> (ptr (ArrayList Variant)))
  (let [subst (subst-new a)
        tparams (primitive/load (primitive/field si type_params))
        np (al-len [(slice u8)] (primitive/load tparams))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) np)
              (break)
              (do
                (subst-insert! subst (al-get [(slice u8)] (primitive/load tparams) (primitive/load i)) (al-elem [Type] args (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (let [vs (primitive/load (primitive/field si variants))
          nv (al-len [Variant] (primitive/load vs))
          (mut out) (al-new [Variant] a)
          (mut j) 0]
      (loop (if (primitive/icmp-ge (primitive/load j) nv)
                (break)
                (do
                  (let [vp (al-elem [Variant] vs (primitive/load j))
                        fs (primitive/load (primitive/field vp fields))
                        nf (al-len [Field] (primitive/load fs))
                        (mut fout) (al-new [Field] a)
                        (mut k) 0
                        nv2 (alloc/stack Variant)]
                    (loop (if (primitive/icmp-ge (primitive/load k) nf)
                              (break)
                              (do
                                (let [fp (al-elem [Field] fs (primitive/load k))
                                      nf2 (alloc/stack Field)]
                                  (primitive/store! (primitive/field nf2 name) (primitive/load (primitive/field fp name)))
                                  (primitive/store! (primitive/field nf2 ty) (subst-apply a (primitive/field fp ty) subst))
                                  (al-push! (mut fout) (primitive/load nf2)))
                                (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                    (primitive/store! (primitive/field nv2 name) (primitive/load (primitive/field vp name)))
                    (primitive/store! (primitive/field nv2 fields) (box-al [Field] a (primitive/load fout)))
                    (al-push! (mut out) (primitive/load nv2)))
                  (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
      (box-al [Variant] a (primitive/load out)))))
(defn sum-variants [(a (ptr Allocator)) (t (ptr Type)) (cx (ptr Cx))] (-> SumVars)
  (let [tg (type-tag t)]
    (if (primitive/icmp-eq tg 6)
        (let [si (sum-find cx (type-struct-name t))]
          (if (primitive/icmp-eq (primitive/cast i64 si) 0)
              (mk-sumvars false "" (primitive/cast (ptr (ArrayList Variant)) 0))
              (mk-sumvars true (type-struct-name t) (primitive/load (primitive/field si variants)))))
        (if (primitive/icmp-eq tg 11)
            (let [si (sum-find cx (t-app-name t))]
              (if (primitive/icmp-eq (primitive/cast i64 si) 0)
                  (mk-sumvars false "" (primitive/cast (ptr (ArrayList Variant)) 0))
                  (mk-sumvars true (t-app-name t) (variants-subst a si (t-fn-params t)))))
            (mk-sumvars false "" (primitive/cast (ptr (ArrayList Variant)) 0))))))

(defn expected-sum-targs [(a (ptr Allocator)) (expected (ptr Type)) (sumname (slice u8)) (arity i64)] (-> TargsOpt)
  (let [p (alloc/stack TargsOpt)
        tg (type-tag expected)]
    (primitive/store! (primitive/field p found) false)
    (primitive/store! (primitive/field p targs) (primitive/cast (ptr (ArrayList Type)) 0))
    (if (primitive/icmp-eq tg 11)
        (when (and (str-eq (t-app-name expected) sumname) (primitive/icmp-eq (al-len [Type] (primitive/load (t-fn-params expected))) arity))
              (primitive/store! (primitive/field p found) true)
              (primitive/store! (primitive/field p targs) (t-fn-params expected))
              0)
        (when (and (primitive/icmp-eq tg 6) (and (str-eq (type-struct-name expected) sumname) (primitive/icmp-eq arity 0)))
              (primitive/store! (primitive/field p found) true)
              (primitive/store! (primitive/field p targs) (box-items-type a))
              0))
    (primitive/load p)))

(defn mismatch-msg [(a (ptr Allocator)) (x (ptr Type)) (y (ptr Type)) (fname (slice u8)) (what (slice u8))] (-> Diag)
  (if (and (type-is-int x) (type-is-int y))
      (if (not (primitive/icmp-eq (t-int-bits x) (t-int-bits y)))
          (derr (sconcat a
                         (sconcat a
                                  (sconcat a (sconcat3 a "in '" fname "': ") (sconcat a what " on mixed widths ("))
                                  (i64->str a (t-int-bits x)))
                         (sconcat a " and " (sconcat a (i64->str a (t-int-bits y)) " bits)"))))
          (derr (sconcat a
                         (sconcat a
                                  (sconcat a (sconcat3 a "in '" fname "': ") (sconcat a what " on mixed signedness ("))
                                  (ty-str a x))
                         (sconcat a " and " (sconcat a (ty-str a y) ")")))))
      (derr (sconcat a
                     (sconcat a
                              (sconcat a (sconcat3 a "in '" fname "': ") (sconcat a what " on different types ("))
                              (ty-str a x))
                     (sconcat a " vs " (sconcat a (ty-str a y) ")"))))))

; unify_branches: fill `out` with coerced exprs, return target type.
(defn unify-branches [(a (ptr Allocator))
                      (branches (ptr (ArrayList Branch)))
                      (out (ptr (ArrayList Expr)))
                      (fname (slice u8))
                      (what (slice u8))] (-> (Result Type Diag))
  (let [n (al-len [Branch] (primitive/load branches))
        (mut i) 0
        (mut have) false
        (mut concrete) (primitive/cast (ptr Type) 0)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [bp (al-elem [Branch] branches (primitive/load i))
                      be (primitive/load (primitive/field bp e))
                      bt (primitive/load (primitive/field bp t))]
                  (when (and (not (is-literal be)) (not (type-is-never bt)))
                        (if (not (primitive/load have))
                            (do (primitive/store! have true) (primitive/store! concrete bt) 0)
                            (when (not (type-eq (primitive/load concrete) bt))
                                  (primitive/store! err (mismatch-msg a (primitive/load concrete) bt fname what))
                                  (primitive/store! failed true)
                                  (break)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed)
        (Err [Type Diag] (primitive/load err))
        (let [(mut target) (primitive/cast (ptr Type) 0)]
          (if (primitive/load have)
              (do (primitive/store! target (primitive/load concrete)) 0)
              (let [(mut j) 0
                    (mut done) false]
                (loop (if (or (primitive/load done) (primitive/icmp-ge (primitive/load j) n))
                          (break)
                          (do
                            (let [bp (al-elem [Branch] branches (primitive/load j))]
                              (when (not (type-is-never (primitive/load (primitive/field bp t))))
                                    (primitive/store! target (primitive/load (primitive/field bp t)))
                                    (primitive/store! done true)
                                    0))
                            (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                (when (not (primitive/load done)) (primitive/store! target (box-type a (TInt 64 true))) 0)))
          (let [(mut k) 0
                (mut err2) (primitive/zeroed Diag)
                (mut failed2) false]
            (loop (if (primitive/icmp-ge (primitive/load k) n)
                      (break)
                      (do
                        (let [bp (al-elem [Branch] branches (primitive/load k))
                              be (primitive/load (primitive/field bp e))
                              bt (primitive/load (primitive/field bp t))]
                          (if (or (type-eq bt (primitive/load target)) (type-is-never bt))
                              (al-push! [Expr] out (primitive/load be))
                              (if (and (same-number-kind bt (primitive/load target)) (is-literal be))
                                  (match (coerce-lit a (primitive/load be) (primitive/load target) fname)
                                    (Err [d] (do (primitive/store! err2 d) (primitive/store! failed2 true) (break)))
                                    (Ok [ce] (al-push! [Expr] out ce)))
                                  (do
                                    (primitive/store! err2 (mismatch-msg a bt (primitive/load target) fname what))
                                    (primitive/store! failed2 true)
                                    (break)))))
                        (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
            (if (primitive/load failed2) (Err [Type Diag] (primitive/load err2)) (Ok (primitive/load (primitive/load target)))))))))

; coerce_arg
; The offending argument's own span, so an argument-type error underlines the
; argument (`"hello"`) not the whole call. dwspan only fills an unset (lo<0)
; span, so once attached here the enclosing call's synth won't overwrite it.
(defn coerce-arg-inner [(a (ptr Allocator))
                        (is_mut_borrow bool)
                        (ae Expr)
                        (at (ptr Type))
                        (want (ptr Type))
                        (is_extern bool)
                        (fname (slice u8))
                        (what (slice u8))] (-> (Result Expr Diag))
  (let [aep (alloc/stack Expr)]
    (primitive/store! aep ae)
    (let [wtg (type-tag want)]
      (cond (primitive/icmp-eq wtg 5)
              (let [wp (t-inner want)
                    want_mut (t-ref-mut want)
                    ap (place-pointee at)]
                (cond (primitive/icmp-eq (primitive/cast i64 ap) 0)
                        (if want_mut
                            (Err [Expr Diag]
                                 (derr (sconcat a
                                                (sconcat a
                                                         (sconcat3 a "in '" fname "': ")
                                                         (sconcat a what " is a (mut "))
                                                (sconcat a
                                                         (ty-str a wp)
                                                         ") parameter; pass a mutable place as (mut …)"))))
                            (if (not (type-eq at wp))
                                (Err [Expr Diag]
                                     (derr (sconcat a
                                                    (sconcat a
                                                             (sconcat a
                                                                      (sconcat3 a "in '" fname "': ")
                                                                      (sconcat a what " expects a reference to "))
                                                             (ty-str a wp))
                                                    (sconcat a ", got " (ty-str a at)))))
                                (Ok (mk-expr (ESpillRef (box-expr a (primitive/load aep)))
                                             (primitive/load (primitive/field aep lo))
                                             (primitive/load (primitive/field aep hi))
                                             (primitive/load (primitive/field aep source))
                                             (primitive/load (primitive/field aep ctxt))))))
                      (not (type-eq ap wp))
                        (Err [Expr Diag]
                             (derr (sconcat a
                                            (sconcat a
                                                     (sconcat a
                                                              (sconcat3 a "in '" fname "': ")
                                                              (sconcat a what " has type "))
                                                     (ty-str a at))
                                            (sconcat a " but expected a reference to " (ty-str a wp)))))
                      want_mut
                        (let [explicitly_mut (or is_mut_borrow (type-is-ptr at))]
                          (if (not explicitly_mut)
                              (Err [Expr Diag]
                                   (derr (sconcat a
                                                  (sconcat a
                                                           (sconcat3 a "in '" fname "': ")
                                                           (sconcat a what " is a (mut "))
                                                  (sconcat a
                                                           (ty-str a wp)
                                                           ") parameter; pass a mutable place as (mut …)"))))
                              (if (not (is-writable at))
                                  (Err [Expr Diag]
                                       (derr (sconcat a
                                                      (sconcat3 a "in '" fname "': ")
                                                      (sconcat a what " cannot be mutably borrowed (it is immutable)"))))
                                  (Ok (primitive/load aep)))))
                      :else (Ok (primitive/load aep))))
            (primitive/icmp-eq wtg 6)
              (if (type-eq at want)
                  (Ok (primitive/load aep))
                  (if is_extern
                      (let [pp (place-pointee at)]
                        (if (and (primitive/icmp-ne (primitive/cast i64 pp) 0) (str-eq (struct-name pp) (type-struct-name want)))
                            (Ok (primitive/load aep))
                            (coerce a (primitive/load aep) at want is_extern fname what)))
                      (coerce a (primitive/load aep) at want is_extern fname what)))
            (primitive/icmp-eq wtg 4)
              (let [wp (t-inner want)
                    pp (place-pointee at)]
                (if (and (primitive/icmp-ne (primitive/cast i64 pp) 0) (and (type-eq pp wp) (is-writable at)))
                    (Ok (primitive/load aep))
                    (coerce a (primitive/load aep) at want is_extern fname what)))
            :else (coerce a (primitive/load aep) at want is_extern fname what)))))
(defn coerce-arg [(a (ptr Allocator))
                  (is_mut_borrow bool)
                  (ae Expr)
                  (at (ptr Type))
                  (want (ptr Type))
                  (is_extern bool)
                  (fname (slice u8))
                  (what (slice u8))] (-> (Result Expr Diag))
  (let [aep (alloc/stack Expr)]
    (primitive/store! aep ae)
    (match (coerce-arg-inner a is_mut_borrow ae at want is_extern fname what)
      (Ok [e] (Ok [Expr Diag] e))
      (Err [d]
           (Err [Expr Diag]
                (dwspan d (primitive/load (primitive/field aep source)) (primitive/load (primitive/field aep lo)) (primitive/load (primitive/field aep hi)) (primitive/load (primitive/field aep ctxt))))))))

(defn check-to [(a (ptr Allocator))
                (e (ptr Expr))
                (want (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))
                (what (slice u8))] (-> (Result Expr Diag))
  (match (do-synth a e want env cx tps fname)
    (Err [d] (Err [Expr Diag] d))
    (Ok [sp0]
        (let [sp (alloc/stack SynPair)]
          (primitive/store! sp sp0)
          (coerce a (primitive/load (primitive/load (primitive/field sp e))) (primitive/load (primitive/field sp t)) want false fname what)))))

; unify
(defn unify [(a (ptr Allocator))
             (decl (ptr Type))
             (actual (ptr Type))
             (tpset (ptr (ArrayList (slice u8))))
             (subst (ptr (ArrayList SubstEntry)))
             (fname (slice u8))] (-> (Result i64 Diag))
  (if (or (type-is-void decl) (type-is-void actual))
      (Err [i64 Diag]
           (derr (sconcat3 a
                           "in '"
                           fname
                           "': a void value cannot be used as a type argument (a (-> void) call yields nothing)")))
      (if (and (primitive/icmp-eq (type-tag decl) 6) (set-contains tpset (type-struct-name decl)))
          (let [p (type-struct-name decl)
                act (if (primitive/icmp-eq (type-tag actual) 5) (t-inner actual) actual)
                prev (subst-get subst p)]
            (if (primitive/icmp-ne (primitive/cast i64 prev) 0)
                (if (not (type-eq prev act))
                    (Err [i64 Diag]
                         (derr (sconcat a
                                        (sconcat a
                                                 (sconcat a
                                                          (sconcat4 a
                                                                    "in '"
                                                                    fname
                                                                    "': conflicting types for parameter '"
                                                                    (sconcat a p "' ("))
                                                          (ty-str a prev))
                                                 " vs ")
                                        (sconcat a (ty-str a act) ")"))))
                    (Ok [i64 Diag] 0))
                (do (subst-insert! subst p act) (Ok [i64 Diag] 0))))
          (let [dt (type-tag decl)
                at2 (type-tag actual)]
            (cond (and (primitive/icmp-eq dt 4) (primitive/icmp-eq at2 4)) (unify a (t-inner decl) (t-inner actual) tpset subst fname)
                  ; a (ptr T) argument satisfies a (mut T)/(ref T) parameter — see through
                  ; BOTH wrappers; a BARE type-parameter pointee keeps the
                  ; general Ref-arm reading below (T := the whole pointer)
                  (and (and (primitive/icmp-eq dt 5) (primitive/icmp-eq at2 4))
                       (not (and (primitive/icmp-eq (type-tag (t-inner decl)) 6)
                                 (set-contains tpset (type-struct-name (t-inner decl))))))
                    (unify a (t-inner decl) (t-inner actual) tpset subst fname)
                  (primitive/icmp-eq dt 5) (unify a (t-inner decl) actual tpset subst fname)
                  (primitive/icmp-eq at2 5) (unify a decl (t-inner actual) tpset subst fname)
                  (and (primitive/icmp-eq dt 7) (primitive/icmp-eq at2 7)) (unify a (t-inner decl) (t-inner actual) tpset subst fname)
                  ; TVec(9), same as the array arm above. Absent until structural impls made
                  ; `(impl [T] Trait (vec T N))` expressible: nothing had ever been generic over
                  ; a vector, so `(vec T 4)` vs `(vec i64 4)` fell through and T went unsolved.
                  (and (primitive/icmp-eq dt 9) (primitive/icmp-eq at2 9)) (unify a (t-inner decl) (t-inner actual) tpset subst fname)
                  (and (primitive/icmp-eq dt 8) (primitive/icmp-eq at2 8)) (unify a (t-inner decl) (t-inner actual) tpset subst fname)
                  (and (and (primitive/icmp-eq dt 11) (primitive/icmp-eq at2 11))
                       (and (str-eq (t-app-name decl) (t-app-name actual))
                            (primitive/icmp-eq (al-len [Type] (primitive/load (t-fn-params decl)))
                                     (al-len [Type] (primitive/load (t-fn-params actual))))))
                    (unify-list a (t-fn-params decl) (t-fn-params actual) tpset subst fname)
                  (and (and (primitive/icmp-eq dt 10) (primitive/icmp-eq at2 10))
                       (primitive/icmp-eq (al-len [Type] (primitive/load (t-fn-params decl)))
                                (al-len [Type] (primitive/load (t-fn-params actual)))))
                    (match (unify-list a
                                       (t-fn-params decl)
                                       (t-fn-params actual)
                                       tpset
                                       subst
                                       fname)
                      (Err [d] (Err [i64 Diag] d))
                      (Ok [_] (unify a (t-fn-ret decl) (t-fn-ret actual) tpset subst fname)))
                  :else (Ok [i64 Diag] 0))))))
(defn unify-list [(a (ptr Allocator))
                  (xs (ptr (ArrayList Type)))
                  (ys (ptr (ArrayList Type)))
                  (tpset (ptr (ArrayList (slice u8))))
                  (subst (ptr (ArrayList SubstEntry)))
                  (fname (slice u8))] (-> (Result i64 Diag))
  (let [n (al-len [Type] (primitive/load xs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (unify a (al-elem [Type] xs (primitive/load i)) (al-elem [Type] ys (primitive/load i)) tpset subst fname)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [i64 Diag] (primitive/load err)) (Ok [i64 Diag] 0))))

; solve_type_args
(defn solve-type-args [(a (ptr Allocator))
                       (type_params (ptr (ArrayList (slice u8))))
                       (declared (ptr (ArrayList Type)))
                       (type_args (ptr (ArrayList Type)))
                       (arglist (ptr (ArrayList ArgSlot)))
                       (ret_tmpl (ptr Type))
                       (expected (ptr Type))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))
                       (what (slice u8))] (-> (Result (ptr (ArrayList SubstEntry)) Diag))
  (let [subst (subst-new a)
        np (al-len [(slice u8)] (primitive/load type_params))]
    (if (primitive/icmp-gt (al-len [Type] (primitive/load type_args)) 0)
        (if (not (primitive/icmp-eq (al-len [Type] (primitive/load type_args)) np))
            (Err [(ptr (ArrayList SubstEntry)) Diag]
                 (derr (sconcat a
                                (sconcat a
                                         (sconcat a
                                                  (sconcat4 a "in '" fname "': '" (sconcat a what "' expects "))
                                                  (i64->str a np))
                                         " type arguments, got ")
                                (i64->str a (al-len [Type] (primitive/load type_args))))))
            (let [(mut i) 0
                  (mut err) (primitive/zeroed Diag)
                  (mut failed) false]
              (loop (if (primitive/icmp-ge (primitive/load i) np)
                        (break)
                        (do
                          (match (validate-type (al-elem [Type] type_args (primitive/load i)) cx tps)
                            (Err [d]
                                 (do
                                   (primitive/store! err (prefix-diag a d (sconcat3 a "in '" fname "': type argument: ")))
                                   (primitive/store! failed true)
                                   (break)))
                            (Ok [_] 0))
                          (subst-insert! subst
                                         (al-get [(slice u8)] (primitive/load type_params) (primitive/load i))
                                         (al-elem [Type] type_args (primitive/load i)))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
              (if (primitive/load failed) (Err [(ptr (ArrayList SubstEntry)) Diag] (primitive/load err)) (Ok subst))))
        (let [(mut err) (primitive/zeroed Diag)
              (mut failed) false]
          (when (expected-some? expected)
                (match (unify a ret_tmpl expected type_params subst fname)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) 0))
                  (Ok [_] 0)))
          (if (primitive/load failed)
              (Err [(ptr (ArrayList SubstEntry)) Diag] (primitive/load err))
              (let [nd (al-len [Type] (primitive/load declared))
                    (mut j) 0]
                (loop (if (primitive/icmp-ge (primitive/load j) nd)
                          (break)
                          (do
                            (let [slot (al-elem [ArgSlot] arglist (primitive/load j))]
                              (when (primitive/load (primitive/field slot present))
                                    (match (unify a
                                                  (al-elem [Type] declared (primitive/load j))
                                                  (primitive/load (primitive/field slot t))
                                                  type_params
                                                  subst
                                                  fname)
                                      (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                                      (Ok [_] 0))))
                            (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                (if (primitive/load failed)
                    (Err [(ptr (ArrayList SubstEntry)) Diag] (primitive/load err))
                    (let [(mut k) 0
                          (mut missing) false
                          (mut mp) ""]
                      (loop (if (primitive/icmp-ge (primitive/load k) np)
                                (break)
                                (do
                                  (let [pn (al-get [(slice u8)] (primitive/load type_params) (primitive/load k))]
                                    (when (not (subst-has subst pn)) (primitive/store! missing true) (primitive/store! mp pn) (break)))
                                  (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                      (if (primitive/load missing)
                          (Err [(ptr (ArrayList SubstEntry)) Diag]
                               (derr (sconcat a
                                              (sconcat a
                                                       (sconcat4 a
                                                                 "in '"
                                                                 fname
                                                                 "': cannot infer type argument '"
                                                                 (sconcat a (primitive/load mp) "' for '"))
                                                       (sconcat a what "'; provide it explicitly: ("))
                                              (sconcat a what " [<types>] ...)"))))
                          (Ok subst))))))))))

; bit_field_type
(defn bit-field-type [(a (ptr Allocator))
                      (ptr (ptr Expr))
                      (field (slice u8))
                      (env (ptr (ArrayList EnvEntry)))
                      (cx (ptr Cx))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))] (-> (Result SynPair Diag))
  (match (do-synth a ptr (null-type) env cx tps fname)
    (Err [d] (Err [SynPair Diag] d))
    (Ok [sp0]
        (let [sp (alloc/stack SynPair)]
          (primitive/store! sp sp0)
          (let [pt (primitive/load (primitive/field sp t))]
            (if (not (type-is-ptr pt))
                (Err [SynPair Diag]
                     (derr (sconcat a (sconcat3 a "in '" fname "': get/set! needs a pointer, got ") (ty-str a pt))))
                (let [pointee (t-inner pt)
                      s (struct-name pointee)
                      si (struct-find cx s)]
                  (if (and (is-struct-or-app pointee) (and (primitive/icmp-ne (primitive/cast i64 si) 0) (primitive/load (primitive/field si is_bits))))
                      (match (struct-fields a pointee cx)
                        (Err [_]
                             (Err [SynPair Diag]
                                  (derr (sconcat a
                                                 (sconcat a
                                                          (sconcat5 a
                                                                    "in '"
                                                                    fname
                                                                    "': bit struct '"
                                                                    s
                                                                    "' has no field '")
                                                          field)
                                                 "'"))))
                        (Ok [fs]
                            (let [n (al-len [Field] (primitive/load fs))
                                  (mut i) 0
                                  (mut fty) (primitive/cast (ptr Type) 0)]
                              (loop (if (primitive/icmp-ge (primitive/load i) n)
                                        (break)
                                        (do
                                          (when (str-eq (primitive/load (primitive/field (al-elem [Field] fs (primitive/load i)) name)) field)
                                                (primitive/store! fty (primitive/field (al-elem [Field] fs (primitive/load i)) ty))
                                                (break))
                                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                              (if (primitive/icmp-eq (primitive/cast i64 (primitive/load fty)) 0)
                                  (Err [SynPair Diag]
                                       (derr (sconcat a
                                                      (sconcat a
                                                               (sconcat5 a
                                                                         "in '"
                                                                         fname
                                                                         "': bit struct '"
                                                                         s
                                                                         "' has no field '")
                                                               field)
                                                      "'")))
                                  (Ok (mk-synpair a (primitive/load (primitive/field sp e)) (primitive/load fty)))))))
                      (Err [SynPair Diag]
                           (derr (sconcat a
                                          (sconcat a
                                                   (sconcat3 a
                                                             "in '"
                                                             fname
                                                             "': get/set! needs a pointer to a :layout bits struct, got (ptr ")
                                                   (ty-str a pointee))
                                          ")")))))))))))

; check_quasi
(defn check-quasi [(a (ptr Allocator))
                   (qp (ptr Quasi))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))] (-> (Result Quasi Diag))
  (match-else (primitive/load qp)
              (QLit [form] (Ok [Quasi Diag] (QLit form)))
              (QUnquote [e]
                        (match (do-synth a e (null-type) env cx tps fname)
                          (Err [d] (Err [Quasi Diag] d))
                          (Ok [sp0]
                              (let [sp (alloc/stack SynPair)] (primitive/store! sp sp0) (Ok (QUnquote (primitive/load (primitive/field sp e))))))))
              (QSplice [e]
                       (match (do-synth a e (null-type) env cx tps fname)
                         (Err [d] (Err [Quasi Diag] d))
                         (Ok [sp0] (let [sp (alloc/stack SynPair)] (primitive/store! sp sp0) (Ok (QSplice (primitive/load (primitive/field sp e))))))))
              (QList [items]
                     (match (check-quasi-list a items env cx tps fname)
                       (Err [d] (Err [Quasi Diag] d))
                       (Ok [nl] (Ok (QList nl)))))
              (QVector [items]
                       (match (check-quasi-list a items env cx tps fname)
                         (Err [d] (Err [Quasi Diag] d))
                         (Ok [nl] (Ok (QVector nl)))))
              (_ (Ok [Quasi Diag] (primitive/load qp)))))
(defn check-quasi-list [(a (ptr Allocator))
                        (items (ptr (ArrayList Quasi)))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))] (-> (Result (ptr (ArrayList Quasi)) Diag))
  (let [n (al-len [Quasi] (primitive/load items))
        (mut out) (al-new [Quasi] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (check-quasi a (al-elem [Quasi] items (primitive/load i)) env cx tps fname)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [q] (al-push! (mut out) q)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [(ptr (ArrayList Quasi)) Diag] (primitive/load err)) (Ok (box-al [Quasi] a (primitive/load out))))))

; ---- dyn / trait helpers ----------------------------------------------------
(defn dyn-struct-trait [(cx (ptr Cx)) (name (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] name)]
    (if (primitive/icmp-lt n 4)
        ""
        (let [base (subslice [u8] name 0 (primitive/isub n 4))
              suf (subslice [u8] name (primitive/isub n 4) n)]
          (if (and (str-eq suf "-dyn") (primitive/icmp-ne (primitive/cast i64 (trait-find cx base)) 0)) base "")))))
(defn is-dyn-target [(t (ptr Type)) (cx (ptr Cx))] (-> bool)
  (let [tg (type-tag t)]
    (if (primitive/icmp-eq tg 6)
        (primitive/icmp-gt (slice-len [u8] (dyn-struct-trait cx (type-struct-name t))) 0)
        (if (primitive/icmp-eq tg 5)
            (let [inner (t-inner t)]
              (if (primitive/icmp-eq (type-tag inner) 6)
                  (primitive/icmp-gt (slice-len [u8] (dyn-struct-trait cx (type-struct-name inner))) 0)
                  false))
            false))))
(defn resolve-trait-name [(cx (ptr Cx)) (name (slice u8))] (-> (slice u8))
  (if (primitive/icmp-ne (primitive/cast i64 (trait-find cx name)) 0)
      name
      (let [n (al-len [TraitDef] (primitive/load (primitive/field cx trait_defs)))
            (mut i) 0
            (mut found) ""
            (mut cnt) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) n)
                  (break)
                  (do
                    (let [k (primitive/load (primitive/field (al-elem [TraitDef] (primitive/field cx trait_defs) (primitive/load i)) name))]
                      (when (str-eq (after-last-dot k) name) (primitive/store! found k) (primitive/store! cnt (primitive/iadd (primitive/load cnt) 1))))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
        (if (primitive/icmp-eq (primitive/load cnt) 1) (primitive/load found) ""))))
(defn trait-visible [(cx (ptr Cx)) (tr (slice u8)) (caller (slice u8)) (has_caller bool)] (-> bool)
  (if (not (has-dot tr))
      true
      (let [tmod (subslice [u8] tr 0 (find-slash-dot tr))
            tname (after-last-dot tr)]
        (if (or (str-eq tmod "coil.core") (and has_caller (str-eq tmod caller)))
            true
            (if (not has_caller)
                false
                (let [imp (imports-find (primitive/load (primitive/field cx imports)) caller)]
                  (if (primitive/icmp-eq (primitive/cast i64 imp) 0)
                      false
                      (let [uses (primitive/field (primitive/field imp imp) uses)
                            nu (al-len [Use] (primitive/load (primitive/field (primitive/field imp imp) uses)))
                            (mut i) 0
                            (mut vis) false]
                        (loop (if (primitive/icmp-ge (primitive/load i) nu)
                                  (break)
                                  (do
                                    (let [up (al-elem [Use] uses (primitive/load i))]
                                      (when (str-eq (primitive/load (primitive/field up target)) tmod)
                                            (let [okspec
                                                    (match-else (primitive/load (primitive/field up spec))
                                                                (UAll [] true)
                                                                (UNames [ns] (set-contains ns tname))
                                                                (_ false))]
                                              (when (and okspec (exports-check (primitive/load (primitive/field cx exports)) tmod tname))
                                                    (primitive/store! vis true)
                                                    (break)))))
                                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                        (primitive/load vis)))))))))
(defn find-slash-dot [(s (slice u8))] (-> i64)
  (let [n (slice-len [u8] s)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (primitive/icmp-lt (primitive/load i) 0)
              (break)
              (do
                (when (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/load i))) 46) (primitive/store! at (primitive/load i)) (break))
                (primitive/store! i (primitive/isub (primitive/load i) 1)))))
    (primitive/load at)))

; The recoverable-collision hint (gen-6): every trait declaring `func`, rendered as
; the qualified call `Trait::func` (Trait by display-name), joined with " or ". So a
; same-name collision is now fixable — `(A::go x)` names the trait explicitly — and the
; error stops telling you to `:use` a module (useless when the traits are your own).
(defn method-qual-suggestions [(a (ptr Allocator)) (cx (ptr Cx)) (func (slice u8))] (-> (slice u8))
  (let [ms (primitive/field cx methods)
        n (al-len [MethodEntry] (primitive/load (primitive/field cx methods)))
        (mut i) 0
        (mut out) ""
        (mut first) true]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [me (al-elem [MethodEntry] ms (primitive/load i))]
                  (when (str-eq (primitive/load (primitive/field me name)) func)
                        (let [q (sconcat4 a "`" (display-name (primitive/load (primitive/field me trait))) "::" (sconcat a func "`"))]
                          (if (primitive/load first)
                              (do (primitive/store! out q) (primitive/store! first false) 0)
                              (do (primitive/store! out (sconcat3 a (primitive/load out) " or " q)) 0)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load out)))

; Qualified `Trait::method` resolution (gen-6): pin the method to the named trait,
; bypassing in-scope ambiguity and module visibility (an explicit trait name IS the
; disambiguation). `qual` matches a trait by its full name or its last-dotted
; component, so both `A::go` and `app.A::go` select `app.A`. An empty `qual` delegates
; to the ordinary in-scope resolution.
(defn resolve-method-qual [(a (ptr Allocator)) (cx (ptr Cx)) (func (slice u8)) (qual (slice u8)) (fname (slice u8))] (-> (Result MethodEntry
                                                                                                                                 Diag))
  (if (primitive/icmp-eq (slice-len [u8] qual) 0)
      (resolve-method a cx func fname)
      (let [ms (primitive/field cx methods)
            n (al-len [MethodEntry] (primitive/load (primitive/field cx methods)))
            (mut i) 0
            (mut cnt) 0
            (mut only) (primitive/cast (ptr MethodEntry) 0)]
        (loop (if (primitive/icmp-ge (primitive/load i) n)
                  (break)
                  (do
                    (let [me (al-elem [MethodEntry] ms (primitive/load i))]
                      (when (and (str-eq (primitive/load (primitive/field me name)) func)
                                 (or (str-eq (primitive/load (primitive/field me trait)) qual)
                                     (str-eq (after-last-dot (primitive/load (primitive/field me trait))) qual)))
                            (primitive/store! cnt (primitive/iadd (primitive/load cnt) 1))
                            (primitive/store! only me)
                            0))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
        (if (primitive/icmp-eq (primitive/load cnt) 1)
            (Ok (primitive/load (primitive/load only)))
            (if (primitive/icmp-eq (primitive/load cnt) 0)
                (Err [MethodEntry Diag]
                     (derr (sconcat a
                                    (sconcat5 a "in '" fname "': no trait '" qual "' declares method '")
                                    (sconcat a func "'"))))
                (let [head
                        (sconcat a
                                 (sconcat5 a "in '" fname "': qualifier '" qual "' is ambiguous — ")
                                 (i64->str a (primitive/load cnt)))]
                  (Err [MethodEntry Diag]
                       (derr (sconcat3 a
                                       head
                                       " traits named '"
                                       (sconcat a
                                                qual
                                                "' declare this method; qualify with the module-prefixed trait name"))))))))))

; resolve_method — returns a chosen MethodEntry.
(defn resolve-method [(a (ptr Allocator)) (cx (ptr Cx)) (func (slice u8)) (fname (slice u8))] (-> (Result MethodEntry
                                                                                                          Diag))
  (let [ms (primitive/field cx methods)
        n (al-len [MethodEntry] (primitive/load (primitive/field cx methods)))
        (mut i) 0
        (mut cnt) 0
        (mut only) (primitive/cast (ptr MethodEntry) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [MethodEntry] ms (primitive/load i)) name)) func)
                      (primitive/store! cnt (primitive/iadd (primitive/load cnt) 1))
                      (primitive/store! only (al-elem [MethodEntry] ms (primitive/load i)))
                      0)
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/icmp-eq (primitive/load cnt) 1)
        (Ok (primitive/load (primitive/load only)))
        (let [has_caller (has-dot fname)
              caller (if (has-dot fname) (subslice [u8] fname 0 (find-slash-dot fname)) "")
              (mut j) 0
              (mut vcnt) 0
              (mut vonly) (primitive/cast (ptr MethodEntry) 0)]
          (loop (if (primitive/icmp-ge (primitive/load j) n)
                    (break)
                    (do
                      (let [me (al-elem [MethodEntry] ms (primitive/load j))]
                        (when (and (str-eq (primitive/load (primitive/field me name)) func)
                                   (trait-visible cx (primitive/load (primitive/field me trait)) caller has_caller))
                              (primitive/store! vcnt (primitive/iadd (primitive/load vcnt) 1))
                              (primitive/store! vonly me)
                              0))
                      (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
          (if (primitive/icmp-eq (primitive/load vcnt) 1)
              (Ok (primitive/load (primitive/load vonly)))
              (if (primitive/icmp-eq (primitive/load vcnt) 0)
                  (Err [MethodEntry Diag]
                       (derr (sconcat a
                                      (sconcat a
                                               (sconcat a
                                                        (sconcat4 a
                                                                  "in '"
                                                                  fname
                                                                  "': trait method '"
                                                                  (sconcat a func "' is declared in "))
                                                        (i64->str a (primitive/load cnt)))
                                               " traits, none in scope here — call it qualified: ")
                                      (method-qual-suggestions a cx func))))
                  (Err [MethodEntry Diag]
                       (derr (sconcat a
                                      (sconcat a
                                               (sconcat a
                                                        (sconcat4 a
                                                                  "in '"
                                                                  fname
                                                                  "': trait method '"
                                                                  (sconcat a func "' is ambiguous — "))
                                                        (i64->str a (primitive/load vcnt)))
                                               " in-scope traits declare it; call it qualified: ")
                                      (method-qual-suggestions a cx func))))))))))

(defn bounds-has [(bounds (ptr (ArrayList Bound))) (tp (slice u8)) (tr (slice u8))] (-> bool)
  (let [n (al-len [Bound] (primitive/load bounds))
        (mut i) 0
        (mut r) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [bp (al-elem [Bound] bounds (primitive/load i))]
                  (when (str-eq (primitive/load (primitive/field bp name)) tp)
                        (let [trs (primitive/load (primitive/field bp traits))
                              m (al-len [(slice u8)] (primitive/load trs))
                              (mut k) 0]
                          (loop (if (primitive/icmp-ge (primitive/load k) m)
                                    (break)
                                    (do
                                      (when (str-eq (al-get [(slice u8)] (primitive/load trs) (primitive/load k)) tr) (primitive/store! r true) (break))
                                      (primitive/store! k (primitive/iadd (primitive/load k) 1))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

; build_make_dyn / dyn dispatch — not yet ported (hard error, never reached by
; non-dyn programs because maybe-coerce-dyn/is-dyn-target gate on a -dyn struct).
(defn dyn-method-names [(a (ptr Allocator)) (td (ptr TraitDef)) (tr (slice u8)) (tn (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [ms (primitive/load (primitive/field td methods))
        n (al-len [TraitMethod] (primitive/load ms))
        (mut out) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (tmfn a tr tn (primitive/load (primitive/field (al-elem [TraitMethod] ms (primitive/load i)) name))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [(slice u8)] a (primitive/load out))))
(defn build-make-dyn [(a (ptr Allocator))
                      (cx (ptr Cx))
                      (trait_name (slice u8))
                      (inner (ptr Expr))
                      (inner_ty (ptr Type))
                      (lo i64)
                      (hi i64)
                      (src i64)
                      (ctxt i64)
                      (fname (slice u8))] (-> (Result SynPair Diag))
  (let [tr (resolve-trait-name cx trait_name)]
    (if (primitive/icmp-eq (slice-len [u8] tr) 0)
        (Err [SynPair Diag]
             (derr-at-src src
                          lo
                          hi
                          (sconcat1 a
                                    (sconcat4 a "in '" fname "': make-dyn: unknown trait '" (sconcat a trait_name "'")))))
        (if (not (type-is-ptr inner_ty))
            (Err [SynPair Diag]
                 (derr-at-src src
                              lo
                              hi
                              (sconcat a
                                       (sconcat3 a "in '" fname "': make-dyn expects a pointer to an implementer, got ")
                                       (ty-str a inner_ty))))
            (let [pointee (t-inner inner_ty)]
              (if (not (has-impl-name a pointee))
                  (Err [SynPair Diag]
                       (derr-at-src src
                                    lo
                                    hi
                                    (sconcat a
                                             (sconcat a
                                                      (sconcat4 a "in '" fname "': make-dyn: " (ty-str a pointee))
                                                      " cannot implement a trait")
                                             "")))
                  ; the vtable must point at the SELECTED impl's functions — a specialized
                  ; impl on the pointee has a decorated name, so the bare key would name a
                  ; function that doesn't exist
                  (let [sel (alloc/stack ImplSel)]
                    (primitive/store! sel (cx-impl-select a cx tr pointee))
                    (if (primitive/icmp-eq (primitive/cast i64 (primitive/load (primitive/field sel ip))) 0)
                        (Err [SynPair Diag]
                             (derr-at-src src
                                          lo
                                          hi
                                          (sconcat a
                                                   (sconcat a
                                                            (sconcat a
                                                                     (sconcat5 a
                                                                               "in '"
                                                                               fname
                                                                               "': '"
                                                                               (ty-str a pointee)
                                                                               "' does not implement '")
                                                                     (display-name tr))
                                                            "' (needed for (dyn ")
                                                   (sconcat a (display-name tr) "))"))))
                        (if (primitive/load (primitive/field sel ambiguous))
                            (Err [SynPair Diag]
                                 (derr-at-src src
                                              lo
                                              hi
                                              (sconcat a
                                                       (sconcat a
                                                                (sconcat5 a
                                                                          "in '"
                                                                          fname
                                                                          "': ambiguous impls of '"
                                                                          (display-name tr)
                                                                          "' for '")
                                                                (ty-str a pointee))
                                                       "' — several match and none is more specific")))
                            (let [dyn_struct (sconcat a tr "-dyn")
                                  vtable_struct (sconcat a tr "-vtable")]
                              (if (primitive/icmp-eq (primitive/cast i64 (struct-find cx dyn_struct)) 0)
                                  (Err [SynPair Diag]
                                       (derr-at-src src
                                                    lo
                                                    hi
                                                    (sconcat a
                                                             (sconcat a
                                                                      (sconcat5 a
                                                                                "in '"
                                                                                fname
                                                                                "': trait '"
                                                                                (display-name tr)
                                                                                "' has no trait object — call (defdyn ")
                                                                      (display-name tr))
                                                             ") after the trait")))
                                  (let [ipp (primitive/load (primitive/field sel ip))]
                                    ; A GENERIC impl's methods are generic functions: the vtable would
                                    ; have to reference a per-instantiation mangled name (e.g. Box__i64),
                                    ; but the trait object erases the concrete type and mono only
                                    ; instantiates via direct trait calls — so the vtable ends up naming
                                    ; the un-instantiated `Trait$Box$method`, which codegen can't resolve
                                    ; (it used to SIGABRT there). Reject it here, located, until dyn
                                    ; coercion learns to monomorphize the vtable.
                                    (if (primitive/icmp-gt (al-len [(slice u8)] (primitive/load (primitive/field ipp type_params))) 0)
                                        (Err [SynPair Diag]
                                             (derr-at-src src
                                                          lo
                                                          hi
                                                          (sconcat a
                                                                   (sconcat a
                                                                            (sconcat5 a
                                                                                      "in '"
                                                                                      fname
                                                                                      "': cannot make a trait object of '"
                                                                                      (ty-str a pointee)
                                                                                      "': its impl of '")
                                                                            (display-name tr))
                                                                   "' is generic, and a (dyn Trait) vtable needs a concrete impl; erase a fully-concrete type instead")))
                                        (let [td (trait-find cx tr)
                                              methods
                                                (dyn-method-names a
                                                                  td
                                                                  tr
                                                                  (impl-mangle-key a
                                                                                   (primitive/field ipp self_type)
                                                                                   (primitive/load (primitive/field ipp type_params))))]
                                          (Ok (mk-synpair a
                                                          (box-expr a
                                                                    (mk-expr (EMakeDyn dyn_struct
                                                                                       vtable_struct
                                                                                       methods
                                                                                       inner)
                                                                             lo
                                                                             hi
                                                                             src
                                                                             ctxt))
                                                          (box-type a (TStruct dyn_struct))))))))))))))))))
(defn maybe-coerce-dyn [(a (ptr Allocator))
                        (cx (ptr Cx))
                        (ae (ptr Expr))
                        (at (ptr Type))
                        (want (ptr Type))
                        (lo i64)
                        (hi i64)
                        (src i64)
                        (ctxt i64)
                        (fname (slice u8))] (-> (Result SynPair Diag))
  (let [wtg (type-tag want)
        wdname
          (if (primitive/icmp-eq wtg 6)
              (type-struct-name want)
              (if (and (primitive/icmp-eq wtg 5) (primitive/icmp-eq (type-tag (t-inner want)) 6)) (type-struct-name (t-inner want)) ""))]
    (if (primitive/icmp-eq (slice-len [u8] wdname) 0)
        (Ok (mk-synpair a ae at))
        (if (and (type-is-ptr at)
                 (not (and (primitive/icmp-eq (type-tag (t-inner at)) 6) (str-eq (type-struct-name (t-inner at)) wdname))))
            (let [tr (dyn-struct-trait cx wdname)]
              (if (primitive/icmp-gt (slice-len [u8] tr) 0)
                  (build-make-dyn a cx tr ae at lo hi src ctxt fname)
                  (Ok (mk-synpair a ae at))))
            (Ok (mk-synpair a ae at))))))
; synth_construct
(defn variant-in-sum [(si (ptr SumInfo)) (variant (slice u8))] (-> (ptr Variant))
  (let [vs (primitive/load (primitive/field si variants))
        n (al-len [Variant] (primitive/load vs))
        (mut i) 0
        (mut r) (primitive/cast (ptr Variant) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [Variant] vs (primitive/load i)) name)) variant)
                      (primitive/store! r (al-elem [Variant] vs (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn field-types-of [(a (ptr Allocator)) (v (ptr Variant))] (-> (ptr (ArrayList Type)))
  (let [fs (primitive/load (primitive/field v fields))
        n (al-len [Field] (primitive/load fs))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (primitive/load (primitive/field (al-elem [Field] fs (primitive/load i)) ty)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))
(defn all-tparams-bound [(tparams (ptr (ArrayList (slice u8)))) (subst (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [n (al-len [(slice u8)] (primitive/load tparams))
        (mut i) 0
        (mut all) true]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (not (subst-has subst (al-get [(slice u8)] (primitive/load tparams) (primitive/load i)))) (primitive/store! all false) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load all)))

(defn synth-construct [(a (ptr Allocator))
                       (variant (slice u8))
                       (type_args (ptr (ArrayList Type)))
                       (args (ptr (ArrayList Expr)))
                       (expected (ptr Type))
                       (env (ptr (ArrayList EnvEntry)))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))
                       (lo i64)
                       (hi i64)
                       (src i64)
                       (ctxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [sumname (primitive/load (primitive/field (vts-find cx variant) sum))
               si (sum-find cx (primitive/load (primitive/field (vts-find cx variant) sum)))
               v (variant-in-sum si variant)]
           (when (not (primitive/icmp-eq (al-len [Field] (primitive/load (primitive/field v fields))) (al-len [Expr] (primitive/load args))))
                 (break :try
                        (err-ep (derr (sconcat a
                                               (sconcat a
                                                        (sconcat a
                                                                 (sconcat4 a
                                                                           "in '"
                                                                           fname
                                                                           "': variant '"
                                                                           (sconcat a variant "' takes "))
                                                                 (i64->str a
                                                                           (al-len [Field] (primitive/load (primitive/field v fields)))))
                                                        " field(s), got ")
                                               (i64->str a (al-len [Expr] (primitive/load args))))))))
           (let [tparams (primitive/load (primitive/field si type_params))
                 field_types (field-types-of a v)
                 subst (subst-new a)
                 np (al-len [(slice u8)] (primitive/load tparams))]
             (if (primitive/icmp-gt (al-len [Type] (primitive/load type_args)) 0)
                 (do
                   (when (not (primitive/icmp-eq (al-len [Type] (primitive/load type_args)) np))
                         (break :try
                                (err-ep (derr (sconcat a
                                                       (sconcat a
                                                                (sconcat a
                                                                         (sconcat4 a
                                                                                   "in '"
                                                                                   fname
                                                                                   "': '"
                                                                                   (sconcat a variant "' expects "))
                                                                         (i64->str a np))
                                                                " type arguments, got ")
                                                       (i64->str a (al-len [Type] (primitive/load type_args))))))))
                   (try! (validate-targs a cx type_args tps fname))
                   (build-subst! subst tparams type_args))
                 (when (expected-some? expected)
                       (let [to (alloc-stack-store-targs a expected sumname np)]
                         (when (primitive/load (primitive/field to found)) (build-subst! subst tparams (primitive/load (primitive/field to targs)))))))
             (let [new_args
                     (if (all-tparams-bound tparams subst)
                         (try! (construct-check-args a field_types args subst variant env cx tps fname))
                         (try! (construct-infer-args a field_types args subst tparams variant env cx tps fname)))]
               (if (primitive/icmp-eq np 0)
                   (ok-ep (mk-expr (ECall variant (box-items-type a) new_args) lo hi src ctxt) (TStruct sumname))
                   (let [out_targs (subst-targs a tparams subst)]
                     (ok-ep (mk-expr (ECall variant out_targs new_args) lo hi src ctxt) (TApp sumname out_targs))))))))))

(defn validate-targs [(a (ptr Allocator))
                      (cx (ptr Cx))
                      (type_args (ptr (ArrayList Type)))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))] (-> (Result i64 Diag))
  (let [n (al-len [Type] (primitive/load type_args))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (validate-type (al-elem [Type] type_args (primitive/load i)) cx tps)
                  (Err [d]
                       (do
                         (primitive/store! err (prefix-diag a d (sconcat3 a "in '" fname "': type argument: ")))
                         (primitive/store! failed true)
                         (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [i64 Diag] (primitive/load err)) (Ok [i64 Diag] 0))))
(defn build-subst! [(subst (ptr (ArrayList SubstEntry)))
                    (tparams (ptr (ArrayList (slice u8))))
                    (targs (ptr (ArrayList Type)))] (-> i64)
  (let [n (al-len [(slice u8)] (primitive/load tparams))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (subst-insert! subst (al-get [(slice u8)] (primitive/load tparams) (primitive/load i)) (al-elem [Type] targs (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))
(defn alloc-stack-store-targs [(a (ptr Allocator)) (expected (ptr Type)) (sumname (slice u8)) (np i64)] (-> (ptr TargsOpt))
  (let [p (unwrap-ptr [TargsOpt] (create [TargsOpt] a))] (primitive/store! p (expected-sum-targs a expected sumname np)) p))
(defn subst-targs [(a (ptr Allocator)) (tparams (ptr (ArrayList (slice u8)))) (subst (ptr (ArrayList SubstEntry)))] (-> (ptr (ArrayList Type)))
  (let [n (al-len [(slice u8)] (primitive/load tparams))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (primitive/load (subst-get subst (al-get [(slice u8)] (primitive/load tparams) (primitive/load i)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))
(defn construct-check-args [(a (ptr Allocator))
                            (field_types (ptr (ArrayList Type)))
                            (args (ptr (ArrayList Expr)))
                            (subst (ptr (ArrayList SubstEntry)))
                            (variant (slice u8))
                            (env (ptr (ArrayList EnvEntry)))
                            (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))
                            (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [n (al-len [Expr] (primitive/load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [want (subst-apply a (al-elem [Type] field_types (primitive/load i)) subst)
                      wp (box-type a want)
                      what (sconcat a (sconcat a (sconcat3 a "'" variant "' field ") (i64->str a (primitive/iadd (primitive/load i) 1))) "")]
                  (match (check-to a (al-elem [Expr] args (primitive/load i)) wp env cx tps fname what)
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [ce] (al-push! (mut out) ce))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [(ptr (ArrayList Expr)) Diag] (primitive/load err)) (Ok (box-al [Expr] a (primitive/load out))))))
(defn construct-infer-args [(a (ptr Allocator))
                            (field_types (ptr (ArrayList Type)))
                            (args (ptr (ArrayList Expr)))
                            (subst (ptr (ArrayList SubstEntry)))
                            (tparams (ptr (ArrayList (slice u8))))
                            (variant (slice u8))
                            (env (ptr (ArrayList EnvEntry)))
                            (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))
                            (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [n (al-len [Expr] (primitive/load args))
        (mut argl) (al-new [ArgSlot] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (do-synth a (al-elem [Expr] args (primitive/load i)) (null-type) env cx tps fname)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (alloc/stack SynPair)
                            sl (alloc/stack ArgSlot)]
                        (primitive/store! sp sp0)
                        (primitive/store! (primitive/field sl present) true)
                        (primitive/store! (primitive/field sl e) (primitive/load (primitive/field sp e)))
                        (primitive/store! (primitive/field sl t) (primitive/load (primitive/field sp t)))
                        (al-push! (mut argl) (primitive/load sl)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (primitive/load err))
        (let [argl2 (box-al [ArgSlot] a (primitive/load argl))
              (mut j) 0
              (mut err2) (primitive/zeroed Diag)
              (mut failed2) false]
          (loop (if (primitive/icmp-ge (primitive/load j) n)
                    (break)
                    (do
                      (match (unify a
                                    (al-elem [Type] field_types (primitive/load j))
                                    (primitive/load (primitive/field (al-elem [ArgSlot] argl2 (primitive/load j)) t))
                                    tparams
                                    subst
                                    fname)
                        (Err [d] (do (primitive/store! err2 d) (primitive/store! failed2 true) (break)))
                        (Ok [_] 0))
                      (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
          (if (primitive/load failed2)
              (Err [(ptr (ArrayList Expr)) Diag] (primitive/load err2))
              (let [npm (al-len [(slice u8)] (primitive/load tparams))
                    (mut k) 0
                    (mut missing) false
                    (mut mp) ""]
                (loop (if (primitive/icmp-ge (primitive/load k) npm)
                          (break)
                          (do
                            (when (not (subst-has subst (al-get [(slice u8)] (primitive/load tparams) (primitive/load k))))
                                  (primitive/store! missing true)
                                  (primitive/store! mp (al-get [(slice u8)] (primitive/load tparams) (primitive/load k)))
                                  (break))
                            (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                (if (primitive/load missing)
                    (Err [(ptr (ArrayList Expr)) Diag]
                         (derr (sconcat a
                                        (sconcat a
                                                 (sconcat4 a
                                                           "in '"
                                                           fname
                                                           "': cannot infer type argument '"
                                                           (sconcat a (primitive/load mp) "' for '"))
                                                 (sconcat a variant "'; provide it explicitly: ("))
                                        (sconcat a variant " [<types>] ...)"))))
                    (let [(mut m) 0
                          (mut out2) (al-new [Expr] a)
                          (mut err3) (primitive/zeroed Diag)
                          (mut failed3) false]
                      (loop (if (primitive/icmp-ge (primitive/load m) n)
                                (break)
                                (do
                                  (let [sl (al-elem [ArgSlot] argl2 (primitive/load m))
                                        want (subst-apply a (al-elem [Type] field_types (primitive/load m)) subst)
                                        wp (box-type a want)
                                        what
                                          (sconcat a (sconcat3 a "'" variant "' field ") (i64->str a (primitive/iadd (primitive/load m) 1)))]
                                    (match (coerce a (primitive/load (primitive/load (primitive/field sl e))) (primitive/load (primitive/field sl t)) wp false fname what)
                                      (Err [d] (do (primitive/store! err3 d) (primitive/store! failed3 true) (break)))
                                      (Ok [ce] (al-push! (mut out2) ce))))
                                  (primitive/store! m (primitive/iadd (primitive/load m) 1)))))
                      (if (primitive/load failed3)
                          (Err [(ptr (ArrayList Expr)) Diag] (primitive/load err3))
                          (Ok (box-al [Expr] a (primitive/load out2))))))))))))

; ---- ECall ----
(defn methods-has [(cx (ptr Cx)) (func (slice u8))] (-> bool)
  (let [n (al-len [MethodEntry] (primitive/load (primitive/field cx methods)))
        (mut i) 0
        (mut r) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [MethodEntry] (primitive/field cx methods) (primitive/load i)) name)) func)
                      (primitive/store! r true)
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn trait-method-find [(td (ptr TraitDef)) (func (slice u8))] (-> (ptr TraitMethod))
  (let [ms (primitive/load (primitive/field td methods))
        n (al-len [TraitMethod] (primitive/load ms))
        (mut i) 0
        (mut r) (primitive/cast (ptr TraitMethod) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [TraitMethod] ms (primitive/load i)) name)) func)
                      (primitive/store! r (al-elem [TraitMethod] ms (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn is-mut-borrow [(e (ptr Expr))] (-> bool)
  (match-else (primitive/load (primitive/field e kind)) (EBorrow [mu place] mu) (_ false)))
(defn peel-ref-ptr [(t (ptr Type))] (-> (ptr Type))
  (let [(mut r) t]
    (loop (let [tg (type-tag (primitive/load r))]
            (if (or (primitive/icmp-eq tg 4) (primitive/icmp-eq tg 5)) (do (primitive/store! r (t-inner (primitive/load r))) 0) (break))))
    (primitive/load r)))

; Can a call to a `tr` method dispatch on a receiver of type `t`? Either an impl
; matches it, `t` is a (bounded) type parameter, or it's a `(dyn Trait)` receiver.
(defn dispatch-here? [(a (ptr Allocator))
                      (cx (ptr Cx))
                      (tr (slice u8))
                      (t (ptr Type))
                      (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (if (not (has-impl-name a t))
      false
      (let [nm (type-impl-name a t)]
        (or (set-contains tps nm)
            (or (primitive/icmp-gt (slice-len [u8] (dyn-struct-trait cx nm)) 0)
                (impl-match a cx tr t))))))

; Method-dispatch autoderef. This was a single full `peel-ref-ptr`, which was fine
; while pointers couldn't carry impls — the pointee was the only possible receiver.
; Now that they can, a pointer's OWN impl must win: `(< p q)` with `Ord (ptr T)` in
; scope compares ADDRESSES, and must not silently peel to the pointee's `Ord`. So we
; try the receiver's own type first and peel one ptr/ref layer at a time, stopping at
; the first level that dispatches (the receiver type is tried before any
; autoderef step). `(len xs)` on `(ptr (ArrayList T))` still works: "ptr" has no `Len`
; impl, so the chain peels to the ArrayList exactly as before. If nothing in the chain
; dispatches, fall back to the fully-peeled type so existing diagnostics are unchanged.
(defn deref-to-impl [(a (ptr Allocator))
                     (cx (ptr Cx))
                     (tr (slice u8))
                     (t0 (ptr Type))
                     (tps (ptr (ArrayList (slice u8))))] (-> (ptr Type))
  (let [(mut r) t0
        (mut found) false]
    (loop (if (dispatch-here? a cx tr (primitive/load r) tps)
              (do (primitive/store! found true) (break))
              (let [tg (type-tag (primitive/load r))]
                (if (or (primitive/icmp-eq tg 4) (primitive/icmp-eq tg 5)) (do (primitive/store! r (t-inner (primitive/load r))) 0) (break)))))
    (if (primitive/load found) (primitive/load r) (peel-ref-ptr t0))))

; ---- associated-type bounds (gen-1) ----------------------------------------
; A PARAMETERIZED trait `(deftrait Get [Self K E] …)` can be used as a bound
; `(C Get)`: its non-Self params (K, E) are ASSOCIATED TYPES — determined by C's
; impl, one impl per type. Inside the bounded generic they are unknown, so each is
; represented as a synthetic abstract type param `<C>$assoc$<Trait>$<K>` — a spelling
; no user identifier can produce (`$` isn't an identifier char), so it never collides
; with a real type. These names are added to the body's tps (so a call whose
; result/arg mentions one type-checks) and resolved to the impl's concrete type at
; monomorphization (mono reads them off the receiver's impl, exactly as it already
; reads a generic impl's own type params).
(defn assoc-tp-name [(a (ptr Allocator)) (base (slice u8)) (tr (slice u8)) (p (slice u8))] (-> (slice u8))
  (sconcat3 a base "$assoc$" (sconcat3 a (display-name tr) "$" p)))

; The deferred-call substitution: the trait method's `Self` -> the bounded type
; param `C`, and each extra trait param -> its associated type. `subst-apply` over
; this turns the trait method signature into the concrete-in-C signature the body
; is checked against.
(defn build-trait-subst [(a (ptr Allocator))
                         (self_pname (slice u8))
                         (self_name (slice u8))
                         (trait_name (slice u8))
                         (td (ptr TraitDef))] (-> (ptr (ArrayList SubstEntry)))
  (let [s (subst-new a)]
    (subst-insert! s self_pname (box-type a (TStruct self_name)))
    (let [tps2 (primitive/load (primitive/field td type_params))
          np (al-len [(slice u8)] (primitive/load tps2))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) np)
                (break)
                (do
                  (let [p (al-get [(slice u8)] (primitive/load tps2) (primitive/load i))]
                    (subst-insert! s p (box-type a (TStruct (assoc-tp-name a self_name trait_name p)))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    s))

; `base` (the function's declared type params) extended with the associated-type
; names of every bound over a parameterized trait — the tps the BODY is checked
; against. The stored func `type_params` are unchanged: associated types are
; internal, never named by a caller.
(defn assoc-body-tps [(a (ptr Allocator))
                      (cx (ptr Cx))
                      (bounds (ptr (ArrayList Bound)))
                      (base (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (al-new [(slice u8)] a)
        nb (al-len [(slice u8)] (primitive/load base))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) nb)
              (break)
              (do (al-push! (mut out) (al-get [(slice u8)] (primitive/load base) (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (let [nbd (al-len [Bound] (primitive/load bounds))
          (mut j) 0]
      (loop (if (primitive/icmp-ge (primitive/load j) nbd)
                (break)
                (do
                  (let [bp (al-elem [Bound] bounds (primitive/load j))
                        trs (primitive/load (primitive/field bp traits))
                        m (al-len [(slice u8)] (primitive/load trs))
                        (mut k) 0]
                    (loop (if (primitive/icmp-ge (primitive/load k) m)
                              (break)
                              (do
                                (let [tr (al-get [(slice u8)] (primitive/load trs) (primitive/load k))
                                      td (trait-find cx tr)]
                                  (when (primitive/icmp-ne (primitive/cast i64 td) 0)
                                        (let [tps2 (primitive/load (primitive/field td type_params))
                                              np (al-len [(slice u8)] (primitive/load tps2))
                                              (mut p) 0]
                                          (loop (if (primitive/icmp-ge (primitive/load p) np)
                                                    (break)
                                                    (do
                                                      (al-push! (mut out)
                                                                (assoc-tp-name a
                                                                               (primitive/load (primitive/field bp name))
                                                                               tr
                                                                               (al-get [(slice u8)] (primitive/load tps2) (primitive/load p))))
                                                      (primitive/store! p (primitive/iadd (primitive/load p) 1))))))))
                                (primitive/store! k (primitive/iadd (primitive/load k) 1))))))
                  (primitive/store! j (primitive/iadd (primitive/load j) 1))))))
    (box-al [(slice u8)] a (primitive/load out))))

; trait type-parameter Self deferred args. `subst` maps Self -> the
; bounded param and every associated type -> its synthetic name (build-trait-subst).
(defn trait-tp-args [(a (ptr Allocator))
                     (tm (ptr TraitMethod))
                     (subst (ptr (ArrayList SubstEntry)))
                     (args (ptr (ArrayList Expr)))
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))
                     (func (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [ps (primitive/load (primitive/field tm params))
        n (al-len [Expr] (primitive/load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [want (subst-apply a (primitive/field (al-elem [Param] ps (primitive/load i)) ty) subst)
                      wp (box-type a want)
                      ismut (is-mut-borrow (al-elem [Expr] args (primitive/load i)))
                      exp (if (primitive/icmp-eq (type-tag wp) 5) (t-inner wp) wp)
                      what
                        (sconcat a (sconcat a (sconcat3 a "argument " (i64->str a (primitive/iadd (primitive/load i) 1)) " to '") func) "'")]
                  (match (do-synth a (al-elem [Expr] args (primitive/load i)) exp env cx tps fname)
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (alloc/stack SynPair)]
                          (primitive/store! sp sp0)
                          (match (coerce-arg a ismut (primitive/load (primitive/load (primitive/field sp e))) (primitive/load (primitive/field sp t)) wp false fname what)
                            (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                            (Ok [ce] (al-push! (mut out) ce)))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [(ptr (ArrayList Expr)) Diag] (primitive/load err)) (Ok (box-al [Expr] a (primitive/load out))))))

; non-generic call args
(defn ca-nongeneric [(a (ptr Allocator))
                     (sig (ptr Sig))
                     (args (ptr (ArrayList Expr)))
                     (func (slice u8))
                     (elo i64)
                     (ehi i64)
                     (esrc i64)
                     (ectxt i64)
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [params (primitive/load (primitive/field sig params))
        nparams (al-len [Type] (primitive/load params))
        is_extern (primitive/load (primitive/field sig is_extern))
        n (al-len [Expr] (primitive/load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (if (primitive/icmp-ge (primitive/load i) nparams)
                    (match (do-synth a (al-elem [Expr] args (primitive/load i)) (null-type) env cx tps fname)
                      (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                      (Ok [sp0]
                          (let [sp (alloc/stack SynPair)]
                            (primitive/store! sp sp0)
                            (if (type-is-void (primitive/load (primitive/field sp t)))
                                (do
                                  (primitive/store! err
                                          (derr (sconcat3 a
                                                          "in '"
                                                          fname
                                                          "': variadic argument uses a void value (a (-> void) call yields nothing)")))
                                  (primitive/store! failed true)
                                  (break))
                                (if (primitive/icmp-eq (type-tag (primitive/load (primitive/field sp t))) 5)
                                    (let [ae (al-elem [Expr] args (primitive/load i))
                                          nm (match-else (primitive/load (primitive/field ae kind)) (EVar [n] n) (_ "…"))]
                                      (do
                                        (primitive/store! err
                                                (derr-at (primitive/load (primitive/field ae lo))
                                                         (primitive/load (primitive/field ae hi))
                                                         (sconcat3 a
                                                                   (sconcat5 a
                                                                             "in '"
                                                                             fname
                                                                             "': cannot pass "
                                                                             (ty-str a (primitive/load (primitive/field sp t)))
                                                                             " to a variadic parameter — it would pass the address; write (primitive/load ")
                                                                   nm
                                                                   ") for the value")))
                                        (primitive/store! failed true)
                                        (break)))
                                    (al-push! (mut out) (primitive/load (primitive/load (primitive/field sp e)))))))))
                    (let [want (al-elem [Type] params (primitive/load i))
                          ismut (is-mut-borrow (al-elem [Expr] args (primitive/load i)))
                          exp (if (primitive/icmp-eq (type-tag want) 5) (t-inner want) want)
                          what
                            (sconcat a
                                     (sconcat a (sconcat3 a "argument " (i64->str a (primitive/iadd (primitive/load i) 1)) " to '") func)
                                     "'")]
                      (match (do-synth a (al-elem [Expr] args (primitive/load i)) exp env cx tps fname)
                        (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                        (Ok [sp0]
                            (let [sp (alloc/stack SynPair)]
                              (primitive/store! sp sp0)
                              (match (maybe-coerce-dyn a
                                                       cx
                                                       (primitive/load (primitive/field sp e))
                                                       (primitive/load (primitive/field sp t))
                                                       want
                                                       elo
                                                       ehi
                                                       esrc
                                                       ectxt
                                                       fname)
                                (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                                (Ok [mp0]
                                    (let [mp (alloc/stack SynPair)]
                                      (primitive/store! mp mp0)
                                      (match (coerce-arg a
                                                         ismut
                                                         (primitive/load (primitive/load (primitive/field mp e)))
                                                         (primitive/load (primitive/field mp t))
                                                         want
                                                         is_extern
                                                         fname
                                                         what)
                                        (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                                        (Ok [ce] (al-push! (mut out) ce)))))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [(ptr (ArrayList Expr)) Diag] (primitive/load err)) (Ok (box-al [Expr] a (primitive/load out))))))

; generic call. Returns the elaborated ECall as EvalPair.
(defn ca-build-arglist [(a (ptr Allocator))
                        (args (ptr (ArrayList Expr)))
                        (defs (ptr (ArrayList Deferred)))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))] (-> (ptr (ArrayList ArgSlot)))
  (let [n (al-len [Expr] (primitive/load args))
        (mut out) (al-new [ArgSlot] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [saved (al-len [EnvEntry] (primitive/load env))]
                  (match (do-synth a (al-elem [Expr] args (primitive/load i)) (null-type) env cx tps fname)
                    (Ok [sp0]
                        (let [sp (alloc/stack SynPair)
                              sl (alloc/stack ArgSlot)]
                          (primitive/store! sp sp0)
                          (primitive/store! (primitive/field sl present) true)
                          (primitive/store! (primitive/field sl e) (primitive/load (primitive/field sp e)))
                          (primitive/store! (primitive/field sl t) (primitive/load (primitive/field sp t)))
                          (al-push! (mut out) (primitive/load sl))))
                    (Err [d]
                         (do
                           (env-truncate! env saved)
                           (let [sl (alloc/stack ArgSlot)
                                 df (alloc/stack Deferred)]
                             (primitive/store! (primitive/field sl present) false)
                             (primitive/store! (primitive/field sl e) (primitive/cast (ptr Expr) 0))
                             (primitive/store! (primitive/field sl t) (primitive/cast (ptr Type) 0))
                             (al-push! (mut out) (primitive/load sl))
                             (primitive/store! (primitive/field df idx) (primitive/load i))
                             (primitive/store! (primitive/field df err) d)
                             (al-push! [Deferred] defs (primitive/load df)))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [ArgSlot] a (primitive/load out))))
(defn ca-check-bounds [(a (ptr Allocator))
                       (sig (ptr Sig))
                       (subst (ptr (ArrayList SubstEntry)))
                       (func (slice u8))
                       (cx (ptr Cx))
                       (fname (slice u8))] (-> (Result i64 Diag))
  (let [bounds (primitive/load (primitive/field sig bounds))
        n (al-len [Bound] (primitive/load bounds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [bp (al-elem [Bound] bounds (primitive/load i))
                      param (primitive/load (primitive/field bp name))
                      tyr (subst-get subst (primitive/load (primitive/field bp name)))]
                  (when (primitive/icmp-ne (primitive/cast i64 tyr) 0)
                        (let [trs (primitive/load (primitive/field bp traits))
                              m (al-len [(slice u8)] (primitive/load trs))
                              (mut k) 0]
                          (loop (if (primitive/icmp-ge (primitive/load k) m)
                                    (break)
                                    (do
                                      (let [tr (al-get [(slice u8)] (primitive/load trs) (primitive/load k))
                                            ok (impl-match a cx tr tyr)]
                                        (when (not ok)
                                              (primitive/store! err
                                                      (derr (sconcat a
                                                                     (sconcat a
                                                                              (sconcat a
                                                                                       (sconcat a
                                                                                                (sconcat4 a
                                                                                                          "in '"
                                                                                                          fname
                                                                                                          "': '"
                                                                                                          (sconcat a
                                                                                                                   (ty-str a
                                                                                                                           tyr)
                                                                                                                   "' does not implement '"))
                                                                                                (display-name tr))
                                                                                       "' (required by '")
                                                                              func)
                                                                     (sconcat a "' bound on '" (sconcat a param "')")))))
                                              (primitive/store! failed true)
                                              (break)))
                                      (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                          0)))
                (if (primitive/load failed) (break) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (if (primitive/load failed) (Err [i64 Diag] (primitive/load err)) (Ok [i64 Diag] 0))))
(defn ca-resynth-deferred [(a (ptr Allocator))
                           (defs (ptr (ArrayList Deferred)))
                           (argl (ptr (ArrayList ArgSlot)))
                           (sig (ptr Sig))
                           (subst (ptr (ArrayList SubstEntry)))
                           (args (ptr (ArrayList Expr)))
                           (env (ptr (ArrayList EnvEntry)))
                           (cx (ptr Cx))
                           (tps (ptr (ArrayList (slice u8))))
                           (fname (slice u8))] (-> (Result i64 Diag))
  (let [params (primitive/load (primitive/field sig params))
        n (al-len [Deferred] (primitive/load defs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [df (al-elem [Deferred] defs (primitive/load i))
                      idx (primitive/load (primitive/field df idx))
                      want (subst-apply a (al-elem [Type] params idx) subst)
                      wp (box-type a want)]
                  (match (do-synth a (al-elem [Expr] args idx) wp env cx tps fname)
                    (Err [_] (do (primitive/store! err (primitive/load (primitive/field df err))) (primitive/store! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (alloc/stack SynPair)
                              sl (al-elem [ArgSlot] argl idx)]
                          (primitive/store! sp sp0)
                          (primitive/store! (primitive/field sl present) true)
                          (primitive/store! (primitive/field sl e) (primitive/load (primitive/field sp e)))
                          (primitive/store! (primitive/field sl t) (primitive/load (primitive/field sp t)))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [i64 Diag] (primitive/load err)) (Ok [i64 Diag] 0))))
(defn ca-final-coerce [(a (ptr Allocator))
                       (argl (ptr (ArrayList ArgSlot)))
                       (sig (ptr Sig))
                       (subst (ptr (ArrayList SubstEntry)))
                       (args (ptr (ArrayList Expr)))
                       (func (slice u8))
                       (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [params (primitive/load (primitive/field sig params))
        is_extern (primitive/load (primitive/field sig is_extern))
        n (al-len [Expr] (primitive/load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [sl (al-elem [ArgSlot] argl (primitive/load i))
                      want (subst-apply a (al-elem [Type] params (primitive/load i)) subst)
                      wp (box-type a want)
                      ismut (is-mut-borrow (al-elem [Expr] args (primitive/load i)))
                      what
                        (sconcat a (sconcat a (sconcat3 a "argument " (i64->str a (primitive/iadd (primitive/load i) 1)) " to '") func) "'")]
                  (match (coerce-arg a ismut (primitive/load (primitive/load (primitive/field sl e))) (primitive/load (primitive/field sl t)) wp is_extern fname what)
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [ce] (al-push! (mut out) ce))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [(ptr (ArrayList Expr)) Diag] (primitive/load err)) (Ok (box-al [Expr] a (primitive/load out))))))

(defn method-index-of [(td (ptr TraitDef)) (func (slice u8))] (-> i64)
  (let [ms (primitive/load (primitive/field td methods))
        n (al-len [TraitMethod] (primitive/load ms))
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [TraitMethod] ms (primitive/load i)) name)) func) (primitive/store! r (primitive/load i)) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn dyn-dispatch-args [(a (ptr Allocator))
                         (tm (ptr TraitMethod))
                         (self_idx i64)
                         (func (slice u8))
                         (args (ptr (ArrayList Expr)))
                         (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))
                         (elo i64)
                         (ehi i64)
                         (esrc i64)
                         (ectxt i64)
                         (params (ptr (ArrayList Type)))
                         (newargs (ptr (ArrayList Expr)))] (-> (Result i64 Diag))
  (let [ps (primitive/load (primitive/field tm params))
        n (al-len [Expr] (primitive/load args))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (unless (primitive/icmp-eq (primitive/load i) self_idx)
                        (let [want (primitive/field (al-elem [Param] ps (primitive/load i)) ty)
                              exp
                                (if (primitive/icmp-eq (type-tag (primitive/field (al-elem [Param] ps (primitive/load i)) ty)) 5)
                                    (t-inner (primitive/field (al-elem [Param] ps (primitive/load i)) ty))
                                    (primitive/field (al-elem [Param] ps (primitive/load i)) ty))
                              ismut (is-mut-borrow (al-elem [Expr] args (primitive/load i)))
                              what (sconcat1 a (sconcat3 a "argument to '" func "'"))]
                          (match (do-synth a (al-elem [Expr] args (primitive/load i)) exp env cx tps fname)
                            (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                            (Ok [sp0]
                                (let [sp (alloc/stack SynPair)]
                                  (primitive/store! sp sp0)
                                  (match (maybe-coerce-dyn a
                                                           cx
                                                           (primitive/load (primitive/field sp e))
                                                           (primitive/load (primitive/field sp t))
                                                           want
                                                           elo
                                                           ehi
                                                           esrc
                                                           ectxt
                                                           fname)
                                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                                    (Ok [mp0]
                                        (let [mp (alloc/stack SynPair)]
                                          (primitive/store! mp mp0)
                                          (match (coerce-arg a
                                                             ismut
                                                             (primitive/load (primitive/load (primitive/field mp e)))
                                                             (primitive/load (primitive/field mp t))
                                                             want
                                                             false
                                                             fname
                                                             what)
                                            (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                                            (Ok [ce]
                                                (do (al-push! [Expr] newargs ce) (al-push! [Type] params (primitive/load want)) 0)))))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [i64 Diag] (primitive/load err)) (Ok [i64 Diag] 0))))
(defn synth-dyn-dispatch [(a (ptr Allocator))
                          (cx (ptr Cx))
                          (func (slice u8))
                          (self_name (slice u8))
                          (self_idx i64)
                          (td (ptr TraitDef))
                          (tm (ptr TraitMethod))
                          (args (ptr (ArrayList Expr)))
                          (env (ptr (ArrayList EnvEntry)))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))
                          (elo i64)
                          (ehi i64)
                          (esrc i64)
                          (ectxt i64)] (-> (Result EvalPair Diag))
  (let [mi (method-index-of td func)
        dyn_ty (box-type a (TStruct self_name))]
    (match (do-synth a (al-elem [Expr] args self_idx) dyn_ty env cx tps fname)
      (Err [d] (err-ep d))
      (Ok [rsp0]
          (let [rsp (alloc/stack SynPair)]
            (primitive/store! rsp rsp0)
            (match (coerce a
                           (primitive/load (primitive/load (primitive/field rsp e)))
                           (primitive/load (primitive/field rsp t))
                           dyn_ty
                           false
                           fname
                           "trait-object receiver")
              (Err [d] (err-ep d))
              (Ok [recv]
                  (let [params (box-al [Type] a (al-new [Type] a))
                        newargs (box-al [Expr] a (al-new [Expr] a))]
                    (al-push! [Type] params (TPtr (box-type a (TInt 8 false))))
                    (match (dyn-dispatch-args a
                                              tm
                                              self_idx
                                              func
                                              args
                                              env
                                              cx
                                              tps
                                              fname
                                              elo
                                              ehi
                                              esrc
                                              ectxt
                                              params
                                              newargs)
                      (Err [d] (err-ep d))
                      (Ok [_]
                          (let [vtable_struct
                                  (sconcat a (subslice [u8] self_name 0 (primitive/isub (slice-len [u8] self_name) 4)) "-vtable")]
                            (ok-ep (mk-expr (EDynDispatch self_name
                                                          vtable_struct
                                                          mi
                                                          "c"
                                                          params
                                                          (primitive/load (primitive/field tm ret))
                                                          (box-expr a recv)
                                                          newargs)
                                            elo
                                            ehi
                                            esrc
                                            ectxt)
                                   (primitive/load (primitive/field tm ret))))))))))))))

(defn synth-call-general [(a (ptr Allocator))
                          (func (slice u8))
                          (call_func (slice u8))
                          (type_args (ptr (ArrayList Type)))
                          (args (ptr (ArrayList Expr)))
                          (expected (ptr Type))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))
                          (elo i64)
                          (ehi i64)
                          (esrc i64)
                          (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [sig (sig-find cx call_func)]
           (when (primitive/icmp-eq (primitive/cast i64 sig) 0) (break :try (err-ep (derr (undefined-call-msg a cx fname func)))))
           (let [nparams (al-len [Type] (primitive/load (primitive/field sig params)))
                 nargs (al-len [Expr] (primitive/load args))
                 variadic (primitive/load (primitive/field sig variadic))
                 arity_ok (if variadic (primitive/icmp-ge nargs nparams) (primitive/icmp-eq nargs nparams))]
             (when (not arity_ok)
                   (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat a
                                                          (sconcat a
                                                                   (sconcat4 a
                                                                             "in '"
                                                                             fname
                                                                             "': '"
                                                                             (sconcat a func "' expects "))
                                                                   (if variadic "at least " ""))
                                                          (i64->str a nparams))
                                                 (sconcat a " args, got " (i64->str a nargs)))))))
             (if (primitive/icmp-eq (al-len [(slice u8)] (primitive/load (primitive/field sig type_params))) 0)
                 (do
                   (when (primitive/icmp-gt (al-len [Type] (primitive/load type_args)) 0)
                         (break :try
                                (err-ep (derr (sconcat1 a
                                                        (sconcat5 a
                                                                  "in '"
                                                                  fname
                                                                  "': '"
                                                                  func
                                                                  "' is not generic but got type arguments"))))))
                   (let [new_args (try! (ca-nongeneric a sig args func elo ehi esrc ectxt env cx tps fname))]
                     (return-from :try
                                  (ok-ep (mk-expr (ECall call_func (box-items-type a) new_args) elo ehi esrc ectxt)
                                         (primitive/load (primitive/field sig ret))))))
                 (let [defs (box-al [Deferred] a (al-new [Deferred] a))
                       argl (ca-build-arglist a args defs env cx tps fname)
                       subst
                         (try! (solve-type-args a
                                                (primitive/load (primitive/field sig type_params))
                                                (primitive/load (primitive/field sig params))
                                                type_args
                                                argl
                                                (primitive/field sig ret)
                                                expected
                                                cx
                                                tps
                                                fname
                                                func))]
                   (try! (ca-check-bounds a sig subst func cx fname))
                   (try! (ca-resynth-deferred a defs argl sig subst args env cx tps fname))
                   (let [new_args (try! (ca-final-coerce a argl sig subst args func fname))
                         out_targs (subst-targs a (primitive/load (primitive/field sig type_params)) subst)
                         ret (subst-apply a (primitive/field sig ret) subst)]
                     ; call_func, not func: a trait-method call on a concrete receiver
                     ; was rewritten to the impl's lowered function — GENERIC for a
                     ; generic impl, so it lands here.
                     (ok-ep (mk-expr (ECall call_func out_targs new_args) elo ehi esrc ectxt) ret)))))))))

(defn synth-inherent-general [(a (ptr Allocator))
                              (func (slice u8))
                              (call-func (slice u8))
                              (type-args (ptr (ArrayList Type)))
                              (args (ptr (ArrayList Expr)))
                              (expected (ptr Type))
                              (env (ptr (ArrayList EnvEntry)))
                              (cx (ptr Cx))
                              (tps (ptr (ArrayList (slice u8))))
                              (fname (slice u8))
                              (elo i64)
                              (ehi i64)
                              (esrc i64)
                              (ectxt i64)] (-> (Result (Option EvalPair) Diag))
  (match (synth-call-general a func call-func type-args args expected env cx tps fname elo ehi esrc ectxt)
    (Err [d] (Err [(Option EvalPair) Diag] d))
    (Ok [ep] (Ok [(Option EvalPair) Diag] (Some [EvalPair] ep)))))

; Try inherent dispatch without stealing ordinary or trait calls. A qualified
; `Type::name` first considers receiverless associated functions, then receiver
; methods. A bare `name` considers receiver methods only and infers the owner from
; argument zero. None means "not an inherent call" and the existing trait/general
; resolution continues unchanged.
(defn synth-inherent-call [(a (ptr Allocator))
                           (func (slice u8))
                           (mname (slice u8))
                           (qual (slice u8))
                           (qualified bool)
                           (type-args (ptr (ArrayList Type)))
                           (args (ptr (ArrayList Expr)))
                           (expected (ptr Type))
                           (env (ptr (ArrayList EnvEntry)))
                           (cx (ptr Cx))
                           (tps (ptr (ArrayList (slice u8))))
                           (fname (slice u8))
                           (elo i64)
                           (ehi i64)
                           (esrc i64)
                           (ectxt i64)] (-> (Result (Option EvalPair) Diag))
  (try (do
         (when qualified
               (let [asel (alloc/stack ImplSel)]
                 (primitive/store! asel (inherent-associated-select a cx mname qual))
                 (when (primitive/load (primitive/field asel ambiguous))
                       (break :try
                              (Err [(Option EvalPair) Diag]
                                   (derr (sconcat a
                                                  (sconcat5 a "in '" fname "': inherent method qualifier '" qual "' is ambiguous for '")
                                                  (sconcat a mname "'"))))))
                 (let [aip (primitive/load (primitive/field asel ip))]
                   (unless (primitive/icmp-eq (primitive/cast i64 aip) 0)
                           (return-from :try
                                        (synth-inherent-general a
                                                                func
                                                                (inherent-fn-name a aip mname)
                                                                type-args
                                                                args
                                                                expected
                                                                env
                                                                cx
                                                                tps
                                                                fname
                                                                elo
                                                                ehi
                                                                esrc
                                                                ectxt))))))
         (when (and (primitive/icmp-gt (al-len [Expr] (primitive/load args)) 0) (inherent-has-name cx mname))
               (let [sp0 (try! (do-synth a (al-elem [Expr] args 0) (null-type) env cx tps fname))
                     sp (alloc/stack SynPair)]
                 (primitive/store! sp sp0)
                 (let [recv (primitive/load (primitive/field sp t))
                       sel (alloc/stack ImplSel)]
                   (primitive/store! sel (inherent-select-deref a cx mname (if qualified qual "") recv))
                   (when (primitive/load (primitive/field sel ambiguous))
                         (break :try
                                (Err [(Option EvalPair) Diag]
                                     (derr (sconcat a
                                                    (sconcat5 a "in '" fname "': ambiguous inherent method '" mname "' for '")
                                                    (sconcat a (ty-str a recv) "'"))))))
                   (let [ip (primitive/load (primitive/field sel ip))]
                     (unless (primitive/icmp-eq (primitive/cast i64 ip) 0)
                             (return-from :try
                                          (synth-inherent-general a
                                                                  func
                                                                  (inherent-fn-name a ip mname)
                                                                  type-args
                                                                  args
                                                                  expected
                                                                  env
                                                                  cx
                                                                  tps
                                                                  fname
                                                                  elo
                                                                  ehi
                                                                  esrc
                                                                  ectxt)))))))
         (Ok [(Option EvalPair) Diag] (None [EvalPair])))))

(defn synth-call [(a (ptr Allocator))
                  (func (slice u8))
                  (type_args (ptr (ArrayList Type)))
                  (args (ptr (ArrayList Expr)))
                  (expected (ptr Type))
                  (env (ptr (ArrayList EnvEntry)))
                  (cx (ptr Cx))
                  (tps (ptr (ArrayList (slice u8))))
                  (fname (slice u8))
                  (elo i64)
                  (ehi i64)
                  (esrc i64)
                  (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (when (primitive/icmp-ne (primitive/cast i64 (vts-find cx func)) 0)
               (break :try (synth-construct a func type_args args expected env cx tps fname elo ehi esrc ectxt)))
         ; A `Trait::method` head (gen-6) splits into the qualifier and the bare method
         ; name; `resolve-method-qual` then pins dispatch to the named trait. A plain call
         ; has no `::`, so `qual` is "" and `mname` is `func` — the original path, unchanged.
         (let [cc (find-coloncolon func)
               qual (if (primitive/icmp-ge cc 0) (subslice [u8] func 0 cc) "")
               mname (if (primitive/icmp-ge cc 0) (subslice [u8] func (primitive/iadd cc 2) (slice-len [u8] func)) func)
               (mut call_func) func]
           (let [inh (try! (synth-inherent-call a
                                                func
                                                mname
                                                qual
                                                (primitive/icmp-ge cc 0)
                                                type_args
                                                args
                                                expected
                                                env
                                                cx
                                                tps
                                                fname
                                                elo
                                                ehi
                                                esrc
                                                ectxt))]
             (match inh
               (Some [ep] (return-from :try (Ok [EvalPair Diag] ep)))
               (None [] 0)))
           (if (methods-has cx mname)
               (let [me0 (try! (resolve-method-qual a cx mname qual fname))
                     me (alloc/stack MethodEntry)]
                 (primitive/store! me me0)
                 (let [trait_name (primitive/load (primitive/field me trait))
                       self_idx (primitive/load (primitive/field me self_idx))
                       td (trait-find cx (primitive/load (primitive/field me trait)))
                       tm (trait-method-find (trait-find cx (primitive/load (primitive/field me trait))) mname)
                       self_pname (primitive/load (primitive/field td self_param))]
                   (when (not (primitive/icmp-eq (al-len [Expr] (primitive/load args)) (al-len [Param] (primitive/load (primitive/field tm params)))))
                         (break :try
                                (err-ep (derr (sconcat a
                                                       (sconcat a
                                                                (sconcat a
                                                                         (sconcat4 a
                                                                                   "in '"
                                                                                   fname
                                                                                   "': '"
                                                                                   (sconcat a mname "' expects "))
                                                                         (i64->str a
                                                                                   (al-len [Param]
                                                                                           (primitive/load (primitive/field tm params)))))
                                                                " args, got ")
                                                       (i64->str a (al-len [Expr] (primitive/load args))))))))
                   (let [selfsp (try! (do-synth a (al-elem [Expr] args self_idx) (null-type) env cx tps fname))
                         ssp (alloc/stack SynPair)]
                     (primitive/store! ssp selfsp)
                     (let [self_ty (deref-to-impl a cx trait_name (primitive/load (primitive/field ssp t)) tps)]
                       (when (not (has-impl-name a self_ty))
                             (break :try
                                    (err-ep (derr (sconcat a
                                                           (sconcat a
                                                                    (sconcat4 a
                                                                              "in '"
                                                                              fname
                                                                              "': trait method '"
                                                                              (sconcat a
                                                                                       mname
                                                                                       "' called on a type that can't carry an impl: "))
                                                                    (ty-str a self_ty))
                                                           "")))))
                       (let [self_name (type-impl-name a self_ty)]
                         (when (primitive/icmp-gt (slice-len [u8] (dyn-struct-trait cx self_name)) 0)
                               (break :try
                                      (synth-dyn-dispatch a
                                                          cx
                                                          mname
                                                          self_name
                                                          self_idx
                                                          td
                                                          tm
                                                          args
                                                          env
                                                          tps
                                                          fname
                                                          elo
                                                          ehi
                                                          esrc
                                                          ectxt)))
                         (if (set-contains tps self_name)
                             ; Self is a type parameter: a DEFERRED trait call. The bound must
                             ; carry the trait (definition-time check). A parameterized trait's
                             ; extra params become associated types (build-trait-subst); the
                             ; method sig, substituted, types the call — mono resolves it to the
                             ; impl once Self is concrete.
                             (if (not (bounds-has (primitive/field cx cur_bounds) self_name trait_name))
                                 (return-from :try
                                              (err-ep (derr (sconcat a
                                                                     (sconcat a
                                                                              (sconcat a
                                                                                       (sconcat4 a
                                                                                                 "in '"
                                                                                                 fname
                                                                                                 "': type parameter '"
                                                                                                 (sconcat a
                                                                                                          self_name
                                                                                                          "' is not bounded by '"))
                                                                                       (display-name trait_name))
                                                                              "' (required to call '")
                                                                     (sconcat a mname "')")))))
                                 (let [subst (build-trait-subst a self_pname self_name trait_name td)
                                       new_args (try! (trait-tp-args a tm subst args env cx tps fname mname))
                                       ret (subst-apply a (primitive/field tm ret) subst)]
                                   (return-from :try
                                                (ok-ep (mk-expr (ETraitCall trait_name mname self_name new_args)
                                                                elo
                                                                ehi
                                                                esrc
                                                                ectxt)
                                                       ret))))
                             ; Pick the most specific impl accepting this receiver, and call
                             ; THAT impl's function. Errors name the RECEIVER TYPE, not the
                             ; dispatch key: selection matches type arguments, so `(Pair u8 bool)`
                             ; can fail while `(Pair i64 i64)` succeeds — "'app.Pair' does not
                             ; implement" would be a lie in exactly the case this catches.
                             (let [sel (alloc/stack ImplSel)]
                               (primitive/store! sel (cx-impl-select a cx trait_name self_ty))
                               (when (primitive/icmp-eq (primitive/cast i64 (primitive/load (primitive/field sel ip))) 0)
                                     (break :try
                                            (err-ep (derr (sconcat a
                                                                   (sconcat a
                                                                            (sconcat5 a
                                                                                      "in '"
                                                                                      fname
                                                                                      "': '"
                                                                                      (ty-str a self_ty)
                                                                                      "' does not implement '")
                                                                            (display-name trait_name))
                                                                   "'")))))
                               (when (primitive/load (primitive/field sel ambiguous))
                                     (break :try
                                            (err-ep (derr (sconcat a
                                                                   (sconcat a
                                                                            (sconcat5 a
                                                                                      "in '"
                                                                                      fname
                                                                                      "': ambiguous impls of '"
                                                                                      (display-name trait_name)
                                                                                      "' for '")
                                                                            (ty-str a self_ty))
                                                                   "' — several match and none is more specific")))))
                               (let [ipp (primitive/load (primitive/field sel ip))]
                                 (primitive/store! call_func
                                         (tmfn a
                                               trait_name
                                               (impl-mangle-key a (primitive/field ipp self_type) (primitive/load (primitive/field ipp type_params)))
                                               mname))
                                 0))))))))
               ; `mname` is neither an inherent nor trait method. A bare call falls
               ; through to the general path; a qualified head promised a method.
               (when (primitive/icmp-ge cc 0)
                     (break :try
                            (err-ep (derr (sconcat a
                                                   (sconcat5 a "in '" fname "': '" func "' names no trait method '")
                                                   (sconcat3 a mname "' or inherent method '" (sconcat a mname "'"))))))))
           (synth-call-general a func (primitive/load call_func) type_args args expected env cx tps fname elo ehi esrc ectxt)))))
; ELet
(defn mk-bind [(name (slice u8)) (mutable bool) (value Expr)] (-> Bind)
  (let [p (alloc/stack Bind)]
    (primitive/store! (primitive/field p name) name)
    (primitive/store! (primitive/field p mutable) mutable)
    (primitive/store! (primitive/field p value) value)
    (primitive/load p)))
(defn synth-let-body [(a (ptr Allocator))
                      (body (ptr (ArrayList Expr)))
                      (expected (ptr Type))
                      (out (ptr (ArrayList Expr)))
                      (env (ptr (ArrayList EnvEntry)))
                      (cx (ptr Cx))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))
                      (what (slice u8))] (-> (Result Type Diag))
  (let [n (al-len [Expr] (primitive/load body))
        (mut i) 0
        (mut last) (TInt 64 true)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (if (primitive/icmp-eq (primitive/iadd (primitive/load i) 1) n)
                    (if (expected-some? expected)
                        (match (check-to a (al-elem [Expr] body (primitive/load i)) expected env cx tps fname what)
                          (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                          (Ok [ce] (do (al-push! [Expr] out ce) (primitive/store! last (primitive/load expected)) 0)))
                        (match (do-synth a (al-elem [Expr] body (primitive/load i)) (null-type) env cx tps fname)
                          (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                          (Ok [sp0]
                              (let [sp (alloc/stack SynPair)]
                                (primitive/store! sp sp0)
                                (primitive/store! last (primitive/load (primitive/load (primitive/field sp t))))
                                (al-push! [Expr] out (primitive/load (primitive/load (primitive/field sp e))))))))
                    (match (do-synth a (al-elem [Expr] body (primitive/load i)) (null-type) env cx tps fname)
                      (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                      (Ok [sp0]
                          (let [sp (alloc/stack SynPair)]
                            (primitive/store! sp sp0)
                            (al-push! [Expr] out (primitive/load (primitive/load (primitive/field sp e))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [Type Diag] (primitive/load err)) (Ok (primitive/load last)))))

; The let body's tail variable — if the body's last expression is a bare `(EVar nm)`
; and the let has an expected type, that binding IS the let's result, so its value can
; be checked against the expected type. "" when there is no such tail or no expectation.
(defn let-tail-var [(body (ptr (ArrayList Expr))) (expected (ptr Type))] (-> (slice u8))
  (if (not (expected-some? expected))
      ""
      (let [l (al-last-expr body)]
        (if (primitive/icmp-eq (primitive/cast i64 l) 0)
            ""
            (match-else (primitive/load (primitive/field l kind)) (EVar [nm] nm) (_ ""))))))

; Synthesize a let binding's value. Try WITHOUT an expectation first — every value that
; already infers is checked exactly as before, so nothing that compiled changes. Only if
; that STRANDS inference (an Err) and this binding is the let's returned tail (`bexp` is
; the let's expected type, else null) do we retry with the expected type, letting a type
; argument flow BACK from the return position (gen-9: `(let [r (Okk 5)] r)` returned as a
; `(Result i64 E)` — E is undetermined at the binding but fixed by the return).
(defn synth-bind-value [(a (ptr Allocator))
                        (bp (ptr Bind))
                        (bexp (ptr Type))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))] (-> (Result SynPair Diag))
  (match (do-synth a (primitive/field bp value) (null-type) env cx tps fname)
    (Ok [vsp] (Ok [SynPair Diag] vsp))
    (Err [d0]
         (if (expected-some? bexp)
             (match (do-synth a (primitive/field bp value) bexp env cx tps fname)
               (Ok [vsp] (Ok [SynPair Diag] vsp))
               (Err [_] (Err [SynPair Diag] d0)))
             (Err [SynPair Diag] d0)))))

(defn process-let-bind [(a (ptr Allocator))
                        (bp (ptr Bind))
                        (bexp (ptr Type))
                        (nbinds (ptr (ArrayList Bind)))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))
                        (elo i64)
                        (ehi i64)
                        (esrc i64)
                        (ectxt i64)] (-> (Result i64 Diag))
  (let [name (primitive/load (primitive/field bp name))
        mutable (primitive/load (primitive/field bp mutable))]
    (match (synth-bind-value a bp bexp env cx tps fname)
      (Err [d] (Err [i64 Diag] d))
      (Ok [vsp]
          (let [sp (alloc/stack SynPair)]
            (primitive/store! sp vsp)
            (let [ve (primitive/load (primitive/load (primitive/field sp e)))
                  vt (primitive/load (primitive/field sp t))]
              (cond (type-is-void vt)
                      (Err [i64 Diag]
                           (derr (sconcat1 a
                                           (sconcat4 a
                                                     "in '"
                                                     fname
                                                     "': cannot bind '"
                                                     (sconcat a
                                                              name
                                                              "' to a void value (a (-> void) call yields nothing)")))))
                    (primitive/icmp-eq (type-tag vt) 5)
                      (let [src_mut (t-ref-mut vt)
                            pointee (t-inner vt)]
                        (if (and mutable (not src_mut))
                            (Err [i64 Diag]
                                 (derr (sconcat1 a
                                                 (sconcat4 a
                                                           "in '"
                                                           fname
                                                           "': cannot make a mutable alias '"
                                                           (sconcat a name "' of an immutable reference")))))
                            (do
                              (env-insert! env name (box-type a (TRef mutable pointee)))
                              (al-push! [Bind] nbinds (mk-bind name false ve))
                              (Ok [i64 Diag] 0))))
                    (or mutable (is-place-value-type vt cx))
                      (let [slot (sconcat a name ".slot")
                            (mut initdo) (al-new [Expr] a)]
                        (env-insert! env name (box-type a (TRef mutable (box-type a (primitive/load vt)))))
                        (al-push! (mut initdo)
                                  (mk-expr (EStore (box-expr a (mk-expr (EVar slot) elo ehi esrc ectxt))
                                                   (box-expr a ve))
                                           elo
                                           ehi
                                           esrc
                                           ectxt))
                        (al-push! (mut initdo) (mk-expr (EVar slot) elo ehi esrc ectxt))
                        (al-push! [Bind]
                                  nbinds
                                  (mk-bind slot false (mk-expr (EAlloc 0 (erase-refs a vt)) elo ehi esrc ectxt)))
                        (al-push! [Bind]
                                  nbinds
                                  (mk-bind name
                                           false
                                           (mk-expr (EDo (box-al [Expr] a (primitive/load initdo))) elo ehi esrc ectxt)))
                        (Ok [i64 Diag] 0))
                    :else
                      (do
                        (env-insert! env name (box-type a (primitive/load vt)))
                        (al-push! [Bind] nbinds (mk-bind name false ve))
                        (Ok [i64 Diag] 0)))))))))

(defn process-let-binds [(a (ptr Allocator))
                         (binds (ptr (ArrayList Bind)))
                         (nbinds (ptr (ArrayList Bind)))
                         (tailvar (slice u8))
                         (expected (ptr Type))
                         (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))
                         (elo i64)
                         (ehi i64)
                         (esrc i64)
                         (ectxt i64)] (-> (Result i64 Diag))
  (let [nb (al-len [Bind] (primitive/load binds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) nb)
              (break)
              (do
                (let [bp (al-elem [Bind] binds (primitive/load i))
                      ; the let's returned tail binding gets the let's expected type as a
                      ; fallback (only used if it fails to infer on its own — see synth-bind-value)
                      bexp
                        (if (and (primitive/icmp-gt (slice-len tailvar) 0) (str-eq (primitive/load (primitive/field bp name)) tailvar))
                            expected
                            (null-type))]
                  (match (process-let-bind a bp bexp nbinds env cx tps fname elo ehi esrc ectxt)
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [_] 0)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [i64 Diag] (primitive/load err)) (Ok [i64 Diag] 0))))

(defn synth-let [(a (ptr Allocator))
                 (binds (ptr (ArrayList Bind)))
                 (body (ptr (ArrayList Expr)))
                 (expected (ptr Type))
                 (env (ptr (ArrayList EnvEntry)))
                 (cx (ptr Cx))
                 (tps (ptr (ArrayList (slice u8))))
                 (fname (slice u8))
                 (elo i64)
                 (ehi i64)
                 (esrc i64)
                 (ectxt i64)] (-> (Result EvalPair Diag))
  (let [saved (al-len [EnvEntry] (primitive/load env))
        nbinds (box-al [Bind] a (al-new [Bind] a))
        tailvar (let-tail-var body expected)]
    (match (process-let-binds a binds nbinds tailvar expected env cx tps fname elo ehi esrc ectxt)
      (Err [d] (err-ep d))
      (Ok [_]
          (let [outl (box-al [Expr] a (al-new [Expr] a))]
            (match (synth-let-body a body expected outl env cx tps fname "let body")
              (Err [d] (err-ep d))
              (Ok [last] (do (env-truncate! env saved) (ok-ep (mk-expr (ELet nbinds outl) elo ehi esrc ectxt) last)))))))))

; EMatch
(defn variant-by-name [(variants (ptr (ArrayList Variant))) (name (slice u8))] (-> (ptr Variant))
  (let [n (al-len [Variant] (primitive/load variants))
        (mut i) 0
        (mut r) (primitive/cast (ptr Variant) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [Variant] variants (primitive/load i)) name)) name)
                      (primitive/store! r (al-elem [Variant] variants (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn covered-has [(cov (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (set-contains cov name))

; the variant names in `variants` not present in `covered`, formatted as
; "`Blue`" / "`Blue`, `Yellow`" / "`Blue`, `Yellow`, `Cyan` … and 4 more".
(defn missing-variants-str [(a (ptr Allocator))
                            (variants (ptr (ArrayList Variant)))
                            (covered (ptr (ArrayList (slice u8))))] (-> (slice u8))
  (let [n (al-len [Variant] (primitive/load variants))
        (mut i) 0
        (mut out) ""
        (mut shown) 0
        (mut extra) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [nm (primitive/load (primitive/field (al-elem [Variant] variants (primitive/load i)) name))]
                  (unless (set-contains covered nm)
                          (if (primitive/icmp-lt (primitive/load shown) 5)
                              (do
                                (when (primitive/icmp-gt (primitive/load shown) 0) (primitive/store! out (sconcat a (primitive/load out) ", ")) 0)
                                (primitive/store! out (sconcat a (primitive/load out) (sconcat3 a "`" nm "`")))
                                (primitive/store! shown (primitive/iadd (primitive/load shown) 1))
                                0)
                              (primitive/store! extra (primitive/iadd (primitive/load extra) 1)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/icmp-gt (primitive/load extra) 0)
        (sconcat a (primitive/load out) (sconcat3 a " … and " (i64->str a (primitive/load extra)) " more"))
        (primitive/load out))))

(defn match-arms-loop [(a (ptr Allocator))
                       (arms (ptr (ArrayList Arm)))
                       (variants (ptr (ArrayList Variant)))
                       (sumname (slice u8))
                       (expected (ptr Type))
                       (covered (ptr (ArrayList (slice u8))))
                       (checked (ptr (ArrayList Arm)))
                       (synb (ptr (ArrayList Branch)))
                       (metav (ptr (ArrayList (slice u8))))
                       (metab (ptr (ArrayList (ptr (ArrayList (slice u8))))))
                       (env (ptr (ArrayList EnvEntry)))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))] (-> (Result i64 Diag))
  (let [narms (al-len [Arm] (primitive/load arms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) narms)
              (break)
              (do
                (let [arm (al-elem [Arm] arms (primitive/load i))
                      av (primitive/load (primitive/field arm variant))
                      abinds (primitive/load (primitive/field arm binds))
                      v (variant-by-name variants av)]
                  (cond (primitive/icmp-eq (primitive/cast i64 v) 0)
                          (do
                            (primitive/store! err
                                    (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a
                                                                      "in '"
                                                                      fname
                                                                      "': sum '"
                                                                      (sconcat a sumname "' has no variant '"))
                                                            av)
                                                   "'")))
                            (primitive/store! failed true)
                            (break))
                        (set-contains covered av)
                          (do
                            (primitive/store! err
                                    (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a "in '" fname "': duplicate match arm for '" av)
                                                            "'")
                                                   "")))
                            (primitive/store! failed true)
                            (break))
                        (not (primitive/icmp-eq (al-len [(slice u8)] (primitive/load abinds))
                                      (al-len [Field] (primitive/load (primitive/field v fields)))))
                          (do
                            (primitive/store! err
                                    (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat a
                                                                     (sconcat a
                                                                              (sconcat4 a
                                                                                        "in '"
                                                                                        fname
                                                                                        "': arm '"
                                                                                        (sconcat a av "' binds "))
                                                                              (i64->str a
                                                                                        (al-len [(slice u8)]
                                                                                                (primitive/load abinds))))
                                                                     " name(s) but the variant has ")
                                                            (i64->str a (al-len [Field] (primitive/load (primitive/field v fields)))))
                                                   " field(s)")))
                            (primitive/store! failed true)
                            (break))
                        :else
                          (do
                            (al-push! [(slice u8)] covered av)
                            (let [saved (al-len [EnvEntry] (primitive/load env))
                                  fs (primitive/load (primitive/field v fields))
                                  nbn (al-len [(slice u8)] (primitive/load abinds))
                                  (mut k) 0]
                              (loop (if (primitive/icmp-ge (primitive/load k) nbn)
                                        (break)
                                        (do
                                          (env-insert! env
                                                       (al-get [(slice u8)] (primitive/load abinds) (primitive/load k))
                                                       (primitive/field (al-elem [Field] fs (primitive/load k)) ty))
                                          (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                              (if (expected-some? expected)
                                  (match (check-to a (primitive/field arm body) expected env cx tps fname "match arm")
                                    (Err [d]
                                         (do (env-truncate! env saved) (primitive/store! err d) (primitive/store! failed true) (break)))
                                    (Ok [be]
                                        (do
                                          (let [na (alloc/stack Arm)]
                                            (primitive/store! (primitive/field na variant) av)
                                            (primitive/store! (primitive/field na binds) abinds)
                                            (primitive/store! (primitive/field na body) be)
                                            (al-push! [Arm] checked (primitive/load na)))
                                          (env-truncate! env saved)
                                          0)))
                                  (match (do-synth a (primitive/field arm body) (null-type) env cx tps fname)
                                    (Err [d]
                                         (do (env-truncate! env saved) (primitive/store! err d) (primitive/store! failed true) (break)))
                                    (Ok [sp0]
                                        (let [sp (alloc/stack SynPair)
                                              br (alloc/stack Branch)]
                                          (primitive/store! sp sp0)
                                          (primitive/store! (primitive/field br e) (primitive/load (primitive/field sp e)))
                                          (primitive/store! (primitive/field br t) (primitive/load (primitive/field sp t)))
                                          (al-push! [Branch] synb (primitive/load br))
                                          (al-push! [(slice u8)] metav av)
                                          (al-push! [(ptr (ArrayList (slice u8)))] metab abinds)
                                          (env-truncate! env saved)
                                          0)))))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (if (primitive/load failed) (Err [i64 Diag] (primitive/load err)) (Ok [i64 Diag] 0))))

(defn build-newarms [(a (ptr Allocator))
                     (metav (ptr (ArrayList (slice u8))))
                     (metab (ptr (ArrayList (ptr (ArrayList (slice u8))))))
                     (outl (ptr (ArrayList Expr)))] (-> (ptr (ArrayList Arm)))
  (let [nm (al-len [(slice u8)] (primitive/load metav))
        (mut newarms) (al-new [Arm] a)
        (mut j) 0]
    (loop (if (primitive/icmp-ge (primitive/load j) nm)
              (break)
              (do
                (let [na (alloc/stack Arm)]
                  (primitive/store! (primitive/field na variant) (al-get [(slice u8)] (primitive/load metav) (primitive/load j)))
                  (primitive/store! (primitive/field na binds) (al-get [(ptr (ArrayList (slice u8)))] (primitive/load metab) (primitive/load j)))
                  (primitive/store! (primitive/field na body) (al-get [Expr] (primitive/load outl) (primitive/load j)))
                  (al-push! (mut newarms) (primitive/load na)))
                (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
    (box-al [Arm] a (primitive/load newarms))))

(defn synth-match [(a (ptr Allocator))
                   (scrut (ptr Expr))
                   (arms (ptr (ArrayList Arm)))
                   (expected (ptr Type))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [ssp0 (try! (do-synth a scrut (null-type) env cx tps fname))
               ssp (alloc/stack SynPair)]
           (primitive/store! ssp ssp0)
           (let [(mut se) (primitive/load (primitive/field ssp e))
                 st0 (primitive/load (primitive/field ssp t))
                 (mut st) st0]
             (when (primitive/icmp-eq (type-tag st0) 5)
                   (let [inner (t-inner st0)]
                     (when (primitive/load (primitive/field (alloc-stack-store-sumvars a inner cx) found))
                           (primitive/store! se (box-expr a (mk-expr (ELoad (primitive/load se)) elo ehi esrc ectxt)))
                           (primitive/store! st inner)
                           0)))
             (let [svp (alloc-stack-store-sumvars a (primitive/load st) cx)]
               (when (not (primitive/load (primitive/field svp found)))
                     (break :try
                            (err-ep (derr (sconcat a
                                                   (sconcat3 a "in '" fname "': match expects a sum value, got ")
                                                   (ty-str a (primitive/load st)))))))
               (let [sumname (primitive/load (primitive/field svp name))
                     variants (primitive/load (primitive/field svp variants))]
                 (when (primitive/icmp-eq (al-len [Arm] (primitive/load arms)) 0)
                       (break :try (err-ep (derr (sconcat3 a "in '" fname "': empty match")))))
                 (let [covered (box-al [(slice u8)] a (al-new [(slice u8)] a))
                       checked (box-al [Arm] a (al-new [Arm] a))
                       synb (box-al [Branch] a (al-new [Branch] a))
                       metav (box-al [(slice u8)] a (al-new [(slice u8)] a))
                       metab (box-al [(ptr (ArrayList (slice u8)))] a (al-new [(ptr (ArrayList (slice u8)))] a))]
                   (try! (match-arms-loop a
                                          arms
                                          variants
                                          sumname
                                          expected
                                          covered
                                          checked
                                          synb
                                          metav
                                          metab
                                          env
                                          cx
                                          tps
                                          fname))
                   (when (not (primitive/icmp-eq (al-len [(slice u8)] (primitive/load covered)) (al-len [Variant] (primitive/load variants))))
                         (break ; the exhaustiveness check already knows WHICH variants are uncovered —
                                ; name them instead of just counting. For a 20-variant sum, "18 of 20"
                                ; told you nothing you didn't already know.
                                :try
                                (err-ep (derr (sconcat a
                                                       (sconcat a
                                                                (sconcat4 a
                                                                          "in '"
                                                                          fname
                                                                          "': non-exhaustive match on '"
                                                                          (sconcat a sumname "': "))
                                                                (missing-variants-str a variants covered))
                                                       " not covered")))))
                   (if (expected-some? expected)
                       (ok-ep (mk-expr (EMatch (primitive/load se) checked) elo ehi esrc ectxt) (primitive/load expected))
                       (let [outl (box-al [Expr] a (al-new [Expr] a))
                             t (try! (unify-branches a synb outl fname "match arms"))]
                         (ok-ep (mk-expr (EMatch (primitive/load se) (build-newarms a metav metab outl)) elo ehi esrc ectxt) t)))))))))))
(defn alloc-stack-store-sumvars [(a (ptr Allocator)) (t (ptr Type)) (cx (ptr Cx))] (-> (ptr SumVars))
  (let [p (unwrap-ptr [SumVars] (create [SumVars] a))] (primitive/store! p (sum-variants a t cx)) p))
; ---- loop / break / continue (cx.loops frames) ----
(defn loops-len [(cx (ptr Cx))] (-> i64)
  (al-len [LoopFrame] (primitive/load (primitive/field cx loops))))
(defn loop-label-exists [(cx (ptr Cx)) (l (slice u8))] (-> bool)
  (let [n (loops-len cx)
        (mut i) 0
        (mut r) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match-else (primitive/load (primitive/field (al-elem [LoopFrame] (primitive/field cx loops) (primitive/load i)) label))
                            (Some [fl] (when (str-eq fl l) (primitive/store! r true) (break)))
                            (_ 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn loops-rpos-label [(cx (ptr Cx)) (l (slice u8))] (-> i64)
  (let [n (loops-len cx)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (primitive/icmp-lt (primitive/load i) 0)
              (break)
              (do
                (match-else (primitive/load (primitive/field (al-elem [LoopFrame] (primitive/field cx loops) (primitive/load i)) label))
                            (Some [fl] (when (str-eq fl l) (primitive/store! at (primitive/load i)) (break)))
                            (_ 0))
                (primitive/store! i (primitive/isub (primitive/load i) 1)))))
    (primitive/load at)))

(defn label-some? [(label (Option (slice u8)))] (-> bool)
  (match-else label (Some [l] true) (_ false)))
(defn label-val [(label (Option (slice u8)))] (-> (slice u8))
  (match-else label (Some [l] l) (_ "")))
(defn run-loop-body [(a (ptr Allocator))
                     (label (Option (slice u8)))
                     (body (ptr (ArrayList Expr)))
                     (expected (ptr Type))
                     (out (ptr (ArrayList Expr)))
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))] (-> (Result Type Diag))
  (let [fr (alloc/stack LoopFrame)]
    (primitive/store! (primitive/field fr label) label)
    (primitive/store! (primitive/field fr break_ty) (None [Type]))
    (primitive/store! (primitive/field fr expected) (if (expected-some? expected) (Some (primitive/load expected)) (None [Type])))
    (al-push! [LoopFrame] (primitive/field cx loops) (primitive/load fr)))
  (let [n (al-len [Expr] (primitive/load body))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (do-synth a (al-elem [Expr] body (primitive/load i)) (null-type) env cx tps fname)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (alloc/stack SynPair)] (primitive/store! sp sp0) (al-push! [Expr] out (primitive/load (primitive/load (primitive/field sp e)))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (let [popped (al-pop! [LoopFrame] (primitive/field cx loops))]
      (if (primitive/load failed)
          (Err [Type Diag] (primitive/load err))
          (let [(mut lty) (TNever)]
            (if (expected-some? expected)
                (primitive/store! lty (primitive/load expected))
                (match-else popped
                            (Some [pf]
                                  (let [pfp (alloc/stack LoopFrame)]
                                    (primitive/store! pfp pf)
                                    (match-else (primitive/load (primitive/field pfp break_ty))
                                                (Some [bt] (primitive/store! lty bt))
                                                (_ (primitive/store! lty (TNever))))))
                            (_ (primitive/store! lty (TNever)))))
            (Ok (primitive/load lty)))))))

(defn synth-loop [(a (ptr Allocator))
                  (label (Option (slice u8)))
                  (body (ptr (ArrayList Expr)))
                  (expected (ptr Type))
                  (env (ptr (ArrayList EnvEntry)))
                  (cx (ptr Cx))
                  (tps (ptr (ArrayList (slice u8))))
                  (fname (slice u8))
                  (elo i64)
                  (ehi i64)
                  (esrc i64)
                  (ectxt i64)] (-> (Result EvalPair Diag))
  (if (and (label-some? label) (loop-label-exists cx (label-val label)))
      (err-ep (derr (sconcat1 a
                              (sconcat4 a
                                        "in '"
                                        fname
                                        "': loop label ':"
                                        (sconcat a (label-val label) "' shadows an enclosing loop with the same label")))))
      (let [outl (box-al [Expr] a (al-new [Expr] a))]
        (match (run-loop-body a label body expected outl env cx tps fname)
          (Err [d] (err-ep d))
          (Ok [lty] (ok-ep (mk-expr (ELoop label outl) elo ehi esrc ectxt) lty))))))

(defn synth-break [(a (ptr Allocator))
                   (label (Option (slice u8)))
                   (value (Option (ptr Expr)))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (when (primitive/icmp-eq (loops-len cx) 0)
               (break :try (err-ep (derr (sconcat3 a "in '" fname "': break outside of a loop")))))
         (let [idx (match-else label (Some [l] (loops-rpos-label cx l)) (_ (primitive/isub (loops-len cx) 1)))]
           (match-else label
                       (Some [l]
                             (when (primitive/icmp-lt idx 0)
                                   (break :try
                                          (err-ep (derr (sconcat a
                                                                 (sconcat4 a
                                                                           "in '"
                                                                           fname
                                                                           "': break to unknown loop label ':"
                                                                           l)
                                                                 "'"))))))
                       (_ 0))
           (let [fr (al-elem [LoopFrame] (primitive/field cx loops) idx)
                 texp (primitive/field fr expected)]
             (let [valpair (alloc/stack SynPair)
                   (mut have_val) false
                   (mut valexpr) (primitive/cast (ptr Expr) 0)
                   (mut vty) (box-type a (TInt 64 true))]
               (match value
                 (Some [vp]
                       (do
                         (primitive/store! have_val true)
                         (match-else (primitive/load texp)
                                     (Some [exp]
                                           (let [ve
                                                   (try! (check-to a vp (box-type a exp) env cx tps fname "break value"))]
                                             (primitive/store! valexpr (box-expr a ve))
                                             (primitive/store! vty (box-type a exp))
                                             0))
                                     (_ (let [vsp (try! (do-synth a vp (null-type) env cx tps fname))]
                                          (primitive/store! valpair vsp)
                                          (primitive/store! valexpr (primitive/load (primitive/field valpair e)))
                                          (primitive/store! vty (primitive/load (primitive/field valpair t)))
                                          0)))
                         0))
                 (None [] 0))
               (when (not (type-is-never (primitive/load vty)))
                     (match (primitive/load (primitive/field (al-elem [LoopFrame] (primitive/field cx loops) idx) break_ty))
                            (Some [prev]
                                  (when (not (type-eq (box-type a prev) (primitive/load vty)))
                                        (break :try
                                               (err-ep (derr (sconcat a
                                                                      (sconcat a
                                                                               (sconcat a
                                                                                        (sconcat4 a
                                                                                                  "in '"
                                                                                                  fname
                                                                                                  "': loop breaks with different value types ("
                                                                                                  (ty-str a
                                                                                                          (box-type a
                                                                                                                    prev)))
                                                                                        " vs ")
                                                                               (ty-str a (primitive/load vty)))
                                                                      ")"))))))
                            (None []
                                  (do
                                    (primitive/store! (primitive/field (al-elem [LoopFrame] (primitive/field cx loops) idx) break_ty)
                                            (Some (primitive/load (primitive/load vty))))
                                    0))))
               (ok-ep (mk-expr (EBreak label (if (primitive/load have_val) (Some (primitive/load valexpr)) (None [(ptr Expr)])))
                               elo
                               ehi
                               esrc
                               ectxt)
                      (TNever))))))))

(defn synth-continue [(a (ptr Allocator))
                      (label (Option (slice u8)))
                      (cx (ptr Cx))
                      (fname (slice u8))
                      (elo i64)
                      (ehi i64)
                      (esrc i64)
                      (ectxt i64)] (-> (Result EvalPair Diag))
  (if (primitive/icmp-eq (loops-len cx) 0)
      (err-ep (derr (sconcat3 a "in '" fname "': continue outside of a loop")))
      (match-else label
                  (Some [l]
                        (if (primitive/icmp-lt (loops-rpos-label cx l) 0)
                            (err-ep (derr (sconcat a
                                                   (sconcat4 a "in '" fname "': continue to unknown loop label ':" l)
                                                   "'")))
                            (ok-ep (mk-expr (EContinue label) elo ehi esrc ectxt) (TNever))))
                  (_ (ok-ep (mk-expr (EContinue label) elo ehi esrc ectxt) (TNever))))))

; ---- bin/cmp ----
(defn mk-branch [(e (ptr Expr)) (t (ptr Type))] (-> Branch)
  (let [p (alloc/stack Branch)] (primitive/store! (primitive/field p e) e) (primitive/store! (primitive/field p t) t) (primitive/load p)))
(defn synth-binop [(a (ptr Allocator))
                   (op i64)
                   (lhs (ptr Expr))
                   (rhs (ptr Expr))
                   (iscmp bool)
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [lsp (try! (do-synth a lhs (null-type) env cx tps fname))
               lp (alloc/stack SynPair)]
           (primitive/store! lp lsp)
           (let [rsp (try! (do-synth a rhs (null-type) env cx tps fname))
                 rp (alloc/stack SynPair)]
             (primitive/store! rp rsp)
             (let [(mut brs) (al-new [Branch] a)
                   outl (box-al [Expr] a (al-new [Expr] a))]
               (al-push! (mut brs) (mk-branch (primitive/load (primitive/field lp e)) (primitive/load (primitive/field lp t))))
               (al-push! (mut brs) (mk-branch (primitive/load (primitive/field rp e)) (primitive/load (primitive/field rp t))))
               (let [t
                       (try! (unify-branches a
                                             (box-al [Branch] a (primitive/load brs))
                                             outl
                                             fname
                                             (if iscmp "comparison" "arithmetic")))
                     tp (box-type a t)]
                 (if (not (numeric tp tps))
                     (return-from :try
                                  (err-ep (derr (sconcat a
                                                         (sconcat3 a "in '" fname "': ")
                                                         (sconcat a
                                                                  (if iscmp
                                                                      "comparison requires integers, got "
                                                                      "arithmetic requires integers, got ")
                                                                  (ty-str a tp))))))
                     (if iscmp
                         (ok-ep (mk-expr (ECmp op (al-elem [Expr] outl 0) (al-elem [Expr] outl 1)) elo ehi esrc ectxt)
                                (TBool))
                         (ok-ep (mk-expr (EBin op (al-elem [Expr] outl 0) (al-elem [Expr] outl 1)) elo ehi esrc ectxt)
                                t))))))))))

; ---- small arg-loop helpers ----
(defn synth-discard-args [(a (ptr Allocator))
                          (args (ptr (ArrayList Expr)))
                          (forbidvoid bool)
                          (voidmsg (slice u8))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [n (al-len [Expr] (primitive/load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (do-synth a (al-elem [Expr] args (primitive/load i)) (null-type) env cx tps fname)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (alloc/stack SynPair)]
                        (primitive/store! sp sp0)
                        (if (and forbidvoid (type-is-void (primitive/load (primitive/field sp t))))
                            (do (primitive/store! err (derr voidmsg)) (primitive/store! failed true) (break))
                            (al-push! (mut out) (primitive/load (primitive/load (primitive/field sp e))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [(ptr (ArrayList Expr)) Diag] (primitive/load err)) (Ok (box-al [Expr] a (primitive/load out))))))
(defn codeop-rty [(op i64)] (-> Type)
  (cond (or (primitive/icmp-eq op 40)
            (or (primitive/icmp-eq op 37)
                (or (primitive/icmp-eq op 3)
                    (or (primitive/icmp-eq op 6)
                        (or (primitive/icmp-eq op 14)
                            (or (primitive/icmp-eq op 16)
                                (or (primitive/icmp-eq op 19) (or (primitive/icmp-eq op 21) (or (primitive/icmp-eq op 22) (primitive/icmp-eq op 24))))))))))
          (TInt 64 true)
        (or (primitive/icmp-eq op 41)
            (or (primitive/icmp-eq op 43) (or (primitive/icmp-eq op 5) (or (primitive/icmp-eq op 13) (or (primitive/icmp-eq op 33) (primitive/icmp-eq op 38))))))
          (TSlice (box-type (malloc-allocator) (TInt 8 false)))
        (or (primitive/icmp-eq op 0)
            (or (primitive/icmp-eq op 1)
                (or (primitive/icmp-eq op 2)
                    (or (primitive/icmp-eq op 10)
                        (or (primitive/icmp-eq op 11)
                            (or (primitive/icmp-eq op 34) (or (primitive/icmp-eq op 45) (primitive/icmp-eq op 39))))))))
          (TBool)
        (primitive/icmp-eq op 9) (TNever)
        :else (TCode)))

(defn synth-callptr-args [(a (ptr Allocator))
                          (params (ptr (ArrayList Type)))
                          (args (ptr (ArrayList Expr)))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [n (al-len [Expr] (primitive/load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [wp (al-elem [Type] params (primitive/load i))
                      what (sconcat a "call-ptr argument " (i64->str a (primitive/iadd (primitive/load i) 1)))]
                  (match (do-synth a (al-elem [Expr] args (primitive/load i)) wp env cx tps fname)
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (alloc/stack SynPair)]
                          (primitive/store! sp sp0)
                          (match (coerce a (primitive/load (primitive/load (primitive/field sp e))) (primitive/load (primitive/field sp t)) wp false fname what)
                            (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                            (Ok [ce] (al-push! (mut out) ce)))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [(ptr (ArrayList Expr)) Diag] (primitive/load err)) (Ok (box-al [Expr] a (primitive/load out))))))
; ---- per-arm helpers for the complex variants ----
(defn synth-do [(a (ptr Allocator))
                (body (ptr (ArrayList Expr)))
                (expected (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))
                (elo i64)
                (ehi i64)
                (esrc i64)
                (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [outl (box-al [Expr] a (al-new [Expr] a))
               last (try! (synth-let-body a body expected outl env cx tps fname "do result"))]
           (ok-ep (mk-expr (EDo outl) elo ehi esrc ectxt) last)))))

(defn synth-if [(a (ptr Allocator))
                (cnd (ptr Expr))
                (thn (ptr Expr))
                (els (ptr Expr))
                (expected (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))
                (elo i64)
                (ehi i64)
                (esrc i64)
                (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [csp0 (try! (do-synth a cnd (null-type) env cx tps fname))
               csp (alloc/stack SynPair)]
           (primitive/store! csp csp0)
           (when (not (is-cond (primitive/load (primitive/field csp t))))
                 (break :try
                        (err-ep (derr (sconcat a
                                               (sconcat3 a
                                                         "in '"
                                                         fname
                                                         "': if condition must be a bool or integer, got ")
                                               (ty-str a (primitive/load (primitive/field csp t))))))))
           (if (expected-some? expected)
               (let [te (try! (check-to a thn expected env cx tps fname "if branch"))
                     ee (try! (check-to a els expected env cx tps fname "if branch"))]
                 (ok-ep (mk-expr (EIf (primitive/load (primitive/field csp e)) (box-expr a te) (box-expr a ee)) elo ehi esrc ectxt)
                        (primitive/load expected)))
               (let [tsp0 (try! (do-synth a thn (null-type) env cx tps fname))
                     tsp (alloc/stack SynPair)]
                 (primitive/store! tsp tsp0)
                 (let [esp0 (try! (do-synth a els (null-type) env cx tps fname))
                       esp (alloc/stack SynPair)]
                   (primitive/store! esp esp0)
                   (let [(mut brs) (al-new [Branch] a)
                         outl (box-al [Expr] a (al-new [Expr] a))]
                     (al-push! (mut brs) (mk-branch (primitive/load (primitive/field tsp e)) (primitive/load (primitive/field tsp t))))
                     (al-push! (mut brs) (mk-branch (primitive/load (primitive/field esp e)) (primitive/load (primitive/field esp t))))
                     (let [t (try! (unify-branches a (box-al [Branch] a (primitive/load brs)) outl fname "if branches"))]
                       (ok-ep (mk-expr (EIf (primitive/load (primitive/field csp e)) (al-elem [Expr] outl 0) (al-elem [Expr] outl 1))
                                       elo
                                       ehi
                                       esrc
                                       ectxt)
                              t))))))))))

(defn synth-field [(a (ptr Allocator))
                   (pp (ptr Expr))
                   (ffld (slice u8))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [psp (try! (do-synth a pp (null-type) env cx tps fname))
               sp (alloc/stack SynPair)]
           (primitive/store! sp psp)
           (let [pt (primitive/load (primitive/field sp t))
                 pointee (place-pointee pt)]
             (when (primitive/icmp-eq (primitive/cast i64 pointee) 0)
                   (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat3 a
                                                           "in '"
                                                           fname
                                                           "': field access needs a pointer or reference, got ")
                                                 (ty-str a pt))))))
             (when (not (is-struct-or-app pointee))
                   (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat3 a
                                                           "in '"
                                                           fname
                                                           "': field access needs a pointer to a struct, got (ptr ")
                                                 (sconcat a (ty-str a pointee) ")"))))))
             (let [sname (struct-name pointee)
                   si (struct-find cx sname)]
               (when (and (primitive/icmp-ne (primitive/cast i64 si) 0) (primitive/load (primitive/field si is_bits)))
                     (break :try
                            (err-ep (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat a
                                                                     (sconcat a
                                                                              (sconcat5 a
                                                                                        "in '"
                                                                                        fname
                                                                                        "': '"
                                                                                        sname
                                                                                        "' is a :layout bits struct; use (primitive/bit-get p ")
                                                                              ffld)
                                                                     ") / (primitive/bit-set! p ")
                                                            ffld)
                                                   " v)")))))
               (match (struct-fields a pointee cx)
                 (Err [d] (return-from :try (err-ep (prefix-diag a d (sconcat4 a "in '" fname "': " "")))))
                 (Ok [fs]
                     (let [nf (al-len [Field] (primitive/load fs))
                           (mut i) 0
                           (mut fty) (primitive/cast (ptr Type) 0)]
                       (loop (if (primitive/icmp-ge (primitive/load i) nf)
                                 (break)
                                 (do
                                   (when (str-eq (primitive/load (primitive/field (al-elem [Field] fs (primitive/load i)) name)) ffld)
                                         (primitive/store! fty (primitive/field (al-elem [Field] fs (primitive/load i)) ty))
                                         (break))
                                   (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                       (when (primitive/icmp-eq (primitive/cast i64 (primitive/load fty)) 0)
                             (break :try
                                    (err-ep (derr (sconcat a
                                                           (sconcat a
                                                                    (sconcat4 a
                                                                              "in '"
                                                                              fname
                                                                              "': struct '"
                                                                              (sconcat a sname "' has no field '"))
                                                                    ffld)
                                                           "'")))))
                       (ok-ep (mk-expr (EField (primitive/load (primitive/field sp e)) ffld) elo ehi esrc ectxt) (replace-pointee a pt fty)))))))))))

(defn synth-store [(a (ptr Allocator))
                   (pp (ptr Expr))
                   (val (ptr Expr))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [psp (try! (do-synth a pp (null-type) env cx tps fname))
               sp (alloc/stack SynPair)]
           (primitive/store! sp psp)
           (let [pt (primitive/load (primitive/field sp t))
                 pointee (place-pointee pt)]
             (when (primitive/icmp-eq (primitive/cast i64 pointee) 0)
                   (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat3 a
                                                           "in '"
                                                           fname
                                                           "': store! expects a pointer or reference, got ")
                                                 (ty-str a pt))))))
             (when (not (is-writable pt))
                   (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat a
                                                          (sconcat4 a
                                                                    "in '"
                                                                    fname
                                                                    "': cannot store! through immutable reference of type "
                                                                    (ty-str a pt))
                                                          " (declare it `(mut …)` to make it writable)")
                                                 "")))))
             (let [vsp (try! (do-synth a val pointee env cx tps fname))
                   vp (alloc/stack SynPair)]
               (primitive/store! vp vsp)
               (match (coerce a (primitive/load (primitive/load (primitive/field vp e))) (primitive/load (primitive/field vp t)) pointee false fname "store! value")
                 (Err [d] (return-from :try (err-ep d)))
                 ; std-12: store! is effect-only — it yields unit (canonical i64 0), not the
                 ; stored value's type, so an effect-only `if`/block no longer type-mismatches.
                 (Ok [ve]
                     (ok-ep (mk-expr (EStore (primitive/load (primitive/field sp e)) (box-expr a ve)) elo ehi esrc ectxt) (TInt 64 true))))))))))

(defn synth-index [(a (ptr Allocator))
                   (pp (ptr Expr))
                   (idx (ptr Expr))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [psp (try! (do-synth a pp (null-type) env cx tps fname))
               sp (alloc/stack SynPair)]
           (primitive/store! sp psp)
           (let [isp (try! (do-synth a idx (null-type) env cx tps fname))
                 ip (alloc/stack SynPair)]
             (primitive/store! ip isp)
             (let [ie
                     (match (coerce a
                                    (primitive/load (primitive/load (primitive/field ip e)))
                                    (primitive/load (primitive/field ip t))
                                    (box-type a (TInt 64 true))
                                    false
                                    fname
                                    "index")
                       (Err [_] (return-from :try (err-ep (derr (sconcat3 a "in '" fname "': index must be i64")))))
                       (Ok [ce] ce))
                   pt (primitive/load (primitive/field sp t))
                   pointee (place-pointee pt)]
               (when (primitive/icmp-eq (primitive/cast i64 pointee) 0)
                     (break :try
                            (err-ep (derr (sconcat a
                                                   (sconcat3 a
                                                             "in '"
                                                             fname
                                                             "': index expects a pointer or reference, got ")
                                                   (ty-str a pt))))))
               (let [elem (if (primitive/icmp-eq (type-tag pointee) 7) (t-inner pointee) pointee)]
                 (ok-ep (mk-expr (EIndex (primitive/load (primitive/field sp e)) (box-expr a ie)) elo ehi esrc ectxt)
                        (replace-pointee a pt elem)))))))))

(defn synth-cast [(a (ptr Allocator))
                  (ty Type)
                  (inner (ptr Expr))
                  (env (ptr (ArrayList EnvEntry)))
                  (cx (ptr Cx))
                  (tps (ptr (ArrayList (slice u8))))
                  (fname (slice u8))
                  (elo i64)
                  (ehi i64)
                  (esrc i64)
                  (ectxt i64)] (-> (Result EvalPair Diag))
  (let [tp (box-type a ty)]
    (match (validate-type tp cx tps)
      (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': cast target: "))))
      (Ok [_]
          (match (do-synth a inner (null-type) env cx tps fname)
            (Err [d] (err-ep d))
            (Ok [sp0]
                (let [sp (alloc/stack SynPair)]
                  (primitive/store! sp sp0)
                  (let [et (primitive/load (primitive/field sp t))
                        tt (type-tag tp)
                        etg (type-tag et)
                        ok
                          (or (and (primitive/icmp-eq tt 0) (primitive/icmp-eq etg 0))
                              (or (and (primitive/icmp-eq tt 4) (primitive/icmp-eq etg 4))
                                  (or (and (primitive/icmp-eq tt 0) (primitive/icmp-eq etg 4))
                                      (or (and (primitive/icmp-eq tt 4) (primitive/icmp-eq etg 0))
                                          (or (and (primitive/icmp-eq tt 1) (primitive/icmp-eq etg 1))
                                              (or (and (primitive/icmp-eq tt 1) (primitive/icmp-eq etg 0))
                                                  (or (and (primitive/icmp-eq tt 0) (primitive/icmp-eq etg 1))
                                                      (or (and (primitive/icmp-eq tt 10) (primitive/icmp-eq etg 10))
                                                          (or (and (primitive/icmp-eq tt 10) (primitive/icmp-eq etg 4))
                                                              (and (primitive/icmp-eq tt 4) (primitive/icmp-eq etg 10)))))))))))]
                    (if ok
                        (ok-ep (mk-expr (ECast ty (primitive/load (primitive/field sp e))) elo ehi esrc ectxt) ty)
                        (err-ep (derr (sconcat a
                                               (sconcat a
                                                        (sconcat a
                                                                 (sconcat4 a
                                                                           "in '"
                                                                           fname
                                                                           "': cast only converts among int, float, and ptr (got "
                                                                           (ty-str a et))
                                                                 " to ")
                                                        (ty-str a tp))
                                               ")"))))))))))))

(defn synth-offsetof [(a (ptr Allocator))
                      (ty Type)
                      (ffld (slice u8))
                      (cx (ptr Cx))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))
                      (elo i64)
                      (ehi i64)
                      (esrc i64)
                      (ectxt i64)] (-> (Result EvalPair Diag))
  (let [tp (box-type a ty)]
    (match (validate-type tp cx tps)
      (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': offsetof: "))))
      (Ok [_]
          (match (struct-fields a tp cx)
            (Err [_]
                 (err-ep (derr (sconcat a
                                        (sconcat3 a "in '" fname "': offsetof needs a struct type, got ")
                                        (ty-str a tp)))))
            (Ok [fs]
                (let [nf (al-len [Field] (primitive/load fs))
                      (mut i) 0
                      (mut found) false]
                  (loop (if (primitive/icmp-ge (primitive/load i) nf)
                            (break)
                            (do
                              (when (str-eq (primitive/load (primitive/field (al-elem [Field] fs (primitive/load i)) name)) ffld)
                                    (primitive/store! found true)
                                    (break))
                              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                  (if (not (primitive/load found))
                      (err-ep (derr (sconcat a
                                             (sconcat a
                                                      (sconcat a
                                                               (sconcat4 a
                                                                         "in '"
                                                                         fname
                                                                         "': offsetof: struct '"
                                                                         (struct-name tp))
                                                               "' has no field '")
                                                      ffld)
                                             "'")))
                      (ok-ep (mk-expr (EOffsetOf ty ffld) elo ehi esrc ectxt) (TInt 64 true))))))))))

(defn synth-fnptr [(a (ptr Allocator))
                   (name (slice u8))
                   (cx (ptr Cx))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (let [sig (sig-find cx name)]
    (cond (primitive/icmp-eq (primitive/cast i64 sig) 0)
            (err-ep (derr (sconcat a (sconcat4 a "in '" fname "': fnptr-of unknown function '" name) "'")))
          (primitive/icmp-gt (al-len [(slice u8)] (primitive/load (primitive/field sig type_params))) 0)
            (err-ep (derr (sconcat a
                                   (sconcat4 a
                                             "in '"
                                             fname
                                             "': cannot take a function pointer to generic function '"
                                             name)
                                   "'")))
          (not (primitive/load (primitive/field sig fnptr_ok)))
            (err-ep (derr (sconcat a
                                   (sconcat4 a "in '" fname "': cannot take a function pointer to '" name)
                                   "' (shim-convention functions are not supported yet)")))
          :else
            (ok-ep (mk-expr (EFnPtrOf name) elo ehi esrc ectxt)
                   (TFn (primitive/load (primitive/field sig cc)) (primitive/load (primitive/field sig params)) (box-type a (primitive/load (primitive/field sig ret))))))))

(defn synth-callptr [(a (ptr Allocator))
                     (fp (ptr Expr))
                     (args (ptr (ArrayList Expr)))
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))
                     (elo i64)
                     (ehi i64)
                     (esrc i64)
                     (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [fsp (try! (do-synth a fp (null-type) env cx tps fname))
               sp (alloc/stack SynPair)]
           (primitive/store! sp fsp)
           (let [ft (primitive/load (primitive/field sp t))]
             (when (not (primitive/icmp-eq (type-tag ft) 10))
                   (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat3 a
                                                           "in '"
                                                           fname
                                                           "': call-ptr expects a function pointer, got ")
                                                 (ty-str a ft))))))
             (let [params (t-fn-params ft)
                   ret (t-fn-ret ft)]
               (when (not (primitive/icmp-eq (al-len [Type] (primitive/load params)) (al-len [Expr] (primitive/load args))))
                     (break :try
                            (err-ep (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat a
                                                                     (sconcat4 a
                                                                               "in '"
                                                                               fname
                                                                               "': function pointer expects "
                                                                               (i64->str a
                                                                                         (al-len [Type]
                                                                                                 (primitive/load params))))
                                                                     " args, got ")
                                                            (i64->str a (al-len [Expr] (primitive/load args))))
                                                   "")))))
               (let [na (try! (synth-callptr-args a params args env cx tps fname))]
                 (ok-ep (mk-expr (ECallPtr (primitive/load (primitive/field sp e)) na) elo ehi esrc ectxt) (primitive/load ret)))))))))

; ============================ synth_inner =================
(defn synth-inner [(a (ptr Allocator))
                   (e (ptr Expr))
                   (expected (ptr Type))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))] (-> (Result EvalPair Diag))
  (let [elo (primitive/load (primitive/field e lo))
        ehi (primitive/load (primitive/field e hi))
        esrc (primitive/load (primitive/field e source))
        ectxt (primitive/load (primitive/field e ctxt))]
    (match (primitive/load (primitive/field e kind))
      (EInt [v] (ok-ep (mk-expr (EInt v) elo ehi esrc ectxt) (TInt 64 true)))
      (EFloat [bits] (ok-ep (mk-expr (EFloat bits) elo ehi esrc ectxt) (TFloat 64)))
      (EBool [b] (ok-ep (mk-expr (EBool b) elo ehi esrc ectxt) (TBool)))
      (EStr [s] (ok-ep (mk-expr (EStr s) elo ehi esrc ectxt) (TSlice (box-type a (TInt 8 false)))))
      (ECStr [s] (ok-ep (mk-expr (ECStr s) elo ehi esrc ectxt) (TPtr (box-type a (TInt 8 true)))))
      (EZeroed [ty]
               (let [tp (box-type a ty)]
                 (match (validate-type tp cx tps)
                   (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': zeroed: "))))
                   (Ok [_] (ok-ep (mk-expr (EZeroed ty) elo ehi esrc ectxt) ty)))))
      (EBorrow [mutable place]
               (match (do-synth a place (null-type) env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [sp0]
                     (let [sp (alloc/stack SynPair)]
                       (primitive/store! sp sp0)
                       (let [pt (primitive/load (primitive/field sp t))
                             pointee (place-pointee pt)]
                         (if (primitive/icmp-eq (primitive/cast i64 pointee) 0)
                             (err-ep (derr (sconcat a
                                                    (sconcat3 a "in '" fname "': cannot borrow a non-place of type ")
                                                    (ty-str a pt))))
                             (if (and mutable (not (is-writable pt)))
                                 (err-ep (derr (sconcat a
                                                        (sconcat a
                                                                 (sconcat4 a
                                                                           "in '"
                                                                           fname
                                                                           "': cannot take a mutable borrow of immutable '"
                                                                           (ty-str a pt))
                                                                 "'")
                                                        "")))
                                 (ok-ep (primitive/load (primitive/load (primitive/field sp e))) (TRef mutable (box-type a (primitive/load pointee)))))))))))
      (EVar [name]
            (let [te (env-get env name)]
              (if (primitive/icmp-ne (primitive/cast i64 te) 0)
                  (ok-ep (mk-expr (EVar name) elo ehi esrc ectxt) (primitive/load te))
                  (let [ce (const-find cx name)]
                    (if (primitive/icmp-ne (primitive/cast i64 ce) 0)
                        (if (set-contains (primitive/field cx static_consts) name)
                            (ok-ep (mk-expr (EStaticRef name) elo ehi esrc ectxt)
                                   (TRef false (box-type a (primitive/load (primitive/field ce ty)))))
                            (if (is-literal-value (primitive/field ce value))
                                (ok-ep (mk-expr (primitive/load (primitive/field (primitive/field ce value) kind)) elo ehi esrc ectxt)
                                       (primitive/load (primitive/field ce ty)))
                                (ok-ep (mk-expr (EComptime (box-expr a (primitive/load (primitive/field ce value)))) elo ehi esrc ectxt)
                                       (primitive/load (primitive/field ce ty)))))
                        (err-ep (derr (sconcat a (sconcat4 a "in '" fname "': unbound variable '" name) "'"))))))))
      (ELlvmIr [result args body]
               (let [rp (box-type a result)]
                 (match (validate-type rp cx tps)
                   (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': llvm-ir result type: "))))
                   (Ok [_]
                       (match (synth-discard-args a
                                                  args
                                                  true
                                                  (sconcat3 a
                                                            "in '"
                                                            fname
                                                            "': llvm-ir operand uses a void value (a (-> void) call yields nothing)")
                                                  env
                                                  cx
                                                  tps
                                                  fname)
                         (Err [d] (err-ep d))
                         (Ok [eargs] (ok-ep (mk-expr (ELlvmIr result eargs body) elo ehi esrc ectxt) result)))))))
      (ETraitCall [trait_name method self_tp args]
                  (err-ep (derr (sconcat a
                                         (sconcat4 a "in '" fname "': internal: unresolved trait call '" method)
                                         "' in input"))))
      (EComptime [inner]
                 (match (do-synth a inner expected env cx tps fname)
                   (Err [d] (err-ep d))
                   (Ok [sp0]
                       (let [sp (alloc/stack SynPair)]
                         (primitive/store! sp sp0)
                         (ok-ep (mk-expr (EComptime (primitive/load (primitive/field sp e))) elo ehi esrc ectxt) (primitive/load (primitive/load (primitive/field sp t))))))))
      ; Type ascription `(: value type)`: check `inner` against `ty` (so a stranded type
      ; arg can be supplied and any legal coercion applies), then LOWER it away — the
      ; result is the coerced inner value at `ty`, so no EAscribe node reaches mono/codegen.
      (EAscribe [ty inner]
                (let [tp (box-type a ty)]
                  (match (validate-type tp cx tps)
                    (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': type ascription: "))))
                    (Ok [_]
                        (match (check-to a inner tp env cx tps fname "ascribed value")
                          (Err [d] (err-ep d))
                          (Ok [ce] (ok-ep ce (primitive/load tp))))))))
      (EStaticRef [name]
                  (err-ep (derr (sconcat a
                                         (sconcat4 a "in '" fname "': internal: unexpected static-ref '" name)
                                         "' in input"))))
      (ETypeQuery [q ty]
                  (let [tp (box-type a ty)]
                    (match (validate-type tp cx tps)
                      (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': type reflection: "))))
                      (Ok [_]
                          (ok-ep (mk-expr (ETypeQuery q ty) elo ehi esrc ectxt)
                                 (if (primitive/icmp-le q 1) (TInt 64 true) (TBool)))))))
      (EFieldMeta [meta ty idx]
                  (let [tp (box-type a ty)]
                    (match (validate-type tp cx tps)
                      (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': field reflection: "))))
                      (Ok [_]
                          (match (do-synth a idx (box-type a (TInt 64 true)) env cx tps fname)
                            (Err [d] (err-ep d))
                            (Ok [sp0]
                                (let [sp (alloc/stack SynPair)]
                                  (primitive/store! sp sp0)
                                  (if (not (type-is-int (primitive/load (primitive/field sp t))))
                                      (err-ep (derr (sconcat a
                                                             (sconcat3 a
                                                                       "in '"
                                                                       fname
                                                                       "': field index must be an integer, got ")
                                                             (ty-str a (primitive/load (primitive/field sp t))))))
                                      (ok-ep (mk-expr (EFieldMeta meta ty (primitive/load (primitive/field sp e))) elo ehi esrc ectxt)
                                             (if (primitive/icmp-eq meta 1) (TInt 64 true) (TSlice (box-type a (TInt 8 false)))))))))))))
      (EQuote [form] (ok-ep (mk-expr (EQuote form) elo ehi esrc ectxt) (TCode)))
      (EQuasi [q]
              (let [qp (alloc/stack Quasi)]
                (primitive/store! qp q)
                (match (check-quasi a qp env cx tps fname)
                  (Err [d] (err-ep d))
                  (Ok [nq] (ok-ep (mk-expr (EQuasi nq) elo ehi esrc ectxt) (TCode))))))
      (ECodeOp [op args]
               (match (synth-discard-args a args false "" env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [na] (ok-ep (mk-expr (ECodeOp op na) elo ehi esrc ectxt) (codeop-rty op)))))
      (EFieldIndex [ty name]
                   (let [tp (box-type a ty)]
                     (match (validate-type tp cx tps)
                       (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': field-index: "))))
                       (Ok [_]
                           (match (do-synth a name (null-type) env cx tps fname)
                             (Err [d] (err-ep d))
                             (Ok [sp0]
                                 (let [sp (alloc/stack SynPair)]
                                   (primitive/store! sp sp0)
                                   (if (not (primitive/icmp-eq (type-tag (primitive/load (primitive/field sp t))) 8))
                                       (err-ep (derr (sconcat a
                                                              (sconcat3 a
                                                                        "in '"
                                                                        fname
                                                                        "': field-index name must be a string, got ")
                                                              (ty-str a (primitive/load (primitive/field sp t))))))
                                       (ok-ep (mk-expr (EFieldIndex ty (primitive/load (primitive/field sp e))) elo ehi esrc ectxt)
                                              (TInt 64 true))))))))))
      (EBin [op lhs rhs] (synth-binop a op lhs rhs false env cx tps fname elo ehi esrc ectxt))
      (ENot [inner]
            (match (do-synth a inner (null-type) env cx tps fname)
              (Err [d] (err-ep d))
              (Ok [sp0]
                  (let [sp (alloc/stack SynPair)]
                    (primitive/store! sp sp0)
                    (if (not (numeric (primitive/load (primitive/field sp t)) tps))
                        (err-ep (derr (sconcat a
                                               (sconcat3 a "in '" fname "': inot requires an integer, got ")
                                               (ty-str a (primitive/load (primitive/field sp t))))))
                        (ok-ep (mk-expr (ENot (primitive/load (primitive/field sp e))) elo ehi esrc ectxt) (primitive/load (primitive/load (primitive/field sp t)))))))))
      (ECmp [op lhs rhs] (synth-binop a op lhs rhs true env cx tps fname elo ehi esrc ectxt))
      (ELoop [label body] (synth-loop a label body expected env cx tps fname elo ehi esrc ectxt))
      (EBreak [label value] (synth-break a label value env cx tps fname elo ehi esrc ectxt))
      (EContinue [label] (synth-continue a label cx fname elo ehi esrc ectxt))
      (EIf [cnd thn els] (synth-if a cnd thn els expected env cx tps fname elo ehi esrc ectxt))
      (EDo [body] (synth-do a body expected env cx tps fname elo ehi esrc ectxt))
      (ELet [binds body] (synth-let a binds body expected env cx tps fname elo ehi esrc ectxt))
      (ECall [func type_args args] (synth-call a func type_args args expected env cx tps fname elo ehi esrc ectxt))
      (EAlloc [storage ty]
              (let [tp (box-type a ty)]
                (match (validate-type tp cx tps)
                  (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': alloc: "))))
                  (Ok [_] (ok-ep (mk-expr (EAlloc storage ty) elo ehi esrc ectxt) (TPtr (box-type a ty)))))))
      (EField [pp ffld] (synth-field a pp ffld env cx tps fname elo ehi esrc ectxt))
      (ELoad [inner]
             (match (do-synth a inner (null-type) env cx tps fname)
               (Err [d] (err-ep d))
               (Ok [sp0]
                   (let [sp (alloc/stack SynPair)]
                     (primitive/store! sp sp0)
                     (let [pp (place-pointee (primitive/load (primitive/field sp t)))]
                       (if (primitive/icmp-ne (primitive/cast i64 pp) 0)
                           (ok-ep (mk-expr (ELoad (primitive/load (primitive/field sp e))) elo ehi esrc ectxt) (primitive/load pp))
                           (err-ep (derr (sconcat a
                                                  (sconcat3 a
                                                            "in '"
                                                            fname
                                                            "': load expects a pointer or reference, got ")
                                                  (ty-str a (primitive/load (primitive/field sp t))))))))))))
      (EStore [pp val] (synth-store a pp val env cx tps fname elo ehi esrc ectxt))
      (EIndex [pp idx] (synth-index a pp idx env cx tps fname elo ehi esrc ectxt))
      (ECast [ty inner] (synth-cast a ty inner env cx tps fname elo ehi esrc ectxt))
      (ESizeOf [ty]
               (let [tp (box-type a ty)]
                 (match (validate-type tp cx tps)
                   (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': sizeof: "))))
                   (Ok [_] (ok-ep (mk-expr (ESizeOf ty) elo ehi esrc ectxt) (TInt 64 true))))))
      (EAlignOf [ty]
                (let [tp (box-type a ty)]
                  (match (validate-type tp cx tps)
                    (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': alignof: "))))
                    (Ok [_] (ok-ep (mk-expr (EAlignOf ty) elo ehi esrc ectxt) (TInt 64 true))))))
      (EOffsetOf [ty ffld] (synth-offsetof a ty ffld cx tps fname elo ehi esrc ectxt))
      (EBitGet [pp bfld]
               (match (bit-field-type a pp bfld env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [sp0]
                     (let [sp (alloc/stack SynPair)]
                       (primitive/store! sp sp0)
                       (ok-ep (mk-expr (EBitGet (primitive/load (primitive/field sp e)) bfld) elo ehi esrc ectxt)
                              (primitive/load (primitive/load (primitive/field sp t))))))))
      (EBitSet [pp bfld val]
               (match (bit-field-type a pp bfld env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [sp0]
                     (let [sp (alloc/stack SynPair)]
                       (primitive/store! sp sp0)
                       (let [fty (primitive/load (primitive/field sp t))]
                         (match (do-synth a val fty env cx tps fname)
                           (Err [d] (err-ep d))
                           (Ok [vsp0]
                               (let [vsp (alloc/stack SynPair)]
                                 (primitive/store! vsp vsp0)
                                 (match (coerce a
                                                (primitive/load (primitive/load (primitive/field vsp e)))
                                                (primitive/load (primitive/field vsp t))
                                                fty
                                                false
                                                fname
                                                (sconcat a (sconcat3 a "set! into bitfield '" bfld "'") ""))
                                   (Err [d] (err-ep d))
                                   (Ok [ve]
                                       (ok-ep (mk-expr (EBitSet (primitive/load (primitive/field sp e)) bfld (box-expr a ve))
                                                       elo
                                                       ehi
                                                       esrc
                                                       ectxt)
                                              (primitive/load fty))))))))))))
      (EFree [inner]
             (match (do-synth a inner (null-type) env cx tps fname)
               (Err [d] (err-ep d))
               (Ok [sp0]
                   (let [sp (alloc/stack SynPair)]
                     (primitive/store! sp sp0)
                     (if (type-is-ptr (primitive/load (primitive/field sp t)))
                         (ok-ep (mk-expr (EFree (primitive/load (primitive/field sp e))) elo ehi esrc ectxt) (TInt 64 true))
                         (err-ep (derr (sconcat a
                                                (sconcat3 a "in '" fname "': free expects a pointer, got ")
                                                (ty-str a (primitive/load (primitive/field sp t)))))))))))
      (EErase [trait_name inner]
              (match (do-synth a inner (null-type) env cx tps fname)
                (Err [d] (err-ep d))
                (Ok [sp0]
                    (let [sp (alloc/stack SynPair)]
                      (primitive/store! sp sp0)
                      (match (build-make-dyn a
                                             cx
                                             trait_name
                                             (primitive/load (primitive/field sp e))
                                             (primitive/load (primitive/field sp t))
                                             elo
                                             ehi
                                             esrc
                                             ectxt
                                             fname)
                        (Err [d] (err-ep d))
                        (Ok [mp0]
                            (let [mp (alloc/stack SynPair)]
                              (primitive/store! mp mp0)
                              (ok-ep (primitive/load (primitive/load (primitive/field mp e))) (primitive/load (primitive/load (primitive/field mp t)))))))))))
      (EMatch [scrut arms] (synth-match a scrut arms expected env cx tps fname elo ehi esrc ectxt))
      (EFnPtrOf [name] (synth-fnptr a name cx fname elo ehi esrc ectxt))
      (ECallPtr [fp args] (synth-callptr a fp args env cx tps fname elo ehi esrc ectxt))
      (EConstruct [sum variant args]
                  (match (synth-construct a
                                          variant
                                          (box-items-type a)
                                          args
                                          (null-type)
                                          env
                                          cx
                                          tps
                                          fname
                                          elo
                                          ehi
                                          esrc
                                          ectxt)
                    (Err [d] (err-ep d))
                    (Ok [rv] (let [r (alloc/stack EvalPair)] (primitive/store! r rv) (ok-ep (primitive/load (primitive/field r e)) (TStruct sum))))))
      (EMakeDyn [dyn_struct vtable_struct methods inner] (ok-ep (primitive/load e) (TStruct dyn_struct)))
      (EDynDispatch [ds vt mi cc params ret recv args] (ok-ep (primitive/load e) ret))
      (ESpillRef [inner] (err-ep (derr (sconcat3 a "in '" fname "': internal: SpillRef in input")))))))

; synth — span-fill + auto dyn-coercion wrapper.
(defn synth [(a (ptr Allocator))
             (e (ptr Expr))
             (expected (ptr Type))
             (env (ptr (ArrayList EnvEntry)))
             (cx (ptr Cx))
             (tps (ptr (ArrayList (slice u8))))
             (fname (slice u8))] (-> (Result EvalPair Diag))
  (let [dynt (if (expected-some? expected) (is-dyn-target expected cx) false)]
    (match (synth-inner a e expected env cx tps fname)
      (Err [d]
           (err-ep (dwspan d (primitive/load (primitive/field e source)) (primitive/load (primitive/field e lo)) (primitive/load (primitive/field e hi)) (primitive/load (primitive/field e ctxt)))))
      (Ok [rv]
          (if (not dynt)
              (Ok [EvalPair Diag] rv)
              (let [r (alloc/stack EvalPair)]
                (primitive/store! r rv)
                (match (maybe-coerce-dyn a
                                         cx
                                         (box-expr a (primitive/load (primitive/field r e)))
                                         (box-type a (primitive/load (primitive/field r t)))
                                         expected
                                         (primitive/load (primitive/field e lo))
                                         (primitive/load (primitive/field e hi))
                                         (primitive/load (primitive/field e source))
                                         (primitive/load (primitive/field e ctxt))
                                         fname)
                  (Err [d] (err-ep d))
                  (Ok [mp0]
                      (let [mp (alloc/stack SynPair)]
                        (primitive/store! mp mp0)
                        (ok-ep (primitive/load (primitive/load (primitive/field mp e))) (primitive/load (primitive/load (primitive/field mp t)))))))))))))

; ============================ finish (Phase 3) =====================
; Static-assert conditions are synth'd + is-cond-checked. The comptime fold
; (comptime::fold_program), aggregate-const statics, (meta …) elaboration, and
; export-c symbol resolution are a separate unported subsystem: finish passes
; funcs through unchanged (a no-op fold for comptime-free programs — any program
; that actually USES comptime will then mismatch the reference and fail the gate,
; never silently pass), and hard-errors on (meta …)/(export-c …) which the dump
; would otherwise misrepresent. Aggregate-const statics do not affect the dump
; (the dumper hardcodes an empty (statics) section), so static_consts are ignored.
(defn finish-asserts [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result (ptr (ArrayList StaticAssert))
                                                                                          Diag))
  (let [as (primitive/load (primitive/field prog asserts))
        n (al-len [StaticAssert] (primitive/load as))
        (mut out) (al-new [StaticAssert] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false
        empty-tps (box-al [(slice u8)] a (al-new [(slice u8)] a))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ap (al-elem [StaticAssert] as (primitive/load i))
                      env (env-new a)]
                  (match (do-synth a (primitive/field ap cnd) (null-type) env cx empty-tps "static-assert")
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (alloc/stack SynPair)]
                          (primitive/store! sp sp0)
                          (if (not (is-cond (primitive/load (primitive/field sp t))))
                              (do
                                (primitive/store! err
                                        (derr (sconcat a
                                                       "static-assert: condition must be a bool or integer, got "
                                                       (ty-str a (primitive/load (primitive/field sp t))))))
                                (primitive/store! failed true)
                                (break))
                              (let [na (alloc/stack StaticAssert)]
                                (primitive/store! (primitive/field na cnd) (primitive/load (primitive/load (primitive/field sp e))))
                                (primitive/store! (primitive/field na msg) (primitive/load (primitive/field ap msg)))
                                (al-push! (mut out) (primitive/load na))
                                0))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [(ptr (ArrayList StaticAssert)) Diag] (primitive/load err)) (Ok (box-al [StaticAssert] a (primitive/load out))))))

; ---- finish: (meta …) elaboration + (export-c …) symbol resolution ----
; display_name: strip the auto-referred coil.core. prefix in diagnostics.
(defn display-name [(n (slice u8))] (-> (slice u8))
  (let [pfx "coil.core."
        pl (slice-len pfx)]
    (if (and (primitive/icmp-ge (slice-len n) pl) (str-eq (subslice n 0 pl) pfx)) (subslice n pl (slice-len n)) n)))
; whether convention `cc` uses a :shim lowering (the C ABI needs a native lowering).
(defn conv-cc-is-shim [(cx (ptr Cx)) (cc (slice u8))] (-> bool)
  (let [cv (conv-find cx cc)] (and (primitive/icmp-ne (primitive/cast i64 cv) 0) (conv-is-shim cv))))
; a valid export-c PARAMETER type: scalars/ptr, or a C-layout struct (not a defsum).
(defn export-param-ok [(cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [tg (type-tag t)]  ; tg 14 = externref (a wasm reference scalar)
    (if (or (primitive/icmp-eq tg 14) (or (primitive/icmp-eq tg 0) (or (primitive/icmp-eq tg 1) (or (primitive/icmp-eq tg 2) (primitive/icmp-eq tg 4)))))
        true
        (if (primitive/icmp-eq tg 6) (primitive/icmp-eq (primitive/cast i64 (sum-find cx (type-struct-name t))) 0) false))))
; a valid export-c RETURN type: scalars/ptr/void, or a C-layout struct/App (not a defsum).
(defn export-ret-ok [(cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [tg (type-tag t)]  ; tg 14 = externref (a wasm reference scalar)
    (if (or (primitive/icmp-eq tg 14)
            (or (primitive/icmp-eq tg 0) (or (primitive/icmp-eq tg 1) (or (primitive/icmp-eq tg 2) (or (primitive/icmp-eq tg 3) (primitive/icmp-eq tg 4))))))
        true
        (if (or (primitive/icmp-eq tg 6) (primitive/icmp-eq tg 11))
            (primitive/icmp-eq (primitive/cast i64 (sum-find cx (if (primitive/icmp-eq tg 6) (type-struct-name t) (t-app-name t)))) 0)
            false))))
; the default C symbol: bare name (module dropped) with `-` -> `_`.
(defn default-c-symbol [(a (ptr Allocator)) (qualified (slice u8))] (-> (slice u8))
  (let [base (last-component qualified)
        n (slice-len base)
        (mut buf) (al-new [u8] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [c (slice-get base (primitive/load i))] (al-push! (mut buf) (if (primitive/icmp-eq (primitive/cast i64 c) 45) (primitive/cast u8 95) c)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (al-slice [u8] (primitive/load buf))))
(defn c-ident-char? [(c i64) (first bool)] (-> bool)
  (or (primitive/icmp-eq c 95)
      (or (and (primitive/icmp-ge c 65) (primitive/icmp-le c 90))
          (or (and (primitive/icmp-ge c 97) (primitive/icmp-le c 122))
              (and (not first) (and (primitive/icmp-ge c 48) (primitive/icmp-le c 57)))))))
(defn is-c-ident [(s (slice u8))] (-> bool)
  (let [n (slice-len s)]
    (if (primitive/icmp-eq n 0)
        false
        (let [(mut ok) (c-ident-char? (primitive/cast i64 (slice-get s 0)) true)
              (mut i) 1]
          (loop (if (or (not (primitive/load ok)) (primitive/icmp-ge (primitive/load i) n))
                    (break)
                    (do
                      (unless (c-ident-char? (primitive/cast i64 (slice-get s (primitive/load i))) false) (primitive/store! ok false) 0)
                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
          (primitive/load ok)))))
(defn fn-param-types [(a (ptr Allocator)) (ps (ptr (ArrayList Param)))] (-> (ptr (ArrayList Type)))
  (let [n (al-len [Param] (primitive/load ps))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut out) (primitive/load (primitive/field (al-elem [Param] ps (primitive/load i)) ty))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))
(defn export-first-bad-param [(cx (ptr Cx)) (ps (ptr (ArrayList Param)))] (-> (ptr Param))
  (let [n (al-len [Param] (primitive/load ps))
        (mut i) 0
        (mut r) (primitive/cast (ptr Param) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] ps (primitive/load i))]
                  (when (not (export-param-ok cx (primitive/field pp ty))) (primitive/store! r pp) (break)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn export-param-msg [(a (ptr Allocator)) (dn (slice u8)) (pname (slice u8)) (t (ptr Type))] (-> (slice u8))
  (sconcat a
           (sconcat3 a "export-c: '" dn "' parameter '")
           (sconcat a
                    pname
                    (sconcat a
                             "' has type "
                             (sconcat a
                                      (ty-str a t)
                                      ", which has no C representation (a slice, sum, SIMD vector, or generic instantiation can't cross the C boundary — take a `(ptr …)` or lower it to a C-layout struct)")))))
; validate ONE export and finalize its C symbol; returns the resolved ExportC.
(defn validate-export [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program)) (ep (ptr ExportC))] (-> (Result ExportC
                                                                                                              Diag))
  (try (let [ename (primitive/load (primitive/field ep name))
             dn (display-name ename)
             elo (primitive/load (primitive/field ep lo))
             ehi (primitive/load (primitive/field ep hi))
             esrc (primitive/load (primitive/field ep source))
             f (prog-fn-find prog ename)]
         (when (primitive/icmp-eq (primitive/cast i64 f) 0)
               (break :try
                      (Err [ExportC Diag]
                           (derr-at-src esrc elo ehi (sconcat3 a "export-c: unknown function '" dn "'")))))
         (when (primitive/icmp-gt (al-len [(slice u8)] (primitive/load (primitive/field f type_params))) 0)
               (break :try
                      (Err [ExportC Diag]
                           (derr-at-src esrc
                                        elo
                                        ehi
                                        (sconcat3 a
                                                  "export-c: '"
                                                  dn
                                                  "' is generic — a generic function has no single C symbol; export a concrete wrapper instead")))))
         (when (conv-cc-is-shim cx (primitive/load (primitive/field f cc)))
               (break :try
                      (Err [ExportC Diag]
                           (derr-at-src esrc
                                        elo
                                        ehi
                                        (sconcat3 a
                                                  "export-c: '"
                                                  dn
                                                  "' uses a :shim convention, which isn't the C ABI")))))
         (let [bp (export-first-bad-param cx (primitive/load (primitive/field f params)))]
           (when (primitive/icmp-ne (primitive/cast i64 bp) 0)
                 (break :try
                        (Err [ExportC Diag]
                             (derr-at-src esrc elo ehi (export-param-msg a dn (primitive/load (primitive/field bp name)) (primitive/field bp ty)))))))
         (when (not (export-ret-ok cx (primitive/field f ret)))
               (break :try
                      (Err [ExportC Diag]
                           (derr-at-src esrc
                                        elo
                                        ehi
                                        (sconcat a
                                                 (sconcat3 a "export-c: '" dn "' returns ")
                                                 (sconcat a
                                                          (ty-str a (primitive/field f ret))
                                                          ", which has no C representation"))))))
         (let [sym (match (primitive/load (primitive/field ep symbol)) (Some [s] s) (None [] (default-c-symbol a ename)))]
           (when (not (is-c-ident sym))
                 (break :try
                        (Err [ExportC Diag]
                             (derr-at-src esrc
                                          elo
                                          ehi
                                          (sconcat a
                                                   (sconcat3 a "export-c: '" dn "' → '")
                                                   (sconcat a
                                                            sym
                                                            "' isn't a valid C identifier; give one with :as \"name\""))))))
           (let [ec (alloc/stack ExportC)]
             (primitive/store! (primitive/field ec name) ename)
             (primitive/store! (primitive/field ec symbol) (Some [(slice u8)] sym))
             (primitive/store! (primitive/field ec params) (fn-param-types a (primitive/load (primitive/field f params))))
             (primitive/store! (primitive/field ec lo) elo)
             (primitive/store! (primitive/field ec hi) ehi)
             (primitive/store! (primitive/field ec source) (primitive/load (primitive/field ep source)))
             (primitive/store! (primitive/field ec ctxt) (primitive/load (primitive/field ep ctxt)))
             (Ok [ExportC Diag] (primitive/load ec)))))))
(defn finish-metas [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [ms (primitive/load (primitive/field prog metas))
        n (al-len [Expr] (primitive/load ms))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false
        empty-tps (box-al [(slice u8)] a (al-new [(slice u8)] a))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [mp (al-elem [Expr] ms (primitive/load i))
                      env (env-new a)]
                  (match (do-synth a mp (null-type) env cx empty-tps "meta")
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (alloc/stack SynPair)]
                          (primitive/store! sp sp0)
                          (if (not (primitive/icmp-eq (type-tag (primitive/load (primitive/field sp t))) 13))
                              (do
                                (primitive/store! err
                                        (derr (sconcat a
                                                       "meta: expression must produce Code, got "
                                                       (ty-str a (primitive/load (primitive/field sp t))))))
                                (primitive/store! failed true)
                                (break))
                              (do (al-push! (mut out) (primitive/load (primitive/load (primitive/field sp e)))) 0))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [(ptr (ArrayList Expr)) Diag] (primitive/load err)) (Ok (box-al [Expr] a (primitive/load out))))))
(defn finish-exports [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result (ptr (ArrayList ExportC))
                                                                                          Diag))
  (let [es (primitive/load (primitive/field prog exports))
        n (al-len [ExportC] (primitive/load es))
        (mut out) (al-new [ExportC] a)
        seenb (unwrap-ptr [SBox] (create [SBox] a))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (primitive/store! (primitive/field seenb items) (al-new [(slice u8)] a))
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (validate-export a cx prog (al-elem [ExportC] es (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [ec0]
                      (let [ec (alloc/stack ExportC)]
                        (primitive/store! ec ec0)
                        (let [sym (match (primitive/load (primitive/field ec symbol)) (Some [s] s) (None [] ""))]
                          (if (set-contains (primitive/field seenb items) sym)
                              (do
                                (primitive/store! err
                                        (derr-at-src (primitive/load (primitive/field ec source))
                                                     (primitive/load (primitive/field ec lo))
                                                     (primitive/load (primitive/field ec hi))
                                                     (sconcat3 a
                                                               "export-c: two functions export the same C symbol '"
                                                               sym
                                                               "'")))
                                (primitive/store! failed true)
                                (break))
                              (do (al-push! (mut (primitive/field seenb items)) sym) (al-push! (mut out) (primitive/load ec))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err [(ptr (ArrayList ExportC)) Diag] (primitive/load err)) (Ok (box-al [ExportC] a (primitive/load out))))))

(defn finish [(a (ptr Allocator)) (cx (ptr Cx)) (prog (ptr Program)) (funcs (ptr (ArrayList Func)))] (-> (Result (ptr Program)
                                                                                                                 Diag))
  (match (finish-asserts a cx prog)
    (Err [d] (Err [(ptr Program) Diag] d))
    (Ok [asserts]
        (match (finish-metas a cx prog)
          (Err [d] (Err [(ptr Program) Diag] d))
          (Ok [metas]
              (match (finish-exports a cx prog)
                (Err [d] (Err [(ptr Program) Diag] d))
                (Ok [exports]
                    (let [out (unwrap-ptr [Program] (create [Program] a))]
                      (primitive/store! (primitive/field out conventions) (primitive/load (primitive/field prog conventions)))
                      (primitive/store! (primitive/field out structs) (primitive/load (primitive/field prog structs)))
                      (primitive/store! (primitive/field out sums) (primitive/load (primitive/field prog sums)))
                      (primitive/store! (primitive/field out externs) (primitive/load (primitive/field prog externs)))
                      (primitive/store! (primitive/field out funcs) funcs)
                      (primitive/store! (primitive/field out asserts) asserts)
                      (primitive/store! (primitive/field out consts) (primitive/load (primitive/field prog consts)))
                      (primitive/store! (primitive/field out traits) (primitive/load (primitive/field prog traits)))
                      (primitive/store! (primitive/field out impls) (primitive/load (primitive/field prog impls)))
                      (primitive/store! (primitive/field out metas) metas)
                      (primitive/store! (primitive/field out exports) exports)
                      ; Phase 3 comptime fold: replace every
                      ; `(comptime …)` in a function body / static-assert with its literal.
                      ; A no-op for comptime-free programs (bootstrap + IR corpus unaffected).
                      (match (fold-program out (primitive/load (primitive/field out asserts)) a)
                        (Err [d] (Err [(ptr Program) Diag] d))
                        (Ok [_] (Ok out)))))))))))

; ============================ the check pass ===================
; check-program: setup (Phase 1, fail-fast) ->
; check_func over every function (Phase 2; FIRST error wins, matching the oracle's
; dump_error of diagnostics[0]) -> finish (Phase 3). Returns the typed/elaborated/
; LOWERED Program, or Err(diag) dumped canonically.
; Check every function body. Mirrors check_with Phase 2: it collects
; ALL body errors (checking continues past a failing function) into `diags`, so the
; build path can render every error (`N errors`). The single-Diag return keeps the
; dump-checked oracle unchanged (it reports diagnostics[0]).
; a function whose BODY failed to resolve (resolve poisoned it): its signature is in the
; table so callers resolve, but there is no point type-checking a body full of unresolved
; names — that only produces derivative noise on top of the resolve error already reported.
(defn func-poisoned? [(s (mut LS)) (nm (slice u8))] (-> bool)
  (let [pp (primitive/load (primitive/field s resolve_poisoned))]
    (if (primitive/icmp-eq (primitive/cast i64 pp) 0)
        false
        (let [n (al-len [(slice u8)] pp)
              (mut i) 0
              (mut r) false]
          (loop (if (primitive/icmp-ge (primitive/load i) n)
                    (break)
                    (do
                      (when (str-eq (al-get [(slice u8)] pp (primitive/load i)) nm) (primitive/store! r true) (break))
                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
          (primitive/load r)))))

(defn check-all-funcs [(a (ptr Allocator)) (cx (ptr Cx)) (allf (ptr (ArrayList Func))) (s (mut LS))] (-> (Result (ptr (ArrayList Func))
                                                                                                                 Diag))
  (let [n (al-len [Func] (primitive/load allf))
        (mut out) (al-new [Func] a)
        (mut dgs) (al-new [Diag] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] allf (primitive/load i))]
                  (unless (func-poisoned? (mut s) (primitive/load (primitive/field fp name)))
                          (match (check-func a cx fp)
                            (Err [d] (al-push! (mut dgs) d))
                            (Ok [f] (al-push! (mut out) f)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/store! (primitive/field s check_diags) (box-al [Diag] a (primitive/load dgs)))
    (if (primitive/icmp-gt (al-len [Diag] (primitive/load dgs)) 0)
        (Err (al-get [Diag] (primitive/load dgs) 0))
        (Ok (box-al [Func] a (primitive/load out))))))
(defn check-program [(a (ptr Allocator)) (p (ptr Program)) (s (mut LS))] (-> (Result (ptr Program) Diag))
  (type-map-reset)  ; S2: fresh per-expression type map for this check pass
  (bind-map-reset)  ; S3: fresh local-binding map + id counter for this check pass
  (res-map-reset)  ; S1: fresh call→callee resolution map
  (let [impb (unwrap-ptr [(ArrayList ImpEntry)] (create [(ArrayList ImpEntry)] a))
        expb (unwrap-ptr [(ArrayList ExpEntry)] (create [(ArrayList ExpEntry)] a))
        cx (unwrap-ptr [Cx] (create [Cx] a))]
    (primitive/store! impb (primitive/load (primitive/field s imports)))
    (primitive/store! expb (primitive/load (primitive/field s exports)))
    (match (setup a cx p impb expb)
      (Err [d] (Err [(ptr Program) Diag] d))
      (Ok [allf]
          (match (check-all-funcs a cx allf (mut s))
            (Err [d] (Err [(ptr Program) Diag] d))
            (Ok [funcs] (finish a cx p funcs)))))))

; ============================ the mono pass =====================
; A PURE specializer: the checker already wrote explicit type-args on every
; generic call/construction, so mono instantiates each generic func/struct/sum
; per concrete type-arg set, rewrites calls to the specialized (mangled) names,
; and drops the generic templates. Output is a Program with no remaining
; generics. mono's String errors become spanless Diags (derr, lo=hi=-1) so they
; dump as (error@D:D "...").

; A type-parameter substitution (param-name -> concrete Type), parallel lists.
