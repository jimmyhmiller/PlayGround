; src/compiler/metalower.coil — lower a CHECKED metaprogram sub-program to a
; normal, compilable program (the compile-and-run metaprogram engine's core pass).
;
; Runs AFTER check-program (so every code-op argument's inferred type is in the
; type map) and BEFORE monomorphize. It rewrites, everywhere:
;   - the type `Code`            -> (ptr i8)   (an opaque handle to a host Sexp)
;   - (ECodeOp op args)          -> metashim arg-builder chain + mp-op-RET call
;   - (EQuote form) / QLit       -> (mp-quoted k) against the host quote registry
;   - (EQuasi q)                 -> nested mp-qq-* builder calls
;   - (primitive/error MSG) (op 9, never)  -> (do (mp-op-int 9 ...) (loop 0))  — never-typed
; and appends an ExportC per metaprogram entry so the dylib exposes coil_mp_<k>.
;
; PARITY RULES. The interpreter fails many misuses only WHEN EVALUATED (wrong-typed
; op arguments, unquoting an aggregate, splicing a non-list). Lowering preserves
; that: wrong-typed args still cross the boundary as real CtVals and fail with the
; interpreter's own message; evaluation-order side effects are kept by nesting the
; builder calls (argument chains evaluate left-to-right, like eval-seq). The only
; compile-time rejections here are values that CANNOT cross (structs, refs), which
; the interpreter would also reject on every evaluation.
(module metalower)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "result.coil" :use *)
(import "match.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "reader.coil" :use *)
(import "parser.coil" :use *)
(import "ast.coil" :use *)
(import "resolve.coil" :use *)
(import "comptime.coil" :use *)
(import "check.coil" :use *)

; ---- pass state ----------------------------------------------------------------
(defstruct MLS
  [(a (ptr Allocator))
   (reg (ptr (ArrayList (ptr Sexp))))])  ; quote registry, in lowering order

(defstruct MLEntry [(name (slice u8)) (symbol (slice u8))])
(defstruct MLOut
  [(prog (ptr Program))
   (entries (ptr (ArrayList MLEntry)))
   (registry (ptr (ArrayList (ptr Sexp))))])

; ---- types: Code -> (ptr i8), recursively ---------------------------------------
(defn ml-code-ty [(a (ptr Allocator))] (-> Type)
  (TPtr (box-type a (TInt 8 true))))
(defn ml-type [(a (ptr Allocator)) (t (ptr Type))] (-> Type)
  (match-else (primitive/load t)
              (TCode [] (ml-code-ty a))
              (TPtr [inner] (TPtr (box-type a (ml-type a inner))))
              (TRef [m inner] (TRef m (box-type a (ml-type a inner))))
              (TArray [e n] (TArray (box-type a (ml-type a e)) n))
              (TSlice [e] (TSlice (box-type a (ml-type a e))))
              (TVec [e n] (TVec (box-type a (ml-type a e)) n))
              (TFn [cc ps ret] (TFn cc (ml-type-list a ps) (box-type a (ml-type a ret))))
              (TApp [nm args] (TApp nm (ml-type-list a args)))
              (_ (primitive/load t))))
(defn ml-type-list [(a (ptr Allocator)) (ts (ptr (ArrayList Type)))] (-> (ptr (ArrayList Type)))
  (let [n (al-len [Type] (primitive/load ts))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (ml-type a (al-elem [Type] ts (primitive/load i))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))
(defn ml-type-opt [(a (ptr Allocator)) (t (Option Type))] (-> (Option Type))
  (match t
    (None [] (None [Type]))
    (Some [tv] (let [tp (alloc/stack Type)] (primitive/store! tp tv) (Some (ml-type a tp))))))

; ---- small expr constructors -----------------------------------------------------
; Every synthesized node inherits the ORIGINAL node's span, so diagnostics keep
; pointing at real source.
(defn ml-call1 [(st (ptr MLS)) (fname (slice u8)) (x Expr) (proto (ptr Expr))] (-> Expr)
  (let [a (primitive/load (primitive/field st a))
        (mut args) (al-new [Expr] a)]
    (al-push! (mut args) x)
    (mk-expr (ECall fname (box-al [Type] a (al-new [Type] a)) (box-al [Expr] a (primitive/load args)))
             (primitive/load (primitive/field proto lo))
             (primitive/load (primitive/field proto hi))
             (primitive/load (primitive/field proto source))
             (primitive/load (primitive/field proto ctxt)))))
(defn ml-call2 [(st (ptr MLS)) (fname (slice u8)) (x Expr) (y Expr) (proto (ptr Expr))] (-> Expr)
  (let [a (primitive/load (primitive/field st a))
        (mut args) (al-new [Expr] a)]
    (al-push! (mut args) x)
    (al-push! (mut args) y)
    (mk-expr (ECall fname (box-al [Type] a (al-new [Type] a)) (box-al [Expr] a (primitive/load args)))
             (primitive/load (primitive/field proto lo))
             (primitive/load (primitive/field proto hi))
             (primitive/load (primitive/field proto source))
             (primitive/load (primitive/field proto ctxt)))))
(defn ml-call0 [(st (ptr MLS)) (fname (slice u8)) (proto (ptr Expr))] (-> Expr)
  (let [a (primitive/load (primitive/field st a))]
    (mk-expr (ECall fname (box-al [Type] a (al-new [Type] a)) (box-al [Expr] a (al-new [Expr] a)))
             (primitive/load (primitive/field proto lo))
             (primitive/load (primitive/field proto hi))
             (primitive/load (primitive/field proto source))
             (primitive/load (primitive/field proto ctxt)))))
(defn ml-int [(st (ptr MLS)) (v i64) (proto (ptr Expr))] (-> Expr)
  (mk-expr (EInt v)
           (primitive/load (primitive/field proto lo))
           (primitive/load (primitive/field proto hi))
           (primitive/load (primitive/field proto source))
           (primitive/load (primitive/field proto ctxt))))
(defn ml-do2 [(st (ptr MLS)) (x Expr) (y Expr) (proto (ptr Expr))] (-> Expr)
  (let [a (primitive/load (primitive/field st a))
        (mut body) (al-new [Expr] a)]
    (al-push! (mut body) x)
    (al-push! (mut body) y)
    (mk-expr (EDo (box-al [Expr] a (primitive/load body)))
             (primitive/load (primitive/field proto lo))
             (primitive/load (primitive/field proto hi))
             (primitive/load (primitive/field proto source))
             (primitive/load (primitive/field proto ctxt)))))
; a break-less loop: the never-typed tail after a host call that cannot return
(defn ml-diverge [(st (ptr MLS)) (proto (ptr Expr))] (-> Expr)
  (let [a (primitive/load (primitive/field st a))
        (mut body) (al-new [Expr] a)]
    (al-push! (mut body) (ml-int st 0 proto))
    (mk-expr (ELoop (None [(slice u8)]) (box-al [Expr] a (primitive/load body)))
             (primitive/load (primitive/field proto lo))
             (primitive/load (primitive/field proto hi))
             (primitive/load (primitive/field proto source))
             (primitive/load (primitive/field proto ctxt)))))

; ---- argument classification ------------------------------------------------------
; kinds: 1=Code 2=int 3=str 4=bool 5=float 6=never 0=cannot-cross
(defn ml-kind-of-type [(t (ptr Type))] (-> i64)
  (match-else (primitive/load t)
              (TCode [] 1)
              (TInt [b s] 2)
              (TBool [] 4)
              (TFloat [b] 5)
              (TNever [] 6)
              (TSlice [e] (match-else (primitive/load e) (TInt [b s] (when (and (primitive/icmp-eq b 8) (not s)) 3)) (_ 0)))
              (_ 0)))
; The checked type of an ORIGINAL (pre-lowering) expr: type map by nid, else a
; structural fallback for the node kinds whose type is intrinsic.
(defn ml-node-type [(st (ptr MLS)) (e (ptr Expr))] (-> (Result Type Diag))
  (match (type-map-lookup (primitive/load (primitive/field e nid)))
    (Some [t] (Ok [Type Diag] t))
    (None []
          (match-else (primitive/load (primitive/field e kind))
                      (EInt [v] (Ok [Type Diag] (TInt 64 true)))
                      (EBool [b] (Ok [Type Diag] (TBool)))
                      (EFloat [bits] (Ok [Type Diag] (TFloat 64)))
                      (EStr [s] (Ok [Type Diag] (TSlice (box-type (primitive/load (primitive/field st a)) (TInt 8 false)))))
                      (EQuote [f] (Ok [Type Diag] (TCode)))
                      (EQuasi [q] (Ok [Type Diag] (TCode)))
                      (ECodeOp [op args] (Ok [Type Diag] (codeop-rty op)))
                      (_ (Err [Type Diag]
                              (derr-at-src (primitive/load (primitive/field e source))
                                           (primitive/load (primitive/field e lo))
                                           (primitive/load (primitive/field e hi))
                                           "metalower: no inferred type recorded for a code-op argument (compiler bug)")))))))

; widen an int/float argument to the boundary's i64/f64
(defn ml-widen-int [(st (ptr MLS)) (t Type) (le Expr) (proto (ptr Expr))] (-> Expr)
  (match-else t
              (TInt [b s]
                    (if (primitive/icmp-eq b 64)
                        le
                        (mk-expr (ECast (TInt 64 true) (box-expr (primitive/load (primitive/field st a)) le))
                                 (primitive/load (primitive/field proto lo))
                                 (primitive/load (primitive/field proto hi))
                                 (primitive/load (primitive/field proto source))
                                 (primitive/load (primitive/field proto ctxt)))))
              (_ le)))
(defn ml-widen-float [(st (ptr MLS)) (t Type) (le Expr) (proto (ptr Expr))] (-> Expr)
  (match-else t
              (TFloat [b]
                      (if (primitive/icmp-eq b 64)
                          le
                          (mk-expr (ECast (TFloat 64) (box-expr (primitive/load (primitive/field st a)) le))
                                   (primitive/load (primitive/field proto lo))
                                   (primitive/load (primitive/field proto hi))
                                   (primitive/load (primitive/field proto source))
                                   (primitive/load (primitive/field proto ctxt)))))
              (_ le)))

; ---- ECodeOp lowering --------------------------------------------------------------
; (op a0 a1 ...) -> (mp-op-RET op (mp-arg-K (mp-arg-K (mp-arg-new) A0) A1))
; If an argument is never-typed, evaluation stops there (like the interpreter's
; arg-evaluation loop): the whole node becomes (do A0 .. ANEVER), itself never-typed.
(defn ml-codeop [(st (ptr MLS)) (op i64) (args (ptr (ArrayList Expr))) (proto (ptr Expr))] (-> (Result Expr Diag))
  (try (do
         (let [a (primitive/load (primitive/field st a))
               n (al-len [Expr] (primitive/load args))
               (mut chain) (ml-call0 st "metashim.mp-arg-new" proto)
               (mut i) 0
               (mut diverged) (None [Expr])
               (mut evald) (al-new [Expr] a)]
           (loop (if (primitive/icmp-ge (primitive/load i) n)
                     (break)
                     (do
                       (let [ap (al-elem [Expr] args (primitive/load i))
                             t (try! (ml-node-type st ap))
                             k (let [tp (alloc/stack Type)] (primitive/store! tp t) (ml-kind-of-type tp))
                             le (try! (ml-expr st ap))]
                         (cond (primitive/icmp-eq k 6)  ; never-typed argument: evaluate the chain so far, then it
                                 (do
                                   (al-push! (mut evald) (primitive/load chain))
                                   (al-push! (mut evald) le)
                                   (primitive/store! diverged
                                           (Some (mk-expr (EDo (box-al [Expr] a (primitive/load evald)))
                                                          (primitive/load (primitive/field proto lo))
                                                          (primitive/load (primitive/field proto hi))
                                                          (primitive/load (primitive/field proto source))
                                                          (primitive/load (primitive/field proto ctxt)))))
                                   (break))
                               (primitive/icmp-eq k 1) (primitive/store! chain (ml-call2 st "metashim.mp-arg-c" (primitive/load chain) le proto))
                               (primitive/icmp-eq k 2)
                                 (primitive/store! chain
                                         (ml-call2 st
                                                   "metashim.mp-arg-i"
                                                   (primitive/load chain)
                                                   (ml-widen-int st t le proto)
                                                   proto))
                               (primitive/icmp-eq k 3) (primitive/store! chain (ml-call2 st "metashim.mp-arg-s" (primitive/load chain) le proto))
                               (primitive/icmp-eq k 4) (primitive/store! chain (ml-call2 st "metashim.mp-arg-b" (primitive/load chain) le proto))
                               (primitive/icmp-eq k 5)
                                 (primitive/store! chain
                                         (ml-call2 st
                                                   "metashim.mp-arg-f"
                                                   (primitive/load chain)
                                                   (ml-widen-float st t le proto)
                                                   proto))
                               :else
                                 (break :try
                                        (Err [Expr Diag]
                                             (derr-at-src (primitive/load (primitive/field ap source))
                                                          (primitive/load (primitive/field ap lo))
                                                          (primitive/load (primitive/field ap hi))
                                                          "metalower: this value cannot cross into a code op (only Code, integers, bools, floats and (slice u8) can; the interpreter rejects it at run time too)"))))
                         (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
           (match (primitive/load diverged)
             (Some [de] (Ok [Expr Diag] de))
             (None []
                   (let [opx (ml-int st op proto)]
                     ; result shape = codeop-rty (check.coil), the op's static type
                     (match-else (codeop-rty op)
                                 (TNever []
                                         (Ok [Expr Diag]
                                             (ml-do2 st
                                                     (ml-call2 st "metashim.mp-op-int" opx (primitive/load chain) proto)
                                                     (ml-diverge st proto)
                                                     proto)))
                                 (TBool [] (Ok [Expr Diag] (ml-call2 st "metashim.mp-op-bool" opx (primitive/load chain) proto)))
                                 (TInt [b s] (Ok [Expr Diag] (ml-call2 st "metashim.mp-op-int" opx (primitive/load chain) proto)))
                                 (TSlice [e] (Ok [Expr Diag] (ml-call2 st "metashim.mp-op-str" opx (primitive/load chain) proto)))
                                 (_ (Ok [Expr Diag] (ml-call2 st "metashim.mp-op-code" opx (primitive/load chain) proto)))))))))))

; ---- quote/quasiquote ---------------------------------------------------------------
(defn ml-quoted [(st (ptr MLS)) (form (ptr Sexp)) (proto (ptr Expr))] (-> Expr)
  (let [k (al-len [(ptr Sexp)] (primitive/load (primitive/load (primitive/field st reg))))]
    (al-push! [(ptr Sexp)] (primitive/load (primitive/field st reg)) form)
    (ml-call1 st "metashim.mp-quoted" (ml-int st k proto) proto)))

(defn ml-unquote [(st (ptr MLS)) (e (ptr Expr)) (proto (ptr Expr))] (-> (Result Expr Diag))
  (try (do
         (let [t (try! (ml-node-type st e))
               k (let [tp (alloc/stack Type)] (primitive/store! tp t) (ml-kind-of-type tp))
               le (try! (ml-expr st e))]
           (cond (primitive/icmp-eq k 1) (Ok [Expr Diag] le)
                 (primitive/icmp-eq k 2) (Ok [Expr Diag] (ml-call1 st "metashim.mp-unq-int" (ml-widen-int st t le proto) proto))
                 (primitive/icmp-eq k 4) (Ok [Expr Diag] (ml-call1 st "metashim.mp-unq-bool" le proto))
                 (primitive/icmp-eq k 5)
                   (Ok [Expr Diag] (ml-call1 st "metashim.mp-unq-float" (ml-widen-float st t le proto) proto))
                 (primitive/icmp-eq k 3) (Ok [Expr Diag] (ml-call1 st "metashim.mp-unq-str" le proto))
                 (primitive/icmp-eq k 6) (Ok [Expr Diag] le)
                 :else  ; aggregate: evaluate it (side effects first, like the interpreter's
                 ; eval-then-convert), then fail with ctval->sexp's own message
                 (Ok [Expr Diag]
                     (ml-do2 st
                             le
                             (ml-call1 st "metashim.mp-parity-fail" (ml-int st 1 proto) proto)
                             proto)))))))

; the builder chain for a quasi list/vector's items
(defn ml-quasi-items [(st (ptr MLS)) (items (ptr (ArrayList Quasi))) (proto (ptr Expr))] (-> (Result Expr Diag))
  (try (do
         (let [a (primitive/load (primitive/field st a))
               n (al-len [Quasi] (primitive/load items))
               (mut chain) (ml-call0 st "metashim.mp-qq-new" proto)
               (mut i) 0]
           (loop (if (primitive/icmp-ge (primitive/load i) n)
                     (break)
                     (do
                       (let [qp (al-elem [Quasi] items (primitive/load i))]
                         (match-else (primitive/load qp)
                                     (QSplice [e]
                                              (let [t (try! (ml-node-type st e))
                                                    k (let [tp (alloc/stack Type)] (primitive/store! tp t) (ml-kind-of-type tp))
                                                    le (try! (ml-expr st e))]
                                                (if (primitive/icmp-eq k 1)
                                                    (primitive/store! chain
                                                            (ml-call2 st "metashim.mp-qq-splice" (primitive/load chain) le proto))
                                                    (if (primitive/icmp-eq k 6)
                                                        (primitive/store! chain (ml-do2 st (primitive/load chain) le proto))
                                                        ; non-Code splice value: evaluate, then the interpreter's error
                                                        (primitive/store! chain
                                                                (ml-do2 st
                                                                        (ml-do2 st (primitive/load chain) le proto)
                                                                        (ml-call1 st
                                                                                  "metashim.mp-parity-fail"
                                                                                  (ml-int st 2 proto)
                                                                                  proto)
                                                                        proto))))))
                                     (_ (primitive/store! chain
                                                (ml-call2 st
                                                          "metashim.mp-qq-push"
                                                          (primitive/load chain)
                                                          (try! (ml-quasi st qp proto))
                                                          proto)))))
                       (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
           (Ok [Expr Diag] (primitive/load chain))))))

(defn ml-quasi [(st (ptr MLS)) (q (ptr Quasi)) (proto (ptr Expr))] (-> (Result Expr Diag))
  (try (do
         (match (primitive/load q)
           (QLit [fp] (Ok [Expr Diag] (ml-quoted st fp proto)))
           (QUnquote [e] (ml-unquote st e proto))
           (QSplice [e]
                    ; a top-level ~@: the interpreter rejects it when evaluated, before
                    ; evaluating e — same here
                    (Ok [Expr Diag] (ml-call1 st "metashim.mp-parity-fail" (ml-int st 3 proto) proto)))
           (QList [items]
                  (let [chain (try! (ml-quasi-items st items proto))
                        fin (if (quasi-head-is-lit-sym items) "metashim.mp-qq-listq" "metashim.mp-qq-list")]
                    (Ok [Expr Diag] (ml-call1 st fin chain proto))))
           (QVector [items]
                    (let [chain (try! (ml-quasi-items st items proto))]
                      (Ok [Expr Diag] (ml-call1 st "metashim.mp-qq-vec" chain proto))))))))

; ---- the expression walk -------------------------------------------------------------
(defn ml-expr-list [(st (ptr MLS)) (es (ptr (ArrayList Expr)))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (do
         (let [a (primitive/load (primitive/field st a))
               n (al-len [Expr] (primitive/load es))
               (mut out) (al-new [Expr] a)
               (mut i) 0]
           (loop (if (primitive/icmp-ge (primitive/load i) n)
                     (break)
                     (do
                       (al-push! (mut out) (try! (ml-expr st (al-elem [Expr] es (primitive/load i)))))
                       (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
           (Ok [(ptr (ArrayList Expr)) Diag] (box-al [Expr] a (primitive/load out)))))))
(defn ml-expr-opt [(st (ptr MLS)) (o (Option (ptr Expr)))] (-> (Result (Option (ptr Expr)) Diag))
  (try (do
         (match o
           (None [] (Ok [(Option (ptr Expr)) Diag] (None [(ptr Expr)])))
           (Some [e] (Ok [(Option (ptr Expr)) Diag] (Some (box-expr (primitive/load (primitive/field st a)) (try! (ml-expr st e))))))))))
(defn ml-binds [(st (ptr MLS)) (bs (ptr (ArrayList Bind)))] (-> (Result (ptr (ArrayList Bind)) Diag))
  (try (do
         (let [a (primitive/load (primitive/field st a))
               n (al-len [Bind] (primitive/load bs))
               (mut out) (al-new [Bind] a)
               (mut i) 0]
           (loop (if (primitive/icmp-ge (primitive/load i) n)
                     (break)
                     (do
                       (let [bp (al-elem [Bind] bs (primitive/load i))
                             nb (alloc/stack Bind)]
                         (primitive/store! (primitive/field nb name) (primitive/load (primitive/field bp name)))
                         (primitive/store! (primitive/field nb mutable) (primitive/load (primitive/field bp mutable)))
                         (primitive/store! (primitive/field nb value) (try! (ml-expr st (primitive/field bp value))))
                         (al-push! (mut out) (primitive/load nb)))
                       (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
           (Ok [(ptr (ArrayList Bind)) Diag] (box-al [Bind] a (primitive/load out)))))))
(defn ml-arms [(st (ptr MLS)) (as (ptr (ArrayList Arm)))] (-> (Result (ptr (ArrayList Arm)) Diag))
  (try (do
         (let [a (primitive/load (primitive/field st a))
               n (al-len [Arm] (primitive/load as))
               (mut out) (al-new [Arm] a)
               (mut i) 0]
           (loop (if (primitive/icmp-ge (primitive/load i) n)
                     (break)
                     (do
                       (let [ap (al-elem [Arm] as (primitive/load i))
                             na (alloc/stack Arm)]
                         (primitive/store! (primitive/field na variant) (primitive/load (primitive/field ap variant)))
                         (primitive/store! (primitive/field na binds) (primitive/load (primitive/field ap binds)))
                         (primitive/store! (primitive/field na body) (try! (ml-expr st (primitive/field ap body))))
                         (al-push! (mut out) (primitive/load na)))
                       (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
           (Ok [(ptr (ArrayList Arm)) Diag] (box-al [Arm] a (primitive/load out)))))))

(defn ml-rewrap [(proto (ptr Expr)) (k ExprKind)] (-> Expr)
  (mk-expr-nid k
               (primitive/load (primitive/field proto lo))
               (primitive/load (primitive/field proto hi))
               (primitive/load (primitive/field proto source))
               (primitive/load (primitive/field proto ctxt))
               (primitive/load (primitive/field proto nid))))

(defn ml-expr [(st (ptr MLS)) (e (ptr Expr))] (-> (Result Expr Diag))
  (try (do
         (let [a (primitive/load (primitive/field st a))]
           (match-else (primitive/load (primitive/field e kind))
                       ; ---- the four lowered kinds ----
                       (ECodeOp [op args] (ml-codeop st op args e))
                       (EQuote [form] (Ok [Expr Diag] (ml-quoted st form e)))
                       (EQuasi [q] (let [qp (alloc/stack Quasi)] (primitive/store! qp q) (ml-quasi st qp e)))
                       (EComptime [inner]
                                  (Err [Expr Diag]
                                       (derr-at-src (primitive/load (primitive/field e source))
                                                    (primitive/load (primitive/field e lo))
                                                    (primitive/load (primitive/field e hi))
                                                    "metalower: (comptime ...) survived the check fold (compiler bug)")))
                       ; ---- types embedded in exprs ----
                       (EZeroed [ty]
                                (Ok [Expr Diag]
                                    (ml-rewrap e (EZeroed (ml-type a (let [tp (alloc/stack Type)] (primitive/store! tp ty) tp))))))
                       (EAlloc [storage ty]
                               (Ok [Expr Diag]
                                   (ml-rewrap e
                                              (EAlloc storage
                                                      (ml-type a (let [tp (alloc/stack Type)] (primitive/store! tp ty) tp))))))
                       (ECast [ty inner]
                              (Ok [Expr Diag]
                                  (ml-rewrap e
                                             (ECast (ml-type a (let [tp (alloc/stack Type)] (primitive/store! tp ty) tp))
                                                    (box-expr a (try! (ml-expr st inner)))))))
                       (ESizeOf [ty]
                                (Ok [Expr Diag]
                                    (ml-rewrap e (ESizeOf (ml-type a (let [tp (alloc/stack Type)] (primitive/store! tp ty) tp))))))
                       (EAlignOf [ty]
                                 (Ok [Expr Diag]
                                     (ml-rewrap e
                                                (EAlignOf (ml-type a (let [tp (alloc/stack Type)] (primitive/store! tp ty) tp))))))
                       (EOffsetOf [ty fname]
                                  (Ok [Expr Diag]
                                      (ml-rewrap e
                                                 (EOffsetOf (ml-type a (let [tp (alloc/stack Type)] (primitive/store! tp ty) tp))
                                                            fname))))
                       (ELlvmIr [result args body]
                                (Ok [Expr Diag]
                                    (ml-rewrap e
                                               (ELlvmIr (ml-type a (let [tp (alloc/stack Type)] (primitive/store! tp result) tp))
                                                        (try! (ml-expr-list st args))
                                                        body))))
                       (ETypeQuery [q ty]
                                   (Ok [Expr Diag]
                                       (ml-rewrap e
                                                  (ETypeQuery q
                                                              (ml-type a
                                                                       (let [tp (alloc/stack Type)] (primitive/store! tp ty) tp))))))
                       (EFieldMeta [meta ty idx]
                                   (Ok [Expr Diag]
                                       (ml-rewrap e
                                                  (EFieldMeta meta
                                                              (ml-type a
                                                                       (let [tp (alloc/stack Type)] (primitive/store! tp ty) tp))
                                                              (box-expr a (try! (ml-expr st idx)))))))
                       (EFieldIndex [ty nm]
                                    (Ok [Expr Diag]
                                        (ml-rewrap e
                                                   (EFieldIndex (ml-type a
                                                                         (let [tp (alloc/stack Type)] (primitive/store! tp ty) tp))
                                                                (box-expr a (try! (ml-expr st nm)))))))
                       (ECall [f targs args]
                              (Ok [Expr Diag]
                                  (ml-rewrap e (ECall f (ml-type-list a targs) (try! (ml-expr-list st args))))))
                       (EDynDispatch [ds vs mi cc params ret recv args]
                                     (Ok [Expr Diag]
                                         (ml-rewrap e
                                                    (EDynDispatch ds
                                                                  vs
                                                                  mi
                                                                  cc
                                                                  (ml-type-list a params)
                                                                  (ml-type a
                                                                           (let [tp (alloc/stack Type)]
                                                                             (primitive/store! tp ret)
                                                                             tp))
                                                                  (box-expr a (try! (ml-expr st recv)))
                                                                  (try! (ml-expr-list st args))))))
                       ; ---- pure structural recursion ----
                       (EBorrow [m place]
                                (Ok [Expr Diag] (ml-rewrap e (EBorrow m (box-expr a (try! (ml-expr st place)))))))
                       (ELet [binds body]
                             (Ok [Expr Diag]
                                 (ml-rewrap e (ELet (try! (ml-binds st binds)) (try! (ml-expr-list st body))))))
                       (EBin [op lhs rhs]
                             (Ok [Expr Diag]
                                 (ml-rewrap e
                                            (EBin op
                                                  (box-expr a (try! (ml-expr st lhs)))
                                                  (box-expr a (try! (ml-expr st rhs)))))))
                       (ENot [inner] (Ok [Expr Diag] (ml-rewrap e (ENot (box-expr a (try! (ml-expr st inner)))))))
                       (ECmp [op lhs rhs]
                             (Ok [Expr Diag]
                                 (ml-rewrap e
                                            (ECmp op
                                                  (box-expr a (try! (ml-expr st lhs)))
                                                  (box-expr a (try! (ml-expr st rhs)))))))
                       (EIf [cnd thn els]
                            (Ok [Expr Diag]
                                (ml-rewrap e
                                           (EIf (box-expr a (try! (ml-expr st cnd)))
                                                (box-expr a (try! (ml-expr st thn)))
                                                (box-expr a (try! (ml-expr st els)))))))
                       (EDo [body] (Ok [Expr Diag] (ml-rewrap e (EDo (try! (ml-expr-list st body))))))
                       (EField [p fname]
                               (Ok [Expr Diag] (ml-rewrap e (EField (box-expr a (try! (ml-expr st p))) fname))))
                       (ELoad [inner] (Ok [Expr Diag] (ml-rewrap e (ELoad (box-expr a (try! (ml-expr st inner)))))))
                       (EStore [p val]
                               (Ok [Expr Diag]
                                   (ml-rewrap e
                                              (EStore (box-expr a (try! (ml-expr st p)))
                                                      (box-expr a (try! (ml-expr st val)))))))
                       (EIndex [p idx]
                               (Ok [Expr Diag]
                                   (ml-rewrap e
                                              (EIndex (box-expr a (try! (ml-expr st p)))
                                                      (box-expr a (try! (ml-expr st idx)))))))
                       (EBitGet [p fname]
                                (Ok [Expr Diag] (ml-rewrap e (EBitGet (box-expr a (try! (ml-expr st p))) fname))))
                       (EBitSet [p fname val]
                                (Ok [Expr Diag]
                                    (ml-rewrap e
                                               (EBitSet (box-expr a (try! (ml-expr st p)))
                                                        fname
                                                        (box-expr a (try! (ml-expr st val)))))))
                       (EFree [inner] (Ok [Expr Diag] (ml-rewrap e (EFree (box-expr a (try! (ml-expr st inner)))))))
                       (EErase [tn inner]
                               (Ok [Expr Diag] (ml-rewrap e (EErase tn (box-expr a (try! (ml-expr st inner)))))))
                       (EMatch [scrut arms]
                               (Ok [Expr Diag]
                                   (ml-rewrap e
                                              (EMatch (box-expr a (try! (ml-expr st scrut))) (try! (ml-arms st arms))))))
                       (ECallPtr [fp args]
                                 (Ok [Expr Diag]
                                     (ml-rewrap e
                                                (ECallPtr (box-expr a (try! (ml-expr st fp)))
                                                          (try! (ml-expr-list st args))))))
                       (ELoop [label body] (Ok [Expr Diag] (ml-rewrap e (ELoop label (try! (ml-expr-list st body))))))
                       (EBreak [label value]
                               (Ok [Expr Diag] (ml-rewrap e (EBreak label (try! (ml-expr-opt st value))))))
                       (ESpillRef [inner]
                                  (Ok [Expr Diag] (ml-rewrap e (ESpillRef (box-expr a (try! (ml-expr st inner)))))))
                       (EConstruct [sum variant args]
                                   (Ok [Expr Diag] (ml-rewrap e (EConstruct sum variant (try! (ml-expr-list st args))))))
                       (ETraitCall [tn method stp args]
                                   (Ok [Expr Diag]
                                       (ml-rewrap e (ETraitCall tn method stp (try! (ml-expr-list st args))))))
                       (EMakeDyn [ds vs methods inner]
                                 (Ok [Expr Diag]
                                     (ml-rewrap e (EMakeDyn ds vs methods (box-expr a (try! (ml-expr st inner)))))))
                       ; leaves: EInt EStr ECStr EVar EFloat EBool EFnPtrOf EContinue EStaticRef
                       (_ (Ok [Expr Diag] (primitive/load e))))))))

; ---- funcs / defs / the whole program ----------------------------------------------
(defn ml-params [(a (ptr Allocator)) (ps (ptr (ArrayList Param)))] (-> (ptr (ArrayList Param)))
  (let [n (al-len [Param] (primitive/load ps))
        (mut out) (al-new [Param] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] ps (primitive/load i))
                      np (alloc/stack Param)]
                  (primitive/store! (primitive/field np name) (primitive/load (primitive/field pp name)))
                  (primitive/store! (primitive/field np ty) (ml-type a (primitive/field pp ty)))
                  (al-push! (mut out) (primitive/load np)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Param] a (primitive/load out))))
(defn ml-fields [(a (ptr Allocator)) (fs (ptr (ArrayList Field)))] (-> (ptr (ArrayList Field)))
  (let [n (al-len [Field] (primitive/load fs))
        (mut out) (al-new [Field] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [fp (al-elem [Field] fs (primitive/load i))
                      nf (alloc/stack Field)]
                  (primitive/store! (primitive/field nf name) (primitive/load (primitive/field fp name)))
                  (primitive/store! (primitive/field nf ty) (ml-type a (primitive/field fp ty)))
                  (al-push! (mut out) (primitive/load nf)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Field] a (primitive/load out))))

(defn ml-func [(st (ptr MLS)) (f (ptr Func))] (-> (Result Func Diag))
  (try (do
         (let [a (primitive/load (primitive/field st a))
               nf (alloc/stack Func)]
           (primitive/store! nf (primitive/load f))
           (primitive/store! (primitive/field nf params) (ml-params a (primitive/load (primitive/field f params))))
           (primitive/store! (primitive/field nf ret) (ml-type a (primitive/field f ret)))
           (primitive/store! (primitive/field nf body) (try! (ml-expr-list st (primitive/load (primitive/field f body)))))
           (Ok [Func Diag] (primitive/load nf))))))
(defn ml-funcs [(st (ptr MLS)) (fs (ptr (ArrayList Func)))] (-> (Result (ptr (ArrayList Func)) Diag))
  (try (do
         (let [a (primitive/load (primitive/field st a))
               n (al-len [Func] (primitive/load fs))
               (mut out) (al-new [Func] a)
               (mut i) 0]
           (loop (if (primitive/icmp-ge (primitive/load i) n)
                     (break)
                     (do
                       (al-push! (mut out) (try! (ml-func st (al-elem [Func] fs (primitive/load i)))))
                       (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
           (Ok [(ptr (ArrayList Func)) Diag] (box-al [Func] a (primitive/load out)))))))

(defn ml-structs [(a (ptr Allocator)) (ss (ptr (ArrayList StructDef)))] (-> (ptr (ArrayList StructDef)))
  (let [n (al-len [StructDef] (primitive/load ss))
        (mut out) (al-new [StructDef] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [sp (al-elem [StructDef] ss (primitive/load i))
                      ns (alloc/stack StructDef)]
                  (primitive/store! ns (primitive/load sp))
                  (primitive/store! (primitive/field ns fields) (ml-fields a (primitive/load (primitive/field sp fields))))
                  (al-push! (mut out) (primitive/load ns)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [StructDef] a (primitive/load out))))
(defn ml-sums [(a (ptr Allocator)) (ss (ptr (ArrayList SumDef)))] (-> (ptr (ArrayList SumDef)))
  (let [n (al-len [SumDef] (primitive/load ss))
        (mut out) (al-new [SumDef] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [sp (al-elem [SumDef] ss (primitive/load i))
                      ns (alloc/stack SumDef)
                      vs (primitive/load (primitive/field sp variants))
                      nv (al-len [Variant] (primitive/load vs))
                      (mut vout) (al-new [Variant] a)
                      (mut j) 0]
                  (primitive/store! ns (primitive/load sp))
                  (loop (if (primitive/icmp-ge (primitive/load j) nv)
                            (break)
                            (do
                              (let [vp (al-elem [Variant] vs (primitive/load j))
                                    nvr (alloc/stack Variant)]
                                (primitive/store! (primitive/field nvr name) (primitive/load (primitive/field vp name)))
                                (primitive/store! (primitive/field nvr fields) (ml-fields a (primitive/load (primitive/field vp fields))))
                                (al-push! (mut vout) (primitive/load nvr)))
                              (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                  (primitive/store! (primitive/field ns variants) (box-al [Variant] a (primitive/load vout)))
                  (al-push! (mut out) (primitive/load ns)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [SumDef] a (primitive/load out))))
(defn ml-externs [(a (ptr Allocator)) (es (ptr (ArrayList Extern)))] (-> (ptr (ArrayList Extern)))
  (let [n (al-len [Extern] (primitive/load es))
        (mut out) (al-new [Extern] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ep (al-elem [Extern] es (primitive/load i))
                      ne (alloc/stack Extern)]
                  (primitive/store! ne (primitive/load ep))
                  (primitive/store! (primitive/field ne params) (ml-type-list a (primitive/load (primitive/field ep params))))
                  (primitive/store! (primitive/field ne ret) (ml-type a (primitive/field ep ret)))
                  (al-push! (mut out) (primitive/load ne)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Extern] a (primitive/load out))))
(defn ml-consts [(st (ptr MLS)) (cs (ptr (ArrayList Const)))] (-> (Result (ptr (ArrayList Const)) Diag))
  (try (do
         (let [a (primitive/load (primitive/field st a))
               n (al-len [Const] (primitive/load cs))
               (mut out) (al-new [Const] a)
               (mut i) 0]
           (loop (if (primitive/icmp-ge (primitive/load i) n)
                     (break)
                     (do
                       (let [cp (al-elem [Const] cs (primitive/load i))
                             nc (alloc/stack Const)]
                         (primitive/store! nc (primitive/load cp))
                         (primitive/store! (primitive/field nc ty) (ml-type-opt a (primitive/load (primitive/field cp ty))))
                         (primitive/store! (primitive/field nc value) (try! (ml-expr st (primitive/field cp value))))
                         (al-push! (mut out) (primitive/load nc)))
                       (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
           (Ok [(ptr (ArrayList Const)) Diag] (box-al [Const] a (primitive/load out)))))))
(defn ml-traits [(a (ptr Allocator)) (ts (ptr (ArrayList TraitDef)))] (-> (ptr (ArrayList TraitDef)))
  (let [n (al-len [TraitDef] (primitive/load ts))
        (mut out) (al-new [TraitDef] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [tp (al-elem [TraitDef] ts (primitive/load i))
                      nt (alloc/stack TraitDef)
                      ms (primitive/load (primitive/field tp methods))
                      nm (al-len [TraitMethod] (primitive/load ms))
                      (mut mout) (al-new [TraitMethod] a)
                      (mut j) 0]
                  (primitive/store! nt (primitive/load tp))
                  (loop (if (primitive/icmp-ge (primitive/load j) nm)
                            (break)
                            (do
                              (let [mp (al-elem [TraitMethod] ms (primitive/load j))
                                    nmr (alloc/stack TraitMethod)]
                                (primitive/store! (primitive/field nmr name) (primitive/load (primitive/field mp name)))
                                (primitive/store! (primitive/field nmr params) (ml-params a (primitive/load (primitive/field mp params))))
                                (primitive/store! (primitive/field nmr ret) (ml-type a (primitive/field mp ret)))
                                (al-push! (mut mout) (primitive/load nmr)))
                              (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                  (primitive/store! (primitive/field nt methods) (box-al [TraitMethod] a (primitive/load mout)))
                  (al-push! (mut out) (primitive/load nt)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [TraitDef] a (primitive/load out))))
(defn ml-impls [(st (ptr MLS)) (is (ptr (ArrayList ImplDef)))] (-> (Result (ptr (ArrayList ImplDef)) Diag))
  (try (do
         (let [a (primitive/load (primitive/field st a))
               n (al-len [ImplDef] (primitive/load is))
               (mut out) (al-new [ImplDef] a)
               (mut i) 0]
           (loop (if (primitive/icmp-ge (primitive/load i) n)
                     (break)
                     (do
                       (let [ip (al-elem [ImplDef] is (primitive/load i))
                             ni (alloc/stack ImplDef)]
                         (primitive/store! ni (primitive/load ip))
                         (primitive/store! (primitive/field ni self_type) (ml-type a (primitive/field ip self_type)))
                         (primitive/store! (primitive/field ni methods) (try! (ml-funcs st (primitive/load (primitive/field ip methods)))))
                         (al-push! (mut out) (primitive/load ni)))
                       (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
           (Ok [(ptr (ArrayList ImplDef)) Diag] (box-al [ImplDef] a (primitive/load out)))))))

; entry exports: one C symbol per metaprogram function; params left empty like the
; parser's own export-c records (codegen derives the thunk from the Func itself)
(defn ml-exports [(a (ptr Allocator)) (p (ptr Program)) (quals (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList MLEntry)))
  ; the vtable-handshake entry (metashim.coil mp-init) — closure-subprogram builds
  ; the sub-program with empty exports, so the shim's record is re-created here
  (let [ip (alloc/stack ExportC)]
    (primitive/store! (primitive/field ip name) "metashim.mp-init")
    (primitive/store! (primitive/field ip symbol) (Some "coil_mp_init"))
    (primitive/store! (primitive/field ip params) (box-al [Type] a (al-new [Type] a)))
    (primitive/store! (primitive/field ip lo) -1)
    (primitive/store! (primitive/field ip hi) -1)
    (primitive/store! (primitive/field ip source) -1)
    (primitive/store! (primitive/field ip ctxt) 0)
    (al-push! [ExportC] (primitive/load (primitive/field p exports)) (primitive/load ip)))
  (let [n (al-len [(slice u8)] (primitive/load quals))
        (mut entries) (al-new [MLEntry] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [q (al-get [(slice u8)] (primitive/load quals) (primitive/load i))
                      sym (sconcat a "coil_mp_" (dec->str a (primitive/load i)))
                      ep (alloc/stack ExportC)
                      me (alloc/stack MLEntry)]
                  (primitive/store! (primitive/field ep name) q)
                  (primitive/store! (primitive/field ep symbol) (Some sym))
                  (primitive/store! (primitive/field ep params) (box-al [Type] a (al-new [Type] a)))
                  (primitive/store! (primitive/field ep lo) -1)
                  (primitive/store! (primitive/field ep hi) -1)
                  (primitive/store! (primitive/field ep source) -1)
                  (primitive/store! (primitive/field ep ctxt) 0)
                  (al-push! [ExportC] (primitive/load (primitive/field p exports)) (primitive/load ep))
                  (primitive/store! (primitive/field me name) q)
                  (primitive/store! (primitive/field me symbol) sym)
                  (al-push! (mut entries) (primitive/load me)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [MLEntry] a (primitive/load entries))))

(defn metalower-program [(a (ptr Allocator)) (checked (ptr Program)) (quals (ptr (ArrayList (slice u8))))] (-> (Result (ptr MLOut)
                                                                                                                       Diag))
  (try (do
         (let [st (alloc/stack MLS)]
           (primitive/store! (primitive/field st a) a)
           (primitive/store! (primitive/field st reg) (box-al [(ptr Sexp)] a (al-new [(ptr Sexp)] a)))
           (let [out (unwrap-ptr [Program] (create [Program] a))]
             (primitive/store! (primitive/field out conventions) (primitive/load (primitive/field checked conventions)))
             (primitive/store! (primitive/field out structs) (ml-structs a (primitive/load (primitive/field checked structs))))
             (primitive/store! (primitive/field out sums) (ml-sums a (primitive/load (primitive/field checked sums))))
             (primitive/store! (primitive/field out externs) (ml-externs a (primitive/load (primitive/field checked externs))))
             (primitive/store! (primitive/field out funcs) (try! (ml-funcs st (primitive/load (primitive/field checked funcs)))))
             (primitive/store! (primitive/field out asserts) (primitive/load (primitive/field checked asserts)))
             (primitive/store! (primitive/field out consts) (try! (ml-consts st (primitive/load (primitive/field checked consts)))))
             (primitive/store! (primitive/field out traits) (ml-traits a (primitive/load (primitive/field checked traits))))
             (primitive/store! (primitive/field out impls) (try! (ml-impls st (primitive/load (primitive/field checked impls)))))
             (primitive/store! (primitive/field out metas) (primitive/load (primitive/field checked metas)))
             (primitive/store! (primitive/field out exports) (box-al [ExportC] a (al-new [ExportC] a)))
             (let [entries (ml-exports a out quals)
                   mo (unwrap-ptr [MLOut] (create [MLOut] a))]
               (primitive/store! (primitive/field mo prog) out)
               (primitive/store! (primitive/field mo entries) entries)
               (primitive/store! (primitive/field mo registry) (primitive/load (primitive/field st reg)))
               (Ok [(ptr MLOut) Diag] mo)))))))
