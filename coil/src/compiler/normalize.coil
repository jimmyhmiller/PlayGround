; src/compiler/normalize.coil — self-host Coil compiler, normalize module.
(module normalize)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ffi.coil" :use *)
(import "ast.coil" :use *)
(import "astdump.coil" :use *)
(import "codegen.coil" :use *)
(import "loader.coil" :use *)
(import "parser.coil" :use *)
(import "resolve.coil" :use *)

(defstruct NumRes [(val i64) (len i64)])
(defstruct ScanRes [(fam i64) (num i64) (endd i64)])
(defstruct NzBlock [(cat i64) (name (slice u8)) (body (ArrayList (slice u8)))])
(defstruct NzParsed [(header (ArrayList (slice u8))) (blocks (ArrayList NzBlock))])
(defstruct Renum [(g (ArrayList i64)) (st (ArrayList i64)) (cs (ArrayList i64)) (lv (ArrayList i64))])
(defstruct AttrDef [(old i64) (body (slice u8))])

(defn nz-b [(s (slice u8)) (i i64)] (-> i64)
  (primitive/cast i64 (slice-get s i)))
(defn nz-digit? [(c i64)] (-> bool)
  (and (primitive/icmp-ge c 48) (primitive/icmp-le c 57)))
(defn nz-alnum? [(c i64)] (-> bool)
  (or (and (primitive/icmp-ge c 48) (primitive/icmp-le c 57))
      (or (and (primitive/icmp-ge c 65) (primitive/icmp-le c 90)) (and (primitive/icmp-ge c 97) (primitive/icmp-le c 122)))))
(defn nz-ident? [(c i64)] (-> bool)
  (or (nz-alnum? c) (primitive/icmp-eq c 95)))
(defn nz-sym? [(c i64)] (-> bool)
  (or (nz-alnum? c) (or (primitive/icmp-eq c 95) (or (primitive/icmp-eq c 46) (or (primitive/icmp-eq c 36) (primitive/icmp-eq c 45))))))

(defn nz-contains? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (str-find hay needle) (Some [_] true) (None [] false)))

(defn nz-find-i64 [(l (ArrayList i64)) (x i64)] (-> i64)
  (let [n (al-len [i64] l)
        (mut i) 0
        (mut res) -1]
    (loop (if (or (primitive/icmp-ge (primitive/load i) n) (primitive/icmp-ge (primitive/load res) 0))
              (break)
              (if (primitive/icmp-eq (al-get [i64] l (primitive/load i)) x) (primitive/store! res (primitive/load i)) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load res)))

(defn nz-all-digits? [(s (slice u8))] (-> bool)
  (let [n (slice-len s)
        (mut i) 0
        (mut ok) true]
    (loop (if (or (primitive/icmp-ge (primitive/load i) n) (not (primitive/load ok)))
              (break)
              (if (nz-digit? (nz-b s (primitive/load i))) (do (primitive/store! i (primitive/iadd (primitive/load i) 1)) 0) (do (primitive/store! ok false) 0))))
    (and (primitive/icmp-gt n 0) (primitive/load ok))))

(defn nz-leading-number [(s (slice u8)) (start i64)] (-> NumRes)
  (let [n (slice-len s)
        (mut j) start
        (mut v) 0]
    (loop (if (or (primitive/icmp-ge (primitive/load j) n) (not (nz-digit? (nz-b s (primitive/load j)))))
              (break)
              (do
                (primitive/store! v (primitive/iadd (primitive/imul (primitive/load v) 10) (primitive/isub (nz-b s (primitive/load j)) 48)))
                (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
    (let [r (alloc/stack NumRes)]
      (primitive/store! (primitive/field r val) (primitive/load v))
      (primitive/store! (primitive/field r len) (primitive/isub (primitive/load j) start))
      (primitive/load r))))

(defn nz-parse-int [(s (slice u8))] (-> i64)
  (let [r (alloc/stack NumRes)] (primitive/store! r (nz-leading-number s 0)) (primitive/load (primitive/field r val))))

(defn nz-split-lines [(a (ptr Allocator)) (text (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (al-new [(slice u8)] a)
        n (slice-len text)
        (mut start) 0
        (mut i) 0]
    (loop (cond (primitive/icmp-gt (primitive/load i) n) (break)
                (primitive/icmp-eq (primitive/load i) n)
                  (do (al-push! (mut out) (subslice text (primitive/load start) (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                (primitive/icmp-eq (nz-b text (primitive/load i)) 10)
                  (do
                    (al-push! (mut out) (subslice text (primitive/load start) (primitive/load i)))
                    (primitive/store! start (primitive/iadd (primitive/load i) 1))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                :else (primitive/store! i (primitive/iadd (primitive/load i) 1))))
    (primitive/load out)))

(defn nz-first-token [(l (slice u8))] (-> (slice u8))
  (match (str-find l " ") (Some [i] (subslice l 0 i)) (None [] l)))

(defn nz-at-symbol [(l (slice u8))] (-> (slice u8))
  (match (str-find l "@")
    (None [] l)
    (Some [at]
          (let [n (slice-len l)
                (mut j) (primitive/iadd at 1)]
            (if (and (primitive/icmp-lt (primitive/load j) n) (primitive/icmp-eq (nz-b l (primitive/load j)) 34))
                (do
                  (primitive/store! j (primitive/iadd (primitive/load j) 1))
                  (loop (if (or (primitive/icmp-ge (primitive/load j) n) (primitive/icmp-eq (nz-b l (primitive/load j)) 34))
                            (break)
                            (primitive/store! j (primitive/iadd (primitive/load j) 1))))
                  (when (primitive/icmp-lt (primitive/load j) n) (primitive/store! j (primitive/iadd (primitive/load j) 1)))
                  (subslice l at (primitive/load j)))
                (do
                  (loop (if (or (primitive/icmp-ge (primitive/load j) n) (not (nz-sym? (nz-b l (primitive/load j)))))
                            (break)
                            (primitive/store! j (primitive/iadd (primitive/load j) 1))))
                  (subslice l at (primitive/load j))))))))

(defn nz-pos-define-name? [(name (slice u8))] (-> bool)
  (let [pre "@__coil_llvm_ir_"
        pl (slice-len pre)]
    (if (or (not (starts-with name pre)) (primitive/icmp-le (slice-len name) pl))
        false
        (nz-all-digits? (subslice name pl (slice-len name))))))

; ---- scan_positional -------------------------------------------------------
(defn nz-mk-scan [(fam i64) (num i64) (endd i64)] (-> ScanRes)
  (let [s (alloc/stack ScanRes)]
    (primitive/store! (primitive/field s fam) fam)
    (primitive/store! (primitive/field s num) num)
    (primitive/store! (primitive/field s endd) endd)
    (primitive/load s)))

(defn nz-try-fam [(s (slice u8)) (i i64) (pre (slice u8)) (fam i64)] (-> (Option ScanRes))
  (let [n (slice-len s)
        pl (slice-len pre)
        ps (primitive/iadd i 1)]
    (if (or (primitive/icmp-gt (primitive/iadd ps pl) n) (not (str-eq (subslice s ps (primitive/iadd ps pl)) pre)))
        (None [ScanRes])
        (let [nr (alloc/stack NumRes)]
          (primitive/store! nr (nz-leading-number s (primitive/iadd ps pl)))
          (if (primitive/icmp-eq (primitive/load (primitive/field nr len)) 0)
              (None [ScanRes])
              (let [endd (primitive/iadd (primitive/iadd ps pl) (primitive/load (primitive/field nr len)))]
                (if (or (primitive/icmp-ge endd n) (not (nz-ident? (nz-b s endd))))
                    (Some (nz-mk-scan fam (primitive/load (primitive/field nr val)) endd))
                    (None [ScanRes]))))))))

(defn nz-scan-positional [(s (slice u8)) (i i64)] (-> (Option ScanRes))
  (if (or (primitive/icmp-ge i (slice-len s)) (primitive/icmp-ne (nz-b s i) 64))
      (None [ScanRes])
      (match (nz-try-fam s i "g." 0)
        (Some [r] (Some r))
        (None []
              (match (nz-try-fam s i "str." 1)
                (Some [r] (Some r))
                (None []
                      (match (nz-try-fam s i "cstr." 2)
                        (Some [r] (Some r))
                        (None [] (nz-try-fam s i "__coil_llvm_ir_" 3)))))))))

; ---- renumber map (4 first-encounter lists) --------------------------------
(defn nz-renum-assign! [(r (ptr Renum)) (fam i64) (old i64)] (-> i64)
  (cond (primitive/icmp-eq fam 0) (when (primitive/icmp-lt (nz-find-i64 (primitive/load (primitive/field r g)) old) 0) (al-push! (mut (primitive/field r g)) old))
        (primitive/icmp-eq fam 1) (when (primitive/icmp-lt (nz-find-i64 (primitive/load (primitive/field r st)) old) 0) (al-push! (mut (primitive/field r st)) old))
        (primitive/icmp-eq fam 2) (when (primitive/icmp-lt (nz-find-i64 (primitive/load (primitive/field r cs)) old) 0) (al-push! (mut (primitive/field r cs)) old))
        (primitive/icmp-lt (nz-find-i64 (primitive/load (primitive/field r lv)) old) 0) (al-push! (mut (primitive/field r lv)) old)
        :else 0))

(defn nz-renum-lookup [(r (ptr Renum)) (fam i64) (old i64)] (-> i64)
  (cond (primitive/icmp-eq fam 0) (nz-find-i64 (primitive/load (primitive/field r g)) old)
        (primitive/icmp-eq fam 1) (nz-find-i64 (primitive/load (primitive/field r st)) old)
        (primitive/icmp-eq fam 2) (nz-find-i64 (primitive/load (primitive/field r cs)) old)
        :else (nz-find-i64 (primitive/load (primitive/field r lv)) old)))

(defn nz-assign-line! [(r (ptr Renum)) (line (slice u8))] (-> i64)
  (let [n (slice-len line)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (if (primitive/icmp-eq (nz-b line (primitive/load i)) 64)
                  (match (nz-scan-positional line (primitive/load i))
                    (Some [sr]
                          (let [s (alloc/stack ScanRes)]
                            (primitive/store! s sr)
                            (nz-renum-assign! r (primitive/load (primitive/field s fam)) (primitive/load (primitive/field s num)))
                            (primitive/store! i (primitive/load (primitive/field s endd)))))
                    (None [] (primitive/store! i (primitive/iadd (primitive/load i) 1))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))

(defn nz-name-of [(blocks (ArrayList NzBlock)) (idx i64)] (-> (slice u8))
  (let [b (alloc/stack NzBlock)] (primitive/store! b (al-get [NzBlock] blocks idx)) (primitive/load (primitive/field b name))))

(defn nz-pnum [(blocks (ArrayList NzBlock)) (idx i64) (r (ptr Renum))] (-> i64)
  (let [name (nz-name-of blocks idx)
        nr (alloc/stack NumRes)]
    (primitive/store! nr (nz-leading-number name (slice-len "@__coil_llvm_ir_")))
    (let [pos (nz-find-i64 (primitive/load (primitive/field r lv)) (primitive/load (primitive/field nr val)))]
      (if (primitive/icmp-lt pos 0) 9223372036854775807 pos))))

(defn nz-assign-block-bodies [(r (ptr Renum)) (blocks (ArrayList NzBlock)) (idx i64)] (-> i64)
  (let [b (alloc/stack NzBlock)]
    (primitive/store! b (al-get [NzBlock] blocks idx))
    (let [body (primitive/load (primitive/field b body))
          n (al-len [(slice u8)] body)
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do (nz-assign-line! r (al-get [(slice u8)] body (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    0))

(defn nz-assign-idxs [(r (ptr Renum)) (blocks (ArrayList NzBlock)) (idxs (ArrayList i64))] (-> i64)
  (let [n (al-len [i64] idxs)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (nz-assign-block-bodies r blocks (al-get [i64] idxs (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))

(defn nz-sort-idx-by-name [(a (ptr Allocator)) (blocks (ArrayList NzBlock)) (idxs (ArrayList i64))] (-> (ArrayList i64))
  (let [n (al-len [i64] idxs)
        (mut used) (al-new [bool] a)
        (mut out) (al-new [i64] a)
        (mut k) 0]
    (loop (if (primitive/icmp-ge (primitive/load k) n) (break) (do (al-push! (mut used) false) (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    (let [(mut c) 0]
      (loop (if (primitive/icmp-ge (primitive/load c) n)
                (break)
                (do
                  (let [(mut best) -1
                        (mut bi) 0]
                    (loop (if (primitive/icmp-ge (primitive/load bi) n)
                              (break)
                              (do
                                (when (and (not (al-get [bool] (primitive/load used) (primitive/load bi)))
                                           (or (primitive/icmp-lt (primitive/load best) 0)
                                               (str-lt (nz-name-of blocks (al-get [i64] idxs (primitive/load bi)))
                                                       (nz-name-of blocks (al-get [i64] idxs (primitive/load best))))))
                                      (primitive/store! best (primitive/load bi)))
                                (primitive/store! bi (primitive/iadd (primitive/load bi) 1)))))
                    (al-set! [bool] (mut used) (primitive/load best) true)
                    (al-push! (mut out) (al-get [i64] idxs (primitive/load best))))
                  (primitive/store! c (primitive/iadd (primitive/load c) 1))))))
    (primitive/load out)))

(defn nz-sort-idx-by-pnum [(a (ptr Allocator)) (blocks (ArrayList NzBlock)) (idxs (ArrayList i64)) (r (ptr Renum))] (-> (ArrayList i64))
  (let [n (al-len [i64] idxs)
        (mut used) (al-new [bool] a)
        (mut out) (al-new [i64] a)
        (mut k) 0]
    (loop (if (primitive/icmp-ge (primitive/load k) n) (break) (do (al-push! (mut used) false) (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    (let [(mut c) 0]
      (loop (if (primitive/icmp-ge (primitive/load c) n)
                (break)
                (do
                  (let [(mut best) -1
                        (mut bi) 0]
                    (loop (if (primitive/icmp-ge (primitive/load bi) n)
                              (break)
                              (do
                                (when (and (not (al-get [bool] (primitive/load used) (primitive/load bi)))
                                           (or (primitive/icmp-lt (primitive/load best) 0)
                                               (primitive/icmp-lt (nz-pnum blocks (al-get [i64] idxs (primitive/load bi)) r)
                                                        (nz-pnum blocks (al-get [i64] idxs (primitive/load best)) r))))
                                      (primitive/store! best (primitive/load bi)))
                                (primitive/store! bi (primitive/iadd (primitive/load bi) 1)))))
                    (al-set! [bool] (mut used) (primitive/load best) true)
                    (al-push! (mut out) (al-get [i64] idxs (primitive/load best))))
                  (primitive/store! c (primitive/iadd (primitive/load c) 1))))))
    (primitive/load out)))

(defn nz-build-renumber [(a (ptr Allocator)) (blocks (ArrayList NzBlock))] (-> Renum)
  (let [rstk (alloc/stack Renum)]
    (primitive/store! (primitive/field rstk g) (al-new [i64] a))
    (primitive/store! (primitive/field rstk st) (al-new [i64] a))
    (primitive/store! (primitive/field rstk cs) (al-new [i64] a))
    (primitive/store! (primitive/field rstk lv) (al-new [i64] a))
    (let [nb (al-len [NzBlock] blocks)
          (mut stable) (al-new [i64] a)
          (mut pos) (al-new [i64] a)
          (mut k) 0]
      (loop (if (primitive/icmp-ge (primitive/load k) nb)
                (break)
                (do
                  (let [b (alloc/stack NzBlock)]
                    (primitive/store! b (al-get [NzBlock] blocks (primitive/load k)))
                    (when (primitive/icmp-eq (primitive/load (primitive/field b cat)) 3)
                          (if (nz-pos-define-name? (primitive/load (primitive/field b name)))
                              (al-push! (mut pos) (primitive/load k))
                              (al-push! (mut stable) (primitive/load k)))))
                  (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
      (nz-assign-idxs rstk blocks (nz-sort-idx-by-name a blocks (primitive/load stable)))
      (nz-assign-idxs rstk blocks (nz-sort-idx-by-pnum a blocks (primitive/load pos) rstk))
      (let [(mut g2) 0]
        (loop (if (primitive/icmp-ge (primitive/load g2) nb)
                  (break)
                  (do
                    (let [b (alloc/stack NzBlock)]
                      (primitive/store! b (al-get [NzBlock] blocks (primitive/load g2)))
                      (when (primitive/icmp-eq (primitive/load (primitive/field b cat)) 1) (nz-assign-block-bodies rstk blocks (primitive/load g2))))
                    (primitive/store! g2 (primitive/iadd (primitive/load g2) 1)))))))
    (primitive/load rstk)))

; ---- apply_renumber --------------------------------------------------------
(defn nz-push-str! [(out (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut out) (slice-get s (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))

(defn nz-fam-str [(fam i64)] (-> (slice u8))
  (if (primitive/icmp-eq fam 0) "g" (if (primitive/icmp-eq fam 1) "str" "cstr")))

(defn nz-emit-renamed [(out (mut (ArrayList u8))) (fam i64) (newn i64)] (-> i64)
  (if (primitive/icmp-eq fam 3)
      (do (nz-push-str! (mut out) "@__coil_llvm_ir_") (push-mag (mut out) newn))
      (do
        (al-push! (mut out) (primitive/cast u8 64))
        (nz-push-str! (mut out) (nz-fam-str fam))
        (al-push! (mut out) (primitive/cast u8 46))
        (push-mag (mut out) newn))))

(defn nz-apply-renumber [(a (ptr Allocator)) (line (slice u8)) (r (ptr Renum))] (-> (slice u8))
  (let [n (slice-len line)
        (mut out) (al-new [u8] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (if (primitive/icmp-eq (nz-b line (primitive/load i)) 64)
                  (match (nz-scan-positional line (primitive/load i))
                    (Some [sr]
                          (let [s (alloc/stack ScanRes)]
                            (primitive/store! s sr)
                            (let [newn (nz-renum-lookup r (primitive/load (primitive/field s fam)) (primitive/load (primitive/field s num)))]
                              (if (primitive/icmp-lt newn 0)
                                  (do (al-push! (mut out) (slice-get line (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                                  (do
                                    (nz-emit-renamed (mut out) (primitive/load (primitive/field s fam)) newn)
                                    (primitive/store! i (primitive/load (primitive/field s endd))))))))
                    (None [] (do (al-push! (mut out) (slice-get line (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                  (do (al-push! (mut out) (slice-get line (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (al-slice [u8] (primitive/load out))))

(defn nz-map-apply [(a (ptr Allocator)) (body (ArrayList (slice u8))) (r (ptr Renum))] (-> (ArrayList (slice u8)))
  (let [n (al-len [(slice u8)] body)
        (mut out) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (nz-apply-renumber a (al-get [(slice u8)] body (primitive/load i)) r))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load out)))

; ---- parse_blocks ----------------------------------------------------------
(defn nz-one-body [(a (ptr Allocator)) (l (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut b) (al-new [(slice u8)] a)] (al-push! (mut b) l) (primitive/load b)))

(defn nz-push-block! [(a (ptr Allocator))
                      (blocks (mut (ArrayList NzBlock)))
                      (cat i64)
                      (name (slice u8))
                      (body (ArrayList (slice u8)))] (-> i64)
  (let [b (alloc/stack NzBlock)]
    (primitive/store! (primitive/field b cat) cat)
    (primitive/store! (primitive/field b name) name)
    (primitive/store! (primitive/field b body) body)
    (al-push! (mut blocks) (primitive/load b))
    0))

(defn nz-parse-define [(a (ptr Allocator))
                       (blocks (mut (ArrayList NzBlock)))
                       (lines (ArrayList (slice u8)))
                       (nlines i64)
                       (i i64)
                       (l (slice u8))] (-> i64)
  (let [(mut body) (al-new [(slice u8)] a)
        (mut j) (primitive/iadd i 1)]
    (al-push! (mut body) l)
    (loop (if (or (primitive/icmp-ge (primitive/load j) nlines) (str-eq (al-get [(slice u8)] lines (primitive/load j)) "}"))
              (break)
              (do (al-push! (mut body) (al-get [(slice u8)] lines (primitive/load j))) (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
    (when (primitive/icmp-lt (primitive/load j) nlines)
          (al-push! (mut body) (al-get [(slice u8)] lines (primitive/load j)))
          (primitive/store! j (primitive/iadd (primitive/load j) 1)))
    (nz-push-block! a (mut blocks) 3 (nz-at-symbol l) (primitive/load body))
    (primitive/load j)))

(defn nz-parse-one-block [(a (ptr Allocator))
                          (blocks (mut (ArrayList NzBlock)))
                          (lines (ArrayList (slice u8)))
                          (nlines i64)
                          (i i64)
                          (l (slice u8))] (-> i64)
  (cond (and (primitive/icmp-eq (nz-b l 0) 37) (nz-contains? l "= type"))
          (do (nz-push-block! a (mut blocks) 0 (nz-first-token l) (nz-one-body a l)) (primitive/iadd i 1))
        (primitive/icmp-eq (nz-b l 0) 64) (do (nz-push-block! a (mut blocks) 1 (nz-first-token l) (nz-one-body a l)) (primitive/iadd i 1))
        (starts-with l "declare") (do (nz-push-block! a (mut blocks) 2 (nz-at-symbol l) (nz-one-body a l)) (primitive/iadd i 1))
        (starts-with l "define") (nz-parse-define a (mut blocks) lines nlines i l)
        :else (do (nz-push-block! a (mut blocks) 4 l (nz-one-body a l)) (primitive/iadd i 1))))

(defn nz-parse-blocks [(a (ptr Allocator)) (text (slice u8))] (-> NzParsed)
  (let [lines (nz-split-lines a text)
        nlines (al-len [(slice u8)] lines)
        (mut header) (al-new [(slice u8)] a)
        (mut blocks) (al-new [NzBlock] a)
        (mut i) 0]
    (loop (if (or (primitive/icmp-ge (primitive/load i) nlines) (primitive/icmp-eq (slice-len (al-get [(slice u8)] lines (primitive/load i))) 0))
              (break)
              (do (al-push! (mut header) (al-get [(slice u8)] lines (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (loop (if (primitive/icmp-ge (primitive/load i) nlines)
              (break)
              (let [l (al-get [(slice u8)] lines (primitive/load i))]
                (if (primitive/icmp-eq (slice-len l) 0)
                    (primitive/store! i (primitive/iadd (primitive/load i) 1))
                    (primitive/store! i (nz-parse-one-block a (mut blocks) lines nlines (primitive/load i) l))))))
    (let [p (alloc/stack NzParsed)]
      (primitive/store! (primitive/field p header) (primitive/load header))
      (primitive/store! (primitive/field p blocks) (primitive/load blocks))
      (primitive/load p))))

; ---- block sort by (cat, name) ---------------------------------------------
(defn nz-block-lt [(blocks (ArrayList NzBlock)) (i i64) (j i64)] (-> bool)
  (let [bi (alloc/stack NzBlock)
        bj (alloc/stack NzBlock)]
    (primitive/store! bi (al-get [NzBlock] blocks i))
    (primitive/store! bj (al-get [NzBlock] blocks j))
    (let [ci (primitive/load (primitive/field bi cat))
          cj (primitive/load (primitive/field bj cat))]
      (if (primitive/icmp-lt ci cj)
          true
          (if (primitive/icmp-gt ci cj)
              false
              (str-lt (primitive/load (primitive/field bi name)) (primitive/load (primitive/field bj name))))))))

(defn nz-sort-blocks [(a (ptr Allocator)) (blocks (ArrayList NzBlock))] (-> (ArrayList NzBlock))
  (let [n (al-len [NzBlock] blocks)
        (mut used) (al-new [bool] a)
        (mut out) (al-new [NzBlock] a)
        (mut k) 0]
    (loop (if (primitive/icmp-ge (primitive/load k) n) (break) (do (al-push! (mut used) false) (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    (let [(mut c) 0]
      (loop (if (primitive/icmp-ge (primitive/load c) n)
                (break)
                (do
                  (let [(mut best) -1
                        (mut bi) 0]
                    (loop (if (primitive/icmp-ge (primitive/load bi) n)
                              (break)
                              (do
                                (when (and (not (al-get [bool] (primitive/load used) (primitive/load bi)))
                                           (or (primitive/icmp-lt (primitive/load best) 0) (nz-block-lt blocks (primitive/load bi) (primitive/load best))))
                                      (primitive/store! best (primitive/load bi)))
                                (primitive/store! bi (primitive/iadd (primitive/load bi) 1)))))
                    (al-set! [bool] (mut used) (primitive/load best) true)
                    (al-push! (mut out) (al-get [NzBlock] blocks (primitive/load best))))
                  (primitive/store! c (primitive/iadd (primitive/load c) 1))))))
    (primitive/load out)))

; ---- attribute-group renumber ----------------------------------------------
(defn nz-body-of [(defs (ArrayList AttrDef)) (idx i64)] (-> (slice u8))
  (let [d (alloc/stack AttrDef)] (primitive/store! d (al-get [AttrDef] defs idx)) (primitive/load (primitive/field d body))))

(defn nz-sort-attrs [(a (ptr Allocator)) (defs (ArrayList AttrDef))] (-> (ArrayList AttrDef))
  (let [n (al-len [AttrDef] defs)
        (mut used) (al-new [bool] a)
        (mut out) (al-new [AttrDef] a)
        (mut k) 0]
    (loop (if (primitive/icmp-ge (primitive/load k) n) (break) (do (al-push! (mut used) false) (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    (let [(mut c) 0]
      (loop (if (primitive/icmp-ge (primitive/load c) n)
                (break)
                (do
                  (let [(mut best) -1
                        (mut bi) 0]
                    (loop (if (primitive/icmp-ge (primitive/load bi) n)
                              (break)
                              (do
                                (when (and (not (al-get [bool] (primitive/load used) (primitive/load bi)))
                                           (or (primitive/icmp-lt (primitive/load best) 0)
                                               (str-lt (nz-body-of defs (primitive/load bi)) (nz-body-of defs (primitive/load best)))))
                                      (primitive/store! best (primitive/load bi)))
                                (primitive/store! bi (primitive/iadd (primitive/load bi) 1)))))
                    (al-set! [bool] (mut used) (primitive/load best) true)
                    (al-push! (mut out) (al-get [AttrDef] defs (primitive/load best))))
                  (primitive/store! c (primitive/iadd (primitive/load c) 1))))))
    (primitive/load out)))

(defn nz-attr-newof [(defs (ArrayList AttrDef)) (old i64)] (-> i64)
  (let [n (al-len [AttrDef] defs)
        (mut i) 0
        (mut res) -1]
    (loop (if (or (primitive/icmp-ge (primitive/load i) n) (primitive/icmp-ge (primitive/load res) 0))
              (break)
              (do
                (let [d (alloc/stack AttrDef)]
                  (primitive/store! d (al-get [AttrDef] defs (primitive/load i)))
                  (when (primitive/icmp-eq (primitive/load (primitive/field d old)) old) (primitive/store! res (primitive/load i))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load res)))

(defn nz-replace-attr-refs [(a (ptr Allocator)) (text (slice u8)) (sorted (ArrayList AttrDef))] (-> (slice u8))
  (let [n (slice-len text)
        (mut out) (al-new [u8] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (if (and (primitive/icmp-eq (nz-b text (primitive/load i)) 35)
                       (and (primitive/icmp-lt (primitive/iadd (primitive/load i) 1) n) (nz-digit? (nz-b text (primitive/iadd (primitive/load i) 1)))))
                  (let [(mut j) (primitive/iadd (primitive/load i) 1)]
                    (loop (if (or (primitive/icmp-ge (primitive/load j) n) (not (nz-digit? (nz-b text (primitive/load j)))))
                              (break)
                              (primitive/store! j (primitive/iadd (primitive/load j) 1))))
                    (if (or (primitive/icmp-ge (primitive/load j) n) (not (nz-ident? (nz-b text (primitive/load j)))))
                        (let [newn (nz-attr-newof sorted (nz-parse-int (subslice text (primitive/iadd (primitive/load i) 1) (primitive/load j))))]
                          (if (primitive/icmp-ge newn 0)
                              (do (al-push! (mut out) (primitive/cast u8 35)) (push-mag (mut out) newn) (primitive/store! i (primitive/load j)))
                              (do (al-push! (mut out) (slice-get text (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                        (do (al-push! (mut out) (slice-get text (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                  (do (al-push! (mut out) (slice-get text (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (al-slice [u8] (primitive/load out))))

(defn nz-renumber-attrs [(a (ptr Allocator)) (text (slice u8))] (-> (slice u8))
  (let [lines (nz-split-lines a text)
        nl (al-len [(slice u8)] lines)
        (mut defs) (al-new [AttrDef] a)
        (mut i) 0
        pre "attributes #"]
    (loop (if (primitive/icmp-ge (primitive/load i) nl)
              (break)
              (do
                (let [l (al-get [(slice u8)] lines (primitive/load i))]
                  (when (starts-with l pre)
                        (let [rest (subslice l (slice-len pre) (slice-len l))]
                          (match (str-find rest " = ")
                            (None [] 0)
                            (Some [eq]
                                  (let [numpart (subslice rest 0 eq)]
                                    (when (nz-all-digits? numpart)
                                          (let [d (alloc/stack AttrDef)]
                                            (primitive/store! (primitive/field d old) (nz-parse-int numpart))
                                            (primitive/store! (primitive/field d body) (subslice rest (primitive/iadd eq 3) (slice-len rest)))
                                            (al-push! (mut defs) (primitive/load d))
                                            0))))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/icmp-eq (al-len [AttrDef] defs) 0)
        text
        (nz-replace-attr-refs a text (nz-sort-attrs a (primitive/load defs))))))

; ---- assemble + normalize --------------------------------------------------
(defn nz-assemble [(a (ptr Allocator)) (header (ArrayList (slice u8))) (nblocks (ArrayList NzBlock))] (-> (slice u8))
  (let [(mut out) (al-new [u8] a)
        nh (al-len [(slice u8)] header)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) nh)
              (break)
              (do
                (nz-push-str! (mut out) (al-get [(slice u8)] header (primitive/load i)))
                (al-push! (mut out) (primitive/cast u8 10))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (al-push! (mut out) (primitive/cast u8 10))
    (let [nb (al-len [NzBlock] nblocks)
          (mut k) 0]
      (loop (if (primitive/icmp-ge (primitive/load k) nb)
                (break)
                (do
                  (let [b (alloc/stack NzBlock)]
                    (primitive/store! b (al-get [NzBlock] nblocks (primitive/load k)))
                    (let [body (primitive/load (primitive/field b body))
                          nbody (al-len [(slice u8)] body)
                          (mut j) 0]
                      (loop (if (primitive/icmp-ge (primitive/load j) nbody)
                                (break)
                                (do
                                  (nz-push-str! (mut out) (al-get [(slice u8)] body (primitive/load j)))
                                  (al-push! (mut out) (primitive/cast u8 10))
                                  (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                      (al-push! (mut out) (primitive/cast u8 10))))
                  (primitive/store! k (primitive/iadd (primitive/load k) 1))))))
    (loop (let [m (al-len [u8] (primitive/load out))]
            (if (and (primitive/icmp-ge m 2)
                     (and (primitive/icmp-eq (nz-b (al-slice [u8] (primitive/load out)) (primitive/isub m 1)) 10)
                          (primitive/icmp-eq (nz-b (al-slice [u8] (primitive/load out)) (primitive/isub m 2)) 10)))
                (do (al-pop! [u8] (mut out)) 0)
                (break))))
    (al-slice [u8] (primitive/load out))))

(defn normalize-ir [(a (ptr Allocator)) (ir (slice u8))] (-> (slice u8))
  (let [text (nz-renumber-attrs a ir)
        parsed (alloc/stack NzParsed)]
    (primitive/store! parsed (nz-parse-blocks a text))
    (let [header (primitive/load (primitive/field parsed header))
          blocks0 (primitive/load (primitive/field parsed blocks))
          rstk (alloc/stack Renum)]
      (primitive/store! rstk (nz-build-renumber a blocks0))
      (let [nb (al-len [NzBlock] blocks0)
            (mut nblocks) (al-new [NzBlock] a)
            (mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) nb)
                  (break)
                  (do
                    (let [b (alloc/stack NzBlock)
                          nbk (alloc/stack NzBlock)]
                      (primitive/store! b (al-get [NzBlock] blocks0 (primitive/load i)))
                      (primitive/store! (primitive/field nbk cat) (primitive/load (primitive/field b cat)))
                      (primitive/store! (primitive/field nbk name) (nz-apply-renumber a (primitive/load (primitive/field b name)) rstk))
                      (primitive/store! (primitive/field nbk body) (nz-map-apply a (primitive/load (primitive/field b body)) rstk))
                      (al-push! (mut nblocks) (primitive/load nbk)))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
        (nz-assemble a header (nz-sort-blocks a (primitive/load nblocks)))))))

; Tail of the pipeline: mono'd Program -> codegen -> print -> normalize -> stdout.
; Mirrors (emit_ir then normalize_ir::normalize).
(defn emit-ir-normalized [(a (ptr Allocator)) (w (ptr Writer)) (mp (ptr Program)) (triple (ptr i8))] (-> i64)
  (let [m (codegen-module a mp triple)
        ir-cstr (LLVMPrintModuleToString m)
        ir (cstr->slice ir-cstr)
        norm (normalize-ir a ir)]
    (ps w norm)
    (wb w 10)  ; mirror `coil dump-ir`'s println! trailing newline
    0))

; Shared front of the pipeline: read -> load -> expand -> resolve -> check -> mono.
; Returns `(Some mono-Program)` on success; on any pass error it dumps the Diag to
; `w` and returns `(None)`. Both `dump-ir-program` (print IR) and `build-ir-program`
; (emit object) drive this so the two share ONE pipeline.
; ============================ diagnostic renderer ===========================
; Faithful render/render_all + report/print_error:
; `error: <msg>\n  --> file:line:col\n   |\nN | <src line>\n   |   ^^^^`, plus a
; `note: in expansion of macro …` trace and an `N errors` multi-error summary.
