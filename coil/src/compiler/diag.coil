; src/compiler/diag.coil — self-host Coil compiler, diag module.
(module diag)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ast.coil" :use *)
(import "loader.coil" :use *)
(import "parser.coil" :use *)

(defn dump-error [(w (ptr Writer)) (d (ptr Diag))] (-> i64)
  (ps w "(error")
  (dump-span w (primitive/load (primitive/field d source)) (primitive/load (primitive/field d lo)) (primitive/load (primitive/field d hi)) (primitive/load (primitive/field d ctxt)))
  (ps w " \"")
  (esc-write w (primitive/load (primitive/field d msg)))
  (ps w "\")"))

(defn sm-src-text [(s (mut LS)) (id i64)] (-> (Option (slice u8)))
  (if (or (primitive/icmp-lt id 0) (primitive/icmp-ge id (al-len [Source] (primitive/load (primitive/field s sources)))))
      (None [(slice u8)])
      (let [sp (alloc/stack Source)]
        (primitive/store! sp (al-get [Source] (primitive/load (primitive/field s sources)) id))
        (Some (primitive/load (primitive/field sp text))))))
(defn sm-src-name [(s (mut LS)) (id i64)] (-> (slice u8))
  (if (or (primitive/icmp-lt id 0) (primitive/icmp-ge id (al-len [Source] (primitive/load (primitive/field s sources)))))
      "<source>"
      (let [sp (alloc/stack Source)] (primitive/store! sp (al-get [Source] (primitive/load (primitive/field s sources)) id)) (primitive/load (primitive/field sp name)))))
(defn sm-exp [(s (mut LS)) (ctxt i64)] (-> (Option Expansion))
  (if (or (primitive/icmp-le ctxt 0) (primitive/icmp-gt ctxt (al-len [Expansion] (primitive/load (primitive/field s expansions)))))
      (None [Expansion])
      (Some (al-get [Expansion] (primitive/load (primitive/field s expansions)) (primitive/isub ctxt 1)))))

; number of decimal digits in n (n >= 0).
(defn dec-len [(n i64)] (-> i64)
  (if (primitive/icmp-lt n 10) 1 (primitive/iadd 1 (dec-len (primitive/udiv n 10)))))
(defn wspaces [(w (ptr Writer)) (n i64)] (-> i64)
  (let [(mut i) 0] (loop (if (primitive/icmp-ge (primitive/load i) n) (break) (do (wb w 32) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn wrepeat [(w (ptr Writer)) (b i64) (n i64)] (-> i64)
  (let [(mut i) 0] (loop (if (primitive/icmp-ge (primitive/load i) n) (break) (do (wb w b) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)

; line (1-based), column (1-based, bytes = chars for ASCII), and the offending
; line's [start,end) byte range, for offset `off` in `src`. Mirrors span::locate.
(defstruct Loc [(line i64) (col i64) (lstart i64) (lend i64)])
(defn locate [(src (slice u8)) (off0 i64)] (-> Loc)
  (let [n (slice-len src)
        off (if (primitive/icmp-gt off0 n) n off0)
        (mut ls) 0
        (mut line) 1
        (mut k) 0]
    (loop (if (primitive/icmp-ge (primitive/load k) off)
              (break)
              (do
                (when (primitive/icmp-eq (primitive/cast i64 (slice-get src (primitive/load k))) 10)
                      (primitive/store! line (primitive/iadd (primitive/load line) 1))
                      (primitive/store! ls (primitive/iadd (primitive/load k) 1)))
                (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    (let [(mut le) off]
      (loop (if (or (primitive/icmp-ge (primitive/load le) n) (primitive/icmp-eq (primitive/cast i64 (slice-get src (primitive/load le))) 10))
                (break)
                (primitive/store! le (primitive/iadd (primitive/load le) 1))))
      (let [lp (alloc/stack Loc)]
        (primitive/store! (primitive/field lp line) (primitive/load line))
        (primitive/store! (primitive/field lp col) (primitive/iadd (primitive/isub off (primitive/load ls)) 1))
        (primitive/store! (primitive/field lp lstart) (primitive/load ls))
        (primitive/store! (primitive/field lp lend) (primitive/load le))
        (primitive/load lp)))))

; Render one located frame (mirrors span::render_frame). Returns false (no output)
; when the span is dummy / out of range, so the caller falls back to the message.
(defn render-frame [(w (ptr Writer)) (s (mut LS)) (source i64) (lo i64) (hi i64) (msg (slice u8)) (arrow (slice u8))] (-> bool)
  (match (sm-src-text (mut s) source)
    (None [] false)
    (Some [src]
          (if (or (primitive/icmp-lt lo 0) (primitive/icmp-gt lo (slice-len src)))
              false
              (let [loc (alloc/stack Loc)]
                (primitive/store! loc (locate src lo))
                (let [line (primitive/load (primitive/field loc line))
                      col (primitive/load (primitive/field loc col))
                      lstart (primitive/load (primitive/field loc lstart))
                      lend (primitive/load (primitive/field loc lend))
                      hic (let [h (if (primitive/icmp-gt hi lend) lend hi)] (if (primitive/icmp-lt h lo) lo h))
                      carets (let [c (primitive/isub hic lo)] (if (primitive/icmp-lt c 1) 1 c))
                      numlen (dec-len line)
                      file (sm-src-name (mut s) source)]
                  ; Window a very long line around the span. A macro-generated line can be tens
                  ; of KB (`cond` -> one line); printing it whole buried the caret and dumped
                  ; the entire expansion. Show at most maxw chars, with `...` (ASCII, so byte
                  ; width matches the caret math) marking either truncated end.
                  (let [maxw 120
                        ctx 32
                        long (primitive/icmp-gt (primitive/isub lend lstart) maxw)
                        wstart (if long (let [x (primitive/isub lo ctx)] (if (primitive/icmp-lt x lstart) lstart x)) lstart)
                        wend (if long (let [x (primitive/iadd wstart maxw)] (if (primitive/icmp-gt x lend) lend x)) lend)
                        pre (primitive/icmp-gt wstart lstart)
                        post (primitive/icmp-lt wend lend)
                        ; caret offset = span start within the window (+3 for a leading "...")
                        pad (primitive/iadd (primitive/isub lo wstart) (when pre 3))
                        ; don't let carets run past the visible window
                        shown
                          (let [avail (primitive/isub wend lo)
                                c (if (primitive/icmp-lt carets avail) carets avail)]
                            (if (primitive/icmp-lt c 1) 1 c))]
                    (when (primitive/icmp-gt (slice-len msg) 0) (ps w msg) (wb w 10))
                    (wspaces w numlen)
                    (wb w 32)
                    (ps w arrow)
                    (wb w 32)
                    (ps w file)
                    (wb w 58)
                    (dump-dec w line)
                    (wb w 58)
                    (dump-dec w col)
                    (wb w 10)
                    (wspaces w numlen)
                    (ps w " |")
                    (wb w 10)
                    (dump-dec w line)
                    (ps w " | ")
                    (when pre (ps w "..."))
                    (print-str w (subslice src wstart wend))
                    (when post (ps w "..."))
                    (wb w 10)
                    (wspaces w numlen)
                    (ps w " | ")
                    (wspaces w pad)
                    (wrepeat w 94 shown)
                    true)))))))

; Render one diagnostic body (mirrors span::render). No leading `error:`.
(defn render-diag [(w (ptr Writer)) (s (mut LS)) (d Diag)] (-> i64)
  (let [dp (alloc/stack Diag)]
    (primitive/store! dp d)
    (let [source (primitive/load (primitive/field dp source))
          lo (primitive/load (primitive/field dp lo))
          hi (primitive/load (primitive/field dp hi))
          ctxt0 (primitive/load (primitive/field dp ctxt))
          msg (primitive/load (primitive/field dp msg))]
      (if (not (render-frame w (mut s) source lo hi msg "-->"))
          (ps w msg)  ; fallback: bare message
          (let [(mut ctxt) ctxt0]
            (loop (match (sm-exp (mut s) (primitive/load ctxt))
                    (None [] (break))
                    (Some [exp]
                          (let [ep (alloc/stack Expansion)]
                            (primitive/store! ep exp)
                            (let [def-dummy (primitive/icmp-lt (primitive/load (primitive/field ep def_lo)) 0)
                                  at-src (if def-dummy (primitive/load (primitive/field ep call_source)) (primitive/load (primitive/field ep def_source)))
                                  at-lo (if def-dummy (primitive/load (primitive/field ep call_lo)) (primitive/load (primitive/field ep def_lo)))
                                  at-hi (if def-dummy (primitive/load (primitive/field ep call_hi)) (primitive/load (primitive/field ep def_hi)))
                                  note
                                    (sconcat3 (primitive/load (primitive/field s a))
                                              "note: in expansion of macro `"
                                              (primitive/load (primitive/field ep macro_name))
                                              "`")]
                              (wb w 10)  ; the "\n" before each note
                              (when (not (render-frame w (mut s) at-src at-lo at-hi note ":::")) (ps w note))
                              (primitive/store! ctxt (primitive/load (primitive/field ep parent))))))))))))
  0)

; Render all diagnostics (mirrors span::render_all): the caller has written the
; leading `error: `; subsequent errors get their own `\n\nerror: `, then an
; `N errors` summary when there is more than one.
(defn render-all [(w (ptr Writer)) (s (mut LS)) (diags (ptr (ArrayList Diag)))] (-> i64)
  (let [n (al-len [Diag] (primitive/load diags))]
    (if (primitive/icmp-le n 1)
        (unless (primitive/icmp-eq n 0) (render-diag w (mut s) (al-get [Diag] (primitive/load diags) 0)))
        (let [(mut i) 0]
          (loop (if (primitive/icmp-ge (primitive/load i) n)
                    (break)
                    (do
                      (when (primitive/icmp-gt (primitive/load i) 0) (ps w "\n\nerror: "))
                      (render-diag w (mut s) (al-get [Diag] (primitive/load diags) (primitive/load i)))
                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
          (ps w "\n\n")
          (dump-dec w n)
          (ps w " errors")
          0)))
  0)

; A single diagnostic → the top-level `error: <rendered>` on stderr (mirrors
; The main source (id 0) is registered under the real
; path, so no `<source>` substitution is needed.
(defn report-diag [(w (ptr Writer)) (s (mut LS)) (d Diag)] (-> i64)
  (ps w "error: ")
  (render-diag w (mut s) d)
  (wb w 10)
  0)

; A check failure: render EVERY collected body error (`error: … / … / N errors`)
; when there is more than one, else the single diagnostic. Mirrors render_all.
(defn report-check-diags [(w (ptr Writer)) (s (mut LS)) (d Diag)] (-> i64)
  (if (primitive/icmp-gt (al-len [Diag] (primitive/load (primitive/field s check_diags))) 1)
      (do (ps w "error: ") (render-all w (mut s) (primitive/load (primitive/field s check_diags))) (wb w 10) 0)
      (report-diag w (mut s) d)))
