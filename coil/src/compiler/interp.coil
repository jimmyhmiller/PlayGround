; src/compiler/interp.coil — a BYTECODE interpreter for the self-host Coil
; compiler. It consumes the SAME monomorphized Program the native backends
; consume (parse -> resolve -> check -> mono), compiles each mono'd function to a
; compact stack-bytecode ISA, and executes it on a small VM with a REAL memory
; model: pointers are genuine host addresses, `alloc-stack` bumps a malloc-backed
; per-frame buffer, heap allocations call real malloc, and loads/stores read and
; write actual process memory. FFI extern calls dispatch to real native libc
; functions through a builtin table, so a program that prints via `putchar` /
; `write` / `puts` actually prints.
;
; This module is strictly ADDITIVE: nothing here is wired into the compile
; pipeline. The driver's new `coil interp <file>` subcommand is the only entry
; point (driver.coil). The native backends are byte-unchanged.
;
; See docs/reference/BYTECODE_INTERP.md for the ISA, value/memory model, frame layout, and
; FFI dispatch.
;
; SCOPE: the slice implemented end-to-end is integer + float arithmetic,
; locals/let/mut, if/loop/while, direct calls + recursion, casts, pointer
; load/store + alloc, and libc FFI. Everything not yet implemented HARD-ERRORS
; with a clear message (idie) — never a silent no-op or sentinel.
(module interp)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ast.coil" :use *)
(import "parser.coil" :use *)
(import "layoutdb.coil" :use *)

; libc functions the interpreter itself uses + the FFI builtin table. Names are
; module-qualified so the C SYMBOL is the last dot component (g-last-component),
; matching the cga64.* pattern; this avoids Coil-scope collisions with the same
; extern declared elsewhere while still linking to the real libc symbol.
; Signatures MUST match any other declaration of the same C symbol elsewhere in
; the compiler (one C symbol, one signature): `exit`/`write`/`malloc` are already
; declared in ffi/io/alloc, so these mirror those exactly. `putchar`/`puts` are
; unique to the interpreter.
(extern interp.malloc [isize] (-> (ptr i8)))  ; size_t — mirror alloc.malloc (isize, not i64)
(extern interp.free [(ptr i8)] (-> i64))
(extern interp.exit [i32] (-> i64))
(extern interp.putchar [i64] (-> i64))
(extern interp.write [i32 (ptr i8) isize] (-> isize))
(extern interp.puts [(ptr i8)] (-> i64))
(extern interp.realloc [(ptr i8) isize] (-> (ptr i8)))
(extern interp.calloc [isize isize] (-> (ptr i8)))
(extern interp.memcpy [(ptr i8) (ptr i8) isize] (-> (ptr i8)))
(extern interp.memmove [(ptr i8) (ptr i8) isize] (-> (ptr i8)))
(extern interp.memset [(ptr i8) i64 isize] (-> (ptr i8)))
(extern interp.memcmp [(ptr i8) (ptr i8) isize] (-> i64))
(extern interp.strlen [(ptr i8)] (-> isize))
(extern interp.strcmp [(ptr i8) (ptr i8)] (-> i32))
(extern interp.read [i32 (ptr i8) isize] (-> isize))
(extern interp.abort [] (-> i64))
(extern interp.fmod [f64 f64] (-> f64))
(extern interp.fmodf [f32 f32] (-> f32))
(extern interp.sqrt [f64] (-> f64))
(extern interp.pow [f64 f64] (-> f64))
(extern interp.fabs [f64] (-> f64))
(extern interp.floor [f64] (-> f64))
(extern interp.ceil [f64] (-> f64))
(extern interp.strtol [(ptr i8) (ptr (ptr i8)) i32] (-> i64))
(extern interp.atoi [(ptr i8)] (-> i32))
; Variadic forwarding. We always pass a fixed tail of 6 word-sized varargs; a
; real printf/snprintf reads only as many as the format string names, so extra
; (unused) trailing words are harmless. This is correct for integer / string /
; char / pointer conversions (the corpus' usage); %f-family (v-register)
; variadics are NOT supported and are not exercised.
(extern interp.printf [(ptr i8) ...] (-> i32))
(extern interp.snprintf [(ptr i8) i64 (ptr i8) ...] (-> i32))
(extern interp.dprintf [i32 (ptr i8) ...] (-> i32))

; address of element i of an ArrayList given by pointer (local copy of the a64
; helper, renamed to avoid a duplicate generic instantiation clash).
(defn ial-at [T] [(p (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (primitive/index (primitive/load (primitive/field p data)) i))

; ============================ hard-error helpers =============================
(defn idie [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "interp: ") (ps w msg) (wb w 10) (interp.exit (primitive/cast i32 1)) 0))
(defn idie2 [(msg (slice u8)) (x (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "interp: ") (ps w msg) (ps w x) (wb w 10) (interp.exit (primitive/cast i32 1)) 0))

; ============================ bytecode data model ============================
; One instruction: op + three immediate operands. See docs/reference/BYTECODE_INTERP.md
; for the opcode legend (mirrored in the VM `case` below).
(defstruct Instr [(op i64) (a i64) (b i64) (c i64)])

(defstruct BFunc
  [(name (slice u8))
   (nparams i64)
   (nlocals i64)
   (code (ptr (ArrayList Instr)))
   (retty Type)
   (state i64)])  ; 0 = body not yet compiled, 1 = compiled (lazy: only funcs reachable from main are compiled)

; a compile-time scope entry: local slot index + static type.
(defstruct CScope [(name (slice u8)) (slot i64) (ty Type) (next (ptr CScope))])

; a lexically-open loop during compilation.
(defstruct CLoop
  [(contlabel i64)
   (breaklabel i64)
   (resultlocal i64)
   (label (Option (slice u8)))
   (has_res bool)
   (resty Type)])

; per-function bytecode builder.
(defstruct FB
  [(cx (ptr Interp))
   (code (ArrayList Instr))
   (loops (ArrayList CLoop))
   (labels (ArrayList i64))
   (nlocals i64)
   (env (ptr CScope))
   (term bool)])

; a parsed inline-LLVM-IR body (see ELlvmIr): the raw text + the arg types,
; interpreted at runtime against the VM's real memory. `result` is the IR's $ret.
(defstruct IIr [(body (slice u8)) (argtys (ArrayList Type)) (result Type)])

; the interpreter context: the mono'd program + compiled functions + layouts.
(defstruct Interp
  [(a (ptr Allocator))
   (mp (ptr Program))
   (externs (ptr (ArrayList Extern)))
   (bfuncs (ArrayList BFunc))
   (layouts LayoutDb)
   (irs (ArrayList IIr))])

; ============================ scope helpers ==================================
(defn cs-cons [(a (ptr Allocator)) (nm (slice u8)) (slot i64) (ty Type) (nx (ptr CScope))] (-> (ptr CScope))
  (let [p (unwrap-ptr [CScope] (create [CScope] a))]
    (primitive/store! (primitive/field p name) nm)
    (primitive/store! (primitive/field p slot) slot)
    (primitive/store! (primitive/field p ty) ty)
    (primitive/store! (primitive/field p next) nx)
    p))
(defn cs-find [(s (ptr CScope)) (nm (slice u8))] (-> (ptr CScope))
  (if (primitive/icmp-eq (primitive/cast i64 s) 0)
      (primitive/cast (ptr CScope) 0)
      (if (str-eq (primitive/load (primitive/field s name)) nm) s (cs-find (primitive/load (primitive/field s next)) nm))))

; ============================ struct/sum layout ==============================
; The VM retains these names because they describe bytecode operations at call
; sites, but all layout facts come from the same database as every backend.
(defn istruct-idx [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (struct-index (primitive/field cx layouts) nm))
(defn isum-idx [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (sum-index (primitive/field cx layouts) nm))
(defn isize-of [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  ; Bytecode compilation uses zero as the return size of a void function.
  (match-else (primitive/load tp)
              (TVoid [] 0)
              (_ (size (primitive/field cx layouts) tp))))
(defn ialign-of [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  (align (primitive/field cx layouts) tp))
(defn ifield-off [(cx (ptr Interp)) (si i64) (fi i64)] (-> i64)
  (field-offset (primitive/field cx layouts) si fi))
(defn ifield-idx [(cx (ptr Interp)) (si i64) (fname (slice u8))] (-> i64)
  (field-number (primitive/field cx layouts) si fname))
(defn itype-bytes [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  (type-bytes (primitive/field cx layouts) tp))
(defn isum-words-def [(cx (ptr Interp)) (variants (ptr (ArrayList Variant)))] (-> i64)
  (sum-words (primitive/field cx layouts) variants))
(defn inatural-off [(cx (ptr Interp)) (fs (ptr (ArrayList Field))) (fi i64)] (-> i64)
  (natural-offset (primitive/field cx layouts) fs fi))
(defn ivariant-idx [(cx (ptr Interp)) (su i64) (vname (slice u8))] (-> i64)
  (variant-number (primitive/field cx layouts) su vname))
(defn iregister-types! [(cx (ptr Interp)) (mp (ptr Program))] (-> i64)
  (primitive/store! (primitive/field cx layouts) (LayoutDb::new (primitive/load (primitive/field cx a)) mp "interp"))
  0)

; Bit-struct access needs the declared bit offsets and field types in addition
; to ordinary byte layout, so it reads the shared entry directly.
(defn ibits-info [(cx (ptr Interp))
                  (nm (slice u8))
                  (fname (slice u8))
                  (lowp (ptr i64))
                  (widthp (ptr i64))
                  (signedp (ptr bool))
                  (backbytesp (ptr i64))] (-> i64)
  (let [si (istruct-idx cx nm)]
    (when (primitive/icmp-lt si 0) (idie2 "bit access on unknown struct: " nm))
    (let [e (struct-at (primitive/field cx layouts) si)]
      (match-else (primitive/load (primitive/field e layout))
                  (LBits [backing offs]
                         (let [fi (ifield-idx cx si fname)]
                           (primitive/store! lowp (al-get [i64] (primitive/load offs) fi))
                           (primitive/store! backbytesp (primitive/idiv backing 8))
                           (match-else (primitive/load (primitive/field (ial-at [Field] (primitive/load (primitive/field e fields)) fi) ty))
                                       (TInt [bits sg] (do (primitive/store! widthp bits) (primitive/store! signedp sg) 0))
                                       (TBool [] (do (primitive/store! widthp 1) (primitive/store! signedp false) 0))
                                       (_ (do (idie "bit-struct field with non-int type") 0)))))
                  (_ (do (idie2 "bit access on non-bits struct: " nm) 0))))))
; Bytecode type classification is interpreter policy, not physical layout.
(defn signed-of [(tp (ptr Type))] (-> bool)
  (match-else (primitive/load tp) (TInt [b sg] sg) (_ false)))
(defn ty-is-agg [(tp (ptr Type))] (-> bool)
  (match-else (primitive/load tp)
              (TStruct [nm] true)
              (TSlice [e0] true)
              (TArray [e1 n0] true)
              (TVec [e2 n1] true)
              (_ false)))
(defn ty-is-float2 [(tp (ptr Type))] (-> bool)
  (match-else (primitive/load tp) (TFloat [b] true) (_ false)))
(defn fbytes-of [(tp (ptr Type))] (-> i64)
  (match-else (primitive/load tp) (TFloat [b] (primitive/idiv b 8)) (_ 8)))
(defn isbool01 [(t Type)] (-> i64)
  (match-else t (TBool [] 1) (_ 0)))
(defn ty-pointee2 [(tp (ptr Type))] (-> Type)
  (match-else (primitive/load tp)
              (TPtr [inner] (primitive/load inner))
              (TRef [m2 inner] (primitive/load inner))
              (_ (do (idie "load/deref of a non-pointer value") (TInt 64 true)))))
(defn tmode [(tp (ptr Type))] (-> i64)
  (match-else (primitive/load tp)
              (TFloat [bits] (if (primitive/icmp-eq bits 32) 1 2))
              (_ 0)))
(defn tsignbits [(tp (ptr Type))] (-> i64)
  (match-else (primitive/load tp)
              (TInt [bits sg] (primitive/ior (when sg 1) (primitive/ishl bits 1)))
              (TBool [] (primitive/ishl 1 1))
              (_ (primitive/ishl 64 1))))
(defn tsigned [(tp (ptr Type))] (-> i64)
  (match-else (primitive/load tp)
              (TInt [bits sg] (when sg 1))
              (TBool [] 0)
              (_ 1)))
(defn tsize [(cx (ptr Interp)) (t Type)] (-> i64)
  (let [tp (alloc/stack Type)] (primitive/store! tp t) (isize-of cx tp)))

; ============================ bytecode emit ==================================
(defn femit [(fb (ptr FB)) (op i64) (a i64) (b i64) (c i64)] (-> i64)
  (let [ins (alloc/stack Instr)]
    (primitive/store! (primitive/field ins op) op)
    (primitive/store! (primitive/field ins a) a)
    (primitive/store! (primitive/field ins b) b)
    (primitive/store! (primitive/field ins c) c)
    (al-push! (mut (primitive/field fb code)) (primitive/load ins))
    0))

(defn fnew-label [(fb (ptr FB))] (-> i64)
  (let [id (al-len [i64] (primitive/load (primitive/field fb labels)))]
    (al-push! (mut (primitive/field fb labels)) -1)
    id))
(defn fbind-label [(fb (ptr FB)) (id i64)] (-> i64)
  (al-set! (mut (primitive/field fb labels)) id (al-len [Instr] (primitive/load (primitive/field fb code))))
  0)
(defn fb-local! [(fb (ptr FB))] (-> i64)
  (let [n (primitive/load (primitive/field fb nlocals))] (primitive/store! (primitive/field fb nlocals) (primitive/iadd n 1)) n))

; rewrite every JMP(11)/JZ(12) target from label-id to instruction index.
(defn resolve-labels [(fb (ptr FB))] (-> i64)
  (let [n (al-len [Instr] (primitive/load (primitive/field fb code)))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ins (ial-at [Instr] (primitive/field fb code) (primitive/load i))
                      op (primitive/load (primitive/field ins op))]
                  (when (or (primitive/icmp-eq op 11) (primitive/icmp-eq op 12))
                        (primitive/store! (primitive/field ins a) (al-get [i64] (primitive/load (primitive/field fb labels)) (primitive/load (primitive/field ins a))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)

; ============================ compile-time helpers ===========================
(defn find-func [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (let [n (al-len [BFunc] (primitive/load (primitive/field cx bfuncs)))
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (ial-at [BFunc] (primitive/field cx bfuncs) (primitive/load i)) name)) nm)
                      (primitive/store! r (primitive/load i))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

(defn find-extern [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (let [es (primitive/load (primitive/field cx externs))
        n (al-len [Extern] (primitive/load es))
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (ial-at [Extern] es (primitive/load i)) name)) nm) (primitive/store! r (primitive/load i)) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

; loop index (labeled search from innermost, else innermost). Mirrors g-loop-index.
(defn cloop-index [(fb (ptr FB)) (label (Option (slice u8)))] (-> i64)
  (let [n (al-len [CLoop] (primitive/load (primitive/field fb loops)))]
    (match label
      (None []
            (do
              (when (primitive/icmp-eq n 0) (idie "break/continue outside a loop"))
              (primitive/isub n 1)))
      (Some [want]
            (let [(mut i) (primitive/isub n 1)
                  (mut r) -1]
              (loop (if (primitive/icmp-lt (primitive/load i) 0)
                        (break)
                        (do
                          (match (primitive/load (primitive/field (ial-at [CLoop] (primitive/field fb loops) (primitive/load i)) label))
                            (None [] 0)
                            (Some [have]
                                  (when (and (primitive/icmp-lt (primitive/load r) 0) (str-eq have want)) (primitive/store! r (primitive/load i)) 0)))
                          (primitive/store! i (primitive/isub (primitive/load i) 1)))))
              (when (primitive/icmp-lt (primitive/load r) 0) (idie2 "no such loop label: " want))
              (primitive/load r))))))

; A Coil function pointer is encoded as (fnptr-base + fidx): a large, nonzero,
; distinctive tag so a valid fnptr never collides with 0 (null) or small ints,
; and ECallPtr decodes the fidx back. (Real C function addresses are not
; supported as call targets — only Coil functions taken with fnptr-of.)
(defn fnptr-base [] (-> i64)
  2251799813685248)  ; 2^51
; the (TFn …) type of function fidx, built from its params + ret (for ECallPtr).
(defn func-fn-type [(cx (ptr Interp)) (fi i64)] (-> Type)
  (let [a (primitive/load (primitive/field cx a))
        fd (ial-at [Func] (primitive/load (primitive/field (primitive/load (primitive/field cx mp)) funcs)) fi)
        ps (primitive/load (primitive/field fd params))
        np (al-len [Param] (primitive/load ps))
        (mut ptys) (al-new [Type] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) np)
              (break)
              (do
                (al-push! (mut ptys) (primitive/load (primitive/field (ial-at [Param] ps (primitive/load i)) ty)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (TFn "c" (box-al [Type] a ptys) (box-type a (primitive/load (primitive/field fd ret))))))

; the last dot component of a name (extern "io.write" -> C symbol "write").
(defn last-component2 [(nm (slice u8))] (-> (slice u8))
  (let [n (slice-len nm)
        (mut dot) -1
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-eq (primitive/cast i64 (slice-get nm (primitive/load i))) 46) (primitive/store! dot (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/icmp-ge (primitive/load dot) 0) (subslice nm (primitive/iadd (primitive/load dot) 1) n) nm)))

; intern a string literal into a persistent, NUL-terminated malloc region and
; return its address. String literals are compile-time constants, so the pointer
; is baked into the bytecode as an immediate.
(defn intern-bytes [(sv (slice u8))] (-> i64)
  (let [n (slice-len sv)
        addr (primitive/cast i64 (interp.malloc (primitive/cast isize (primitive/iadd n 1))))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (primitive/store! (primitive/cast (ptr u8) (primitive/iadd addr (primitive/load i))) (slice-get sv (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/store! (primitive/cast (ptr u8) (primitive/iadd addr n)) (primitive/cast u8 0))
    addr))

; ============================ compile ========================================
(defn compile-args [(fb (ptr FB)) (args (ptr (ArrayList Expr)))] (-> i64)
  (let [n (al-len [Expr] (primitive/load args))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (compile-expr fb (ial-at [Expr] args (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)

(defn compile-call [(fb (ptr FB)) (func (slice u8)) (args (ptr (ArrayList Expr)))] (-> Type)
  (let [cx (primitive/load (primitive/field fb cx))
        fi (find-func cx func)]
    (if (primitive/icmp-ge fi 0)
        (do
          (compile-args fb args)
          (femit fb 13 fi (al-len [Expr] (primitive/load args)) 0)
          (ensure-compiled cx fi)
          (primitive/load (primitive/field (ial-at [BFunc] (primitive/field cx bfuncs) fi) retty)))
        (let [ei (find-extern cx func)]
          (if (primitive/icmp-ge ei 0)
              (do
                (compile-args fb args)
                (femit fb 14 ei (al-len [Expr] (primitive/load args)) 0)
                (let [rt (primitive/load (primitive/field (ial-at [Extern] (primitive/load (primitive/field cx externs)) ei) ret))
                      rtp (alloc/stack Type)]
                  (primitive/store! rtp rt)
                  ; a by-value aggregate C return (<=8 bytes, e.g. div's div_t in
                  ; x0) comes back as a packed word; box it into a frame slot so it
                  ; behaves as an aggregate value (an address) like any other.
                  (when (ty-is-agg rtp) (femit fb 43 (isize-of cx rtp) (ialign-of cx rtp) 0))
                  rt))
              (do (idie2 "call to unknown function: " func) (TInt 64 true)))))))

; compile a sequence, POPping all but the last; returns the last expr's type
; (the sequence's value). Used for do / let body / function body.
(defn compile-seq [(fb (ptr FB)) (body (ptr (ArrayList Expr)))] (-> Type)
  (let [n (al-len [Expr] (primitive/load body))
        (mut i) 0
        (mut last) (TInt 64 true)]
    (when (primitive/icmp-eq n 0) (femit fb 1 0 0 0) 0)  ; empty body -> push 0
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/load (primitive/field fb term)) (break))
                (primitive/store! last (compile-expr fb (ial-at [Expr] body (primitive/load i))))
                (when (and (primitive/icmp-lt (primitive/load i) (primitive/isub n 1)) (not (primitive/load (primitive/field fb term)))) (femit fb 4 0 0 0))  ; POP intermediate result
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load last)))

; compile a statement sequence, POPping EVERY produced value (used for loop bodies).
(defn compile-stmts [(fb (ptr FB)) (body (ptr (ArrayList Expr)))] (-> i64)
  (let [n (al-len [Expr] (primitive/load body))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/load (primitive/field fb term)) (break))
                (compile-expr fb (ial-at [Expr] body (primitive/load i)))
                (unless (primitive/load (primitive/field fb term)) (femit fb 4 0 0 0))  ; POP
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)

(defn compile-binds [(fb (ptr FB)) (binds (ptr (ArrayList Bind)))] (-> i64)
  (let [n (al-len [Bind] (primitive/load binds))
        (mut i) 0
        cx (primitive/load (primitive/field fb cx))
        a (primitive/load (primitive/field cx a))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [b (ial-at [Bind] binds (primitive/load i))
                      t (compile-expr fb (primitive/field b value))]
                  (if (primitive/load (primitive/field b mutable))
                      ; mutable: spill to a frame cell, bind name -> pointer to it
                      (let [tp (alloc/stack Type)
                            l (fb-local! fb)]
                        (primitive/store! tp t)
                        (femit fb 21 l (isize-of cx tp) (when (ty-is-agg tp) 1))  ; MUTCELL
                        (primitive/store! (primitive/field fb env)
                                (cs-cons a (primitive/load (primitive/field b name)) l (TPtr (box-type a t)) (primitive/load (primitive/field fb env)))))
                      ; immutable: bind name -> a plain local holding the value
                      (let [l (fb-local! fb)]
                        (femit fb 3 l 0 0)  ; SETLOCAL
                        (primitive/store! (primitive/field fb env)
                                (cs-cons a (primitive/load (primitive/field b name)) l t (primitive/load (primitive/field fb env)))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)

; compile ONE expression; emit its bytecode (leaving exactly one value on the
; operand stack unless the path terminated) and RETURN its static type. This is
; the interpreter analogue of codegen_a64's emit-expr returning an AVal.
(defn compile-expr [(fb (ptr FB)) (e (ptr Expr))] (-> Type)
  (let [cx (primitive/load (primitive/field fb cx))
        a (primitive/load (primitive/field cx a))]
    (match-else (primitive/load (primitive/field e kind))
                (EInt [v] (do (femit fb 1 v 0 0) (TInt 64 true)))
                (EFloat [bits] (do (femit fb 1 bits 0 0) (TFloat 64)))
                (EBool [b] (do (femit fb 1 (when b 1) 0 0) (TBool)))
                (EVar [name]
                      (let [node (cs-find (primitive/load (primitive/field fb env)) name)]
                        (if (primitive/icmp-eq (primitive/cast i64 node) 0)
                            (do (idie2 "unbound variable: " name) (TInt 64 true))
                            (do (femit fb 2 (primitive/load (primitive/field node slot)) 0 0) (primitive/load (primitive/field node ty))))))
                (ELet [binds body]
                      (let [sv (primitive/load (primitive/field fb env))]
                        (compile-binds fb binds)
                        (let [bt (compile-seq fb body)] (primitive/store! (primitive/field fb env) sv) bt)))
                (EDo [body] (compile-seq fb body))
                (EBin [op lhs rhs]
                      (let [tp (alloc/stack Type)]
                        (primitive/store! tp (compile-expr fb lhs))
                        (compile-expr fb rhs)
                        (femit fb 8 op (tmode tp) (tsignbits tp))
                        (primitive/load tp)))
                (ECmp [op lhs rhs]
                      (let [tp (alloc/stack Type)]
                        (primitive/store! tp (compile-expr fb lhs))
                        (compile-expr fb rhs)
                        (femit fb 9 op (tmode tp) (tsigned tp))
                        (TBool)))
                (ENot [inner]
                      (let [t (compile-expr fb inner)]
                        (femit fb 10 (isbool01 t) 0 0)
                        t))
                (EIf [cnd thn els]
                     (do
                       (compile-expr fb cnd)
                       (let [lelse (fnew-label fb)
                             lend (fnew-label fb)]
                         (femit fb 12 lelse 0 0)  ; JZ lelse
                         (let [tt (compile-expr fb thn)
                               thnterm (primitive/load (primitive/field fb term))]
                           (unless thnterm (femit fb 11 lend 0 0))  ; JMP lend
                           (primitive/store! (primitive/field fb term) false)
                           (fbind-label fb lelse)
                           (let [et (compile-expr fb els)
                                 elsterm (primitive/load (primitive/field fb term))]
                             (fbind-label fb lend)
                             (primitive/store! (primitive/field fb term) (and thnterm elsterm))
                             (if thnterm et tt))))))
                (ELoop [label body]
                       (let [contlabel (fnew-label fb)
                             breaklabel (fnew-label fb)
                             resultl (fb-local! fb)
                             gl (alloc/stack CLoop)]
                         (primitive/store! (primitive/field gl contlabel) contlabel)
                         (primitive/store! (primitive/field gl breaklabel) breaklabel)
                         (primitive/store! (primitive/field gl resultlocal) resultl)
                         (primitive/store! (primitive/field gl label) label)
                         (primitive/store! (primitive/field gl has_res) false)
                         (primitive/store! (primitive/field gl resty) (TInt 64 true))
                         (al-push! (mut (primitive/field fb loops)) (primitive/load gl))
                         (fbind-label fb contlabel)
                         (compile-stmts fb body)
                         (unless (primitive/load (primitive/field fb term)) (femit fb 11 contlabel 0 0))  ; JMP contlabel (loop)
                         (let [nn (al-len [CLoop] (primitive/load (primitive/field fb loops)))
                               fin (ial-at [CLoop] (primitive/field fb loops) (primitive/isub nn 1))
                               had (primitive/load (primitive/field fin has_res))
                               rty (primitive/load (primitive/field fin resty))]
                           (primitive/store! (primitive/field (primitive/field fb loops) len) (primitive/isub nn 1))  ; pop loop frame
                           (fbind-label fb breaklabel)
                           (if had (femit fb 2 resultl 0 0) (femit fb 1 0 0 0))  ; push loop value (or dead 0)
                           (primitive/store! (primitive/field fb term) (not had))
                           rty)))
                (EBreak [label value]
                        (let [li (cloop-index fb label)
                              lp (ial-at [CLoop] (primitive/field fb loops) li)]
                          (match value
                            (Some [ve]
                                  (let [vt (compile-expr fb ve)]
                                    (femit fb 3 (primitive/load (primitive/field lp resultlocal)) 0 0)  ; SETLOCAL resultlocal
                                    (primitive/store! (primitive/field lp resty) vt)))
                            (None []
                                  (do
                                    (femit fb 1 0 0 0)  ; push 0
                                    (femit fb 3 (primitive/load (primitive/field lp resultlocal)) 0 0))))
                          (primitive/store! (primitive/field lp has_res) true)
                          (femit fb 11 (primitive/load (primitive/field lp breaklabel)) 0 0)  ; JMP breaklabel
                          (primitive/store! (primitive/field fb term) true)
                          (TInt 64 true)))
                (EContinue [label]
                           (let [li (cloop-index fb label)
                                 lp (ial-at [CLoop] (primitive/field fb loops) li)]
                             (femit fb 11 (primitive/load (primitive/field lp contlabel)) 0 0)
                             (primitive/store! (primitive/field fb term) true)
                             (TInt 64 true)))
                (ECall [func targs args] (compile-call fb func args))
                (ELoad [inner]
                       (let [tp (alloc/stack Type)]
                         (primitive/store! tp (compile-expr fb inner))
                         (let [pt (alloc/stack Type)]
                           (primitive/store! pt (ty-pointee2 tp))
                           (if (ty-is-agg pt)
                               (femit fb 32 (isize-of cx pt) (ialign-of cx pt) 0)  ; LOADAGG (fresh copy)
                               (femit fb 6 (isize-of cx pt) (when (signed-of pt) 1) 0))  ; LOAD scalar
                           (primitive/load pt))))
                (EStore [p val]
                        (do
                          (compile-expr fb p)
                          (let [vt (alloc/stack Type)]
                            (primitive/store! vt (compile-expr fb val))
                            (if (ty-is-agg vt)
                                (femit fb 33 (isize-of cx vt) 0 0)  ; STOREAGG (memcpy)
                                (femit fb 7 (isize-of cx vt) 0 0))  ; STORE scalar
                            (TInt 64 true))))
                (ECast [t inner]
                       (let [st (alloc/stack Type)]
                         (primitive/store! st (compile-expr fb inner))
                         (match-else t
                                     (TInt [dbits dsigned]
                                           (do
                                             (if (ty-is-float2 st)
                                                 (femit fb 18 dbits (when dsigned 1) (fbytes-of st))  ; F2I
                                                 (femit fb 16 dbits (when dsigned 1) 0))  ; ICANON
                                             t))
                                     (TFloat [dbits]
                                             (do
                                               (if (ty-is-float2 st)
                                                   (femit fb 19 (primitive/idiv dbits 8) (fbytes-of st) 0)  ; F2F
                                                   (femit fb 17 (primitive/idiv dbits 8) (when (signed-of st) 1) 0))  ; I2F
                                               t))
                                     (_ t))))  ; ptr / fnptr / bool targets: identity 8-byte value
                (EAlloc [storage t]
                        (let [tp (alloc/stack Type)]
                          (primitive/store! tp t)
                          (let [sz (isize-of cx tp)
                                al (ialign-of cx tp)]
                            (cond (primitive/icmp-eq storage 0) (femit fb 5 sz al 0)  ; stack (uninit)
                                  (primitive/icmp-eq storage 2) (femit fb 23 sz 0 0)  ; heap malloc
                                  ; static: allocate ONCE at compile time (one persistent, zeroed
                                  ; region per alloc-static site, shared across all executions —
                                  ; mirrors codegen's per-site zeroed global) and bake its address.
                                  (let [addr (primitive/cast i64 (interp.malloc (primitive/cast isize sz)))]
                                    (memzero addr sz)
                                    (femit fb 1 addr 0 0)))
                            (TPtr (box-type a t)))))
                (EZeroed [t]
                         (let [tp (alloc/stack Type)]
                           (primitive/store! tp t)
                           ; an aggregate zero is a zeroed slot (ADDRESS), regardless of size; a
                           ; scalar zero is the literal 0. (A small struct is still by-address, so
                           ; sizing alone must NOT decide — that pushed a bare 0 that a later
                           ; aggregate copy dereferenced as a null pointer.)
                           (if (ty-is-agg tp)
                               (femit fb 31 (isize-of cx tp) (ialign-of cx tp) 0)
                               (femit fb 1 0 0 0))
                           t))
                (EFree [inner] (do (compile-expr fb inner) (femit fb 22 0 0 0) (TInt 64 true)))
                (ESizeOf [t]
                         (let [tp (alloc/stack Type)] (primitive/store! tp t) (femit fb 1 (isize-of cx tp) 0 0) (TInt 64 true)))
                (EAlignOf [t]
                          (let [tp (alloc/stack Type)] (primitive/store! tp t) (femit fb 1 (ialign-of cx tp) 0 0) (TInt 64 true)))
                (EStr [sv] (do (femit fb 30 (intern-bytes sv) (slice-len sv) 0) (TSlice (box-type a (TInt 8 false)))))
                (ECStr [sv] (do (femit fb 1 (intern-bytes sv) 0 0) (TPtr (box-type a (TInt 8 true)))))
                (EBorrow [m place] (compile-expr fb place))
                (ESpillRef [inner]
                           (let [tp (alloc/stack Type)]
                             (primitive/store! tp (compile-expr fb inner))
                             (let [l (fb-local! fb)]
                               (femit fb 21 l (isize-of cx tp) (when (ty-is-agg tp) 1))
                               (femit fb 2 l 0 0)
                               (TPtr (box-type a (primitive/load tp))))))
                (EField [p fname]
                        (let [t (alloc/stack Type)]
                          (primitive/store! t (compile-expr fb p))  ; pushes a pointer-to-struct
                          (let [pt (alloc/stack Type)]
                            (primitive/store! pt (ty-pointee2 t))
                            (match-else (primitive/load pt)
                                        (TStruct [nm]
                                                 (let [si (istruct-idx cx nm)]
                                                   (when (primitive/icmp-lt si 0) (idie2 "field access on non-struct: " nm))
                                                   (let [fi (ifield-idx cx si fname)
                                                         off (ifield-off cx si fi)
                                                         fty
                                                           (primitive/load (primitive/field (ial-at [Field]
                                                                                (primitive/load (primitive/field (struct-at (primitive/field cx layouts) si) fields))
                                                                                fi)
                                                                        ty))]
                                                     (when (primitive/icmp-ne off 0) (femit fb 34 off 0 0))  ; FIELDPTR: addr += off
                                                     (TPtr (box-type a fty)))))
                                        (_ (do (idie "field access through non-struct pointer") (TInt 64 true)))))))
                (EIndex [p idx]
                        (let [t (alloc/stack Type)]
                          (primitive/store! t (compile-expr fb p))  ; base pointer
                          (compile-expr fb idx)  ; index
                          (let [pt (alloc/stack Type)
                                ep (alloc/stack Type)]
                            (primitive/store! pt (ty-pointee2 t))
                            (match-else (primitive/load pt)
                                        (TArray [elem n0] (primitive/store! ep (primitive/load elem)))
                                        (_ (primitive/store! ep (primitive/load pt))))
                            (femit fb 35 (isize-of cx ep) 0 0)  ; INDEX: base + idx*esz
                            (TPtr (box-type a (primitive/load ep))))))
                (EConstruct [sum variant args]
                            (let [su (isum-idx cx sum)]
                              (when (primitive/icmp-lt su 0) (idie2 "construct of unknown sum: " sum))
                              (let [vidx (ivariant-idx cx su variant)
                                    sumtp (alloc/stack Type)]
                                (primitive/store! sumtp (TStruct sum))
                                (let [sz (isize-of cx sumtp)
                                      aln (ialign-of cx sumtp)
                                      vs (primitive/load (primitive/field (sum-at (primitive/field cx layouts) su) variants))
                                      vfields (primitive/load (primitive/field (ial-at [Variant] vs vidx) fields))
                                      n (al-len [Expr] (primitive/load args))
                                      l (fb-local! fb)
                                      (mut i) 0]
                                  (femit fb 31 sz aln 0)  ; ALLOCZ zeroed slot
                                  (femit fb 3 l 0 0)  ; SETLOCAL l = slot addr
                                  ; tag (i32 at offset 0)
                                  (femit fb 2 l 0 0)
                                  (femit fb 1 vidx 0 0)
                                  (femit fb 7 4 0 0)
                                  (femit fb 4 0 0 0)
                                  ; payload fields at natural offsets within the variant struct, from slot+8
                                  (loop (if (primitive/icmp-ge (primitive/load i) n)
                                            (break)
                                            (do
                                              (let [foff (primitive/iadd 8 (inatural-off cx vfields (primitive/load i)))]
                                                (femit fb 2 l 0 0)  ; base = slot
                                                (when (primitive/icmp-ne foff 0) (femit fb 34 foff 0 0))  ; addr = slot+foff
                                                (let [ft (alloc/stack Type)]
                                                  (primitive/store! ft (compile-expr fb (ial-at [Expr] args (primitive/load i))))
                                                  (if (ty-is-agg ft)
                                                      (femit fb 33 (isize-of cx ft) 0 0)
                                                      (femit fb 7 (isize-of cx ft) 0 0)))
                                                (femit fb 4 0 0 0))  ; pop store's unit
                                              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                                  (femit fb 2 l 0 0)  ; push slot addr (the sum value)
                                  (TStruct sum)))))
                (EMatch [scrut arms]
                        (let [st (alloc/stack Type)]
                          (primitive/store! st (compile-expr fb scrut))
                          (let [sumname (match-else (primitive/load st) (TStruct [nm] nm) (_ ""))
                                su (isum-idx cx sumname)]
                            (when (primitive/icmp-lt su 0) (idie2 "match on non-sum: " sumname))
                            (let [vs (primitive/load (primitive/field (sum-at (primitive/field cx layouts) su) variants))
                                  narms (al-len [Arm] (primitive/load arms))
                                  sloc (fb-local! fb)
                                  tagl (fb-local! fb)
                                  resl (fb-local! fb)
                                  lend (fnew-label fb)
                                  (mut anylive) false
                                  (mut allterm) true
                                  (mut rty) (TInt 64 true)
                                  (mut i) 0]
                              (femit fb 3 sloc 0 0)  ; SETLOCAL sloc = scrutinee addr
                              (femit fb 2 sloc 0 0)
                              (femit fb 6 4 0 0)
                              (femit fb 3 tagl 0 0)  ; tag = load i32 at sloc
                              (loop (if (primitive/icmp-ge (primitive/load i) narms)
                                        (break)
                                        (do
                                          (let [arm (ial-at [Arm] arms (primitive/load i))
                                                vidx (ivariant-idx cx su (primitive/load (primitive/field arm variant)))
                                                vfields (primitive/load (primitive/field (ial-at [Variant] vs vidx) fields))
                                                lnext (fnew-label fb)
                                                sv (primitive/load (primitive/field fb env))
                                                binds (primitive/load (primitive/field arm binds))
                                                nb (al-len [(slice u8)] (primitive/load binds))
                                                (mut j) 0]
                                            (femit fb 2 tagl 0 0)
                                            (femit fb 1 vidx 0 0)
                                            (femit fb 9 4 0 0)  ; CMP eq -> bool
                                            (femit fb 12 lnext 0 0)  ; JZ lnext (not this variant)
                                            (primitive/store! (primitive/field fb term) false)
                                            ; bind payload fields
                                            (loop (if (primitive/icmp-ge (primitive/load j) nb)
                                                      (break)
                                                      (do
                                                        (let [fty (primitive/load (primitive/field (ial-at [Field] vfields (primitive/load j)) ty))
                                                              foff (primitive/iadd 8 (inatural-off cx vfields (primitive/load j)))
                                                              bl (fb-local! fb)
                                                              ftp (alloc/stack Type)]
                                                          (primitive/store! ftp fty)
                                                          (femit fb 2 sloc 0 0)
                                                          (when (primitive/icmp-ne foff 0) (femit fb 34 foff 0 0))  ; addr = sloc+foff
                                                          (unless (ty-is-agg ftp)
                                                                  ; aggregate: keep the address
                                                                  (femit fb 6 (isize-of cx ftp) (when (signed-of ftp) 1) 0))  ; scalar: load
                                                          (femit fb 3 bl 0 0)
                                                          (primitive/store! (primitive/field fb env)
                                                                  (cs-cons a
                                                                           (al-get [(slice u8)] (primitive/load binds) (primitive/load j))
                                                                           bl
                                                                           fty
                                                                           (primitive/load (primitive/field fb env)))))
                                                        (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                                            (let [bt (compile-expr fb (primitive/field arm body))]
                                              (primitive/store! (primitive/field fb env) sv)
                                              (unless (primitive/load (primitive/field fb term))
                                                      (femit fb 3 resl 0 0)
                                                      ; SETLOCAL resl = body value
                                                      (primitive/store! anylive true)
                                                      (primitive/store! allterm false)
                                                      (primitive/store! rty bt)
                                                      (femit fb 11 lend 0 0))  ; JMP lend
                                              (fbind-label fb lnext)))
                                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                              (femit fb 36 0 0 0)  ; no arm matched -> trap
                              (fbind-label fb lend)
                              (femit fb 2 resl 0 0)  ; push result (dead if allterm)
                              (primitive/store! (primitive/field fb term) (primitive/load allterm))
                              (primitive/load rty)))))
                (ELlvmIr [result args body]
                         (let [n (al-len [Expr] (primitive/load args))
                               (mut i) 0
                               ir0 (alloc/stack IIr)]
                           (primitive/store! (primitive/field ir0 body) body)
                           (primitive/store! (primitive/field ir0 argtys) (al-new [Type] a))
                           (primitive/store! (primitive/field ir0 result) result)
                           ; compile args FIRST (nested llvm-ir may register its own IIrs), then
                           ; register this body and read the index back — capturing it before the
                           ; args would use the nested body's slot instead.
                           (loop (if (primitive/icmp-ge (primitive/load i) n)
                                     (break)
                                     (do
                                       (let [t (compile-expr fb (ial-at [Expr] args (primitive/load i)))]
                                         (al-push! (mut (primitive/field ir0 argtys)) t))
                                       (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                           (let [iri (al-len [IIr] (primitive/load (primitive/field cx irs)))]
                             (al-push! (mut (primitive/field cx irs)) (primitive/load ir0))
                             (femit fb 40 iri n 0))
                           result))
                (EOffsetOf [t fname]
                           (match-else t
                                       (TStruct [nm]
                                                (let [si (istruct-idx cx nm)]
                                                  (when (primitive/icmp-lt si 0) (idie2 "offset-of on non-struct: " nm))
                                                  (femit fb 1 (ifield-off cx si (ifield-idx cx si fname)) 0 0)
                                                  (TInt 64 true)))
                                       (_ (do (idie "offset-of on non-struct type") (TInt 64 true)))))
                (EFnPtrOf [name]
                          (let [fi (find-func cx name)]
                            (if (primitive/icmp-lt fi 0)
                                (do (idie2 "fnptr-of unknown function: " name) (TInt 64 true))
                                (do
                                  (ensure-compiled cx fi)
                                  (femit fb 1 (primitive/iadd (fnptr-base) fi) 0 0)
                                  (func-fn-type cx fi)))))
                (ECallPtr [fp args]
                          (let [ft (alloc/stack Type)]
                            (primitive/store! ft (compile-expr fb fp))  ; push the fnptr value
                            (compile-args fb args)  ; push args
                            (femit fb 42 (al-len [Expr] (primitive/load args)) 0 0)  ; CALLPTR
                            (match-else (primitive/load ft)
                                        (TFn [cc ps r] (primitive/load r))
                                        (_ (do (idie "call-ptr on a non-fnptr value") (TInt 64 true))))))
                (EBitGet [p fname]
                         (let [t (alloc/stack Type)]
                           (primitive/store! t (compile-expr fb p))
                           (let [pt (alloc/stack Type)]
                             (primitive/store! pt (ty-pointee2 t))
                             (match-else (primitive/load pt)
                                         (TStruct [nm]
                                                  (let [low (alloc/stack i64)
                                                        width (alloc/stack i64)
                                                        sg (alloc/stack bool)
                                                        bb (alloc/stack i64)]
                                                    (ibits-info cx nm fname low width sg bb)
                                                    (femit fb
                                                           37
                                                           (primitive/load low)
                                                           (primitive/load width)
                                                           (primitive/ior (when (primitive/load sg) 1) (primitive/ishl (primitive/load bb) 1)))
                                                    (if (primitive/icmp-eq (primitive/load width) 1) (TBool) (TInt (primitive/load width) (primitive/load sg)))))
                                         (_ (do (idie "bit-get through non-struct pointer") (TInt 64 true)))))))
                (EBitSet [p fname val]
                         (let [t (alloc/stack Type)]
                           (primitive/store! t (compile-expr fb p))
                           (let [pt (alloc/stack Type)
                                 vt (alloc/stack Type)]
                             (primitive/store! pt (ty-pointee2 t))
                             (primitive/store! vt (compile-expr fb val))
                             (match-else (primitive/load pt)
                                         (TStruct [nm]
                                                  (let [low (alloc/stack i64)
                                                        width (alloc/stack i64)
                                                        sg (alloc/stack bool)
                                                        bb (alloc/stack i64)]
                                                    (ibits-info cx nm fname low width sg bb)
                                                    (femit fb 38 (primitive/load low) (primitive/load width) (primitive/load bb))
                                                    (primitive/load vt)))
                                         (_ (do (idie "bit-set through non-struct pointer") (TInt 64 true)))))))
                (EMakeDyn [ds vtn methods inner]
                          ; a dyn object { data, vtable } (16 bytes). The vtable is a persistent
                          ; malloc'd array of encoded Coil fnptrs, one per method (built once at
                          ; compile time and baked as an immediate — mirrors codegen's data global).
                          (let [nmeth (al-len [(slice u8)] (primitive/load methods))
                                vt (primitive/cast i64 (interp.malloc (primitive/cast isize (primitive/imul (if (primitive/icmp-le nmeth 1) 1 nmeth) 8))))
                                (mut i) 0
                                l (fb-local! fb)]
                            (loop (if (primitive/icmp-ge (primitive/load i) nmeth)
                                      (break)
                                      (do
                                        (let [mnm (al-get [(slice u8)] (primitive/load methods) (primitive/load i))
                                              mfi (find-func cx mnm)]
                                          (when (primitive/icmp-lt mfi 0) (idie2 "make-dyn: unknown method " mnm))
                                          (ensure-compiled cx mfi)
                                          (primitive/store! (primitive/cast (ptr i64) (primitive/iadd vt (primitive/imul (primitive/load i) 8))) (primitive/iadd (fnptr-base) mfi)))
                                        (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                            (femit fb 31 16 8 0)
                            (femit fb 3 l 0 0)  ; ALLOCZ 16 -> local l
                            (femit fb 2 l 0 0)
                            (compile-expr fb inner)
                            (femit fb 7 8 0 0)
                            (femit fb 4 0 0 0)  ; l[0] = data
                            (femit fb 2 l 0 0)
                            (femit fb 34 8 0 0)
                            (femit fb 1 vt 0 0)
                            (femit fb 7 8 0 0)
                            (femit fb 4 0 0 0)  ; l[8] = vtable
                            (femit fb 2 l 0 0)  ; push the dyn object
                            (TStruct ds)))
                (EDynDispatch [ds vtn mi cc params ret recv args]
                              (let [r (fb-local! fb)]
                                (compile-expr fb recv)
                                (femit fb 3 r 0 0)  ; r = receiver dyn object addr
                                ; fnptr = *( *(r+8) + mi*8 )
                                (femit fb 2 r 0 0)
                                (femit fb 34 8 0 0)
                                (femit fb 6 8 0 0)  ; vtable addr
                                (when (primitive/icmp-ne (primitive/imul mi 8) 0) (femit fb 34 (primitive/imul mi 8) 0 0))
                                (femit fb 6 8 0 0)  ; fnptr (encoded)
                                (femit fb 2 r 0 0)
                                (femit fb 6 8 0 0)  ; data ptr (first arg)
                                (compile-args fb args)
                                (femit fb 42 (primitive/iadd 1 (al-len [Expr] (primitive/load args))) 0 0)  ; CALLPTR
                                ret))
                (EErase [tn inner] (do (idie2 "TODO EErase: " tn) (TInt 64 true)))
                (ETypeQuery [q t] (do (idie "TODO ETypeQuery") (TInt 64 true)))
                (_ (do (idie "unimplemented expression kind reached the interpreter compiler") (TInt 64 true))))))

; compile function `fi` on first reference (self-recursion is guarded by marking
; state=1 BEFORE compiling the body). Only functions reachable from main are ever
; compiled, so unused stdlib functions using not-yet-implemented features never
; force a hard error.
(defn ensure-compiled [(cx (ptr Interp)) (fi i64)] (-> i64)
  (let [bf (ial-at [BFunc] (primitive/field cx bfuncs) fi)]
    (when (primitive/icmp-eq (primitive/load (primitive/field bf state)) 0)
          (primitive/store! (primitive/field bf state) 1)
          (compile-func cx (ial-at [Func] (primitive/load (primitive/field (primitive/load (primitive/field cx mp)) funcs)) fi) fi))))

; compile one mono'd function into cx.bfuncs[fidx] (name/nparams/retty were set
; by pre-registration so calls resolve regardless of compile order).
(defn compile-func [(cx (ptr Interp)) (fd (ptr Func)) (fidx i64)] (-> i64)
  (let [a (primitive/load (primitive/field cx a))
        fb (alloc/stack FB)]
    (primitive/store! (primitive/field fb cx) cx)
    (primitive/store! (primitive/field fb code) (al-new [Instr] a))
    (primitive/store! (primitive/field fb loops) (al-new [CLoop] a))
    (primitive/store! (primitive/field fb labels) (al-new [i64] a))
    (primitive/store! (primitive/field fb nlocals) 0)
    (primitive/store! (primitive/field fb env) (primitive/cast (ptr CScope) 0))
    (primitive/store! (primitive/field fb term) false)
    (let [ps (primitive/load (primitive/field fd params))
          np (al-len [Param] (primitive/load ps))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) np)
                (break)
                (do
                  (let [p (ial-at [Param] ps (primitive/load i))
                        slot (fb-local! fb)]
                    (primitive/store! (primitive/field fb env)
                            (cs-cons a (primitive/load (primitive/field p name)) slot (primitive/load (primitive/field p ty)) (primitive/load (primitive/field fb env)))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (compile-seq fb (primitive/load (primitive/field fd body)))
    (femit fb 15 0 0 0)  ; RET (pops the body's value)
    (resolve-labels fb)
    (let [bf (ial-at [BFunc] (primitive/field cx bfuncs) fidx)]
      (primitive/store! (primitive/field bf nlocals) (primitive/load (primitive/field fb nlocals)))
      (primitive/store! (primitive/field bf code) (box-al [Instr] a (primitive/load (primitive/field fb code)))))
    0))

; ============================ real memory model ==============================
(defn mem-load [(addr i64) (sz i64) (signed bool)] (-> i64)
  (cond (primitive/icmp-eq sz 8) (primitive/load (primitive/cast (ptr i64) addr))
        (primitive/icmp-eq sz 4) (if signed (primitive/cast i64 (primitive/load (primitive/cast (ptr i32) addr))) (primitive/cast i64 (primitive/load (primitive/cast (ptr u32) addr))))
        (primitive/icmp-eq sz 2) (if signed (primitive/cast i64 (primitive/load (primitive/cast (ptr i16) addr))) (primitive/cast i64 (primitive/load (primitive/cast (ptr u16) addr))))
        (primitive/icmp-eq sz 1) (if signed (primitive/cast i64 (primitive/load (primitive/cast (ptr i8) addr))) (primitive/cast i64 (primitive/load (primitive/cast (ptr u8) addr))))
        (do (idie "mem-load: bad size") 0)))
(defn mem-store [(addr i64) (v i64) (sz i64)] (-> i64)
  (cond (primitive/icmp-eq sz 8) (do (primitive/store! (primitive/cast (ptr i64) addr) v) 0)
        (primitive/icmp-eq sz 4) (do (primitive/store! (primitive/cast (ptr i32) addr) (primitive/cast i32 v)) 0)
        (primitive/icmp-eq sz 2) (do (primitive/store! (primitive/cast (ptr i16) addr) (primitive/cast i16 v)) 0)
        (primitive/icmp-eq sz 1) (do (primitive/store! (primitive/cast (ptr i8) addr) (primitive/cast i8 v)) 0)
        (do (idie "mem-store: bad size") 0)))
(defn memzero [(addr i64) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (primitive/store! (primitive/cast (ptr u8) (primitive/iadd addr (primitive/load i))) (primitive/cast u8 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
; copy n bytes dst<-src (word-at-a-time then byte tail). src/dst are real addrs.
(defn memcopy [(dst i64) (src i64) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (primitive/icmp-gt (primitive/iadd (primitive/load i) 8) n)
              (break)
              (do
                (primitive/store! (primitive/cast (ptr i64) (primitive/iadd dst (primitive/load i))) (primitive/load (primitive/cast (ptr i64) (primitive/iadd src (primitive/load i)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 8)))))
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (primitive/store! (primitive/cast (ptr u8) (primitive/iadd dst (primitive/load i))) (primitive/load (primitive/cast (ptr u8) (primitive/iadd src (primitive/load i)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
; bump-allocate `size` bytes (aligned) from the frame buffer; returns a real host
; address. Overflow of the fixed frame buffer is a hard error, never silent.
(defn frame-alloc [(base i64) (offc (ptr i64)) (size i64) (align i64)] (-> i64)
  (let [al (if (primitive/icmp-le align 1) 1 align)
        off (primitive/imul (primitive/idiv (primitive/iadd (primitive/load offc) (primitive/isub al 1)) al) al)
        addr (primitive/iadd base off)]
    (primitive/store! offc (primitive/iadd off size))
    (when (primitive/icmp-gt (primitive/load offc) 1048576) (idie "frame overflow: stack allocation exceeded 1 MiB frame buffer"))
    addr))

; ============================ float bit-casts ================================
(defn bits->f64 [(b i64)] (-> f64)
  (let [p (alloc/stack i64)] (primitive/store! p b) (primitive/load (primitive/cast (ptr f64) p))))
(defn f64->bits [(x f64)] (-> i64)
  (let [p (alloc/stack f64)] (primitive/store! p x) (primitive/load (primitive/cast (ptr i64) p))))
(defn bits->f32 [(b i64)] (-> f32)
  (let [p (alloc/stack i32)] (primitive/store! p (primitive/cast i32 b)) (primitive/load (primitive/cast (ptr f32) p))))
(defn f32->bits [(x f32)] (-> i64)
  (let [p (alloc/stack f32)] (primitive/store! p x) (primitive/cast i64 (primitive/cast u32 (primitive/load (primitive/cast (ptr i32) p))))))

(defn f64-frem-unsupported [] (-> f64)
  (do (idie "float remainder (frem) not implemented in interp yet") (bits->f64 0)))
(defn f32-frem-unsupported [] (-> f32)
  (do (idie "float remainder (frem) not implemented in interp yet") (bits->f32 0)))

; ============================ VM arithmetic =================================
; canonicalize `v` to exact iN width (container invariant: values are sign/zero
; extended from bit N-1). No-op for 64-bit — the common case.
(defn canon-int [(v i64) (bits i64) (signed bool)] (-> i64)
  (if (primitive/icmp-ge bits 64)
      v
      (if signed
          (let [sh (primitive/isub 64 bits)] (primitive/ishr (primitive/ishl v sh) sh))
          (primitive/iand v (primitive/isub (primitive/ishl 1 bits) 1)))))

(defn ult [(a i64) (b i64)] (-> bool)
  (primitive/icmp-lt (primitive/ixor a (primitive/ishl 1 63)) (primitive/ixor b (primitive/ishl 1 63))))
(defn ule [(a i64) (b i64)] (-> bool)
  (primitive/icmp-le (primitive/ixor a (primitive/ishl 1 63)) (primitive/ixor b (primitive/ishl 1 63))))
(defn ugt [(a i64) (b i64)] (-> bool)
  (primitive/icmp-gt (primitive/ixor a (primitive/ishl 1 63)) (primitive/ixor b (primitive/ishl 1 63))))
(defn uge [(a i64) (b i64)] (-> bool)
  (primitive/icmp-ge (primitive/ixor a (primitive/ishl 1 63)) (primitive/ixor b (primitive/ishl 1 63))))
(defn b01 [(x bool)] (-> i64)
  (when x 1))

(defn do-bin [(op i64) (mode i64) (c i64) (l i64) (r i64)] (-> i64)
  (if (primitive/icmp-eq mode 0)
      (let [signed (primitive/icmp-ne (primitive/iand c 1) 0)
            bits (primitive/ishr c 1)
            v
              (cond (primitive/icmp-eq op 0) (primitive/iadd l r)
                    (primitive/icmp-eq op 1) (primitive/isub l r)
                    (primitive/icmp-eq op 2) (primitive/imul l r)
                    (primitive/icmp-eq op 3) (if signed (primitive/idiv l r) (primitive/udiv l r))
                    (primitive/icmp-eq op 4) (if signed (primitive/irem l r) (primitive/urem l r))
                    (primitive/icmp-eq op 5) (primitive/udiv l r)
                    (primitive/icmp-eq op 6) (primitive/urem l r)
                    (primitive/icmp-eq op 7) (primitive/iand l r)
                    (primitive/icmp-eq op 8) (primitive/ior l r)
                    (primitive/icmp-eq op 9) (primitive/ixor l r)
                    (primitive/icmp-eq op 10) (primitive/ishl l r)
                    (primitive/icmp-eq op 11) (if signed (primitive/ishr l r) (primitive/cast i64 (primitive/ishr (primitive/cast u64 l) (primitive/cast u64 r))))
                    (idie "do-bin: bad integer op"))]
        (canon-int v bits signed))
      (if (primitive/icmp-eq mode 2)
          (let [lf (bits->f64 l)
                rf (bits->f64 r)]
            (f64->bits (cond (primitive/icmp-eq op 0) (primitive/fadd lf rf)
                             (primitive/icmp-eq op 1) (primitive/fsub lf rf)
                             (primitive/icmp-eq op 2) (primitive/fmul lf rf)
                             (primitive/icmp-eq op 3) (primitive/fdiv lf rf)
                             (interp.fmod lf rf))))
          (let [lf (bits->f32 l)
                rf (bits->f32 r)]
            (f32->bits (cond (primitive/icmp-eq op 0) (primitive/fadd lf rf)
                             (primitive/icmp-eq op 1) (primitive/fsub lf rf)
                             (primitive/icmp-eq op 2) (primitive/fmul lf rf)
                             (primitive/icmp-eq op 3) (primitive/fdiv lf rf)
                             (interp.fmodf lf rf)))))))

(defn do-cmp [(op i64) (mode i64) (signed i64) (l i64) (r i64)] (-> i64)
  (if (primitive/icmp-eq mode 0)
      (if (primitive/icmp-ne signed 0)
          (cond (primitive/icmp-eq op 0) (b01 (primitive/icmp-lt l r))
                (primitive/icmp-eq op 1) (b01 (primitive/icmp-le l r))
                (primitive/icmp-eq op 2) (b01 (primitive/icmp-gt l r))
                (primitive/icmp-eq op 3) (b01 (primitive/icmp-ge l r))
                (primitive/icmp-eq op 4) (b01 (primitive/icmp-eq l r))
                (b01 (primitive/icmp-ne l r)))
          (cond (primitive/icmp-eq op 0) (b01 (ult l r))
                (primitive/icmp-eq op 1) (b01 (ule l r))
                (primitive/icmp-eq op 2) (b01 (ugt l r))
                (primitive/icmp-eq op 3) (b01 (uge l r))
                (primitive/icmp-eq op 4) (b01 (primitive/icmp-eq l r))
                (b01 (primitive/icmp-ne l r))))
      (if (primitive/icmp-eq mode 2)
          (let [lf (bits->f64 l)
                rf (bits->f64 r)]
            (cond (primitive/icmp-eq op 0) (b01 (primitive/fcmp-lt lf rf))
                  (primitive/icmp-eq op 1) (b01 (primitive/fcmp-le lf rf))
                  (primitive/icmp-eq op 2) (b01 (primitive/fcmp-gt lf rf))
                  (primitive/icmp-eq op 3) (b01 (primitive/fcmp-ge lf rf))
                  (primitive/icmp-eq op 4) (b01 (primitive/fcmp-eq lf rf))
                  (b01 (primitive/fcmp-ne lf rf))))
          (let [lf (bits->f32 l)
                rf (bits->f32 r)]
            (cond (primitive/icmp-eq op 0) (b01 (primitive/fcmp-lt lf rf))
                  (primitive/icmp-eq op 1) (b01 (primitive/fcmp-le lf rf))
                  (primitive/icmp-eq op 2) (b01 (primitive/fcmp-gt lf rf))
                  (primitive/icmp-eq op 3) (b01 (primitive/fcmp-ge lf rf))
                  (primitive/icmp-eq op 4) (b01 (primitive/fcmp-eq lf rf))
                  (b01 (primitive/fcmp-ne lf rf)))))))

(defn i2f [(v i64) (fbytes i64) (srcsigned i64)] (-> i64)
  (if (primitive/icmp-ne srcsigned 0)
      (if (primitive/icmp-eq fbytes 4) (f32->bits (primitive/cast f32 v)) (f64->bits (primitive/cast f64 v)))
      (if (primitive/icmp-eq fbytes 4) (f32->bits (primitive/cast f32 (primitive/cast u64 v))) (f64->bits (primitive/cast f64 (primitive/cast u64 v))))))
(defn f2i [(v i64) (destbits i64) (destsigned i64) (srcfbytes i64)] (-> i64)
  (let [x (if (primitive/icmp-eq srcfbytes 4) (primitive/cast f64 (bits->f32 v)) (bits->f64 v))]
    (canon-int (primitive/cast i64 x) destbits (primitive/icmp-ne destsigned 0))))
(defn f2f [(v i64) (destbytes i64) (srcbytes i64)] (-> i64)
  (if (primitive/icmp-eq destbytes srcbytes)
      v
      (if (primitive/icmp-eq destbytes 8)
          (f64->bits (primitive/cast f64 (bits->f32 v)))
          (f32->bits (primitive/cast f32 (bits->f64 v))))))

; qsort(base, n, size, cmp): sort in place, invoking the Coil comparator fnptr
; through the VM (C-calls-back-into-Coil). A stable insertion sort — for the
; corpus' distinct keys the final order equals libc qsort's. cmp returns i32
; (<0 / 0 / >0); we sign-extend it. Ascending: swap while prev > cur.
(defn interp-qsort [(cx (ptr Interp)) (base i64) (n i64) (size i64) (cmpfp i64)] (-> i64)
  (let [fi (primitive/isub cmpfp (fnptr-base))
        tmp (primitive/cast i64 (interp.malloc (primitive/cast isize (if (primitive/icmp-lt size 1) 1 size))))
        argbuf (alloc/stack (array i64 2))
        (mut i) 1]
    (when (or (primitive/icmp-lt fi 0) (primitive/icmp-ge fi (al-len [BFunc] (primitive/load (primitive/field cx bfuncs)))))
          (idie "qsort: comparator is not a Coil function pointer"))
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [(mut j) (primitive/load i)]
                  (loop (if (primitive/icmp-le (primitive/load j) 0)
                            (break)
                            (let [pa (primitive/iadd base (primitive/imul (primitive/isub (primitive/load j) 1) size))
                                  pb (primitive/iadd base (primitive/imul (primitive/load j) size))]
                              (primitive/store! (primitive/index (primitive/cast (ptr i64) argbuf) 0) pa)
                              (primitive/store! (primitive/index (primitive/cast (ptr i64) argbuf) 1) pb)
                              (if (primitive/icmp-gt (canon-int (vm-exec cx fi (primitive/cast (ptr i64) argbuf) 2 0) 32 true) 0)
                                  (do
                                    (memcopy tmp pa size)
                                    (memcopy pa pb size)
                                    (memcopy pb tmp size)
                                    (primitive/store! j (primitive/isub (primitive/load j) 1)))
                                  (primitive/store! j 0))))))  ; in order -> stop inner loop
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (interp.free (primitive/cast (ptr i8) tmp))
    0))

; ============================ FFI dispatch ==================================
; Builtin table: dispatch an extern call to the REAL native libc function by its
; C symbol name. This is self-contained (no dlsym) and every entry is a genuine
; native call with the correct signature. An extern not in the table hard-errors
; — never a silent no-op.
(defn extern-call [(cx (ptr Interp)) (ei i64) (buf (ptr i64)) (n i64)] (-> i64)
  (let [nm (last-component2 (primitive/load (primitive/field (ial-at [Extern] (primitive/load (primitive/field cx externs)) ei) name)))]
    (cond (str-eq nm "putchar") (interp.putchar (primitive/load (primitive/index buf 0)))
          (str-eq nm "putc") (interp.putchar (primitive/load (primitive/index buf 0)))
          (str-eq nm "write")
            (primitive/cast i64
                  (interp.write (primitive/cast i32 (primitive/load (primitive/index buf 0)))
                                (primitive/cast (ptr i8) (primitive/load (primitive/index buf 1)))
                                (primitive/cast isize (primitive/load (primitive/index buf 2)))))
          (str-eq nm "puts") (interp.puts (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0))))
          (str-eq nm "exit") (interp.exit (primitive/cast i32 (primitive/load (primitive/index buf 0))))
          (str-eq nm "malloc") (primitive/cast i64 (interp.malloc (primitive/cast isize (primitive/load (primitive/index buf 0)))))
          (str-eq nm "free") (do (interp.free (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0)))) 0)
          (str-eq nm "realloc")
            (primitive/cast i64 (interp.realloc (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0))) (primitive/cast isize (primitive/load (primitive/index buf 1)))))
          (str-eq nm "calloc")
            (primitive/cast i64 (interp.calloc (primitive/cast isize (primitive/load (primitive/index buf 0))) (primitive/cast isize (primitive/load (primitive/index buf 1)))))
          (str-eq nm "memcpy")
            (primitive/cast i64
                  (interp.memcpy (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0)))
                                 (primitive/cast (ptr i8) (primitive/load (primitive/index buf 1)))
                                 (primitive/cast isize (primitive/load (primitive/index buf 2)))))
          (str-eq nm "memmove")
            (primitive/cast i64
                  (interp.memmove (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0)))
                                  (primitive/cast (ptr i8) (primitive/load (primitive/index buf 1)))
                                  (primitive/cast isize (primitive/load (primitive/index buf 2)))))
          (str-eq nm "memset")
            (primitive/cast i64
                  (interp.memset (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0)))
                                 (primitive/load (primitive/index buf 1))
                                 (primitive/cast isize (primitive/load (primitive/index buf 2)))))
          (str-eq nm "memcmp")
            (interp.memcmp (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0)))
                           (primitive/cast (ptr i8) (primitive/load (primitive/index buf 1)))
                           (primitive/cast isize (primitive/load (primitive/index buf 2))))
          (str-eq nm "strlen") (primitive/cast i64 (interp.strlen (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0)))))
          (str-eq nm "strcmp")
            (primitive/cast i64 (interp.strcmp (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0))) (primitive/cast (ptr i8) (primitive/load (primitive/index buf 1)))))
          (str-eq nm "read")
            (primitive/cast i64
                  (interp.read (primitive/cast i32 (primitive/load (primitive/index buf 0)))
                               (primitive/cast (ptr i8) (primitive/load (primitive/index buf 1)))
                               (primitive/cast isize (primitive/load (primitive/index buf 2)))))
          (str-eq nm "abort") (do (interp.abort) 0)
          (str-eq nm "printf")
            (primitive/cast i64
                  (interp.printf (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0)))
                                 (primitive/load (primitive/index buf 1))
                                 (primitive/load (primitive/index buf 2))
                                 (primitive/load (primitive/index buf 3))
                                 (primitive/load (primitive/index buf 4))
                                 (primitive/load (primitive/index buf 5))
                                 (primitive/load (primitive/index buf 6))))
          (str-eq nm "dprintf")
            (primitive/cast i64
                  (interp.dprintf (primitive/cast i32 (primitive/load (primitive/index buf 0)))
                                  (primitive/cast (ptr i8) (primitive/load (primitive/index buf 1)))
                                  (primitive/load (primitive/index buf 2))
                                  (primitive/load (primitive/index buf 3))
                                  (primitive/load (primitive/index buf 4))
                                  (primitive/load (primitive/index buf 5))
                                  (primitive/load (primitive/index buf 6))
                                  (primitive/load (primitive/index buf 7))))
          (str-eq nm "snprintf")
            (primitive/cast i64
                  (interp.snprintf (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0)))
                                   (primitive/load (primitive/index buf 1))
                                   (primitive/cast (ptr i8) (primitive/load (primitive/index buf 2)))
                                   (primitive/load (primitive/index buf 3))
                                   (primitive/load (primitive/index buf 4))
                                   (primitive/load (primitive/index buf 5))
                                   (primitive/load (primitive/index buf 6))
                                   (primitive/load (primitive/index buf 7))
                                   (primitive/load (primitive/index buf 8))))
          ; div_t div(int,int): {quot@0, rem@4}, returned in x0 (quot low, rem high).
          ; Computed directly (avoids a struct-return extern declaration); the caller
          ; boxes this packed word into a div_t slot (opcode 43).
          (str-eq nm "div")
            (let [x (primitive/load (primitive/index buf 0))
                  y (primitive/load (primitive/index buf 1))]
              (primitive/ior (primitive/iand (primitive/idiv x y) 4294967295) (primitive/ishl (primitive/irem x y) 32)))
          (str-eq nm "qsort")
            (interp-qsort cx (primitive/load (primitive/index buf 0)) (primitive/load (primitive/index buf 1)) (primitive/load (primitive/index buf 2)) (primitive/load (primitive/index buf 3)))
          ; pthread_create(handle, attr, start, arg): run the Coil start routine
          ; SYNCHRONOUSLY (the interpreter is single-threaded; sequential execution of
          ; the workers' atomic ops yields the same race-free final state as genuine
          ; concurrency for the corpus' contention-free dogfoods). *handle gets a
          ; nonzero id so join has something; the routine's return is discarded.
          (str-eq nm "pthread_create")
            (let [fi (primitive/isub (primitive/load (primitive/index buf 2)) (fnptr-base))
                  wargs (alloc/stack (array i64 1))]
              (when (or (primitive/icmp-lt fi 0) (primitive/icmp-ge fi (al-len [BFunc] (primitive/load (primitive/field cx bfuncs)))))
                    (idie "pthread_create: start routine is not a Coil function pointer"))
              (primitive/store! (primitive/index (primitive/cast (ptr i64) wargs) 0) (primitive/load (primitive/index buf 3)))
              (vm-exec cx fi (primitive/cast (ptr i64) wargs) 1 0)
              (mem-store (primitive/load (primitive/index buf 0)) 1 8)
              0)
          (str-eq nm "pthread_join") 0
          (str-eq nm "sqrt") (f64->bits (interp.sqrt (bits->f64 (primitive/load (primitive/index buf 0)))))
          (str-eq nm "pow") (f64->bits (interp.pow (bits->f64 (primitive/load (primitive/index buf 0))) (bits->f64 (primitive/load (primitive/index buf 1)))))
          (str-eq nm "fabs") (f64->bits (interp.fabs (bits->f64 (primitive/load (primitive/index buf 0)))))
          (str-eq nm "floor") (f64->bits (interp.floor (bits->f64 (primitive/load (primitive/index buf 0)))))
          (str-eq nm "ceil") (f64->bits (interp.ceil (bits->f64 (primitive/load (primitive/index buf 0)))))
          (str-eq nm "strtol")
            (interp.strtol (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0)))
                           (primitive/cast (ptr (ptr i8)) (primitive/load (primitive/index buf 1)))
                           (primitive/cast i32 (primitive/load (primitive/index buf 2))))
          (str-eq nm "atoi") (primitive/cast i64 (interp.atoi (primitive/cast (ptr i8) (primitive/load (primitive/index buf 0)))))
          ; not a libc builtin: if a meta extern hook is registered (meta execution), let
          ; it dispatch (e.g. the metashim mh_* callbacks into the compiler). Otherwise a
          ; genuinely unsupported extern is a hard error, as before.
          (let [hk (interp-extern-hook)]
            (if (primitive/icmp-ne (primitive/load (primitive/field hk isset)) 0)
                (primitive/call-ptr (primitive/load (primitive/field hk fp)) (slice-data nm) (slice-len nm) buf n)
                (do (idie2 "unsupported extern (add it to the interp builtin table): " nm) 0))))))

; ============================ inline LLVM-IR interpreter ====================
; The corpus' (primitive/llvm-ir …) bodies are straight-line SSA (slice / atomic / simd /
; mmio helpers). We INTERPRET them at runtime against the VM's real memory,
; mirroring codegen_a64's structural lowering exactly (same offsets, same lane
; math). Anything outside the implemented subset HARD-ERRORS with the line.
(defn istr->i64 [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        neg (and (primitive/icmp-gt n 0) (primitive/icmp-eq (primitive/cast i64 (slice-get s 0)) 45))
        (mut i) (when neg 1)
        (mut v) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [c (primitive/cast i64 (slice-get s (primitive/load i)))]
                  (if (or (primitive/icmp-lt c 48) (primitive/icmp-gt c 57))
                      (idie2 "not an integer token: " s)
                      (primitive/store! v (primitive/iadd (primitive/imul (primitive/load v) 10) (primitive/isub c 48)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if neg (primitive/isub 0 (primitive/load v)) (primitive/load v))))

; tokenizer: split on whitespace and commas; '{','}','<','>','(',')' self-delimit.
(defn ir-tokens2 [(a (ptr Allocator)) (line (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut toks) (al-new [(slice u8)] a)
        n (slice-len line)
        (mut i) 0
        (mut start) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (do (when (primitive/icmp-ge (primitive/load start) 0) (al-push! (mut toks) (subslice line (primitive/load start) n))) (break))
              (do
                (let [c (primitive/cast i64 (slice-get line (primitive/load i)))]
                  (if (or (or (primitive/icmp-eq c 32) (primitive/icmp-eq c 9)) (primitive/icmp-eq c 44))
                      (do
                        (when (primitive/icmp-ge (primitive/load start) 0) (al-push! (mut toks) (subslice line (primitive/load start) (primitive/load i))))
                        (primitive/store! start -1)
                        0)
                      (if (or (or (or (primitive/icmp-eq c 123) (primitive/icmp-eq c 125)) (or (primitive/icmp-eq c 40) (primitive/icmp-eq c 41)))
                              (or (primitive/icmp-eq c 60) (primitive/icmp-eq c 62)))
                          (do
                            (when (primitive/icmp-ge (primitive/load start) 0) (al-push! (mut toks) (subslice line (primitive/load start) (primitive/load i))))
                            (al-push! (mut toks) (subslice line (primitive/load i) (primitive/iadd (primitive/load i) 1)))
                            (primitive/store! start -1)
                            0)
                          (do (when (primitive/icmp-lt (primitive/load start) 0) (primitive/store! start (primitive/load i))) 0))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [(slice u8)] a (primitive/load toks))))

(defn irtok [(toks (ptr (ArrayList (slice u8)))) (i i64)] (-> (slice u8))
  (al-get [(slice u8)] (primitive/load toks) i))

; parse an IR type token (context: result + arg types); advances *tokp past it.
(defn ir-parse-type2 [(cx (ptr Interp))
                      (result Type)
                      (argtys (ptr (ArrayList Type)))
                      (toks (ptr (ArrayList (slice u8))))
                      (tokp (ptr i64))] (-> Type)
  (let [a (primitive/load (primitive/field cx a))
        tk (irtok toks (primitive/load tokp))]
    (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))
    (cond (str-eq tk "$ret") result
          (str-eq tk "i64") (TInt 64 true)
          (str-eq tk "i32") (TInt 32 true)
          (str-eq tk "i16") (TInt 16 true)
          (str-eq tk "i8") (TInt 8 true)
          (str-eq tk "i1") (TBool)
          (str-eq tk "ptr") (TPtr (box-type a (TInt 8 true)))
          (str-eq tk "float") (TFloat 32)
          (str-eq tk "double") (TFloat 64)
          (str-eq tk "{")
            (let [t0 (ir-parse-type2 cx result argtys toks tokp)
                  t1 (ir-parse-type2 cx result argtys toks tokp)]
              (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))  ; skip }
              (TSlice (box-type a t0)))
          (str-eq tk "<")
            (let [nstr (irtok toks (primitive/load tokp))]
              (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))  ; N
              (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))  ; x
              (let [elem (ir-parse-type2 cx result argtys toks tokp)]
                (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))  ; >
                (TVec (box-type a elem) (istr->i64 nstr))))
          (and (primitive/icmp-ge (slice-len tk) 3)
               (and (primitive/icmp-eq (primitive/cast i64 (slice-get tk 0)) 36)
                    (primitive/icmp-eq (primitive/cast i64 (slice-get tk 1)) 116)))
            (al-get [Type]
                    (primitive/load argtys)
                    (istr->i64 (subslice tk 2 (slice-len tk))))
          :else (do (idie2 "llvm-ir: unsupported type token: " tk) (TInt 64 true)))))

; aggregate element (offset, elem type) for extract/insert.
(defn ir-agg-elem2 [(cx (ptr Interp)) (tp (ptr Type)) (idx i64) (offp (ptr i64))] (-> Type)
  (match-else (primitive/load tp)
              (TSlice [elem] (if (primitive/icmp-eq idx 0) (do (primitive/store! offp 0) (TPtr elem)) (do (primitive/store! offp 8) (TInt 64 true))))
              (TStruct [nm]
                       (let [si (istruct-idx cx nm)]
                         (when (primitive/icmp-lt si 0) (idie2 "llvm-ir: extract from unknown struct " nm) 0)
                         (primitive/store! offp (ifield-off cx si idx))
                         (primitive/load (primitive/field (ial-at [Field]
                                              (primitive/load (primitive/field (struct-at (primitive/field cx layouts) si) fields))
                                              idx)
                                      ty))))
              (_ (do (idie "llvm-ir: extract/insert on unsupported aggregate") (TInt 64 true)))))

; resolve a VALUE token: %name (env), $N (arg), undef/zeroinitializer (fresh slot),
; integer literal. `tp` is the value's type context (for undef/zero slot sizing).
(defn ir-value2 [(cx (ptr Interp))
                 (names (ptr (ArrayList (slice u8))))
                 (vals (ptr (ArrayList i64)))
                 (args (ptr i64))
                 (tk (slice u8))
                 (tp (ptr Type))
                 (fm i64)
                 (moff (ptr i64))] (-> i64)
  (let [c0 (primitive/cast i64 (slice-get tk 0))]
    (cond (primitive/icmp-eq c0 37)  ; %
            (ir-env-get names vals tk)
          (primitive/icmp-eq c0 36)  ; $N  (value arg)
            (primitive/load (primitive/index args (istr->i64 (subslice tk 1 (slice-len tk)))))
          (str-eq tk "undef") (frame-alloc fm moff (isize-of cx tp) (ialign-of cx tp))
          (str-eq tk "zeroinitializer")
            (let [addr (frame-alloc fm moff (isize-of cx tp) (ialign-of cx tp))]
              (do (memzero addr (isize-of cx tp)) addr))
          :else (istr->i64 tk))))
(defn ir-env-get [(names (ptr (ArrayList (slice u8)))) (vals (ptr (ArrayList i64))) (nm (slice u8))] (-> i64)
  (let [n (al-len [(slice u8)] (primitive/load names))
        (mut i) (primitive/isub n 1)
        (mut r) 0]
    (loop (if (primitive/icmp-lt (primitive/load i) 0)
              (break)
              (do
                (when (str-eq (al-get [(slice u8)] (primitive/load names) (primitive/load i)) nm)
                      (primitive/store! r (al-get [i64] (primitive/load vals) (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/isub (primitive/load i) 1)))))
    (primitive/load r)))
(defn ir-env-put! [(names (ptr (ArrayList (slice u8)))) (vals (ptr (ArrayList i64))) (nm (slice u8)) (v i64)] (-> i64)
  (al-push! (mut names) nm)
  (al-push! (mut vals) v)
  0)

; store scalar/aggregate cell `v` of type tp at absolute address `dst`.
(defn ir-store-at [(cx (ptr Interp)) (dst i64) (v i64) (tp (ptr Type))] (-> i64)
  (if (ty-is-agg tp) (memcopy dst v (isize-of cx tp)) (mem-store dst v (isize-of cx tp)))
  0)

; per-lane float binop over vec addresses (op 0 add 1 sub 2 mul). lb = lane bytes.
(defn ir-vec-fbin [(op i64) (dst i64) (asrc i64) (bsrc i64) (lanes i64) (lb i64)] (-> i64)
  (let [(mut k) 0]
    (loop (if (primitive/icmp-ge (primitive/load k) lanes)
              (break)
              (do
                (let [av (mem-load (primitive/iadd asrc (primitive/imul (primitive/load k) lb)) lb false)
                      bv (mem-load (primitive/iadd bsrc (primitive/imul (primitive/load k) lb)) lb false)
                      rv
                        (if (primitive/icmp-eq lb 4)
                            (f32->bits (if (primitive/icmp-eq op 0)
                                           (primitive/fadd (bits->f32 av) (bits->f32 bv))
                                           (if (primitive/icmp-eq op 1)
                                               (primitive/fsub (bits->f32 av) (bits->f32 bv))
                                               (primitive/fmul (bits->f32 av) (bits->f32 bv)))))
                            (f64->bits (if (primitive/icmp-eq op 0)
                                           (primitive/fadd (bits->f64 av) (bits->f64 bv))
                                           (if (primitive/icmp-eq op 1)
                                               (primitive/fsub (bits->f64 av) (bits->f64 bv))
                                               (primitive/fmul (bits->f64 av) (bits->f64 bv))))))]
                  (mem-store (primitive/iadd dst (primitive/imul (primitive/load k) lb)) rv lb))
                (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    0))

; interpret ONE IR line; on `ret` writes *retvalp and sets *donep.
(defn ir-line! [(cx (ptr Interp))
                (names (ptr (ArrayList (slice u8))))
                (vals (ptr (ArrayList i64)))
                (args (ptr i64))
                (argtys (ptr (ArrayList Type)))
                (result Type)
                (retvalp (ptr i64))
                (donep (ptr bool))
                (line (slice u8))
                (fm i64)
                (moff (ptr i64))] (-> i64)
  (let [a (primitive/load (primitive/field cx a))
        toks (ir-tokens2 a line)
        ntk (al-len [(slice u8)] (primitive/load toks))]
    (unless (primitive/icmp-eq ntk 0)
            (let [t0 (irtok toks 0)]
              (cond (str-eq t0 "declare") 0
                    (str-eq t0 "ret")
                      (let [tokp (alloc/stack i64)
                            rtp (alloc/stack Type)]
                        (primitive/store! tokp 1)
                        (primitive/store! rtp (ir-parse-type2 cx result argtys toks tokp))
                        (primitive/store! retvalp (ir-value2 cx names vals args (irtok toks (primitive/load tokp)) rtp fm moff))
                        (primitive/store! donep true)
                        0)
                    (str-eq t0 "store")  ; store atomic TYPE VAL, ptr PTR seq_cst, align N   (sequential model)
                      (if (and (primitive/icmp-ge ntk 7) (str-eq (irtok toks 1) "atomic"))
                          (let [tokp (alloc/stack i64)
                                vtp (alloc/stack Type)]
                            (primitive/store! tokp 2)
                            (primitive/store! vtp (ir-parse-type2 cx result argtys toks tokp))
                            (let [v (ir-value2 cx names vals args (irtok toks (primitive/load tokp)) vtp fm moff)
                                  ptp (alloc/stack Type)]
                              (primitive/store! ptp (TPtr (box-type a (TInt 8 true))))
                              (let [p (ir-value2 cx names vals args (irtok toks (primitive/iadd (primitive/load tokp) 2)) ptp fm moff)]
                                (mem-store p v (isize-of cx vtp))
                                0)))
                          (do (idie2 "llvm-ir: unsupported store line: " line) 0))
                    (and (primitive/icmp-ge ntk 3) (primitive/icmp-eq (primitive/cast i64 (slice-get t0 0)) 37))
                      (let [op (irtok toks 2)]
                        (cond (str-eq op "extractvalue")
                                (let [tokp (alloc/stack i64)
                                      aggtp (alloc/stack Type)]
                                  (primitive/store! tokp 3)
                                  (primitive/store! aggtp (ir-parse-type2 cx result argtys toks tokp))
                                  (let [aggv (ir-value2 cx names vals args (irtok toks (primitive/load tokp)) aggtp fm moff)
                                        idx (istr->i64 (irtok toks (primitive/iadd (primitive/load tokp) 1)))
                                        offp (alloc/stack i64)
                                        etp (alloc/stack Type)]
                                    (primitive/store! etp (ir-agg-elem2 cx aggtp idx offp))
                                    (if (ty-is-agg etp)
                                        (let [ns (frame-alloc fm moff (isize-of cx etp) (ialign-of cx etp))]
                                          (memcopy ns (primitive/iadd aggv (primitive/load offp)) (isize-of cx etp))
                                          (ir-env-put! names vals t0 ns))
                                        (ir-env-put! names
                                                     vals
                                                     t0
                                                     (mem-load (primitive/iadd aggv (primitive/load offp))
                                                               (isize-of cx etp)
                                                               (signed-of etp))))
                                    0))
                              (str-eq op "insertvalue")
                                (let [tokp (alloc/stack i64)
                                      aggtp (alloc/stack Type)]
                                  (primitive/store! tokp 3)
                                  (primitive/store! aggtp (ir-parse-type2 cx result argtys toks tokp))
                                  (let [aggtk (irtok toks (primitive/load tokp))]
                                    (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))
                                    (let [aggv (ir-value2 cx names vals args aggtk aggtp fm moff)
                                          eltp (alloc/stack Type)]
                                      (primitive/store! eltp (ir-parse-type2 cx result argtys toks tokp))
                                      (let [elv (ir-value2 cx names vals args (irtok toks (primitive/load tokp)) eltp fm moff)
                                            idx (istr->i64 (irtok toks (primitive/iadd (primitive/load tokp) 1)))
                                            dslot (frame-alloc fm moff (isize-of cx aggtp) (ialign-of cx aggtp))
                                            offp (alloc/stack i64)]
                                        (memcopy dslot aggv (isize-of cx aggtp))
                                        (ir-agg-elem2 cx aggtp idx offp)
                                        (ir-store-at cx (primitive/iadd dslot (primitive/load offp)) elv eltp)
                                        (ir-env-put! names vals t0 dslot)
                                        0))))
                              (str-eq op "atomicrmw")  ; %old = atomicrmw SUB ptr PTR, TYPE VAL seq_cst
                                (let [sub (irtok toks 3)
                                      ptp (alloc/stack Type)]
                                  (primitive/store! ptp (TPtr (box-type a (TInt 8 true))))
                                  (let [p (ir-value2 cx names vals args (irtok toks 5) ptp fm moff)
                                        tokp (alloc/stack i64)
                                        vtp (alloc/stack Type)]
                                    (primitive/store! tokp 6)
                                    (primitive/store! vtp (ir-parse-type2 cx result argtys toks tokp))
                                    (let [v (ir-value2 cx names vals args (irtok toks (primitive/load tokp)) vtp fm moff)
                                          sz (isize-of cx vtp)
                                          old (mem-load p sz false)]
                                      (cond (str-eq sub "add") (mem-store p (primitive/iadd old v) sz)
                                            (str-eq sub "sub") (mem-store p (primitive/isub old v) sz)
                                            (str-eq sub "xchg") (mem-store p v sz)
                                            :else (idie2 "llvm-ir: unsupported atomicrmw op: " sub))
                                      (ir-env-put! names vals t0 old)
                                      0)))
                              (str-eq op "cmpxchg")  ; %r = cmpxchg ptr PTR, TYPE EXP, TYPE NEW seq_cst seq_cst -> {old,success}
                                (let [ptp (alloc/stack Type)]
                                  (primitive/store! ptp (TPtr (box-type a (TInt 8 true))))
                                  (let [p (ir-value2 cx names vals args (irtok toks 4) ptp fm moff)
                                        tokp (alloc/stack i64)
                                        etp (alloc/stack Type)]
                                    (primitive/store! tokp 5)
                                    (primitive/store! etp (ir-parse-type2 cx result argtys toks tokp))
                                    (let [exp
                                            (ir-value2 cx
                                                       names
                                                       vals
                                                       args
                                                       (irtok toks (primitive/load tokp))
                                                       etp
                                                       fm
                                                       moff)]
                                      (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))
                                      (let [ntp (alloc/stack Type)]
                                        (primitive/store! ntp (ir-parse-type2 cx result argtys toks tokp))
                                        (let [nv
                                                (ir-value2 cx
                                                           names
                                                           vals
                                                           args
                                                           (irtok toks (primitive/load tokp))
                                                           ntp
                                                           fm
                                                           moff)
                                              old (mem-load p 8 false)
                                              ok (primitive/icmp-eq old exp)
                                              slot (frame-alloc fm moff 16 8)]
                                          (when ok (mem-store p nv 8))
                                          (mem-store slot old 8)
                                          (mem-store (primitive/iadd slot 8) (when ok 1) 8)
                                          (ir-env-put! names vals t0 slot)
                                          0)))))
                              (str-eq op "load")  ; %v = load atomic TYPE, ptr PTR seq_cst, align N
                                (if (str-eq (irtok toks 3) "atomic")
                                    (let [tokp (alloc/stack i64)
                                          vtp (alloc/stack Type)]
                                      (primitive/store! tokp 4)
                                      (primitive/store! vtp (ir-parse-type2 cx result argtys toks tokp))
                                      (let [ptp (alloc/stack Type)]
                                        (primitive/store! ptp (TPtr (box-type a (TInt 8 true))))
                                        (let [p
                                                (ir-value2 cx
                                                           names
                                                           vals
                                                           args
                                                           (irtok toks (primitive/iadd (primitive/load tokp) 1))
                                                           ptp
                                                           fm
                                                           moff)]
                                          (ir-env-put! names
                                                       vals
                                                       t0
                                                       (mem-load p (isize-of cx vtp) (signed-of vtp)))
                                          0)))
                                    (do (idie2 "llvm-ir: unsupported load line: " line) 0))
                              (str-eq op "insertelement")  ; %v = insertelement <N x T> AGG, ET EV, i32 K
                                (let [tokp (alloc/stack i64)
                                      vtp (alloc/stack Type)]
                                  (primitive/store! tokp 3)
                                  (primitive/store! vtp (ir-parse-type2 cx result argtys toks tokp))
                                  (let [aggtk (irtok toks (primitive/load tokp))]
                                    (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))
                                    (let [aggv (ir-value2 cx names vals args aggtk vtp fm moff)
                                          etp (alloc/stack Type)]
                                      (primitive/store! etp (ir-parse-type2 cx result argtys toks tokp))
                                      (let [ev
                                              (ir-value2 cx
                                                         names
                                                         vals
                                                         args
                                                         (irtok toks (primitive/load tokp))
                                                         etp
                                                         fm
                                                         moff)
                                            k (istr->i64 (irtok toks (primitive/iadd (primitive/load tokp) 2)))
                                            lb (isize-of cx etp)
                                            dslot
                                              (frame-alloc fm
                                                           moff
                                                           (isize-of cx vtp)
                                                           (ialign-of cx vtp))]
                                        (memcopy dslot aggv (isize-of cx vtp))
                                        (mem-store (primitive/iadd dslot (primitive/imul k lb)) ev lb)
                                        (ir-env-put! names vals t0 dslot)
                                        0))))
                              (str-eq op "shufflevector")  ; splat: %r = shufflevector VTY V, VTY undef, <N x i32> zeroinitializer
                                (let [tokp (alloc/stack i64)
                                      vtp (alloc/stack Type)]
                                  (primitive/store! tokp 3)
                                  (primitive/store! vtp (ir-parse-type2 cx result argtys toks tokp))
                                  (let [v
                                          (ir-value2 cx
                                                     names
                                                     vals
                                                     args
                                                     (irtok toks (primitive/load tokp))
                                                     vtp
                                                     fm
                                                     moff)]
                                    (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))
                                    (ir-parse-type2 cx result argtys toks tokp)  ; 2nd operand type
                                    (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))  ; undef
                                    (ir-parse-type2 cx result argtys toks tokp)  ; mask type
                                    (unless (str-eq (irtok toks (primitive/load tokp)) "zeroinitializer")
                                            (idie2 "llvm-ir: only splat shuffles supported: " line))
                                    (match-else (primitive/load vtp)
                                                (TVec [elem lanes]
                                                      (let [lb (isize-of cx elem)
                                                            dslot
                                                              (frame-alloc fm
                                                                           moff
                                                                           (isize-of cx vtp)
                                                                           (ialign-of cx vtp))
                                                            lane0 (mem-load v lb false)
                                                            (mut k) 0]
                                                        (loop (if (primitive/icmp-ge (primitive/load k) lanes)
                                                                  (break)
                                                                  (do
                                                                    (mem-store (primitive/iadd dslot
                                                                                     (primitive/imul (primitive/load k)
                                                                                           lb))
                                                                               lane0
                                                                               lb)
                                                                    (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                                                        (ir-env-put! names vals t0 dslot)
                                                        0))
                                                (_ (do
                                                     (idie "llvm-ir: shufflevector on non-vector")
                                                     0)))))
                              (or (or (str-eq op "fadd") (str-eq op "fsub"))
                                  (str-eq op "fmul"))
                                (let [tokp (alloc/stack i64)
                                      opn
                                        (unless (str-eq op "fadd") (if (str-eq op "fsub") 1 2))
                                      vtp (alloc/stack Type)]
                                  (primitive/store! tokp 3)
                                  (primitive/store! vtp (ir-parse-type2 cx result argtys toks tokp))
                                  (let [av
                                          (ir-value2 cx
                                                     names
                                                     vals
                                                     args
                                                     (irtok toks (primitive/load tokp))
                                                     vtp
                                                     fm
                                                     moff)
                                        bv
                                          (ir-value2 cx
                                                     names
                                                     vals
                                                     args
                                                     (irtok toks (primitive/iadd (primitive/load tokp) 1))
                                                     vtp
                                                     fm
                                                     moff)]
                                    (match-else (primitive/load vtp)
                                                (TVec [elem lanes]
                                                      (let [lb (isize-of cx elem)
                                                            dslot
                                                              (frame-alloc fm
                                                                           moff
                                                                           (isize-of cx vtp)
                                                                           (ialign-of cx
                                                                                      vtp))]
                                                        (ir-vec-fbin opn
                                                                     dslot
                                                                     av
                                                                     bv
                                                                     lanes
                                                                     lb)
                                                        (ir-env-put! names vals t0 dslot)
                                                        0))
                                                (TFloat [bits]
                                                        (let [rv
                                                                (if (primitive/icmp-eq bits 32)
                                                                    (f32->bits (if (primitive/icmp-eq opn
                                                                                            0)
                                                                                   (primitive/fadd (bits->f32 av)
                                                                                         (bits->f32 bv))
                                                                                   (if (primitive/icmp-eq opn
                                                                                                1)
                                                                                       (primitive/fsub (bits->f32 av)
                                                                                             (bits->f32 bv))
                                                                                       (primitive/fmul (bits->f32 av)
                                                                                             (bits->f32 bv)))))
                                                                    (f64->bits (if (primitive/icmp-eq opn
                                                                                            0)
                                                                                   (primitive/fadd (bits->f64 av)
                                                                                         (bits->f64 bv))
                                                                                   (if (primitive/icmp-eq opn
                                                                                                1)
                                                                                       (primitive/fsub (bits->f64 av)
                                                                                             (bits->f64 bv))
                                                                                       (primitive/fmul (bits->f64 av)
                                                                                             (bits->f64 bv))))))]
                                                          (ir-env-put! names vals t0 rv)
                                                          0))
                                                (_ (do
                                                     (idie "llvm-ir: float op on unsupported type")
                                                     0)))))
                              (str-eq op "call")
                                (ir-call! cx
                                          names
                                          vals
                                          args
                                          argtys
                                          result
                                          toks
                                          t0
                                          line
                                          fm
                                          moff)
                              :else (do (idie2 "llvm-ir: unsupported op: " op) 0)))
                    :else (do (idie2 "llvm-ir: unsupported line: " line) 0))))))

; intrinsic calls: @llvm.fma.v4f32 and @llvm.vector.reduce.fadd.v4f32
(defn ir-call! [(cx (ptr Interp))
                (names (ptr (ArrayList (slice u8))))
                (vals (ptr (ArrayList i64)))
                (args (ptr i64))
                (argtys (ptr (ArrayList Type)))
                (result Type)
                (toks (ptr (ArrayList (slice u8))))
                (t0 (slice u8))
                (line (slice u8))
                (fm i64)
                (moff (ptr i64))] (-> i64)
  (let [a (primitive/load (primitive/field cx a))
        tokp (alloc/stack i64)
        rtp (alloc/stack Type)]
    (primitive/store! tokp 3)
    (primitive/store! rtp (ir-parse-type2 cx result argtys toks tokp))
    (let [callee (irtok toks (primitive/load tokp))]
      (if (str-eq callee "@llvm.fma.v4f32")
          (let [t1 (alloc/stack Type)
                t2 (alloc/stack Type)
                t3 (alloc/stack Type)]
            (primitive/store! tokp (primitive/iadd (primitive/load tokp) 2))  ; skip name + "("
            (primitive/store! t1 (ir-parse-type2 cx result argtys toks tokp))
            (let [av (ir-value2 cx names vals args (irtok toks (primitive/load tokp)) t1 fm moff)]
              (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))
              (primitive/store! t2 (ir-parse-type2 cx result argtys toks tokp))
              (let [bv (ir-value2 cx names vals args (irtok toks (primitive/load tokp)) t2 fm moff)]
                (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))
                (primitive/store! t3 (ir-parse-type2 cx result argtys toks tokp))
                (let [cv (ir-value2 cx names vals args (irtok toks (primitive/load tokp)) t3 fm moff)]
                  (match-else result
                              (TVec [elem lanes]
                                    (let [lb (isize-of cx elem)
                                          dslot
                                            (frame-alloc fm
                                                         moff
                                                         (isize-of cx (box-type a result))
                                                         (ialign-of cx (box-type a result)))
                                          (mut k) 0]
                                      (loop (if (primitive/icmp-ge (primitive/load k) lanes)
                                                (break)
                                                (do
                                                  (let [ai (mem-load (primitive/iadd av (primitive/imul (primitive/load k) lb)) lb false)
                                                        bi (mem-load (primitive/iadd bv (primitive/imul (primitive/load k) lb)) lb false)
                                                        ci (mem-load (primitive/iadd cv (primitive/imul (primitive/load k) lb)) lb false)
                                                        rv
                                                          (if (primitive/icmp-eq lb 4)
                                                              (f32->bits (primitive/fadd (primitive/fmul (bits->f32 ai) (bits->f32 bi))
                                                                               (bits->f32 ci)))
                                                              (f64->bits (primitive/fadd (primitive/fmul (bits->f64 ai) (bits->f64 bi))
                                                                               (bits->f64 ci))))]
                                                    (mem-store (primitive/iadd dslot (primitive/imul (primitive/load k) lb)) rv lb))
                                                  (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                                      (ir-env-put! names vals t0 dslot)
                                      0))
                              (_ (do (idie "llvm-ir: fma on non-vector") 0)))))))
          (if (str-eq callee "@llvm.vector.reduce.fadd.v4f32")
              (let [vtp (alloc/stack Type)]
                (primitive/store! tokp (primitive/iadd (primitive/load tokp) 2))  ; skip name + "("
                (ir-parse-type2 cx result argtys toks tokp)  ; float
                (unless (str-eq (irtok toks (primitive/load tokp)) "0.0") (idie2 "llvm-ir: reduce.fadd start must be 0.0: " line))
                (primitive/store! tokp (primitive/iadd (primitive/load tokp) 1))
                (primitive/store! vtp (ir-parse-type2 cx result argtys toks tokp))
                (let [v (ir-value2 cx names vals args (irtok toks (primitive/load tokp)) vtp fm moff)]
                  (match-else (primitive/load vtp)
                              (TVec [elem lanes]
                                    (let [lb (isize-of cx elem)
                                          (mut k) 0
                                          (mut acc)
                                            (if (primitive/icmp-eq lb 4) (f32->bits (primitive/cast f32 0)) (f64->bits (primitive/cast f64 0)))]
                                      (loop (if (primitive/icmp-ge (primitive/load k) lanes)
                                                (break)
                                                (do
                                                  (let [li (mem-load (primitive/iadd v (primitive/imul (primitive/load k) lb)) lb false)]
                                                    (primitive/store! acc
                                                            (if (primitive/icmp-eq lb 4)
                                                                (f32->bits (primitive/fadd (bits->f32 (primitive/load acc)) (bits->f32 li)))
                                                                (f64->bits (primitive/fadd (bits->f64 (primitive/load acc)) (bits->f64 li))))))
                                                  (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                                      (ir-env-put! names vals t0 (primitive/load acc))
                                      0))
                              (_ (do (idie "llvm-ir: reduce on non-vector") 0)))))
              (do (idie2 "llvm-ir: unsupported intrinsic: " callee) 0))))))

; run a whole IR body; returns the result cell.
(defn ir-run [(cx (ptr Interp)) (irp (ptr IIr)) (args (ptr i64)) (fm i64) (moff (ptr i64))] (-> i64)
  (let [a (primitive/load (primitive/field cx a))
        names (box-al [(slice u8)] a (al-new [(slice u8)] a))
        vals (box-al [i64] a (al-new [i64] a))
        argtys (primitive/field irp argtys)
        result (primitive/load (primitive/field irp result))
        body (primitive/load (primitive/field irp body))
        blen (slice-len body)
        (mut pos) 0
        retvalp (alloc/stack i64)
        donep (alloc/stack bool)]
    (primitive/store! retvalp 0)
    (primitive/store! donep false)
    (loop (if (primitive/icmp-ge (primitive/load pos) blen)
              (break)
              (do
                (let [(mut eol) (primitive/load pos)]
                  (loop (if (or (primitive/icmp-ge (primitive/load eol) blen) (primitive/icmp-eq (primitive/cast i64 (slice-get body (primitive/load eol))) 10))
                            (break)
                            (primitive/store! eol (primitive/iadd (primitive/load eol) 1))))
                  (let [line (subslice body (primitive/load pos) (primitive/load eol))]
                    (primitive/store! pos (primitive/iadd (primitive/load eol) 1))
                    (unless (primitive/icmp-eq (slice-len line) 0)
                            (if (primitive/load donep)
                                (idie2 "llvm-ir: code after ret: " line)
                                (ir-line! cx names vals args argtys result retvalp donep line fm moff)))))
                0)))
    (unless (primitive/load donep) (idie "llvm-ir: body did not ret"))
    (primitive/load retvalp)))

; ============================ the VM ========================================
(defn vpush [(ops (ptr i64)) (spc (ptr i64)) (v i64)] (-> i64)
  (primitive/store! (primitive/index ops (primitive/load spc)) v)
  (primitive/store! spc (primitive/iadd (primitive/load spc) 1))
  0)
(defn vpop [(ops (ptr i64)) (spc (ptr i64))] (-> i64)
  (let [t (primitive/isub (primitive/load spc) 1)] (primitive/store! spc t) (primitive/load (primitive/index ops t))))

; execute compiled function `fidx` with `argc` i64 arguments; return its i64
; result. Recursion uses the host call stack (one vm-exec activation per call).
(defn vm-exec [(cx (ptr Interp)) (fidx i64) (argv (ptr i64)) (argc i64) (retbuf i64)] (-> i64)
  (let [bf (ial-at [BFunc] (primitive/field cx bfuncs) fidx)
        nl (primitive/load (primitive/field bf nlocals))
        nlb (if (primitive/icmp-le nl 1) 1 nl)
        locals (primitive/cast (ptr i64) (interp.malloc (primitive/cast isize (primitive/imul nlb 8))))
        framemem (primitive/cast i64 (interp.malloc 1048576))
        ops (primitive/cast (ptr i64) (interp.malloc 32768))
        spc (alloc/stack i64)
        memoffc (alloc/stack i64)
        code (primitive/load (primitive/field bf code))
        argbuf (alloc/stack (array i64 32))
        retp (alloc/stack Type)
        (mut pc) 0
        (mut halt) false
        (mut retval) 0]
    (primitive/store! retp (primitive/load (primitive/field bf retty)))
    (let [retagg (ty-is-agg retp)
          retsz (when (ty-is-agg retp) (isize-of cx retp))]
      (primitive/store! spc 0)
      (primitive/store! memoffc 0)
      (let [(mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) argc)
                  (break)
                  (do
                    (primitive/store! (primitive/index locals (primitive/load i)) (primitive/load (primitive/index argv (primitive/load i))))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
      (loop
        ; interp-aborting? is false (one field load) unless a metaprogram-level (primitive/error …)
        ; requested an abort; when it fires, every vm-exec frame breaks here and unwinds,
        ; freeing its frame memory below — no pthread_exit, no (loop 0) spin.
        (if (or (primitive/load halt) (interp-aborting?))
            (break)
            (let [ins (ial-at [Instr] code (primitive/load pc))
                  op (primitive/load (primitive/field ins op))
                  a (primitive/load (primitive/field ins a))
                  b (primitive/load (primitive/field ins b))
                  c (primitive/load (primitive/field ins c))]
              (primitive/store! pc (primitive/iadd (primitive/load pc) 1))
              (case op 1
                    (vpush ops spc a) 2
                    (vpush ops spc (primitive/load (primitive/index locals a))) 3
                    (primitive/store! (primitive/index locals a) (vpop ops spc)) 4
                    (do (vpop ops spc) 0) 5
                    (vpush ops spc (frame-alloc framemem memoffc a b)) 6
                    (let [addr (vpop ops spc)] (vpush ops spc (mem-load addr a (primitive/icmp-ne b 0)))) 7
                    (let [v (vpop ops spc)
                          addr (vpop ops spc)]
                      (do (mem-store addr v a) (vpush ops spc 0)))
                      8
                    (let [r (vpop ops spc)
                          l (vpop ops spc)]
                      (vpush ops spc (do-bin a b c l r)))
                      9
                    (let [r (vpop ops spc)
                          l (vpop ops spc)]
                      (vpush ops spc (do-cmp a b c l r)))
                      10
                    (let [v (vpop ops spc)] (vpush ops spc (if (primitive/icmp-ne a 0) (when (primitive/icmp-eq v 0) 1) (primitive/ixor v -1)))) 11
                    (primitive/store! pc a) 12
                    (let [v (vpop ops spc)] (when (primitive/icmp-eq v 0) (primitive/store! pc a))) 13
                    (let [(mut k) (primitive/isub b 1)]
                      (loop (if (primitive/icmp-lt (primitive/load k) 0)
                                (break)
                                (do
                                  (primitive/store! (primitive/index (primitive/cast (ptr i64) argbuf) (primitive/load k)) (vpop ops spc))
                                  (primitive/store! k (primitive/isub (primitive/load k) 1)))))
                      (let [crp (alloc/stack Type)]
                        (primitive/store! crp (primitive/load (primitive/field (ial-at [BFunc] (primitive/field cx bfuncs) a) retty)))
                        (let [rb (when (ty-is-agg crp) (frame-alloc framemem memoffc (isize-of cx crp) 16))]
                          (vpush ops spc (vm-exec cx a (primitive/cast (ptr i64) argbuf) b rb)))))
                      14
                    (let [(mut k) (primitive/isub b 1)]
                      (loop (if (primitive/icmp-lt (primitive/load k) 0)
                                (break)
                                (do
                                  (primitive/store! (primitive/index (primitive/cast (ptr i64) argbuf) (primitive/load k)) (vpop ops spc))
                                  (primitive/store! k (primitive/isub (primitive/load k) 1)))))
                      (vpush ops spc (extern-call cx a (primitive/cast (ptr i64) argbuf) b)))
                      15
                    (let [v (vpop ops spc)]
                      (if retagg (do (memcopy retbuf v retsz) (primitive/store! retval retbuf)) (primitive/store! retval v))
                      (primitive/store! halt true)
                      0)
                      16
                    (let [v (vpop ops spc)] (vpush ops spc (canon-int v a (primitive/icmp-ne b 0)))) 17
                    (let [v (vpop ops spc)] (vpush ops spc (i2f v a b))) 18
                    (let [v (vpop ops spc)] (vpush ops spc (f2i v a b c))) 19
                    (let [v (vpop ops spc)] (vpush ops spc (f2f v a b))) 21
                    (let [src (vpop ops spc)
                          addr (frame-alloc framemem memoffc b (if (primitive/icmp-ne c 0) 16 8))]
                      (do
                        (if (primitive/icmp-ne c 0) (memcopy addr src b) (mem-store addr src b))
                        (primitive/store! (primitive/index locals a) addr)))
                      22
                    (let [addr (vpop ops spc)] (do (interp.free (primitive/cast (ptr i8) addr)) (vpush ops spc 0))) 23
                    (vpush ops spc (primitive/cast i64 (interp.malloc (primitive/cast isize a)))) 24
                    (let [addr (primitive/cast i64 (interp.malloc (primitive/cast isize a)))] (do (memzero addr a) (vpush ops spc addr))) 30
                    (let [addr (frame-alloc framemem memoffc 16 8)]
                      (do (mem-store addr a 8) (mem-store (primitive/iadd addr 8) b 8) (vpush ops spc addr)))
                      31
                    (let [addr (frame-alloc framemem memoffc a b)] (do (memzero addr a) (vpush ops spc addr))) 32
                    (let [src (vpop ops spc)
                          dst (frame-alloc framemem memoffc a b)]
                      (do (memcopy dst src a) (vpush ops spc dst)))  ; LOADAGG (fresh copy)
                      33
                    (let [src (vpop ops spc)
                          dst (vpop ops spc)]
                      (do (memcopy dst src a) (vpush ops spc 0)))  ; STOREAGG
                      34
                    (let [addr (vpop ops spc)] (vpush ops spc (primitive/iadd addr a)))  ; FIELDPTR
                      35
                    (let [idx (vpop ops spc)
                          base (vpop ops spc)]
                      (vpush ops spc (primitive/iadd base (primitive/imul idx a))))  ; INDEX
                      36
                    (do (idie "match: no variant matched (non-exhaustive match reached at runtime)") 0)  ; TRAP
                      37
                    (let [addr (vpop ops spc)
                          low a
                          width b
                          sg (primitive/iand c 1)
                          bb (primitive/ishr c 1)]
                      (let [cont (mem-load addr bb false)
                            v (primitive/cast i64 (primitive/ishr (primitive/cast u64 cont) (primitive/cast u64 low)))]
                        (vpush ops spc (if (primitive/icmp-lt width 64) (canon-int v width (primitive/icmp-ne sg 0)) v))))  ; BITGET
                      38
                    (let [val (vpop ops spc)
                          addr (vpop ops spc)
                          low a
                          width b
                          bb c]
                      (let [fieldmask (if (primitive/icmp-ge width 64) -1 (primitive/isub (primitive/ishl 1 width) 1))
                            cont (mem-load addr bb false)
                            cleared (primitive/iand cont (primitive/ixor (primitive/ishl fieldmask low) -1))
                            merged (primitive/ior cleared (primitive/ishl (primitive/iand val fieldmask) low))]
                        (mem-store addr merged bb)
                        (vpush ops spc val)))  ; BITSET
                      40
                    (let [(mut k) (primitive/isub b 1)]
                      (loop (if (primitive/icmp-lt (primitive/load k) 0)
                                (break)
                                (do
                                  (primitive/store! (primitive/index (primitive/cast (ptr i64) argbuf) (primitive/load k)) (vpop ops spc))
                                  (primitive/store! k (primitive/isub (primitive/load k) 1)))))
                      (vpush ops
                             spc
                             (ir-run cx (ial-at [IIr] (primitive/field cx irs) a) (primitive/cast (ptr i64) argbuf) framemem memoffc)))  ; LLVMIR
                      43
                    (let [val (vpop ops spc)
                          slot (frame-alloc framemem memoffc a b)]
                      (when (primitive/icmp-gt a 8) (idie "extern by-value struct return >8 bytes not supported by interp"))
                      (memzero slot a)
                      (mem-store slot val a)
                      (vpush ops spc slot))  ; box extern agg return
                      42
                    (let [(mut k) (primitive/isub a 1)]
                      (loop (if (primitive/icmp-lt (primitive/load k) 0)
                                (break)
                                (do
                                  (primitive/store! (primitive/index (primitive/cast (ptr i64) argbuf) (primitive/load k)) (vpop ops spc))
                                  (primitive/store! k (primitive/isub (primitive/load k) 1)))))
                      (let [fpv (vpop ops spc)
                            fi (primitive/isub fpv (fnptr-base))]
                        (when (or (primitive/icmp-lt fi 0) (primitive/icmp-ge fi (al-len [BFunc] (primitive/load (primitive/field cx bfuncs)))))
                              (idie "call-ptr: not a Coil function pointer (real C addresses unsupported)")
                              0)
                        (let [crp (alloc/stack Type)]
                          (primitive/store! crp (primitive/load (primitive/field (ial-at [BFunc] (primitive/field cx bfuncs) fi) retty)))
                          (let [rb (when (ty-is-agg crp) (frame-alloc framemem memoffc (isize-of cx crp) 16))]
                            (vpush ops spc (vm-exec cx fi (primitive/cast (ptr i64) argbuf) a rb))))))  ; CALLPTR
                      (do (idie "VM: bad opcode") 0))))))
    (interp.free (primitive/cast (ptr i8) locals))
    (interp.free (primitive/cast (ptr i8) framemem))
    (interp.free (primitive/cast (ptr i8) ops))
    (primitive/load retval)))

; ============================ top-level entry ================================
; The program's argc/argv (set by the driver's `interp` subcommand before the
; pipeline runs), delivered to a `main` that declares parameters. argv points at
; the real OS char** (so argv[i] are genuine C strings).
(defstruct IArgs [(argc i64) (argv i64)])
(defn iargs-box [] (-> (ptr IArgs))
  (alloc/static IArgs))
(defn set-interp-args [(argc i64) (argv i64)] (-> i64)
  (let [b (iargs-box)] (primitive/store! (primitive/field b argc) argc) (primitive/store! (primitive/field b argv) argv) 0))

; ============================ META execution hooks ==========================
; The metaengine can run a metaprogram (or a comptime fold thunk) by INTERPRETING
; its mono'd sub-program in-process — no dylib/JIT/side-module. Two registered hooks
; make that work without interp.coil depending on the metahost:
;   (1) an EXTERN FALLBACK: the metaprogram's metashim wrappers call `mh_*` externs
;       (metashim_wasm), which are not libc — dispatch them to the compiler's real
;       mh_* via a registered callback keyed by the extern's C symbol.
;   (2) an ABORT CHECK: a metaprogram-level `(primitive/error …)` cannot pthread_exit (that would
;       kill the whole in-process pipeline) and must not spin on metalower's (loop 0).
;       mh-halt sets a flag; vm-exec polls this hook and unwinds every frame cleanly.
; Both unset ⇒ the interpreter behaves exactly as `coil interp` (gate-interp green).
(defstruct InterpExternHook [(isset i64) (fp (fnptr c [(ptr u8) i64 (ptr i64) i64] i64))])
(defn interp-extern-hook [] (-> (ptr InterpExternHook))
  (alloc/static InterpExternHook))
(defn set-interp-extern-hook! [(fp (fnptr c [(ptr u8) i64 (ptr i64) i64] i64))] (-> i64)
  (let [b (interp-extern-hook)] (primitive/store! (primitive/field b fp) fp) (primitive/store! (primitive/field b isset) 1) 0))

(defstruct InterpAbortHook [(isset i64) (fp (fnptr c [] i64))])
(defn interp-abort-hook [] (-> (ptr InterpAbortHook))
  (alloc/static InterpAbortHook))
(defn set-interp-abort-check! [(fp (fnptr c [] i64))] (-> i64)
  (let [b (interp-abort-hook)] (primitive/store! (primitive/field b fp) fp) (primitive/store! (primitive/field b isset) 1) 0))
(defn interp-aborting? [] (-> bool)
  (let [b (interp-abort-hook)]
    (if (primitive/icmp-eq (primitive/load (primitive/field b isset)) 0) false (primitive/icmp-ne (primitive/call-ptr (primitive/load (primitive/field b fp))) 0))))

; Build a persistent (heap) interpreter context for a mono'd Program WITHOUT running
; main: same registration as interp-program, so entries can be called repeatedly (one
; per macro invocation). Reachable functions compile lazily on first call.
(defn interp-build [(a (ptr Allocator)) (mp (ptr Program))] (-> (ptr Interp))
  (let [cx (unwrap-ptr [Interp] (create [Interp] a))]
    (primitive/store! (primitive/field cx a) a)
    (primitive/store! (primitive/field cx mp) mp)
    (primitive/store! (primitive/field cx externs) (primitive/load (primitive/field mp externs)))
    (primitive/store! (primitive/field cx bfuncs) (al-new [BFunc] a))
    (primitive/store! (primitive/field cx irs) (al-new [IIr] a))
    (iregister-types! cx mp)
    (let [fs (primitive/load (primitive/field mp funcs))
          n (al-len [Func] (primitive/load fs))
          (mut i) 0
          bf0 (alloc/stack BFunc)]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (let [fd (ial-at [Func] fs (primitive/load i))]
                    (primitive/store! (primitive/field bf0 name) (primitive/load (primitive/field fd name)))
                    (primitive/store! (primitive/field bf0 nparams) (al-len [Param] (primitive/load (primitive/field fd params))))
                    (primitive/store! (primitive/field bf0 nlocals) 0)
                    (primitive/store! (primitive/field bf0 code) (primitive/cast (ptr (ArrayList Instr)) 0))
                    (primitive/store! (primitive/field bf0 retty) (primitive/load (primitive/field fd ret)))
                    (primitive/store! (primitive/field bf0 state) 0)
                    (al-push! (mut (primitive/field cx bfuncs)) (primitive/load bf0)))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    cx))

; Run entry `nm` with `argc` already-boxed argument cells; returns the i64 result cell
; (a metaprogram entry returns a Code/Sexp handle as a pointer-in-a-cell). A missing
; entry is a hard error.
(defn interp-call-entry [(cx (ptr Interp)) (nm (slice u8)) (argv (ptr i64)) (argc i64)] (-> i64)
  (let [fi (find-func cx nm)]
    (if (primitive/icmp-lt fi 0)
        (do (idie2 "interp meta: no such entry function: " nm) 0)
        (do
          (ensure-compiled cx fi)
          (vm-exec cx fi argv argc 0)))))

; Does the context define an entry with this coil function name? (e.g. the comptime
; div-by-zero guard's coil.ct.status is present only when the sub-program had a div/rem.)
(defn interp-has-entry? [(cx (ptr Interp)) (nm (slice u8))] (-> bool)
  (primitive/icmp-ge (find-func cx nm) 0))

; Compile every mono'd function to bytecode, then run `main` and return its i64
; (the process exit code). Registration happens BEFORE compilation so calls
; resolve by name regardless of order.
(defn interp-program [(a (ptr Allocator)) (mp (ptr Program))] (-> i64)
  (let [cx (alloc/stack Interp)]
    (primitive/store! (primitive/field cx a) a)
    (primitive/store! (primitive/field cx mp) mp)
    (primitive/store! (primitive/field cx externs) (primitive/load (primitive/field mp externs)))
    (primitive/store! (primitive/field cx bfuncs) (al-new [BFunc] a))
    (primitive/store! (primitive/field cx irs) (al-new [IIr] a))
    (iregister-types! cx mp)
    ; pre-register: name + nparams + retty for every func (calls need these).
    (let [fs (primitive/load (primitive/field mp funcs))
          n (al-len [Func] (primitive/load fs))
          (mut i) 0
          bf0 (alloc/stack BFunc)]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (let [fd (ial-at [Func] fs (primitive/load i))]
                    (primitive/store! (primitive/field bf0 name) (primitive/load (primitive/field fd name)))
                    (primitive/store! (primitive/field bf0 nparams) (al-len [Param] (primitive/load (primitive/field fd params))))
                    (primitive/store! (primitive/field bf0 nlocals) 0)
                    (primitive/store! (primitive/field bf0 code) (primitive/cast (ptr (ArrayList Instr)) 0))
                    (primitive/store! (primitive/field bf0 retty) (primitive/load (primitive/field fd ret)))
                    (primitive/store! (primitive/field bf0 state) 0)
                    (al-push! (mut (primitive/field cx bfuncs)) (primitive/load bf0)))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    ; lazily compile from main (transitively compiles exactly the reachable set),
    ; then run it. main's i64 return is the process exit code.
    (let [mi (find-func cx "main")]
      (if (primitive/icmp-lt mi 0)
          (do (idie "no `main` function in program") 1)
          (do
            (ensure-compiled cx mi)
            (let [np (primitive/load (primitive/field (ial-at [BFunc] (primitive/field cx bfuncs) mi) nparams))
                  ib (iargs-box)
                  argbuf (alloc/stack (array i64 4))]
              ; a main that takes parameters receives (argc, argv); a nullary main
              ; gets none. argc widens into the first cell, argv (a char**) the second.
              (if (primitive/icmp-ge np 2)
                  (do
                    (primitive/store! (primitive/index (primitive/cast (ptr i64) argbuf) 0) (primitive/load (primitive/field ib argc)))
                    (primitive/store! (primitive/index (primitive/cast (ptr i64) argbuf) 1) (primitive/load (primitive/field ib argv)))
                    (vm-exec cx mi (primitive/cast (ptr i64) argbuf) 2 0))
                  (vm-exec cx mi (primitive/cast (ptr i64) argbuf) 0 0))))))))
