; src/compiler/codegen.coil — self-host Coil compiler, codegen module.
(module codegen)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ffi.coil" :use *)
(import "ast.coil" :use *)
(import "astdump.coil" :use *)
(import "check.coil" :use *)
(import "comptime.coil" :use *)
(import "loader.coil" :use *)
(import "normalize.coil" :use *)
(import "parser.coil" :use *)
(import "resolve.coil" :use *)
(import "layoutdb.coil" :use *)

(defstruct Tv [(val (ptr i8)) (ty Type)])
(defn mk-tv [(v (ptr i8)) (t Type)] (-> Tv)
  (let [p (alloc/stack Tv)] (primitive/store! (primitive/field p val) v) (primitive/store! (primitive/field p ty) t) (primitive/load p)))
(defn tv-val [(t Tv)] (-> (ptr i8))
  (let [p (alloc/stack Tv)] (primitive/store! p t) (primitive/load (primitive/field p val))))
(defn tv-ty [(t Tv)] (-> Type)
  (let [p (alloc/stack Tv)] (primitive/store! p t) (primitive/load (primitive/field p ty))))

; ---- scope: a persistent cons-list (HashMap<String,Tv> with clone+insert = cons,
;      lookup = linear-from-head so a later binding shadows an earlier one).
(defsum Scope
  (SNil [])
  (SBind [(name (slice u8)) (val (ptr i8)) (ty Type) (rest (ptr Scope))]))
(defn scope-nil [(a (ptr Allocator))] (-> (ptr Scope))
  (let [p (unwrap-ptr [Scope] (create [Scope] a))] (primitive/store! p (SNil)) p))
(defn scope-put [(a (ptr Allocator)) (s (ptr Scope)) (name (slice u8)) (v (ptr i8)) (t Type)] (-> (ptr Scope))
  (let [p (unwrap-ptr [Scope] (create [Scope] a))] (primitive/store! p (SBind name v t s)) p))
(defn scope-get [(s (ptr Scope)) (name (slice u8))] (-> (Option Tv))
  (match (primitive/load s)
    (SNil [] (None [Tv]))
    (SBind [n v t rest] (if (str-eq n name) (Some [Tv] (mk-tv v t)) (scope-get rest name)))))

; ---- C-ABI struct-by-value classification (StructAbi/Class + the codegen
;      ArgAbi/CSig). AArch64 AAPCS64 only (the self-host target); the SysV path is
;      a hard-error stub (never reached). StructAbi/CSig are always handled BY
;      POINTER (never threaded by value), Option = a null (ptr …).
(defsum AbiClass
  ; Passed/returned directly in register slots, coerced to these LLVM types.
  (ACDirect [(slots (ptr (ArrayList (ptr i8))))])
  ; Passed indirectly (pointer to a copy / sret). `align` = the struct's ABI align.
  (ACIndirect [(align i32)]))
(defstruct StructAbi
  [(arg AbiClass) (ret AbiClass) (llvm_ty (ptr i8)) (size i64) (align i32)])
(defsum ArgAbiK
  (AAScalar [])
  (AADirect [(sa (ptr StructAbi))])
  (AAIndirect [(sa (ptr StructAbi))]))
(defstruct CSig
  [(sret (ptr StructAbi))  ; null = scalar/direct return
   (ret_direct (ptr StructAbi))  ; null = scalar/sret/void return
   (args (ptr (ArrayList ArgAbiK)))
   (fn_ty (ptr i8))])
(defstruct CSigEntry [(name (slice u8)) (sig (ptr CSig))])
; One scalar leaf of a (possibly nested) struct, for the SysV field-walk
; Leaf): its absolute byte offset, byte size, SysV class (0=None 1=Integer 2=Sse),
; and whether the leaf is a 32-bit float. `AbiLeafBox` wraps the accumulator list so
; it can be threaded by pointer (the established self-host push-through-pointer idiom).
(defstruct AbiLeaf [(offset i64) (size i64) (cls i64) (is_f32 bool)])
(defstruct AbiLeafBox [(items (ArrayList AbiLeaf))])

; ---- Cg: codegen state. Maps are
;      ArrayLists keyed by name (the established self-host pattern; mono uses it).
(defstruct CgStruct [(name (slice u8)) (fields (ptr (ArrayList Field))) (ty (ptr i8)) (layout Layout)])
(defstruct CgSum
  [(name (slice u8)) (variants (ptr (ArrayList Variant))) (ty (ptr i8)) (vstructs (ptr (ArrayList (ptr i8))))])
(defstruct CgFunc [(name (slice u8)) (val (ptr i8))])
(defstruct CgRet [(name (slice u8)) (ty Type)])
(defstruct CgSig [(name (slice u8)) (cc (slice u8)) (params (ptr (ArrayList Type))) (ret Type)])
(defstruct CgBreak [(val (ptr i8)) (bb (ptr i8))])
(defstruct CgLoop
  [(label (Option (slice u8)))
   (body_bb (ptr i8))
   (after_bb (ptr i8))
   (breaks (ArrayList CgBreak))
   (break_ty (Option Type))])
(defstruct CgStatic [(name (slice u8)) (ptr (ptr i8)) (ty Type)])
; A `:shim` convention function's realization: the `ccc` __impl
; function that carries the body, plus the convention's register layout.
(defstruct CgShim
  [(name (slice u8))
   (impl_fn (ptr i8))
   (param_regs (ptr (ArrayList (slice u8))))
   (ret_reg (slice u8))
   (clobber (ptr (ArrayList (slice u8))))])
(defstruct Cg
  [(ctx (ptr i8))
   (module (ptr i8))
   (builder (ptr i8))
   (td (ptr i8))
   (layouts LayoutDb)
   (structs (ArrayList CgStruct))
   (sums (ArrayList CgSum))
   (funcs (ArrayList CgFunc))
   (rets (ArrayList CgRet))
   (sigs (ArrayList CgSig))
   (statics (ArrayList CgStatic))
   (shims (ArrayList CgShim))  ; :shim-convention functions
   (globals i64)
   (llvm_seq i64)
   (loops (ArrayList CgLoop))
   (csigs (ArrayList CSigEntry))  ; only struct-by-value callables
   (arch i64)  ; 0 = x86_64, 1 = aarch64, 2 = wasm32 (from the triple)
   (mach_o bool)  ; Mach-O (Apple) => asm symbols carry a leading `_`
   (a (ptr Allocator))])

; ---- map lookups (linear; names are unique so first/last match is the same) ----
(defn cg-struct-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (struct-index (primitive/field cg layouts) nm))
(defn cg-sum-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (sum-index (primitive/field cg layouts) nm))
(defn cg-func [(cg (ptr Cg)) (nm (slice u8))] (-> (ptr i8))  ; 0 if absent
  (let [n (al-len [CgFunc] (primitive/load (primitive/field cg funcs)))
        (mut i) 0
        (mut r) (primitive/cast (ptr i8) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [fp (al-elem [CgFunc] (primitive/field cg funcs) (primitive/load i))]
                  (when (str-eq (primitive/load (primitive/field fp name)) nm) (primitive/store! r (primitive/load (primitive/field fp val))) 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn cg-ret [(cg (ptr Cg)) (nm (slice u8))] (-> (Option Type))
  (let [n (al-len [CgRet] (primitive/load (primitive/field cg rets)))
        (mut i) 0
        (mut r) (None [Type])]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [fp (al-elem [CgRet] (primitive/field cg rets) (primitive/load i))]
                  (when (str-eq (primitive/load (primitive/field fp name)) nm) (primitive/store! r (Some [Type] (primitive/load (primitive/field fp ty)))) 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn cg-sig-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (let [n (al-len [CgSig] (primitive/load (primitive/field cg sigs)))
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [CgSig] (primitive/field cg sigs) (primitive/load i)) name)) nm) (primitive/store! r (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn cg-static-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (let [n (al-len [CgStatic] (primitive/load (primitive/field cg statics)))
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [CgStatic] (primitive/field cg statics) (primitive/load i)) name)) nm)
                      (primitive/store! r (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

; ---- small FFI conveniences ----
(defn cg-bug [(msg (slice u8))] (-> Tv)
  (unimplemented msg)
  (mk-tv (primitive/cast (ptr i8) 0) (TInt 64 true)))
(defn ty-is-void [(t (ptr Type))] (-> bool)
  (match-else (primitive/load t) (TVoid [] true) (_ false)))
(defn int-width [(ctx (ptr i8)) (bits i64)] (-> (ptr i8))
  (LLVMIntTypeInContext ctx (primitive/cast i32 bits)))
; an ArrayList of opaque handles -> a contiguous C array (ptr (ptr i8)).
(defn carr [(a (ptr Allocator)) (xs (ArrayList (ptr i8)))] (-> (ptr (ptr i8)))
  (let [n (al-len [(ptr i8)] xs)
        buf (primitive/cast (ptr (ptr i8)) (unwrap-ptr [i8] (raw-alloc a (primitive/imul (if (primitive/icmp-eq n 0) 1 n) 8) 8)))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (primitive/store! (primitive/index buf (primitive/load i)) (al-get [(ptr i8)] xs (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    buf))
; LLVMConstInt of `ty` for value 0 (the const_zero of an int/bool type).
(defn cg-zero [(ty (ptr i8))] (-> (ptr i8))
  (LLVMConstInt ty 0 0))

; ---- the slice fat-pointer type { ptr, i64 } (a fresh literal struct; LLVM
;      uniques it so repeated calls return the same type, exactly like the LLVM API).
(defn cg-slice-ty [(cg (ptr Cg))] (-> (ptr i8))
  (let [ctx (primitive/load (primitive/field cg ctx))
        (mut fs) (al-new [(ptr i8)] (primitive/load (primitive/field cg a)))]
    (al-push! (mut fs) (LLVMPointerTypeInContext ctx 0))
    (al-push! (mut fs) (LLVMInt64TypeInContext ctx))
    (LLVMStructTypeInContext ctx (carr (primitive/load (primitive/field cg a)) (primitive/load fs)) 2 0)))

; ---- basic_ty: Coil Type -> LLVM type. void/App/Code are
;      compiler-bug paths (hard error, never a placeholder).
(defn basic-ty [(cg (ptr Cg)) (t (ptr Type))] (-> (ptr i8))
  (let [ctx (primitive/load (primitive/field cg ctx))]
    (match (primitive/load t)
      (TNever [] (LLVMInt64TypeInContext ctx))
      (TInt [bits s] (int-width ctx bits))
      (TFloat [b] (if (primitive/icmp-eq b 32) (LLVMFloatTypeInContext ctx) (LLVMDoubleTypeInContext ctx)))
      (TBool [] (LLVMInt1TypeInContext ctx))
      (TPtr [i] (LLVMPointerTypeInContext ctx 0))
      (TRef [m i] (LLVMPointerTypeInContext ctx 0))
      (TFn [c p r] (LLVMPointerTypeInContext ctx 0))
      (TArray [el n] (LLVMArrayType2 (basic-ty cg el) n))
      (TSlice [el] (cg-slice-ty cg))
      (TStruct [nm] (cg-nominal-ty cg nm))
      (TVec [el n] (LLVMVectorType (basic-ty cg el) (primitive/cast i32 n)))
      ; `externref` is a wasm reference: an addrspace(10) pointer LLVM's wasm backend
      ; lowers to the externref value type. Opaque, scalar, never in linear memory.
      (TExternRef [] (LLVMPointerTypeInContext ctx 10))
      (TVoid [] (do (unimplemented "codegen/basic_ty: void reached as a value type (checker hole)") (primitive/cast (ptr i8) 0)))
      (TApp [n a] (do (unimplemented "codegen/basic_ty: generic type survived monomorphization") (primitive/cast (ptr i8) 0)))
      (TCode [] (do (unimplemented "codegen/basic_ty: comptime-only Code reached codegen") (primitive/cast (ptr i8) 0))))))
(defn cg-nominal-ty [(cg (ptr Cg)) (nm (slice u8))] (-> (ptr i8))
  (let [ctx (primitive/load (primitive/field cg ctx))
        si (cg-struct-idx cg nm)]
    (if (primitive/icmp-ge si 0)
        (let [sp (al-elem [CgStruct] (primitive/field cg structs) si)]
          (match-else (primitive/load (primitive/field sp layout))
                      (LBits [backing offs] (int-width ctx backing))
                      (_ (primitive/load (primitive/field sp ty)))))
        (let [ui (cg-sum-idx cg nm)]
          (if (primitive/icmp-ge ui 0)
              (primitive/load (primitive/field (al-elem [CgSum] (primitive/field cg sums) ui) ty))
              (do (unimplemented "codegen/basic_ty: unknown nominal type") (primitive/cast (ptr i8) 0)))))))

; ---- layout helpers: one shared source for runtime representation.
; align8 also remains a local LLVM ABI utility for padded temporary slots.
(defn align8 [(x i64)] (-> i64)
  (primitive/imul (primitive/udiv (primitive/iadd x 7) 8) 8))
(defn cg-sum-words [(cg (ptr Cg)) (sp (ptr CgSum))] (-> i64)
  (sum-words (primitive/field cg layouts) (primitive/load (primitive/field sp variants))))
(defn cg-sum-words-def [(cg (ptr Cg)) (sd (ptr SumDef))] (-> i64)
  (sum-words (primitive/field cg layouts) (primitive/load (primitive/field sd variants))))
; Keep LLVM authoritative for target-dependent scalar/view types (notably
; wasm32 pointers). Declared struct layouts, and arrays of them, are Coil's
; contract and come from the shared database.
(defn cg-layout-size [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match-else (primitive/load t)
              (TStruct [name]
                       (if (primitive/icmp-ge (struct-index (primitive/field cg layouts) name) 0)
                           (size (primitive/field cg layouts) t)
                           (LLVMABISizeOfType (primitive/load (primitive/field cg td)) (basic-ty cg t))))
              (TArray [elem n] (primitive/imul (cg-layout-size cg elem) n))
              (_ (LLVMABISizeOfType (primitive/load (primitive/field cg td)) (basic-ty cg t)))))
(defn cg-layout-align [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match-else (primitive/load t)
              (TStruct [name]
                       (if (primitive/icmp-ge (struct-index (primitive/field cg layouts) name) 0)
                           (align (primitive/field cg layouts) t)
                           (primitive/cast i64 (LLVMABIAlignmentOfType (primitive/load (primitive/field cg td)) (basic-ty cg t)))))
              (TArray [elem _n] (cg-layout-align cg elem))
              (_ (primitive/cast i64 (LLVMABIAlignmentOfType (primitive/load (primitive/field cg td)) (basic-ty cg t))))))
; ---- offset_of / const_eval (for static-assert) ----
(defn cg-offset-of [(cg (ptr Cg)) (t (ptr Type)) (fname (slice u8))] (-> i64)
  (match-else (primitive/load t)
              (TStruct [nm]
                       (let [si (cg-struct-idx cg nm)]
                         (if (primitive/icmp-lt si 0)
                             (do (unimplemented "codegen/offsetof: non-struct") 0)
                             (let [sp (al-elem [CgStruct] (primitive/field cg structs) si)
                                   idx (field-number (primitive/field cg layouts) si fname)]
                               (match-else (primitive/load (primitive/field sp layout))
                                           (LBits [_ _] 0)
                                           (_ (field-offset (primitive/field cg layouts) si idx)))))))
              (_ (do (unimplemented "codegen/offsetof: needs a struct") 0))))
; const_eval_t -> (value, is_unsigned). Faithful to:3153.
(defstruct CEval [(v i64) (uns bool)])
(defn mk-ceval [(v i64) (u bool)] (-> CEval)
  (let [p (alloc/stack CEval)] (primitive/store! (primitive/field p v) v) (primitive/store! (primitive/field p uns) u) (primitive/load p)))
(defn cev-v [(c CEval)] (-> i64)
  (let [p (alloc/stack CEval)] (primitive/store! p c) (primitive/load (primitive/field p v))))
(defn cev-u [(c CEval)] (-> bool)
  (let [p (alloc/stack CEval)] (primitive/store! p c) (primitive/load (primitive/field p uns))))
; A spanless codegen error (A spanless error is rendered by `report` as a
; bare `error: <msg>` + exit 1). The self-host's codegen paths (const-eval-t → CEval,
; emit-expr → Tv, the extern C-ABI check → i64) have no Result channel, so — exactly
; like the assertion-failed case — print the rendered line and exit(1). The stderr
; text + exit code are byte-identical to the front-end returning the Err. Used for
; static-assert folding, the by-value-view C-ABI rejection, and bitwise-op-on-float.
(defn cg-fail [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "error: ") (ps w msg) (wb w 10) (exit 1) 0))
(defn const-eval-bin [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> CEval)
  (let [uns (or lu ru)]
    (mk-ceval (cond (primitive/icmp-eq op 0) (primitive/iadd l r)
                    (primitive/icmp-eq op 1) (primitive/isub l r)
                    (primitive/icmp-eq op 2) (primitive/imul l r)
                    (primitive/icmp-eq op 7) (primitive/iand l r)
                    (primitive/icmp-eq op 8) (primitive/ior l r)
                    (primitive/icmp-eq op 9) (primitive/ixor l r)
                    (primitive/icmp-eq op 10) (primitive/ishl l r)
                    (primitive/icmp-eq op 11) (if uns (primitive/cast i64 (primitive/ishr (primitive/cast u64 l) (primitive/cast u64 r))) (primitive/ishr l r))
                    (primitive/icmp-eq op 3)
                      (if (primitive/icmp-eq r 0)
                          (do (cg-fail "static-assert: divide/mod by zero") 0)
                          (if uns (primitive/udiv l r) (primitive/idiv l r)))
                    (primitive/icmp-eq op 4)
                      (if (primitive/icmp-eq r 0)
                          (do (cg-fail "static-assert: divide/mod by zero") 0)
                          (if uns (primitive/urem l r) (primitive/irem l r)))
                    (primitive/icmp-eq op 5)
                      (if (primitive/icmp-eq r 0)
                          (do (cg-fail "static-assert: divide/mod by zero") 0)
                          (primitive/udiv l r))
                    (primitive/icmp-eq r 0) (do (cg-fail "static-assert: divide/mod by zero") 0)
                    :else (primitive/urem l r))
              uns)))
(defn const-eval-cmp [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> CEval)
  (let [b
          (cond (or lu ru)
                  (let [lx (primitive/cast u64 l)
                        rx (primitive/cast u64 r)]
                    (cond (primitive/icmp-eq op 0) (primitive/icmp-lt lx rx)
                          (primitive/icmp-eq op 1) (primitive/icmp-le lx rx)
                          (primitive/icmp-eq op 2) (primitive/icmp-gt lx rx)
                          (primitive/icmp-eq op 3) (primitive/icmp-ge lx rx)
                          (primitive/icmp-eq op 4) (primitive/icmp-eq lx rx)
                          :else (primitive/icmp-ne lx rx)))
                (primitive/icmp-eq op 0) (primitive/icmp-lt l r)
                (primitive/icmp-eq op 1) (primitive/icmp-le l r)
                (primitive/icmp-eq op 2) (primitive/icmp-gt l r)
                (primitive/icmp-eq op 3) (primitive/icmp-ge l r)
                (primitive/icmp-eq op 4) (primitive/icmp-eq l r)
                :else (primitive/icmp-ne l r))]
    (mk-ceval (when b 1) false)))
(defn const-eval-t [(cg (ptr Cg)) (e (ptr Expr))] (-> CEval)
  (let [a (primitive/load (primitive/field cg a))]
    (match-else (primitive/load (primitive/field e kind))
                (EInt [v] (mk-ceval v false))
                (EBool [b] (mk-ceval (when b 1) false))
                (EIf [c thn els]
                     (if (primitive/icmp-ne (cev-v (const-eval-t cg c)) 0) (const-eval-t cg thn) (const-eval-t cg els)))
                (ESizeOf [t] (mk-ceval (cg-layout-size cg (box-type a t)) false))
                (EAlignOf [t]
                          (mk-ceval (cg-layout-align cg (box-type a t)) false))
                (EOffsetOf [t fname] (mk-ceval (cg-offset-of cg (box-type a t) fname) false))
                (ECast [t inner]
                       (mk-ceval (cev-v (const-eval-t cg inner)) (match-else t (TInt [bits s] (not s)) (_ false))))
                (EBin [op lhs rhs]
                      (let [lc (const-eval-t cg lhs)
                            rc (const-eval-t cg rhs)]
                        (const-eval-bin op (cev-v lc) (cev-u lc) (cev-v rc) (cev-u rc))))
                (ECmp [op lhs rhs]
                      (let [lc (const-eval-t cg lhs)
                            rc (const-eval-t cg rhs)]
                        (const-eval-cmp op (cev-v lc) (cev-u lc) (cev-v rc) (cev-u rc))))
                (_ (do
                     (cg-fail "static-assert: only int literals, sizeof/alignof/offsetof, casts, arithmetic and comparisons are allowed")
                     (mk-ceval 0 false))))))
(defn const-eval [(cg (ptr Cg)) (e (ptr Expr))] (-> i64)
  (cev-v (const-eval-t cg e)))

; ---- builder conveniences ----
(defn cg-bld [(cg (ptr Cg))] (-> (ptr i8))
  (primitive/load (primitive/field cg builder)))
(defn cg-ctx [(cg (ptr Cg))] (-> (ptr i8))
  (primitive/load (primitive/field cg ctx)))
(defn cg-i64t [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMInt64TypeInContext (cg-ctx cg)))
(defn cg-i32t [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMInt32TypeInContext (cg-ctx cg)))
(defn cg-const-i64 [(cg (ptr Cg)) (n i64)] (-> (ptr i8))
  (LLVMConstInt (cg-i64t cg) n 1))
(defn cg-zero-i64 [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMConstInt (cg-i64t cg) 0 0))
(defn cg-append [(cg (ptr Cg)) (func (ptr i8)) (nm (ptr i8))] (-> (ptr i8))
  (LLVMAppendBasicBlockInContext (cg-ctx cg) func nm))
(defn cg-pos [(cg (ptr Cg)) (bb (ptr i8))] (-> i64)
  (LLVMPositionBuilderAtEnd (cg-bld cg) bb)
  0)
(defn cg-cur-block [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMGetInsertBlock (cg-bld cg)))
(defn cg-cur-func [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMGetBasicBlockParent (cg-cur-block cg)))
; Entry-block alloca: a constant-size alloca is a STATIC (allocate-once) frame
; slot only when it sits in the function's ENTRY block. Emitted inline inside a
; loop it becomes a DYNAMIC per-iteration stack growth — the cause of unbounded
; stack use when compiling large programs (e.g. a by-value-aggregate `al-push!`
; loop). Build compiler-internal temp/spill slots here so each is allocated once
; and reused across iterations. Mirrors.
(defn cg-entry-alloca [(cg (ptr Cg)) (ty (ptr i8)) (name (ptr i8))] (-> (ptr i8))
  (let [b (cg-bld cg)
        cur (LLVMGetInsertBlock b)
        entry (LLVMGetEntryBasicBlock (LLVMGetBasicBlockParent cur))
        first (LLVMGetFirstInstruction entry)]
    (if (primitive/icmp-eq (primitive/cast i64 first) 0)
        (do (LLVMPositionBuilderAtEnd b entry) 0)
        (do (LLVMPositionBuilderBefore b first) 0))
    (let [slot (LLVMBuildAlloca b ty name)]
      (LLVMPositionBuilderAtEnd b cur)
      slot)))
(defn cg-terminated [(cg (ptr Cg))] (-> bool)
  (primitive/icmp-ne (primitive/cast i64 (LLVMGetBasicBlockTerminator (cg-cur-block cg))) 0))
(defn cg-bl [(cg (ptr Cg)) (s (slice u8))] (-> (ptr i8))
  (slice->cstr (primitive/load (primitive/field cg a)) s))
; next global counter value (shared g/str/cstr counter, per).
(defn cg-next-global [(cg (ptr Cg))] (-> i64)
  (let [n (primitive/load (primitive/field cg globals))] (primitive/store! (primitive/field cg globals) (primitive/iadd n 1)) n))
(defn cg-gname [(cg (ptr Cg)) (prefix (slice u8)) (n i64)] (-> (ptr i8))
  (slice->cstr (primitive/load (primitive/field cg a)) (sconcat (primitive/load (primitive/field cg a)) prefix (i64->str (primitive/load (primitive/field cg a)) n))))
; build a function type from Coil params/ret (fn_type_types), possibly variadic.
(defn cg-fn-type-v [(cg (ptr Cg)) (params (ptr (ArrayList Type))) (ret (ptr Type)) (variadic bool)] (-> (ptr i8))
  (let [n (al-len [Type] (primitive/load params))
        (mut tys) (al-new [(ptr i8)] (primitive/load (primitive/field cg a)))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut tys) (basic-ty cg (al-elem [Type] params (primitive/load i)))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (let [rt (if (ty-is-void ret) (LLVMVoidTypeInContext (cg-ctx cg)) (basic-ty cg ret))]
      (LLVMFunctionType rt (carr (primitive/load (primitive/field cg a)) (primitive/load tys)) (primitive/cast i32 n) (when variadic 1)))))
(defn cg-fn-type [(cg (ptr Cg)) (params (ptr (ArrayList Type))) (ret (ptr Type))] (-> (ptr i8))
  (cg-fn-type-v cg params ret false))

; ===== calling conventions +:shim trampolines =====
; A convention name -> its Convention (null if absent) in the codegen Program.
(defn cg-prog-conv [(p (ptr Program)) (name (slice u8))] (-> (ptr Convention))
  (let [cs (primitive/load (primitive/field p conventions))
        n (al-len [Convention] (primitive/load cs))
        (mut i) 0
        (mut r) (primitive/cast (ptr Convention) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (conv-name (al-get [Convention] (primitive/load cs) (primitive/load i))) name)
                      (primitive/store! r (al-elem [Convention] cs (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
; native-cc code (0=c 1=fast 2=cold) -> LLVM CallingConv.h id (stable: c=0 fast=8 cold=9).
(defn native-cc-llvm-id [(code i64)] (-> i64)
  (cond (primitive/icmp-eq code 0) 0
        (primitive/icmp-eq code 1) 8
        (primitive/icmp-eq code 2) 9
        :else (do (unimplemented "codegen: unknown native calling-convention code") 0)))
; LLVM call-conv id for a native convention; -1 for a :shim (no native id).
(defn conv-native-id [(c (ptr Convention))] (-> i64)
  (match (primitive/load (primitive/field c lowering)) (LNative [cc] (native-cc-llvm-id cc)) (LShim [] -1)))

; ---- shim registry ----
(defn cg-add-shim [(cg (ptr Cg))
                   (name (slice u8))
                   (impl-fn (ptr i8))
                   (param-regs (ptr (ArrayList (slice u8))))
                   (ret-reg (slice u8))
                   (clobber (ptr (ArrayList (slice u8))))] (-> i64)
  (let [s (alloc/stack CgShim)]
    (primitive/store! (primitive/field s name) name)
    (primitive/store! (primitive/field s impl_fn) impl-fn)
    (primitive/store! (primitive/field s param_regs) param-regs)
    (primitive/store! (primitive/field s ret_reg) ret-reg)
    (primitive/store! (primitive/field s clobber) clobber)
    (al-push! (mut (primitive/field cg shims)) (primitive/load s))
    0))
(defn cg-shim-find [(cg (ptr Cg)) (name (slice u8))] (-> (ptr CgShim))
  (let [n (al-len [CgShim] (primitive/load (primitive/field cg shims)))
        (mut i) 0
        (mut r) (primitive/cast (ptr CgShim) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [CgShim] (primitive/field cg shims) (primitive/load i)) name)) name)
                      (primitive/store! r (al-elem [CgShim] (primitive/field cg shims) (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

; ---- arch register model ----
; Mach-O (Apple) target? Its inline-asm symbols carry a leading `_`.
(defn triple-mach-o [(triple (slice u8))] (-> bool)
  (or (match (str-find triple "apple") (Some [x0] true) (None [] false))
      (or (match (str-find triple "darwin") (Some [x1] true) (None [] false))
          (match (str-find triple "macosx") (Some [x2] true) (None [] false)))))
; the name to use when referencing a global symbol from inline asm.
(defn cg-asm-sym [(cg (ptr Cg)) (name (slice u8))] (-> (slice u8))
  (if (primitive/load (primitive/field cg mach_o)) (sconcat (primitive/load (primitive/field cg a)) "_" name) name))
; the i-th C-ABI integer/pointer argument register.
(defn cg-c-arg-reg [(cg (ptr Cg)) (i i64)] (-> (slice u8))
  (cond (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 0)
          (cond (primitive/icmp-eq i 0) "rdi"
                (primitive/icmp-eq i 1) "rsi"
                (primitive/icmp-eq i 2) "rdx"
                (primitive/icmp-eq i 3) "rcx"
                (primitive/icmp-eq i 4) "r8"
                (primitive/icmp-eq i 5) "r9"
                :else (do (unimplemented "codegen: too many shim args for the x86_64 C ABI") ""))
        (primitive/icmp-eq i 0) "x0"
        (primitive/icmp-eq i 1) "x1"
        (primitive/icmp-eq i 2) "x2"
        (primitive/icmp-eq i 3) "x3"
        (primitive/icmp-eq i 4) "x4"
        (primitive/icmp-eq i 5) "x5"
        (primitive/icmp-eq i 6) "x6"
        (primitive/icmp-eq i 7) "x7"
        :else (do (unimplemented "codegen: too many shim args for the aarch64 C ABI") "")))
; the C-ABI integer return register.
(defn cg-c-ret-reg [(cg (ptr Cg))] (-> (slice u8))
  (if (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 0) "rax" "x0"))
; is `reg` a general-purpose register on the target arch?
(defn aarch64-xreg? [(reg (slice u8))] (-> bool)
  (let [n (slice-len reg)]
    (if (or (primitive/icmp-lt n 2) (primitive/icmp-ne (primitive/cast i64 (slice-get reg 0)) 120))
        false
        (let [(mut i) 1
              (mut v) 0
              (mut ok) true]
          (loop (if (or (primitive/icmp-ge (primitive/load i) n) (not (primitive/load ok)))
                    (break)
                    (let [c (primitive/cast i64 (slice-get reg (primitive/load i)))]
                      (if (and (primitive/icmp-ge c 48) (primitive/icmp-le c 57))
                          (do (primitive/store! v (primitive/iadd (primitive/imul (primitive/load v) 10) (primitive/isub c 48))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))
                          (do (primitive/store! ok false) 0)))))
          (and (primitive/load ok) (primitive/icmp-le (primitive/load v) 30))))))
(defn x86-gpr? [(r (slice u8))] (-> bool)
  (let [(mut ok) false]
    (when (str-eq r "rax") (primitive/store! ok true) 0)
    (when (str-eq r "rbx") (primitive/store! ok true) 0)
    (when (str-eq r "rcx") (primitive/store! ok true) 0)
    (when (str-eq r "rdx") (primitive/store! ok true) 0)
    (when (str-eq r "rsi") (primitive/store! ok true) 0)
    (when (str-eq r "rdi") (primitive/store! ok true) 0)
    (when (str-eq r "rbp") (primitive/store! ok true) 0)
    (when (str-eq r "rsp") (primitive/store! ok true) 0)
    (when (str-eq r "r8") (primitive/store! ok true) 0)
    (when (str-eq r "r9") (primitive/store! ok true) 0)
    (when (str-eq r "r10") (primitive/store! ok true) 0)
    (when (str-eq r "r11") (primitive/store! ok true) 0)
    (when (str-eq r "r12") (primitive/store! ok true) 0)
    (when (str-eq r "r13") (primitive/store! ok true) 0)
    (when (str-eq r "r14") (primitive/store! ok true) 0)
    (when (str-eq r "r15") (primitive/store! ok true) 0)
    (primitive/load ok)))
(defn aarch64-gpr? [(r (slice u8))] (-> bool)
  (let [(mut ok) (aarch64-xreg? r)]
    (when (str-eq r "sp") (primitive/store! ok true) 0)
    (when (str-eq r "lr") (primitive/store! ok true) 0)
    (when (str-eq r "fp") (primitive/store! ok true) 0)
    (when (str-eq r "xzr") (primitive/store! ok true) 0)
    (primitive/load ok)))
(defn cg-is-valid-gpr [(cg (ptr Cg)) (reg (slice u8))] (-> bool)
  (if (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 0) (x86-gpr? reg) (aarch64-gpr? reg)))
; reject a shim convention naming a register that isn't a GPR on the target arch:
; a spanless `error: <msg>` + exit 1, via cg-fail. The message names the arch.
(defn cg-check-gpr [(cg (ptr Cg)) (reg (slice u8)) (what (slice u8))] (-> i64)
  (unless (cg-is-valid-gpr cg reg)
          (let [a (primitive/load (primitive/field cg a))
                arch (if (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 0) "x86_64" "aarch64")]
            (cg-fail (sconcat3 a
                               (sconcat3 a
                                         (sconcat3 a "codegen: shim convention names " what " register '")
                                         reg
                                         "', which is not a general-purpose register on the target architecture (")
                               arch
                               "). Declare the convention per-arch (see src/examples/per-arch.coil).")))))
(defn cg-check-shim-regs [(cg (ptr Cg)) (shim (ptr CgShim)) (n i64)] (-> i64)
  (let [prs (primitive/load (primitive/field shim param_regs))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (cg-check-gpr cg (al-get [(slice u8)] (primitive/load prs) (primitive/load i)) "parameter") (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (cg-check-gpr cg (primitive/load (primitive/field shim ret_reg)) "return")
  (let [cl (primitive/load (primitive/field shim clobber))
        nc (al-len [(slice u8)] (primitive/load cl))
        (mut j) 0]
    (loop (if (primitive/icmp-ge (primitive/load j) nc)
              (break)
              (do (cg-check-gpr cg (al-get [(slice u8)] (primitive/load cl) (primitive/load j)) "clobber") (primitive/store! j (primitive/iadd (primitive/load j) 1))))))
  0)

; is `name` one of the used registers (a param reg [0..n) or the return reg)?
(defn cg-reg-in-used [(prs (ptr (ArrayList (slice u8)))) (n i64) (ret-reg (slice u8)) (name (slice u8))] (-> bool)
  (if (str-eq name ret-reg)
      true
      (let [(mut i) 0
            (mut r) false]
        (loop (if (or (primitive/icmp-ge (primitive/load i) n) (primitive/load r))
                  (break)
                  (do
                    (when (str-eq (al-get [(slice u8)] (primitive/load prs) (primitive/load i)) name) (primitive/store! r true) 0)
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
        (primitive/load r))))

; ---- trampolines ----
(defn cg-x86-trampoline [(cg (ptr Cg)) (shim (ptr CgShim)) (n i64) (impl-name (slice u8))] (-> (slice u8))
  (let [a (primitive/load (primitive/field cg a))
        (mut sb) (sb-new a)
        prs (primitive/load (primitive/field shim param_regs))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (sb-push-str! (mut sb) "movq %")
                (sb-push-str! (mut sb) (al-get [(slice u8)] (primitive/load prs) (primitive/load i)))
                (sb-push-str! (mut sb) ", %")
                (sb-push-str! (mut sb) (cg-c-arg-reg cg (primitive/load i)))
                (sb-push-str! (mut sb) "\n")
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (sb-push-str! (mut sb) "subq $$8, %rsp\n")
    (sb-push-str! (mut sb) "call ")
    (sb-push-str! (mut sb) impl-name)
    (sb-push-str! (mut sb) "\n")
    (sb-push-str! (mut sb) "addq $$8, %rsp\n")
    (when (not (str-eq (primitive/load (primitive/field shim ret_reg)) (cg-c-ret-reg cg)))
          (sb-push-str! (mut sb) "movq %rax, %")
          (sb-push-str! (mut sb) (primitive/load (primitive/field shim ret_reg)))
          (sb-push-str! (mut sb) "\n")
          0)
    (sb-push-str! (mut sb) "ret\n")
    (sb-str (primitive/load sb))))
(defn cg-aarch64-trampoline [(cg (ptr Cg)) (shim (ptr CgShim)) (n i64) (impl-name (slice u8))] (-> (slice u8))
  (let [a (primitive/load (primitive/field cg a))
        (mut sb) (sb-new a)
        prs (primitive/load (primitive/field shim param_regs))
        (mut i) 0]
    (sb-push-str! (mut sb) "str x30, [sp, #-16]!\n")
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (sb-push-str! (mut sb) "mov ")
                (sb-push-str! (mut sb) (cg-c-arg-reg cg (primitive/load i)))
                (sb-push-str! (mut sb) ", ")
                (sb-push-str! (mut sb) (al-get [(slice u8)] (primitive/load prs) (primitive/load i)))
                (sb-push-str! (mut sb) "\n")
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (sb-push-str! (mut sb) "bl ")
    (sb-push-str! (mut sb) impl-name)
    (sb-push-str! (mut sb) "\n")
    (when (not (str-eq (primitive/load (primitive/field shim ret_reg)) (cg-c-ret-reg cg)))
          (sb-push-str! (mut sb) "mov ")
          (sb-push-str! (mut sb) (primitive/load (primitive/field shim ret_reg)))
          (sb-push-str! (mut sb) ", x0\n")
          0)
    (sb-push-str! (mut sb) "ldr x30, [sp], #16\n")
    (sb-push-str! (mut sb) "ret\n")
    (sb-str (primitive/load sb))))
(defn cg-emit-trampoline [(cg (ptr Cg)) (tramp (ptr i8)) (shim (ptr CgShim)) (n i64)] (-> i64)
  (cg-check-shim-regs cg shim n)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        ctx (cg-ctx cg)
        entry (cg-append cg tramp (cg-bl cg "entry"))
        impl-name (cg-asm-sym cg (sconcat a (primitive/load (primitive/field shim name)) "__impl"))
        asm
          (if (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 0)
              (cg-x86-trampoline cg shim n impl-name)
              (cg-aarch64-trampoline cg shim n impl-name))
        mem "~{memory}"
        void-ty (LLVMFunctionType (LLVMVoidTypeInContext ctx) (carr a (al-new [(ptr i8)] a)) 0 0)]
    (cg-pos cg entry)
    (let [asm-ptr
            (LLVMGetInlineAsm void-ty
                              (primitive/cast (ptr i8) (slice-data [u8] asm))
                              (slice-len asm)
                              (primitive/cast (ptr i8) (slice-data [u8] mem))
                              (slice-len mem)
                              1
                              0
                              0
                              0)]
      (LLVMBuildCall2 b void-ty asm-ptr (carr a (al-new [(ptr i8)] a)) 0 (cg-bl cg ""))
      (LLVMBuildUnreachable b)
      0)))

; ---- register-constrained shim call site ----
(defn cg-shim-constraints [(cg (ptr Cg)) (shim (ptr CgShim)) (n i64)] (-> (slice u8))
  (let [a (primitive/load (primitive/field cg a))
        (mut sb) (sb-new a)
        prs (primitive/load (primitive/field shim param_regs))
        ret-reg (primitive/load (primitive/field shim ret_reg))]
    (sb-push-str! (mut sb) "={")
    (sb-push-str! (mut sb) ret-reg)
    (sb-push-str! (mut sb) "}")
    (let [(mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (sb-push-str! (mut sb) ",{")
                  (sb-push-str! (mut sb) (al-get [(slice u8)] (primitive/load prs) (primitive/load i)))
                  (sb-push-str! (mut sb) "}")
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (let [cl (primitive/load (primitive/field shim clobber))
          nc (al-len [(slice u8)] (primitive/load cl))
          (mut j) 0]
      (loop (if (primitive/icmp-ge (primitive/load j) nc)
                (break)
                (do
                  (let [c (al-get [(slice u8)] (primitive/load cl) (primitive/load j))]
                    (when (not (cg-reg-in-used prs n ret-reg c))
                          (sb-push-str! (mut sb) ",~{")
                          (sb-push-str! (mut sb) c)
                          (sb-push-str! (mut sb) "}")
                          0))
                  (primitive/store! j (primitive/iadd (primitive/load j) 1))))))
    ; the `bl` clobbers the link register on AArch64; spell it `lr` so LLVM forces
    ; the caller to save/restore it.
    (when (and (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 1)
               (and (not (cg-reg-in-used prs n ret-reg "lr")) (not (cg-reg-in-used prs n ret-reg "x30"))))
          (sb-push-str! (mut sb) ",~{lr}")
          0)
    (sb-push-str! (mut sb) ",~{memory}")
    (sb-str (primitive/load sb))))
(defn cg-emit-shim-call [(cg (ptr Cg)) (name (slice u8)) (shim (ptr CgShim)) (argvals (ptr (ArrayList (ptr i8))))] (-> (ptr i8))
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        ctx (cg-ctx cg)
        n (al-len [(ptr i8)] (primitive/load argvals))]
    (cg-check-shim-regs cg shim n)
    (let [cons (cg-shim-constraints cg shim n)
          sym (cg-asm-sym cg name)
          (mut body) (sb-new a)]
      (if (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 0) (sb-push-str! (mut body) "call ") (sb-push-str! (mut body) "bl "))
      (sb-push-str! (mut body) sym)
      (let [bstr (sb-str (primitive/load body))
            (mut tys) (al-new [(ptr i8)] a)
            (mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) n)
                  (break)
                  (do
                    (al-push! (mut tys) (LLVMTypeOf (al-get [(ptr i8)] (primitive/load argvals) (primitive/load i))))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
        (let [fn-ty (LLVMFunctionType (LLVMInt64TypeInContext ctx) (carr a (primitive/load tys)) (primitive/cast i32 n) 0)
              asm-ptr
                (LLVMGetInlineAsm fn-ty
                                  (primitive/cast (ptr i8) (slice-data [u8] bstr))
                                  (slice-len bstr)
                                  (primitive/cast (ptr i8) (slice-data [u8] cons))
                                  (slice-len cons)
                                  1
                                  1
                                  0
                                  0)]
          (LLVMBuildCall2 b fn-ty asm-ptr (carr a (primitive/load argvals)) (primitive/cast i32 n) (cg-bl cg "shimcall")))))))

; ---- variant index in a sum (position of `variant` in its variant list) ----
(defn cg-variant-idx [(cg (ptr Cg)) (sp (ptr CgSum)) (variant (slice u8))] (-> i64)
  (let [vs (primitive/load (primitive/field sp variants))
        n (al-len [Variant] (primitive/load vs))
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [Variant] vs (primitive/load i)) name)) variant) (primitive/store! r (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

; ---- string replace (for emit_llvm_ir placeholder substitution) ----
(defn str-replace-all [(a (ptr Allocator)) (hay (slice u8)) (needle (slice u8)) (rep (slice u8))] (-> (slice u8))
  (let [(mut sb) (sb-new a)
        nl (slice-len needle)
        n (slice-len hay)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (if (and (primitive/icmp-le (primitive/iadd (primitive/load i) nl) n) (str-eq (substr hay (primitive/load i) (primitive/iadd (primitive/load i) nl)) needle))
                  (do (sb-push-str! (mut sb) rep) (primitive/store! i (primitive/iadd (primitive/load i) nl)))
                  (do (sb-push-byte! (mut sb) (slice-get hay (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (sb-str (primitive/load sb))))

; ---- emit a list of arg expressions to their LLVM values ----
(defn emit-vals [(cg (ptr Cg)) (es (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> (ArrayList (ptr i8)))
  (let [n (al-len [Expr] (primitive/load es))
        (mut out) (al-new [(ptr i8)] (primitive/load (primitive/field cg a)))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut out) (tv-val (emit-expr cg (al-elem [Expr] es (primitive/load i)) scp)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load out)))

; ---- reconcile_args: spill a struct/array VALUE passed to a pointer param ----
(defn reconcile-args [(cg (ptr Cg)) (callee (ptr i8)) (vals (ArrayList (ptr i8)))] (-> (ArrayList (ptr i8)))
  (let [a (primitive/load (primitive/field cg a))
        fnty (LLVMGlobalGetValueType callee)
        np (primitive/cast i64 (LLVMCountParamTypes fnty))
        ptbuf (primitive/cast (ptr (ptr i8)) (unwrap-ptr [i8] (raw-alloc a (primitive/imul (if (primitive/icmp-eq np 0) 1 np) 8) 8)))
        n (al-len [(ptr i8)] vals)
        (mut out) (al-new [(ptr i8)] a)
        (mut i) 0]
    (LLVMGetParamTypes fnty ptbuf)
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [v (al-get [(ptr i8)] vals (primitive/load i))
                      (mut av) v]
                  (when (primitive/icmp-lt (primitive/load i) np)
                        (let [pt (primitive/load (primitive/index ptbuf (primitive/load i)))
                              vk (LLVMGetTypeKind (LLVMTypeOf v))]
                          (when (and (primitive/icmp-eq (LLVMGetTypeKind pt) 12) (or (primitive/icmp-eq vk 10) (primitive/icmp-eq vk 11)))
                                (let [slot (cg-entry-alloca cg (LLVMTypeOf v) (cg-bl cg "arg.spill"))]
                                  (LLVMBuildStore (cg-bld cg) v slot)
                                  (primitive/store! av slot)
                                  0))))
                  (al-push! (mut out) (primitive/load av)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load out)))

; ======================== emit_expr =====================
(defn emit-expr [(cg (ptr Cg)) (e (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        ctx (cg-ctx cg)]
    (match (primitive/load (primitive/field e kind))
      (EInt [v] (mk-tv (LLVMConstInt (cg-i64t cg) v 1) (TInt 64 true)))
      (EBool [bv] (mk-tv (LLVMConstInt (LLVMInt1TypeInContext ctx) (when bv 1) 0) (TBool)))
      (EFloat [bits]
              (mk-tv (LLVMConstReal (LLVMDoubleTypeInContext ctx)
                                    (let [p (alloc/stack i64)] (primitive/store! p bits) (primitive/load (primitive/cast (ptr f64) p))))
                     (TFloat 64)))
      ; NUL-terminate the backing constant (last arg = DontNullTerminate = 0).
      ; The slice's length (below) is unchanged; the extra \0 only
      ; makes the pointer safe to hand to C string APIs (snprintf format, etc.).
      (EStr [s]
            (let [bytes (LLVMConstStringInContext ctx (primitive/cast (ptr i8) (slice-data [u8] s)) (primitive/cast i32 (slice-len s)) 0)
                  n (cg-next-global cg)
                  g (LLVMAddGlobal (primitive/load (primitive/field cg module)) (LLVMTypeOf bytes) (cg-gname cg "str." n))]
              (LLVMSetInitializer g bytes)
              (LLVMSetGlobalConstant g 1)
              (LLVMSetLinkage g 9)
              (let [(mut fs) (al-new [(ptr i8)] a)]
                (al-push! (mut fs) g)
                (al-push! (mut fs) (LLVMConstInt (cg-i64t cg) (slice-len s) 0))
                (mk-tv (LLVMConstStructInContext ctx (carr a (primitive/load fs)) 2 0) (TSlice (box-type a (TInt 8 false)))))))
      (ECStr [s]
             (let [bytes (LLVMConstStringInContext ctx (primitive/cast (ptr i8) (slice-data [u8] s)) (primitive/cast i32 (slice-len s)) 0)
                   n (cg-next-global cg)
                   g (LLVMAddGlobal (primitive/load (primitive/field cg module)) (LLVMTypeOf bytes) (cg-gname cg "cstr." n))]
               (LLVMSetInitializer g bytes)
               (LLVMSetGlobalConstant g 1)
               (LLVMSetLinkage g 9)
               (mk-tv g (TPtr (box-type a (TInt 8 true))))))
      (EVar [name]
            (match (scope-get scp name)
              (Some [tv] tv)
              (None [] (cg-bug (sconcat a "codegen: unbound " name)))))
      (EZeroed [t] (mk-tv (LLVMConstNull (basic-ty cg (box-type a t))) t))
      (EBorrow [m place] (emit-expr cg place scp))
      (ESpillRef [inner]
                 (let [tv (emit-expr cg inner scp)
                       t (tv-ty tv)
                       slot (cg-entry-alloca cg (basic-ty cg (box-type a t)) (cg-bl cg "spill"))]
                   (LLVMBuildStore b (tv-val tv) slot)
                   (mk-tv slot (TPtr (box-type a t)))))
      (EBin [op lhs rhs]
            (let [lv (emit-expr cg lhs scp)
                  rv (emit-expr cg rhs scp)
                  lt (tv-ty lv)
                  l (tv-val lv)
                  r (tv-val rv)]
              (if (match-else lt (TFloat [x] true) (_ false))
                  (mk-tv (cond (primitive/icmp-eq op 0) (LLVMBuildFAdd b l r (cg-bl cg "fadd"))
                               (primitive/icmp-eq op 1) (LLVMBuildFSub b l r (cg-bl cg "fsub"))
                               (primitive/icmp-eq op 2) (LLVMBuildFMul b l r (cg-bl cg "fmul"))
                               (primitive/icmp-eq op 3) (LLVMBuildFDiv b l r (cg-bl cg "fdiv"))
                               (primitive/icmp-eq op 4) (LLVMBuildFRem b l r (cg-bl cg "frem"))
                               :else (do (cg-fail "codegen: bitwise op on a float") (primitive/cast (ptr i8) 0)))
                         lt)
                  (let [signed (match-else lt (TInt [bits s] s) (_ false))]
                    (mk-tv (cond (primitive/icmp-eq op 0) (LLVMBuildAdd b l r (cg-bl cg "add"))
                                 (primitive/icmp-eq op 1) (LLVMBuildSub b l r (cg-bl cg "sub"))
                                 (primitive/icmp-eq op 2) (LLVMBuildMul b l r (cg-bl cg "mul"))
                                 (primitive/icmp-eq op 3)
                                   (if signed
                                       (LLVMBuildSDiv b l r (cg-bl cg "div"))
                                       (LLVMBuildUDiv b l r (cg-bl cg "div")))
                                 (primitive/icmp-eq op 4)
                                   (if signed
                                       (LLVMBuildSRem b l r (cg-bl cg "rem"))
                                       (LLVMBuildURem b l r (cg-bl cg "rem")))
                                 (primitive/icmp-eq op 5) (LLVMBuildUDiv b l r (cg-bl cg "udiv"))
                                 (primitive/icmp-eq op 6) (LLVMBuildURem b l r (cg-bl cg "urem"))
                                 (primitive/icmp-eq op 7) (LLVMBuildAnd b l r (cg-bl cg "and"))
                                 (primitive/icmp-eq op 8) (LLVMBuildOr b l r (cg-bl cg "or"))
                                 (primitive/icmp-eq op 9) (LLVMBuildXor b l r (cg-bl cg "xor"))
                                 (primitive/icmp-eq op 10) (LLVMBuildShl b l r (cg-bl cg "shl"))
                                 signed (LLVMBuildAShr b l r (cg-bl cg "shr"))
                                 :else (LLVMBuildLShr b l r (cg-bl cg "shr")))
                           lt)))))
      (ENot [x]
            (let [xv (emit-expr cg x scp)]
              (mk-tv (LLVMBuildNot b (tv-val xv) (cg-bl cg "not")) (tv-ty xv))))
      (ECmp [op lhs rhs]
            (let [lv (emit-expr cg lhs scp)
                  rv (emit-expr cg rhs scp)
                  lt (tv-ty lv)
                  l (tv-val lv)
                  r (tv-val rv)]
              (if (match-else lt (TFloat [x] true) (_ false))
                  (let [pred
                          (cond (primitive/icmp-eq op 0) 4
                                (primitive/icmp-eq op 1) 5
                                (primitive/icmp-eq op 2) 2
                                (primitive/icmp-eq op 3) 3
                                (primitive/icmp-eq op 4) 1
                                :else 6)]
                    (mk-tv (LLVMBuildFCmp b (primitive/cast i32 pred) l r (cg-bl cg "fcmp")) (TBool)))
                  (let [signed (match-else lt (TInt [bits s] s) (_ false))
                        pred
                          (cond (primitive/icmp-eq op 0) (if signed 40 36)
                                (primitive/icmp-eq op 1) (if signed 41 37)
                                (primitive/icmp-eq op 2) (if signed 38 34)
                                (primitive/icmp-eq op 3) (if signed 39 35)
                                (primitive/icmp-eq op 4) 32
                                :else 33)]
                    (mk-tv (LLVMBuildICmp b (primitive/cast i32 pred) l r (cg-bl cg "cmp")) (TBool))))))
      (EDo [body] (emit-body cg body scp))
      (ELet [binds body]
            (let [child (emit-binds cg binds scp)] (emit-body cg body child)))
      (EIf [cnd thn els] (emit-if cg cnd thn els scp))
      (ELoop [label body] (emit-loop cg label body scp))
      (EBreak [label value] (emit-break cg label value scp))
      (EContinue [label] (emit-continue cg label))
      (ECall [func targs args] (emit-call cg func args scp))
      (EAlloc [storage t] (emit-alloc cg storage (box-type a t)))
      (EField [pe fname] (emit-field cg pe fname scp))
      (EBitGet [pe fname] (emit-bitget cg pe fname scp))
      (EBitSet [pe fname val] (emit-bitset cg pe fname val scp))
      (ELoad [inner]
             (let [pv (emit-expr cg inner scp)
                   pointee
                     (match-else (tv-ty pv)
                                 (TPtr [pe] (primitive/load pe))
                                 (_ (do (unimplemented "codegen: load of non-pointer") (TInt 64 true))))]
               (mk-tv (LLVMBuildLoad2 b (basic-ty cg (box-type a pointee)) (tv-val pv) (cg-bl cg "load")) pointee)))
      (EStore [pe val]
              (let [pv (emit-expr cg pe scp)
                    vv (emit-expr cg val scp)]
                ; std-12: store! yields unit (canonical i64 0), matching its checked type.
                (LLVMBuildStore b (tv-val vv) (tv-val pv))
                (mk-tv (cg-zero-i64 cg) (TInt 64 true))))
      (EIndex [pe idx] (emit-index cg pe idx scp))
      (ECast [t inner] (emit-cast cg (box-type a t) inner scp))
      (ESizeOf [t]
               (mk-tv (cg-const-i64 cg (cg-layout-size cg (box-type a t)))
                      (TInt 64 true)))
      (EAlignOf [t]
                (mk-tv (cg-const-i64 cg (cg-layout-align cg (box-type a t)))
                       (TInt 64 true)))
      (EOffsetOf [t fname] (mk-tv (cg-const-i64 cg (cg-offset-of cg (box-type a t) fname)) (TInt 64 true)))
      (EFree [p] (let [pv (emit-expr cg p scp)] (LLVMBuildFree b (tv-val pv)) (mk-tv (cg-zero-i64 cg) (TInt 64 true))))
      (EConstruct [sum variant args] (emit-construct cg sum variant args scp))
      (EMatch [scrut arms] (emit-match cg scrut arms scp))
      (EFnPtrOf [name] (emit-fnptr cg name))
      (ECallPtr [fp args] (emit-callptr cg fp args scp))
      (ELlvmIr [result args body] (emit-llvm-ir cg (box-type a result) args body scp))
      (EStaticRef [name]
                  (let [si (cg-static-idx cg name)]
                    (if (primitive/icmp-lt si 0)
                        (cg-bug (sconcat a "codegen: unknown static const " name))
                        (let [sp (al-elem [CgStatic] (primitive/field cg statics) si)]
                          (mk-tv (primitive/load (primitive/field sp ptr)) (TPtr (box-type a (primitive/load (primitive/field sp ty)))))))))
      (EErase [tn inner] (cg-bug "codegen: unlowered Erase (checker should have made it a MakeDyn)"))
      (ETraitCall [tn m s args] (cg-bug "codegen: unresolved trait call (compiler bug)"))
      (EComptime [inner] (cg-bug "codegen: unresolved comptime node (compiler bug)"))
      (EAscribe [ty inner]
                (cg-bug "codegen: unlowered ascription node — the checker should have replaced (: v t) with its coerced value (compiler bug)"))
      (EQuote [form] (cg-bug "codegen: a Code value has no runtime representation"))
      (ECodeOp [op args] (cg-bug "codegen: a Code value has no runtime representation"))
      (EQuasi [q] (cg-bug "codegen: a Code value has no runtime representation"))
      (ETypeQuery [q t] (cg-bug "codegen: unresolved type-query (compiler bug)"))
      (EFieldMeta [m t idx] (cg-bug "codegen: unresolved field-reflection (compiler bug)"))
      (EFieldIndex [t name] (cg-bug "codegen: unresolved field-reflection (compiler bug)"))
      (EMakeDyn [ds vt methods inner] (emit-make-dyn cg ds vt methods inner scp))
      (EDynDispatch [ds vt mi cc params ret recv args]
                    (emit-dyn-dispatch cg ds vt mi cc params (box-type (primitive/load (primitive/field cg a)) ret) recv args scp)))))

; ExprKind::MakeDyn — erase a concrete (ptr T) to a
; (dyn Trait) fat pointer. Materialise a constant vtable global (the impl methods'
; addresses in trait order) and a caller-frame { data, vtable } struct BY VALUE.
(defn emit-make-dyn [(cg (ptr Cg))
                     (ds (slice u8))
                     (vt (slice u8))
                     (methods (ptr (ArrayList (slice u8))))
                     (inner (ptr Expr))
                     (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        iv (emit-expr cg inner scp)
        data (tv-val iv)
        vsi (cg-struct-idx cg vt)]
    (if (primitive/icmp-lt vsi 0)
        (cg-bug (sconcat a "codegen: unknown vtable struct " vt))
        (let [vty (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) vsi) ty))
              nm (al-len [(slice u8)] (primitive/load methods))
              (mut fields) (al-new [(ptr i8)] a)
              (mut i) 0]
          (loop (if (primitive/icmp-ge (primitive/load i) nm)
                    (break)
                    (do
                      (let [mn (al-get [(slice u8)] (primitive/load methods) (primitive/load i))
                            fv (cg-func cg mn)]
                        (when (primitive/icmp-eq (primitive/cast i64 fv) 0)
                              (unimplemented (sconcat a "codegen: dyn vtable references unknown fn " mn))
                              0)
                        (al-push! (mut fields) fv))
                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
          (let [g (LLVMAddGlobal (primitive/load (primitive/field cg module)) vty (slice->cstr a (sconcat a "vtable." ds)))]
            (LLVMSetInitializer g (LLVMConstNamedStruct vty (carr a (primitive/load fields)) (primitive/cast i32 nm)))
            (LLVMSetGlobalConstant g 1)
            (let [dsi (cg-struct-idx cg ds)]
              (if (primitive/icmp-lt dsi 0)
                  (cg-bug (sconcat a "codegen: unknown dyn struct " ds))
                  (let [dty (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) dsi) ty))
                        slot (cg-entry-alloca cg dty (cg-bl cg "dyn.obj"))
                        dp (LLVMBuildStructGEP2 b dty slot 0 (cg-bl cg "dyn.data"))]
                    (LLVMBuildStore b data dp)
                    (let [vp (LLVMBuildStructGEP2 b dty slot 1 (cg-bl cg "dyn.vt"))]
                      (LLVMBuildStore b g vp)
                      (mk-tv (LLVMBuildLoad2 b dty slot (cg-bl cg "dyn.val")) (TStruct ds)))))))))))

; ExprKind::DynDispatch — call a trait method through the
; fat pointer's vtable: spill the receiver, load data + vtable, load the method's
; fnptr from vtable slot `mi`, then indirect-call (data, args…).
(defn emit-dyn-dispatch [(cg (ptr Cg))
                         (ds (slice u8))
                         (vt (slice u8))
                         (mi i64)
                         (cc (slice u8))
                         (params (ptr (ArrayList Type)))
                         (ret (ptr Type))
                         (recv (ptr Expr))
                         (args (ptr (ArrayList Expr)))
                         (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        pty (LLVMPointerTypeInContext (cg-ctx cg) 0)
        rv (emit-expr cg recv scp)
        dsi (cg-struct-idx cg ds)]
    (if (primitive/icmp-lt dsi 0)
        (cg-bug (sconcat a "codegen: unknown dyn struct " ds))
        (let [dty (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) dsi) ty))
              slot (cg-entry-alloca cg dty (cg-bl cg "dyn.recv"))]
          (LLVMBuildStore b (tv-val rv) slot)
          (let [dp (LLVMBuildStructGEP2 b dty slot 0 (cg-bl cg "dyn.data"))
                data (LLVMBuildLoad2 b pty dp (cg-bl cg "data"))
                vp (LLVMBuildStructGEP2 b dty slot 1 (cg-bl cg "dyn.vt"))
                vtab (LLVMBuildLoad2 b pty vp (cg-bl cg "vt"))
                vsi (cg-struct-idx cg vt)]
            (if (primitive/icmp-lt vsi 0)
                (cg-bug (sconcat a "codegen: unknown vtable struct " vt))
                (let [vty (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) vsi) ty))
                      mp (LLVMBuildStructGEP2 b vty vtab (primitive/cast i32 mi) (cg-bl cg "vt.m"))
                      fnptr (LLVMBuildLoad2 b pty mp (cg-bl cg "fn"))
                      fnty (cg-fn-type cg params ret)
                      (mut meta) (al-new [(ptr i8)] a)]
                  (al-push! (mut meta) data)
                  (let [n (al-len [Expr] (primitive/load args))
                        (mut i) 0]
                    (loop (if (primitive/icmp-ge (primitive/load i) n)
                              (break)
                              (do
                                (let [av (emit-expr cg (al-elem [Expr] args (primitive/load i)) scp)]
                                  (al-push! (mut meta) (tv-val av)))
                                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
                  (let [cs
                          (LLVMBuildCall2 b
                                          fnty
                                          fnptr
                                          (carr a (primitive/load meta))
                                          (primitive/cast i32 (al-len [(ptr i8)] (primitive/load meta)))
                                          (cg-bl cg "dyn.call"))
                        id (native-cc-parse cc)]
                    (when (primitive/icmp-ge id 0) (LLVMSetInstructionCallConv cs (primitive/cast i32 id)) 0)
                    (mk-tv cs (primitive/load ret))))))))))

; emit a `do`/let body: last value, default (i64 0); stop at a terminator.
(defn emit-body [(cg (ptr Cg)) (body (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> Tv)
  (let [n (al-len [Expr] (primitive/load body))
        (mut last) (mk-tv (cg-zero-i64 cg) (TInt 64 true))
        (mut i) 0]
    (loop (if (or (primitive/icmp-ge (primitive/load i) n) (cg-terminated cg))
              (break)
              (do
                (primitive/store! last (emit-expr cg (al-elem [Expr] body (primitive/load i)) scp))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load last)))
; bind a let's bindings into a child scp.
(defn emit-binds [(cg (ptr Cg)) (binds (ptr (ArrayList Bind))) (scp (ptr Scope))] (-> (ptr Scope))
  (let [a (primitive/load (primitive/field cg a))
        n (al-len [Bind] (primitive/load binds))
        (mut s) scp
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [bp (al-elem [Bind] binds (primitive/load i))
                      tv (emit-expr cg (primitive/field bp value) (primitive/load s))]
                  (primitive/store! s (scope-put a (primitive/load s) (primitive/load (primitive/field bp name)) (tv-val tv) (tv-ty tv))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load s)))

(defn emit-call [(cg (ptr Cg)) (func (slice u8)) (args (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        ret-ty (match (cg-ret cg func) (Some [t] t) (None [] (cg-bug-ty (sconcat a "codegen: unknown callable " func))))
        shim (cg-shim-find cg func)]
    (if (primitive/icmp-ne (primitive/cast i64 shim) 0)
        ; a :shim callee is reached through a register-constrained inline-asm call,
        ; not a plain direct call.
        (let [vals (emit-vals cg args scp)
              vp (alloc/stack (ArrayList (ptr i8)))]
          (primitive/store! vp vals)
          (mk-tv (cg-emit-shim-call cg func shim vp) ret-ty))
        (emit-call-native cg func args scp ret-ty))))
(defn emit-call-native [(cg (ptr Cg)) (func (slice u8)) (args (ptr (ArrayList Expr))) (scp (ptr Scope)) (ret-ty Type)] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        callee (cg-func cg func)]
    (if (primitive/icmp-eq (primitive/cast i64 callee) 0)
        (cg-bug (sconcat a "codegen: call to undefined " func))
        (let [sig (cg-csig cg func)]
          (if (primitive/icmp-ne (primitive/cast i64 sig) 0)
              (emit-c-call cg callee sig (emit-argtv cg args scp) ret-ty)
              (let [vals (emit-vals cg args scp)
                    meta (reconcile-args cg callee vals)
                    cs
                      (LLVMBuildCall2 b
                                      (LLVMGlobalGetValueType callee)
                                      callee
                                      (carr a meta)
                                      (primitive/cast i32 (al-len [(ptr i8)] meta))
                                      (cg-call-name cg (LLVMGlobalGetValueType callee) "call"))]
                (LLVMSetInstructionCallConv cs (LLVMGetFunctionCallConv callee))
                (if (ty-is-void (box-type a ret-ty)) (mk-tv (cg-zero-i64 cg) (TVoid)) (mk-tv cs ret-ty))))))))
(defn cg-bug-ty [(msg (slice u8))] (-> Type)
  (unimplemented msg)
  (TInt 64 true))

(defn emit-field [(cg (ptr Cg)) (pe (ptr Expr)) (fname (slice u8)) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        pv (emit-expr cg pe scp)
        sname
          (match-else (tv-ty pv)
                      (TPtr [pe2]
                            (match-else (primitive/load pe2) (TStruct [s] s) (_ (cg-bug-sl "codegen: field on (ptr non-struct)"))))
                      (_ (cg-bug-sl "codegen: field on non-pointer")))
        si (cg-struct-idx cg sname)]
    (if (primitive/icmp-lt si 0)
        (cg-bug (sconcat a "codegen: unknown struct " sname))
        (let [sp (al-elem [CgStruct] (primitive/field cg structs) si)
              fs (primitive/load (primitive/field sp fields))
              nf (al-len [Field] (primitive/load fs))
              (mut idx) -1
              (mut i) 0]
          (loop (if (primitive/icmp-ge (primitive/load i) nf)
                    (break)
                    (do
                      (when (str-eq (primitive/load (primitive/field (al-elem [Field] fs (primitive/load i)) name)) fname) (primitive/store! idx (primitive/load i)))
                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
          (if (primitive/icmp-lt (primitive/load idx) 0)
              (cg-bug "codegen: no such field")
              (let [fty (primitive/load (primitive/field (al-elem [Field] fs (primitive/load idx)) ty))
                    gep
                      (match-else (primitive/load (primitive/field sp layout))
                                  (LBits [_ _]
                                         (LLVMBuildStructGEP2 b
                                                             (primitive/load (primitive/field sp ty))
                                                             (tv-val pv)
                                                             0
                                                             (cg-bl cg "field")))
                                  (_ (let [(mut ix) (al-new [(ptr i8)] a)]
                                       (al-push! (mut ix)
                                                 (LLVMConstInt (cg-i64t cg)
                                                               (field-offset (primitive/field cg layouts) si (primitive/load idx))
                                                               0))
                                       (LLVMBuildGEP2 b
                                                      (LLVMInt8TypeInContext (cg-ctx cg))
                                                      (tv-val pv)
                                                      (carr a (primitive/load ix))
                                                      1
                                                      (cg-bl cg "field")))))]
                (mk-tv gep (TPtr (box-type a fty)))))))))
(defn cg-bug-sl [(msg (slice u8))] (-> (slice u8))
  (unimplemented msg)
  "")

(defn emit-index [(cg (ptr Cg)) (pe (ptr Expr)) (idx (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        pv (emit-expr cg pe scp)
        iv (emit-expr cg idx scp)
        pointee
          (match-else (tv-ty pv)
                      (TPtr [pe2] (primitive/load pe2))
                      (_ (do (unimplemented "codegen: index of non-pointer") (TInt 64 true))))]
    (match-else pointee
                (TArray [elem nn]
                        (let [(mut ix) (al-new [(ptr i8)] a)]
                          (al-push! (mut ix) (cg-zero-i64 cg))
                          (al-push! (mut ix) (tv-val iv))
                          (mk-tv (LLVMBuildGEP2 b
                                                (basic-ty cg (box-type a pointee))
                                                (tv-val pv)
                                                (carr a (primitive/load ix))
                                                2
                                                (cg-bl cg "idx"))
                                 (TPtr elem))))
                (_ (let [(mut ix) (al-new [(ptr i8)] a)]
                     (al-push! (mut ix) (tv-val iv))
                     (mk-tv (LLVMBuildGEP2 b
                                           (basic-ty cg (box-type a pointee))
                                           (tv-val pv)
                                           (carr a (primitive/load ix))
                                           1
                                           (cg-bl cg "idx"))
                            (TPtr (box-type a pointee))))))))

(defn emit-cast [(cg (ptr Cg)) (t (ptr Type)) (inner (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        ctx (cg-ctx cg)
        iv (emit-expr cg inner scp)
        v (tv-val iv)
        vt (tv-ty iv)
        v-is-ptr (match-else vt (TPtr [x] true) (_ false))
        v-is-float (match-else vt (TFloat [x] true) (_ false))
        v-is-int (match-else vt (TInt [x y] true) (_ false))
        v-signed (match-else vt (TInt [x s] s) (_ false))]
    (match-else (primitive/load t)
                (TInt [to s]
                      (if v-is-ptr
                          (mk-tv (LLVMBuildPtrToInt b v (int-width ctx to) (cg-bl cg "ptrtoint")) (primitive/load t))
                          (if v-is-float
                              (mk-tv (if s
                                         (LLVMBuildFPToSI b v (int-width ctx to) (cg-bl cg "fptosi"))
                                         (LLVMBuildFPToUI b v (int-width ctx to) (cg-bl cg "fptoui")))
                                     (primitive/load t))
                              (let [from (cg-int-bits vt)]
                                (mk-tv (if (primitive/icmp-gt to from)
                                           (if v-signed
                                               (LLVMBuildSExt b v (int-width ctx to) (cg-bl cg "sext"))
                                               (LLVMBuildZExt b v (int-width ctx to) (cg-bl cg "zext")))
                                           (if (primitive/icmp-lt to from)
                                               (LLVMBuildTrunc b v (int-width ctx to) (cg-bl cg "trunc"))
                                               v))
                                       (primitive/load t))))))
                (TPtr [inner2]
                      (if v-is-int
                          (mk-tv (LLVMBuildIntToPtr b v (LLVMPointerTypeInContext ctx 0) (cg-bl cg "inttoptr"))
                                 (primitive/load t))
                          (mk-tv v (primitive/load t))))
                (TFn [c p r] (mk-tv v (primitive/load t)))
                (TFloat [to]
                        (let [ft (basic-ty cg t)]
                          (if v-is-int
                              (mk-tv (if v-signed
                                         (LLVMBuildSIToFP b v ft (cg-bl cg "sitofp"))
                                         (LLVMBuildUIToFP b v ft (cg-bl cg "uitofp")))
                                     (primitive/load t))
                              (if v-is-float
                                  (let [from (cg-float-bits vt)]
                                    (mk-tv (if (primitive/icmp-gt to from)
                                               (LLVMBuildFPExt b v ft (cg-bl cg "fpext"))
                                               (if (primitive/icmp-lt to from) (LLVMBuildFPTrunc b v ft (cg-bl cg "fptrunc")) v))
                                           (primitive/load t)))
                                  (cg-bug "codegen: cannot cast to float")))))
                (_ (cg-bug "codegen: cannot cast to this type")))))
(defn cg-int-bits [(t Type)] (-> i64)
  (match-else t (TInt [b s] b) (_ 64)))
(defn cg-float-bits [(t Type)] (-> i64)
  (match-else t (TFloat [b] b) (_ 64)))

; ======================== emit_construct / emit_match ========================
(defn emit-construct [(cg (ptr Cg))
                      (sum (slice u8))
                      (variant (slice u8))
                      (args (ptr (ArrayList Expr)))
                      (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        ui (cg-sum-idx cg sum)]
    (if (primitive/icmp-lt ui 0)
        (cg-bug (sconcat a "codegen: unknown sum " sum))
        (let [sp (al-elem [CgSum] (primitive/field cg sums) ui)
              vidx (cg-variant-idx cg sp variant)
              sum-ty (primitive/load (primitive/field sp ty))
              var-struct (al-get [(ptr i8)] (primitive/load (primitive/field sp vstructs)) vidx)
              tmp (cg-entry-alloca cg sum-ty (cg-bl cg "sum.tmp"))
              tagptr (LLVMBuildStructGEP2 b sum-ty tmp 0 (cg-bl cg "tag"))]
          (LLVMBuildStore b (LLVMConstInt (cg-i32t cg) vidx 0) tagptr)
          (let [payload (LLVMBuildStructGEP2 b sum-ty tmp 1 (cg-bl cg "payload"))
                n (al-len [Expr] (primitive/load args))
                (mut i) 0]
            (loop (if (primitive/icmp-ge (primitive/load i) n)
                      (break)
                      (do
                        (let [vv (emit-expr cg (al-elem [Expr] args (primitive/load i)) scp)
                              fptr (LLVMBuildStructGEP2 b var-struct payload (primitive/cast i32 (primitive/load i)) (cg-bl cg "vf"))]
                          (LLVMBuildStore b (tv-val vv) fptr))
                        (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
            (mk-tv (LLVMBuildLoad2 b sum-ty tmp (cg-bl cg "sum")) (TStruct sum)))))))

(defn emit-match [(cg (ptr Cg)) (scrut (ptr Expr)) (arms (ptr (ArrayList Arm))) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        sv (emit-expr cg scrut scp)
        sumname (match-else (tv-ty sv) (TStruct [s] s) (_ (cg-bug-sl "codegen: match on non-sum")))
        ui (cg-sum-idx cg sumname)]
    (if (primitive/icmp-lt ui 0)
        (cg-bug (sconcat a "codegen: match on non-sum " sumname))
        (let [sp (al-elem [CgSum] (primitive/field cg sums) ui)
              sum-ty (primitive/load (primitive/field sp ty))
              tmp (cg-entry-alloca cg sum-ty (cg-bl cg "match.tmp"))]
          (LLVMBuildStore b (tv-val sv) tmp)
          (let [tagptr (LLVMBuildStructGEP2 b sum-ty tmp 0 (cg-bl cg "tag"))
                tag (LLVMBuildLoad2 b (cg-i32t cg) tagptr (cg-bl cg "tag"))
                payload (LLVMBuildStructGEP2 b sum-ty tmp 1 (cg-bl cg "payload"))
                func (cg-cur-func cg)
                narms (al-len [Arm] (primitive/load arms))
                (mut armbbs) (al-new [(ptr i8)] a)
                (mut k) 0]
            (loop (if (primitive/icmp-ge (primitive/load k) narms)
                      (break)
                      (do (al-push! (mut armbbs) (cg-append cg func (cg-bl cg "arm"))) (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
            (let [default (cg-append cg func (cg-bl cg "match.default"))
                  merge (cg-append cg func (cg-bl cg "match.end"))
                  sw (LLVMBuildSwitch b tag default (primitive/cast i32 narms))
                  (mut k2) 0]
              (loop (if (primitive/icmp-ge (primitive/load k2) narms)
                        (break)
                        (do
                          (let [ap (al-elem [Arm] arms (primitive/load k2))
                                vidx (cg-variant-idx cg sp (primitive/load (primitive/field ap variant)))]
                            (LLVMAddCase sw
                                         (LLVMConstInt (cg-i32t cg) vidx 0)
                                         (al-get [(ptr i8)] (primitive/load armbbs) (primitive/load k2))))
                          (primitive/store! k2 (primitive/iadd (primitive/load k2) 1)))))
              (cg-pos cg default)
              (LLVMBuildUnreachable b)
              ; emit arms; collect (value, end-block) for the merge phi.
              (let [(mut inc-vals) (al-new [(ptr i8)] a)
                    (mut inc-bbs) (al-new [(ptr i8)] a)
                    (mut result-ty) (TInt 64 true)
                    (mut k3) 0]
                (loop (if (primitive/icmp-ge (primitive/load k3) narms)
                          (break)
                          (do
                            (cg-pos cg (al-get [(ptr i8)] (primitive/load armbbs) (primitive/load k3)))
                            (let [ap (al-elem [Arm] arms (primitive/load k3))
                                  vidx (cg-variant-idx cg sp (primitive/load (primitive/field ap variant)))
                                  var-struct (al-get [(ptr i8)] (primitive/load (primitive/field sp vstructs)) vidx)
                                  vp (al-elem [Variant] (primitive/load (primitive/field sp variants)) vidx)
                                  vfs (primitive/load (primitive/field vp fields))
                                  binds (primitive/load (primitive/field ap binds))
                                  nb (al-len [(slice u8)] (primitive/load binds))
                                  (mut child) scp
                                  (mut j) 0]
                              (loop (if (primitive/icmp-ge (primitive/load j) nb)
                                        (break)
                                        (do
                                          (let [fptr
                                                  (LLVMBuildStructGEP2 b
                                                                       var-struct
                                                                       payload
                                                                       (primitive/cast i32 (primitive/load j))
                                                                       (cg-bl cg "vf"))
                                                fty (primitive/load (primitive/field (al-elem [Field] vfs (primitive/load j)) ty))
                                                bname (al-get [(slice u8)] (primitive/load binds) (primitive/load j))
                                                fval
                                                  (LLVMBuildLoad2 b
                                                                  (basic-ty cg (box-type a fty))
                                                                  fptr
                                                                  (slice->cstr a bname))]
                                            (primitive/store! child (scope-put a (primitive/load child) bname fval fty)))
                                          (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                              (let [bv (emit-expr cg (primitive/field ap body) (primitive/load child))
                                    endbb (cg-cur-block cg)]
                                (when (primitive/icmp-eq (primitive/cast i64 (LLVMGetBasicBlockTerminator endbb)) 0)
                                      (primitive/store! result-ty (tv-ty bv))
                                      (LLVMBuildBr b merge)
                                      (al-push! (mut inc-vals) (tv-val bv))
                                      (al-push! (mut inc-bbs) endbb))))
                            (primitive/store! k3 (primitive/iadd (primitive/load k3) 1)))))
                (cg-pos cg merge)
                (if (primitive/icmp-eq (al-len [(ptr i8)] (primitive/load inc-vals)) 0)
                    (do (LLVMBuildUnreachable b) (mk-tv (cg-zero-i64 cg) (primitive/load result-ty)))
                    (let [phi (LLVMBuildPhi b (basic-ty cg (box-type a (primitive/load result-ty))) (cg-bl cg "match.val"))]
                      (LLVMAddIncoming phi
                                       (carr a (primitive/load inc-vals))
                                       (carr a (primitive/load inc-bbs))
                                       (primitive/cast i32 (al-len [(ptr i8)] (primitive/load inc-vals))))
                      (mk-tv phi (primitive/load result-ty)))))))))))

; ======================== emit_alloc / bit access ============================
; a struct with `:layout (align N)` (or explicit `:align`) forces its allocation
; alignment; 0 = no forced alignment.
(defn cg-force-align [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match-else (primitive/load t)
              (TStruct [nm]
                       (let [si (cg-struct-idx cg nm)]
                         (unless (primitive/icmp-lt si 0)
                                 (let [want (primitive/load (primitive/field (struct-at (primitive/field cg layouts) si) align))
                                       natural (primitive/cast i64
                                                     (LLVMABIAlignmentOfType (primitive/load (primitive/field cg td))
                                                                             (basic-ty cg t)))]
                                   (if (primitive/icmp-gt want natural) want 0)))))
              (TArray [elem _n] (cg-force-align cg elem))
              (_ 0)))
(defn emit-alloc [(cg (ptr Cg)) (storage i64) (t (ptr Type))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        bt (basic-ty cg t)
        fa (cg-force-align cg t)]
    (if (primitive/icmp-eq storage 0)
        (let [p (LLVMBuildAlloca b bt (cg-bl cg "stack.slot"))]
          (when (primitive/icmp-gt fa 0) (LLVMSetAlignment p (primitive/cast i32 fa)) 0)
          (mk-tv p (TPtr (box-type a (primitive/load t)))))
        (if (primitive/icmp-eq storage 2)
            (mk-tv (LLVMBuildMalloc b bt (cg-bl cg "heap.box")) (TPtr (box-type a (primitive/load t))))
            (let [n (cg-next-global cg)
                  g (LLVMAddGlobal (primitive/load (primitive/field cg module)) bt (cg-gname cg "g." n))]
              (LLVMSetInitializer g (LLVMConstNull bt))
              (when (primitive/icmp-gt fa 0) (LLVMSetAlignment g (primitive/cast i32 fa)) 0)
              (mk-tv g (TPtr (box-type a (primitive/load t)))))))))

; ======================== emit_if / loop / break / continue ==================
(defn emit-if [(cg (ptr Cg)) (cnd (ptr Expr)) (thn (ptr Expr)) (els (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        func (cg-cur-func cg)
        cv (emit-expr cg cnd scp)
        c (tv-val cv)
        cmp (LLVMBuildICmp b 33 c (cg-zero (LLVMTypeOf c)) (cg-bl cg "ifc"))
        then-bb (cg-append cg func (cg-bl cg "then"))
        else-bb (cg-append cg func (cg-bl cg "else"))]
    (LLVMBuildCondBr b cmp then-bb else-bb)
    (cg-pos cg then-bb)
    (let [tv (emit-expr cg thn scp)
          then-end (cg-cur-block cg)
          then-div (primitive/icmp-ne (primitive/cast i64 (LLVMGetBasicBlockTerminator then-end)) 0)]
      (cg-pos cg else-bb)
      (let [ev (emit-expr cg els scp)
            else-end (cg-cur-block cg)
            else-div (primitive/icmp-ne (primitive/cast i64 (LLVMGetBasicBlockTerminator else-end)) 0)]
        (cond (and (not then-div) (not else-div))
                (let [merge-bb (cg-append cg func (cg-bl cg "ifcont"))]
                  (cg-pos cg then-end)
                  (LLVMBuildBr b merge-bb)
                  (cg-pos cg else-end)
                  (LLVMBuildBr b merge-bb)
                  (cg-pos cg merge-bb)
                  (let [phi (LLVMBuildPhi b (basic-ty cg (box-type a (tv-ty tv))) (cg-bl cg "ifval"))
                        (mut vs) (al-new [(ptr i8)] a)
                        (mut bs) (al-new [(ptr i8)] a)]
                    (al-push! (mut vs) (tv-val tv))
                    (al-push! (mut vs) (tv-val ev))
                    (al-push! (mut bs) then-end)
                    (al-push! (mut bs) else-end)
                    (LLVMAddIncoming phi (carr a (primitive/load vs)) (carr a (primitive/load bs)) 2)
                    (mk-tv phi (tv-ty tv))))
              (and (not then-div) else-div) (do (cg-pos cg then-end) tv)
              (and then-div (not else-div)) (do (cg-pos cg else-end) ev)
              :else
                (let [dead-bb (cg-append cg func (cg-bl cg "ifcont.dead"))]
                  (cg-pos cg dead-bb)
                  (LLVMBuildUnreachable b)
                  (mk-tv (cg-zero-i64 cg) (tv-ty tv))))))))

(defn emit-loop [(cg (ptr Cg)) (label (Option (slice u8))) (body (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        func (cg-cur-func cg)
        body-bb (cg-append cg func (cg-bl cg "loop.body"))
        after-bb (cg-append cg func (cg-bl cg "loop.after"))]
    (LLVMBuildBr b body-bb)
    (cg-pos cg body-bb)
    (let [lc (alloc/stack CgLoop)]
      (primitive/store! (primitive/field lc label) label)
      (primitive/store! (primitive/field lc body_bb) body-bb)
      (primitive/store! (primitive/field lc after_bb) after-bb)
      (primitive/store! (primitive/field lc breaks) (al-new [CgBreak] a))
      (primitive/store! (primitive/field lc break_ty) (None [Type]))
      (al-push! (mut (primitive/field cg loops)) (primitive/load lc)))
    (let [n (al-len [Expr] (primitive/load body))
          (mut i) 0]
      (loop (if (or (primitive/icmp-ge (primitive/load i) n) (cg-terminated cg))
                (break)
                (do (emit-expr cg (al-elem [Expr] body (primitive/load i)) scp) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (when (not (cg-terminated cg)) (LLVMBuildBr b body-bb) 0)
    (let [popped
            (match (al-pop! [CgLoop] (mut (primitive/field cg loops)))
              (Some [x] x)
              (None [] (do (unimplemented "loop ctx missing") (primitive/zeroed CgLoop))))
          lp (alloc/stack CgLoop)]
      (primitive/store! lp popped)
      (cg-pos cg after-bb)
      (let [nb (al-len [CgBreak] (primitive/load (primitive/field lp breaks)))]
        (if (primitive/icmp-eq nb 0)
            (do (LLVMBuildUnreachable b) (mk-tv (cg-zero-i64 cg) (TInt 64 true)))
            (let [ty (match (primitive/load (primitive/field lp break_ty)) (Some [t] t) (None [] (TInt 64 true)))
                  phi (LLVMBuildPhi b (basic-ty cg (box-type a ty)) (cg-bl cg "loop.val"))
                  (mut vs) (al-new [(ptr i8)] a)
                  (mut bs) (al-new [(ptr i8)] a)
                  (mut i) 0]
              (loop (if (primitive/icmp-ge (primitive/load i) nb)
                        (break)
                        (do
                          (let [bp (al-elem [CgBreak] (primitive/field lp breaks) (primitive/load i))]
                            (al-push! (mut vs) (primitive/load (primitive/field bp val)))
                            (al-push! (mut bs) (primitive/load (primitive/field bp bb))))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
              (LLVMAddIncoming phi (carr a (primitive/load vs)) (carr a (primitive/load bs)) (primitive/cast i32 nb))
              (mk-tv phi ty)))))))

(defn cg-loop-index [(cg (ptr Cg)) (label (Option (slice u8)))] (-> i64)
  (let [n (al-len [CgLoop] (primitive/load (primitive/field cg loops)))]
    (match label
      (Some [l]
            (let [(mut r) -1
                  (mut i) 0]
              (loop (if (primitive/icmp-ge (primitive/load i) n)
                        (break)
                        (do
                          (match (primitive/load (primitive/field (al-elem [CgLoop] (primitive/field cg loops) (primitive/load i)) label))
                            (Some [ll] (when (str-eq ll l) (primitive/store! r (primitive/load i))))
                            (None [] 0))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
              (if (primitive/icmp-lt (primitive/load r) 0) (do (unimplemented "codegen: break/continue to unknown loop label") -1) (primitive/load r))))
      (None [] (if (primitive/icmp-eq n 0) (do (unimplemented "codegen: break/continue outside of a loop") -1) (primitive/isub n 1))))))

(defn emit-break [(cg (ptr Cg)) (label (Option (slice u8))) (value (Option (ptr Expr))) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        vtv (match value (Some [e] (emit-expr cg e scp)) (None [] (mk-tv (cg-zero-i64 cg) (TInt 64 true))))]
    (if (cg-terminated cg)
        (mk-tv (cg-zero-i64 cg) (TInt 64 true))
        (let [pred (cg-cur-block cg)
              idx (cg-loop-index cg label)
              lp (al-elem [CgLoop] (primitive/field cg loops) idx)
              site (alloc/stack CgBreak)]
          (primitive/store! (primitive/field site val) (tv-val vtv))
          (primitive/store! (primitive/field site bb) pred)
          (al-push! (mut (primitive/field lp breaks)) (primitive/load site))
          (match (primitive/load (primitive/field lp break_ty))
            (Some [x] 0)
            (None [] (do (primitive/store! (primitive/field lp break_ty) (Some [Type] (tv-ty vtv))) 0)))
          (LLVMBuildBr b (primitive/load (primitive/field lp after_bb)))
          (mk-tv (cg-zero-i64 cg) (TInt 64 true))))))

(defn emit-continue [(cg (ptr Cg)) (label (Option (slice u8)))] (-> Tv)
  (let [b (cg-bld cg)
        idx (cg-loop-index cg label)
        lp (al-elem [CgLoop] (primitive/field cg loops) idx)]
    (LLVMBuildBr b (primitive/load (primitive/field lp body_bb)))
    (mk-tv (cg-zero-i64 cg) (TInt 64 true))))

; ======================== bit access (BitGet/BitSet) =========================
(defstruct BitAcc [(pv (ptr i8)) (off i64) (width i64) (backing i64)])
(defn bit-access [(cg (ptr Cg)) (pe (ptr Expr)) (fname (slice u8)) (scp (ptr Scope))] (-> BitAcc)
  (let [a (primitive/load (primitive/field cg a))
        pv (emit-expr cg pe scp)
        sname
          (match-else (tv-ty pv)
                      (TPtr [p2] (match-else (primitive/load p2) (TStruct [s] s) (_ (cg-bug-sl "bit access on non-struct"))))
                      (_ (cg-bug-sl "bit access on non-pointer")))
        si (cg-struct-idx cg sname)
        sp (al-elem [CgStruct] (primitive/field cg structs) si)
        fs (primitive/load (primitive/field sp fields))
        nf (al-len [Field] (primitive/load fs))
        (mut idx) -1
        (mut i) 0
        r (alloc/stack BitAcc)]
    (loop (if (primitive/icmp-ge (primitive/load i) nf)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [Field] fs (primitive/load i)) name)) fname) (primitive/store! idx (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/store! (primitive/field r pv) (tv-val pv))
    (primitive/store! (primitive/field r width)
            (match-else (primitive/load (primitive/field (al-elem [Field] fs (primitive/load idx)) ty))
                        (TInt [w s] w)
                        (_ (do (unimplemented "bitfield not int") 0))))
    (match-else (primitive/load (primitive/field sp layout))
                (LBits [backing offs]
                       (do
                         (primitive/store! (primitive/field r backing) backing)
                         (primitive/store! (primitive/field r off) (al-get [i64] (primitive/load offs) (primitive/load idx)))))
                (_ (do (unimplemented "codegen: not a bit struct") 0)))
    (primitive/load r)))
(defn emit-bitget [(cg (ptr Cg)) (pe (ptr Expr)) (fname (slice u8)) (scp (ptr Scope))] (-> Tv)
  (let [b (cg-bld cg)
        ctx (cg-ctx cg)
        ba (alloc/stack BitAcc)]
    (primitive/store! ba (bit-access cg pe fname scp))
    (let [backing-ty (int-width ctx (primitive/load (primitive/field ba backing)))
          loaded (LLVMBuildLoad2 b backing-ty (primitive/load (primitive/field ba pv)) (cg-bl cg "bits"))
          off (primitive/load (primitive/field ba off))
          width (primitive/load (primitive/field ba width))
          shifted (if (primitive/icmp-gt off 0) (LLVMBuildLShr b loaded (LLVMConstInt backing-ty off 0) (cg-bl cg "shr")) loaded)
          field-ty (int-width ctx width)
          res
            (if (primitive/icmp-lt width (primitive/load (primitive/field ba backing))) (LLVMBuildTrunc b shifted field-ty (cg-bl cg "bget")) shifted)]
      (mk-tv res (TInt width false)))))
(defn emit-bitset [(cg (ptr Cg)) (pe (ptr Expr)) (fname (slice u8)) (val (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [b (cg-bld cg)
        ctx (cg-ctx cg)
        ba (alloc/stack BitAcc)]
    (primitive/store! ba (bit-access cg pe fname scp))
    (let [vv (emit-expr cg val scp)
          backing (primitive/load (primitive/field ba backing))
          off (primitive/load (primitive/field ba off))
          width (primitive/load (primitive/field ba width))
          backing-ty (int-width ctx backing)
          loaded (LLVMBuildLoad2 b backing-ty (primitive/load (primitive/field ba pv)) (cg-bl cg "bits"))
          field-mask (primitive/ishl (primitive/isub (primitive/ishl 1 width) 1) off)
          clear (LLVMConstInt backing-ty (primitive/ixor field-mask -1) 0)
          cleared (LLVMBuildAnd b loaded clear (cg-bl cg "clear"))
          vext (if (primitive/icmp-lt width backing) (LLVMBuildZExt b (tv-val vv) backing-ty (cg-bl cg "vext")) (tv-val vv))
          vshift (if (primitive/icmp-gt off 0) (LLVMBuildShl b vext (LLVMConstInt backing-ty off 0) (cg-bl cg "vshl")) vext)
          newval (LLVMBuildOr b cleared vshift (cg-bl cg "set"))]
      (LLVMBuildStore b newval (primitive/load (primitive/field ba pv)))
      (mk-tv (tv-val vv) (TInt width false)))))

; ======================== fnptr-of / call-ptr / llvm-ir ======================
(defn emit-fnptr [(cg (ptr Cg)) (name (slice u8))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        fv (cg-func cg name)]
    (if (primitive/icmp-eq (primitive/cast i64 fv) 0)
        (cg-bug (sconcat a "codegen: fnptr-of unknown " name))
        (let [si (cg-sig-idx cg name)]
          (if (primitive/icmp-lt si 0)
              (cg-bug (sconcat a "codegen: no signature for " name))
              (let [sp (al-elem [CgSig] (primitive/field cg sigs) si)]
                (mk-tv fv (TFn (primitive/load (primitive/field sp cc)) (primitive/load (primitive/field sp params)) (box-type a (primitive/load (primitive/field sp ret)))))))))))
; An indirect call through a `(fnptr cc …)`.
;
; ⚠ A `c` fnptr must go through the SAME C-ABI lowering a direct extern gets. It
; used to build a plain call from the declared parameter types, so a by-value
; struct was passed as the raw LLVM aggregate while the callee — declared with the
; C-lowered signature — expected packed i64 slots. Structs of 16 and 32 bytes
; happened to agree; 4- and 8-byte ones arrived corrupt, silently
; (docs/archive/BUG_CALLPTR_C_ABI.md). c-signature takes params/ret directly rather than a
; callee name, so the indirect case can use it with no registry entry.
;
; Only the `c` convention is lowered. A non-`c` fnptr keeps the plain call it has
; always had — its convention is Coil-internal, not an ABI boundary.
(defn emit-callptr [(cg (ptr Cg)) (fp (ptr Expr)) (args (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        fpv (emit-expr cg fp scp)
        cc-params-ret
          (match-else (tv-ty fpv)
                      (TFn [c p r] (mk-fnsig c p r))
                      (_ (do
                           (unimplemented "codegen: call-ptr on non-fnptr")
                           (mk-fnsig "" (box-al [Type] a (al-new [Type] a)) (box-type a (TInt 64 true))))))
        params (fnsig-params cc-params-ret)
        retp (fnsig-ret cc-params-ret)]
    (if (str-eq (fnsig-cc cc-params-ret) "c")
        ; NOT guarded by cg-check-c-abi-types, deliberately. The bug report suggested
        ; it, reasoning that a by-value (slice u8) through a `c` fnptr slips past a
        ; rejection the direct path raises. But `c` is the DEFAULT convention for an
        ; ordinary defn, not a marker of an FFI boundary: driver.coil's whole backend
        ; injection surface is (fnptr c [… (slice u8) …] i64) passing Coil to Coil, and
        ; guarding here rejects the compiler's own source. A fnptr cannot tell us
        ; whether its target is a C function or a Coil one — both are `c` — so the
        ; guard has no way to fire only at real boundaries.
        ; The LOWERING below still applies to every `c` fnptr, and that is correct:
        ; fnptr-of hands back the function as declared, and a Coil defn with struct
        ; params IS declared with the C-lowered signature. A slice is unaffected —
        ; c-signature classifies it AAScalar, exactly the type the old path built.
        (let [sig (c-signature cg params retp false)]
          (emit-c-call-ty cg
                          (tv-val fpv)
                          (primitive/load (primitive/field sig fn_ty))
                          (primitive/cast i32 0)
                          sig
                          (emit-argtv cg args scp)
                          (primitive/load retp)
                          "callptr"))
        (let [fnty (cg-fn-type cg params retp)
              vals (emit-vals cg args scp)
              cs
                (LLVMBuildCall2 b
                                fnty
                                (tv-val fpv)
                                (carr a vals)
                                (primitive/cast i32 (al-len [(ptr i8)] vals))
                                (cg-bl cg "callptr"))]
          (mk-tv cs (primitive/load retp))))))
(defstruct FnSig [(cc (slice u8)) (params (ptr (ArrayList Type))) (ret (ptr Type))])
(defn mk-fnsig [(c (slice u8)) (p (ptr (ArrayList Type))) (r (ptr Type))] (-> FnSig)
  (let [x (alloc/stack FnSig)] (primitive/store! (primitive/field x cc) c) (primitive/store! (primitive/field x params) p) (primitive/store! (primitive/field x ret) r) (primitive/load x)))
(defn fnsig-params [(s FnSig)] (-> (ptr (ArrayList Type)))
  (let [x (alloc/stack FnSig)] (primitive/store! x s) (primitive/load (primitive/field x params))))
(defn fnsig-ret [(s FnSig)] (-> (ptr Type))
  (let [x (alloc/stack FnSig)] (primitive/store! x s) (primitive/load (primitive/field x ret))))
(defn fnsig-cc [(s FnSig)] (-> (slice u8))
  (let [x (alloc/stack FnSig)] (primitive/store! x s) (primitive/load (primitive/field x cc))))

(defn emit-llvm-ir [(cg (ptr Cg)) (result (ptr Type)) (args (ptr (ArrayList Expr))) (body (slice u8)) (scp (ptr Scope))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        argtv (emit-arg-tvs cg args scp)
        nargs (al-len [Tv] (primitive/load argtv))
        ret-str (cstr->slice (LLVMPrintTypeToString (basic-ty cg result)))
        ; substitute placeholders, highest index first.
        (mut text) body
        (mut i) (primitive/isub nargs 1)]
    (loop (if (primitive/icmp-lt (primitive/load i) 0)
              (break)
              (do
                (let [argstr
                        (cstr->slice (LLVMPrintTypeToString (basic-ty cg
                                                                      (box-type a
                                                                                (tv-ty (al-get [Tv]
                                                                                               (primitive/load argtv)
                                                                                               (primitive/load i)))))))]
                  (primitive/store! text (str-replace-all a (primitive/load text) (sconcat a "$t" (i64->str a (primitive/load i))) argstr))
                  (primitive/store! text
                          (str-replace-all a
                                           (primitive/load text)
                                           (sconcat a "$" (i64->str a (primitive/load i)))
                                           (sconcat a "%" (i64->str a (primitive/load i))))))
                (primitive/store! i (primitive/isub (primitive/load i) 1)))))
    (primitive/store! text (str-replace-all a (primitive/load text) "$ret" ret-str))
    ; hoist `declare` lines; build the helper module text.
    (let [lines (nz-split-lines a (primitive/load text))
          nl (al-len [(slice u8)] lines)
          (mut decls) (sb-new a)
          (mut fnbody) (sb-new a)
          (mut j) 0]
      (loop (if (primitive/icmp-ge (primitive/load j) nl)
                (break)
                (do
                  (let [ln (al-get [(slice u8)] lines (primitive/load j))]
                    (if (starts-with (str-ltrim ln) "declare")
                        (do (sb-push-str! (mut decls) ln) (sb-push-byte! (mut decls) 10))
                        (do (sb-push-str! (mut fnbody) ln) (sb-push-byte! (mut fnbody) 10))))
                  (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
      (let [seq (primitive/load (primitive/field cg llvm_seq))]
        (primitive/store! (primitive/field cg llvm_seq) (primitive/iadd seq 1))
        (let [name (sconcat a "__coil_llvm_ir_" (i64->str a seq))
              (mut params) (sb-new a)
              (mut k) 0]
          (loop (if (primitive/icmp-ge (primitive/load k) nargs)
                    (break)
                    (do
                      (when (primitive/icmp-gt (primitive/load k) 0) (sb-push-str! (mut params) ", "))
                      (let [argstr
                              (cstr->slice (LLVMPrintTypeToString (basic-ty cg
                                                                            (box-type a
                                                                                      (tv-ty (al-get [Tv]
                                                                                                     (primitive/load argtv)
                                                                                                     (primitive/load k)))))))]
                        (sb-push-str! (mut params) argstr)
                        (sb-push-str! (mut params) " %")
                        (sb-push-str! (mut params) (i64->str a (primitive/load k))))
                      (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
          (let [(mut mt) (sb-new a)]
            (sb-push-str! (mut mt) (sb-str (primitive/load decls)))
            (sb-push-str! (mut mt) "define ")
            (sb-push-str! (mut mt) ret-str)
            (sb-push-str! (mut mt) " @")
            (sb-push-str! (mut mt) name)
            (sb-push-str! (mut mt) "(")
            (sb-push-str! (mut mt) (sb-str (primitive/load params)))
            (sb-push-str! (mut mt) ") alwaysinline {\n")
            (sb-push-str! (mut mt) (sb-str (primitive/load fnbody)))
            (sb-push-str! (mut mt) "}\n")
            (let [mtext (sb-str (primitive/load mt))
                  membuf
                    (LLVMCreateMemoryBufferWithMemoryRangeCopy (primitive/cast (ptr i8) (slice-data [u8] mtext))
                                                               (slice-len mtext)
                                                               (cg-bl cg "coil_llvm_ir"))
                  modout (alloc/stack (ptr i8))
                  errout (alloc/stack (ptr i8))]
              (if (primitive/icmp-ne (LLVMParseIRInContext (cg-ctx cg) membuf modout errout) 0)
                  ; Parse failure: the message is LLVM's own, which is
                  ; itself `{:?}` (Debug) over its `Deref::Target = CStr` — so the LLVM
                  ; error message (read from the `errout` char** out-param) is CStr-Debug-
                  ; escaped (quoted, `\n`, `\'`, `\xHH` …) via cstr-dbg-escape; the
                  ; `--- generated module ---` section is the module text we just built
                  ; (mtext). cg-fail renders it as `error: <body>` + exit 1.
                  (do
                    (cg-fail (sconcat a
                                      (sconcat3 a
                                                "llvm-ir: could not parse IR: "
                                                (sconcat3 a "\"" (cstr-dbg-escape a (cstr->slice (primitive/load errout))) "\"")
                                                "\n--- generated module ---\n")
                                      mtext))
                    (mk-tv (primitive/cast (ptr i8) 0) (primitive/load result)))
                  (let [helper (primitive/load modout)]
                    (LLVMSetTarget helper (LLVMGetTarget (primitive/load (primitive/field cg module))))
                    (LLVMSetDataLayout helper (LLVMGetDataLayoutStr (primitive/load (primitive/field cg module))))
                    (LLVMLinkModules2 (primitive/load (primitive/field cg module)) helper)
                    (let [callee (LLVMGetNamedFunction (primitive/load (primitive/field cg module)) (slice->cstr a name))]
                      (LLVMSetLinkage callee 8)
                      (let [(mut vs) (al-new [(ptr i8)] a)
                            (mut q) 0]
                        (loop (if (primitive/icmp-ge (primitive/load q) nargs)
                                  (break)
                                  (do
                                    (al-push! (mut vs) (tv-val (al-get [Tv] (primitive/load argtv) (primitive/load q))))
                                    (primitive/store! q (primitive/iadd (primitive/load q) 1)))))
                        (mk-tv (LLVMBuildCall2 b
                                               (LLVMGlobalGetValueType callee)
                                               callee
                                               (carr a (primitive/load vs))
                                               (primitive/cast i32 nargs)
                                               (cg-bl cg "llvmir"))
                               (primitive/load result)))))))))))))
(defn emit-arg-tvs [(cg (ptr Cg)) (es (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> (ArrayList Tv))
  (let [n (al-len [Expr] (primitive/load es))
        (mut out) (al-new [Tv] (primitive/load (primitive/field cg a)))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut out) (emit-expr cg (al-elem [Expr] es (primitive/load i)) scp)) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load out)))
(defn str-ltrim [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (or (primitive/icmp-ge (primitive/load i) n) (primitive/icmp-ne (primitive/cast i64 (slice-get s (primitive/load i))) 32))
              (break)
              (primitive/store! i (primitive/iadd (primitive/load i) 1))))
    (substr s (primitive/load i) n)))

; ======================== emit_func / emit_tail ==============================
(defn emit-c-return [(cg (ptr Cg)) (sig (ptr CSig)) (ret (ptr Type)) (last Tv)] (-> i64)
  (let [b (cg-bld cg)]
    (if (ty-is-void ret)
        (do (LLVMBuildRetVoid b) 0)
        (let [has-sret (and (primitive/icmp-ne (primitive/cast i64 sig) 0) (primitive/icmp-ne (primitive/cast i64 (primitive/load (primitive/field sig sret))) 0))
              has-rd (and (primitive/icmp-ne (primitive/cast i64 sig) 0) (primitive/icmp-ne (primitive/cast i64 (primitive/load (primitive/field sig ret_direct))) 0))]
          (if (not (or has-sret has-rd))
              (do (LLVMBuildRet b (tv-val last)) 0)
              (let [sa (if has-sret (primitive/load (primitive/field sig sret)) (primitive/load (primitive/field sig ret_direct)))
                    lv (tv-val last)
                    src
                      (if (primitive/icmp-eq (LLVMGetTypeKind (LLVMTypeOf lv)) 12)
                          lv
                          (let [slot (cg-struct-slot cg sa "ret.spill")] (LLVMBuildStore b lv slot) slot))]
                (if has-sret
                    (do (cg-copy-struct cg (LLVMGetParam (cg-cur-func cg) 0) src sa) (LLVMBuildRetVoid b) 0)
                    (do
                      (LLVMBuildRet b (LLVMBuildLoad2 b (abi-direct-return-type cg sa) src (cg-bl cg "abi.ret.coerce")))
                      0))))))))
(defn tail-call-ok [(cg (ptr Cg)) (func (slice u8)) (function (ptr i8))] (-> bool)
  (and (primitive/icmp-eq (primitive/cast i64 (cg-func cg func)) (primitive/cast i64 function)) (not (cg-has-csig cg func))))
(defn emit-tail [(cg (ptr Cg)) (e (ptr Expr)) (function (ptr i8)) (sig (ptr CSig)) (ret (ptr Type)) (scp (ptr Scope))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)]
    (match-else (primitive/load (primitive/field e kind))
                (EDo [body]
                     (let [n (al-len [Expr] (primitive/load body))]
                       (if (primitive/icmp-eq n 0)
                           (emit-c-return cg sig ret (mk-tv (cg-zero-i64 cg) (TInt 64 true)))
                           (let [(mut i) 0]
                             (loop (if (or (primitive/icmp-ge (primitive/load i) (primitive/isub n 1)) (cg-terminated cg))
                                       (break)
                                       (do
                                         (emit-expr cg (al-elem [Expr] body (primitive/load i)) scp)
                                         (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                             (when (not (cg-terminated cg))
                                   (emit-tail cg (al-elem [Expr] body (primitive/isub n 1)) function sig ret scp))))))
                (ELet [binds body]
                      (let [child (emit-binds cg binds scp)
                            n (al-len [Expr] (primitive/load body))]
                        (unless (primitive/icmp-eq n 0)
                                (let [(mut i) 0]
                                  (loop (if (or (primitive/icmp-ge (primitive/load i) (primitive/isub n 1)) (cg-terminated cg))
                                            (break)
                                            (do
                                              (emit-expr cg (al-elem [Expr] body (primitive/load i)) child)
                                              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                                  (when (not (cg-terminated cg))
                                        (emit-tail cg (al-elem [Expr] body (primitive/isub n 1)) function sig ret child))))))
                (EIf [cnd thn els]
                     (let [cv (emit-expr cg cnd scp)
                           c (tv-val cv)
                           cmp (LLVMBuildICmp b 33 c (cg-zero (LLVMTypeOf c)) (cg-bl cg "ifc"))
                           then-bb (cg-append cg function (cg-bl cg "then"))
                           else-bb (cg-append cg function (cg-bl cg "else"))]
                       (LLVMBuildCondBr b cmp then-bb else-bb)
                       (cg-pos cg then-bb)
                       (emit-tail cg thn function sig ret scp)
                       (cg-pos cg else-bb)
                       (emit-tail cg els function sig ret scp)))
                (ECall [func targs args]
                       (if (tail-call-ok cg func function)
                           (let [vals (emit-vals cg args scp)
                                 callee (cg-func cg func)
                                 cs
                                   (LLVMBuildCall2 b
                                                   (LLVMGlobalGetValueType callee)
                                                   callee
                                                   (carr a vals)
                                                   (primitive/cast i32 (al-len [(ptr i8)] vals))
                                                   (cg-call-name cg (LLVMGlobalGetValueType callee) "tailcall"))]
                             (LLVMSetInstructionCallConv cs (LLVMGetFunctionCallConv callee))
                             ; musttail (kind 2) guarantees TCO, but the x86-64 SysV backend cannot
                             ; tail-call a self-recursion whose return is a large aggregate: SysV
                             ; classifies it MEMORY and returns it via a hidden sret pointer, and LLVM
                             ; aborts codegen ("failed to perform tail call elimination on a call site
                             ; marked musttail"). AArch64 returns aggregates via x8 and tail-calls them
                             ; fine, so it keeps musttail. On x86, when the callee's LLVM return type is
                             ; a Struct (10) or Array (11), downgrade to `tail` (kind 1): a hint LLVM
                             ; applies where it can (scalar self-calls still get real TCO) and otherwise
                             ; degrades to a normal call. Scalar/pointer returns keep guaranteed musttail.
                             (let [rk (LLVMGetTypeKind (LLVMGetReturnType (LLVMGlobalGetValueType callee)))
                                   x86-agg
                                     (and (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 0)
                                          (or (primitive/icmp-eq (primitive/cast i64 rk) 10) (primitive/icmp-eq (primitive/cast i64 rk) 11)))]
                               (LLVMSetTailCallKind cs (if x86-agg 1 2)))
                             (if (ty-is-void ret) (do (LLVMBuildRetVoid b) 0) (do (LLVMBuildRet b cs) 0)))
                           (let [v (emit-expr cg e scp)] (when (not (cg-terminated cg)) (emit-c-return cg sig ret v)))))
                (EMatch [scrut arms] (emit-tail-match cg scrut arms function sig ret scp))
                (_ (let [v (emit-expr cg e scp)] (when (not (cg-terminated cg)) (emit-c-return cg sig ret v)))))))
(defn emit-tail-match [(cg (ptr Cg))
                       (scrut (ptr Expr))
                       (arms (ptr (ArrayList Arm)))
                       (function (ptr i8))
                       (sig (ptr CSig))
                       (ret (ptr Type))
                       (scp (ptr Scope))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        sv (emit-expr cg scrut scp)
        sumname (match-else (tv-ty sv) (TStruct [s] s) (_ (cg-bug-sl "codegen: match on non-sum")))
        ui (cg-sum-idx cg sumname)
        sp (al-elem [CgSum] (primitive/field cg sums) ui)
        sum-ty (primitive/load (primitive/field sp ty))
        tmp (cg-entry-alloca cg sum-ty (cg-bl cg "match.tmp"))]
    (LLVMBuildStore b (tv-val sv) tmp)
    (let [tagptr (LLVMBuildStructGEP2 b sum-ty tmp 0 (cg-bl cg "tag"))
          tag (LLVMBuildLoad2 b (cg-i32t cg) tagptr (cg-bl cg "tag"))
          payload (LLVMBuildStructGEP2 b sum-ty tmp 1 (cg-bl cg "payload"))
          narms (al-len [Arm] (primitive/load arms))
          (mut armbbs) (al-new [(ptr i8)] a)
          (mut k) 0]
      (loop (if (primitive/icmp-ge (primitive/load k) narms)
                (break)
                (do (al-push! (mut armbbs) (cg-append cg function (cg-bl cg "arm"))) (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
      (let [default (cg-append cg function (cg-bl cg "match.default"))
            (mut k2) 0
            sw (LLVMBuildSwitch b tag default (primitive/cast i32 narms))]
        (loop (if (primitive/icmp-ge (primitive/load k2) narms)
                  (break)
                  (do
                    (let [ap (al-elem [Arm] arms (primitive/load k2))
                          vidx (cg-variant-idx cg sp (primitive/load (primitive/field ap variant)))]
                      (LLVMAddCase sw (LLVMConstInt (cg-i32t cg) vidx 0) (al-get [(ptr i8)] (primitive/load armbbs) (primitive/load k2))))
                    (primitive/store! k2 (primitive/iadd (primitive/load k2) 1)))))
        (cg-pos cg default)
        (LLVMBuildUnreachable b)
        (let [(mut k3) 0]
          (loop (if (primitive/icmp-ge (primitive/load k3) narms)
                    (break)
                    (do
                      (cg-pos cg (al-get [(ptr i8)] (primitive/load armbbs) (primitive/load k3)))
                      (let [ap (al-elem [Arm] arms (primitive/load k3))
                            vidx (cg-variant-idx cg sp (primitive/load (primitive/field ap variant)))
                            var-struct (al-get [(ptr i8)] (primitive/load (primitive/field sp vstructs)) vidx)
                            vp (al-elem [Variant] (primitive/load (primitive/field sp variants)) vidx)
                            vfs (primitive/load (primitive/field vp fields))
                            binds (primitive/load (primitive/field ap binds))
                            nb (al-len [(slice u8)] (primitive/load binds))
                            (mut child) scp
                            (mut j) 0]
                        (loop (if (primitive/icmp-ge (primitive/load j) nb)
                                  (break)
                                  (do
                                    (let [fptr
                                            (LLVMBuildStructGEP2 b
                                                                 var-struct
                                                                 payload
                                                                 (primitive/cast i32 (primitive/load j))
                                                                 (cg-bl cg "vf"))
                                          fty (primitive/load (primitive/field (al-elem [Field] vfs (primitive/load j)) ty))
                                          bname (al-get [(slice u8)] (primitive/load binds) (primitive/load j))
                                          fval
                                            (LLVMBuildLoad2 b (basic-ty cg (box-type a fty)) fptr (slice->cstr a bname))]
                                      (primitive/store! child (scope-put a (primitive/load child) bname fval fty)))
                                    (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                        (emit-tail cg (primitive/field ap body) function sig ret (primitive/load child)))
                      (primitive/store! k3 (primitive/iadd (primitive/load k3) 1)))))
          0)))))

(defn emit-func [(cg (ptr Cg)) (f (ptr Func)) (function (ptr i8))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        entry (cg-append cg function (cg-bl cg "entry"))
        sig (cg-csig cg (primitive/load (primitive/field f name)))
        base (when (and (primitive/icmp-ne (primitive/cast i64 sig) 0) (primitive/icmp-ne (primitive/cast i64 (primitive/load (primitive/field sig sret))) 0)) 1)]
    (cg-pos cg entry)
    (let [params (primitive/load (primitive/field f params))
          np (al-len [Param] (primitive/load params))
          (mut scp) (scope-nil a)
          (mut idx) base
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) np)
                (break)
                (do
                  (let [pp (al-elem [Param] params (primitive/load i))
                        pname (primitive/load (primitive/field pp name))
                        pty (primitive/load (primitive/field pp ty))
                        aa (if (primitive/icmp-ne (primitive/cast i64 sig) 0) (cg-argabi sig (primitive/load i)) (AAScalar))]
                    (match aa
                      (AADirect [sa]
                                (let [slot (cg-struct-slot cg sa (sconcat a pname ".arg"))]
                                  (match-else (primitive/load (primitive/field sa arg))
                                              (ACDirect [slots]
                                                        (let [ns (al-len [(ptr i8)] (primitive/load slots))
                                                              (mut k) 0]
                                                          (loop (if (primitive/icmp-ge (primitive/load k) ns)
                                                                    (break)
                                                                    (do
                                                                      (let [v
                                                                              (LLVMGetParam function
                                                                                            (primitive/cast i32 (primitive/load idx)))
                                                                            off (primitive/imul (primitive/load k) 8)
                                                                            gep
                                                                              (if (primitive/icmp-eq off 0)
                                                                                  slot
                                                                                  (cg-gep-i8 cg slot off))]
                                                                        (LLVMBuildStore b v gep)
                                                                        (primitive/store! idx (primitive/iadd (primitive/load idx) 1)))
                                                                      (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                                                          0))
                                              (_ 0))
                                  (primitive/store! scp
                                          (scope-put a
                                                     (primitive/load scp)
                                                     pname
                                                     (LLVMBuildLoad2 b
                                                                     (primitive/load (primitive/field sa llvm_ty))
                                                                     slot
                                                                     (slice->cstr a pname))
                                                     pty))))
                      (AAIndirect [sa]
                                  (let [ptr (LLVMGetParam function (primitive/cast i32 (primitive/load idx)))
                                        val (LLVMBuildLoad2 b (primitive/load (primitive/field sa llvm_ty)) ptr (slice->cstr a pname))]
                                    (primitive/store! idx (primitive/iadd (primitive/load idx) 1))
                                    (primitive/store! scp (scope-put a (primitive/load scp) pname val pty))))
                      (AAScalar []
                                (let [v (LLVMGetParam function (primitive/cast i32 (primitive/load idx)))]
                                  (LLVMSetValueName2 v (slice->cstr a pname) (slice-len pname))
                                  (primitive/store! idx (primitive/iadd (primitive/load idx) 1))
                                  (primitive/store! scp (scope-put a (primitive/load scp) pname v pty))))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (let [body (primitive/load (primitive/field f body))
            nb (al-len [Expr] (primitive/load body))]
        (if (primitive/icmp-eq nb 0)
            (when (not (cg-terminated cg)) (emit-c-return cg sig (primitive/field f ret) (mk-tv (cg-zero-i64 cg) (TInt 64 true))))
            (let [(mut j) 0]
              (loop (if (or (primitive/icmp-ge (primitive/load j) (primitive/isub nb 1)) (cg-terminated cg))
                        (break)
                        (do (emit-expr cg (al-elem [Expr] body (primitive/load j)) (primitive/load scp)) (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
              (when (not (cg-terminated cg))
                    (emit-tail cg (al-elem [Expr] body (primitive/isub nb 1)) function sig (primitive/field f ret) (primitive/load scp))))))))
  0)

; ======================== the module driver (compile_for_dbg, dbg=None) ======
; `triple-override` = a NUL-terminated triple cstr to cross-compile for, or null to
; use the host default.
(defn codegen-module [(a (ptr Allocator)) (p (ptr Program)) (triple-override (ptr i8))] (-> (ptr i8))
  (let [ctx (LLVMContextCreate)]
    ; init targets so an arbitrary (possibly non-host) triple resolves.
    (LLVMInitializeAArch64TargetInfo)
    (LLVMInitializeAArch64Target)
    (LLVMInitializeAArch64TargetMC)
    (LLVMInitializeX86TargetInfo)
    (LLVMInitializeX86Target)
    (LLVMInitializeX86TargetMC)
    (LLVMInitializeWebAssemblyTargetInfo)
    (LLVMInitializeWebAssemblyTarget)
    (LLVMInitializeWebAssemblyTargetMC)
    (let [triple (if (primitive/icmp-ne (primitive/cast i64 triple-override) 0) triple-override (LLVMGetDefaultTargetTriple))
          targetout (alloc/stack (ptr i8))
          errout (alloc/stack (ptr i8))]
      ; LLVMGetTargetFromTriple RETURNS a status and writes an error string; discarding
      ; both left `targetout` garbage and segfaulted LLVMCreateTargetMachine on it, so a
      ; bogus --target crashed the compiler instead of naming the triple. LLVM already
      ; wrote a perfectly good explanation into errout — print it.
      (when (primitive/icmp-ne (LLVMGetTargetFromTriple triple targetout errout) 0)
            (let [w (stderr)]
              (ps w "error: unsupported --target '")
              (ps w (cstr->slice triple))
              (ps w "': ")
              (ps w (cstr->slice (primitive/load errout)))
              (wb w 10)
              (exit 1)
              0))
      (let [tm (LLVMCreateTargetMachine (primitive/load targetout) triple c"generic" (llvm-cpu-features triple) 2 2 0)
            td (LLVMCreateTargetDataLayout tm)
            dl (LLVMCopyStringRepOfTargetData td)
            module (LLVMModuleCreateWithNameInContext c"coil" ctx)
            builder (LLVMCreateBuilderInContext ctx)
            cgp (alloc/stack Cg)]
        (LLVMSetTarget module triple)
        (LLVMSetDataLayout module dl)
        (primitive/store! (primitive/field cgp ctx) ctx)
        (primitive/store! (primitive/field cgp module) module)
        (primitive/store! (primitive/field cgp builder) builder)
        (primitive/store! (primitive/field cgp td) td)
        (primitive/store! (primitive/field cgp structs) (al-new [CgStruct] a))
        (primitive/store! (primitive/field cgp sums) (al-new [CgSum] a))
        (primitive/store! (primitive/field cgp funcs) (al-new [CgFunc] a))
        (primitive/store! (primitive/field cgp rets) (al-new [CgRet] a))
        (primitive/store! (primitive/field cgp sigs) (al-new [CgSig] a))
        (primitive/store! (primitive/field cgp statics) (al-new [CgStatic] a))
        (primitive/store! (primitive/field cgp shims) (al-new [CgShim] a))
        (primitive/store! (primitive/field cgp globals) 0)
        (primitive/store! (primitive/field cgp llvm_seq) 0)
        (primitive/store! (primitive/field cgp loops) (al-new [CgLoop] a))
        (primitive/store! (primitive/field cgp csigs) (al-new [CSigEntry] a))
        (primitive/store! (primitive/field cgp arch) (arch-from-triple (cstr->slice triple)))
        (primitive/store! (primitive/field cgp mach_o) (triple-mach-o (cstr->slice triple)))
        (primitive/store! (primitive/field cgp a) a)
        (primitive/store! (primitive/field cgp layouts) (LayoutDb::new a p "codegen"))
        (cg-register-types cgp p)
        (cg-eval-asserts cgp p)
        (cg-declare-externs cgp p)
        (cg-declare-funcs cgp p)
        (cg-emit-bodies cgp p)
        (cg-emit-thunks cgp p)
        module))))

; 0a-0d: two-phase type registration.
(defn cg-register-types [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [ctx (cg-ctx cg)
        ss (primitive/load (primitive/field p structs))
        ns (al-len [StructDef] (primitive/load ss))
        us (primitive/load (primitive/field p sums))
        nu (al-len [SumDef] (primitive/load us))
        (mut i) 0]
    ; 0a. opaque struct names.
    (loop (if (primitive/icmp-ge (primitive/load i) ns)
              (break)
              (do
                (let [sd (al-elem [StructDef] ss (primitive/load i))
                      nm (primitive/load (primitive/field sd name))
                      ty (LLVMStructCreateNamed ctx (slice->cstr (primitive/load (primitive/field cg a)) nm))
                      cs (alloc/stack CgStruct)]
                  (primitive/store! (primitive/field cs name) nm)
                  (primitive/store! (primitive/field cs fields) (primitive/load (primitive/field sd fields)))
                  (primitive/store! (primitive/field cs ty) ty)
                  (primitive/store! (primitive/field cs layout) (primitive/load (primitive/field sd layout)))
                  (al-push! (mut (primitive/field cg structs)) (primitive/load cs)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    ; 0a2. register ALL sum names (opaque) + their variants FIRST, so type sizing
    ;      (sum_words) can size a sum that references a not-yet-bodied sum/struct —
    ;      Sizing comes from the whole-program def maps, independent of build order.
    (primitive/store! i 0)
    (loop (if (primitive/icmp-ge (primitive/load i) nu)
              (break)
              (do
                (let [sd (al-elem [SumDef] us (primitive/load i))
                      nm (primitive/load (primitive/field sd name))
                      ty (LLVMStructCreateNamed ctx (slice->cstr (primitive/load (primitive/field cg a)) nm))
                      cs (alloc/stack CgSum)]
                  (primitive/store! (primitive/field cs name) nm)
                  (primitive/store! (primitive/field cs variants) (primitive/load (primitive/field sd variants)))
                  (primitive/store! (primitive/field cs ty) ty)
                  (primitive/store! (primitive/field cs vstructs)
                          (let [bp
                                  (unwrap-ptr [(ArrayList (ptr i8))]
                                              (create [(ArrayList (ptr i8))] (primitive/load (primitive/field cg a))))]
                            (primitive/store! bp (al-new [(ptr i8)] (primitive/load (primitive/field cg a))))
                            bp))
                  (al-push! (mut (primitive/field cg sums)) (primitive/load cs)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    ; 0b. set each sum's body { i32 tag, [words x i64] payload }.
    (primitive/store! i 0)
    (loop (if (primitive/icmp-ge (primitive/load i) nu)
              (break)
              (do
                (let [sd (al-elem [SumDef] us (primitive/load i))
                      words (cg-sum-words-def cg sd)
                      payload (LLVMArrayType2 (cg-i64t cg) words)
                      ty (primitive/load (primitive/field (al-elem [CgSum] (primitive/field cg sums) (cg-sum-idx cg (primitive/load (primitive/field sd name)))) ty))
                      (mut bs) (al-new [(ptr i8)] (primitive/load (primitive/field cg a)))]
                  (al-push! (mut bs) (cg-i32t cg))
                  (al-push! (mut bs) payload)
                  (LLVMStructSetBody ty (carr (primitive/load (primitive/field cg a)) (primitive/load bs)) 2 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    ; 0c. struct bodies.
    (primitive/store! i 0)
    (loop (if (primitive/icmp-ge (primitive/load i) ns)
              (break)
              (do
                (cg-set-struct-body cg (al-elem [StructDef] ss (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    ; LLVM IR has no type-level over-alignment. Once every named body exists,
    ; finalize them in dependency order and append tail padding until LLVM's
    ; by-value size/array stride matches LayoutDb. Allocation sites separately
    ; carry the database alignment via cg-force-align.
    (cg-finalize-struct-layouts! cg p)
    ; 0d. per-variant field structs.
    (primitive/store! i 0)
    (loop (if (primitive/icmp-ge (primitive/load i) nu)
              (break)
              (do
                (cg-fill-variant-structs cg (al-elem [SumDef] us (primitive/load i)) (primitive/load i))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))

(defn cg-finalize-struct-layouts! [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        ctx (cg-ctx cg)
        ss (primitive/load (primitive/field p structs))
        n (al-len [StructDef] (primitive/load ss))
        (mut done) (al-new [i64] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut done) 0) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (let [(mut pass) 0]
      (loop (if (primitive/icmp-ge (primitive/load pass) (primitive/iadd n 1))
                (break)
                (do
                  (let [(mut si) 0]
                    (loop (if (primitive/icmp-ge (primitive/load si) n)
                              (break)
                              (do
                                (when (and (primitive/icmp-eq (al-get [i64] (primitive/load done) (primitive/load si)) 0)
                                           (struct-ready? (primitive/field cg layouts) (primitive/load si) (mut done)))
                                  (let [sd (al-elem [StructDef] ss (primitive/load si))
                                        sp (al-elem [CgStruct] (primitive/field cg structs) (primitive/load si))]
                                    (match-else (primitive/load (primitive/field sd layout))
                                                (LBits [_ _] 0)
                                                (LExplicit [_ _ _] 0)
                                                (_ (let [fs (primitive/load (primitive/field sd fields))
                                                        nf (al-len [Field] (primitive/load fs))
                                                        (mut bs) (al-new [(ptr i8)] a)
                                                        (mut fi) 0
                                                        packed (match-else (primitive/load (primitive/field sd layout)) (LPacked [] 1) (_ 0))]
                                                     (loop (if (primitive/icmp-ge (primitive/load fi) nf)
                                                               (break)
                                                               (do
                                                                 (al-push! (mut bs)
                                                                           (basic-ty cg (primitive/field (al-elem [Field] fs (primitive/load fi)) ty)))
                                                                 (primitive/store! fi (primitive/iadd (primitive/load fi) 1)))))
                                                     (LLVMStructSetBody (primitive/load (primitive/field sp ty))
                                                                        (carr a (primitive/load bs))
                                                                        (primitive/cast i32 nf)
                                                                        (primitive/cast i32 packed))
                                                     (let [actual (LLVMABISizeOfType (primitive/load (primitive/field cg td)) (primitive/load (primitive/field sp ty)))
                                                           want (primitive/load (primitive/field (struct-at (primitive/field cg layouts) (primitive/load si)) size))]
                                                       (when (primitive/icmp-gt actual want)
                                                             (cg-fail "LLVM struct layout exceeds LayoutDb size"))
                                                       (when (primitive/icmp-lt actual want)
                                                             (do
                                                               (al-push! (mut bs)
                                                                         (LLVMArrayType2 (LLVMInt8TypeInContext ctx)
                                                                                         (primitive/isub want actual)))
                                                               (LLVMStructSetBody (primitive/load (primitive/field sp ty))
                                                                                  (carr a (primitive/load bs))
                                                                                  (primitive/cast i32 (al-len [(ptr i8)] (primitive/load bs)))
                                                                                  (primitive/cast i32 packed))
                                                               0))))))
                                    (al-set! (mut done) (primitive/load si) 1)))
                                (primitive/store! si (primitive/iadd (primitive/load si) 1))))))
                  (primitive/store! pass (primitive/iadd (primitive/load pass) 1))))))
    0))
(defn cg-set-struct-body [(cg (ptr Cg)) (sd (ptr StructDef))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        ctx (cg-ctx cg)
        si (cg-struct-idx cg (primitive/load (primitive/field sd name)))
        sp (al-elem [CgStruct] (primitive/field cg structs) si)
        ty (primitive/load (primitive/field sp ty))
        fs (primitive/load (primitive/field sd fields))
        nf (al-len [Field] (primitive/load fs))]
    (match-else (primitive/load (primitive/field sd layout))
                (LBits [backing offs]
                       (let [(mut bs) (al-new [(ptr i8)] a)]
                         (al-push! (mut bs) (int-width ctx backing))
                         (LLVMStructSetBody ty (carr a (primitive/load bs)) 1 0)
                         0))
                (LExplicit [offs sz al]
                           (let [(mut computed) 0
                                 (mut sizes) (al-new [i64] a)
                                 (mut i) 0]
                             ; Gather each field's ABI size, track the minimum total, and — when the
                             ; struct declares an explicit :size — reject any field that spills past it
                             ; (LAYOUT.md's "each field fits within :size"). Same error surface as a
                             ; failed static-assert: a plain `error: …` on stderr + exit(1), no object.
                             (loop (if (primitive/icmp-ge (primitive/load i) nf)
                                       (break)
                                       (do
                                         (let [off (al-get [i64] (primitive/load offs) (primitive/load i))
                                               fsz
                                                 (LLVMABISizeOfType (primitive/load (primitive/field cg td))
                                                                    (basic-ty cg
                                                                              (primitive/field (al-elem [Field] fs (primitive/load i)) ty)))
                                               end (primitive/iadd off fsz)]
                                           (al-push! (mut sizes) fsz)
                                           (match sz
                                             (Some [s]
                                                   (when (primitive/icmp-gt end s)
                                                         (cg-fail (sconcat3 a
                                                                            "defstruct '"
                                                                            (primitive/load (primitive/field sd name))
                                                                            (sconcat3 a
                                                                                      "': field '"
                                                                                      (primitive/load (primitive/field (al-elem [Field]
                                                                                                            fs
                                                                                                            (primitive/load i))
                                                                                                   name))
                                                                                      (sconcat3 a
                                                                                                "' at :at "
                                                                                                (i64->str a off)
                                                                                                (sconcat3 a
                                                                                                          " occupies "
                                                                                                          (i64->str a fsz)
                                                                                                          (sconcat3 a
                                                                                                                    " byte(s), past the declared :size "
                                                                                                                    (i64->str a
                                                                                                                              s)
                                                                                                                    ""))))))))
                                             (None [] 0))
                                           (when (primitive/icmp-gt end (primitive/load computed)) (primitive/store! computed end)))
                                         (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                             ; Overlap at UNEQUAL :at is an error (equal :at is an intentional union);
                             ; name both colliding fields.
                             (let [(mut p) 0]
                               (loop (if (primitive/icmp-ge (primitive/load p) nf)
                                         (break)
                                         (do
                                           (let [(mut q) (primitive/iadd (primitive/load p) 1)]
                                             (loop (if (primitive/icmp-ge (primitive/load q) nf)
                                                       (break)
                                                       (do
                                                         (let [op (al-get [i64] (primitive/load offs) (primitive/load p))
                                                               oq (al-get [i64] (primitive/load offs) (primitive/load q))
                                                               ep (primitive/iadd op (al-get [i64] (primitive/load sizes) (primitive/load p)))
                                                               eq (primitive/iadd oq (al-get [i64] (primitive/load sizes) (primitive/load q)))]
                                                           (when (and (primitive/icmp-ne op oq)
                                                                      (and (primitive/icmp-lt op eq) (primitive/icmp-lt oq ep)))
                                                                 (cg-fail (sconcat3 a
                                                                                    "defstruct '"
                                                                                    (primitive/load (primitive/field sd name))
                                                                                    (sconcat3 a
                                                                                              "': fields '"
                                                                                              (primitive/load (primitive/field (al-elem [Field]
                                                                                                                    fs
                                                                                                                    (primitive/load p))
                                                                                                           name))
                                                                                              (sconcat3 a
                                                                                                        "' (:at "
                                                                                                        (i64->str a op)
                                                                                                        (sconcat3 a
                                                                                                                  ") and '"
                                                                                                                  (primitive/load (primitive/field (al-elem [Field]
                                                                                                                                        fs
                                                                                                                                        (primitive/load q))
                                                                                                                               name))
                                                                                                                  (sconcat3 a
                                                                                                                            "' (:at "
                                                                                                                            (i64->str a
                                                                                                                                      oq)
                                                                                                                            ") overlap at unequal offsets (equal :at = union)"))))))))
                                                         (primitive/store! q (primitive/iadd (primitive/load q) 1))))))
                                           (primitive/store! p (primitive/iadd (primitive/load p) 1))))))
                             (let [size
                                     (match sz
                                       (Some [s] (if (primitive/icmp-gt s (primitive/load computed)) s (primitive/load computed)))
                                       (None [] (primitive/load computed)))
                                   (mut bs) (al-new [(ptr i8)] a)]
                               (al-push! (mut bs) (LLVMArrayType2 (LLVMInt8TypeInContext ctx) size))
                               (LLVMStructSetBody ty (carr a (primitive/load bs)) 1 1)
                               0)))
                (_ (let [(mut bs) (al-new [(ptr i8)] a)
                         (mut i) 0
                         packed (match-else (primitive/load (primitive/field sd layout)) (LPacked [] 1) (_ 0))]
                     (loop (if (primitive/icmp-ge (primitive/load i) nf)
                               (break)
                               (do
                                 (al-push! (mut bs) (basic-ty cg (primitive/field (al-elem [Field] fs (primitive/load i)) ty)))
                                 (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                     (LLVMStructSetBody ty (carr a (primitive/load bs)) (primitive/cast i32 nf) (primitive/cast i32 packed))
                     0)))))
(defn cg-fill-variant-structs [(cg (ptr Cg)) (sd (ptr SumDef)) (ui i64)] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        ctx (cg-ctx cg)
        sp (al-elem [CgSum] (primitive/field cg sums) (cg-sum-idx cg (primitive/load (primitive/field sd name))))
        vs (primitive/load (primitive/field sd variants))
        nv (al-len [Variant] (primitive/load vs))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) nv)
              (break)
              (do
                (let [vp (al-elem [Variant] vs (primitive/load i))
                      fs (primitive/load (primitive/field vp fields))
                      nf (al-len [Field] (primitive/load fs))
                      (mut bs) (al-new [(ptr i8)] a)
                      (mut j) 0]
                  (loop (if (primitive/icmp-ge (primitive/load j) nf)
                            (break)
                            (do
                              (al-push! (mut bs) (basic-ty cg (primitive/field (al-elem [Field] fs (primitive/load j)) ty)))
                              (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                  (al-push! (mut (primitive/load (primitive/field sp vstructs)))
                            (LLVMStructTypeInContext ctx (carr a (primitive/load bs)) (primitive/cast i32 nf) 0)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))

; 0e: static asserts.
(defn cg-eval-asserts [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [as (primitive/load (primitive/field p asserts))
        n (al-len [StaticAssert] (primitive/load as))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ap (al-elem [StaticAssert] as (primitive/load i))]
                  ; Mirror: a failed static-assert is
                  ; `Err("static assertion failed: {msg}")`, which `report`
                  ; renders as `error: static assertion failed: <msg>` and exits nonzero.
                  ; The message is spanless (a plain codegen string error), so it renders
                  ; like any other spanless Diag: bare `error: <msg>`. Codegen has no
                  ; Result channel here, so print the rendered line and exit(1) — the
                  ; observable behavior (stderr text + exit code, no object/link) is
                  ; byte-identical to the front-end returning the Err.
                  (when (primitive/icmp-eq (const-eval cg (primitive/field ap cnd)) 0)
                        (let [w (stderr)
                              msg (sconcat (primitive/load (primitive/field cg a)) "static assertion failed: " (primitive/load (primitive/field ap msg)))]
                          (ps w "error: ")
                          (ps w msg)
                          (wb w 10)
                          (exit 1)
                          0)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))

; helper: store a (name -> Type) into a CgRet list and (name cc params ret) into sigs.
(defn cg-record-callable [(cg (ptr Cg)) (name (slice u8)) (cc (slice u8)) (params (ptr (ArrayList Type))) (ret Type)] (-> i64)
  (let [r (alloc/stack CgRet)]
    (primitive/store! (primitive/field r name) name)
    (primitive/store! (primitive/field r ty) ret)
    (al-push! (mut (primitive/field cg rets)) (primitive/load r)))
  (let [s (alloc/stack CgSig)]
    (primitive/store! (primitive/field s name) name)
    (primitive/store! (primitive/field s cc) cc)
    (primitive/store! (primitive/field s params) params)
    (primitive/store! (primitive/field s ret) ret)
    (al-push! (mut (primitive/field cg sigs)) (primitive/load s)))
  0)
(defn cg-add-func [(cg (ptr Cg)) (name (slice u8)) (fv (ptr i8))] (-> i64)
  (let [r (alloc/stack CgFunc)]
    (primitive/store! (primitive/field r name) name)
    (primitive/store! (primitive/field r val) fv)
    (al-push! (mut (primitive/field cg funcs)) (primitive/load r)))
  0)

; `last-component` moved to check.coil (a pure path/string helper used by both
; check and codegen); codegen imports check, so it resolves here unchanged. This
; keeps check.coil free of any codegen (LLVM) dependency so the frontend can be
; built into an LLVM-free (arm64-only) compiler. See src/compiler/main_a64.coil.
(defn ty-list-has-struct [(cg (ptr Cg)) (l (ptr (ArrayList Type)))] (-> bool)
  (let [n (al-len [Type] (primitive/load l))
        (mut i) 0
        (mut r) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (cg-abi-struct? cg (al-elem [Type] l (primitive/load i))) (primitive/store! r true) 0)
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn cg-abi-struct? [(cg (ptr Cg)) (t (ptr Type))] (-> bool)
  (match-else (primitive/load t)
              (TStruct [nm]
                       (let [si (cg-struct-idx cg nm)]
                         (if (primitive/icmp-lt si 0)
                             false
                             (match-else (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) si) layout))
                                         (LBits [b o] false)
                                         (_ true)))))
              (_ false)))

; ============================ C-ABI struct classification ====================
; Faithful (AArch64 AAPCS64 path) + the codegen ABI helpers.
; The x86_64 SysV path is a hard-error stub (the self-host targets AArch64).

; arch from a triple's first '-'-separated component.
(defn arch-from-triple [(triple (slice u8))] (-> i64)
  (let [n (slice-len triple)
        (mut i) 0]
    (loop (if (or (primitive/icmp-ge (primitive/load i) n) (primitive/icmp-eq (primitive/cast i64 (slice-get triple (primitive/load i))) 45))
              (break)
              (primitive/store! i (primitive/iadd (primitive/load i) 1))))
    (let [a0 (substr triple 0 (primitive/load i))]
      (cond (or (str-eq a0 "x86_64") (str-eq a0 "amd64")) 0
            (or (str-eq a0 "aarch64") (or (str-eq a0 "arm64") (str-eq a0 "arm64e"))) 1
            (or (str-eq a0 "wasm32") (str-eq a0 "wasm64")) 2
            :else  ; wasm ABI class is width-agnostic; word width comes from the triple's datalayout
              (do (unimplemented "abi: unsupported target architecture") -1)))))

; LLVM subtarget-feature string for a triple's TargetMachine, as a C string for
; LLVMCreateTargetMachine's `Features` arg. wasm64's 64-bit memory is IMPLIED by the
; triple's datalayout (there is no `+memory64` subtarget feature in LLVM), so the only
; wasm feature we opt into is `+tail-call` (Wasm 3.0 tail calls — LLVM lowers `musttail`
; to `return_call`). Everything else takes LLVM's defaults (empty features).
(defn llvm-cpu-features [(triple (ptr i8))] (-> (ptr i8))
  c"")  ; TODO(wasm 3.0): +tail-call once memory64 lands + verified

; smallest power-of-two-byte int width (bits) covering `bytes` data bytes.
(defn abi-int-bits-for-bytes [(bytes i64)] (-> i64)
  (cond (primitive/icmp-le bytes 1) 8 (primitive/icmp-eq bytes 2) 16 (primitive/icmp-le bytes 4) 32 :else 64))

; abi_struct: CgStruct index of a non-bits by-value struct type, else -1.
(defn cg-abi-struct-cs [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match-else (primitive/load t)
              (TStruct [nm]
                       (let [si (cg-struct-idx cg nm)]
                         (if (primitive/icmp-lt si 0)
                             -1
                             (match-else (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) si) layout))
                                         (LBits [b o] -1)
                                         (_ si)))))
              (_ -1)))

; resolve_struct: the field list of a named struct (null if not a struct).
(defn cg-resolve-fields [(cg (ptr Cg)) (name (slice u8))] (-> (ptr (ArrayList Field)))
  (let [si (cg-struct-idx cg name)]
    (if (primitive/icmp-lt si 0)
        (primitive/cast (ptr (ArrayList Field)) 0)
        (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) si) fields)))))

; ---- HFA detection (faithful; never fires in the corpus = no float-only structs)
(defn abi-hfa-walk-ty [(cg (ptr Cg)) (ty (ptr Type)) (found (ptr (Option Type))) (count (ptr i64))] (-> bool)
  (let [a (primitive/load (primitive/field cg a))]
    (match-else (primitive/load ty)
                (TFloat [b]
                        (let [(mut ok) true]
                          (match (primitive/load found)
                            (None [] (do (primitive/store! found (Some (primitive/load ty))) 0))
                            (Some [prev] (unless (type-eq (box-type a prev) ty) (primitive/store! ok false) 0)))
                          (primitive/store! count (primitive/iadd (primitive/load count) 1))
                          (and (primitive/load ok) (primitive/icmp-le (primitive/load count) 4))))
                (TArray [elem n]
                        (let [(mut ok) true
                              (mut i) 0]
                          (loop (if (or (primitive/icmp-ge (primitive/load i) n) (not (primitive/load ok)))
                                    (break)
                                    (do
                                      (when (not (abi-hfa-walk-ty cg elem found count)) (primitive/store! ok false) 0)
                                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                          (primitive/load ok)))
                (TStruct [nm]
                         (let [fs (cg-resolve-fields cg nm)]
                           (if (primitive/icmp-eq (primitive/cast i64 fs) 0) false (abi-hfa-walk-fields cg fs found count))))
                (_ false))))
(defn abi-hfa-walk-fields [(cg (ptr Cg)) (fields (ptr (ArrayList Field))) (found (ptr (Option Type))) (count (ptr i64))] (-> bool)
  (let [n (al-len [Field] (primitive/load fields))
        (mut ok) true
        (mut i) 0]
    (loop (if (or (primitive/icmp-ge (primitive/load i) n) (not (primitive/load ok)))
              (break)
              (do
                (when (not (abi-hfa-walk-ty cg (primitive/field (al-elem [Field] fields (primitive/load i)) ty) found count))
                      (primitive/store! ok false)
                      0)
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load ok)))
; returns the HFA member count (0 if not an HFA); writes the FP element type to out-fty.
(defn abi-hfa [(cg (ptr Cg)) (fields (ptr (ArrayList Field))) (out-fty (ptr Type))] (-> i64)
  (let [found (alloc/stack (Option Type))
        count (alloc/stack i64)]
    (primitive/store! found (None [Type]))
    (primitive/store! count 0)
    (unless (not (abi-hfa-walk-fields cg fields found count))
            (match (primitive/load found)
              (None [] 0)
              (Some [t]
                    (when (and (primitive/icmp-ge (primitive/load count) 1) (primitive/icmp-le (primitive/load count) 4)) (primitive/store! out-fty t) (primitive/load count)))))))

; a one-element slot list (the AArch64 coercion is always a single slot).
(defn abi-slots1 [(cg (ptr Cg)) (t (ptr i8))] (-> (ptr (ArrayList (ptr i8))))
  (let [a (primitive/load (primitive/field cg a))
        (mut xs) (al-new [(ptr i8)] a)]
    (al-push! (mut xs) t)
    (box-al [(ptr i8)] a (primitive/load xs))))

; ---- SysV AMD64: the byte-class flatten + eightbyte-coercion ----
; SysV "merge" rule for two classes covering the same byte: INTEGER dominates SSE,
; SSE dominates NONE (0=None 1=Integer 2=Sse).
(defn abi-merge [(x i64) (y i64)] (-> i64)
  (if (or (primitive/icmp-eq x 1) (primitive/icmp-eq y 1))
      1
      (when (or (primitive/icmp-eq x 2) (primitive/icmp-eq y 2)) 2)))
(defn abi-align-up [(x i64) (al i64)] (-> i64)
  (if (primitive/icmp-eq al 0) x (primitive/imul (primitive/udiv (primitive/iadd x (primitive/isub al 1)) al) al)))
; Flatten CgStruct `si`'s fields into scalar leaves at absolute byte offsets,
; recursing into nested structs and arrays. Offsets come from
; the struct's REAL LayoutDb offsets — never LLVM's natural offsets, which cannot
; express Coil's explicit/packed/over-aligned nesting contract.
(defn abi-flatten-cs [(cg (ptr Cg)) (si i64) (base i64) (out (ptr AbiLeafBox))] (-> i64)
  (let [td (primitive/load (primitive/field cg td))
        sp (al-elem [CgStruct] (primitive/field cg structs) si)
        fs (primitive/load (primitive/field sp fields))
        n (al-len [Field] (primitive/load fs))
        (mut i) 0]
    (match-else (primitive/load (primitive/field sp layout))
                (LBits [backing offs]
                       ; bits struct: one integer backing word (unreachable via cg-abi-struct-cs,
                       ; which reports bits structs as scalars — kept total for direct callers).
                       (let [lf (alloc/stack AbiLeaf)]
                         (primitive/store! (primitive/field lf offset) base)
                         (primitive/store! (primitive/field lf size) (primitive/udiv backing 8))
                         (primitive/store! (primitive/field lf cls) 1)
                         (primitive/store! (primitive/field lf is_f32) false)
                         (al-push! (mut (primitive/field out items)) (primitive/load lf))
                         0))
                (LExplicit [offs sz al]
                           (do
                             (loop (if (primitive/icmp-ge (primitive/load i) n)
                                       (break)
                                       (do
                                         (abi-flatten-type cg
                                                           (primitive/field (al-elem [Field] fs (primitive/load i)) ty)
                                                           (primitive/iadd base (al-get [i64] (primitive/load offs) (primitive/load i)))
                                                           out)
                                         (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                             0))
                (_ (do
                     (loop (if (primitive/icmp-ge (primitive/load i) n)
                               (break)
                               (do
                                 (abi-flatten-type cg
                                                   (primitive/field (al-elem [Field] fs (primitive/load i)) ty)
                                                   (primitive/iadd base (field-offset (primitive/field cg layouts) si (primitive/load i)))
                                                   out)
                                 (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                     0)))))
(defn abi-flatten-type [(cg (ptr Cg)) (ty (ptr Type)) (offset i64) (out (ptr AbiLeafBox))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        td (primitive/load (primitive/field cg td))]
    (match-else (primitive/load ty)
                (TFloat [bits]
                        (let [lf (alloc/stack AbiLeaf)]
                          (primitive/store! (primitive/field lf offset) offset)
                          (primitive/store! (primitive/field lf size) (primitive/udiv bits 8))
                          (primitive/store! (primitive/field lf cls) 2)
                          (primitive/store! (primitive/field lf is_f32) (primitive/icmp-eq bits 32))
                          (al-push! (mut (primitive/field out items)) (primitive/load lf))
                          0))
                (TArray [elem n]
                        (let [esz (LLVMABISizeOfType td (basic-ty cg elem))
                              (mut i) 0]
                          (loop (if (primitive/icmp-ge (primitive/load i) n)
                                    (break)
                                    (do
                                      (abi-flatten-type cg elem (primitive/iadd offset (primitive/imul (primitive/load i) esz)) out)
                                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                          0))
                (TStruct [nm]
                         (let [si (cg-struct-idx cg nm)]
                           (if (primitive/icmp-lt si 0)
                               (do (unimplemented "SysV ABI: nested type is not a classifiable struct") 0)
                               (abi-flatten-cs cg si offset out))))
                ; view/generic types have no C representation; the unreachable ones must NOT
                ; fall through to the Integer arm below.
                (TVec [el n]
                      (do
                        (unimplemented "SysV ABI: passing a vec by value across the C boundary is not supported yet")
                        0))
                (TSlice [el]
                        (do
                          (unimplemented "SysV ABI: passing a slice by value across the C boundary is not supported")
                          0))
                (TApp [nm args]
                      (do (unimplemented "SysV ABI: generic type survived to ABI classification (compiler bug)") 0))
                (TNever [] (do (unimplemented "SysV ABI: Never type has no ABI representation") 0))
                (TCode [] (do (unimplemented "SysV ABI: Code type has no ABI representation") 0))
                (TExternRef [] (do (unimplemented "SysV ABI: externref has no SysV representation") 0))
                (TVoid [] (do (unimplemented "SysV ABI: void is a return type only; never a field/by-value param") 0))
                ; Int, Bool, Ptr, Ref, Fn -> a single INTEGER leaf.
                (_ (let [lf (alloc/stack AbiLeaf)]
                     (primitive/store! (primitive/field lf offset) offset)
                     (primitive/store! (primitive/field lf size) (LLVMABISizeOfType td (basic-ty cg ty)))
                     (primitive/store! (primitive/field lf cls) 1)
                     (primitive/store! (primitive/field lf is_f32) false)
                     (al-push! (mut (primitive/field out items)) (primitive/load lf))
                     0)))))
; true if any leaf is a 32-bit float starting exactly at byte `off`.
(defn abi-leaves-has-f32-at [(leaves (ptr (ArrayList AbiLeaf))) (off i64)] (-> bool)
  (let [n (al-len [AbiLeaf] (primitive/load leaves))
        (mut i) 0
        (mut r) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [lf (al-elem [AbiLeaf] leaves (primitive/load i))]
                  (when (and (primitive/load (primitive/field lf is_f32)) (primitive/icmp-eq (primitive/load (primitive/field lf offset)) off)) (primitive/store! r true) 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn abi-classify-sysv [(cg (ptr Cg)) (si i64) (sty (ptr i8)) (size i64) (align i32)] (-> (ptr StructAbi))
  (let [a (primitive/load (primitive/field cg a))
        ctx (cg-ctx cg)
        p (unwrap-ptr [StructAbi] (create [StructAbi] a))]
    (primitive/store! (primitive/field p llvm_ty) sty)
    (primitive/store! (primitive/field p size) size)
    (primitive/store! (primitive/field p align) align)
    ; Structs larger than two eightbytes (16 bytes) are passed in memory.
    (if (primitive/icmp-gt size 16)
        (do (primitive/store! (primitive/field p arg) (ACIndirect align)) (primitive/store! (primitive/field p ret) (ACIndirect align)))
        (let [lb (unwrap-ptr [AbiLeafBox] (create [AbiLeafBox] a))]
          (primitive/store! (primitive/field lb items) (al-new [AbiLeaf] a))
          (abi-flatten-cs cg si 0 lb)
          (let [leaves (primitive/field lb items)
                nbytes size
                (mut bytes) (al-new [i64] a)
                (mut bi) 0]
            ; per-byte class array (None), then merge each leaf onto its byte range.
            (loop (if (primitive/icmp-ge (primitive/load bi) nbytes) (break) (do (al-push! (mut bytes) 0) (primitive/store! bi (primitive/iadd (primitive/load bi) 1)))))
            (let [nleaves (al-len [AbiLeaf] (primitive/load leaves))
                  (mut li) 0]
              (loop (if (primitive/icmp-ge (primitive/load li) nleaves)
                        (break)
                        (do
                          (let [lf (al-elem [AbiLeaf] leaves (primitive/load li))
                                lo (primitive/load (primitive/field lf offset))
                                hi (primitive/iadd (primitive/load (primitive/field lf offset)) (primitive/load (primitive/field lf size)))]
                            (when (primitive/icmp-gt hi nbytes) (unimplemented "SysV ABI: scalar runs past struct size") 0)
                            (let [(mut b) lo]
                              (loop (if (primitive/icmp-ge (primitive/load b) hi)
                                        (break)
                                        (do
                                          (al-set! [i64]
                                                   (mut bytes)
                                                   (primitive/load b)
                                                   (abi-merge (al-get [i64] (primitive/load bytes) (primitive/load b))
                                                              (primitive/load (primitive/field lf cls))))
                                          (primitive/store! b (primitive/iadd (primitive/load b) 1)))))))
                          (primitive/store! li (primitive/iadd (primitive/load li) 1)))))
              ; collapse into eightbyte coerced slots.
              (let [neb (primitive/udiv (primitive/iadd nbytes 7) 8)
                    (mut slots) (al-new [(ptr i8)] a)
                    (mut eb) 0]
                (loop (if (primitive/icmp-ge (primitive/load eb) neb)
                          (break)
                          (do
                            (let [lo (primitive/imul (primitive/load eb) 8)
                                  hi
                                    (if (primitive/icmp-lt (primitive/iadd (primitive/imul (primitive/load eb) 8) 8) nbytes) (primitive/iadd (primitive/imul (primitive/load eb) 8) 8) nbytes)
                                  (mut cls) 0
                                  (mut bb) 0]
                              (primitive/store! bb lo)
                              (loop (if (primitive/icmp-ge (primitive/load bb) hi)
                                        (break)
                                        (do
                                          (primitive/store! cls (abi-merge (primitive/load cls) (al-get [i64] (primitive/load bytes) (primitive/load bb))))
                                          (primitive/store! bb (primitive/iadd (primitive/load bb) 1)))))
                              (let [used (primitive/isub hi lo)
                                    slot
                                      (if (primitive/icmp-eq (primitive/load cls) 2)
                                          ; SSE eightbyte: two distinct low/high 4-byte floats -> <2 x float>;
                                          ; one double (or 5..8 SSE bytes) -> double; a single 4-byte float -> float.
                                          (if (and (primitive/icmp-eq used 8)
                                                   (and (abi-leaves-has-f32-at leaves lo)
                                                        (abi-leaves-has-f32-at leaves (primitive/iadd lo 4))))
                                              (LLVMVectorType (LLVMFloatTypeInContext ctx) 2)
                                              (if (primitive/icmp-gt used 4)
                                                  (LLVMDoubleTypeInContext ctx)
                                                  (LLVMFloatTypeInContext ctx)))
                                          ; INTEGER (or padding-only) eightbyte -> smallest pow2 int covering its data bytes.
                                          (int-width ctx (abi-int-bits-for-bytes used)))]
                                (al-push! (mut slots) slot)))
                            (primitive/store! eb (primitive/iadd (primitive/load eb) 1)))))
                ; SysV arg and ret coerce to the SAME slots.
                (let [sp (box-al [(ptr i8)] a (primitive/load slots))]
                  (primitive/store! (primitive/field p arg) (ACDirect sp))
                  (primitive/store! (primitive/field p ret) (ACDirect sp))))))))
    p))

; classify a struct for the C ABI (StructAbi by pointer). Takes the CgStruct INDEX
; so the SysV flatten can honor the struct's real layout (packed/explicit offsets).
(defn abi-classify [(cg (ptr Cg)) (si i64)] (-> (ptr StructAbi))
  (let [sp (al-elem [CgStruct] (primitive/field cg structs) si)
        sty (primitive/load (primitive/field sp ty))
        le (struct-at (primitive/field cg layouts) si)
        size (primitive/load (primitive/field le size))
        align (primitive/cast i32 (primitive/load (primitive/field le align)))]
    (if (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 1)
        (abi-classify-aapcs64 cg (primitive/load (primitive/field sp fields)) sty size align)
        (abi-classify-sysv cg si sty size align))))
(defn abi-classify-aapcs64 [(cg (ptr Cg)) (fields (ptr (ArrayList Field))) (sty (ptr i8)) (size i64) (align i32)] (-> (ptr StructAbi))
  (let [a (primitive/load (primitive/field cg a))
        ctx (cg-ctx cg)
        p (unwrap-ptr [StructAbi] (create [StructAbi] a))
        fty (alloc/stack Type)
        nhfa (abi-hfa cg fields fty)]
    (primitive/store! (primitive/field p llvm_ty) sty)
    (primitive/store! (primitive/field p size) size)
    (primitive/store! (primitive/field p align) align)
    (if (primitive/icmp-gt nhfa 0)
        (let [elem (basic-ty cg fty)
              arr (LLVMArrayType2 elem nhfa)]
          (primitive/store! (primitive/field p arg) (ACDirect (abi-slots1 cg arr)))
          (primitive/store! (primitive/field p ret) (ACDirect (abi-slots1 cg sty))))
        (if (primitive/icmp-gt size 16)
            (do (primitive/store! (primitive/field p arg) (ACIndirect align)) (primitive/store! (primitive/field p ret) (ACIndirect align)))
            (do
              (primitive/store! (primitive/field p arg)
                      (ACDirect (abi-slots1 cg (if (primitive/icmp-le size 8) (cg-i64t cg) (LLVMArrayType2 (cg-i64t cg) 2)))))
              (primitive/store! (primitive/field p ret)
                      (ACDirect (abi-slots1 cg
                                            (if (primitive/icmp-le size 8)
                                                (int-width ctx (abi-int-bits-for-bytes size))
                                                (LLVMArrayType2 (cg-i64t cg) 2))))))))
    p))

; the single LLVM type a Direct return coerces to.
(defn abi-direct-return-type [(cg (ptr Cg)) (sa (ptr StructAbi))] (-> (ptr i8))
  (match (primitive/load (primitive/field sa ret))
    (ACDirect [slots]
              (let [n (al-len [(ptr i8)] (primitive/load slots))]
                (if (primitive/icmp-eq n 1)
                    (al-get [(ptr i8)] (primitive/load slots) 0)
                    (if (primitive/icmp-eq n 2)
                        (let [a (primitive/load (primitive/field cg a))
                              (mut fs) (al-new [(ptr i8)] a)]
                          (al-push! (mut fs) (al-get [(ptr i8)] (primitive/load slots) 0))
                          (al-push! (mut fs) (al-get [(ptr i8)] (primitive/load slots) 1))
                          (LLVMStructTypeInContext (cg-ctx cg) (carr a (primitive/load fs)) 2 0))
                        (do (unimplemented "abi: empty direct return classification") (primitive/cast (ptr i8) 0))))))
    (ACIndirect [al] (do (unimplemented "abi: direct-return-type on an indirect class") (primitive/cast (ptr i8) 0)))))
(defn abi-ret-indirect? [(sa (ptr StructAbi))] (-> bool)
  (match-else (primitive/load (primitive/field sa ret)) (ACIndirect [a] true) (_ false)))

; ---- csigs map (only struct-by-value callables) ----
(defn cg-csig [(cg (ptr Cg)) (nm (slice u8))] (-> (ptr CSig))
  (let [n (al-len [CSigEntry] (primitive/load (primitive/field cg csigs)))
        (mut i) 0
        (mut r) (primitive/cast (ptr CSig) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ep (al-elem [CSigEntry] (primitive/field cg csigs) (primitive/load i))]
                  (when (str-eq (primitive/load (primitive/field ep name)) nm) (primitive/store! r (primitive/load (primitive/field ep sig))) 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn cg-has-csig [(cg (ptr Cg)) (nm (slice u8))] (-> bool)
  (primitive/icmp-ne (primitive/cast i64 (cg-csig cg nm)) 0))
(defn cg-add-csig [(cg (ptr Cg)) (nm (slice u8)) (sig (ptr CSig))] (-> i64)
  (let [e (alloc/stack CSigEntry)]
    (primitive/store! (primitive/field e name) nm)
    (primitive/store! (primitive/field e sig) sig)
    (al-push! (mut (primitive/field cg csigs)) (primitive/load e)))
  0)
(defn cg-argabi [(sig (ptr CSig)) (i i64)] (-> ArgAbiK)
  (let [args (primitive/load (primitive/field sig args))]
    (if (primitive/icmp-lt i (al-len [ArgAbiK] (primitive/load args))) (al-get [ArgAbiK] (primitive/load args) i) (AAScalar))))

; ---- SysV register accounting for by-value aggregates -----------------------
; An aggregate that classifies ACDirect is only ACTUALLY passed in registers if
; enough of them are still free at its position in the argument list. SysV says
; that when either of its eightbytes has no register left, the WHOLE aggregate
; goes in memory instead — it does not half-spill. Clang implements exactly this
; (compare `f(F2)` -> `double, double` against
; `f(double x7..., F2)` -> `ptr byval(%F2)`), and getting it wrong is invisible
; until a struct lands after enough scalars to exhaust one register file:
; the callee then reads one eightbyte from the last free register and the other
; from the stack, i.e. from the wrong place.
;
; `slot-is-sse?` reads the class back off the coerced slot type the classifier
; already computed: float/double/vector slots are SSE eightbytes, integer slots
; are INTEGER ones.
(defn slot-is-sse? [(t (ptr i8))] (-> bool)
  (let [k (LLVMGetTypeKind t)]
    (or (primitive/icmp-eq k 2) (or (primitive/icmp-eq k 3) (primitive/icmp-eq k 13)))))  ; float / double / vector

; How many INTEGER and SSE registers an ACDirect aggregate would consume.
(defn abi-slot-regs [(slots (ptr (ArrayList (ptr i8)))) (gpp (ptr i64)) (ssep (ptr i64))] (-> i64)
  (let [n (al-len [(ptr i8)] (primitive/load slots))
        (mut k) 0]
    (primitive/store! gpp 0)
    (primitive/store! ssep 0)
    (loop (if (primitive/icmp-ge (primitive/load k) n)
              (break)
              (do
                (if (slot-is-sse? (al-get [(ptr i8)] (primitive/load slots) (primitive/load k)))
                    (primitive/store! ssep (primitive/iadd (primitive/load ssep) 1))
                    (primitive/store! gpp (primitive/iadd (primitive/load gpp) 1)))
                (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    0))

; ---- c_signature: the C-ABI realization of a (params -> ret) signature ----
(defn c-signature [(cg (ptr Cg)) (params (ptr (ArrayList Type))) (ret (ptr Type)) (variadic bool)] (-> (ptr CSig))
  (let [a (primitive/load (primitive/field cg a))
        ctx (cg-ctx cg)
        sig (unwrap-ptr [CSig] (create [CSig] a))
        (mut lp) (al-new [(ptr i8)] a)
        (mut argl) (al-new [ArgAbiK] a)
        (mut rty) (primitive/cast (ptr i8) 0)]  ; null = void return type
    (primitive/store! (primitive/field sig sret) (primitive/cast (ptr StructAbi) 0))
    (primitive/store! (primitive/field sig ret_direct) (primitive/cast (ptr StructAbi) 0))
    ; return classification
    (let [rcs (cg-abi-struct-cs cg ret)]
      (if (primitive/icmp-ge rcs 0)
          (let [sa (abi-classify cg rcs)]
            (if (abi-ret-indirect? sa)
                (do (al-push! (mut lp) (LLVMPointerTypeInContext ctx 0)) (primitive/store! (primitive/field sig sret) sa) 0)
                (do (primitive/store! rty (abi-direct-return-type cg sa)) (primitive/store! (primitive/field sig ret_direct) sa) 0)))
          (unless (ty-is-void ret) (primitive/store! rty (basic-ty cg ret)) 0)))
    ; param classification.
    ; `ngp`/`nsse` track how many argument registers the parameters BEFORE this
    ; one have consumed, because on x86-64 an ACDirect aggregate is demoted to
    ; byval when its eightbytes no longer fit (see abi-slot-regs above). An sret
    ; pointer occupies the first integer register. AArch64 does not have this
    ; rule — its ACDirect coercion is a single slot and the classifier already
    ; accounts for HFA/size — so the demotion is x86-only.
    (let [n (al-len [Type] (primitive/load params))
          x86 (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 0)
          (mut ngp) (if (primitive/icmp-ne (primitive/cast i64 (primitive/load (primitive/field sig sret))) 0) 1 0)
          (mut nsse) 0
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (let [pty (al-elem [Type] params (primitive/load i))
                        pcs (cg-abi-struct-cs cg pty)]
                    (if (primitive/icmp-ge pcs 0)
                        (let [sa (abi-classify cg pcs)]
                          (match (primitive/load (primitive/field sa arg))
                            (ACDirect [slots]
                                      (let [ns (al-len [(ptr i8)] (primitive/load slots))
                                            needg (alloc/stack i64)
                                            needs (alloc/stack i64)]
                                        (abi-slot-regs slots needg needs)
                                        (if (and x86
                                                 (or (primitive/icmp-gt (primitive/iadd (primitive/load ngp) (primitive/load needg)) 6)
                                                     (primitive/icmp-gt (primitive/iadd (primitive/load nsse) (primitive/load needs)) 8)))
                                            ; no room for BOTH eightbytes: the whole
                                            ; aggregate goes in memory, as byval.
                                            (do
                                              (al-push! (mut lp) (LLVMPointerTypeInContext ctx 0))
                                              (al-push! (mut argl) (AAIndirect sa))
                                              0)
                                            (let [(mut k) 0]
                                              (loop (if (primitive/icmp-ge (primitive/load k) ns)
                                                        (break)
                                                        (do
                                                          (al-push! (mut lp) (al-get [(ptr i8)] (primitive/load slots) (primitive/load k)))
                                                          (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                                              (primitive/store! ngp (primitive/iadd (primitive/load ngp) (primitive/load needg)))
                                              (primitive/store! nsse (primitive/iadd (primitive/load nsse) (primitive/load needs)))
                                              (al-push! (mut argl) (AADirect sa))
                                              0))))
                            (ACIndirect [al]
                                        (do
                                          ; a byval pointer still costs an integer
                                          ; register when one is available
                                          (when (primitive/icmp-lt (primitive/load ngp) 6) (primitive/store! ngp (primitive/iadd (primitive/load ngp) 1)) 0)
                                          (al-push! (mut lp) (LLVMPointerTypeInContext ctx 0))
                                          (al-push! (mut argl) (AAIndirect sa))))))
                        (do
                          (if (type-is-float pty)
                              (when (primitive/icmp-lt (primitive/load nsse) 8) (primitive/store! nsse (primitive/iadd (primitive/load nsse) 1)) 0)
                              (when (primitive/icmp-lt (primitive/load ngp) 6) (primitive/store! ngp (primitive/iadd (primitive/load ngp) 1)) 0))
                          (al-push! (mut lp) (basic-ty cg pty))
                          (al-push! (mut argl) (AAScalar)))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (let [rt (if (primitive/icmp-eq (primitive/cast i64 (primitive/load rty)) 0) (LLVMVoidTypeInContext ctx) (primitive/load rty))
          fnty (LLVMFunctionType rt (carr a (primitive/load lp)) (primitive/cast i32 (al-len [(ptr i8)] (primitive/load lp))) (when variadic 1))]
      (primitive/store! (primitive/field sig args) (box-al [ArgAbiK] a (primitive/load argl)))
      (primitive/store! (primitive/field sig fn_ty) fnty)
      sig)))

; ---- attributes ----
(defn cg-enum-attr [(cg (ptr Cg)) (name (slice u8)) (val i64)] (-> (ptr i8))
  (LLVMCreateEnumAttribute (cg-ctx cg)
                           (LLVMGetEnumAttributeKindForName (slice->cstr (primitive/load (primitive/field cg a)) name) (slice-len name))
                           val))
(defn cg-type-attr [(cg (ptr Cg)) (name (slice u8)) (ty (ptr i8))] (-> (ptr i8))
  (LLVMCreateTypeAttribute (cg-ctx cg)
                           (LLVMGetEnumAttributeKindForName (slice->cstr (primitive/load (primitive/field cg a)) name) (slice-len name))
                           ty))
(defn cg-attr-at [(cg (ptr Cg)) (target (ptr i8)) (is-call bool) (pidx i64) (attr (ptr i8))] (-> i64)
  (if is-call
      (do (LLVMAddCallSiteAttribute target (primitive/cast i32 (primitive/iadd pidx 1)) attr) 0)
      (do (LLVMAddAttributeAtIndex target (primitive/cast i32 (primitive/iadd pidx 1)) attr) 0)))
; apply a CSig's attrs (sret/align, and x86 byval — never on AArch64) to a function
; declaration (is-call=false) or a call instruction (is-call=true).
(defn cg-apply-csig-attrs [(cg (ptr Cg)) (sig (ptr CSig)) (target (ptr i8)) (is-call bool)] (-> i64)
  (let [(mut idx) 0
        sret-sa (primitive/load (primitive/field sig sret))]
    (when (primitive/icmp-ne (primitive/cast i64 sret-sa) 0)
          (cg-attr-at cg target is-call (primitive/load idx) (cg-type-attr cg "sret" (primitive/load (primitive/field sret-sa llvm_ty))))
          (cg-attr-at cg target is-call (primitive/load idx) (cg-enum-attr cg "align" (primitive/cast i64 (primitive/load (primitive/field sret-sa align)))))
          (primitive/store! idx (primitive/iadd (primitive/load idx) 1)))
    (let [args (primitive/load (primitive/field sig args))
          n (al-len [ArgAbiK] (primitive/load args))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (match (al-get [ArgAbiK] (primitive/load args) (primitive/load i))
                    (AADirect [sa]
                              (match-else (primitive/load (primitive/field sa arg))
                                          (ACDirect [slots]
                                                    (primitive/store! idx (primitive/iadd (primitive/load idx) (al-len [(ptr i8)] (primitive/load slots)))))
                                          (_ 0)))
                    (AAIndirect [sa]
                                (do
                                  (when (primitive/icmp-eq (primitive/load (primitive/field cg arch)) 0)
                                        (cg-attr-at cg
                                                    target
                                                    is-call
                                                    (primitive/load idx)
                                                    (cg-type-attr cg "byval" (primitive/load (primitive/field sa llvm_ty))))
                                        (cg-attr-at cg
                                                    target
                                                    is-call
                                                    (primitive/load idx)
                                                    (cg-enum-attr cg "align" (primitive/cast i64 (primitive/load (primitive/field sa align))))))
                                  (primitive/store! idx (primitive/iadd (primitive/load idx) 1))))
                    (AAScalar [] (primitive/store! idx (primitive/iadd (primitive/load idx) 1))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    0))

; ---- struct slot / arg pointer / memcpy / gep helpers ----
(defn cg-const-uoff [(cg (ptr Cg)) (n i64)] (-> (ptr i8))
  (LLVMConstInt (cg-i64t cg) n 0))
; the call's value name: empty for a void-returning callee (LLVM never
; name a void call), else `nm` — so named/bare calls match the reference exactly.
(defn cg-call-name [(cg (ptr Cg)) (fnty (ptr i8)) (nm (slice u8))] (-> (ptr i8))
  (if (primitive/icmp-eq (LLVMGetTypeKind (LLVMGetReturnType fnty)) 0) (cg-bl cg "") (cg-bl cg nm)))
(defn cg-struct-slot [(cg (ptr Cg)) (sa (ptr StructAbi)) (name (slice u8))] (-> (ptr i8))
  (let [p (cg-entry-alloca cg (primitive/load (primitive/field sa llvm_ty)) (cg-bl cg name))
        al (primitive/load (primitive/field sa align))]
    (LLVMSetAlignment p (if (primitive/icmp-gt al 8) al 8))
    p))
; A spill slot for an aggregate that is about to be read back as whole i64 ABI
; slots. Its size must be rounded UP to a multiple of 8: an ACDirect argument is
; passed by loading one i64 per slot, so a 4-byte struct sitting in an exactly
; 4-byte alloca would have that load reach 4 bytes past the end of the object.
; LLVM treats the out-of-bounds load as poison and folds it, which is how a
; (4x u8) struct arrived at a C callee as 0,0,0,0. The padding bytes are never
; read by the callee — it only looks at the struct's own fields.
(defn cg-struct-slot-padded [(cg (ptr Cg)) (sa (ptr StructAbi)) (name (slice u8))] (-> (ptr i8))
  (let [ctx (cg-ctx cg)
        ty (LLVMArrayType2 (LLVMInt8TypeInContext ctx) (align8 (primitive/load (primitive/field sa size))))
        p (cg-entry-alloca cg ty (cg-bl cg name))
        al (primitive/load (primitive/field sa align))]
    (LLVMSetAlignment p (if (primitive/icmp-gt al 8) al 8))
    p))
(defn cg-struct-arg-ptr [(cg (ptr Cg)) (v (ptr i8)) (sa (ptr StructAbi))] (-> (ptr i8))
  (if (primitive/icmp-eq (LLVMGetTypeKind (LLVMTypeOf v)) 12)
      v
      (let [slot (cg-struct-slot-padded cg sa "abi.arg")] (LLVMBuildStore (cg-bld cg) v slot) slot)))
(defn cg-copy-struct [(cg (ptr Cg)) (dst (ptr i8)) (src (ptr i8)) (sa (ptr StructAbi))] (-> i64)
  (LLVMBuildMemCpy (cg-bld cg)
                   dst
                   (primitive/load (primitive/field sa align))
                   src
                   (primitive/load (primitive/field sa align))
                   (cg-const-uoff cg (primitive/load (primitive/field sa size))))
  0)
(defn cg-gep-i8 [(cg (ptr Cg)) (base (ptr i8)) (off i64)] (-> (ptr i8))
  (let [a (primitive/load (primitive/field cg a))
        (mut ix) (al-new [(ptr i8)] a)]
    (al-push! (mut ix) (cg-const-uoff cg off))
    (LLVMBuildGEP2 (cg-bld cg) (LLVMInt8TypeInContext (cg-ctx cg)) base (carr a (primitive/load ix)) 1 (cg-bl cg "abi.eb"))))

; ---- reject by-value slice/vec crossing the C boundary
; reject_view_at_c_abi) ---- Runs eagerly over EVERY extern declaration (before,
; and independent of, per-target struct classification), so it holds on every
; target. A by-value slice or SIMD vec — direct, or nested in a by-value struct
; field / array — has no defined C representation. It is an error naming `<who>`
; rendered as a bare spanless `error: <msg>` + exit 1; codegen here has no Result
; channel, so cg-fail prints and exits — byte-identical stderr + exit code.
(defn cg-reject-view [(cg (ptr Cg)) (t (ptr Type)) (who (slice u8))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))]
    (match-else (primitive/load t)
                (TSlice [el]
                        (cg-fail (sconcat a
                                          who
                                          ": a slice cannot cross the C ABI by value (it is a Coil view type); for FFI pass a c\"…\"/(ptr i8) and a length")))
                (TVec [el n] (cg-fail (sconcat a who ": a vec cannot cross the C ABI by value; pass a pointer to it")))
                (TStruct [nm]
                         (let [si (cg-struct-idx cg nm)]
                           (unless (primitive/icmp-lt si 0)
                                   (match (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) si) layout))
                                          (LBits [b o] 0)
                                          (LC []
                                              (let [fs (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) si) fields))
                                                    n (al-len [Field] (primitive/load fs))
                                                    (mut i) 0]
                                                (loop (if (primitive/icmp-ge (primitive/load i) n)
                                                          (break)
                                                          (do
                                                            (cg-reject-view cg
                                                                            (primitive/field (al-elem [Field] fs (primitive/load i)) ty)
                                                                            who)
                                                            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                                                0))
                                          (LPacked []
                                                   (let [fs (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) si) fields))
                                                         n (al-len [Field] (primitive/load fs))
                                                         (mut i) 0]
                                                     (loop (if (primitive/icmp-ge (primitive/load i) n)
                                                               (break)
                                                               (do
                                                                 (cg-reject-view cg
                                                                                 (primitive/field (al-elem [Field] fs (primitive/load i)) ty)
                                                                                 who)
                                                                 (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                                                     0))
                                          (LAligned [$g3488]
                                                    (let [fs (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) si) fields))
                                                          n (al-len [Field] (primitive/load fs))
                                                          (mut i) 0]
                                                      (loop (if (primitive/icmp-ge (primitive/load i) n)
                                                                (break)
                                                                (do
                                                                  (cg-reject-view cg
                                                                                  (primitive/field (al-elem [Field] fs (primitive/load i)) ty)
                                                                                  who)
                                                                  (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                                                      0))
                                          (LExplicit [$g3489 $g3490 $g3491]
                                                     (let [fs (primitive/load (primitive/field (al-elem [CgStruct] (primitive/field cg structs) si) fields))
                                                           n (al-len [Field] (primitive/load fs))
                                                           (mut i) 0]
                                                       (loop (if (primitive/icmp-ge (primitive/load i) n)
                                                                 (break)
                                                                 (do
                                                                   (cg-reject-view cg
                                                                                   (primitive/field (al-elem [Field] fs (primitive/load i)) ty)
                                                                                   who)
                                                                   (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                                                       0))))))
                (TArray [el n] (cg-reject-view cg el who))
                (_ 0))))
(defn cg-check-c-abi-types [(cg (ptr Cg)) (params (ptr (ArrayList Type))) (ret (ptr Type)) (who (slice u8))] (-> i64)
  (cg-reject-view cg ret who)
  (let [n (al-len [Type] (primitive/load params))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (cg-reject-view cg (al-elem [Type] params (primitive/load i)) who) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)

; ---- emit a call through the C struct ABI ----
(defn emit-argtv [(cg (ptr Cg)) (args (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> (ArrayList Tv))
  (let [a (primitive/load (primitive/field cg a))
        n (al-len [Expr] (primitive/load args))
        (mut out) (al-new [Tv] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut out) (emit-expr cg (al-elem [Expr] args (primitive/load i)) scp)) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load out)))
; Emit a C-ABI call given the callee VALUE plus its function type and calling
; convention explicitly. A direct extern derives both from the global (emit-c-call
; below); an indirect `call-ptr` has neither — a raw function-pointer value has no
; global value type and no function callconv — so it passes the CSig's own fn_ty
; and the C convention id. Everything else here (classification, sret slot, byval
; copies, ACDirect slot loads, csig attrs) is shared verbatim.
; `label` names the call's SSA value. It is threaded through rather than fixed so
; an indirect call keeps its historic "callptr" name: a `c` fnptr whose args need
; no struct lowering emits exactly the instruction it always did, and the IR gate
; stays sensitive to real changes instead of drowning in a rename.
(defn emit-c-call-ty [(cg (ptr Cg))
                      (callee (ptr i8))
                      (fnty (ptr i8))
                      (ccid i32)
                      (sig (ptr CSig))
                      (argtv (ArrayList Tv))
                      (ret-ty Type)
                      (label (slice u8))] (-> Tv)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        ctx (cg-ctx cg)
        (mut meta) (al-new [(ptr i8)] a)
        sret-sa (primitive/load (primitive/field sig sret))
        (mut sret-slot) (primitive/cast (ptr i8) 0)
        nargs (al-len [Tv] argtv)
        nfixed (al-len [ArgAbiK] (primitive/load (primitive/field sig args)))]
    (when (primitive/icmp-ne (primitive/cast i64 sret-sa) 0)
          (let [s (cg-struct-slot cg sret-sa "abi.sret")] (primitive/store! sret-slot s) (al-push! (mut meta) s)))
    (let [(mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) nfixed)
                (break)
                (do
                  (let [aa (al-get [ArgAbiK] (primitive/load (primitive/field sig args)) (primitive/load i))
                        tv (al-get [Tv] argtv (primitive/load i))
                        v (tv-val tv)]
                    (match aa
                      (AAScalar [] (al-push! (mut meta) v))
                      (AAIndirect [sa]
                                  (let [src (cg-struct-arg-ptr cg v sa)
                                        copy (cg-struct-slot cg sa "abi.byval")]
                                    (cg-copy-struct cg copy src sa)
                                    (al-push! (mut meta) copy)))
                      (AADirect [sa]
                                (let [src (cg-struct-arg-ptr cg v sa)]
                                  (match (primitive/load (primitive/field sa arg))
                                    (ACDirect [slots]
                                              (let [ns (al-len [(ptr i8)] (primitive/load slots))
                                                    (mut k) 0]
                                                (loop (if (primitive/icmp-ge (primitive/load k) ns)
                                                          (break)
                                                          (do
                                                            (let [slot-ty (al-get [(ptr i8)] (primitive/load slots) (primitive/load k))
                                                                  off (primitive/imul (primitive/load k) 8)
                                                                  gep (if (primitive/icmp-eq off 0) src (cg-gep-i8 cg src off))]
                                                              (al-push! (mut meta)
                                                                        (LLVMBuildLoad2 b
                                                                                        slot-ty
                                                                                        gep
                                                                                        (cg-bl cg "abi.slot"))))
                                                            (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                                                0))
                                    (ACIndirect [al] (do (unimplemented "abi: Direct arg has a Direct class") 0)))))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (let [(mut i) nfixed]
      (loop (if (primitive/icmp-ge (primitive/load i) nargs)
                (break)
                (do
                  (let [tv (al-get [Tv] argtv (primitive/load i))
                        v (tv-val tv)]
                    (if (and (primitive/icmp-ge (cg-abi-struct-cs cg (box-type a (tv-ty tv))) 0)
                             (primitive/icmp-ne (LLVMGetTypeKind (LLVMTypeOf v)) 12))
                        (do
                          (unimplemented "codegen: passing a struct by value in a variadic argument is not supported")
                          0)
                        (al-push! (mut meta) v)))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    (let [cs
            (LLVMBuildCall2 b
                            fnty
                            callee
                            (carr a (primitive/load meta))
                            (primitive/cast i32 (al-len [(ptr i8)] (primitive/load meta)))
                            (cg-call-name cg fnty label))]
      (LLVMSetInstructionCallConv cs ccid)
      (cg-apply-csig-attrs cg sig cs true)
      (if (primitive/icmp-ne (primitive/cast i64 sret-sa) 0)
          (mk-tv (LLVMBuildLoad2 b (primitive/load (primitive/field sret-sa llvm_ty)) (primitive/load sret-slot) (cg-bl cg "abi.ret")) ret-ty)
          (let [rd (primitive/load (primitive/field sig ret_direct))]
            (if (primitive/icmp-ne (primitive/cast i64 rd) 0)
                (let [slot (cg-struct-slot cg rd "abi.ret")]
                  (LLVMBuildStore b cs slot)
                  (mk-tv (LLVMBuildLoad2 b (primitive/load (primitive/field rd llvm_ty)) slot (cg-bl cg "abi.ret.val")) ret-ty))
                (if (ty-is-void (box-type a ret-ty)) (mk-tv (cg-zero-i64 cg) (TVoid)) (mk-tv cs ret-ty))))))))

; a DIRECT call to a named C function: the global carries both its type and its cc.
(defn emit-c-call [(cg (ptr Cg)) (callee (ptr i8)) (sig (ptr CSig)) (argtv (ArrayList Tv)) (ret-ty Type)] (-> Tv)
  (emit-c-call-ty cg
                  callee
                  (LLVMGlobalGetValueType callee)
                  (LLVMGetFunctionCallConv callee)
                  sig
                  argtv
                  ret-ty
                  "ccall"))

; Two `(extern …)` declarations that resolve to the same C symbol must agree on
; their LLVM function type. A module holds ONE function per symbol, so the second
; declaration is dropped and its calls are built with the second signature against
; the first declaration's type. On arm64 that mismatch is invisible (i32 and i64
; args share a register); on wasm32 the param types are distinct, so it emits an
; import whose signature contradicts its call sites and the module fails to
; validate ("type mismatch: expected i64, found i32"). Reject it at declaration:
; the mismatch is a real conflict either way, the wasm backend just can't hide it.
;
; The conflict is usually with a declaration the program never wrote itself (the
; prelude declares read/write/strlen/memcpy), so name the earlier extern. Scanning
; for it is O(n) over the externs already walked, but only on the fatal path.
(defn cg-extern-prior-decl [(p (ptr Program)) (csym (slice u8)) (upto i64)] (-> (slice u8))
  (let [es (primitive/load (primitive/field p externs))
        (mut i) 0
        (mut r) ""]
    (loop (if (primitive/icmp-ge (primitive/load i) upto)
              (break)
              (do
                (let [nm (primitive/load (primitive/field (al-elem [Extern] es (primitive/load i)) name))]
                  (when (str-eq (last-component nm) csym) (primitive/store! r nm) (break)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn cg-extern-redecl-check [(cg (ptr Cg))
                              (existing (ptr i8))
                              (fnty (ptr i8))
                              (prior (slice u8))
                              (ename (slice u8))
                              (csym (slice u8))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        have (LLVMGlobalGetValueType existing)]
    (unless (primitive/icmp-eq (primitive/cast i64 have) (primitive/cast i64 fnty))
            (cg-fail (sconcat3 a
                               (sconcat3 a "C symbol '" csym "' is declared twice with different signatures: ")
                               (sconcat3 a
                                         (if (primitive/icmp-gt (slice-len prior) 0)
                                             (sconcat3 a "'" prior "'")
                                             "an earlier declaration")
                                         " is "
                                         (cstr->slice (LLVMPrintTypeToString have)))
                               (sconcat3 a
                                         (sconcat3 a ", '" ename "' is ")
                                         (cstr->slice (LLVMPrintTypeToString fnty))
                                         ". One C symbol, one signature: fix the types to match, or use a different symbol"))))))

; 1a: declare externs.
(defn cg-declare-externs [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        es (primitive/load (primitive/field p externs))
        n (al-len [Extern] (primitive/load es))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ep (al-elem [Extern] es (primitive/load i))
                      ename (primitive/load (primitive/field ep name))
                      params (primitive/load (primitive/field ep params))
                      ret (primitive/load (primitive/field ep ret))
                      csym (last-component ename)
                      ; the extern's convention -> its native LLVM calling-convention id
                      ; (externs are always native; a :shim extern is rejected in check).
                      conv (cg-prog-conv p (primitive/load (primitive/field ep cc)))
                      cc-id (when (primitive/icmp-ne (primitive/cast i64 conv) 0) (conv-native-id conv))]
                  ; Eager C-ABI view check for EVERY extern
                  ; before — and regardless of — the struct-by-value branch below. A bare
                  ; `(slice u8)`/`(vec …)` param isn't a struct, so the struct branch
                  ; alone would wave it through; this catches it at declaration.
                  (cg-check-c-abi-types cg params (box-type a ret) (sconcat3 a "extern '" ename "'"))
                  (if (or (cg-abi-struct? cg (box-type a ret)) (ty-list-has-struct cg params))
                      (let [sig (c-signature cg params (box-type a ret) (primitive/load (primitive/field ep variadic)))
                            existing (LLVMGetNamedFunction (primitive/load (primitive/field cg module)) (slice->cstr a csym))
                            fv
                              (if (primitive/icmp-ne (primitive/cast i64 existing) 0)
                                  (do
                                    (cg-extern-redecl-check cg
                                                            existing
                                                            (primitive/load (primitive/field sig fn_ty))
                                                            (cg-extern-prior-decl p csym (primitive/load i))
                                                            ename
                                                            csym)
                                    existing)
                                  (let [nf
                                          (LLVMAddFunction (primitive/load (primitive/field cg module))
                                                           (slice->cstr a csym)
                                                           (primitive/load (primitive/field sig fn_ty)))]
                                    (cg-apply-csig-attrs cg sig nf false)
                                    (LLVMSetFunctionCallConv nf (primitive/cast i32 cc-id))
                                    nf))]
                        (when (not (cg-has-csig cg ename)) (cg-add-csig cg ename sig))
                        (cg-add-func cg ename fv)
                        (cg-record-callable cg ename (primitive/load (primitive/field ep cc)) params ret))
                      (let [existing (LLVMGetNamedFunction (primitive/load (primitive/field cg module)) (slice->cstr a csym))
                            fnty (cg-fn-type-v cg params (box-type a ret) (primitive/load (primitive/field ep variadic)))
                            fv
                              (if (primitive/icmp-ne (primitive/cast i64 existing) 0)
                                  (do
                                    (cg-extern-redecl-check cg
                                                            existing
                                                            fnty
                                                            (cg-extern-prior-decl p csym (primitive/load i))
                                                            ename
                                                            csym)
                                    existing)
                                  (let [nf (LLVMAddFunction (primitive/load (primitive/field cg module)) (slice->cstr a csym) fnty)]
                                    (LLVMSetFunctionCallConv nf (primitive/cast i32 cc-id))
                                    nf))]
                        (cg-add-func cg ename fv)
                        (cg-record-callable cg ename (primitive/load (primitive/field ep cc)) params ret))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))

; 1b: declare functions (native path only; no shims/exports in corpus).
(defn cg-has-anchor [(p (ptr Program))] (-> bool)
  (let [fs (primitive/load (primitive/field p funcs))
        n (al-len [Func] (primitive/load fs))
        (mut i) 0
        (mut r) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [Func] fs (primitive/load i)) name)) "main") (primitive/store! r true) 0)
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (or (primitive/load r) (primitive/icmp-gt (al-len [ExportC] (primitive/load (primitive/field p exports))) 0))))
; find the ExportC for a function name (null if not exported).
(defn cg-export-find [(p (ptr Program)) (name (slice u8))] (-> (ptr ExportC))
  (let [es (primitive/load (primitive/field p exports))
        n (al-len [ExportC] (primitive/load es))
        (mut i) 0
        (mut r) (primitive/cast (ptr ExportC) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [ExportC] es (primitive/load i)) name)) name)
                      (primitive/store! r (al-elem [ExportC] es (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
; an export takes a struct BY VALUE (a TStruct param) -> it needs a C-ABI thunk (the
; internal function is reference-model, taking the struct by pointer).
(defn cg-export-needs-thunk [(e (ptr ExportC))] (-> bool)
  (let [ps (primitive/load (primitive/field e params))
        n (al-len [Type] (primitive/load ps))
        (mut i) 0
        (mut r) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-eq (type-tag (al-elem [Type] ps (primitive/load i))) 6) (primitive/store! r true) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn cg-declare-funcs [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        fs (primitive/load (primitive/field p funcs))
        n (al-len [Func] (primitive/load fs))
        anchor (cg-has-anchor p)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (primitive/load i))
                      fname (primitive/load (primitive/field fp name))
                      fparams (cg-param-types cg (primitive/load (primitive/field fp params)))
                      ret (primitive/load (primitive/field fp ret))
                      exp (cg-export-find p fname)
                      ; a thunk-FREE C export is emitted directly under its C symbol; everything
                      ; else (incl. a thunk-needing export's internal function) under its Coil name.
                      direct-sym
                        (if (and (primitive/icmp-ne (primitive/cast i64 exp) 0) (not (cg-export-needs-thunk exp)))
                            (primitive/load (primitive/field exp symbol))
                            (None [(slice u8)]))
                      llvm-name (match direct-sym (Some [sm] sm) (None [] fname))
                      external
                        (or (str-eq fname "main")
                            (or (match direct-sym (Some [sm2] true) (None [] false)) (not anchor)))
                      conv (cg-prog-conv p (primitive/load (primitive/field fp cc)))]
                  (cg-record-callable cg fname (primitive/load (primitive/field fp cc)) fparams ret)
                  (if (and (primitive/icmp-ne (primitive/cast i64 conv) 0) (conv-is-shim conv))
                      ; :shim lowering -> a `ccc` __impl carrying the body + a `naked` void
                      ; trampoline under the Coil name.
                      (let [ret-reg
                              (match (primitive/load (primitive/field conv ret))
                                (Some [r] r)
                                (None []
                                      (do
                                        (unimplemented (sconcat3 a
                                                                 "shim convention '"
                                                                 (primitive/load (primitive/field fp cc))
                                                                 "' needs a :ret register"))
                                        "")))
                            fnty (cg-fn-type cg fparams (box-type a ret))
                            impl-fn
                              (LLVMAddFunction (primitive/load (primitive/field cg module)) (slice->cstr a (sconcat a fname "__impl")) fnty)
                            void-ty
                              (LLVMFunctionType (LLVMVoidTypeInContext (cg-ctx cg)) (carr a (al-new [(ptr i8)] a)) 0 0)
                            tramp (LLVMAddFunction (primitive/load (primitive/field cg module)) (slice->cstr a fname) void-ty)]
                        (LLVMAddAttributeAtIndex tramp (primitive/cast i32 -1) (cg-enum-attr cg "naked" 0))
                        (LLVMAddAttributeAtIndex tramp (primitive/cast i32 -1) (cg-enum-attr cg "noinline" 0))
                        (cg-add-func cg fname tramp)
                        (cg-add-shim cg fname impl-fn (primitive/load (primitive/field conv params)) ret-reg (primitive/load (primitive/field conv clobber))))
                      (let [cc-id (when (primitive/icmp-ne (primitive/cast i64 conv) 0) (conv-native-id conv))]
                        (if (or (cg-abi-struct? cg (box-type a ret)) (ty-list-has-struct cg fparams))
                            (let [sig (c-signature cg fparams (box-type a ret) false)
                                  fv
                                    (LLVMAddFunction (primitive/load (primitive/field cg module))
                                                     (slice->cstr a llvm-name)
                                                     (primitive/load (primitive/field sig fn_ty)))]
                              (LLVMSetFunctionCallConv fv (primitive/cast i32 cc-id))
                              (cg-apply-csig-attrs cg sig fv false)
                              (cg-add-csig cg fname sig)
                              (when (not external) (LLVMSetLinkage fv 8) 0)
                              (cg-add-func cg fname fv))
                            (let [fnty (cg-fn-type cg fparams (box-type a ret))
                                  fv (LLVMAddFunction (primitive/load (primitive/field cg module)) (slice->cstr a llvm-name) fnty)]
                              (LLVMSetFunctionCallConv fv (primitive/cast i32 cc-id))
                              (when (not external) (LLVMSetLinkage fv 8) 0)
                              (cg-add-func cg fname fv))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))
; 2b: C-ABI export THUNKS. For each export that
; takes a struct by value, emit the external C-symbol function that marshals the C ABI
; into the reference-model (pointer) args the internal function takes, then calls it.
(defn cg-emit-export-thunk [(cg (ptr Cg))
                            (c-symbol (slice u8))
                            (internal-name (slice u8))
                            (internal (ptr i8))
                            (params (ptr (ArrayList Type)))
                            (ret (ptr Type))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        b (cg-bld cg)
        sig (c-signature cg params ret false)
        thunk (LLVMAddFunction (primitive/load (primitive/field cg module)) (slice->cstr a c-symbol) (primitive/load (primitive/field sig fn_ty)))]
    (LLVMSetFunctionCallConv thunk 0)
    (cg-apply-csig-attrs cg sig thunk false)
    (let [entry (cg-append cg thunk (cg-bl cg "entry"))]
      (cg-pos cg entry)
      (let [(mut meta) (al-new [(ptr i8)] a)
            sret-sa (primitive/load (primitive/field sig sret))
            (mut idx) 0]
        (when (primitive/icmp-ne (primitive/cast i64 sret-sa) 0) (al-push! (mut meta) (LLVMGetParam thunk 0)) (primitive/store! idx 1))
        (let [args (primitive/load (primitive/field sig args))
              n (al-len [ArgAbiK] (primitive/load args))
              (mut i) 0]
          (loop (if (primitive/icmp-ge (primitive/load i) n)
                    (break)
                    (do
                      (match (al-get [ArgAbiK] (primitive/load args) (primitive/load i))
                        (AAScalar []
                                  (do
                                    (al-push! (mut meta) (LLVMGetParam thunk (primitive/cast i32 (primitive/load idx))))
                                    (primitive/store! idx (primitive/iadd (primitive/load idx) 1))))
                        (AADirect [sa]
                                  ; padded for the same reason the call side is: the loop below
                                  ; STORES one whole i64 per ABI slot, so a 4-byte struct in a
                                  ; 4-byte alloca would be written 4 bytes past its end. LLVM
                                  ; folded that to poison and the argument reached the callee as
                                  ; zero — with `mov x0, xzr` right there in the disassembly.
                                  (let [slot (cg-struct-slot-padded cg sa "thunk.arg")]
                                    (match-else (primitive/load (primitive/field sa arg))
                                                (ACDirect [slots]
                                                          (let [ns (al-len [(ptr i8)] (primitive/load slots))
                                                                (mut k) 0]
                                                            (loop (if (primitive/icmp-ge (primitive/load k) ns)
                                                                      (break)
                                                                      (do
                                                                        (let [v
                                                                                (LLVMGetParam thunk
                                                                                              (primitive/cast i32 (primitive/load idx)))
                                                                              off (primitive/imul (primitive/load k) 8)
                                                                              gep
                                                                                (if (primitive/icmp-eq off 0)
                                                                                    slot
                                                                                    (cg-gep-i8 cg slot off))]
                                                                          (LLVMBuildStore b v gep)
                                                                          (primitive/store! idx (primitive/iadd (primitive/load idx) 1)))
                                                                        (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
                                                            0))
                                                (_ 0))
                                    (al-push! (mut meta) slot)))
                        (AAIndirect [sa]
                                    (do
                                      (al-push! (mut meta) (LLVMGetParam thunk (primitive/cast i32 (primitive/load idx))))
                                      (primitive/store! idx (primitive/iadd (primitive/load idx) 1)))))
                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
          (let [cs
                  (LLVMBuildCall2 b
                                  (LLVMGlobalGetValueType internal)
                                  internal
                                  (carr a (primitive/load meta))
                                  (primitive/cast i32 (al-len [(ptr i8)] (primitive/load meta)))
                                  (cg-call-name cg (LLVMGlobalGetValueType internal) "thunk.call"))]
            (LLVMSetInstructionCallConv cs (LLVMGetFunctionCallConv internal))
            (when (cg-has-csig cg internal-name) (cg-apply-csig-attrs cg (cg-csig cg internal-name) cs true))
            (if (or (primitive/icmp-ne (primitive/cast i64 sret-sa) 0) (ty-is-void ret))
                (do (LLVMBuildRetVoid b) 0)
                (do (LLVMBuildRet b cs) 0)))))
      0)))
(defn cg-emit-thunks [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (primitive/load (primitive/field cg a))
        es (primitive/load (primitive/field p exports))
        n (al-len [ExportC] (primitive/load es))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ep (al-elem [ExportC] es (primitive/load i))]
                  (when (cg-export-needs-thunk ep)
                        (let [sym (match (primitive/load (primitive/field ep symbol)) (Some [s] s) (None [] ""))
                              internal (cg-func cg (primitive/load (primitive/field ep name)))
                              ret
                                (match (cg-ret cg (primitive/load (primitive/field ep name)))
                                  (Some [t] (box-type a t))
                                  (None [] (box-type a (TVoid))))]
                          (cg-emit-export-thunk cg sym (primitive/load (primitive/field ep name)) internal (primitive/load (primitive/field ep params)) ret))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))
(defn cg-param-types [(cg (ptr Cg)) (params (ptr (ArrayList Param)))] (-> (ptr (ArrayList Type)))
  (let [a (primitive/load (primitive/field cg a))
        n (al-len [Param] (primitive/load params))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut out) (primitive/load (primitive/field (al-elem [Param] params (primitive/load i)) ty))) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [Type] a (primitive/load out))))

; 2: emit bodies.
(defn cg-emit-bodies [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [fs (primitive/load (primitive/field p funcs))
        n (al-len [Func] (primitive/load fs))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (primitive/load i))
                      fname (primitive/load (primitive/field fp name))
                      shim (cg-shim-find cg fname)]
                  ; a :shim function's body goes into the `ccc` __impl; then emit the
                  ; naked trampoline into the Coil-named function.
                  (if (primitive/icmp-ne (primitive/cast i64 shim) 0)
                      (do
                        (emit-func cg fp (primitive/load (primitive/field shim impl_fn)))
                        (cg-emit-trampoline cg (cg-func cg fname) shim (al-len [Param] (primitive/load (primitive/field fp params)))))
                      (emit-func cg fp (cg-func cg fname))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    0))

; ===== Port of — cancels codegen's run-to-run nondeterminism
; so the self-host's LLVMPrintModuleToString text matches the normalized reference.
; Faithful, function-for-function port. Families: 0=g 1=str 2=cstr 3=llvmir.
; Categories: 0=type 1=global 2=declare 3=define 4=misc.
