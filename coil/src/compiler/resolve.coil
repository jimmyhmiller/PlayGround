; src/compiler/resolve.coil — self-host Coil compiler, resolve module.
(module resolve)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ast.coil" :use *)
(import "astdump.coil" :use *)
(import "check.coil" :use *)
(import "loader.coil" :use *)
(import "parser.coil" :use *)
(import "reader.coil" :use *)
(import "hashmap.coil" :use *)  ; the per-module def-name index (defs-has?)

(defstruct Defs
  [(callables (ArrayList (slice u8)))
   (types (ArrayList (slice u8)))
   (traits (ArrayList (slice u8)))
   (convs (ArrayList (slice u8)))
   (externs (ArrayList (slice u8)))])
; A module's definitions, plus an INDEX over them. `resolve-name` asks "does module M
; define NAME, as kind K?" once for every identifier in the program, and answering it
; by scanning M's name lists with `str-eq` is O(references × definitions) — quadratic in
; program size, and on the compiler's own source the single largest cost in the whole
; frontend, over half of a run. `mono` had the same defect and was hash-indexed in
; gen-10; this is that treatment for `resolve`.
;
; One map per module, name -> a BITMASK of the kinds that define it, so a name that is
; both a type and a callable costs one slot and one probe instead of one map per kind.
; It is built ONCE, after `build-deftable` has finished filling every module, and lives
; inside the `DefEntry` — so unlike an index keyed on a list's address it cannot outlive
; or be mismatched against the lists it indexes. `built` is 0 until then and every
; lookup falls back to the scan, which keeps the index a pure optimisation: delete the
; build call and the compiler still resolves identically, only slower.
(defstruct DefEntry [(module (slice u8)) (defs Defs) (idx (HashMap (slice u8) i64)) (built i64)])
(defstruct ParsedForm [(prog (ptr Program)) (module (Option (slice u8)))])

; One-field wrapper structs: an `(ArrayList X)` BY VALUE inside a heap struct, so it
; can be GROWN via the field place `(primitive/field box items)` (al-push! needs a place; a
; bare `(ptr (ArrayList X))` cannot be pushed into). `(primitive/field box items)` is itself a
; `(ptr (ArrayList X))`, usable directly for read-only queries (table-find etc.).
(defstruct PBox [(items (ArrayList ParsedForm))])
(defstruct TBox [(items (ArrayList DefEntry))])
(defstruct SBox [(items (ArrayList (slice u8)))])

; The threaded resolution context (mirrors the args of /
; qualify_*). `m`/`imp` change per module; `strict`/`bareok` are constant for the
; whole program (dump-resolved resolves with strict=true).
(defstruct Ctx
  [(a (ptr Allocator))
   (m (slice u8))
   (imp (ptr ImpEntry))
   (table (ptr (ArrayList DefEntry)))
   (exp (ptr (ArrayList ExpEntry)))
   (strict bool)
   (bareok (ptr (ArrayList (slice u8))))
   ; the function whose body is being qualified, so a resolve error can name it the
   ; way the checker's identical error already does ("in 'big.buried'") instead of
   ; naming the module. Empty outside a function body (const/meta/assert).
   (fname (slice u8))
   ; the collect-and-continue sink for recoverable body errors: every diagnostic, and
   ; the qualified names of the functions whose bodies failed (so the checker skips
   ; them). Shared across modules — resolve-program allocates them once.
   (diags (ptr (ArrayList Diag)))
   (poisoned (ptr (ArrayList (slice u8))))])

; The merged output program, sections as BY-VALUE ArrayLists so merge can push.
(defstruct Out
  [(conventions (ArrayList Convention))
   (structs (ArrayList StructDef))
   (sums (ArrayList SumDef))
   (externs (ArrayList Extern))
   (funcs (ArrayList Func))
   (asserts (ArrayList StaticAssert))
   (consts (ArrayList Const))
   (traits (ArrayList TraitDef))
   (impls (ArrayList ImplDef))
   (metas (ArrayList Expr))
   (exports (ArrayList ExportC))])

; ---- small generic + string helpers ---------------------------------------
; pointer to element i of an ArrayList reached by pointer (live, mutable).
(defn al-elem [T] [(p (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (primitive/index (primitive/load (primitive/field p data)) i))

(defn booleq [(x bool) (y bool)] (-> bool)
  (or (and x y) (and (not x) (not y))))

(defn has-dot [(s (slice u8))] (-> bool)
  (let [n (slice-len s)
        (mut i) 0
        (mut f) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/load i))) 46) (primitive/store! f true) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load f)))

(defn find-slash [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/load i))) 47) (primitive/store! r (primitive/load i)) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

; `(dyn Trait)` is currently parsed as the source-generated nominal `Trait-dyn`.
; Resolve that nominal THROUGH the originating trait rather than as an ordinary
; exported type: `(export Trait)` is the public contract, while the vtable and fat
; pointer structs emitted by `defdyn` remain implementation details.  Keeping this
; bridge here also makes nested uses such as `(Option (dyn Trait))` follow the normal
; recursive type qualifier.
(defn dyn-type-name? [(s (slice u8))] (-> bool)
  (let [n (slice-len s)]
    (and (primitive/icmp-ge n 4)
         (str-eq (subslice [u8] s (primitive/isub n 4) n) "-dyn"))))

(defn qualify-dyn-type [(c (ptr Ctx)) (name (slice u8))] (-> (Result (slice u8) Diag))
  (let [a (primitive/load (primitive/field c a))
        n (slice-len name)
        trait-name (subslice [u8] name 0 (primitive/isub n 4))]
    (match (resolve c trait-name 2)
      (Err [d] (Err [(slice u8) Diag] d))
      (Ok [trait-qual] (Ok [(slice u8) Diag] (sconcat a trait-qual "-dyn"))))))

; Index of the first `::` in a symbol, or -1 (byte 58 = ':'). A `Trait::method`
; qualified trait-method call (gen-6) carries the qualifier this way — the checker
; splits it in synth-call, so resolve leaves the head bare and exempts it from the
; strict undefined-reference check below.
(defn find-coloncolon [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-ge (primitive/load i) (primitive/isub n 1))
              (break)
              (do
                (when (and (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/load i))) 58)
                           (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/iadd (primitive/load i) 1))) 58))
                      (primitive/store! r (primitive/load i))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

(defn empty-strs [(a (ptr Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [bp (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
    (primitive/store! bp (al-new [(slice u8)] a))
    bp))

; is_scalar_typename: bool / f32 / f64 / (i|u)<digits>.
(defn is-scalar-typename [(s (slice u8))] (-> bool)
  (cond (str-eq s "bool") true
        (str-eq s "f32") true
        (str-eq s "f64") true
        :else
          (let [n (slice-len s)]
            (if (primitive/icmp-lt n 2)
                false
                (let [c0 (primitive/cast i64 (slice-get s 0))]
                  (if (or (primitive/icmp-eq c0 105) (primitive/icmp-eq c0 117))
                      (let [(mut ok) true
                            (mut j) 1]
                        (loop (if (primitive/icmp-ge (primitive/load j) n)
                                  (break)
                                  (do
                                    (let [ch (primitive/cast i64 (slice-get s (primitive/load j)))]
                                      (unless (and (primitive/icmp-ge ch 48) (primitive/icmp-le ch 57)) (primitive/store! ok false) (break)))
                                    (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                        (primitive/load ok))
                      false))))))

; ---- error messages (faithful to) --------------------------
(defn priv-msg [(a (ptr Allocator)) (m (slice u8)) (rest (slice u8)) (target (slice u8))] (-> (slice u8))
  (let [p1 (sconcat3 a "in module '" m "': '")
        p2 (sconcat3 a p1 rest "' is private to module '")]
    (sconcat3 a p2 target "' (add it to that module's (export …))")))
; Every callable name in the def table — the candidate pool for an undefined-call
; "did you mean" hint.
(defn all-callables [(a (ptr Allocator)) (table (ptr (ArrayList DefEntry)))] (-> (ptr (ArrayList (slice u8))))
  (let [n (al-len [DefEntry] (primitive/load table))
        (mut i) 0
        (mut out) (al-new [(slice u8)] a)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [cs (primitive/field (primitive/field (al-elem [DefEntry] table (primitive/load i)) defs) callables)
                      cn (al-len [(slice u8)] (primitive/load cs))
                      (mut j) 0]
                  (loop (if (primitive/icmp-ge (primitive/load j) cn)
                            (break)
                            (do
                              (al-push! (mut out) (al-get [(slice u8)] (primitive/load cs) (primitive/load j)))
                              (primitive/store! j (primitive/iadd (primitive/load j) 1))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (box-al [(slice u8)] a (primitive/load out))))
; `where` names the enclosing function when there is one, else the module — the checker
; emits this exact error and names the function, and resolve named only the module, so
; which one a user saw depended on whether the file had a (module …) declaration (diag-1).
; A "did you mean 'X'?" suggestion (nearest def-table name by edit distance) is appended
; when there's a near miss (diag-6).
(defn undef-msg [(a (ptr Allocator)) (c (ptr Ctx)) (func (slice u8))] (-> (slice u8))
  (let [fname (primitive/load (primitive/field c fname))
        where
          (if (primitive/icmp-gt (slice-len [u8] fname) 0)
              (sconcat3 a "in '" fname "'")
              (sconcat3 a "in module '" (primitive/load (primitive/field c m)) "'"))
        base (sconcat a (sconcat3 a where ": call to undefined function '" "") (sconcat a func "'"))]
    (match (nearest-name a (all-callables a (primitive/load (primitive/field c table))) func)
      (None [] base)
      (Some [s] (sconcat3 a base "; did you mean '" (sconcat a s "'?"))))))
(defn extern-conflict-msg [(a (ptr Allocator)) (nm (slice u8))] (-> (slice u8))
  (sconcat3 a "extern '" nm "' declared with conflicting signatures"))
(defn const-dup-msg [(a (ptr Allocator)) (nm (slice u8))] (-> (slice u8))
  (sconcat3 a "const '" nm "' defined more than once"))
; A bare name is exported by more than one `:use`d module. Resolving it first-import-wins
; would SILENTLY pick whichever import came first (reorder two import lines, run a different
; function). Same shape as the checker's trait-method ambiguity ("… is ambiguous — …"):
; name the competing modules and tell the user to disambiguate (NAMESPACING.md).
(defn use-ambig-msg [(a (ptr Allocator)) (m (slice u8)) (name (slice u8)) (m1 (slice u8)) (m2 (slice u8))] (-> (slice u8))
  (sconcat5 a
            (sconcat5 a "in module '" m "': '" name "' is ambiguous — exported by :use'd modules '")
            m1
            "' and '"
            m2
            "'; :use only one, or reach it qualified via an :as alias"))
; The SAME name is explicitly `:use [name]`'d from two different modules in one importer —
; the same silent collision, caught eagerly at the import instead of at a later use site.
(defn use-dup-msg [(a (ptr Allocator)) (m (slice u8)) (name (slice u8)) (m1 (slice u8)) (m2 (slice u8))] (-> (slice u8))
  (sconcat5 a
            (sconcat5 a "in module '" m "': '" name "' is explicitly :use'd from two modules '")
            m1
            "' and '"
            m2
            "' — :use it from only one"))
; diag-10: a `:use [name]` naming a symbol the target module does not export. Uses the SAME
; export table (`exports-check`) that resolution itself consults, so a name the resolver would
; treat as private/absent is named at the import site instead of silently accepted. A module
; with no (export …) exports everything, so only an explicit export list can trip this.
(defn use-unexported-msg [(a (ptr Allocator)) (m (slice u8)) (name (slice u8)) (target (slice u8))] (-> (slice u8))
  (let [p (sconcat5 a "in module '" m "': :use names '" name "', which module '")]
    (sconcat3 a p target "' does not export")))

; ---- table / import / export queries --------------------------------------
(defn defs-set [(d (ptr Defs)) (kind i64)] (-> (ptr (ArrayList (slice u8))))
  (cond (primitive/icmp-eq kind 0) (primitive/field d callables)
        (primitive/icmp-eq kind 1) (primitive/field d types)
        (primitive/icmp-eq kind 2) (primitive/field d traits)
        (primitive/icmp-eq kind 3) (primitive/field d convs)
        :else (primitive/field d externs)))

; The bit each `defs-set` kind occupies in an indexed name's mask. Same numbering as
; `defs-set` above, and the two must be read together.
(defn defs-kind-bit [(kind i64)] (-> i64)
  (cond (primitive/icmp-eq kind 0) 1
        (primitive/icmp-eq kind 1) 2
        (primitive/icmp-eq kind 2) 4
        (primitive/icmp-eq kind 3) 8
        :else 16))

(defn defs-index-kind! [(e (ptr DefEntry)) (lst (ptr (ArrayList (slice u8)))) (bit i64)] (-> i64)
  (let [n (al-len [(slice u8)] (primitive/load lst))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (let [k (al-get [(slice u8)] (primitive/load lst) (primitive/load i))
                    cur (match (hm-get [(slice u8) i64] (primitive/load (primitive/field e idx)) k)
                          (Some [v] v)
                          (None [] 0))]
                (hm-put! [(slice u8) i64] (mut (primitive/field e idx)) k (primitive/ior cur bit))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)

(defn defs-index-build! [(a (ptr Allocator)) (e (ptr DefEntry))] (-> i64)
  (primitive/store! (primitive/field e idx) (hm-new [(slice u8) i64] a (str-keyops)))
  (defs-index-kind! e (primitive/field (primitive/field e defs) callables) 1)
  (defs-index-kind! e (primitive/field (primitive/field e defs) types) 2)
  (defs-index-kind! e (primitive/field (primitive/field e defs) traits) 4)
  (defs-index-kind! e (primitive/field (primitive/field e defs) convs) 8)
  (defs-index-kind! e (primitive/field (primitive/field e defs) externs) 16)
  (primitive/store! (primitive/field e built) 1)
  0)

; Does module `e` define `name` as kind `kind`? The indexed answer when the index has
; been built, the original scan when it has not — identical results either way.
(defn defs-has? [(e (ptr DefEntry)) (kind i64) (name (slice u8))] (-> bool)
  (if (primitive/icmp-eq (primitive/load (primitive/field e built)) 0)
      (set-contains (defs-set (primitive/field e defs) kind) name)
      (match (hm-get [(slice u8) i64] (primitive/load (primitive/field e idx)) name)
        (None [] false)
        (Some [mask] (primitive/icmp-ne (primitive/iand mask (defs-kind-bit kind)) 0)))))

(defn set-contains [(setp (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (let [n (al-len [(slice u8)] (primitive/load setp))
        (mut i) 0
        (mut f) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (al-get [(slice u8)] (primitive/load setp) (primitive/load i)) name) (primitive/store! f true) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load f)))

(defn table-find [(table (ptr (ArrayList DefEntry))) (m (slice u8))] (-> (ptr DefEntry))
  (let [n (al-len [DefEntry] (primitive/load table))
        (mut i) 0
        (mut r) (primitive/cast (ptr DefEntry) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [DefEntry] table (primitive/load i)) module)) m)
                      (primitive/store! r (al-elem [DefEntry] table (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

(defn imports-find [(impb (ptr (ArrayList ImpEntry))) (m (slice u8))] (-> (ptr ImpEntry))
  (let [n (al-len [ImpEntry] (primitive/load impb))
        (mut i) 0
        (mut r) (primitive/cast (ptr ImpEntry) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [ImpEntry] impb (primitive/load i)) name)) m)
                      (primitive/store! r (al-elem [ImpEntry] impb (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

; macros::exports — `exports.get(m).map(contains).unwrap_or(true)`.
(defn exports-check [(expb (ptr (ArrayList ExpEntry))) (m (slice u8)) (name (slice u8))] (-> bool)
  (let [n (al-len [ExpEntry] (primitive/load expb))
        (mut i) 0
        (mut found) (primitive/cast (ptr ExpEntry) 0)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (primitive/load (primitive/field (al-elem [ExpEntry] expb (primitive/load i)) name)) m)
                      (primitive/store! found (al-elem [ExpEntry] expb (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/icmp-eq (primitive/cast i64 (primitive/load found)) 0) true (set-contains (primitive/field (primitive/load found) names) name))))

(defn alias-target [(imp (ptr ImpEntry)) (alias (slice u8))] (-> (Option (slice u8)))
  (let [als (primitive/field (primitive/field imp imp) aliases)
        n (al-len [Alias] (primitive/load als))
        (mut i) 0
        (mut r) (None [(slice u8)])]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ep (alloc/stack Alias)]
                  (primitive/store! ep (al-get [Alias] (primitive/load als) (primitive/load i)))
                  (when (str-eq (primitive/load (primitive/field ep alias)) alias) (primitive/store! r (Some (primitive/load (primitive/field ep target)))) (break)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))

; the `:use`d-modules branch of resolve (extracted so no try!/return runs in a loop).
; Now collision-aware: it scans ALL `:use`d modules rather than stopping at the first
; match, so a name exported by two distinct `:use`d modules is a hard ambiguity error
; instead of the old first-import-wins silent pick (tool-10). Distinct modules only —
; the same target reached via two `:use` entries is one module, not a collision.
(defn resolve-use [(c (ptr Ctx)) (imp (ptr ImpEntry)) (name (slice u8)) (kind i64)] (-> (Result (Option (slice u8))
                                                                                                Diag))
  (let [a (primitive/load (primitive/field c a))
        table (primitive/load (primitive/field c table))
        exp (primitive/load (primitive/field c exp))
        uses (primitive/field (primitive/field imp imp) uses)
        n (al-len [Use] (primitive/load uses))
        (mut i) 0
        (mut r) (None [(slice u8)])
        (mut m1) ""
        (mut m2) ""
        (mut cnt) 0]
    (loop (if (or (primitive/icmp-ge (primitive/load cnt) 2) (primitive/icmp-ge (primitive/load i) n))
              (break)
              (do
                (let [up (alloc/stack Use)]
                  (primitive/store! up (al-get [Use] (primitive/load uses) (primitive/load i)))
                  (let [target (primitive/load (primitive/field up target))
                        used (match (primitive/load (primitive/field up spec)) (UAll [] true) (UNames [names] (set-contains names name)))]
                    (when (and used (exports-check exp target name))
                          (let [td (table-find table target)]
                            (when (and (primitive/icmp-ne (primitive/cast i64 td) 0) (defs-has? td kind name))
                                  (if (primitive/icmp-eq (primitive/load cnt) 0)
                                      (do
                                        (primitive/store! r (Some (sconcat3 a target "." name)))
                                        (primitive/store! m1 target)
                                        (primitive/store! cnt 1)
                                        0)
                                      (unless (str-eq (primitive/load m1) target) (primitive/store! m2 target) (primitive/store! cnt 2) 0)))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/icmp-ge (primitive/load cnt) 2)
        (Err [(Option (slice u8)) Diag] (derr (use-ambig-msg a (primitive/load (primitive/field c m)) name (primitive/load m1) (primitive/load m2))))
        (Ok [(Option (slice u8)) Diag] (primitive/load r)))))

; — kind: 0 callables, 1 types, 2 traits, 3 convs.
; ── the name-resolution memo ─────────────────────────────────────────────────
; `resolve` is called once per IDENTIFIER, and the answer costs an allocation before it
; can be returned: the qualified name is built with sconcat3 every time. Identifiers
; repeat relentlessly — `load`, `store!`, `al-len`, `icmp-eq` — and within one module the
; answer is a pure function of (name, kind): the def table, imports and exports are all
; fixed for the whole resolve pass.
;
; So it is memoised per module, with one map per kind so the kind need not be encoded
; into the key. Only successes are cached: a failure carries a Diag whose message is
; built for the site that raised it, and reusing one would misreport the second site.
; The memo is dropped whenever the module changes.
(defstruct ResMemo
  [(mod (slice u8)) (valid i64)
   (k0 (HashMap (slice u8) (slice u8))) (k1 (HashMap (slice u8) (slice u8)))
   (k2 (HashMap (slice u8) (slice u8))) (k3 (HashMap (slice u8) (slice u8)))
   (k4 (HashMap (slice u8) (slice u8)))])
(defn res-memo [] (-> (ptr ResMemo))
  (alloc/static ResMemo))
(defn res-memo-map [(rm (ptr ResMemo)) (kind i64)] (-> (ptr (HashMap (slice u8) (slice u8))))
  (cond (primitive/icmp-eq kind 0) (primitive/field rm k0)
        (primitive/icmp-eq kind 1) (primitive/field rm k1)
        (primitive/icmp-eq kind 2) (primitive/field rm k2)
        (primitive/icmp-eq kind 3) (primitive/field rm k3)
        :else (primitive/field rm k4)))
(defn res-memo-reset! [(rm (ptr ResMemo)) (m (slice u8))] (-> i64)
  (let [a (malloc-allocator)]
    (primitive/store! (primitive/field rm k0) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
    (primitive/store! (primitive/field rm k1) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
    (primitive/store! (primitive/field rm k2) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
    (primitive/store! (primitive/field rm k3) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
    (primitive/store! (primitive/field rm k4) (hm-new [(slice u8) (slice u8)] a (str-keyops)))
    (primitive/store! (primitive/field rm mod) m)
    (primitive/store! (primitive/field rm valid) 1)
    0))
(defn resolve [(c (ptr Ctx)) (name (slice u8)) (kind i64)] (-> (Result (slice u8) Diag))
  (let [rm (res-memo)
        m (primitive/load (primitive/field c m))]
    (when (or (primitive/icmp-eq (primitive/load (primitive/field rm valid)) 0) (not (str-eq (primitive/load (primitive/field rm mod)) m)))
          (res-memo-reset! rm m))
    (let [mp (res-memo-map rm kind)]
      (match (hm-get [(slice u8) (slice u8)] (primitive/load mp) name)
        (Some [hit] (Ok [(slice u8) Diag] hit))
        (None []
              (match (resolve-uncached c name kind)
                (Err [d] (Err [(slice u8) Diag] d))
                (Ok [q]
                    (do
                      (hm-put! [(slice u8) (slice u8)] (mut mp) name q)
                      (Ok [(slice u8) Diag] q)))))))))

(defn resolve-uncached [(c (ptr Ctx)) (name (slice u8)) (kind i64)] (-> (Result (slice u8) Diag))
  (let [a (primitive/load (primitive/field c a))
        m (primitive/load (primitive/field c m))
        imp (primitive/load (primitive/field c imp))
        table (primitive/load (primitive/field c table))
        exp (primitive/load (primitive/field c exp))
        sl (find-slash name)]
    (if (primitive/icmp-ge sl 0)
        (let [alias (subslice name 0 sl)
              rest (subslice name (primitive/iadd sl 1) (slice-len name))]
          (if (primitive/icmp-ne (primitive/cast i64 imp) 0)
              (match (alias-target imp alias)
                (Some [target]
                      (if (not (exports-check exp target rest))
                          (Err [(slice u8) Diag] (derr (priv-msg a m rest target)))
                          (Ok [(slice u8) Diag] (sconcat3 a target "." rest))))
                (None [] (Ok [(slice u8) Diag] name)))
              (Ok [(slice u8) Diag] name)))
        (let [tf (table-find table m)]
          (if (and (primitive/icmp-ne (primitive/cast i64 tf) 0) (defs-has? tf kind name))
              (Ok [(slice u8) Diag] (sconcat3 a m "." name))
              (match (if (primitive/icmp-ne (primitive/cast i64 imp) 0)
                         (resolve-use c imp name kind)
                         (Ok [(Option (slice u8)) Diag] (None [(slice u8)])))
                (Err [d] (Err [(slice u8) Diag] d))
                (Ok [used-opt]
                    (match used-opt
                      (Some [q] (Ok [(slice u8) Diag] q))
                      (None []
                            (if (not (str-eq m "coil.core"))
                                (let [ct (table-find table "coil.core")]
                                  (if (and (and (primitive/icmp-ne (primitive/cast i64 ct) 0)
                                                (defs-has? ct kind name))
                                           (exports-check exp "coil.core" name))
                                      (Ok [(slice u8) Diag] (sconcat3 a "coil.core" "." name))
                                      (Ok [(slice u8) Diag] name)))
                                (Ok [(slice u8) Diag] name)))))))))))

; ---- type-equality (for extern dedup in merge) ----------------------------
; All take/recurse on `(ptr Type)` — passing a `Type` sum BY VALUE into a recursive
; call corrupts its payload (Coil by-value-aggregate-in-recursion bug), so we keep
; everything behind pointers (as the rest of the resolver does for aggregates).
(defn type-tag [(t (ptr Type))] (-> i64)
  (match (primitive/load t)
    (TInt [_ _] 0)
    (TFloat [_] 1)
    (TBool [] 2)
    (TVoid [] 3)
    (TPtr [_] 4)
    (TRef [_ _] 5)
    (TStruct [_] 6)
    (TArray [_ _] 7)
    (TSlice [_] 8)
    (TVec [_ _] 9)
    (TFn [_ _ _] 10)
    (TApp [_ _] 11)
    (TNever [] 12)
    (TCode [] 13)
    (TExternRef [] 14)))
(defn t-inner [(t (ptr Type))] (-> (ptr Type))
  (match (primitive/load t)
    (TPtr [i] i)
    (TRef [_ i] i)
    (TArray [i _] i)
    (TSlice [i] i)
    (TVec [i _] i)
    (TInt [_ _] (do (loader-abort "t-inner: not a wrapper type") (box-type (malloc-allocator) (TVoid))))
    (TFloat [_] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TBool [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TVoid [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TStruct [_] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TFn [_ _ _] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TApp [_ _] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TNever [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TCode [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))
    (TExternRef [] (do (loader-abort "t-inner") (box-type (malloc-allocator) (TVoid))))))
(defn type-struct-name [(t (ptr Type))] (-> (slice u8))
  (match (primitive/load t)
    (TStruct [n] n)
    (TInt [_ _] (do (loader-abort "type-struct-name: not a struct") ""))
    (TFloat [_] (do (loader-abort "type-struct-name") ""))
    (TBool [] (do (loader-abort "type-struct-name") ""))
    (TVoid [] (do (loader-abort "type-struct-name") ""))
    (TPtr [_] (do (loader-abort "type-struct-name") ""))
    (TRef [_ _] (do (loader-abort "type-struct-name") ""))
    (TArray [_ _] (do (loader-abort "type-struct-name") ""))
    (TSlice [_] (do (loader-abort "type-struct-name") ""))
    (TVec [_ _] (do (loader-abort "type-struct-name") ""))
    (TFn [_ _ _] (do (loader-abort "type-struct-name") ""))
    (TApp [_ _] (do (loader-abort "type-struct-name") ""))
    (TNever [] (do (loader-abort "type-struct-name") ""))
    (TCode [] (do (loader-abort "type-struct-name") ""))
    (TExternRef [] (do (loader-abort "type-struct-name") ""))))
(defn t-int-bits [(t (ptr Type))] (-> i64)
  (match (primitive/load t)
    (TInt [b _] b)
    (TFloat [b] b)
    (TBool [] 0)
    (TVoid [] 0)
    (TPtr [_] 0)
    (TRef [_ _] 0)
    (TStruct [_] 0)
    (TArray [_ _] 0)
    (TSlice [_] 0)
    (TVec [_ _] 0)
    (TFn [_ _ _] 0)
    (TApp [_ _] 0)
    (TNever [] 0)
    (TCode [] 0)
    (TExternRef [] 0)))
(defn t-int-signed [(t (ptr Type))] (-> bool)
  (match (primitive/load t)
    (TInt [_ s] s)
    (TFloat [_] false)
    (TBool [] false)
    (TVoid [] false)
    (TPtr [_] false)
    (TRef [_ _] false)
    (TStruct [_] false)
    (TArray [_ _] false)
    (TSlice [_] false)
    (TVec [_ _] false)
    (TFn [_ _ _] false)
    (TApp [_ _] false)
    (TNever [] false)
    (TCode [] false)
    (TExternRef [] false)))
(defn t-ref-mut [(t (ptr Type))] (-> bool)
  (match (primitive/load t)
    (TRef [m _] m)
    (TInt [_ _] false)
    (TFloat [_] false)
    (TBool [] false)
    (TVoid [] false)
    (TPtr [_] false)
    (TStruct [_] false)
    (TArray [_ _] false)
    (TSlice [_] false)
    (TVec [_ _] false)
    (TFn [_ _ _] false)
    (TApp [_ _] false)
    (TNever [] false)
    (TCode [] false)
    (TExternRef [] false)))
(defn t-arrn [(t (ptr Type))] (-> i64)
  (match (primitive/load t)
    (TArray [_ n] n)
    (TVec [_ n] n)
    (TInt [_ _] 0)
    (TFloat [_] 0)
    (TBool [] 0)
    (TVoid [] 0)
    (TPtr [_] 0)
    (TRef [_ _] 0)
    (TStruct [_] 0)
    (TSlice [_] 0)
    (TFn [_ _ _] 0)
    (TApp [_ _] 0)
    (TNever [] 0)
    (TCode [] 0)
    (TExternRef [] 0)))
(defn t-fn-cc [(t (ptr Type))] (-> (slice u8))
  (match (primitive/load t)
    (TFn [cc _ _] cc)
    (TInt [_ _] "")
    (TFloat [_] "")
    (TBool [] "")
    (TVoid [] "")
    (TPtr [_] "")
    (TRef [_ _] "")
    (TStruct [_] "")
    (TArray [_ _] "")
    (TSlice [_] "")
    (TVec [_ _] "")
    (TApp [_ _] "")
    (TNever [] "")
    (TCode [] "")
    (TExternRef [] "")))
(defn t-fn-params [(t (ptr Type))] (-> (ptr (ArrayList Type)))
  (match (primitive/load t)
    (TFn [_ p _] p)
    (TApp [_ args] args)
    (TInt [_ _] (box-items-type (malloc-allocator)))
    (TFloat [_] (box-items-type (malloc-allocator)))
    (TBool [] (box-items-type (malloc-allocator)))
    (TVoid [] (box-items-type (malloc-allocator)))
    (TPtr [_] (box-items-type (malloc-allocator)))
    (TRef [_ _] (box-items-type (malloc-allocator)))
    (TStruct [_] (box-items-type (malloc-allocator)))
    (TArray [_ _] (box-items-type (malloc-allocator)))
    (TSlice [_] (box-items-type (malloc-allocator)))
    (TVec [_ _] (box-items-type (malloc-allocator)))
    (TNever [] (box-items-type (malloc-allocator)))
    (TCode [] (box-items-type (malloc-allocator)))
    (TExternRef [] (box-items-type (malloc-allocator)))))
(defn t-fn-ret [(t (ptr Type))] (-> (ptr Type))
  (match (primitive/load t)
    (TFn [_ _ r] r)
    (TInt [_ _] (box-type (malloc-allocator) (TVoid)))
    (TFloat [_] (box-type (malloc-allocator) (TVoid)))
    (TBool [] (box-type (malloc-allocator) (TVoid)))
    (TVoid [] (box-type (malloc-allocator) (TVoid)))
    (TPtr [_] (box-type (malloc-allocator) (TVoid)))
    (TRef [_ _] (box-type (malloc-allocator) (TVoid)))
    (TStruct [_] (box-type (malloc-allocator) (TVoid)))
    (TArray [_ _] (box-type (malloc-allocator) (TVoid)))
    (TSlice [_] (box-type (malloc-allocator) (TVoid)))
    (TVec [_ _] (box-type (malloc-allocator) (TVoid)))
    (TApp [_ _] (box-type (malloc-allocator) (TVoid)))
    (TNever [] (box-type (malloc-allocator) (TVoid)))
    (TCode [] (box-type (malloc-allocator) (TVoid)))
    (TExternRef [] (box-type (malloc-allocator) (TVoid)))))
(defn t-app-name [(t (ptr Type))] (-> (slice u8))
  (match (primitive/load t)
    (TApp [n _] n)
    (TInt [_ _] "")
    (TFloat [_] "")
    (TBool [] "")
    (TVoid [] "")
    (TPtr [_] "")
    (TRef [_ _] "")
    (TStruct [_] "")
    (TArray [_ _] "")
    (TSlice [_] "")
    (TVec [_ _] "")
    (TFn [_ _ _] "")
    (TNever [] "")
    (TCode [] "")
    (TExternRef [] "")))
(defn box-items-type [(a (ptr Allocator))] (-> (ptr (ArrayList Type)))
  (let [bp (unwrap-ptr [(ArrayList Type)] (create [(ArrayList Type)] a))] (primitive/store! bp (al-new [Type] a)) bp))

(defn type-list-eq [(xs (ptr (ArrayList Type))) (ys (ptr (ArrayList Type)))] (-> bool)
  (let [nx (al-len [Type] (primitive/load xs))
        ny (al-len [Type] (primitive/load ys))]
    (if (not (primitive/icmp-eq nx ny))
        false
        (let [(mut i) 0
              (mut ok) true]
          (loop (if (primitive/icmp-ge (primitive/load i) nx)
                    (break)
                    (do
                      (when (not (type-eq (al-elem [Type] xs (primitive/load i)) (al-elem [Type] ys (primitive/load i))))
                            (primitive/store! ok false)
                            (break))
                      (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
          (primitive/load ok)))))
(defn type-eq [(x (ptr Type)) (y (ptr Type))] (-> bool)
  (if (not (primitive/icmp-eq (type-tag x) (type-tag y)))
      false
      (let [tg (type-tag x)]
        (cond (primitive/icmp-eq tg 0) (and (primitive/icmp-eq (t-int-bits x) (t-int-bits y)) (booleq (t-int-signed x) (t-int-signed y)))
              (primitive/icmp-eq tg 1) (primitive/icmp-eq (t-int-bits x) (t-int-bits y))
              (primitive/icmp-eq tg 2) true
              (primitive/icmp-eq tg 3) true
              (primitive/icmp-eq tg 4) (type-eq (t-inner x) (t-inner y))
              (primitive/icmp-eq tg 5) (and (booleq (t-ref-mut x) (t-ref-mut y)) (type-eq (t-inner x) (t-inner y)))
              (primitive/icmp-eq tg 6) (str-eq (type-struct-name x) (type-struct-name y))
              (primitive/icmp-eq tg 7) (and (primitive/icmp-eq (t-arrn x) (t-arrn y)) (type-eq (t-inner x) (t-inner y)))
              (primitive/icmp-eq tg 8) (type-eq (t-inner x) (t-inner y))
              (primitive/icmp-eq tg 9) (and (primitive/icmp-eq (t-arrn x) (t-arrn y)) (type-eq (t-inner x) (t-inner y)))
              (primitive/icmp-eq tg 10)
                (and (str-eq (t-fn-cc x) (t-fn-cc y))
                     (and (type-list-eq (t-fn-params x) (t-fn-params y))
                          (type-eq (t-fn-ret x) (t-fn-ret y))))
              (primitive/icmp-eq tg 11)
                (and (str-eq (t-app-name x) (t-app-name y))
                     (type-list-eq (t-fn-params x) (t-fn-params y)))
              :else true))))

(defn extern-eq [(x (ptr Extern)) (y (ptr Extern))] (-> bool)
  (and (str-eq (primitive/load (primitive/field x cc)) (primitive/load (primitive/field y cc)))
       (and (type-list-eq (primitive/load (primitive/field x params)) (primitive/load (primitive/field y params)))
            (and (booleq (primitive/load (primitive/field x variadic)) (primitive/load (primitive/field y variadic)))
                 (type-eq (primitive/field x ret) (primitive/field y ret))))))

; ============================ foundation =============================
; display_name — strip the auto-referred "coil.core." prefix
; from a name for diagnostics. "coil.core." is 10 bytes.
(defn ty-str-join [(a (ptr Allocator)) (v (ptr (ArrayList Type)))] (-> (slice u8))
  (let [(mut out) ""
        n (al-len [Type] (primitive/load v))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (primitive/store! out (sconcat a (primitive/load out) " ")) 0)
                (let [tp (alloc/stack Type)]
                  (primitive/store! tp (al-get [Type] (primitive/load v) (primitive/load i)))
                  (primitive/store! out (sconcat a (primitive/load out) (ty-str a tp))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load out)))

; A synthetic associated type minted for an associated-type bound
; (check.coil::assoc-tp-name) is spelled `C$assoc$Get$K`. Render it readably as
; `<C as Get>::K` in diagnostics. No ordinary type name contains `$assoc$`, so
; `assoc-marker-at` returns -1 for every real type and this is a no-op there —
; existing ty-str output is byte-for-byte unchanged.
(defn assoc-marker-at [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        mk "$assoc$"
        mn (slice-len mk)
        (mut i) 0
        (mut r) -1]
    (loop (if (primitive/icmp-gt (primitive/iadd (primitive/load i) mn) n)
              (break)
              (do
                (when (str-eq (subslice [u8] s (primitive/load i) (primitive/iadd (primitive/load i) mn)) mk) (primitive/store! r (primitive/load i)) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn last-dollar [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) (primitive/isub n 1)
        (mut r) -1]
    (loop (if (primitive/icmp-lt (primitive/load i) 0)
              (break)
              (do
                (when (primitive/icmp-eq (primitive/cast i64 (slice-get s (primitive/load i))) 36) (primitive/store! r (primitive/load i)) (break))
                (primitive/store! i (primitive/isub (primitive/load i) 1)))))
    (primitive/load r)))
(defn assoc-render [(a (ptr Allocator)) (s (slice u8))] (-> (slice u8))
  (let [mi (assoc-marker-at s)]
    (if (primitive/icmp-lt mi 0)
        s
        (let [base (subslice [u8] s 0 mi)
              rest (subslice [u8] s (primitive/iadd mi 7) (slice-len s))
              di (last-dollar rest)]
          (if (primitive/icmp-lt di 0)
              s
              (let [tr (subslice [u8] rest 0 di)
                    p (subslice [u8] rest (primitive/iadd di 1) (slice-len rest))]
                (sconcat a "<" (sconcat a base (sconcat a " as " (sconcat3 a tr ">::" p))))))))))

(defn ty-str [(a (ptr Allocator)) (t (ptr Type))] (-> (slice u8))
  (let [tg (type-tag t)]
    (cond (primitive/icmp-eq tg 12) "!"
          (primitive/icmp-eq tg 14) "externref"
          (primitive/icmp-eq tg 13) "code"
          (primitive/icmp-eq tg 3) "void"
          (primitive/icmp-eq tg 0) (sconcat a (if (t-int-signed t) "i" "u") (i64->str a (t-int-bits t)))
          (primitive/icmp-eq tg 1) (sconcat a "f" (i64->str a (t-int-bits t)))
          (primitive/icmp-eq tg 2) "bool"
          (primitive/icmp-eq tg 4) (sconcat3 a "(ptr " (ty-str a (t-inner t)) ")")
          (primitive/icmp-eq tg 5)
            (if (t-ref-mut t)
                (sconcat3 a "(mut " (ty-str a (t-inner t)) ")")
                (sconcat3 a "(ref " (ty-str a (t-inner t)) ")"))
          (primitive/icmp-eq tg 6) (assoc-render a (type-struct-name t))
          (primitive/icmp-eq tg 7)
            (sconcat3 a
                      (sconcat3 a "(array " (ty-str a (t-inner t)) " ")
                      (i64->str a (t-arrn t))
                      ")")
          (primitive/icmp-eq tg 8) (sconcat3 a "(slice " (ty-str a (t-inner t)) ")")
          (primitive/icmp-eq tg 9)
            (sconcat3 a
                      (sconcat3 a "(vec " (ty-str a (t-inner t)) " ")
                      (i64->str a (t-arrn t))
                      ")")
          (primitive/icmp-eq tg 10)
            (sconcat3 a
                      (sconcat3 a
                                (sconcat3 a "(fnptr " (t-fn-cc t) " [")
                                (ty-str-join a (t-fn-params t))
                                "] ")
                      (ty-str a (t-fn-ret t))
                      ")")
          :else
            (sconcat3 a
                      (sconcat3 a "(" (t-app-name t) " ")
                      (ty-str-join a (t-fn-params t))
                      ")"))))

; ---- qualify a Type in place ----------------
(defn qualify-type-list [(c (ptr Ctx)) (lst (ptr (ArrayList Type))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                    Diag))
  (let [n (al-len [Type] (primitive/load lst))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-type c (al-elem [Type] lst (primitive/load i)) tps)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn qualify-type [(c (ptr Ctx)) (typ (ptr Type)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (primitive/load (primitive/field c a))]
    (match (primitive/load typ)
      (TNever [] (Ok [i64 Diag] 0))
      (TCode [] (Ok [i64 Diag] 0))
      (TExternRef [] (Ok [i64 Diag] 0))
      (TBool [] (Ok [i64 Diag] 0))
      (TVoid [] (Ok [i64 Diag] 0))
      (TInt [_ _] (Ok [i64 Diag] 0))
      (TFloat [_] (Ok [i64 Diag] 0))
      (TStruct [nm]
               (if (set-contains tps nm)
                   (Ok [i64 Diag] 0)
                   (match (if (dyn-type-name? nm) (qualify-dyn-type c nm) (resolve c nm 1))
                     (Err [d] (Err [i64 Diag] d))
                     (Ok [nn]
                         (do (type-res-record (primitive/load (primitive/field c m)) nm nn) (primitive/store! typ (TStruct nn)) (Ok [i64 Diag] 0))))))
      (TApp [nm args]
            (let [r0
                    (if (set-contains tps nm)
                        (Ok [i64 Diag] 0)
                        (match (resolve c nm 1)
                          (Err [d] (Err [i64 Diag] d))
                          (Ok [nn]
                              (do
                                (type-res-record (primitive/load (primitive/field c m)) nm nn)
                                (primitive/store! typ (TApp nn args))
                                (Ok [i64 Diag] 0)))))]
              (match r0
                (Err [d] (Err [i64 Diag] d))
                (Ok [_] (qualify-type-list c args tps)))))
      (TPtr [inner] (qualify-type c inner tps))
      (TRef [mu inner] (qualify-type c inner tps))
      (TArray [inner nn] (qualify-type c inner tps))
      (TSlice [inner] (qualify-type c inner tps))
      (TVec [inner nn] (qualify-type c inner tps))
      (TFn [cc params ret]
           (match (resolve c cc 3)
             (Err [d] (Err [i64 Diag] d))
             (Ok [ncc]
                 (do
                   (primitive/store! typ (TFn ncc params ret))
                   (match (qualify-type-list c params tps)
                     (Err [d] (Err [i64 Diag] d))
                     (Ok [_] (qualify-type c ret tps))))))))))

; ---- qualify Exprs / quasi / lists ----------
(defn qualify-expr-list [(c (ptr Ctx)) (lst (ptr (ArrayList Expr))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                    Diag))
  (let [n (al-len [Expr] (primitive/load lst))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-expr c (al-elem [Expr] lst (primitive/load i)) tps)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn qualify-bind-list [(c (ptr Ctx)) (binds (ptr (ArrayList Bind))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                      Diag))
  (let [n (al-len [Bind] (primitive/load binds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-expr c (primitive/field (al-elem [Bind] binds (primitive/load i)) value) tps)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn qualify-arm-list [(c (ptr Ctx)) (arms (ptr (ArrayList Arm))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                   Diag))
  (let [n (al-len [Arm] (primitive/load arms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ap (al-elem [Arm] arms (primitive/load i))]
                  (match (resolve c (primitive/load (primitive/field ap variant)) 0)
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [nv]
                        (do
                          (primitive/store! (primitive/field ap variant) nv)
                          (match (qualify-expr c (primitive/field ap body) tps)
                            (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                            (Ok [_] 0))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn qualify-quasi-list [(c (ptr Ctx)) (items (ptr (ArrayList Quasi))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                        Diag))
  (let [n (al-len [Quasi] (primitive/load items))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-quasi c (al-elem [Quasi] items (primitive/load i)) tps)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn qualify-quasi [(c (ptr Ctx)) (qp (ptr Quasi)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (match (primitive/load qp)
    (QLit [_] (Ok [i64 Diag] 0))
    (QUnquote [e] (qualify-expr c e tps))
    (QSplice [e] (qualify-expr c e tps))
    (QList [items] (qualify-quasi-list c items tps))
    (QVector [items] (qualify-quasi-list c items tps))))
(defn qualify-expr [(c (ptr Ctx)) (ep (ptr Expr)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (primitive/load (primitive/field c a))]
    (try (do
           (match (primitive/load (primitive/field ep kind))
             (EInt [_] 0)
             (EFloat [_] 0)
             (EBool [_] 0)
             (EStr [_] 0)
             (ECStr [_] 0)
             (EVar [_] 0)
             (EZeroed [t]
                      (do
                        (let [tp (alloc/stack Type)]
                          (primitive/store! tp t)
                          (try! (qualify-type c tp tps))
                          (primitive/store! (primitive/field ep kind) (EZeroed (primitive/load tp))))
                        0))
             (EBorrow [mu place] (do (try! (qualify-expr c place tps)) 0))
             (ELet [binds body] (do (try! (qualify-bind-list c binds tps)) (try! (qualify-expr-list c body tps)) 0))
             (EBin [op lhs rhs] (do (try! (qualify-expr c lhs tps)) (try! (qualify-expr c rhs tps)) 0))
             (ENot [inner] (do (try! (qualify-expr c inner tps)) 0))
             (ECmp [op lhs rhs] (do (try! (qualify-expr c lhs tps)) (try! (qualify-expr c rhs tps)) 0))
             (EIf [cnd thn els]
                  (do (try! (qualify-expr c cnd tps)) (try! (qualify-expr c thn tps)) (try! (qualify-expr c els tps)) 0))
             (EDo [body] (do (try! (qualify-expr-list c body tps)) 0))
             (ECall [func type_args args]
                    (do
                      (let [nf (try! (resolve c func 0))]
                        (primitive/store! (primitive/field ep kind) (ECall nf type_args args))
                        ; A `Trait::method` qualified call (gen-6) is validated in the checker
                        ; (synth-call splits it and pins the trait), so it is not an undefined
                        ; reference here even though the whole head is not a def-table name.
                        (when (and (primitive/load (primitive/field c strict))
                                   (and (primitive/icmp-lt (find-coloncolon nf) 0)
                                        (and (not (has-dot nf)) (not (set-contains (primitive/load (primitive/field c bareok)) nf)))))
                              (break ; `ep` IS the call node — its span was right here and simply unused,
                                     ; so the language's most common error lost its location the moment a
                                     ; file declared a module (i.e. in every real multi-file project). The
                                     ; message itself now also carries the did-you-mean suggestion (diag-6).
                                     :try
                                     (Err (dwspan (derr (undef-msg a c nf))
                                                  (primitive/load (primitive/field ep source))
                                                  (primitive/load (primitive/field ep lo))
                                                  (primitive/load (primitive/field ep hi))
                                                  (primitive/load (primitive/field ep ctxt)))))))
                      (try! (qualify-type-list c type_args tps))
                      (try! (qualify-expr-list c args tps))
                      0))
             (EAlloc [storage t]
                     (do
                       (let [tp (alloc/stack Type)]
                         (primitive/store! tp t)
                         (try! (qualify-type c tp tps))
                         (primitive/store! (primitive/field ep kind) (EAlloc storage (primitive/load tp))))
                       0))
             (EField [p fname] (do (try! (qualify-expr c p tps)) 0))
             (ELoad [inner] (do (try! (qualify-expr c inner tps)) 0))
             (EStore [p val] (do (try! (qualify-expr c p tps)) (try! (qualify-expr c val tps)) 0))
             (EIndex [p idx] (do (try! (qualify-expr c p tps)) (try! (qualify-expr c idx tps)) 0))
             (ECast [t inner]
                    (do
                      (let [tp (alloc/stack Type)]
                        (primitive/store! tp t)
                        (try! (qualify-type c tp tps))
                        (primitive/store! (primitive/field ep kind) (ECast (primitive/load tp) inner)))
                      (try! (qualify-expr c inner tps))
                      0))
             (EAscribe [t inner]
                       (do
                         (let [tp (alloc/stack Type)]
                           (primitive/store! tp t)
                           (try! (qualify-type c tp tps))
                           (primitive/store! (primitive/field ep kind) (EAscribe (primitive/load tp) inner)))
                         (try! (qualify-expr c inner tps))
                         0))
             (ESizeOf [t]
                      (do
                        (let [tp (alloc/stack Type)]
                          (primitive/store! tp t)
                          (try! (qualify-type c tp tps))
                          (primitive/store! (primitive/field ep kind) (ESizeOf (primitive/load tp))))
                        0))
             (EAlignOf [t]
                       (do
                         (let [tp (alloc/stack Type)]
                           (primitive/store! tp t)
                           (try! (qualify-type c tp tps))
                           (primitive/store! (primitive/field ep kind) (EAlignOf (primitive/load tp))))
                         0))
             (EOffsetOf [t fname]
                        (do
                          (let [tp (alloc/stack Type)]
                            (primitive/store! tp t)
                            (try! (qualify-type c tp tps))
                            (primitive/store! (primitive/field ep kind) (EOffsetOf (primitive/load tp) fname)))
                          0))
             (EBitGet [p fname] (do (try! (qualify-expr c p tps)) 0))
             (EBitSet [p fname val] (do (try! (qualify-expr c p tps)) (try! (qualify-expr c val tps)) 0))
             (EFree [inner] (do (try! (qualify-expr c inner tps)) 0))
             (EErase [trait_name inner]
                     (do
                       (let [tp (alloc/stack Type)]
                         (primitive/store! tp (TStruct trait_name))
                         (try! (qualify-type c tp tps))
                         (primitive/store! (primitive/field ep kind) (EErase (type-struct-name tp) inner)))
                       (try! (qualify-expr c inner tps))
                       0))
             (EMatch [scrut arms] (do (try! (qualify-expr c scrut tps)) (try! (qualify-arm-list c arms tps)) 0))
             (EFnPtrOf [nm] (do (let [nn (try! (resolve c nm 0))] (primitive/store! (primitive/field ep kind) (EFnPtrOf nn))) 0))
             (ECallPtr [fp args] (do (try! (qualify-expr c fp tps)) (try! (qualify-expr-list c args tps)) 0))
             (ELoop [label body] (do (try! (qualify-expr-list c body tps)) 0))
             (EBreak [label value] (do (match value (Some [vp] (try! (qualify-expr c vp tps))) (None [] 0)) 0))
             (EContinue [label] 0)
             (ELlvmIr [result args body]
                      (do
                        (let [tp (alloc/stack Type)]
                          (primitive/store! tp result)
                          (try! (qualify-type c tp tps))
                          (primitive/store! (primitive/field ep kind) (ELlvmIr (primitive/load tp) args body)))
                        (try! (qualify-expr-list c args tps))
                        0))
             (ETypeQuery [q t]
                         (do
                           (let [tp (alloc/stack Type)]
                             (primitive/store! tp t)
                             (try! (qualify-type c tp tps))
                             (primitive/store! (primitive/field ep kind) (ETypeQuery q (primitive/load tp))))
                           0))
             (EFieldMeta [meta t idx]
                         (do
                           (let [tp (alloc/stack Type)]
                             (primitive/store! tp t)
                             (try! (qualify-type c tp tps))
                             (primitive/store! (primitive/field ep kind) (EFieldMeta meta (primitive/load tp) idx)))
                           (try! (qualify-expr c idx tps))
                           0))
             (EFieldIndex [t nm]
                          (do
                            (let [tp (alloc/stack Type)]
                              (primitive/store! tp t)
                              (try! (qualify-type c tp tps))
                              (primitive/store! (primitive/field ep kind) (EFieldIndex (primitive/load tp) nm)))
                            (try! (qualify-expr c nm tps))
                            0))
             (EQuote [form] 0)
             (ECodeOp [op args] (do (try! (qualify-expr-list c args tps)) 0))
             (EQuasi [q] (do (let [qp (alloc/stack Quasi)] (primitive/store! qp q) (try! (qualify-quasi c qp tps))) 0))
             (EComptime [inner] (do (try! (qualify-expr c inner tps)) 0))
             ; ---- check-introduced variants: cannot occur during resolve (they are
             ; produced by the LATER check pass), so reaching them here is a bug. ----
             (ESpillRef [_] (do (unimplemented "qualify/ESpillRef") 0))
             (EConstruct [_ _ _] (do (unimplemented "qualify/EConstruct") 0))
             (ETraitCall [_ _ _ _] (do (unimplemented "qualify/ETraitCall") 0))
             (EDynDispatch [_ _ _ _ _ _ _ _] (do (unimplemented "qualify/EDynDispatch") 0))
             (EMakeDyn [_ _ _ _] (do (unimplemented "qualify/EMakeDyn") 0))
             (EStaticRef [_] (do (unimplemented "qualify/EStaticRef") 0)))
           (Ok 0)))))

; ---- qualify per-section helpers ---------
(defn qualify-param-types [(c (ptr Ctx)) (ps (ptr (ArrayList Param))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                      Diag))
  (let [n (al-len [Param] (primitive/load ps))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-type c (primitive/field (al-elem [Param] ps (primitive/load i)) ty) tps)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn qualify-field-types [(c (ptr Ctx)) (fs (ptr (ArrayList Field))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                      Diag))
  (let [n (al-len [Field] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-type c (primitive/field (al-elem [Field] fs (primitive/load i)) ty) tps)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
; `resolve` is deliberately lenient: a name it cannot find passes through UNQUALIFIED
; (bare), because some names resolve later (builtins, coil.core methods). A real trait
; always resolves to `module.Trait` — so a bound trait that comes back with no dot names
; a trait that exists nowhere. That was accepted silently: `(defn f [(T NoSuchTrait)] …)`
; compiled, and only failed at the CALL site as "i64 does not implement NoSuchTrait" —
; which is nonsense, since no type could ever implement a trait that doesn't exist. Catch
; it here, at the definition, where it belongs.
; THE single trait-name resolver for every bound position (defn/defstruct/defsum/impl
; trait, and `:requires` supertraits). `resolve` is lenient — an unknown name passes
; through bare — but a real trait (kind 2) always comes back as `module.Trait`, so a
; result with no dot names a trait that exists nowhere. Every bound position delegates
; here, so an unknown trait produces the identical located "unknown trait '…' in bound".
(defn qualify-trait-name [(c (ptr Ctx)) (raw (slice u8))] (-> (Result (slice u8) Diag))
  (let [a (primitive/load (primitive/field c a))]
    (match (resolve c raw 2)
      (Err [d] (Err [(slice u8) Diag] d))
      (Ok [nn]
          (if (has-dot nn)
              (Ok [(slice u8) Diag] nn)
              (Err [(slice u8) Diag] (derr (sconcat3 a "unknown trait '" raw "' in bound"))))))))
(defn qualify-trait-names [(c (ptr Ctx)) (lst (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [n (al-len [(slice u8)] (primitive/load lst))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [raw (al-get [(slice u8)] (primitive/load lst) (primitive/load i))]
                  (match (qualify-trait-name c raw)
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [nn] (primitive/store! (al-elem [(slice u8)] lst (primitive/load i)) nn))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn qualify-bound-list [(c (ptr Ctx)) (bounds (ptr (ArrayList Bound)))] (-> (Result i64 Diag))
  (let [n (al-len [Bound] (primitive/load bounds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-trait-names c (primitive/load (primitive/field (al-elem [Bound] bounds (primitive/load i)) traits)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))

; The SIGNATURE (name, cc, bounds, param/return types). An error here is FATAL: an
; unqualified name or a bad type corrupts the shared tables the checker reads, so
; continuing past it cascades. These abort the pipeline as before.
(defn qualify-func-sig [(c (ptr Ctx)) (fp (ptr Func))] (-> (Result i64 Diag))
  (let [a (primitive/load (primitive/field c a))
        m (primitive/load (primitive/field c m))
        tps (primitive/load (primitive/field fp type_params))]
    (try (do
           (when (not (str-eq (primitive/load (primitive/field fp name)) "main"))
                 (primitive/store! (primitive/field fp name) (sconcat3 a m "." (primitive/load (primitive/field fp name))))
                 0)
           (primitive/store! (primitive/field fp cc) (try! (resolve c (primitive/load (primitive/field fp cc)) 3)))
           (try! (qualify-bound-list c (primitive/load (primitive/field fp bounds))))
           (try! (qualify-param-types c (primitive/load (primitive/field fp params)) tps))
           (try! (qualify-type c (primitive/field fp ret) tps))
           (Ok 0)))))

; The BODY. An error here is RECOVERABLE: one function's body cannot corrupt another,
; so q-funcs collects it and moves on, and the checker skips this body while keeping
; the (already-resolved) signature. `fname` names the enclosing function in any error.
(defn qualify-func-body [(c (ptr Ctx)) (fp (ptr Func))] (-> (Result i64 Diag))
  (let [tps (primitive/load (primitive/field fp type_params))]
    (try (do
           (primitive/store! (primitive/field c fname) (primitive/load (primitive/field fp name)))
           (try! (qualify-expr-list c (primitive/load (primitive/field fp body)) tps))
           (primitive/store! (primitive/field c fname) "")
           (Ok 0)))))

(defn qualify-one-func [(c (ptr Ctx)) (fp (ptr Func))] (-> (Result i64 Diag))
  (try (do (try! (qualify-func-sig c fp)) (try! (qualify-func-body c fp)) (Ok 0))))
(defn qualify-one-struct [(c (ptr Ctx)) (sp (ptr StructDef))] (-> (Result i64 Diag))
  (let [a (primitive/load (primitive/field c a))
        m (primitive/load (primitive/field c m))
        tps (primitive/load (primitive/field sp type_params))]
    (primitive/store! (primitive/field sp name) (sconcat3 a m "." (primitive/load (primitive/field sp name))))
    (try (do
           (try! (qualify-bound-list c (primitive/load (primitive/field sp bounds))))  ; resolve + reject unknown traits
           (try! (qualify-field-types c (primitive/load (primitive/field sp fields)) tps))
           (Ok 0)))))
(defn qualify-variants [(c (ptr Ctx))
                        (vs (ptr (ArrayList Variant)))
                        (m (slice u8))
                        (a (ptr Allocator))
                        (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [n (al-len [Variant] (primitive/load vs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [vp (al-elem [Variant] vs (primitive/load i))]
                  (primitive/store! (primitive/field vp name) (sconcat3 a m "." (primitive/load (primitive/field vp name))))
                  (match (qualify-field-types c (primitive/load (primitive/field vp fields)) tps)
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [_] 0)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn qualify-one-sum [(c (ptr Ctx)) (sp (ptr SumDef))] (-> (Result i64 Diag))
  (let [a (primitive/load (primitive/field c a))
        m (primitive/load (primitive/field c m))
        tps (primitive/load (primitive/field sp type_params))]
    (primitive/store! (primitive/field sp name) (sconcat3 a m "." (primitive/load (primitive/field sp name))))
    (try (do
           (try! (qualify-bound-list c (primitive/load (primitive/field sp bounds))))  ; resolve + reject unknown traits
           (try! (qualify-variants c (primitive/load (primitive/field sp variants)) m a tps))
           (Ok 0)))))
(defn qualify-one-conv [(c (ptr Ctx)) (cp (ptr Convention))] (-> (Result i64 Diag))
  (let [a (primitive/load (primitive/field c a))
        m (primitive/load (primitive/field c m))]
    (when (not (str-eq (primitive/load (primitive/field cp name)) "c"))
          (primitive/store! (primitive/field cp name) (sconcat3 a m "." (primitive/load (primitive/field cp name))))
          0)
    (Ok [i64 Diag] 0)))
(defn qualify-one-extern [(c (ptr Ctx)) (ep (ptr Extern)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (primitive/load (primitive/field c a))
        m (primitive/load (primitive/field c m))]
    (try (do
           (primitive/store! (primitive/field ep name) (sconcat3 a m "." (primitive/load (primitive/field ep name))))
           (try! (qualify-type-list c (primitive/load (primitive/field ep params)) empty))
           (try! (qualify-type c (primitive/field ep ret) empty))
           (Ok 0)))))
(defn qualify-one-export [(c (ptr Ctx)) (ep (ptr ExportC))] (-> (Result i64 Diag))
  (match (resolve c (primitive/load (primitive/field ep name)) 0)
    (Err [d] (Err [i64 Diag] d))
    (Ok [nn] (do (primitive/store! (primitive/field ep name) nn) (Ok [i64 Diag] 0)))))
(defn qualify-one-assert [(c (ptr Ctx)) (ap (ptr StaticAssert)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                  Diag))
  (qualify-expr c (primitive/field ap cnd) empty))
(defn qualify-one-const [(c (ptr Ctx)) (kp (ptr Const)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (try (do
         (match (primitive/load (primitive/field kp ty))
           (Some [t]
                 (let [tp (alloc/stack Type)]
                   (primitive/store! tp t)
                   (try! (qualify-type c tp empty))
                   (primitive/store! (primitive/field kp ty) (Some (primitive/load tp)))
                   0))
           (None [] 0))
         (try! (qualify-expr c (primitive/field kp value) empty))
         (Ok 0))))
(defn qualify-trait-methods [(c (ptr Ctx)) (ms (ptr (ArrayList TraitMethod))) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                              Diag))
  (let [n (al-len [TraitMethod] (primitive/load ms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [mp (al-elem [TraitMethod] ms (primitive/load i))]
                  (match (qualify-param-types c (primitive/load (primitive/field mp params)) tps)
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [_]
                        (match (qualify-type c (primitive/field mp ret) tps)
                          (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                          (Ok [_] 0)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn qualify-one-trait [(c (ptr Ctx)) (tp (ptr TraitDef))] (-> (Result i64 Diag))
  (try (let [a (primitive/load (primitive/field c a))
             m (primitive/load (primitive/field c m))
             (mut tl) (al-new [(slice u8)] a)]
         (al-push! (mut tl) (primitive/load (primitive/field tp self_param)))
         ; extra trait type parameters are in scope in method signatures too. gen-8 guard:
         ; an extra param that NAMES A KNOWN TRAIT was almost certainly meant as a supertrait
         ; (the two used to share this vector), so reject it with a pointer at `:requires`
         ; rather than silently accepting it as an associated-type parameter.
         (let [xs (primitive/load (primitive/field tp type_params))
               nx (al-len [(slice u8)] (primitive/load xs))
               (mut xi) 0]
           (loop (if (primitive/icmp-ge (primitive/load xi) nx)
                     (break)
                     (do
                       (let [pn (al-get [(slice u8)] (primitive/load xs) (primitive/load xi))]
                         (when (has-dot (try! (resolve c pn 2)))
                               (break :try
                                      (Err (derr (sconcat a
                                                          (sconcat3 a
                                                                    "deftrait: type parameter '"
                                                                    pn
                                                                    "' names a trait — if you meant a supertrait, write ':requires [")
                                                          (sconcat a
                                                                   pn
                                                                   "]'; if you meant an associated-type parameter, rename it"))))))
                         (al-push! (mut tl) pn))
                       (primitive/store! xi (primitive/iadd (primitive/load xi) 1))))))
         ; qualify the `:requires` supertrait names exactly as trait bounds are qualified —
         ; an unknown supertrait is a located "unknown trait" error, and the stored names
         ; become the canonical qualified ones the checker matches impls against.
         (try! (qualify-trait-names c (primitive/load (primitive/field tp requires))))
         (let [tlb (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))]
           (primitive/store! tlb (primitive/load tl))
           (primitive/store! (primitive/field tp name) (sconcat3 a m "." (primitive/load (primitive/field tp name))))
           (qualify-trait-methods c (primitive/load (primitive/field tp methods)) tlb)))))
(defn qualify-impl-method [(c (ptr Ctx)) (fp (ptr Func)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (try
       ; bounds too — an impl method now carries its impl's bounds (`(impl [(T Eq)] …)`),
       ; and an unqualified `Eq` here would never match the checker's `coil.core.Eq`
       (do
         (try! (qualify-bound-list c (primitive/load (primitive/field fp bounds))))
         (try! (qualify-param-types c (primitive/load (primitive/field fp params)) tps))
         (try! (qualify-type c (primitive/field fp ret) tps))
         (try! (qualify-expr-list c (primitive/load (primitive/field fp body)) tps))
         (Ok 0))))
(defn qualify-impl-methods [(c (ptr Ctx)) (ms (ptr (ArrayList Func)))] (-> (Result i64 Diag))
  (let [n (al-len [Func] (primitive/load ms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] ms (primitive/load i))]
                  (match (qualify-impl-method c fp (primitive/load (primitive/field fp type_params)))
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [_] 0)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn qualify-one-impl [(c (ptr Ctx)) (ip (ptr ImplDef)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (primitive/load (primitive/field c a))]
    (try
         ; The trait being implemented is a bound position too — resolve it through the
         ; ONE shared helper so an unknown trait errors identically to a defn/struct/sum
         ; bound (was: lenient `resolve`, so an unknown impl trait slipped past here and was
         ; caught late in the checker with a divergent "impl: unknown trait" message).
         (do
           (when (impl-is-trait ip)
                 (primitive/store! (primitive/field ip kind) (TraitImpl (try! (qualify-trait-name c (impl-trait-name ip))))))
           ; A blanket impl — `(impl [T] Show T)`, the implementing type IS a bare type
           ; param — was accepted and then never matched any receiver, so it was dead code
           ; that looked live: the user got no error at the impl and "does not implement" at
           ; every call. Reject it at the impl (blanket impls / specialization over a bare
           ; param are not supported).
           (match-else (primitive/load (primitive/field ip self_type))
                       (TStruct [nm]
                                (when (set-contains (primitive/load (primitive/field ip type_params)) nm)
                                      (break :try
                                             (Err (derr (sconcat3 a
                                                                  "cannot impl on a bare type parameter '"
                                                                  nm
                                                                  "'; the implementing type must be a concrete type or type constructor"))))))
                       (_ 0))
           ; Qualify the implementing type (the impl's own type params stay
           ; unqualified — scalars and `slice` are structurally exempt), then
           ; re-derive the dispatch base name from the qualified type.
           (try! (qualify-type c (primitive/field ip self_type) (primitive/load (primitive/field ip type_params))))
           (primitive/store! (primitive/field ip for_type) (impl-base-name a (primitive/field ip self_type)))
           (try! (qualify-impl-methods c (primitive/load (primitive/field ip methods))))
           (Ok 0)))))

; SIGNATURE errors abort (fatal, corrupt shared tables); BODY errors are collected
; into the sink and the loop continues, so a batch of undefined-function mistakes is
; reported in ONE pass instead of one-recompile-at-a-time. The checker later skips
; every poisoned body while keeping its resolved signature, so callers don't cascade.
(defn q-funcs [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p funcs))
        n (al-len [Func] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (primitive/load i))]
                  (match (qualify-func-sig c fp)
                    (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                    (Ok [_]
                        (match (qualify-func-body c fp)
                          (Err [d]
                               (do
                                 (al-push! (mut (primitive/load (primitive/field c diags))) d)
                                 (al-push! (mut (primitive/load (primitive/field c poisoned))) (primitive/load (primitive/field fp name)))
                                 (primitive/store! (primitive/field c fname) "")
                                 0))
                          (Ok [_] 0)))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn q-structs [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p structs))
        n (al-len [StructDef] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-one-struct c (al-elem [StructDef] fs (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn q-sums [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p sums))
        n (al-len [SumDef] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-one-sum c (al-elem [SumDef] fs (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn q-convs [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p conventions))
        n (al-len [Convention] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-one-conv c (al-elem [Convention] fs (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn q-externs [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p externs))
        n (al-len [Extern] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-one-extern c (al-elem [Extern] fs (primitive/load i)) empty)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn q-exports [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p exports))
        n (al-len [ExportC] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-one-export c (al-elem [ExportC] fs (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn q-asserts [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p asserts))
        n (al-len [StaticAssert] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-one-assert c (al-elem [StaticAssert] fs (primitive/load i)) empty)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn q-consts [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p consts))
        n (al-len [Const] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-one-const c (al-elem [Const] fs (primitive/load i)) empty)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn q-metas [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p metas))
        n (al-len [Expr] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-expr c (al-elem [Expr] fs (primitive/load i)) empty)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn q-traits [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p traits))
        n (al-len [TraitDef] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-one-trait c (al-elem [TraitDef] fs (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn q-impls [(c (ptr Ctx)) (p (ptr Program)) (empty (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [fs (primitive/load (primitive/field p impls))
        n (al-len [ImplDef] (primitive/load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (match (qualify-one-impl c (al-elem [ImplDef] fs (primitive/load i)) empty)
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) (break)))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))

(defn qualify-program [(c (ptr Ctx)) (p (ptr Program))] (-> (Result i64 Diag))
  (let [empty (empty-strs (primitive/load (primitive/field c a)))]
    (try (do
           (try! (q-funcs c p))
           (try! (q-structs c p))
           (try! (q-sums c p))
           (try! (q-convs c p))
           (try! (q-externs c p empty))
           (try! (q-exports c p))
           (try! (q-asserts c p empty))
           (try! (q-consts c p empty))
           (try! (q-metas c p empty))
           (try! (q-traits c p))
           (try! (q-impls c p empty))
           (Ok 0)))))

; ---- merge -----------------------------------------
(defn out-extern [(o (mut Out)) (i i64)] (-> (ptr Extern))
  (primitive/index (primitive/load (primitive/field (primitive/field o externs) data)) i))
(defn out-const [(o (mut Out)) (i i64)] (-> (ptr Const))
  (primitive/index (primitive/load (primitive/field (primitive/field o consts) data)) i))

(defn merge-structs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (primitive/load (primitive/field p structs))
        n (al-len [StructDef] (primitive/load src))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut (primitive/field o structs)) (al-get [StructDef] (primitive/load src) (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn merge-sums [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (primitive/load (primitive/field p sums))
        n (al-len [SumDef] (primitive/load src))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut (primitive/field o sums)) (al-get [SumDef] (primitive/load src) (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn merge-funcs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (primitive/load (primitive/field p funcs))
        n (al-len [Func] (primitive/load src))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut (primitive/field o funcs)) (al-get [Func] (primitive/load src) (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn merge-exports [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (primitive/load (primitive/field p exports))
        n (al-len [ExportC] (primitive/load src))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut (primitive/field o exports)) (al-get [ExportC] (primitive/load src) (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn merge-asserts [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (primitive/load (primitive/field p asserts))
        n (al-len [StaticAssert] (primitive/load src))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut (primitive/field o asserts)) (al-get [StaticAssert] (primitive/load src) (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn merge-metas [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (primitive/load (primitive/field p metas))
        n (al-len [Expr] (primitive/load src))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut (primitive/field o metas)) (al-get [Expr] (primitive/load src) (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn merge-traits [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (primitive/load (primitive/field p traits))
        n (al-len [TraitDef] (primitive/load src))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (al-push! (mut (primitive/field o traits)) (al-get [TraitDef] (primitive/load src) (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn merge-impls [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (primitive/load (primitive/field p impls))
        n (al-len [ImplDef] (primitive/load src))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do (al-push! (mut (primitive/field o impls)) (al-get [ImplDef] (primitive/load src) (primitive/load i))) (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn conv-in-out [(o (mut Out)) (name (slice u8))] (-> bool)
  (let [n (al-len [Convention] (primitive/load (primitive/field o conventions)))
        (mut i) 0
        (mut f) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (conv-name (al-get [Convention] (primitive/load (primitive/field o conventions)) (primitive/load i))) name)
                      (primitive/store! f true)
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load f)))
(defn merge-convs [(o (mut Out)) (p (ptr Program))] (-> i64)
  (let [src (primitive/load (primitive/field p conventions))
        n (al-len [Convention] (primitive/load src))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [cv (al-get [Convention] (primitive/load src) (primitive/load i))]
                  (unless (conv-in-out (mut o) (conv-name cv)) (al-push! (mut (primitive/field o conventions)) cv)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
(defn merge-externs [(o (mut Out)) (p (ptr Program)) (a (ptr Allocator))] (-> (Result i64 Diag))
  (let [src (primitive/load (primitive/field p externs))
        n (al-len [Extern] (primitive/load src))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [ev (al-get [Extern] (primitive/load src) (primitive/load i))
                      esp (alloc/stack Extern)]
                  (primitive/store! esp ev)
                  (let [nm (primitive/load (primitive/field esp name))
                        on (al-len [Extern] (primitive/load (primitive/field o externs)))
                        (mut idx) -1
                        (mut j) 0]
                    (loop (if (primitive/icmp-ge (primitive/load j) on)
                              (break)
                              (do
                                (when (str-eq (primitive/load (primitive/field (out-extern (mut o) (primitive/load j)) name)) nm)
                                      (primitive/store! idx (primitive/load j))
                                      (break))
                                (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                    (if (primitive/icmp-ge (primitive/load idx) 0)
                        (unless (extern-eq (out-extern (mut o) (primitive/load idx)) esp)
                                (primitive/store! err (derr (extern-conflict-msg a nm)))
                                (primitive/store! failed true)
                                (break))
                        (al-push! (mut (primitive/field o externs)) ev))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn merge-consts [(o (mut Out)) (p (ptr Program)) (a (ptr Allocator))] (-> (Result i64 Diag))
  (let [src (primitive/load (primitive/field p consts))
        n (al-len [Const] (primitive/load src))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [cv (al-get [Const] (primitive/load src) (primitive/load i))
                      csp (alloc/stack Const)]
                  (primitive/store! csp cv)
                  (let [nm (primitive/load (primitive/field csp name))
                        on (al-len [Const] (primitive/load (primitive/field o consts)))
                        (mut dup) false
                        (mut j) 0]
                    (loop (if (primitive/icmp-ge (primitive/load j) on)
                              (break)
                              (do
                                (when (str-eq (primitive/load (primitive/field (out-const (mut o) (primitive/load j)) name)) nm)
                                      (primitive/store! dup true)
                                      (break))
                                (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                    (if (primitive/load dup)
                        (do (primitive/store! err (derr (const-dup-msg a nm))) (primitive/store! failed true) (break))
                        (al-push! (mut (primitive/field o consts)) cv))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
(defn merge-into [(o (mut Out)) (p (ptr Program)) (a (ptr Allocator))] (-> (Result i64 Diag))
  (merge-convs (mut o) p)
  (merge-structs (mut o) p)
  (merge-sums (mut o) p)
  (match (merge-externs (mut o) p a)
    (Err [d] (Err [i64 Diag] d))
    (Ok [_]
        (do
          (merge-funcs (mut o) p)
          (merge-exports (mut o) p)
          (merge-asserts (mut o) p)
          (merge-metas (mut o) p)
          (merge-traits (mut o) p)
          (merge-impls (mut o) p)
          (merge-consts (mut o) p a)))))

; ---- build the DefTable + bare-ok set (pass 1) ----------------------------
(defn mk-empty-defs [(a (ptr Allocator))] (-> Defs)
  (let [d (alloc/stack Defs)]
    (primitive/store! (primitive/field d callables) (al-new [(slice u8)] a))
    (primitive/store! (primitive/field d types) (al-new [(slice u8)] a))
    (primitive/store! (primitive/field d traits) (al-new [(slice u8)] a))
    (primitive/store! (primitive/field d convs) (al-new [(slice u8)] a))
    (primitive/store! (primitive/field d externs) (al-new [(slice u8)] a))
    (primitive/load d)))
(defn table-getc [(a (ptr Allocator)) (tb (ptr TBox)) (m (slice u8))] (-> (ptr DefEntry))
  (let [hit (table-find (primitive/field tb items) m)]
    (if (primitive/icmp-ne (primitive/cast i64 hit) 0)
        hit
        (let [e (alloc/stack DefEntry)
              n (al-len [DefEntry] (primitive/load (primitive/field tb items)))]
          (primitive/store! (primitive/field e module) m)
          (primitive/store! (primitive/field e defs) (mk-empty-defs a))
          ; no index yet — `defs-has?` scans until build-deftable builds one
          (primitive/store! (primitive/field e built) 0)
          (primitive/store! (primitive/field e idx) (hm-new [(slice u8) i64] a (str-keyops)))
          (al-push! (mut (primitive/field tb items)) (primitive/load e))
          (al-elem [DefEntry] (primitive/field tb items) n)))))
(defn add-module-defs [(a (ptr Allocator)) (tb (ptr TBox)) (m (slice u8)) (prog (ptr Program))] (-> i64)
  (let [de (table-getc a tb m)]
    ; funcs (non-main) -> callables
    (let [fs (primitive/load (primitive/field prog funcs))
          n (al-len [Func] (primitive/load fs))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (let [nm (func-name (al-get [Func] (primitive/load fs) (primitive/load i)))]
                    (when (not (str-eq nm "main")) (al-push! (mut (primitive/field (primitive/field de defs) callables)) nm)))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    ; structs -> types
    (let [fs (primitive/load (primitive/field prog structs))
          n (al-len [StructDef] (primitive/load fs))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (let [sp (al-elem [StructDef] fs (primitive/load i))]
                    (al-push! (mut (primitive/field (primitive/field de defs) types)) (primitive/load (primitive/field sp name))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    ; sums -> types + variants -> callables
    (let [fs (primitive/load (primitive/field prog sums))
          n (al-len [SumDef] (primitive/load fs))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (let [sp (al-elem [SumDef] fs (primitive/load i))]
                    (al-push! (mut (primitive/field (primitive/field de defs) types)) (primitive/load (primitive/field sp name)))
                    (let [vs (primitive/load (primitive/field sp variants))
                          vn (al-len [Variant] (primitive/load vs))
                          (mut j) 0]
                      (loop (if (primitive/icmp-ge (primitive/load j) vn)
                                (break)
                                (do
                                  (al-push! (mut (primitive/field (primitive/field de defs) callables))
                                            (primitive/load (primitive/field (al-elem [Variant] vs (primitive/load j)) name)))
                                  (primitive/store! j (primitive/iadd (primitive/load j) 1)))))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    ; traits -> traits
    (let [fs (primitive/load (primitive/field prog traits))
          n (al-len [TraitDef] (primitive/load fs))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (al-push! (mut (primitive/field (primitive/field de defs) traits)) (primitive/load (primitive/field (al-elem [TraitDef] fs (primitive/load i)) name)))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    ; conventions (non-c) -> convs
    (let [fs (primitive/load (primitive/field prog conventions))
          n (al-len [Convention] (primitive/load fs))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (let [nm (conv-name (al-get [Convention] (primitive/load fs) (primitive/load i)))]
                    (when (not (str-eq nm "c")) (al-push! (mut (primitive/field (primitive/field de defs) convs)) nm)))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    ; externs -> externs + callables
    (let [fs (primitive/load (primitive/field prog externs))
          n (al-len [Extern] (primitive/load fs))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (let [nm (primitive/load (primitive/field (al-elem [Extern] fs (primitive/load i)) name))]
                    (al-push! (mut (primitive/field (primitive/field de defs) externs)) nm)
                    (al-push! (mut (primitive/field (primitive/field de defs) callables)) nm))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
    0))
(defn build-deftable [(a (ptr Allocator)) (parsed (ptr (ArrayList ParsedForm)))] (-> (ptr (ArrayList DefEntry)))
  (let [tb (unwrap-ptr [TBox] (create [TBox] a))
        n (al-len [ParsedForm] (primitive/load parsed))
        (mut i) 0]
    (primitive/store! (primitive/field tb items) (al-new [DefEntry] a))
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [pf (al-elem [ParsedForm] parsed (primitive/load i))]
                  (match (primitive/load (primitive/field pf module))
                    (Some [m] (add-module-defs a tb m (primitive/load (primitive/field pf prog))))
                    (None [] 0)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    ; every module is filled now, so the indexes can be built and can no longer go
    ; stale — nothing adds a definition after this point.
    (let [ne (al-len [DefEntry] (primitive/load (primitive/field tb items)))
          (mut k) 0]
      (loop (if (primitive/icmp-ge (primitive/load k) ne)
                (break)
                (do (defs-index-build! a (al-elem [DefEntry] (primitive/field tb items) (primitive/load k)))
                    (primitive/store! k (primitive/iadd (primitive/load k) 1))))))
    (primitive/field tb items)))
(defn build-bareok [(a (ptr Allocator)) (parsed (ptr (ArrayList ParsedForm)))] (-> (ptr (ArrayList (slice u8))))
  (let [sb (unwrap-ptr [SBox] (create [SBox] a))
        n (al-len [ParsedForm] (primitive/load parsed))
        (mut i) 0]
    (primitive/store! (primitive/field sb items) (al-new [(slice u8)] a))
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [prog (primitive/load (primitive/field (al-elem [ParsedForm] parsed (primitive/load i)) prog))
                      ts (primitive/load (primitive/field prog traits))
                      tn (al-len [TraitDef] (primitive/load ts))
                      (mut j) 0]
                  (loop (if (primitive/icmp-ge (primitive/load j) tn)
                            (break)
                            (do
                              (let [tp (al-elem [TraitDef] ts (primitive/load j))
                                    ms (primitive/load (primitive/field tp methods))
                                    mn (al-len [TraitMethod] (primitive/load ms))
                                    (mut k) 0]
                                (loop (if (primitive/icmp-ge (primitive/load k) mn)
                                          (break)
                                          (do
                                            (al-push! (mut (primitive/field sb items))
                                                      (primitive/load (primitive/field (al-elem [TraitMethod] ms (primitive/load k)) name)))
                                            (primitive/store! k (primitive/iadd (primitive/load k) 1))))))
                              (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
                  ; Receiver-bearing inherent methods are validated later, but all
                  ; inherent names must pass strict resolution so `(size db ty)` can
                  ; reach the checker's type-directed method selection.
                  (let [is (primitive/load (primitive/field prog impls))
                        ni (al-len [ImplDef] (primitive/load is))
                        (mut ii) 0]
                    (loop (if (primitive/icmp-ge (primitive/load ii) ni)
                              (break)
                              (do
                                (let [ip (al-elem [ImplDef] is (primitive/load ii))]
                                  (when (impl-is-inherent ip)
                                        (let [ms (primitive/load (primitive/field ip methods))
                                              nm (al-len [Func] (primitive/load ms))
                                              (mut mi) 0]
                                          (loop (if (primitive/icmp-ge (primitive/load mi) nm)
                                                    (break)
                                                    (do
                                                      (al-push! (mut (primitive/field sb items))
                                                                (primitive/load (primitive/field (al-elem [Func] ms (primitive/load mi)) name)))
                                                      (primitive/store! mi (primitive/iadd (primitive/load mi) 1))))))))
                                (primitive/store! ii (primitive/iadd (primitive/load ii) 1)))))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/field sb items)))

; ---- Out -> Program + Ctx/Out init -----------------------------------------
(defn init-out [(o (ptr Out)) (a (ptr Allocator))] (-> i64)
  (primitive/store! (primitive/field o conventions) (al-new [Convention] a))
  (primitive/store! (primitive/field o structs) (al-new [StructDef] a))
  (primitive/store! (primitive/field o sums) (al-new [SumDef] a))
  (primitive/store! (primitive/field o externs) (al-new [Extern] a))
  (primitive/store! (primitive/field o funcs) (al-new [Func] a))
  (primitive/store! (primitive/field o asserts) (al-new [StaticAssert] a))
  (primitive/store! (primitive/field o consts) (al-new [Const] a))
  (primitive/store! (primitive/field o traits) (al-new [TraitDef] a))
  (primitive/store! (primitive/field o impls) (al-new [ImplDef] a))
  (primitive/store! (primitive/field o metas) (al-new [Expr] a))
  (primitive/store! (primitive/field o exports) (al-new [ExportC] a))
  0)
(defn out->program [(o (ptr Out)) (a (ptr Allocator))] (-> (ptr Program))
  (let [pp (unwrap-ptr [Program] (create [Program] a))]
    (primitive/store! (primitive/field pp conventions) (box-al [Convention] a (primitive/load (primitive/field o conventions))))
    (primitive/store! (primitive/field pp structs) (box-al [StructDef] a (primitive/load (primitive/field o structs))))
    (primitive/store! (primitive/field pp sums) (box-al [SumDef] a (primitive/load (primitive/field o sums))))
    (primitive/store! (primitive/field pp externs) (box-al [Extern] a (primitive/load (primitive/field o externs))))
    (primitive/store! (primitive/field pp funcs) (box-al [Func] a (primitive/load (primitive/field o funcs))))
    (primitive/store! (primitive/field pp asserts) (box-al [StaticAssert] a (primitive/load (primitive/field o asserts))))
    (primitive/store! (primitive/field pp consts) (box-al [Const] a (primitive/load (primitive/field o consts))))
    (primitive/store! (primitive/field pp traits) (box-al [TraitDef] a (primitive/load (primitive/field o traits))))
    (primitive/store! (primitive/field pp impls) (box-al [ImplDef] a (primitive/load (primitive/field o impls))))
    (primitive/store! (primitive/field pp metas) (box-al [Expr] a (primitive/load (primitive/field o metas))))
    (primitive/store! (primitive/field pp exports) (box-al [ExportC] a (primitive/load (primitive/field o exports))))
    pp))
(defn init-ctx [(c (ptr Ctx))
                (a (ptr Allocator))
                (m (slice u8))
                (imp (ptr ImpEntry))
                (table (ptr (ArrayList DefEntry)))
                (exp (ptr (ArrayList ExpEntry)))
                (bareok (ptr (ArrayList (slice u8))))
                (strict bool)
                (diags (ptr (ArrayList Diag)))
                (poisoned (ptr (ArrayList (slice u8))))] (-> i64)
  (primitive/store! (primitive/field c a) a)
  (primitive/store! (primitive/field c m) m)
  (primitive/store! (primitive/field c imp) imp)
  (primitive/store! (primitive/field c table) table)
  (primitive/store! (primitive/field c exp) exp)
  (primitive/store! (primitive/field c strict) strict)
  (primitive/store! (primitive/field c bareok) bareok)
  (primitive/store! (primitive/field c fname) "")
  (primitive/store! (primitive/field c diags) diags)
  (primitive/store! (primitive/field c poisoned) poisoned)
  0)

; tool-10 (import-site collision). The two parallel `(ptr SBox)`s hold, for one importer,
; the names already explicitly `:use [name]`'d and the module each came from — a box so the
; push survives across the per-`:use` scan (a bare ArrayList can't be grown through a ptr).
; partner-of returns the module a name was first seen from, or "" if this is the first.
(defn partner-of [(nbox (ptr SBox)) (tbox (ptr SBox)) (nm (slice u8))] (-> (slice u8))
  (let [names (primitive/field nbox items)
        tgts (primitive/field tbox items)
        n (al-len [(slice u8)] (primitive/load names))
        (mut i) 0
        (mut r) ""]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (str-eq (al-get [(slice u8)] (primitive/load names) (primitive/load i)) nm)
                      (primitive/store! r (al-get [(slice u8)] (primitive/load tgts) (primitive/load i)))
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
; Scan one `:use [names]` entry: the first name already seen from a DIFFERENT module is the
; collision (Some diag); otherwise every name is recorded and None is returned.
(defn scan-use-names [(a (ptr Allocator))
                      (importer (slice u8))
                      (nbox (ptr SBox))
                      (tbox (ptr SBox))
                      (nms (ptr (ArrayList (slice u8))))
                      (tgt (slice u8))] (-> (Option Diag))
  (let [nn (al-len [(slice u8)] (primitive/load nms))
        (mut k) 0
        (mut r) (None [Diag])]
    (loop (if (primitive/icmp-ge (primitive/load k) nn)
              (break)
              (do
                (let [nm (al-get [(slice u8)] (primitive/load nms) (primitive/load k))
                      prev (partner-of nbox tbox nm)]
                  (if (and (primitive/icmp-gt (slice-len [u8] prev) 0) (not (str-eq prev tgt)))
                      (do (primitive/store! r (Some (derr (use-dup-msg a importer nm prev tgt)))) (break))
                      (do (al-push! (mut (primitive/field nbox items)) nm) (al-push! (mut (primitive/field tbox items)) tgt) 0)))
                (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    (primitive/load r)))
; One importer: scan every `:use [names]` entry, sharing the seen-name boxes across them.
(defn dup-in-importer [(a (ptr Allocator)) (ie (ptr ImpEntry))] (-> (Result i64 Diag))
  (let [importer (primitive/load (primitive/field ie name))
        uses (primitive/field (primitive/field ie imp) uses)
        un (al-len [Use] (primitive/load uses))
        (mut j) 0
        nbox (unwrap-ptr [SBox] (create [SBox] a))
        tbox (unwrap-ptr [SBox] (create [SBox] a))
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (primitive/store! (primitive/field nbox items) (al-new [(slice u8)] a))
    (primitive/store! (primitive/field tbox items) (al-new [(slice u8)] a))
    (loop (if (or (primitive/load failed) (primitive/icmp-ge (primitive/load j) un))
              (break)
              (do
                (let [up (alloc/stack Use)]
                  (primitive/store! up (al-get [Use] (primitive/load uses) (primitive/load j)))
                  (match (primitive/load (primitive/field up spec))
                    (UAll [] 0)
                    (UNames [nms]
                            (match (scan-use-names a importer nbox tbox nms (primitive/load (primitive/field up target)))
                              (Some [d] (do (primitive/store! err d) (primitive/store! failed true) 0))
                              (None [] 0)))))
                (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
; tool-10: reject the SAME name explicitly `:use [name]`'d from two DIFFERENT modules in one
; importer, eagerly at the import site (before any use site is even reached).
(defn check-explicit-use-dups [(a (ptr Allocator)) (impb (ptr (ArrayList ImpEntry)))] (-> (Result i64 Diag))
  (let [n (al-len [ImpEntry] (primitive/load impb))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (primitive/load failed) (primitive/icmp-ge (primitive/load i) n))
              (break)
              (do
                (match (dup-in-importer a (al-elem [ImpEntry] impb (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) 0))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))

; diag-10: scan one `:use [names]` entry — the first name the target module does NOT export
; is a located error (Some diag); otherwise None.
(defn scan-use-exports [(a (ptr Allocator))
                        (importer (slice u8))
                        (expb (ptr (ArrayList ExpEntry)))
                        (nms (ptr (ArrayList (slice u8))))
                        (tgt (slice u8))] (-> (Option Diag))
  (let [nn (al-len [(slice u8)] (primitive/load nms))
        (mut k) 0
        (mut r) (None [Diag])]
    (loop (if (primitive/icmp-ge (primitive/load k) nn)
              (break)
              (do
                (let [nm (al-get [(slice u8)] (primitive/load nms) (primitive/load k))]
                  (when (not (exports-check expb tgt nm))
                        (primitive/store! r (Some (derr (use-unexported-msg a importer nm tgt))))
                        (break)))
                (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    (primitive/load r)))
; One importer: every `:use [names]` entry must name only exports of its target module.
(defn exports-in-importer [(a (ptr Allocator)) (expb (ptr (ArrayList ExpEntry))) (ie (ptr ImpEntry))] (-> (Result i64
                                                                                                                  Diag))
  (let [importer (primitive/load (primitive/field ie name))
        uses (primitive/field (primitive/field ie imp) uses)
        un (al-len [Use] (primitive/load uses))
        (mut j) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (primitive/load failed) (primitive/icmp-ge (primitive/load j) un))
              (break)
              (do
                (let [up (alloc/stack Use)]
                  (primitive/store! up (al-get [Use] (primitive/load uses) (primitive/load j)))
                  (match (primitive/load (primitive/field up spec))
                    (UAll [] 0)
                    (UNames [nms]
                            (match (scan-use-exports a importer expb nms (primitive/load (primitive/field up target)))
                              (Some [d] (do (primitive/store! err d) (primitive/store! failed true) 0))
                              (None [] 0)))))
                (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))
; diag-10: reject `:use [name]` naming a non-exported symbol, eagerly at the import site.
(defn check-use-exports [(a (ptr Allocator)) (impb (ptr (ArrayList ImpEntry))) (expb (ptr (ArrayList ExpEntry)))] (-> (Result i64
                                                                                                                              Diag))
  (let [n (al-len [ImpEntry] (primitive/load impb))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (or (primitive/load failed) (primitive/icmp-ge (primitive/load i) n))
              (break)
              (do
                (match (exports-in-importer a expb (al-elem [ImpEntry] impb (primitive/load i)))
                  (Err [d] (do (primitive/store! err d) (primitive/store! failed true) 0))
                  (Ok [_] 0))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (if (primitive/load failed) (Err (primitive/load err)) (Ok [i64 Diag] 0))))

; ---- resolve-program, strict=true --------
; `tolerant` = SKIP a top-level form that does not parse, instead of aborting. Only
; the macro-context build (expander.coil::expand-stage3) passes true: at that point
; macros are not yet expanded, so a top-level macro CALL — `(gctype Node)` — is not
; yet a `defn` and cannot parse. Skipping those leaves every real definition in the
; context, so the comptime closure walk can reach ordinary functions rather than
; being restricted to a syntactic `Code`-signature subset. Every other caller passes
; false and still reports a genuine syntax error. NOTE: deliberately NOT keyed on
; `strict` — the authoritative resolve runs with strict=false whenever the program
; has metaprograms, and must still fail loudly on a real parse error.
; ---- primitive-definition resolution --------------------------------------
; Runs before AST parsing because primitive operands may themselves be type syntax.
; The parser receives only source spelling -> opcode bindings already resolved for
; the current module; it never interprets imports or primitive declaration names.
(defn primitive-canonical [(a (ptr Allocator)) (module (slice u8)) (name (slice u8))] (-> (slice u8))
  (sconcat3 a module "." name))

(defn primitive-def-op [(s (mut LS)) (canonical (slice u8))] (-> (Option (slice u8)))
  (let [defs (alloc/stack (ArrayList PrimitiveDef))
        a (primitive/load (primitive/field s a)) (mut i) 0 (mut out) (None [(slice u8)])]
    (primitive/store! defs (primitive/load (primitive/field s primitive_defs)))
    (let [n (al-len [PrimitiveDef] (primitive/load defs))]
    (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
              (let [p (al-elem [PrimitiveDef] defs (primitive/load i))]
                (if (str-eq (primitive-canonical a (primitive/load (primitive/field p module)) (primitive/load (primitive/field p name))) canonical)
                    (do (primitive/store! out (Some (primitive/load (primitive/field p opcode)))) (break))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))
    (primitive/load out)))

(defn primitive-alias-target [(s (mut LS)) (canonical (slice u8))] (-> (Option (slice u8)))
  (let [aliases (alloc/stack (ArrayList PrimitiveAlias))
        a (primitive/load (primitive/field s a)) (mut i) 0 (mut out) (None [(slice u8)])]
    (primitive/store! aliases (primitive/load (primitive/field s primitive_aliases)))
    (let [n (al-len [PrimitiveAlias] (primitive/load aliases))]
    (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
              (let [p (al-elem [PrimitiveAlias] aliases (primitive/load i))]
                (if (str-eq (primitive-canonical a (primitive/load (primitive/field p module)) (primitive/load (primitive/field p name))) canonical)
                    (let [raw (primitive/load (primitive/field p target)) slash (find-slash raw)]
                      (if (primitive/icmp-ge slash 0)
                          (let [impe (imports-find (primitive/field s imports) (primitive/load (primitive/field p module)))
                                prefix (subslice raw 0 slash)
                                rest (subslice raw (primitive/iadd slash 1) (slice-len raw))]
                            (if (primitive/icmp-eq (primitive/cast i64 impe) 0) (break)
                                (match (alias-target impe prefix)
                                  (Some [target] (do (primitive/store! out (Some (primitive-canonical a target rest))) (break)))
                                  (None [] (break)))))
                          (do (primitive/store! out (Some (primitive-canonical a (primitive/load (primitive/field p module)) raw))) (break))))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))
    (primitive/load out)))

(defn primitive-op [(s (mut LS)) (canonical (slice u8)) (depth i64)] (-> (Option (slice u8)))
  (if (primitive/icmp-gt depth 64) (None [(slice u8)])
      (match (primitive-def-op (mut s) canonical)
        (Some [op] (Some op))
        (None [] (match (primitive-alias-target (mut s) canonical)
                   (Some [target] (primitive-op (mut s) target (primitive/iadd depth 1)))
                   (None [] (None [(slice u8)])))))))

(defn primitive-binding-push! [(out (mut (ArrayList PrimitiveBinding))) (name (slice u8)) (op (slice u8))] (-> i64)
  (let [p (alloc/stack PrimitiveBinding)]
    (primitive/store! (primitive/field p source_name) name) (primitive/store! (primitive/field p opcode) op)
    (al-push! (mut out) (primitive/load p)))
  0)

(defn primitive-bind-one! [(s (mut LS)) (module (slice u8)) (decl-module (slice u8))
                           (name (slice u8)) (op (slice u8))
                           (out (mut (ArrayList PrimitiveBinding)))] (-> i64)
  (let [a (primitive/load (primitive/field s a)) impe (imports-find (primitive/field s imports) module)]
    ; Fully-qualified module names resolve without an import alias, just like
    ; ordinary definitions.  This also lets hygienic macros emit canonical names.
    (primitive-binding-push! (mut out) (sconcat3 a decl-module "/" name) op)
    (when (str-eq module decl-module) (primitive-binding-push! (mut out) name op) 0)
    (when (primitive/icmp-ne (primitive/cast i64 impe) 0)
      (let [aliases (primitive/field (primitive/field impe imp) aliases) n (al-len [Alias] (primitive/load aliases)) (mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
                  (let [p (al-elem [Alias] aliases (primitive/load i))]
                    (when (and (str-eq (primitive/load (primitive/field p target)) decl-module)
                               (exports-check (primitive/field s exports) decl-module name))
                      (primitive-binding-push! (mut out) (sconcat3 a (primitive/load (primitive/field p alias)) "/" name) op) 0)
                    (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
      (let [uses (primitive/field (primitive/field impe imp) uses) n (al-len [Use] (primitive/load uses)) (mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
                  (let [p (al-elem [Use] uses (primitive/load i))]
                    (when (and (and (str-eq (primitive/load (primitive/field p target)) decl-module)
                                    (exports-check (primitive/field s exports) decl-module name))
                               (match (primitive/load (primitive/field p spec)) (UAll [] true) (UNames [names] (set-contains names name))))
                      (primitive-binding-push! (mut out) name op) 0)
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))
    (when (and (not (str-eq module "coil.core")) (str-eq decl-module "coil.core"))
      (primitive-binding-push! (mut out) name op) 0))
  0)

(defn primitive-bindings-for [(s (mut LS)) (module (Option (slice u8)))] (-> (ptr (ArrayList PrimitiveBinding)))
  (let [a (primitive/load (primitive/field s a)) box (unwrap-ptr [(ArrayList PrimitiveBinding)] (create [(ArrayList PrimitiveBinding)] a))
        (mut out) (al-new [PrimitiveBinding] a)]
    ; Canonical names do not depend on the current source having a module
    ; declaration. This mirrors ordinary fully-qualified lookup and matters for
    ; small standalone/comptime files.
    (let [defs (alloc/stack (ArrayList PrimitiveDef)) (mut i) 0]
      (primitive/store! defs (primitive/load (primitive/field s primitive_defs)))
      (let [n (al-len [PrimitiveDef] (primitive/load defs))]
        (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
                  (let [p (al-elem [PrimitiveDef] defs (primitive/load i))]
                    (primitive-binding-push! (mut out)
                      (sconcat3 a (primitive/load (primitive/field p module)) "/" (primitive/load (primitive/field p name)))
                      (primitive/load (primitive/field p opcode)))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))
    (let [aliases (alloc/stack (ArrayList PrimitiveAlias)) (mut i) 0]
      (primitive/store! aliases (primitive/load (primitive/field s primitive_aliases)))
      (let [n (al-len [PrimitiveAlias] (primitive/load aliases))]
        (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
                  (let [p (al-elem [PrimitiveAlias] aliases (primitive/load i))
                        canonical (primitive-canonical a (primitive/load (primitive/field p module)) (primitive/load (primitive/field p name)))]
                    (match (primitive-op (mut s) canonical 0)
                      (Some [op] (primitive-binding-push! (mut out)
                                   (sconcat3 a (primitive/load (primitive/field p module)) "/" (primitive/load (primitive/field p name))) op))
                      (None [] 0))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))
    (match module
      (None [] 0)
      (Some [m]
        (do
          (let [defs (alloc/stack (ArrayList PrimitiveDef)) (mut i) 0]
            (primitive/store! defs (primitive/load (primitive/field s primitive_defs)))
            (let [n (al-len [PrimitiveDef] (primitive/load defs))]
            (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
                      (let [p (al-elem [PrimitiveDef] defs (primitive/load i))]
                        (primitive-bind-one! (mut s) m (primitive/load (primitive/field p module)) (primitive/load (primitive/field p name))
                                             (primitive/load (primitive/field p opcode)) (mut out))
                        (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))
          (let [aliases (alloc/stack (ArrayList PrimitiveAlias)) (mut i) 0]
            (primitive/store! aliases (primitive/load (primitive/field s primitive_aliases)))
            (let [n (al-len [PrimitiveAlias] (primitive/load aliases))]
            (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
                      (let [p (al-elem [PrimitiveAlias] aliases (primitive/load i))
                            canonical (primitive-canonical a (primitive/load (primitive/field p module)) (primitive/load (primitive/field p name)))]
                        (match (primitive-op (mut s) canonical 0)
                          (Some [op] (primitive-bind-one! (mut s) m (primitive/load (primitive/field p module))
                                                         (primitive/load (primitive/field p name)) op (mut out)))
                          (None [] 0))
                        (primitive/store! i (primitive/iadd (primitive/load i) 1))))))))))
    (primitive/store! box (primitive/load out)) box))

(defn resolve-program [(a (ptr Allocator)) (s (mut LS)) (strict bool) (tolerant bool)] (-> (Result (ptr Program) Diag))
  (let [impb (unwrap-ptr [(ArrayList ImpEntry)] (create [(ArrayList ImpEntry)] a))
        expb (unwrap-ptr [(ArrayList ExpEntry)] (create [(ArrayList ExpEntry)] a))
        out-forms (primitive/field s out)
        nforms (al-len [TaggedForm] (primitive/load out-forms))
        pb (unwrap-ptr [PBox] (create [PBox] a))
        parsed (primitive/field pb items)
        (mut perr) (primitive/zeroed Diag)
        (mut pfailed) false
        (mut fi) 0
        (mut dupd) (primitive/zeroed Diag)
        (mut dupfail) false]
    (primitive/store! impb (primitive/load (primitive/field s imports)))
    (primitive/store! expb (primitive/load (primitive/field s exports)))
    (match (check-explicit-use-dups a impb)
      (Err [d] (do (primitive/store! dupd d) (primitive/store! dupfail true) 0))
      (Ok [_] 0))
    ; diag-10: a `:use [name]` naming a non-exported symbol is a located error, not silence.
    (unless (primitive/load dupfail)
            (match (check-use-exports a impb expb)
              (Err [d] (do (primitive/store! dupd d) (primitive/store! dupfail true) 0))
              (Ok [_] 0)))
    (primitive/store! (primitive/field pb items) (al-new [ParsedForm] a))
    (type-res-reset)  ; fresh type-reference resolution registry for this pass
    (src-mod-reset)  ; fresh source→module map
    ; pass 0: parse each tagged form into its own Program
    (loop (if (primitive/icmp-ge (primitive/load fi) nforms)
              (break)
              (do
                (let [tfp (alloc/stack TaggedForm)]
                  (primitive/store! tfp (al-get [TaggedForm] (primitive/load out-forms) (primitive/load fi)))
                  (parser-set-primitive-bindings!
                    (primitive-bindings-for (mut s) (primitive/load (primitive/field tfp module))))
                  ; record which module this source file belongs to (for type-node resolution)
                  (src-mod-record (sx-source (primitive/load (primitive/field tfp form)))
                                  (match (primitive/load (primitive/field tfp module)) (Some [m] m) (None [] "")))
                  (let [single (unwrap-ptr [(ArrayList Sexp)] (create [(ArrayList Sexp)] a))
                        (mut sl) (al-new [Sexp] a)]
                    (al-push! (mut sl) (primitive/load (primitive/field tfp form)))
                    (primitive/store! single (primitive/load sl))
                    (match (parse-program a single)
                      (Err [d] (unless tolerant (primitive/store! perr d) (primitive/store! pfailed true) (break)))
                      (Ok [prog]
                          (let [pp (unwrap-ptr [Program] (create [Program] a))
                                pf (alloc/stack ParsedForm)]
                            (primitive/store! pp prog)
                            (primitive/store! (primitive/field pf prog) pp)
                            (primitive/store! (primitive/field pf module) (primitive/load (primitive/field tfp module)))
                            (al-push! (mut (primitive/field pb items)) (primitive/load pf)))))))
                (primitive/store! fi (primitive/iadd (primitive/load fi) 1)))))
    (if (primitive/load dupfail)
        (Err (primitive/load dupd))
        (if (primitive/load pfailed)
            (Err (primitive/load perr))
            (let [table (build-deftable a parsed)
                  bareok (build-bareok a parsed)
                  o (alloc/stack Out)
                  np (al-len [ParsedForm] (primitive/load parsed))
                  ; the collect-and-continue sink, allocated once and shared across modules.
                  rdiags (unwrap-ptr [(ArrayList Diag)] (create [(ArrayList Diag)] a))
                  rpoison (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))
                  (mut qerr) (primitive/zeroed Diag)
                  (mut qfailed) false
                  (mut qi) 0]
              (primitive/store! rdiags (al-new [Diag] a))
              (primitive/store! rpoison (al-new [(slice u8)] a))
              (primitive/store! (primitive/field s resolve_diags) rdiags)
              (primitive/store! (primitive/field s resolve_poisoned) rpoison)
              (init-out o a)
              (loop (if (primitive/icmp-ge (primitive/load qi) np)
                        (break)
                        (do
                          (let [pf (al-elem [ParsedForm] parsed (primitive/load qi))
                                prog (primitive/load (primitive/field pf prog))]
                            (match (primitive/load (primitive/field pf module))
                              (Some [m]
                                    (let [imp (imports-find impb m)
                                          cx (alloc/stack Ctx)]
                                      (init-ctx cx a m imp table expb bareok strict rdiags rpoison)
                                      (match (qualify-program cx prog)
                                        (Err [d] (do (primitive/store! qerr d) (primitive/store! qfailed true) (break)))
                                        (Ok [_] 0))))
                              (None [] 0))
                            (unless (primitive/load qfailed)
                                    (match (merge-into (mut o) prog a)
                                      (Err [d] (do (primitive/store! qerr d) (primitive/store! qfailed true) (break)))
                                      (Ok [_] 0))))
                          (primitive/store! qi (primitive/iadd (primitive/load qi) 1)))))
              (if (primitive/load qfailed) (Err (primitive/load qerr)) (Ok (out->program o a))))))))

; ============================ tables (Cx) ==========================
; Sig/StructInfo/SumInfo/Cx. The HashMaps become
; linear-scan ArrayList tables (the resolver's deftable idiom). Cx tables are
; BY-VALUE ArrayList fields so they can be pushed via (mut (primitive/field cx X)); they are
; read via (primitive/field cx X) for al-elem and (primitive/load (primitive/field cx X)) for al-len/al-get.
