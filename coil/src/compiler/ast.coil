; src/compiler/ast.coil — self-host Coil compiler, ast module.
(module ast)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "reader.coil" :use *)

(defsum Type
  (TInt [(bits i64) (signed bool)])
  (TFloat [(bits i64)])
  (TBool [])
  (TVoid [])
  (TPtr [(inner (ptr Type))])
  (TRef [(mutable bool) (inner (ptr Type))])
  (TStruct [(name (slice u8))])
  (TArray [(elem (ptr Type)) (n i64)])
  (TSlice [(elem (ptr Type))])
  (TVec [(elem (ptr Type)) (n i64)])
  (TFn [(cc (slice u8)) (params (ptr (ArrayList Type))) (ret (ptr Type))])
  (TApp [(name (slice u8)) (args (ptr (ArrayList Type)))])
  (TNever [])
  (TCode [])
  (TExternRef []))  ; wasm `externref`: an opaque, GC-managed host reference (last: keeps discriminants stable)

; A function parameter (name + type).
(defstruct Param [(name (slice u8)) (ty Type)])
; A struct/variant field (name + type).
(defstruct Field [(name (slice u8)) (ty Type)])

; Compiler primitives are ordinary module definitions. `opcode` is compiler-only
; lowering metadata; it is never itself entered into source scope. Primitive aliases
; retain the target definition's identity rather than becoming wrapper functions.
(defstruct PrimitiveDef
  [(module (slice u8)) (name (slice u8)) (opcode (slice u8))])
(defstruct PrimitiveAlias
  [(module (slice u8)) (name (slice u8)) (target (slice u8))])
; The loader/resolver computes the primitive bindings visible in one module. The parser
; consumes only this resolved table, so it never decides primitive-ness from source text.
(defstruct PrimitiveBinding [(source_name (slice u8)) (opcode (slice u8))])

; ExprKind — the 43 variants `parse_program` can PRODUCE (the 6 checker/mono-only
; variants — SpillRef, DynDispatch, MakeDyn, Construct, StaticRef, TraitCall —
; are never produced by the parser, so they are intentionally absent here).
; Numeric op tags: BinOp/CmpOp/Storage/TypeQuery/FieldMeta/CodeOp are stored as
; i64 codes (see the d-*-tag dumpers for the code->string mapping).
(defsum ExprKind
  (EInt [(v i64)])
  (EStr [(s (slice u8))])
  (ECStr [(s (slice u8))])
  (EVar [(name (slice u8))])
  (EZeroed [(ty Type)])
  (EBorrow [(mutable bool) (place (ptr Expr))])
  (ELet [(binds (ptr (ArrayList Bind))) (body (ptr (ArrayList Expr)))])
  (EBin [(op i64) (lhs (ptr Expr)) (rhs (ptr Expr))])
  (ENot [(inner (ptr Expr))])
  (EFloat [(bits i64)])
  (EBool [(b bool)])
  (ECmp [(op i64) (lhs (ptr Expr)) (rhs (ptr Expr))])
  (EIf [(cnd (ptr Expr)) (thn (ptr Expr)) (els (ptr Expr))])
  (EDo [(body (ptr (ArrayList Expr)))])
  (ECall [(func (slice u8)) (type_args (ptr (ArrayList Type))) (args (ptr (ArrayList Expr)))])
  (EAlloc [(storage i64) (ty Type)])
  (EField [(p (ptr Expr)) (fname (slice u8))])
  (ELoad [(inner (ptr Expr))])
  (EStore [(p (ptr Expr)) (val (ptr Expr))])
  (EIndex [(p (ptr Expr)) (idx (ptr Expr))])
  (ECast [(ty Type) (inner (ptr Expr))])
  (ESizeOf [(ty Type)])
  (EAlignOf [(ty Type)])
  (EOffsetOf [(ty Type) (fname (slice u8))])
  (EBitGet [(p (ptr Expr)) (fname (slice u8))])
  (EBitSet [(p (ptr Expr)) (fname (slice u8)) (val (ptr Expr))])
  (EFree [(inner (ptr Expr))])
  (EErase [(trait_name (slice u8)) (inner (ptr Expr))])
  (EMatch [(scrut (ptr Expr)) (arms (ptr (ArrayList Arm)))])
  (EFnPtrOf [(name (slice u8))])
  (ECallPtr [(fp (ptr Expr)) (args (ptr (ArrayList Expr)))])
  (ELoop [(label (Option (slice u8))) (body (ptr (ArrayList Expr)))])
  (EBreak [(label (Option (slice u8))) (value (Option (ptr Expr)))])
  (EContinue [(label (Option (slice u8)))])
  (ELlvmIr [(result Type) (args (ptr (ArrayList Expr))) (body (slice u8))])
  (ETypeQuery [(q i64) (ty Type)])
  (EFieldMeta [(meta i64) (ty Type) (idx (ptr Expr))])
  (EFieldIndex [(ty Type) (name (ptr Expr))])
  (EQuote [(form (ptr Sexp))])
  (ECodeOp [(op i64) (args (ptr (ArrayList Expr)))])
  (EQuasi [(q Quasi)])
  (EComptime [(inner (ptr Expr))])
  ; Type ascription `(: value type)` — a general expression that synthesizes `value`
  ; with `type` as the expected type (so an otherwise-stranded type argument can be
  ; supplied) and yields it at `type`. The checker LOWERS it away (to the coerced
  ; inner value), so it never survives into mono/codegen. Same field shape as ECast,
  ; but it type-CHECKS rather than numeric-converts.
  (EAscribe [(ty Type) (inner (ptr Expr))])
  ; ---- the 6 check-introduced variants (parser/resolver never emit these;
  ; the type-checker LOWERS calls/borrows/etc. into them). Mirror.
  (ESpillRef [(inner (ptr Expr))])
  (EConstruct [(sum (slice u8)) (variant (slice u8)) (args (ptr (ArrayList Expr)))])
  (ETraitCall [(trait_name (slice u8)) (method (slice u8)) (self_tp (slice u8)) (args (ptr (ArrayList Expr)))])
  (EDynDispatch [(dyn_struct (slice u8))
                 (vtable_struct (slice u8))
                 (method_index i64)
                 (cc (slice u8))
                 (params (ptr (ArrayList Type)))
                 (ret Type)
                 (recv (ptr Expr))
                 (args (ptr (ArrayList Expr)))])
  (EMakeDyn [(dyn_struct (slice u8))
             (vtable_struct (slice u8))
             (methods (ptr (ArrayList (slice u8))))
             (inner (ptr Expr))])
  (EStaticRef [(name (slice u8))]))

; `nid` mirrors Sexp.nid — parse-expr copies the source node's id so the type-checker
; can record an expression's inferred type keyed by node identity (see do-synth /
; type-of). Never dumped. Synthesized exprs (mk-expr default) get -1.
(defstruct Expr [(kind ExprKind) (lo i64) (hi i64) (source i64) (ctxt i64) (nid i64)])

; A let binding (name, mutable, value).
(defstruct Bind [(name (slice u8)) (mutable bool) (value Expr)])
; A match arm (variant, bound names, body).
(defstruct Arm [(variant (slice u8)) (binds (ptr (ArrayList (slice u8)))) (body Expr)])

; A quasiquote template node.
(defsum Quasi
  (QLit [(form (ptr Sexp))])
  (QUnquote [(e (ptr Expr))])
  (QSplice [(e (ptr Expr))])
  (QList [(items (ptr (ArrayList Quasi)))])
  (QVector [(items (ptr (ArrayList Quasi)))]))

; Calling-convention lowering.
(defsum Lowering
  (LNative [(cc i64)])  ; cc: 0=c 1=fast 2=cold
  (LShim []))

(defstruct Convention
  [(name (slice u8))
   (params (ptr (ArrayList (slice u8))))
   (ret (Option (slice u8)))
   (clobber (ptr (ArrayList (slice u8))))
   (preserve (ptr (ArrayList (slice u8))))
   (lowering Lowering)])

; Struct memory layout.
(defsum Layout
  (LC [])
  (LPacked [])
  (LAligned [(n i64)])
  (LExplicit [(offsets (ptr (ArrayList i64))) (size (Option i64)) (align i64)])
  (LBits [(backing i64) (offsets (ptr (ArrayList i64)))]))

(defstruct StructDef
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))  ; trait bounds on the params (empty if none)
   (layout Layout)
   (fields (ptr (ArrayList Field)))])

(defstruct Variant [(name (slice u8)) (fields (ptr (ArrayList Field)))])
(defstruct SumDef
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))  ; trait bounds on the params (empty if none)
   (variants (ptr (ArrayList Variant)))])

(defstruct Extern
  [(name (slice u8))
   (cc (slice u8))
   (params (ptr (ArrayList Type)))
   (variadic bool)
   (ret Type)])

; A trait bound on a type parameter (name + required trait names).
(defstruct Bound [(name (slice u8)) (traits (ptr (ArrayList (slice u8))))])

(defstruct Func
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (cc (slice u8))
   (params (ptr (ArrayList Param)))
   (ret Type)
   (body (ptr (ArrayList Expr)))
   (macro_variadic bool)
   (lo i64)
   (hi i64)
   (source i64)
   (ctxt i64)])

(defstruct StaticAssert [(cnd Expr) (msg (slice u8))])
(defstruct Const [(name (slice u8)) (ty (Option Type)) (value Expr)])

(defstruct TraitMethod [(name (slice u8)) (params (ptr (ArrayList Param))) (ret Type)])
; `type_params` = the EXTRA trait type parameters beyond Self:
; `(deftrait Get [Self K E] …)` — Self determines them (one impl per type).
; `requires` = the SUPERTRAITS from a `:requires [Base …]` clause (gen-8): every
; impl of this trait must also impl each Base. This is a SEPARATE axis from the
; type-param vector, so `[Self …]` (associated types) and supertraits stop sharing
; one syntax; the names here are qualified by the resolver like any trait name.
(defstruct TraitDef
  [(name (slice u8))
   (self_param (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (requires (ptr (ArrayList (slice u8))))
   (methods (ptr (ArrayList TraitMethod)))])
; An impl's kind owns its trait name when there is one. Keeping this distinction
; explicit prevents inherent impls from masquerading as a trait named "".
(defsum ImplKind
  (TraitImpl [(trait_name (slice u8))])
  (InherentImpl []))
; A GENERIC impl `(impl [T] Push (ArrayList T) …)` carries its type params and
; the full implementing-type pattern in `self_type`; `for_type` is the dispatch
; BASE name derived from it (kept in sync by the resolver after qualification).
; Both kinds share one record so their methods use the same qualify/check/lower
; pipeline without encoding the distinction in a magic string.
(defstruct ImplDef
  [(kind ImplKind)
   (for_type (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (self_type Type)
   (methods (ptr (ArrayList Func)))])

(defn impl-is-inherent [(im (ptr ImplDef))] (-> bool)
  (match-else (primitive/load (primitive/field im kind)) (InherentImpl [] true) (_ false)))
(defn impl-is-trait [(im (ptr ImplDef))] (-> bool)
  (not (impl-is-inherent im)))
(defn impl-trait-name [(im (ptr ImplDef))] (-> (slice u8))
  (match (primitive/load (primitive/field im kind))
    (TraitImpl [name] name)
    (InherentImpl [] (do (abort) (primitive/zeroed (slice u8))))))

(defstruct ExportC
  [(name (slice u8))
   (symbol (Option (slice u8)))
   (params (ptr (ArrayList Type)))
   (lo i64)
   (hi i64)
   (source i64)
   (ctxt i64)])

; The whole program. `statics` is omitted: parsing never
; produces statics (they come from checking), so the dump always emits an empty
; `(statics)` section.
(defstruct Program
  [(conventions (ptr (ArrayList Convention)))
   (structs (ptr (ArrayList StructDef)))
   (sums (ptr (ArrayList SumDef)))
   (externs (ptr (ArrayList Extern)))
   (funcs (ptr (ArrayList Func)))
   (asserts (ptr (ArrayList StaticAssert)))
   (consts (ptr (ArrayList Const)))
   (traits (ptr (ArrayList TraitDef)))
   (impls (ptr (ArrayList ImplDef)))
   (metas (ptr (ArrayList Expr)))
   (exports (ptr (ArrayList ExportC)))])

; A parse/read diagnostic; dummy span = -1.
(defstruct Diag [(lo i64) (hi i64) (msg (slice u8)) (source i64) (ctxt i64)])

; ============================ small constructors =============================
; Monotonic node-id counter. Every Sexp gets a unique nid at construction (starting at
; 1; 0 means "no id"). Deterministic — the same source produces the same nids in the
; same order, so the rebootstrap fixpoint holds.
(defstruct NidCell [(n i64)])
(defn nid-cell [] (-> (ptr NidCell))
  (alloc/static NidCell))
(defn next-nid [] (-> i64)
  (let [c (nid-cell)
        v (primitive/iadd (primitive/load (primitive/field c n)) 1)]
    (primitive/store! (primitive/field c n) v)
    v))

; ── TYPE-REFERENCE resolution registry (for exact `(primitive/code-decl TYPE-NODE)`) ────
; Types carry no node id (adding one to the Type sum ripples across every match),
; so instead the resolver records, at qualify-type, what each `(module, raw type
; name)` resolves to. A metaprogram then resolves a type node exactly: its raw name
; (the symbol) + its module (via the source→module map below) → the qualified type.
(defstruct TypeResEntry [(module (slice u8)) (raw (slice u8)) (qual (slice u8))])
(defstruct TypeResBox [(init i64) (lst (ptr (ArrayList TypeResEntry)))])
(defn type-res-box [] (-> (ptr TypeResBox))
  (alloc/static TypeResBox))
(defn type-res-list [] (-> (ptr (ArrayList TypeResEntry)))
  (let [b (type-res-box)]
    (when (primitive/icmp-eq (primitive/load (primitive/field b init)) 0)
          (primitive/store! (primitive/field b lst)
                  (unwrap-ptr [(ArrayList TypeResEntry)] (create [(ArrayList TypeResEntry)] (malloc-allocator))))
          (primitive/store! (primitive/load (primitive/field b lst)) (al-new [TypeResEntry] (malloc-allocator)))
          (primitive/store! (primitive/field b init) 1)
          0)
    (primitive/load (primitive/field b lst))))
(defn type-res-reset [] (-> i64)
  (let [_ (type-res-list)
        b (type-res-box)]
    (primitive/store! (primitive/load (primitive/field b lst)) (al-new [TypeResEntry] (malloc-allocator)))
    0))
(defn type-res-record [(module (slice u8)) (raw (slice u8)) (qual (slice u8))] (-> i64)
  (let [e (alloc/stack TypeResEntry)]
    (primitive/store! (primitive/field e module) module)
    (primitive/store! (primitive/field e raw) raw)
    (primitive/store! (primitive/field e qual) qual)
    (al-push! (type-res-list) (primitive/load e))
    0))
(defn type-res-lookup [(module (slice u8)) (raw (slice u8))] (-> (slice u8))
  (let [lst (type-res-list)
        n (al-len [TypeResEntry] (primitive/load lst))
        (mut i) (primitive/isub n 1)
        (mut r) ""
        e (alloc/stack TypeResEntry)]
    (loop (if (primitive/icmp-lt (primitive/load i) 0)
              (break)
              (do
                (primitive/store! e (al-get [TypeResEntry] (primitive/load lst) (primitive/load i)))
                (when (and (str-eq (primitive/load (primitive/field e module)) module) (str-eq (primitive/load (primitive/field e raw)) raw))
                      (primitive/store! r (primitive/load (primitive/field e qual)))
                      (break))
                (primitive/store! i (primitive/isub (primitive/load i) 1)))))
    (primitive/load r)))
; ── source-id → module-name map (so a node's module is known at query time) ───
(defstruct SrcModEntry [(source i64) (module (slice u8))])
(defstruct SrcModBox [(init i64) (lst (ptr (ArrayList SrcModEntry)))])
(defn src-mod-box [] (-> (ptr SrcModBox))
  (alloc/static SrcModBox))
(defn src-mod-list [] (-> (ptr (ArrayList SrcModEntry)))
  (let [b (src-mod-box)]
    (when (primitive/icmp-eq (primitive/load (primitive/field b init)) 0)
          (primitive/store! (primitive/field b lst)
                  (unwrap-ptr [(ArrayList SrcModEntry)] (create [(ArrayList SrcModEntry)] (malloc-allocator))))
          (primitive/store! (primitive/load (primitive/field b lst)) (al-new [SrcModEntry] (malloc-allocator)))
          (primitive/store! (primitive/field b init) 1)
          0)
    (primitive/load (primitive/field b lst))))
(defn src-mod-reset [] (-> i64)
  (let [_ (src-mod-list)
        b (src-mod-box)]
    (primitive/store! (primitive/load (primitive/field b lst)) (al-new [SrcModEntry] (malloc-allocator)))
    0))
(defn src-mod-record [(source i64) (module (slice u8))] (-> i64)
  (unless (primitive/icmp-lt source 0)
          (let [e (alloc/stack SrcModEntry)]
            (primitive/store! (primitive/field e source) source)
            (primitive/store! (primitive/field e module) module)
            (al-push! (src-mod-list) (primitive/load e))
            0)))
(defn src-mod-lookup [(source i64)] (-> (slice u8))
  (let [lst (src-mod-list)
        n (al-len [SrcModEntry] (primitive/load lst))
        (mut i) 0
        (mut r) ""
        e (alloc/stack SrcModEntry)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (primitive/store! e (al-get [SrcModEntry] (primitive/load lst) (primitive/load i)))
                (when (primitive/icmp-eq (primitive/load (primitive/field e source)) source) (primitive/store! r (primitive/load (primitive/field e module))) (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/load r)))
(defn mk-sexp [(kind SexpKind) (lo i64) (hi i64)] (-> Sexp)
  (let [p (alloc/stack Sexp)]
    (primitive/store! (primitive/field p kind) kind)
    (primitive/store! (primitive/field p lo) lo)
    (primitive/store! (primitive/field p hi) hi)
    (primitive/store! (primitive/field p source) (when (primitive/icmp-lt lo 0) -1))
    (primitive/store! (primitive/field p ctxt) 0)
    (primitive/store! (primitive/field p nid) (next-nid))
    (primitive/load p)))
(defn mk-tok [(kind TokKind) (lo i64) (hi i64)] (-> Tok)
  (let [p (alloc/stack Tok)]
    (primitive/store! (primitive/field p kind) kind)
    (primitive/store! (primitive/field p lo) lo)
    (primitive/store! (primitive/field p hi) hi)
    (primitive/load p)))
; source = -1 means "not yet attributed to a file"; the span is file-relative, so
; it is meaningless until a caller stamps the source that `lo`/`hi` are offsets
; into (dwspan / diag-with-source). Defaulting to 0 instead would silently claim
; every diagnostic came from the entry file, rendering the right offsets against
; the wrong source text.
(defn mk-diag [(lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (let [p (alloc/stack Diag)]
    (primitive/store! (primitive/field p lo) lo)
    (primitive/store! (primitive/field p hi) hi)
    (primitive/store! (primitive/field p msg) msg)
    (primitive/store! (primitive/field p source) -1)
    (primitive/store! (primitive/field p ctxt) 0)
    (primitive/load p)))
(defn mk-diag-src [(source i64) (lo i64) (hi i64) (msg (slice u8))] (-> Diag)
  (let [p (alloc/stack Diag)]
    (primitive/store! p (mk-diag lo hi msg))
    (primitive/store! (primitive/field p source) source)
    (primitive/load p)))
(defn mk-strread [(s (slice u8)) (end i64)] (-> StrRead)
  (let [p (alloc/stack StrRead)]
    (primitive/store! (primitive/field p s) s)
    (primitive/store! (primitive/field p end) end)
    (primitive/load p)))

(defn box-items [(a (ptr Allocator)) (items (ArrayList Sexp))] (-> (ptr (ArrayList Sexp)))
  (let [p (unwrap-ptr [(ArrayList Sexp)] (create [(ArrayList Sexp)] a))]
    (primitive/store! p items)
    p))
(defn box-sexp [(a (ptr Allocator)) (s Sexp)] (-> (ptr Sexp))
  (let [p (unwrap-ptr [Sexp] (create [Sexp] a))] (primitive/store! p s) p))
(defn box-expr [(a (ptr Allocator)) (e Expr)] (-> (ptr Expr))
  (let [p (unwrap-ptr [Expr] (create [Expr] a))] (primitive/store! p e) p))
(defn box-type [(a (ptr Allocator)) (t Type)] (-> (ptr Type))
  (let [p (unwrap-ptr [Type] (create [Type] a))] (primitive/store! p t) p))

(defn mk-expr [(kind ExprKind) (lo i64) (hi i64) (source i64) (ctxt i64)] (-> Expr)
  (let [p (alloc/stack Expr)]
    (primitive/store! (primitive/field p kind) kind)
    (primitive/store! (primitive/field p lo) lo)
    (primitive/store! (primitive/field p hi) hi)
    (primitive/store! (primitive/field p source) source)
    (primitive/store! (primitive/field p ctxt) ctxt)
    (primitive/store! (primitive/field p nid) -1)
    (primitive/load p)))
; Like mk-expr but carrying a source node id (parse-expr uses this so type-of can key
; on node identity). Synthesized exprs keep mk-expr's -1.
(defn mk-expr-nid [(kind ExprKind) (lo i64) (hi i64) (source i64) (ctxt i64) (nid i64)] (-> Expr)
  (let [p (alloc/stack Expr)]
    (primitive/store! (primitive/field p kind) kind)
    (primitive/store! (primitive/field p lo) lo)
    (primitive/store! (primitive/field p hi) hi)
    (primitive/store! (primitive/field p source) source)
    (primitive/store! (primitive/field p ctxt) ctxt)
    (primitive/store! (primitive/field p nid) nid)
    (primitive/load p)))
; Rebuild a Sexp of `kind` preserving `orig`'s full span (source+ctxt+lo+hi),
; mirroring `Sexp::new(kind, s.span)` — so the expander's non-macro
; List/Vector reconstruction never drops source/ctxt.
(defn mk-sexp-src [(kind SexpKind) (orig (ptr Sexp))] (-> Sexp)
  (let [p (alloc/stack Sexp)]
    (primitive/store! (primitive/field p kind) kind)
    (primitive/store! (primitive/field p lo) (primitive/load (primitive/field orig lo)))
    (primitive/store! (primitive/field p hi) (primitive/load (primitive/field orig hi)))
    (primitive/store! (primitive/field p source) (primitive/load (primitive/field orig source)))
    (primitive/store! (primitive/field p ctxt) (primitive/load (primitive/field orig ctxt)))
    (primitive/store! (primitive/field p nid) (next-nid))
    (primitive/load p)))

; ============================ numeric/string utils ===========================
(defn f64-bits [(x f64)] (-> i64)
  (let [p (alloc/stack f64)] (primitive/store! p x) (primitive/load (primitive/cast (ptr i64) p))))

(defn slice->cstr [(a (ptr Allocator)) (s (slice u8))] (-> (ptr i8))
  (let [n (slice-len s)
        buf (unwrap-ptr [i8] (raw-alloc a (primitive/iadd n 1) 1))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (primitive/store! (primitive/index buf (primitive/load i)) (primitive/cast i8 (slice-get s (primitive/load i))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/store! (primitive/index buf n) (primitive/cast i8 0))
    buf))

; ============================ output primitives ==============================
(defn wb [(w (ptr Writer)) (b i64)] (-> i64)
  (write-byte w (primitive/cast u8 b))
  0)
(defn ps [(w (ptr Writer)) (s (slice u8))] (-> i64)
  (print-str w s)
  0)
(defn hexd [(d i64)] (-> i64)
  (if (primitive/icmp-lt d 10) (primitive/iadd d 48) (primitive/iadd d 87)))

(defn dump-dec-mag [(w (ptr Writer)) (n i64)] (-> i64)
  (if (primitive/icmp-lt n 10)
      (wb w (primitive/iadd n 48))
      (do (dump-dec-mag w (primitive/udiv n 10)) (wb w (primitive/iadd (primitive/urem n 10) 48)))))
(defn dump-dec [(w (ptr Writer)) (n i64)] (-> i64)
  (if (primitive/icmp-lt n 0)
      (do (wb w 45) (dump-dec-mag w (primitive/isub 0 n)))
      (dump-dec-mag w n)))

(defn u-hex16 [(w (ptr Writer)) (n i64)] (-> i64)
  (let [(mut k) 60]
    (loop (if (primitive/icmp-lt (primitive/load k) 0)
              (break)
              (do (wb w (hexd (primitive/iand (primitive/ishr n (primitive/load k)) 15))) (primitive/store! k (primitive/isub (primitive/load k) 4))))))
  0)

; A span `@lo:hi`, dummy (lo/hi = -1) prints as `@D:…`/`…:D` (mirrors dump_span).
(defn dump-span-field [(w (ptr Writer)) (v i64)] (-> i64)
  (if (primitive/icmp-lt v 0) (wb w 68) (dump-dec w v)))
(defn dump-span [(w (ptr Writer)) (source i64) (lo i64) (hi i64) (ctxt i64)] (-> i64)
  (wb w 64)
  (dump-span-field w source)
  (wb w 58)
  (dump-span-field w lo)
  (wb w 58)
  (dump-span-field w hi)
  (wb w 58)
  (dump-span-field w ctxt))

(defn hex2 [(w (ptr Writer)) (b i64)] (-> i64)
  (wb w (hexd (primitive/iand (primitive/ishr b 4) 15)))
  (wb w (hexd (primitive/iand b 15))))
(defn esc-write [(w (ptr Writer)) (s (slice u8))] (-> i64)
  (let [(mut i) 0
        n (slice-len s)]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (let [b (primitive/cast i64 (slice-get s (primitive/load i)))]
                  (cond (primitive/icmp-eq b 92) (ps w "\\\\")
                        (primitive/icmp-eq b 34) (ps w "\\\"")
                        (primitive/icmp-eq b 10) (ps w "\\n")
                        (primitive/icmp-eq b 9) (ps w "\\t")
                        (primitive/icmp-eq b 13) (ps w "\\r")
                        (and (primitive/icmp-ge b 32) (primitive/icmp-le b 126)) (wb w b)
                        :else (do (ps w "\\x") (hex2 w b))))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  0)
; A quoted string `"<escaped>"`.
(defn dstr [(w (ptr Writer)) (s (slice u8))] (-> i64)
  (wb w 34)
  (esc-write w s)
  (wb w 34))
; A bool as '1'/'0'.
(defn dbool [(w (ptr Writer)) (b bool)] (-> i64)
  (if b (wb w 49) (wb w 48)))

; ============================ Sexp canonical dump (for quote) =================
; Mirrors dump_node (reused by EQuote / QLit). Identical to
; src/compiler/reader.coil's dumper.
(defn sx-atom [(w (ptr Writer)) (tag (slice u8)) (s (slice u8)) (source i64) (lo i64) (hi i64) (ctxt i64)] (-> i64)
  (wb w 40)
  (ps w tag)
  (dump-span w source lo hi ctxt)
  (ps w " \"")
  (esc-write w s)
  (ps w "\")"))
(defn sx-seq [(w (ptr Writer))
              (tag (slice u8))
              (items (ptr (ArrayList Sexp)))
              (source i64)
              (lo i64)
              (hi i64)
              (ctxt i64)] (-> i64)
  (wb w 40)
  (ps w tag)
  (dump-span w source lo hi ctxt)
  (let [(mut i) 0
        n (al-len [Sexp] (primitive/load items))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [child (alloc/stack Sexp)]
                  (primitive/store! child (al-get [Sexp] (primitive/load items) (primitive/load i)))
                  (sx-node w child))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41))
(defn sx-node [(w (ptr Writer)) (x (ptr Sexp))] (-> i64)
  (let [lo (primitive/load (primitive/field x lo))
        hi (primitive/load (primitive/field x hi))
        src (primitive/load (primitive/field x source))
        ctxt (primitive/load (primitive/field x ctxt))]
    (match (primitive/load (primitive/field x kind))
      (KInt [v] (do (ps w "(int") (dump-span w src lo hi ctxt) (wb w 32) (dump-dec w v) (wb w 41)))
      (KFloat [bits] (do (ps w "(float") (dump-span w src lo hi ctxt) (ps w " 0x") (u-hex16 w bits) (wb w 41)))
      (KSym [s] (sx-atom w "sym" s src lo hi ctxt))
      (KKw [s] (sx-atom w "kw" s src lo hi ctxt))
      (KStr [s] (sx-atom w "str" s src lo hi ctxt))
      (KCStr [s] (sx-atom w "cstr" s src lo hi ctxt))
      (KList [items] (sx-seq w "list" items src lo hi ctxt))
      (KVec [items] (sx-seq w "vec" items src lo hi ctxt)))))

; ============================ AST canonical dump =============================

; `["a" "b"]` — a vector of strings.
