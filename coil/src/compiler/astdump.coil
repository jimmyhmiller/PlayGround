; src/compiler/astdump.coil — self-host Coil compiler, astdump module.
(module astdump)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ast.coil" :use *)

(defn d-strs [(w (ptr Writer)) (v (ptr (ArrayList (slice u8))))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [(slice u8)] (primitive/load v))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (dstr w (al-get [(slice u8)] (primitive/load v) (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93))

; `(some "x")` / `(none)` — an optional string.
(defn d-opt-str [(w (ptr Writer)) (v (Option (slice u8)))] (-> i64)
  (match v
    (Some [s] (do (ps w "(some ") (dstr w s) (wb w 41)))
    (None [] (ps w "(none)"))))

; ---- types ----
(defn d-types [(w (ptr Writer)) (v (ptr (ArrayList Type)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [Type] (primitive/load v))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (let [t (alloc/stack Type)] (primitive/store! t (al-get [Type] (primitive/load v) (primitive/load i))) (d-type w t))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93))

(defn d-type [(w (ptr Writer)) (t (ptr Type))] (-> i64)
  (match (primitive/load t)
    (TInt [bits signed] (do (ps w "(int ") (dump-dec w bits) (wb w 32) (dbool w signed) (wb w 41)))
    (TFloat [bits] (do (ps w "(float ") (dump-dec w bits) (wb w 41)))
    (TBool [] (ps w "bool"))
    (TVoid [] (ps w "void"))
    (TPtr [inner] (do (ps w "(ptr ") (d-type w inner) (wb w 41)))
    (TRef [m inner] (do (ps w "(ref ") (dbool w m) (wb w 32) (d-type w inner) (wb w 41)))
    (TStruct [name] (do (ps w "(primitive/struct? ") (dstr w name) (wb w 41)))
    (TArray [elem n] (do (ps w "(array ") (d-type w elem) (wb w 32) (dump-dec w n) (wb w 41)))
    (TSlice [elem] (do (ps w "(slice ") (d-type w elem) (wb w 41)))
    (TVec [elem n] (do (ps w "(vec ") (d-type w elem) (wb w 32) (dump-dec w n) (wb w 41)))
    (TFn [cc params ret] (do (ps w "(fn ") (dstr w cc) (wb w 32) (d-types w params) (wb w 32) (d-type w ret) (wb w 41)))
    (TApp [name args] (do (ps w "(app ") (dstr w name) (wb w 32) (d-types w args) (wb w 41)))
    (TNever [] (ps w "never"))
    (TCode [] (ps w "code"))
    (TExternRef [] (ps w "externref"))))

; ---- enum-tag dumpers (i64 code -> string) ----
(defn d-binop [(w (ptr Writer)) (op i64)] (-> i64)
  (ps w
      (cond (primitive/icmp-eq op 0) "add"
            (primitive/icmp-eq op 1) "sub"
            (primitive/icmp-eq op 2) "mul"
            (primitive/icmp-eq op 3) "div"
            (primitive/icmp-eq op 4) "rem"
            (primitive/icmp-eq op 5) "udiv"
            (primitive/icmp-eq op 6) "urem"
            (primitive/icmp-eq op 7) "and"
            (primitive/icmp-eq op 8) "or"
            (primitive/icmp-eq op 9) "xor"
            (primitive/icmp-eq op 10) "shl"
            :else "shr")))
(defn d-cmpop [(w (ptr Writer)) (op i64)] (-> i64)
  (ps w
      (cond (primitive/icmp-eq op 0) "lt"
            (primitive/icmp-eq op 1) "le"
            (primitive/icmp-eq op 2) "gt"
            (primitive/icmp-eq op 3) "ge"
            (primitive/icmp-eq op 4) "eq"
            :else "ne")))
(defn d-storage [(w (ptr Writer)) (s i64)] (-> i64)
  (ps w (if (primitive/icmp-eq s 0) "stack" (if (primitive/icmp-eq s 1) "static" "heap"))))
(defn d-typequery [(w (ptr Writer)) (q i64)] (-> i64)
  (ps w
      (cond (primitive/icmp-eq q 0) "fieldcount"
            (primitive/icmp-eq q 1) "variantcount"
            (primitive/icmp-eq q 2) "isstruct"
            (primitive/icmp-eq q 3) "issum"
            (primitive/icmp-eq q 4) "isint"
            (primitive/icmp-eq q 5) "isfloat"
            (primitive/icmp-eq q 6) "isptr"
            :else "isarray")))
(defn d-fieldmeta [(w (ptr Writer)) (m i64)] (-> i64)
  (ps w (if (primitive/icmp-eq m 0) "name" (if (primitive/icmp-eq m 1) "typekind" "typename"))))
(defn d-codeop [(w (ptr Writer)) (op i64)] (-> i64)
  (ps w
      (cond (primitive/icmp-eq op 0) "islist"
            (primitive/icmp-eq op 1) "issym"
            (primitive/icmp-eq op 2) "isint"
            (primitive/icmp-eq op 3) "count"
            (primitive/icmp-eq op 4) "nth"
            (primitive/icmp-eq op 5) "sym"
            (primitive/icmp-eq op 6) "int"
            (primitive/icmp-eq op 7) "rest"
            (primitive/icmp-eq op 8) "gensym"
            (primitive/icmp-eq op 9) "error"
            (primitive/icmp-eq op 10) "eq"
            (primitive/icmp-eq op 11) "iskeyword"
            (primitive/icmp-eq op 12) "symbol"
            (primitive/icmp-eq op 13) "str"
            (primitive/icmp-eq op 14) "cfieldcount"
            (primitive/icmp-eq op 15) "cfieldname"
            (primitive/icmp-eq op 16) "cfieldkind"
            (primitive/icmp-eq op 17) "cfieldtype"
            (primitive/icmp-eq op 18) "cvariantsum"
            (primitive/icmp-eq op 19) "cvariantcount"
            (primitive/icmp-eq op 20) "cvariantname"
            (primitive/icmp-eq op 21) "cvariantfields"
            (primitive/icmp-eq op 22) "ctraitmethodcount"
            (primitive/icmp-eq op 23) "ctraitmethodname"
            (primitive/icmp-eq op
                     24)
              "ctraitarity"
            (primitive/icmp-eq op
                     25)
              "ctraitparamname"
            (primitive/icmp-eq op
                     26)
              "ctraitparamtype"
            (primitive/icmp-eq op
                     27)
              "ctraitrettype"
            (primitive/icmp-eq op
                     28)
              "strbytes"
            (primitive/icmp-eq op
                     29)
              "bytestostr"
            (primitive/icmp-eq op
                     30)
              "targetarch"
            (primitive/icmp-eq op
                     31)
              "report"
            (primitive/icmp-eq op
                     32)
              "warn"
            (primitive/icmp-eq op
                     33)
              "codefile"
            (primitive/icmp-eq op
                     34)
              "codefromuser"
            (primitive/icmp-eq op
                     35)
              "codedecl"
            (primitive/icmp-eq op
                     36)
              "typeof"
            (primitive/icmp-eq op
                     37)
              "bindingof"
            :else "codefromuser")))

; ---- exprs ----
(defn d-exprs [(w (ptr Writer)) (v (ptr (ArrayList Expr)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [Expr] (primitive/load v))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (let [e (alloc/stack Expr)] (primitive/store! e (al-get [Expr] (primitive/load v) (primitive/load i))) (d-expr w e))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93))

(defn d-opt-expr [(w (ptr Writer)) (v (Option (ptr Expr)))] (-> i64)
  (match v
    (Some [e] (do (ps w "(some ") (d-expr w e) (wb w 41)))
    (None [] (ps w "(none)"))))

(defn d-binds [(w (ptr Writer)) (v (ptr (ArrayList Bind)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [Bind] (primitive/load v))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (let [b (alloc/stack Bind)]
                  (primitive/store! b (al-get [Bind] (primitive/load v) (primitive/load i)))
                  (ps w "(bind ")
                  (dstr w (primitive/load (primitive/field b name)))
                  (wb w 32)
                  (dbool w (primitive/load (primitive/field b mutable)))
                  (wb w 32)
                  (let [ve (alloc/stack Expr)] (primitive/store! ve (primitive/load (primitive/field b value))) (d-expr w ve))
                  (wb w 41))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93))

(defn d-arms [(w (ptr Writer)) (v (ptr (ArrayList Arm)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [Arm] (primitive/load v))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (let [a (alloc/stack Arm)]
                  (primitive/store! a (al-get [Arm] (primitive/load v) (primitive/load i)))
                  (ps w "(arm ")
                  (dstr w (primitive/load (primitive/field a variant)))
                  (wb w 32)
                  (d-strs w (primitive/load (primitive/field a binds)))
                  (wb w 32)
                  (let [be (alloc/stack Expr)] (primitive/store! be (primitive/load (primitive/field a body))) (d-expr w be))
                  (wb w 41))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93))

(defn d-quasi [(w (ptr Writer)) (q (ptr Quasi))] (-> i64)
  (match (primitive/load q)
    (QLit [form] (do (ps w "(qlit ") (sx-node w form) (wb w 41)))
    (QUnquote [e] (do (ps w "(qunq ") (d-expr w e) (wb w 41)))
    (QSplice [e] (do (ps w "(qspl ") (d-expr w e) (wb w 41)))
    (QList [items]
           (do
             (ps w "(qlist")
             (let [(mut i) 0
                   n (al-len [Quasi] (primitive/load items))]
               (loop (if (primitive/icmp-ge (primitive/load i) n)
                         (break)
                         (do
                           (wb w 32)
                           (let [c (alloc/stack Quasi)] (primitive/store! c (al-get [Quasi] (primitive/load items) (primitive/load i))) (d-quasi w c))
                           (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
             (wb w 41)))
    (QVector [items]
             (do
               (ps w "(qvec")
               (let [(mut i) 0
                     n (al-len [Quasi] (primitive/load items))]
                 (loop (if (primitive/icmp-ge (primitive/load i) n)
                           (break)
                           (do
                             (wb w 32)
                             (let [c (alloc/stack Quasi)]
                               (primitive/store! c (al-get [Quasi] (primitive/load items) (primitive/load i)))
                               (d-quasi w c))
                             (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
               (wb w 41)))))

(defn d-expr [(w (ptr Writer)) (e (ptr Expr))] (-> i64)
  (let [lo (primitive/load (primitive/field e lo))
        hi (primitive/load (primitive/field e hi))
        src (primitive/load (primitive/field e source))
        ctxt (primitive/load (primitive/field e ctxt))]
    (wb w 40)
    (match (primitive/load (primitive/field e kind))
      (EInt [v] (do (ps w "eint") (dump-span w src lo hi ctxt) (wb w 32) (dump-dec w v)))
      (EFloat [bits] (do (ps w "efloat") (dump-span w src lo hi ctxt) (ps w " 0x") (u-hex16 w bits)))
      (EBool [b] (do (ps w "ebool") (dump-span w src lo hi ctxt) (wb w 32) (dbool w b)))
      (EStr [s] (do (ps w "estr") (dump-span w src lo hi ctxt) (wb w 32) (dstr w s)))
      (ECStr [s] (do (ps w "ecstr") (dump-span w src lo hi ctxt) (wb w 32) (dstr w s)))
      (EVar [name] (do (ps w "var") (dump-span w src lo hi ctxt) (wb w 32) (dstr w name)))
      (EZeroed [ty]
               (do
                 (ps w "zeroed")
                 (dump-span w src lo hi ctxt)
                 (wb w 32)
                 (let [t (alloc/stack Type)] (primitive/store! t ty) (d-type w t))))
      (EBorrow [m place]
               (do (ps w "borrow") (dump-span w src lo hi ctxt) (wb w 32) (dbool w m) (wb w 32) (d-expr w place)))
      (ELet [binds body]
            (do (ps w "let") (dump-span w src lo hi ctxt) (wb w 32) (d-binds w binds) (wb w 32) (d-exprs w body)))
      (EBin [op lhs rhs]
            (do
              (ps w "bin")
              (dump-span w src lo hi ctxt)
              (wb w 32)
              (d-binop w op)
              (wb w 32)
              (d-expr w lhs)
              (wb w 32)
              (d-expr w rhs)))
      (ENot [inner] (do (ps w "inot") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w inner)))
      (ECmp [op lhs rhs]
            (do
              (ps w "cmp")
              (dump-span w src lo hi ctxt)
              (wb w 32)
              (d-cmpop w op)
              (wb w 32)
              (d-expr w lhs)
              (wb w 32)
              (d-expr w rhs)))
      (EIf [cnd thn els]
           (do
             (ps w "if")
             (dump-span w src lo hi ctxt)
             (wb w 32)
             (d-expr w cnd)
             (wb w 32)
             (d-expr w thn)
             (wb w 32)
             (d-expr w els)))
      (EDo [body] (do (ps w "do") (dump-span w src lo hi ctxt) (wb w 32) (d-exprs w body)))
      (ECall [func type_args args]
             (do
               (ps w "call")
               (dump-span w src lo hi ctxt)
               (wb w 32)
               (dstr w func)
               (wb w 32)
               (d-types w type_args)
               (wb w 32)
               (d-exprs w args)))
      (EAlloc [storage ty]
              (do
                (ps w "alloc")
                (dump-span w src lo hi ctxt)
                (wb w 32)
                (d-storage w storage)
                (wb w 32)
                (let [t (alloc/stack Type)] (primitive/store! t ty) (d-type w t))))
      (EField [p fname]
              (do (ps w "field") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w p) (wb w 32) (dstr w fname)))
      (ELoad [inner] (do (ps w "load") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w inner)))
      (EStore [p val] (do (ps w "store") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w p) (wb w 32) (d-expr w val)))
      (EIndex [p idx] (do (ps w "index") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w p) (wb w 32) (d-expr w idx)))
      (ECast [ty inner]
             (do
               (ps w "cast")
               (dump-span w src lo hi ctxt)
               (wb w 32)
               (let [t (alloc/stack Type)] (primitive/store! t ty) (d-type w t))
               (wb w 32)
               (d-expr w inner)))
      (ESizeOf [ty]
               (do
                 (ps w "sizeof")
                 (dump-span w src lo hi ctxt)
                 (wb w 32)
                 (let [t (alloc/stack Type)] (primitive/store! t ty) (d-type w t))))
      (EAlignOf [ty]
                (do
                  (ps w "alignof")
                  (dump-span w src lo hi ctxt)
                  (wb w 32)
                  (let [t (alloc/stack Type)] (primitive/store! t ty) (d-type w t))))
      (EOffsetOf [ty fname]
                 (do
                   (ps w "offsetof")
                   (dump-span w src lo hi ctxt)
                   (wb w 32)
                   (let [t (alloc/stack Type)] (primitive/store! t ty) (d-type w t))
                   (wb w 32)
                   (dstr w fname)))
      (EBitGet [p fname]
               (do (ps w "bitget") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w p) (wb w 32) (dstr w fname)))
      (EBitSet [p fname val]
               (do
                 (ps w "bitset")
                 (dump-span w src lo hi ctxt)
                 (wb w 32)
                 (d-expr w p)
                 (wb w 32)
                 (dstr w fname)
                 (wb w 32)
                 (d-expr w val)))
      (EFree [inner] (do (ps w "free") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w inner)))
      (EErase [trait_name inner]
              (do (ps w "erase") (dump-span w src lo hi ctxt) (wb w 32) (dstr w trait_name) (wb w 32) (d-expr w inner)))
      (EMatch [scrut arms]
              (do (ps w "match") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w scrut) (wb w 32) (d-arms w arms)))
      (EFnPtrOf [name] (do (ps w "fnptrof") (dump-span w src lo hi ctxt) (wb w 32) (dstr w name)))
      (ECallPtr [fp args]
                (do (ps w "callptr") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w fp) (wb w 32) (d-exprs w args)))
      (ELoop [label body]
             (do (ps w "loop") (dump-span w src lo hi ctxt) (wb w 32) (d-opt-str w label) (wb w 32) (d-exprs w body)))
      (EBreak [label value]
              (do
                (ps w "break")
                (dump-span w src lo hi ctxt)
                (wb w 32)
                (d-opt-str w label)
                (wb w 32)
                (d-opt-expr w value)))
      (EContinue [label] (do (ps w "continue") (dump-span w src lo hi ctxt) (wb w 32) (d-opt-str w label)))
      (ELlvmIr [result args body]
               (do
                 (ps w "llvmir")
                 (dump-span w src lo hi ctxt)
                 (wb w 32)
                 (let [t (alloc/stack Type)] (primitive/store! t result) (d-type w t))
                 (wb w 32)
                 (d-exprs w args)
                 (wb w 32)
                 (dstr w body)))
      (ETypeQuery [q ty]
                  (do
                    (ps w "typequery")
                    (dump-span w src lo hi ctxt)
                    (wb w 32)
                    (d-typequery w q)
                    (wb w 32)
                    (let [t (alloc/stack Type)] (primitive/store! t ty) (d-type w t))))
      (EFieldMeta [meta ty idx]
                  (do
                    (ps w "fieldmeta")
                    (dump-span w src lo hi ctxt)
                    (wb w 32)
                    (d-fieldmeta w meta)
                    (wb w 32)
                    (let [t (alloc/stack Type)] (primitive/store! t ty) (d-type w t))
                    (wb w 32)
                    (d-expr w idx)))
      (EFieldIndex [ty name]
                   (do
                     (ps w "fieldindex")
                     (dump-span w src lo hi ctxt)
                     (wb w 32)
                     (let [t (alloc/stack Type)] (primitive/store! t ty) (d-type w t))
                     (wb w 32)
                     (d-expr w name)))
      (EQuote [form] (do (ps w "quote") (dump-span w src lo hi ctxt) (wb w 32) (sx-node w form)))
      (ECodeOp [op args]
               (do (ps w "codeop") (dump-span w src lo hi ctxt) (wb w 32) (d-codeop w op) (wb w 32) (d-exprs w args)))
      (EQuasi [q]
              (do
                (ps w "quasi")
                (dump-span w src lo hi ctxt)
                (wb w 32)
                (let [qp (alloc/stack Quasi)] (primitive/store! qp q) (d-quasi w qp))))
      (EComptime [inner] (do (ps w "comptime") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w inner)))
      (EAscribe [ty inner]
                (do
                  (ps w "ascribe")
                  (dump-span w src lo hi ctxt)
                  (wb w 32)
                  (let [t (alloc/stack Type)] (primitive/store! t ty) (d-type w t))
                  (wb w 32)
                  (d-expr w inner)))
      ; ---- the 6 check-introduced variants  ----
      (ESpillRef [inner] (do (ps w "spillref") (dump-span w src lo hi ctxt) (wb w 32) (d-expr w inner)))
      (EConstruct [sum variant args]
                  (do
                    (ps w "construct")
                    (dump-span w src lo hi ctxt)
                    (wb w 32)
                    (dstr w sum)
                    (wb w 32)
                    (dstr w variant)
                    (wb w 32)
                    (d-exprs w args)))
      (ETraitCall [trait_name method self_tp args]
                  (do
                    (ps w "traitcall")
                    (dump-span w src lo hi ctxt)
                    (wb w 32)
                    (dstr w trait_name)
                    (wb w 32)
                    (dstr w method)
                    (wb w 32)
                    (dstr w self_tp)
                    (wb w 32)
                    (d-exprs w args)))
      (EDynDispatch [dyn_struct vtable_struct method_index cc params ret recv args]
                    (do
                      (ps w "dyndispatch")
                      (dump-span w src lo hi ctxt)
                      (wb w 32)
                      (dstr w dyn_struct)
                      (wb w 32)
                      (dstr w vtable_struct)
                      (wb w 32)
                      (dump-dec w method_index)
                      (wb w 32)
                      (dstr w cc)
                      (wb w 32)
                      (d-types w params)
                      (wb w 32)
                      (let [t (alloc/stack Type)] (primitive/store! t ret) (d-type w t))
                      (wb w 32)
                      (d-expr w recv)
                      (wb w 32)
                      (d-exprs w args)))
      (EMakeDyn [dyn_struct vtable_struct methods inner]
                (do
                  (ps w "makedyn")
                  (dump-span w src lo hi ctxt)
                  (wb w 32)
                  (dstr w dyn_struct)
                  (wb w 32)
                  (dstr w vtable_struct)
                  (wb w 32)
                  (d-strs w methods)
                  (wb w 32)
                  (d-expr w inner)))
      (EStaticRef [name] (do (ps w "staticref") (dump-span w src lo hi ctxt) (wb w 32) (dstr w name))))
    (wb w 41)))

; ---- declarations ----
(defn d-param [(w (ptr Writer)) (p (ptr Param))] (-> i64)
  (ps w "(param ")
  (dstr w (primitive/load (primitive/field p name)))
  (wb w 32)
  (let [t (alloc/stack Type)] (primitive/store! t (primitive/load (primitive/field p ty))) (d-type w t))
  (wb w 41))
(defn d-params [(w (ptr Writer)) (v (ptr (ArrayList Param)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [Param] (primitive/load v))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (let [p (alloc/stack Param)] (primitive/store! p (al-get [Param] (primitive/load v) (primitive/load i))) (d-param w p))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93))

(defn d-field [(w (ptr Writer)) (f (ptr Field))] (-> i64)
  (ps w "(fld ")
  (dstr w (primitive/load (primitive/field f name)))
  (wb w 32)
  (let [t (alloc/stack Type)] (primitive/store! t (primitive/load (primitive/field f ty))) (d-type w t))
  (wb w 41))
(defn d-fields [(w (ptr Writer)) (v (ptr (ArrayList Field)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [Field] (primitive/load v))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (let [f (alloc/stack Field)] (primitive/store! f (al-get [Field] (primitive/load v) (primitive/load i))) (d-field w f))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93))

(defn d-i64s [(w (ptr Writer)) (v (ptr (ArrayList i64)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [i64] (primitive/load v))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (dump-dec w (al-get [i64] (primitive/load v) (primitive/load i)))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93))

(defn d-bounds [(w (ptr Writer)) (v (ptr (ArrayList Bound)))] (-> i64)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [Bound] (primitive/load v))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (let [b (alloc/stack Bound)]
                  (primitive/store! b (al-get [Bound] (primitive/load v) (primitive/load i)))
                  (ps w "(bound ")
                  (dstr w (primitive/load (primitive/field b name)))
                  (wb w 32)
                  (d-strs w (primitive/load (primitive/field b traits)))
                  (wb w 41))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93))

(defn d-func [(w (ptr Writer)) (f (ptr Func))] (-> i64)
  (ps w "(func ")
  (dstr w (primitive/load (primitive/field f name)))
  (wb w 32)
  (d-strs w (primitive/load (primitive/field f type_params)))
  (wb w 32)
  (d-bounds w (primitive/load (primitive/field f bounds)))
  (wb w 32)
  (dstr w (primitive/load (primitive/field f cc)))
  (wb w 32)
  (d-params w (primitive/load (primitive/field f params)))
  (wb w 32)
  (let [t (alloc/stack Type)] (primitive/store! t (primitive/load (primitive/field f ret))) (d-type w t))
  (wb w 32)
  (d-exprs w (primitive/load (primitive/field f body)))
  (wb w 32)
  (dbool w (primitive/load (primitive/field f macro_variadic)))
  (wb w 32)
  (dump-span w (primitive/load (primitive/field f source)) (primitive/load (primitive/field f lo)) (primitive/load (primitive/field f hi)) (primitive/load (primitive/field f ctxt)))
  (wb w 41))

(defn d-convention [(w (ptr Writer)) (c (ptr Convention))] (-> i64)
  (ps w "(cc ")
  (dstr w (primitive/load (primitive/field c name)))
  (wb w 32)
  (d-strs w (primitive/load (primitive/field c params)))
  (wb w 32)
  (d-opt-str w (primitive/load (primitive/field c ret)))
  (wb w 32)
  (d-strs w (primitive/load (primitive/field c clobber)))
  (wb w 32)
  (d-strs w (primitive/load (primitive/field c preserve)))
  (wb w 32)
  (match (primitive/load (primitive/field c lowering))
    (LNative [cc] (do (ps w "(native ") (ps w (if (primitive/icmp-eq cc 0) "c" (if (primitive/icmp-eq cc 1) "fast" "cold"))) (wb w 41)))
    (LShim [] (ps w "(shim)")))
  (wb w 41))

(defn d-layout [(w (ptr Writer)) (l (ptr Layout))] (-> i64)
  (match (primitive/load l)
    (LC [] (ps w "(c)"))
    (LPacked [] (ps w "(packed)"))
    (LAligned [n] (do (ps w "(aligned ") (dump-dec w n) (wb w 41)))
    (LExplicit [offsets size align]
               (do
                 (ps w "(explicit ")
                 (d-i64s w offsets)
                 (wb w 32)
                 (match size (Some [n] (do (ps w "(some ") (dump-dec w n) (wb w 41))) (None [] (ps w "(none)")))
                 (wb w 32)
                 (dump-dec w align)
                 (wb w 41)))
    (LBits [backing offsets]
           (do (ps w "(bits ") (dump-dec w backing) (wb w 32) (d-i64s w offsets) (wb w 41)))))

(defn d-struct [(w (ptr Writer)) (s (ptr StructDef))] (-> i64)
  (ps w "(primitive/struct? ")
  (dstr w (primitive/load (primitive/field s name)))
  (wb w 32)
  (d-strs w (primitive/load (primitive/field s type_params)))
  (wb w 32)
  (let [lp (alloc/stack Layout)] (primitive/store! lp (primitive/load (primitive/field s layout))) (d-layout w lp))
  (wb w 32)
  (d-fields w (primitive/load (primitive/field s fields)))
  (wb w 41))

(defn d-variant [(w (ptr Writer)) (vr (ptr Variant))] (-> i64)
  (ps w "(variant ")
  (dstr w (primitive/load (primitive/field vr name)))
  (wb w 32)
  (d-fields w (primitive/load (primitive/field vr fields)))
  (wb w 41))
(defn d-sum [(w (ptr Writer)) (s (ptr SumDef))] (-> i64)
  (ps w "(sum ")
  (dstr w (primitive/load (primitive/field s name)))
  (wb w 32)
  (d-strs w (primitive/load (primitive/field s type_params)))
  (wb w 32)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [Variant] (primitive/load (primitive/field s variants)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (let [vr (alloc/stack Variant)]
                  (primitive/store! vr (al-get [Variant] (primitive/load (primitive/field s variants)) (primitive/load i)))
                  (d-variant w vr))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93)
  (wb w 41))

(defn d-extern [(w (ptr Writer)) (e (ptr Extern))] (-> i64)
  (ps w "(extern ")
  (dstr w (primitive/load (primitive/field e name)))
  (wb w 32)
  (dstr w (primitive/load (primitive/field e cc)))
  (wb w 32)
  (d-types w (primitive/load (primitive/field e params)))
  (wb w 32)
  (dbool w (primitive/load (primitive/field e variadic)))
  (wb w 32)
  (let [t (alloc/stack Type)] (primitive/store! t (primitive/load (primitive/field e ret))) (d-type w t))
  (wb w 41))

(defn d-assert [(w (ptr Writer)) (a (ptr StaticAssert))] (-> i64)
  (ps w "(assert ")
  (let [ce (alloc/stack Expr)] (primitive/store! ce (primitive/load (primitive/field a cnd))) (d-expr w ce))
  (wb w 32)
  (dstr w (primitive/load (primitive/field a msg)))
  (wb w 41))

(defn d-const [(w (ptr Writer)) (c (ptr Const))] (-> i64)
  (ps w "(const ")
  (dstr w (primitive/load (primitive/field c name)))
  (wb w 32)
  (match (primitive/load (primitive/field c ty))
    (Some [t] (do (ps w "(some ") (let [tp (alloc/stack Type)] (primitive/store! tp t) (d-type w tp)) (wb w 41)))
    (None [] (ps w "(none)")))
  (wb w 32)
  (let [ve (alloc/stack Expr)] (primitive/store! ve (primitive/load (primitive/field c value))) (d-expr w ve))
  (wb w 41))

(defn d-trait [(w (ptr Writer)) (t (ptr TraitDef))] (-> i64)
  (ps w "(trait ")
  (dstr w (primitive/load (primitive/field t name)))
  (wb w 32)
  (dstr w (primitive/load (primitive/field t self_param)))
  (wb w 32)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [TraitMethod] (primitive/load (primitive/field t methods)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (let [m (alloc/stack TraitMethod)]
                  (primitive/store! m (al-get [TraitMethod] (primitive/load (primitive/field t methods)) (primitive/load i)))
                  (ps w "(method ")
                  (dstr w (primitive/load (primitive/field m name)))
                  (wb w 32)
                  (d-params w (primitive/load (primitive/field m params)))
                  (wb w 32)
                  (let [rt (alloc/stack Type)] (primitive/store! rt (primitive/load (primitive/field m ret))) (d-type w rt))
                  (wb w 41))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93)
  (wb w 41))

(defn d-impl [(w (ptr Writer)) (im (ptr ImplDef))] (-> i64)
  (if (impl-is-inherent im)
      (ps w "(inherent ")
      (do (ps w "(impl ")
          (dstr w (impl-trait-name im))
          (wb w 32)))
  (dstr w (primitive/load (primitive/field im for_type)))
  (wb w 32)
  (wb w 91)
  (let [(mut i) 0
        n (al-len [Func] (primitive/load (primitive/field im methods)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-gt (primitive/load i) 0) (wb w 32))
                (let [f (alloc/stack Func)] (primitive/store! f (al-get [Func] (primitive/load (primitive/field im methods)) (primitive/load i))) (d-func w f))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 93)
  (wb w 41))

(defn d-export [(w (ptr Writer)) (e (ptr ExportC))] (-> i64)
  (ps w "(export ")
  (dstr w (primitive/load (primitive/field e name)))
  (wb w 32)
  (d-opt-str w (primitive/load (primitive/field e symbol)))
  (wb w 32)
  (d-types w (primitive/load (primitive/field e params)))
  (wb w 32)
  (dump-span w (primitive/load (primitive/field e source)) (primitive/load (primitive/field e lo)) (primitive/load (primitive/field e hi)) (primitive/load (primitive/field e ctxt)))
  (wb w 41))

; Byte-lexicographic `<` on strings (ASCII conv names):
; a proper prefix is less than the longer string.
(defn str-lt [(x (slice u8)) (y (slice u8))] (-> bool)
  (let [nx (slice-len x)
        ny (slice-len y)
        (mut i) 0
        (mut res) 0]
    (loop (if (or (primitive/icmp-ge (primitive/load i) nx) (primitive/icmp-ge (primitive/load i) ny))
              (break)
              (let [cx (primitive/cast i64 (slice-get x (primitive/load i)))
                    cy (primitive/cast i64 (slice-get y (primitive/load i)))]
                (if (primitive/icmp-lt cx cy)
                    (do (primitive/store! res 1) (break))
                    (if (primitive/icmp-gt cx cy)
                        (do (primitive/store! res 2) (break))
                        (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))
    (if (primitive/icmp-eq (primitive/load res) 1) true (if (primitive/icmp-eq (primitive/load res) 2) false (primitive/icmp-lt nx ny)))))
(defn conv-name [(c Convention)] (-> (slice u8))
  (let [p (alloc/stack Convention)] (primitive/store! p c) (primitive/load (primitive/field p name))))

; A whole-section dumper: `(<tag>` then a space+item per element, then `)`.
; Mirrors dump_program's per-section loops.
(defn d-program [(w (ptr Writer)) (p (ptr Program)) (a (ptr Allocator))] (-> i64)
  ; conventions — sorted by name (mirrors dump_program's keys().sort()).
  (ps w "(conventions")
  (let [convs (primitive/load (primitive/field p conventions))
        n (al-len [Convention] convs)
        (mut used) (al-new [bool] a)
        (mut k) 0]
    (loop (if (primitive/icmp-ge (primitive/load k) n) (break) (do (al-push! (mut used) false) (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
    (let [(mut c) 0]
      (loop (if (primitive/icmp-ge (primitive/load c) n)
                (break)
                (do
                  (let [(mut best) -1
                        (mut bi) 0]
                    (loop (if (primitive/icmp-ge (primitive/load bi) n)
                              (break)
                              (do
                                (when (and (not (al-get [bool] (primitive/load used) (primitive/load bi)))
                                           (or (primitive/icmp-lt (primitive/load best) 0)
                                               (str-lt (conv-name (al-get [Convention] convs (primitive/load bi)))
                                                       (conv-name (al-get [Convention] convs (primitive/load best))))))
                                      (primitive/store! best (primitive/load bi)))
                                (primitive/store! bi (primitive/iadd (primitive/load bi) 1)))))
                    (al-set! [bool] (mut used) (primitive/load best) true)
                    (wb w 32)
                    (let [cc (alloc/stack Convention)]
                      (primitive/store! cc (al-get [Convention] convs (primitive/load best)))
                      (d-convention w cc)))
                  (primitive/store! c (primitive/iadd (primitive/load c) 1)))))))
  (wb w 41)
  (ps w "\n(structs")
  (let [(mut i) 0
        n (al-len [StructDef] (primitive/load (primitive/field p structs)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [s (alloc/stack StructDef)]
                  (primitive/store! s (al-get [StructDef] (primitive/load (primitive/field p structs)) (primitive/load i)))
                  (d-struct w s))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41)
  (ps w "\n(sums")
  (let [(mut i) 0
        n (al-len [SumDef] (primitive/load (primitive/field p sums)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [s (alloc/stack SumDef)] (primitive/store! s (al-get [SumDef] (primitive/load (primitive/field p sums)) (primitive/load i))) (d-sum w s))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41)
  (ps w "\n(externs")
  (let [(mut i) 0
        n (al-len [Extern] (primitive/load (primitive/field p externs)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [e (alloc/stack Extern)]
                  (primitive/store! e (al-get [Extern] (primitive/load (primitive/field p externs)) (primitive/load i)))
                  (d-extern w e))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41)
  (ps w "\n(funcs")
  (let [(mut i) 0
        n (al-len [Func] (primitive/load (primitive/field p funcs)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [f (alloc/stack Func)] (primitive/store! f (al-get [Func] (primitive/load (primitive/field p funcs)) (primitive/load i))) (d-func w f))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41)
  (ps w "\n(asserts")
  (let [(mut i) 0
        n (al-len [StaticAssert] (primitive/load (primitive/field p asserts)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [a (alloc/stack StaticAssert)]
                  (primitive/store! a (al-get [StaticAssert] (primitive/load (primitive/field p asserts)) (primitive/load i)))
                  (d-assert w a))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41)
  (ps w "\n(consts")
  (let [(mut i) 0
        n (al-len [Const] (primitive/load (primitive/field p consts)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [c (alloc/stack Const)] (primitive/store! c (al-get [Const] (primitive/load (primitive/field p consts)) (primitive/load i))) (d-const w c))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41)
  (ps w "\n(traits")
  (let [(mut i) 0
        n (al-len [TraitDef] (primitive/load (primitive/field p traits)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [t (alloc/stack TraitDef)]
                  (primitive/store! t (al-get [TraitDef] (primitive/load (primitive/field p traits)) (primitive/load i)))
                  (d-trait w t))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41)
  (ps w "\n(impls")
  (let [(mut i) 0
        n (al-len [ImplDef] (primitive/load (primitive/field p impls)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [im (alloc/stack ImplDef)]
                  (primitive/store! im (al-get [ImplDef] (primitive/load (primitive/field p impls)) (primitive/load i)))
                  (d-impl w im))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41)
  (ps w "\n(statics)")
  (ps w "\n(metas")
  (let [(mut i) 0
        n (al-len [Expr] (primitive/load (primitive/field p metas)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [m (alloc/stack Expr)] (primitive/store! m (al-get [Expr] (primitive/load (primitive/field p metas)) (primitive/load i))) (d-expr w m))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41)
  (ps w "\n(exports")
  (let [(mut i) 0
        n (al-len [ExportC] (primitive/load (primitive/field p exports)))]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (wb w 32)
                (let [e (alloc/stack ExportC)]
                  (primitive/store! e (al-get [ExportC] (primitive/load (primitive/field p exports)) (primitive/load i)))
                  (d-export w e))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
  (wb w 41)
  0)

; ============================ the PORT (implement these) =====================
; Each stub HARD-ABORTS (never a silent wrong value). Replace the body with a
; faithful.
