; src/compiler/layoutdb.coil — one source of truth for runtime type layout.
(module layoutdb)
(import "../stdlib/primitive.coil" :as primitive)

(import "../stdlib/alloc.coil" :as alloc :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "hashmap.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "match.coil" :use *)
(import "ast.coil" :use *)

; The consumers used to have four copies of these records and of every algorithm
; below. Backend state now owns one LayoutDb; ABI classification remains backend-
; specific, but ordinary size/alignment/offset questions cannot drift.
(defstruct LayoutStruct
  [(name (slice u8))
   (fields (ptr (ArrayList Field)))
   (layout Layout)
   (size i64)
   (align i64)
   (offsets (ArrayList i64))])
(defstruct LayoutSum
  [(name (slice u8))
   (variants (ptr (ArrayList Variant)))
   (words i64)])
(defstruct LayoutDb
  [(a (ptr Allocator))
   (owner (slice u8))
   (structs (ArrayList LayoutStruct))
   (sums (ArrayList LayoutSum))
   (struct_idx (HashMap (slice u8) i64))
   (sum_idx (HashMap (slice u8) i64))])

(defn layout-fail [(db (ptr LayoutDb)) (msg (slice u8))] (-> i64)
  (print-str (stderr) (primitive/load (primitive/field db owner)))
  (print-str (stderr) ": ")
  (print-str (stderr) msg)
  (write-byte (stderr) (primitive/cast u8 10))
  (abort)
  0)
(defn layout-fail2 [(db (ptr LayoutDb)) (msg (slice u8)) (what (slice u8))] (-> i64)
  (print-str (stderr) (primitive/load (primitive/field db owner)))
  (print-str (stderr) ": ")
  (print-str (stderr) msg)
  (print-str (stderr) what)
  (write-byte (stderr) (primitive/cast u8 10))
  (abort)
  0)
(defn layout-round-up [(n i64) (a i64)] (-> i64)
  (primitive/imul (primitive/idiv (primitive/iadd n (primitive/isub a 1)) a) a))
(defn layout-align8 [(n i64)] (-> i64)
  (layout-round-up n 8))
(defn layout-at [T] [(xs (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (primitive/index (primitive/load (primitive/field xs data)) i))

(impl LayoutDb
  ; Build all nominal entries first, then sum payload sizes, then struct layouts
  ; in dependency order. No receiver means construction is explicitly qualified.
  (new [(a (ptr Allocator)) (mp (ptr Program)) (owner (slice u8))] (-> LayoutDb)
    (let [db (alloc/stack LayoutDb)]
      (primitive/store! (primitive/field db a) a)
      (primitive/store! (primitive/field db owner) owner)
      (primitive/store! (primitive/field db structs) (al-new [LayoutStruct] a))
      (primitive/store! (primitive/field db sums) (al-new [LayoutSum] a))
      (primitive/store! (primitive/field db struct_idx) (hm-new [(slice u8) i64] a (str-keyops)))
      (primitive/store! (primitive/field db sum_idx) (hm-new [(slice u8) i64] a (str-keyops)))
      (let [ss (primitive/load (primitive/field mp structs))
            n (al-len [StructDef] (primitive/load ss))
            (mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) n)
                  (break)
                  (do
                    (let [sd (layout-at [StructDef] ss (primitive/load i))
                          e (alloc/stack LayoutStruct)]
                      (primitive/store! (primitive/field e name) (primitive/load (primitive/field sd name)))
                      (primitive/store! (primitive/field e fields) (primitive/load (primitive/field sd fields)))
                      (primitive/store! (primitive/field e layout) (primitive/load (primitive/field sd layout)))
                      (primitive/store! (primitive/field e size) 0)
                      (primitive/store! (primitive/field e align) 1)
                      (primitive/store! (primitive/field e offsets) (al-new [i64] a))
                      (hm-put! [(slice u8) i64]
                               (mut (primitive/field db struct_idx))
                               (primitive/load (primitive/field e name))
                               (primitive/load i))
                      (al-push! (mut (primitive/field db structs)) (primitive/load e)))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
      (let [ss (primitive/load (primitive/field mp sums))
            n (al-len [SumDef] (primitive/load ss))
            (mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) n)
                  (break)
                  (do
                    (let [sd (layout-at [SumDef] ss (primitive/load i))
                          e (alloc/stack LayoutSum)]
                      (primitive/store! (primitive/field e name) (primitive/load (primitive/field sd name)))
                      (primitive/store! (primitive/field e variants) (primitive/load (primitive/field sd variants)))
                      (primitive/store! (primitive/field e words) 0)
                      (hm-put! [(slice u8) i64]
                               (mut (primitive/field db sum_idx))
                               (primitive/load (primitive/field e name))
                               (primitive/load i))
                      (al-push! (mut (primitive/field db sums)) (primitive/load e)))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
      (let [n (al-len [LayoutSum] (primitive/load (primitive/field db sums)))
            (mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) n)
                  (break)
                  (do
                    (let [e (layout-at [LayoutSum] (primitive/field db sums) (primitive/load i))]
                      (primitive/store! (primitive/field e words) (sum-words db (primitive/load (primitive/field e variants)))))
                    (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
      (compute-struct-layouts! db)
      (primitive/load db)))

  (struct-index [(db (ptr LayoutDb)) (name (slice u8))] (-> i64)
    (match (hm-get [(slice u8) i64] (primitive/load (primitive/field db struct_idx)) name)
      (Some [i] i)
      (None [] -1)))

  (sum-index [(db (ptr LayoutDb)) (name (slice u8))] (-> i64)
    (match (hm-get [(slice u8) i64] (primitive/load (primitive/field db sum_idx)) name)
      (Some [i] i)
      (None [] -1)))

  (struct-at [(db (ptr LayoutDb)) (i i64)] (-> (ptr LayoutStruct))
    (layout-at [LayoutStruct] (primitive/field db structs) i))

  (sum-at [(db (ptr LayoutDb)) (i i64)] (-> (ptr LayoutSum))
    (layout-at [LayoutSum] (primitive/field db sums) i))

  (size [(db (ptr LayoutDb)) (t (ptr Type))] (-> i64)
    (match (primitive/load t)
      (TInt [bits _s] (cond (primitive/icmp-le bits 8) 1 (primitive/icmp-le bits 16) 2 (primitive/icmp-le bits 32) 4 :else 8))
      (TFloat [bits] (primitive/idiv bits 8))
      (TBool [] 1)
      (TVoid [] (layout-fail db "size on void"))
      (TPtr [_] 8)
      (TRef [_ _] 8)
      (TFn [_ _ _] 8)
      (TNever [] 8)
      (TArray [elem n] (primitive/imul (size db elem) n))
      (TSlice [_] 16)
      (TVec [elem n] (primitive/imul (size db elem) n))
      (TStruct [name]
        (let [si (struct-index db name)]
          (if (primitive/icmp-ge si 0)
              (primitive/load (primitive/field (struct-at db si) size))
              (let [su (sum-index db name)]
                (if (primitive/icmp-ge su 0)
                    (primitive/iadd 8 (primitive/imul 8 (primitive/load (primitive/field (sum-at db su) words))))
                    (layout-fail2 db "unknown nominal type: " name))))))
      (TApp [_ _] (layout-fail db "generic type reached layout after monomorphization"))
      (TCode [] (layout-fail db "Code reached runtime layout"))
      (TExternRef [] (layout-fail db "externref reached native layout"))))

  (align [(db (ptr LayoutDb)) (t (ptr Type))] (-> i64)
    (match (primitive/load t)
      (TInt [bits _s] (cond (primitive/icmp-le bits 8) 1 (primitive/icmp-le bits 16) 2 (primitive/icmp-le bits 32) 4 :else 8))
      (TFloat [bits] (primitive/idiv bits 8))
      (TBool [] 1)
      (TVoid [] (layout-fail db "align on void"))
      (TPtr [_] 8)
      (TRef [_ _] 8)
      (TFn [_ _ _] 8)
      (TNever [] 8)
      (TArray [elem _n] (align db elem))
      (TSlice [_] 8)
      (TVec [elem n] (primitive/imul (align db elem) n))
      (TStruct [name]
        (let [si (struct-index db name)]
          (if (primitive/icmp-ge si 0)
              (primitive/load (primitive/field (struct-at db si) align))
              (if (primitive/icmp-ge (sum-index db name) 0)
                  8
                  (layout-fail2 db "unknown nominal type: " name)))))
      (TApp [_ _] (layout-fail db "generic type reached layout after monomorphization"))
      (TCode [] (layout-fail db "Code reached runtime layout"))
      (TExternRef [] (layout-fail db "externref reached native layout"))))

  (field-offset [(db (ptr LayoutDb)) (si i64) (fi i64)] (-> i64)
    (al-get [i64] (primitive/load (primitive/field (struct-at db si) offsets)) fi))

  (field-number [(db (ptr LayoutDb)) (si i64) (name (slice u8))] (-> i64)
    (let [fs (primitive/load (primitive/field (struct-at db si) fields))
          n (al-len [Field] (primitive/load fs))
          (mut i) 0
          (mut found) -1]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (when (str-eq (primitive/load (primitive/field (layout-at [Field] fs (primitive/load i)) name)) name)
                    (primitive/store! found (primitive/load i))
                    (break))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (when (primitive/icmp-lt (primitive/load found) 0) (layout-fail2 db "no such field: " name))
      (primitive/load found)))

  (variant-number [(db (ptr LayoutDb)) (su i64) (name (slice u8))] (-> i64)
    (let [vs (primitive/load (primitive/field (sum-at db su) variants))
          n (al-len [Variant] (primitive/load vs))
          (mut i) 0
          (mut found) -1]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do
                  (when (str-eq (primitive/load (primitive/field (layout-at [Variant] vs (primitive/load i)) name)) name)
                    (primitive/store! found (primitive/load i))
                    (break))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (when (primitive/icmp-lt (primitive/load found) 0) (layout-fail2 db "no such variant: " name))
      (primitive/load found)))

  ; Conservative SUM PAYLOAD sizing. Each field occupies an 8-byte-rounded
  ; region, matching LLVM's [words x i64] payload representation.
  (type-bytes [(db (ptr LayoutDb)) (t (ptr Type))] (-> i64)
    (match (primitive/load t)
      ; Integer widths are arbitrary. Round partial bytes up: i9 occupies two
      ; bytes, which matters when arrays of narrow integers live in sum payloads.
      (TInt [bits _s] (primitive/idiv (primitive/iadd bits 7) 8))
      (TFloat [bits] (primitive/idiv bits 8))
      (TBool [] 1)
      (TPtr [_] 8)
      (TRef [_ _] 8)
      (TFn [_ _ _] 8)
      (TNever [] 8)
      (TArray [elem n] (primitive/imul (type-bytes db elem) n))
      (TSlice [_] 16)
      (TVec [elem n] (primitive/imul (type-bytes db elem) n))
      (TStruct [name]
        (let [si (struct-index db name)]
          (if (primitive/icmp-ge si 0)
              (let [fs (primitive/load (primitive/field (struct-at db si) fields))
                    n (al-len [Field] (primitive/load fs))
                    (mut i) 0
                    (mut total) 0]
                (loop (if (primitive/icmp-ge (primitive/load i) n)
                          (break)
                          (do
                            (primitive/store! total
                                    (primitive/iadd (primitive/load total)
                                          (layout-align8
                                            (type-bytes db (primitive/field (layout-at [Field] fs (primitive/load i)) ty)))))
                            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
                (primitive/load total))
              (let [su (sum-index db name)]
                (if (primitive/icmp-ge su 0)
                    (primitive/iadd 8 (primitive/imul 8 (sum-words db (primitive/load (primitive/field (sum-at db su) variants)))))
                    (layout-fail2 db "type-bytes: unknown nominal " name))))))
      (TVoid [] (layout-fail db "type-bytes on void"))
      (TApp [_ _] (layout-fail db "type-bytes on generic type"))
      (TCode [] (layout-fail db "type-bytes on Code"))
      (TExternRef [] (layout-fail db "type-bytes on externref"))))

  (sum-words [(db (ptr LayoutDb)) (variants (ptr (ArrayList Variant)))] (-> i64)
    (let [n (al-len [Variant] (primitive/load variants))
          (mut vi) 0
          (mut best) 0]
      (loop (if (primitive/icmp-ge (primitive/load vi) n)
                (break)
                (do
                  (let [fs (primitive/load (primitive/field (layout-at [Variant] variants (primitive/load vi)) fields))
                        nf (al-len [Field] (primitive/load fs))
                        (mut fi) 0
                        (mut total) 0]
                    (loop (if (primitive/icmp-ge (primitive/load fi) nf)
                              (break)
                              (do
                                (primitive/store! total
                                        (primitive/iadd (primitive/load total)
                                              (layout-align8
                                                (type-bytes db (primitive/field (layout-at [Field] fs (primitive/load fi)) ty)))))
                                (primitive/store! fi (primitive/iadd (primitive/load fi) 1)))))
                    (when (primitive/icmp-gt (primitive/load total) (primitive/load best)) (primitive/store! best (primitive/load total))))
                  (primitive/store! vi (primitive/iadd (primitive/load vi) 1)))))
      (primitive/idiv (primitive/iadd (primitive/load best) 7) 8)))

  (natural-offset [(db (ptr LayoutDb)) (fs (ptr (ArrayList Field))) (fi i64)] (-> i64)
    (let [(mut i) 0
          (mut off) 0
          (mut result) -1]
      (loop (if (primitive/icmp-gt (primitive/load i) fi)
                (break)
                (do
                  (let [ft (primitive/field (layout-at [Field] fs (primitive/load i)) ty)
                        a (align db ft)]
                    (primitive/store! off (layout-round-up (primitive/load off) a))
                    (when (primitive/icmp-eq (primitive/load i) fi) (primitive/store! result (primitive/load off)) 0)
                    (primitive/store! off (primitive/iadd (primitive/load off) (size db ft))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (primitive/load result)))

  (natural-layout! [(db (ptr LayoutDb)) (si i64)] (-> i64)
    (let [e (struct-at db si)
          fs (primitive/load (primitive/field e fields))
          nf (al-len [Field] (primitive/load fs))
          (mut off) 0
          (mut max-align) 1
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) nf)
                (break)
                (do
                  (let [ft (primitive/field (layout-at [Field] fs (primitive/load i)) ty)
                        a (align db ft)]
                    (when (primitive/icmp-gt a (primitive/load max-align)) (primitive/store! max-align a))
                    (primitive/store! off (layout-round-up (primitive/load off) a))
                    (al-push! (mut (primitive/field e offsets)) (primitive/load off))
                    (primitive/store! off (primitive/iadd (primitive/load off) (size db ft))))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (primitive/store! (primitive/field e align) (primitive/load max-align))
      (primitive/store! (primitive/field e size) (layout-round-up (primitive/load off) (primitive/load max-align)))
      0))

  (compute-one-struct! [(db (ptr LayoutDb)) (si i64)] (-> i64)
    (let [e (struct-at db si)
          fs (primitive/load (primitive/field e fields))
          nf (al-len [Field] (primitive/load fs))]
      (match (primitive/load (primitive/field e layout))
        (LBits [backing _offs]
          (do
            (primitive/store! (primitive/field e size) (primitive/idiv backing 8))
            (primitive/store! (primitive/field e align) (primitive/idiv backing 8))
            0))
        (LExplicit [offs user-size user-align]
          (do
            (let [(mut max-end) 0
                  (mut i) 0]
              (loop (if (primitive/icmp-ge (primitive/load i) nf)
                        (break)
                        (do
                          (let [end (primitive/iadd (al-get [i64] (primitive/load offs) (primitive/load i))
                                          (size db (primitive/field (layout-at [Field] fs (primitive/load i)) ty)))]
                            (when (primitive/icmp-gt end (primitive/load max-end)) (primitive/store! max-end end)))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
              (primitive/store! (primitive/field e size)
                      (match user-size
                        (Some [n] (if (primitive/icmp-gt n (primitive/load max-end)) n (primitive/load max-end)))
                        (None [] (primitive/load max-end))))
              (primitive/store! (primitive/field e align) (if (primitive/icmp-gt user-align 0) user-align 1))
              (let [(mut i) 0]
                (loop (if (primitive/icmp-ge (primitive/load i) nf)
                          (break)
                          (do
                            (al-push! (mut (primitive/field e offsets)) (al-get [i64] (primitive/load offs) (primitive/load i)))
                            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))))
            0))
        (LPacked []
          (do
            (let [(mut off) 0
                  (mut i) 0]
              (loop (if (primitive/icmp-ge (primitive/load i) nf)
                        (break)
                        (do
                          (al-push! (mut (primitive/field e offsets)) (primitive/load off))
                          (primitive/store! off (primitive/iadd (primitive/load off) (size db (primitive/field (layout-at [Field] fs (primitive/load i)) ty))))
                          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
              (primitive/store! (primitive/field e size) (primitive/load off))
              (primitive/store! (primitive/field e align) 1))
            0))
        (LAligned [forced]
          (do
            (natural-layout! db si)
            (when (primitive/icmp-gt forced (primitive/load (primitive/field e align))) (primitive/store! (primitive/field e align) forced))
            (primitive/store! (primitive/field e size) (layout-round-up (primitive/load (primitive/field e size)) (primitive/load (primitive/field e align))))
            0))
        (LC [] (natural-layout! db si)))))

  (type-ready? [(db (ptr LayoutDb)) (t (ptr Type)) (done (mut (ArrayList i64)))] (-> bool)
    (match-else (primitive/load t)
      (TStruct [name]
        (let [si (struct-index db name)]
          (if (primitive/icmp-ge si 0) (primitive/icmp-eq (al-get [i64] (primitive/load done) si) 1) true)))
      (TArray [elem _n] (type-ready? db elem (mut done)))
      (TVec [elem _n] (type-ready? db elem (mut done)))
      (_ true)))

  (struct-ready? [(db (ptr LayoutDb)) (si i64) (done (mut (ArrayList i64)))] (-> bool)
    (let [fs (primitive/load (primitive/field (struct-at db si) fields))
          nf (al-len [Field] (primitive/load fs))
          (mut i) 0
          (mut ready) true]
      (loop (if (primitive/icmp-ge (primitive/load i) nf)
                (break)
                (do
                  (when (not (type-ready? db (primitive/field (layout-at [Field] fs (primitive/load i)) ty) (mut done)))
                    (primitive/store! ready false))
                  (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (primitive/load ready)))

  (compute-struct-layouts! [(db (ptr LayoutDb))] (-> i64)
    (let [n (al-len [LayoutStruct] (primitive/load (primitive/field db structs)))
          (mut done) (al-new [i64] (primitive/load (primitive/field db a)))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) n)
                (break)
                (do (al-push! (mut done) 0) (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (let [(mut pass) 0]
        (loop (if (primitive/icmp-ge (primitive/load pass) (primitive/iadd n 1))
                  (break)
                  (do
                    (let [(mut si) 0
                          (mut all-done) true]
                      (loop (if (primitive/icmp-ge (primitive/load si) n)
                                (break)
                                (do
                                  (when (primitive/icmp-eq (al-get [i64] (primitive/load done) (primitive/load si)) 0)
                                    (if (struct-ready? db (primitive/load si) (mut done))
                                        (do
                                          (compute-one-struct! db (primitive/load si))
                                          (al-set! (mut done) (primitive/load si) 1))
                                        (primitive/store! all-done false)))
                                  (primitive/store! si (primitive/iadd (primitive/load si) 1)))))
                      (when (primitive/load all-done) (break)))
                    (primitive/store! pass (primitive/iadd (primitive/load pass) 1))))))
      (let [(mut si) 0]
        (loop (if (primitive/icmp-ge (primitive/load si) n)
                  (break)
                  (do
                    (when (primitive/icmp-eq (al-get [i64] (primitive/load done) (primitive/load si)) 0)
                      (layout-fail2 db "struct layout cycle at " (primitive/load (primitive/field (struct-at db (primitive/load si)) name))))
                    (primitive/store! si (primitive/iadd (primitive/load si) 1))))))
      0)))
