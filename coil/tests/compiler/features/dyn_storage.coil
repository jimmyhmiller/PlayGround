(module dyn_storage)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)

(import "dyn_provider.coil" :use *)
(import "../../../src/stdlib/alloc.coil" :use *)
(import "../../../src/stdlib/arraylist.coil" :use *)
(import "../../../src/stdlib/result.coil" :use *)

(defsum DynChoice
  (NoProvider [])
  (HasProvider [(provider (dyn ModelProvider))]))

(defstruct AgentRunJob
  [(provider (dyn ModelProvider))])

(defstruct ProviderRegistry
  [(providers (ArrayList (dyn ModelProvider)))])

(defn invoke [(job (ptr AgentRunJob))] (-> i64)
  (run (primitive/load (primitive/field job provider))))

(defn erase-provider [(provider (ptr Provider))] (-> (dyn ModelProvider))
  provider)

(defn run-local [(provider (dyn ModelProvider))] (-> i64)
  (let [local (: provider (dyn ModelProvider))]
    (run local)))

(defn main [] (-> i64)
  (let [provider (alloc/stack Provider)
        job (alloc/stack AgentRunJob)
        providers (alloc/stack (array (dyn ModelProvider) 2))
        (mut list) (al-new [(dyn ModelProvider)] (malloc-allocator))]
    (primitive/store! (primitive/field provider value) 42)
    ; Expected-type coercion must work for fields and array elements.
    (primitive/store! (primitive/field job provider) provider)
    (primitive/store! (primitive/index providers 0) provider)
    (primitive/store! (primitive/index providers 1) (erase-provider provider))
    ; A dynamic trait is an ordinary fixed-size generic argument.
    (al-push! (mut list) (primitive/make-dyn ModelProvider provider))
    (let [choice (HasProvider (erase-provider provider))
          optional (Some [(dyn ModelProvider)] (erase-provider provider))]
      (if (and (primitive/icmp-eq (invoke job) 42)
               (and (primitive/icmp-eq (run (primitive/load (primitive/index providers 0))) 42)
                    (and (primitive/icmp-eq (run-local (al-get [(dyn ModelProvider)] (primitive/load list) 0)) 42)
                         (and (match choice
                                (HasProvider [p] (primitive/icmp-eq (run p) 42))
                                (NoProvider [] false))
                              (match optional
                                (Some [p] (primitive/icmp-eq (run p) 42))
                                (None [] false))))))
          0
          1))))
