(defn
  head-free?
  [(f Code)]
  (-> bool)
  (and
    (code-list? f)
    (and (icmp-gt (code-count f) 0) (code-eq (code-nth f 0) (quasiquote free)))))

(defn
  refs?
  [(f Code) (x Code)]
  (-> bool)
  (if
    (code-sym? f)
    (code-eq f x)
    (if (code-list? f) (refs-list? f x 0 (code-count f)) false)))

(defn
  refs-list?
  [(f Code) (x Code) (i i64) (n i64)]
  (-> bool)
  (if (icmp-ge i n) false (if (refs? (code-nth f i) x) true (refs-list? f x (iadd i 1) n))))

(defn
  used-after?
  [(body Code) (x Code) (j i64) (n i64)]
  (-> bool)
  (if
    (icmp-ge j n)
    false
    (if (refs? (code-nth body j) x) true (used-after? body x (iadd j 1) n))))

(defn
  uaf-clean?
  [(body Code) (i i64) (n i64)]
  (-> bool)
  (if
    (icmp-ge i n)
    true
    (let
      [f (code-nth body i)]
      (if
        (and (head-free? f) (used-after? body (code-nth f 1) (iadd i 1) n))
        false
        (uaf-clean? body (iadd i 1) n)))))

(defn
  check-uaf
  [& (body Code)]
  (-> Code)
  (if
    (uaf-clean? body 0 (code-count body))
    (quasiquote (do (unquote-splicing body)))
    (error "check-uaf: use after free — a freed pointer is read later")))

