(defn
  main
  []
  (-> :i64)
  (let
    [w (stdout)]
    (do
      (coil.io.print-str w "n=")
      (coil.fmt.print-i w -42)
      (coil.io.print-str w " hex=")
      (coil.fmt.print-uhex w 255)
      (coil.io.print-str w " ok=")
      (coil.fmt.print-bool w true)
      (coil.io.print-str w "
"))
    0))

