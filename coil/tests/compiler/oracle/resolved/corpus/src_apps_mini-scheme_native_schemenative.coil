                          (let
                            [$g2864 (caddr2 tgt)]
                            (gc-root $g2864)
                            (let [$g2865 (snil)] (gc-root $g2865) (seval $g2864 $g2865)))]
                        (gc-sp-set $g2862)
                        $g2863))]
                  (gc-root $g2866)
                  (print-val $g2866))]
              (gc-sp-set $g2860)
              $g2861))
          (do (coil.io.print-str (stdout) "
"))
          (do
            (coil.io.print-str (stderr) "[gc] peak_live=")
            (coil.fmt.print-i (stderr) (gc-peak))
            (coil.io.print-str (stderr) " collections=")
            (coil.fmt.print-i (stderr) (gc-collections))
            (coil.io.print-str (stderr) " total_alloc=")
            (coil.fmt.print-i (stderr) (gc-total))
            (coil.io.print-str (stderr) "
"))
          (do (gc-sp-set $g2855) 0))))))

