(defn
  glookup
  [(s (ptr Val)) (g (ptr Val))]
  (-> (ptr Val))
  (if
    (truthy (s-null g))
    s
    (if (truthy (s-eq (car (car g)) s)) (cdr (car g)) (glookup s (cdr g)))))

(defn
  lookup
  [(s (ptr Val)) (env (ptr Val))]
  (-> (ptr Val))
  (if
    (truthy (s-null env))
    (glookup s (genv))
    (if (truthy (s-eq (car (car env)) s)) (cdr (car env)) (lookup s (cdr env)))))

