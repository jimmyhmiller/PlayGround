                          (let
                            [$g2832 (caddr2 tgt)]
                            (gc-root $g2832)
                            (let [$g2833 (snil)] (gc-root $g2833) (seval $g2832 $g2833)))]
                        (gc-sp-set $g2830)
                        $g2831))]
                  (gc-root $g2834)
                  (print-val $g2834))]
              (gc-sp-set $g2828)
              $g2829))
          (do (io.print-str (stdout) "
"))
          (do
            (io.print-str (stderr) "[gc] peak_live=")
            (fmt.print-i (stderr) (gc-peak))
            (io.print-str (stderr) " collections=")
            (fmt.print-i (stderr) (gc-collections))
            (io.print-str (stderr) " total_alloc=")
            (fmt.print-i (stderr) (gc-total))
            (io.print-str (stderr) "
"))
          (do (gc-sp-set $g2823) 0))))))

