(defn
  sum-args
  [(args (ptr Val))]
  (-> i64)
  (if (nullp args) 0 (+ (ival (car args)) (sum-args (cdr args)))))

(defn
  mul-args
  [(args (ptr Val))]
  (-> i64)
  (if (nullp args) 1 (* (ival (car args)) (mul-args (cdr args)))))

