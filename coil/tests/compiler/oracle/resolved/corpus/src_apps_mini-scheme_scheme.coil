          (do (gc-sp-set $g3009) (mk-int (sx-ival x)))
          (if
            (icmp-eq tg 2)
            (let [$g3010 (mk-sym (intern (sx-sval x)))] (gc-sp-set $g3009) $g3010)
            (if
              (or (icmp-eq tg 6) (icmp-eq tg 7))
              (do (gc-sp-set $g3009) (sexp-list->val (sx-items x) 0 (sx-len (sx-items x))))
              (do (gc-sp-set $g3009) (mk-int 0)))))))))

