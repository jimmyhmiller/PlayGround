      (def-prim "cons" 5)
      (def-prim "car" 6)
      (def-prim "cdr" 7)
      (def-prim "null?" 8)
      (def-prim "pair?" 9)
      (def-prim "eq?" 10)
      (def-prim "not" 11)
      (do (gc-sp-set $g2867) 0))))

