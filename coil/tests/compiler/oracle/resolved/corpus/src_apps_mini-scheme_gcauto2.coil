(defn
  managed-type?
  [(T Code)]
  (-> bool)
  (or
    (code-eq T (quasiquote Val))
    (and
      (code-list? T)
      (and
        (>= (code-count T) 2)
        (and
          (code-eq (code-nth T 0) (quasiquote ptr))
          (code-eq (code-nth T 1) (quasiquote Val)))))))

(defn
  rewrite-type
  [(T Code)]
  (-> Code)
  (if (code-eq T (quasiquote Val)) (quasiquote (ptr Val)) T))

(defn
  mg-member?
  [(name Code) (l Code) (i i64) (n i64)]
  (-> bool)
  (if (>= i n) false (if (code-eq (code-nth l i) name) true (mg-member? name l (+ i 1) n))))

(defn
  managed-call?
  [(e Code) (mg Code)]
  (-> bool)
  (and
    (code-list? e)
    (and
      (> (code-count e) 0)
      (and (code-sym? (code-nth e 0)) (mg-member? (code-nth e 0) mg 0 (code-count mg))))))

(defn
  snoc
  [(lst Code) (x Code)]
  (-> Code)
  (quasiquote ((unquote-splicing lst) (unquote x))))

(defn
  has-managed-arg?
  [(e Code) (i i64) (n i64) (mg Code)]
  (-> bool)
  (if
    (>= i n)
    false
    (if (managed-call? (code-nth e i) mg) true (has-managed-arg? e (+ i 1) n mg))))

(defn
  wrap-args
  [(head Code) (args Code) (i i64) (n i64) (placed Code) (mg Code)]
  (-> Code)
  (if
    (>= i n)
    (quasiquote ((unquote head) (unquote-splicing placed)))
    (let
      [orig (code-nth args i) a (root-expr orig mg)]
      (if
        (managed-call? orig mg)
        (let
          [g (gensym)]
          (quasiquote
            (let
              [(unquote g) (unquote a)]
              (gc-root (unquote g))
              (unquote (wrap-args head args (+ i 1) n (snoc placed g) mg)))))
        (wrap-args head args (+ i 1) n (snoc placed a) mg)))))

(defn
  root-exprs
  [(e Code) (i i64) (n i64) (mg Code)]
  (-> Code)
  (if
    (>= i n)
    (quasiquote ())
    (quasiquote
      ((unquote (root-expr (code-nth e i) mg))
        (unquote-splicing (root-exprs e (+ i 1) n mg))))))

(defn
  has-managed-bind?
  [(bv Code) (i i64) (n i64) (mg Code)]
  (-> bool)
  (if
    (>= i n)
    false
    (if
      (and (< (+ i 1) n) (managed-call? (code-nth bv (+ i 1)) mg))
      true
      (has-managed-bind? bv (+ i 2) n mg))))

(defn
  build-let
  [(bv Code) (i i64) (n i64) (inner Code) (mg Code)]
  (-> Code)
  (if
    (>= i n)
    inner
    (let
      [name
        (code-nth bv i)
        val
        (if (< (+ i 1) n) (root-expr (code-nth bv (+ i 1)) mg) (quasiquote 0))
        rest
        (build-let bv (+ i 2) n inner mg)]
      (if
        (and (code-sym? name) (and (< (+ i 1) n) (managed-call? (code-nth bv (+ i 1)) mg)))
        (quasiquote
          (let [(unquote name) (unquote val)] (gc-root (unquote name)) (unquote rest)))
        (quasiquote (let [(unquote name) (unquote val)] (unquote rest)))))))

(defn
  root-arms
  [(e Code) (i i64) (n i64) (mg Code)]
  (-> Code)
  (if
    (>= i n)
    (quasiquote ())
    (let
      [arm (code-nth e i)]
      (quasiquote
        ((unquote
           (if
             (and (code-list? arm) (>= (code-count arm) 3))
             (quasiquote
               ((unquote (code-nth arm 0))
                 (unquote (code-nth arm 1))
                 (unquote (root-expr (code-nth arm 2) mg))))
             arm))
          (unquote-splicing (root-arms e (+ i 1) n mg)))))))

(defn
  root-binds
  [(bv Code) (i i64) (n i64) (mg Code)]
  (-> Code)
  (if
    (>= i n)
    (quasiquote [])
    (if
      (= (% i 2) 0)
      (quasiquote
        [(unquote (code-nth bv i)) (unquote-splicing (root-binds bv (+ i 1) n mg))])
      (quasiquote
        [(unquote (root-expr (code-nth bv i) mg))
          (unquote-splicing (root-binds bv (+ i 1) n mg))]))))

(defn
  root-expr
  [(e Code) (mg Code)]
  (-> Code)
  (if
    (not (code-list? e))
    e
    (if
      (= (code-count e) 0)
      e
      (let
        [h (code-nth e 0)]
        (if
          (not (code-sym? h))
          (quasiquote ((unquote-splicing (root-exprs e 0 (code-count e) mg))))
          (if
            (code-eq h (quasiquote if))
            (quasiquote
              (if
                (unquote (root-expr (code-nth e 1) mg))
                (unquote (root-expr (code-nth e 2) mg))
                (unquote (root-expr (code-nth e 3) mg))))
            (if
              (code-eq h (quasiquote do))
              (quasiquote (do (unquote-splicing (root-exprs e 1 (code-count e) mg))))
              (if
                (code-eq h (quasiquote loop))
                (quasiquote (loop (unquote-splicing (root-exprs e 1 (code-count e) mg))))
                (if
                  (code-eq h (quasiquote break))
                  (if
                    (= (code-count e) 1)
                    e
                    (quasiquote (break (unquote (root-expr (code-nth e 1) mg)))))
                  (if
                    (code-eq h (quasiquote continue))
                    e
                    (if
                      (code-eq h (quasiquote let))
                      (let
                        [bv
                          (code-nth e 1)
                          nb
                          (code-count bv)
                          body
                          (root-exprs e 2 (code-count e) mg)]
                        (if
                          (has-managed-bind? bv 0 nb mg)
                          (let
                            [sp (gensym) r (gensym)]
                            (quasiquote
                              (let
                                [(unquote sp) (gc-sp)]
                                (unquote
                                  (build-let
                                    bv
                                    0
                                    nb
                                    (quasiquote
                                      (let
                                        [(unquote r) (do (unquote-splicing body))]
                                        (gc-sp-set (unquote sp))
                                        (unquote r)))
                                    mg)))))
                          (quasiquote
                            (let (unquote (root-binds bv 0 nb mg)) (unquote-splicing body)))))
                      (if
                        (code-eq h (quasiquote match))
                        (quasiquote
                          (match
                            (unquote (root-expr (code-nth e 1) mg))
                            (unquote-splicing (root-arms e 2 (code-count e) mg))))
                        (if
                          (or
                            (code-eq h (quasiquote quote))
                            (code-eq h (quasiquote quasiquote)))
                          e
                          (if
                            (has-managed-arg? e 1 (code-count e) mg)
                            (let
                              [sp (gensym) res (gensym)]
                              (quasiquote
                                (let
                                  [(unquote sp) (gc-sp)]
                                  (let
                                    [(unquote res)
                                      (unquote
                                        (wrap-args h e 1 (code-count e) (quasiquote ()) mg))]
                                    (gc-sp-set (unquote sp))
                                    (unquote res)))))
                            (wrap-args h e 1 (code-count e) (quasiquote ()) mg)))))))))))))))

(defn
  tail-fallback
  [(e Code) (base Code) (mg Code)]
  (-> Code)
  (let
    [r (gensym)]
    (quasiquote
      (let [(unquote r) (unquote (root-expr e mg))] (gc-sp-set (unquote base)) (unquote r)))))

(defn
  tail-wrap-args
  [(head Code) (args Code) (i i64) (n i64) (placed Code) (base Code) (mg Code)]
  (-> Code)
  (if
    (>= i n)
    (quasiquote (do (gc-sp-set (unquote base)) ((unquote head) (unquote-splicing placed))))
    (let
      [orig (code-nth args i) a (root-expr orig mg)]
      (if
        (managed-call? orig mg)
        (let
          [g (gensym)]
          (quasiquote
            (let
              [(unquote g) (unquote a)]
              (gc-root (unquote g))
              (unquote (tail-wrap-args head args (+ i 1) n (snoc placed g) base mg)))))
        (tail-wrap-args head args (+ i 1) n (snoc placed a) base mg)))))

(defn
  tail-let
  [(e Code) (base Code) (mg Code)]
  (-> Code)
  (let
    [bv
      (code-nth e 1)
      nb
      (code-count bv)
      cnt
      (code-count e)
      tailbody
      (tail-expr (code-nth e (- cnt 1)) base mg)
      mid
      (root-exprs e 2 (- cnt 1) mg)]
    (if
      (has-managed-bind? bv 0 nb mg)
      (build-let bv 0 nb (quasiquote (do (unquote-splicing mid) (unquote tailbody))) mg)
      (quasiquote
        (let (unquote (root-binds bv 0 nb mg)) (unquote-splicing mid) (unquote tailbody))))))

(defn
  tail-expr
  [(e Code) (base Code) (mg Code)]
  (-> Code)
  (if
    (not (code-list? e))
    (quasiquote (do (gc-sp-set (unquote base)) (unquote e)))
    (if
      (= (code-count e) 0)
      (quasiquote (do (gc-sp-set (unquote base)) (unquote e)))
      (let
        [h (code-nth e 0)]
        (if
          (not (code-sym? h))
          (tail-fallback e base mg)
          (if
            (code-eq h (quasiquote if))
            (quasiquote
              (if
                (unquote (root-expr (code-nth e 1) mg))
                (unquote (tail-expr (code-nth e 2) base mg))
                (unquote (tail-expr (code-nth e 3) base mg))))
            (if
              (code-eq h (quasiquote do))
              (quasiquote
                (do
                  (unquote-splicing (root-exprs e 1 (- (code-count e) 1) mg))
                  (unquote (tail-expr (code-nth e (- (code-count e) 1)) base mg))))
              (if
                (code-eq h (quasiquote let))
                (tail-let e base mg)
                (if
                  (or (code-eq h (quasiquote quote)) (code-eq h (quasiquote quasiquote)))
                  (quasiquote (do (gc-sp-set (unquote base)) (unquote e)))
                  (if
                    (or
                      (code-eq h (quasiquote match))
                      (or
                        (code-eq h (quasiquote loop))
                        (or
                          (code-eq h (quasiquote break))
                          (or
                            (code-eq h (quasiquote continue))
                            (mg-member? h (base-allocs) 0 (code-count (base-allocs)))))))
                    (tail-fallback e base mg)
                    (tail-wrap-args h e 1 (code-count e) (quasiquote ()) base mg)))))))))))

(defn
  rewrite-params
  [(ps Code) (i i64) (n i64)]
  (-> Code)
  (if
    (>= i n)
    (quasiquote [])
    (let
      [p (code-nth ps i) rest (rewrite-params ps (+ i 1) n)]
      (quasiquote
        [((unquote (code-nth p 0)) (unquote (rewrite-type (code-nth p 1))))
          (unquote-splicing rest)]))))

(defn
  param-roots
  [(ps Code) (i i64) (n i64)]
  (-> Code)
  (if
    (>= i n)
    (quasiquote ())
    (let
      [p (code-nth ps i) rest (param-roots ps (+ i 1) n)]
      (if
        (managed-type? (code-nth p 1))
        (quasiquote ((gc-root (unquote (code-nth p 0))) (unquote-splicing rest)))
        rest))))

(defn
  rewrite-defn
  [(f Code) (mg Code)]
  (-> Code)
  (let
    [name
      (code-nth f 1)
      ps
      (code-nth f 2)
      ret
      (code-nth f 3)
      new-ps
      (rewrite-params ps 0 (code-count ps))
      new-ret
      (quasiquote (-> (unquote (rewrite-type (code-nth ret 1)))))
      proots
      (param-roots ps 0 (code-count ps))
      cnt
      (code-count f)
      mid
      (root-exprs f 4 (- cnt 1) mg)
      sp
      (gensym)
      tail
      (tail-expr (code-nth f (- cnt 1)) sp mg)]
    (quasiquote
      (defn
        (unquote name)
        (unquote new-ps)
        (unquote new-ret)
        (let
          [(unquote sp) (gc-sp)]
          (do (unquote-splicing proots) (unquote-splicing mid) (unquote tail)))))))

(defn base-allocs [] (-> Code) (quasiquote (cons mk-sym mk-prim mk-closure)))

(defn
  expr-allocs?
  [(e Code) (as Code)]
  (-> bool)
  (if
    (not (code-list? e))
    false
    (if
      (= (code-count e) 0)
      false
      (let
        [h (code-nth e 0)]
        (if
          (and (code-sym? h) (mg-member? h as 0 (code-count as)))
          true
          (children-alloc? e 0 (code-count e) as))))))

(defn
  children-alloc?
  [(e Code) (i i64) (n i64) (as Code)]
  (-> bool)
  (if
    (>= i n)
    false
    (if (expr-allocs? (code-nth e i) as) true (children-alloc? e (+ i 1) n as))))

(defn defn-allocs? [(f Code) (as Code)] (-> bool) (children-alloc? f 4 (code-count f) as))

(defn
  grow-pass
  [(m Code) (i i64) (n i64) (as Code)]
  (-> Code)
  (if
    (>= i n)
    as
    (let
      [f (code-nth m i)]
      (grow-pass
        m
        (+ i 1)
        n
        (if
          (and
            (is-defn? f)
            (and (defn-allocs? f as) (not (mg-member? (code-nth f 1) as 0 (code-count as)))))
          (snoc as (code-nth f 1))
          as)))))

(defn
  fixpoint-allocs
  [(m Code) (iter i64) (as Code)]
  (-> Code)
  (if
    (<= iter 0)
    as
    (let
      [as2 (grow-pass m 1 (code-count m) as)]
      (if (= (code-count as2) (code-count as)) as2 (fixpoint-allocs m (- iter 1) as2)))))

(defn
  body-forms
  [(f Code) (i i64) (n i64)]
  (-> Code)
  (if
    (>= i n)
    (quasiquote ())
    (quasiquote ((unquote (code-nth f i)) (unquote-splicing (body-forms f (+ i 1) n))))))

(defn
  rewrite-defn-thin
  [(f Code)]
  (-> Code)
  (let
    [name (code-nth f 1) ps (code-nth f 2) ret (code-nth f 3)]
    (quasiquote
      (defn
        (unquote name)
        (unquote (rewrite-params ps 0 (code-count ps)))
        (-> (unquote (rewrite-type (code-nth ret 1))))
        (unquote-splicing (body-forms f 4 (code-count f)))))))

(defn
  is-defn?
  [(f Code)]
  (-> bool)
  (and
    (code-list? f)
    (and
      (>= (code-count f) 4)
      (and (code-sym? (code-nth f 0)) (code-eq (code-nth f 0) (quasiquote defn))))))

(defn
  returns-managed?
  [(f Code)]
  (-> bool)
  (and
    (is-defn? f)
    (let
      [ret (code-nth f 3)]
      (and (code-list? ret) (and (= (code-count ret) 2) (managed-type? (code-nth ret 1)))))))

(defn
  from-user-mod?
  [(m Code)]
  (-> bool)
  (and (> (code-count m) 1) (code-from-user? (code-nth m 1))))

(defn rewrite-mod? [(m Code)] (-> bool) (code-eq (code-nth m 0) (quasiquote scheme)))

(defn
  collect-mod
  [(m Code) (i i64) (n i64) (mg Code)]
  (-> Code)
  (if
    (>= i n)
    mg
    (collect-mod
      m
      (+ i 1)
      n
      (if (returns-managed? (code-nth m i)) (snoc mg (code-nth (code-nth m i) 1)) mg))))

(defn
  collect-mods
  [(ms Code) (i i64) (n i64) (mg Code)]
  (-> Code)
  (if
    (>= i n)
    mg
    (collect-mods
      ms
      (+ i 1)
      n
      (if
        (from-user-mod? (code-nth ms i))
        (collect-mod (code-nth ms i) 1 (code-count (code-nth ms i)) mg)
        mg))))

(defn
  already-rooted?
  [(f Code)]
  (-> bool)
  (and
    (= (code-count f) 5)
    (let
      [b (code-nth f 4)]
      (and
        (code-list? b)
        (and
          (> (code-count b) 0)
          (and
            (code-eq (code-nth b 0) (quasiquote let))
            (let
              [bv (code-nth b 1)]
              (and
                (code-list? bv)
                (and
                  (>= (code-count bv) 2)
                  (let
                    [v (code-nth bv 1)]
                    (and
                      (code-list? v)
                      (and (> (code-count v) 0) (code-eq (code-nth v 0) (quasiquote gc-sp))))))))))))))

(defn
  xform-forms
  [(m Code) (i i64) (n i64) (mg Code) (as Code)]
  (-> Code)
  (if
    (>= i n)
    (quasiquote ())
    (let
      [f (code-nth m i) rest (xform-forms m (+ i 1) n mg as)]
      (if
        (and (is-defn? f) (not (already-rooted? f)))
        (if
          (mg-member? (code-nth f 1) as 0 (code-count as))
          (quasiquote ((unquote (rewrite-defn f mg)) (unquote-splicing rest)))
          (quasiquote ((unquote (rewrite-defn-thin f)) (unquote-splicing rest))))
        (quasiquote ((unquote f) (unquote-splicing rest)))))))

(defn
  xform-mod
  [(m Code) (mg Code)]
  (-> Code)
  (if
    (rewrite-mod? m)
    (let
      [as (fixpoint-allocs m (code-count m) (base-allocs))]
      (quasiquote
        ((unquote (code-nth m 0)) (unquote-splicing (xform-forms m 1 (code-count m) mg as)))))
    m))

(defn
  xform-mods
  [(ms Code) (i i64) (n i64) (mg Code)]
  (-> Code)
  (if
    (>= i n)
    (quasiquote ())
    (quasiquote
      ((unquote (xform-mod (code-nth ms i) mg))
        (unquote-splicing (xform-mods ms (+ i 1) n mg))))))

(defn
  gc-transform
  [(mods Code)]
  (-> Code)
  (let
    [mg (collect-mods mods 0 (code-count mods) (quasiquote (cons car cdr)))]
    (quasiquote (do (unquote-splicing (xform-mods mods 0 (code-count mods) mg))))))

