(module abi)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(defstruct Small [(a i32) (b i32)])
(defstruct Big   [(a i64) (b i64) (c i64)])
(defn take-small [(s Small)] (-> i64) (primitive/iadd (primitive/cast i64 (primitive/load (primitive/field s a))) (primitive/cast i64 (primitive/load (primitive/field s b)))))
(defn take-big   [(b Big)]   (-> i64) (primitive/iadd (primitive/load (primitive/field b a)) (primitive/iadd (primitive/load (primitive/field b b)) (primitive/load (primitive/field b c)))))
(defn make-small [(a i32) (b i32)] (-> Small)
  (let [p (alloc/stack Small)] (primitive/store! (primitive/field p a) a) (primitive/store! (primitive/field p b) b) (primitive/load p)))
(defn main [] (-> i64)
  (primitive/iadd (take-small (make-small 3 4))
        (take-big (let [(mut g) (primitive/zeroed Big)] (primitive/store! (primitive/field (mut g) a) 1) (primitive/load g)))))
