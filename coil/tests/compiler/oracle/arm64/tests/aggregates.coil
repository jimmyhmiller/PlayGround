; Big-aggregate paths: >64B and >256B copies (unrolled vs loop code paths),
; array-of-structs by value, sret of large structs, sums with big payloads.
(module t)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "src/stdlib/alloc.coil" :use *)
(import "src/stdlib/io.coil" :use *)
(import "src/stdlib/fmt.coil" :use *)

(defn out [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l) (print-str w "=") (print-i w v) (print-nl w) 0)

(defstruct Big [(arr (array i64 40)) (tag i64)])       ; 328 bytes -> loop copy
(defstruct Mid [(arr (array i32 20)) (tag i64)])       ; 88 bytes  -> unrolled
(defsum Carrier
  (CEmpty [])
  (CMid   [(m Mid)])
  (CPair  [(a i64) (b i64)]))

(defn fill-big [(k i64)] (-> Big)
  (let [p (alloc/stack Big) (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) 40) (break)
      (do (primitive/store! (primitive/index (primitive/cast (ptr i64) (primitive/field p arr)) (primitive/load i)) (primitive/imul (primitive/load i) k))
          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/store! (primitive/field p tag) k)
    (primitive/load p)))

(defn sum-big [(b Big)] (-> i64)
  (let [p (alloc/stack Big)]
    (primitive/store! p b)
    (let [(mut tot) (primitive/load (primitive/field p tag)) (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) 40) (break)
        (do (primitive/store! tot (primitive/iadd (primitive/load tot) (primitive/load (primitive/index (primitive/cast (ptr i64) (primitive/field p arr)) (primitive/load i)))))
            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (primitive/load tot))))

(defn fill-mid [(k i64)] (-> Mid)
  (let [p (alloc/stack Mid) (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) 20) (break)
      (do (primitive/store! (primitive/index (primitive/cast (ptr i32) (primitive/field p arr)) (primitive/load i)) (primitive/cast i32 (primitive/iadd (primitive/load i) k)))
          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/store! (primitive/field p tag) (primitive/imul k 1000))
    (primitive/load p)))

(defn sum-mid [(m Mid)] (-> i64)
  (let [p (alloc/stack Mid)]
    (primitive/store! p m)
    (let [(mut tot) (primitive/load (primitive/field p tag)) (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) 20) (break)
        (do (primitive/store! tot (primitive/iadd (primitive/load tot) (primitive/cast i64 (primitive/load (primitive/index (primitive/cast (ptr i32) (primitive/field p arr)) (primitive/load i))))))
            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (primitive/load tot))))

(defn carrier-val [(c Carrier)] (-> i64)
  (match c
    (CEmpty [] -1)
    (CMid [m] (sum-mid m))
    (CPair [a b] (primitive/imul a b))))

(defn main [] (-> i64)
  (let [w (stdout)]
    ; big struct: build in one call, copy by value TWICE, sum in another
    (let [b (fill-big 3)
          b2 b]                       ; whole-struct binding copy
      (out w "big" (sum-big b2))
      (out w "bigtag" (let [p (alloc/stack Big)] (primitive/store! p b2) (primitive/load (primitive/field p tag)))))
    (out w "mid" (sum-mid (fill-mid 5)))
    ; sums carrying aggregates through match
    (out w "cmid" (carrier-val (CMid (fill-mid 2))))
    (out w "cpair" (carrier-val (CPair 6 7)))
    (out w "cempty" (carrier-val (CEmpty)))
    ; array of structs on the heap
    (let [a (malloc-allocator)
          arr (primitive/cast (ptr Mid) (unwrap-ptr (raw-alloc a (primitive/imul 5 (primitive/sizeof Mid)) 8)))
          (mut i) 0]
      (loop (if (primitive/icmp-ge (primitive/load i) 5) (break)
        (do (primitive/store! (primitive/index arr (primitive/load i)) (fill-mid (primitive/load i)))
            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (out w "arr3" (sum-mid (primitive/load (primitive/index arr 3))))
      (out w "arr0" (sum-mid (primitive/load (primitive/index arr 0)))))
    0))
