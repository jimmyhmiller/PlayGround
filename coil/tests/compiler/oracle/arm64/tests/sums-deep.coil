; Sum-type torture: nesting (Option of Result of struct), 8-variant tags,
; sums built inside loops, matches storing aggregates, recursive sums.
(module t)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "src/stdlib/alloc.coil" :use *)
(import "src/stdlib/io.coil" :use *)
(import "src/stdlib/fmt.coil" :use *)
(import "src/stdlib/result.coil" :use *)
(import "src/stdlib/arraylist.coil" :use *)
(import "src/stdlib/control.coil" :use *)

(defn out [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l) (print-str w "=") (print-i w v) (print-nl w) 0)

(defstruct Info [(a i64) (b i64)])
(defsum Eight
  (E0 []) (E1 [(x i64)]) (E2 [(x i64) (y i64)]) (E3 [(s Info)])
  (E4 []) (E5 [(f f64)]) (E6 [(p (ptr i8))]) (E7 [(x i64)]))
(defsum Tree
  (Leaf [(v i64)])
  (Node [(kids (ptr (ArrayList Tree)))]))

(defn eight-val [(e Eight)] (-> i64)
  (match e
    (E0 [] 0)
    (E1 [x] x)
    (E2 [x y] (primitive/iadd x (primitive/imul y 100)))
    (E3 [s] (let [p (alloc/stack Info)] (primitive/store! p s) (primitive/isub (primitive/load (primitive/field p a)) (primitive/load (primitive/field p b)))))
    (E4 [] 44)
    (E5 [f] (primitive/cast i64 (primitive/fmul f 10.0)))
    (E6 [p] (primitive/cast i64 p))
    (E7 [x] (primitive/imul x -1))))

(defn pick [(k i64)] (-> Eight)
  (if (primitive/icmp-eq k 0) (E0)
    (if (primitive/icmp-eq k 1) (E1 11)
      (if (primitive/icmp-eq k 2) (E2 5 7)
        (if (primitive/icmp-eq k 3) (E3 (let [p (alloc/stack Info)]
                                (primitive/store! (primitive/field p a) 50) (primitive/store! (primitive/field p b) 8) (primitive/load p)))
          (if (primitive/icmp-eq k 4) (E4)
            (if (primitive/icmp-eq k 5) (E5 2.5)
              (if (primitive/icmp-eq k 6) (E6 (primitive/cast (ptr i8) 0)) (E7 9)))))))))

; A variant carrying an ARRAY. This is the shape that caught a real cross-backend
; layout split: codegen.coil used to align-8 every array element while the arm64
; backend packed them, so this sum measured 40 bytes under LLVM and 24 under arm64
; — the same type with two sizes. Nothing in the corpus carried an array inside a
; sum, so both gates stayed green while the two backends disagreed. Report the
; stride the backend actually laid out, and round-trip the payload to prove it is
; usable and not merely the right size.
(defsum Arr
  (Packed [(cells (array i32 4))])
  (Empty []))

; Arbitrary-width integers must round partial bytes up during payload sizing.
; Five u9 cells occupy ten bytes, so the payload needs two i64 words.
(defsum OddArr
  (OddPacked [(cells (array u9 5))])
  (OddEmpty []))

; LLVM has allocation alignment but no aligned-struct type. These assertions and
; the nested runtime access pin LayoutDb's size/alignment/offset contract across
; the LLVM and native backends.
(defstruct Over :layout (align 16) [(value i64)])
(defstruct OverOuter [(tag u8) (inner Over) (tail u8)])
(static-assert (primitive/icmp-eq (primitive/sizeof Over) 16) "over-aligned size")
(static-assert (primitive/icmp-eq (primitive/alignof Over) 16) "over-aligned alignment")
(static-assert (primitive/icmp-eq (primitive/offsetof OverOuter inner) 16) "nested aligned offset")
(static-assert (primitive/icmp-eq (primitive/offsetof OverOuter tail) 32) "nested aligned tail")
(static-assert (primitive/icmp-eq (primitive/sizeof OverOuter) 48) "nested aligned size")

(defn arr-stride [] (-> i64)
  (let [p (alloc/stack (array Arr 2)) q (primitive/cast (ptr Arr) p)]
    (primitive/isub (primitive/cast i64 (primitive/index q 1)) (primitive/cast i64 (primitive/index q 0)))))

(defn arr-roundtrip [] (-> i64)
  (let [cell (alloc/stack (array i32 4)) (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) 4) (break)
      (do (primitive/store! (primitive/index cell (primitive/load i)) (primitive/cast i32 (primitive/imul (primitive/iadd (primitive/load i) 1) 7)))
          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (match (Packed (primitive/load cell))
      (Empty [] -1)
      (Packed [cs]
        (let [c (alloc/stack (array i32 4)) (mut j) 0 (mut tot) 0]
          (primitive/store! c cs)
          (loop (if (primitive/icmp-ge (primitive/load j) 4) (break)
            (do (primitive/store! tot (primitive/iadd (primitive/load tot) (primitive/cast i64 (primitive/load (primitive/index c (primitive/load j))))))
                (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
          (primitive/load tot))))))

(defn odd-arr-stride [] (-> i64)
  (let [p (alloc/stack (array OddArr 2)) q (primitive/cast (ptr OddArr) p)]
    (primitive/isub (primitive/cast i64 (primitive/index q 1)) (primitive/cast i64 (primitive/index q 0)))))

(defn odd-arr-roundtrip [] (-> i64)
  (let [cell (alloc/stack (array u9 5)) (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) 5) (break)
      (do (primitive/store! (primitive/index cell (primitive/load i)) (primitive/cast u9 (primitive/imul (primitive/iadd (primitive/load i) 1) 60)))
          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (match (OddPacked (primitive/load cell))
      (OddEmpty [] -1)
      (OddPacked [cs]
        (let [c (alloc/stack (array u9 5)) (mut j) 0 (mut tot) 0]
          (primitive/store! c cs)
          (loop (if (primitive/icmp-ge (primitive/load j) 5) (break)
            (do (primitive/store! tot (primitive/iadd (primitive/load tot) (primitive/cast i64 (primitive/load (primitive/index c (primitive/load j))))))
                (primitive/store! j (primitive/iadd (primitive/load j) 1)))))
          (primitive/load tot))))))

(defn aligned-roundtrip [] (-> i64)
  (let [p (alloc/stack OverOuter)]
    (primitive/store! (primitive/field p tag) (primitive/cast u8 1))
    (primitive/store! (primitive/field (primitive/field p inner) value) 40)
    (primitive/store! (primitive/field p tail) (primitive/cast u8 1))
    (primitive/iadd (primitive/cast i64 (primitive/load (primitive/field p tag)))
          (primitive/iadd (primitive/load (primitive/field (primitive/field p inner) value))
                (primitive/cast i64 (primitive/load (primitive/field p tail)))))))

(defn tree-sum [(t Tree)] (-> i64)
  (match t
    (Leaf [v] v)
    (Node [kids]
      (let [n (al-len [Tree] (primitive/load kids)) (mut i) 0 (mut tot) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
          (do (primitive/store! tot (primitive/iadd (primitive/load tot) (tree-sum (al-get [Tree] (primitive/load kids) (primitive/load i)))))
              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
        (primitive/load tot)))))

(defn main [] (-> i64)
  (let [w (stdout) a (malloc-allocator)]
    ; a sum carrying an array: stride, sizeof and comptime sizeof must all agree,
    ; and must agree across backends
    (out w "arr-stride"    (arr-stride))
    (out w "arr-sizeof"    (primitive/sizeof Arr))
    (out w "arr-ct-sizeof" (comptime (primitive/sizeof Arr)))
    (out w "arr-sum"       (arr-roundtrip))
    (out w "odd-arr-stride" (odd-arr-stride))
    (out w "odd-arr-sizeof" (primitive/sizeof OddArr))
    (out w "odd-arr-sum" (odd-arr-roundtrip))
    (out w "aligned" (aligned-roundtrip))
    ; all 8 variants through one dispatcher, built in a loop
    (let [(mut k) 0 (mut acc) 0]
      (loop (if (primitive/icmp-ge (primitive/load k) 8) (break)
        (do (primitive/store! acc (primitive/iadd (primitive/load acc) (eight-val (pick (primitive/load k)))))
            (primitive/store! k (primitive/iadd (primitive/load k) 1)))))
      (out w "eight" (primitive/load acc)))
    ; Option<Result<Info,i64>> nesting
    (let [r (Some (Ok [Info i64] (let [p (alloc/stack Info)]
                                   (primitive/store! (primitive/field p a) 30) (primitive/store! (primitive/field p b) 12) (primitive/load p))))]
      (out w "nest"
        (match r
          (None [] -1)
          (Some [inner]
            (match inner
              (Err [e] (primitive/isub 0 e))
              (Ok [s] (let [p (alloc/stack Info)] (primitive/store! p s)
                        (primitive/iadd (primitive/load (primitive/field p a)) (primitive/load (primitive/field p b))))))))))
    ; recursive sum: ((1 2) (3 (4 5)))
    (let [(mut l1) (al-new [Tree] a)]
      (al-push! (mut l1) (Leaf 1)) (al-push! (mut l1) (Leaf 2))
      (let [n1 (Node (box-al-tree a (primitive/load l1))) (mut l2) (al-new [Tree] a)]
        (al-push! (mut l2) (Leaf 4)) (al-push! (mut l2) (Leaf 5))
        (let [n2 (Node (box-al-tree a (primitive/load l2))) (mut l3) (al-new [Tree] a)]
          (al-push! (mut l3) (Leaf 3)) (al-push! (mut l3) n2)
          (let [n3 (Node (box-al-tree a (primitive/load l3))) (mut l4) (al-new [Tree] a)]
            (al-push! (mut l4) n1) (al-push! (mut l4) n3)
            (out w "tree" (tree-sum (Node (box-al-tree a (primitive/load l4)))))))))
    0))

(defn box-al-tree [(a (ptr Allocator)) (l (ArrayList Tree))] (-> (ptr (ArrayList Tree)))
  (let [p (unwrap-ptr [(ArrayList Tree)] (create [(ArrayList Tree)] a))] (primitive/store! p l) p))
