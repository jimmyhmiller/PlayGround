; Float semantics: f32/f64 arithmetic + conversions, ordered comparisons
; (incl. NaN behavior — printed as booleans, never cast), frem, negatives.
(module t)
(import "primitive.coil" :as primitive)
(import "src/stdlib/alloc.coil" :use *)
(import "src/stdlib/io.coil" :use *)
(import "src/stdlib/fmt.coil" :use *)

(defn out [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l) (print-str w "=") (print-i w v) (print-nl w) 0)
(defn outb [(w (ptr Writer)) (l (slice u8)) (v bool)] (-> i64)
  (print-str w l) (print-str w "=") (print-bool w v) (print-nl w) 0)

(defn milli [(x f64)] (-> i64) (primitive/cast i64 (primitive/fmul x 1000.0)))

(defn main [] (-> i64)
  (let [w (stdout)]
    (out w "add" (milli (primitive/fadd 1.5 2.25)))
    (out w "sub" (milli (primitive/fsub 1.0 3.5)))
    (out w "mul" (milli (primitive/fmul -2.5 4.0)))
    (out w "div" (milli (primitive/fdiv 7.0 2.0)))
    (out w "rem" (milli (primitive/frem 7.5 2.0)))
    (out w "remneg" (milli (primitive/frem -7.5 2.0)))
    ; f32 arithmetic (rounded differently than f64)
    (out w "f32" (primitive/cast i64 (primitive/fmul (primitive/fadd (primitive/cast f32 0.1) (primitive/cast f32 0.2)) (primitive/cast f32 10000000.0))))
    ; conversions
    (out w "f2i" (primitive/cast i64 -3.99))
    (out w "f2u" (primitive/cast i64 (primitive/cast u32 3.99)))
    (out w "i2f" (milli (primitive/fadd (primitive/cast f64 -7) 0.25)))
    (out w "u2f" (milli (primitive/fdiv (primitive/cast f64 (primitive/cast u64 -1)) 1000000000000000000.0)))
    (out w "narrow" (milli (primitive/cast f64 (primitive/cast f32 1.1))))
    ; comparisons incl. NaN (0.0/0.0)
    (let [nan (primitive/fdiv 0.0 0.0) one 1.0]
      (outb w "ltnan" (primitive/fcmp-lt nan one))
      (outb w "genan" (primitive/fcmp-ge nan one))
      (outb w "eqnan" (primitive/fcmp-eq nan nan))
      (outb w "nenan" (primitive/fcmp-ne nan nan))
      (outb w "lt" (primitive/fcmp-lt -0.5 0.5))
      (outb w "le" (primitive/fcmp-le 2.0 2.0))
      (outb w "gt" (primitive/fcmp-gt 2.0 2.0))
      (outb w "negz" (primitive/fcmp-eq 0.0 -0.0)))
    0))
