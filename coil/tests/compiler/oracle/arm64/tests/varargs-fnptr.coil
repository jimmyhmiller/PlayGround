; Variadic externs with many/mixed args (Apple: variadic -> stack), qsort
; with a Coil comparator called back from C, fnptr tables.
(module t)
(import "primitive.coil" :as primitive)
(import "src/stdlib/alloc.coil" :use *)
(import "src/stdlib/io.coil" :use *)
(import "src/stdlib/fmt.coil" :use *)
(import "src/stdlib/control.coil" :use *)

(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))
(extern qsort :cc c [(ptr i8) i64 i64 (fnptr c [(ptr i8) (ptr i8)] i32)] (-> void))
(extern strlen :cc c [(ptr i8)] (-> i64))

(defn out [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l) (print-str w "=") (print-i w v) (print-nl w) 0)

(defn cmp-i64 [(pa (ptr i8)) (pb (ptr i8))] (-> i32)
  (let [a (primitive/load (primitive/cast (ptr i64) pa)) b (primitive/load (primitive/cast (ptr i64) pb))]
    (if (primitive/icmp-lt a b) (primitive/cast i32 -1) (if (primitive/icmp-gt a b) (primitive/cast i32 1) (primitive/cast i32 0)))))

(defn dub [(x i64)] (-> i64) (primitive/imul x 2))
(defn sqr [(x i64)] (-> i64) (primitive/imul x x))
(defn neg [(x i64)] (-> i64) (primitive/isub 0 x))

(defn main [] (-> i64)
  (let [w (stdout) a (malloc-allocator)
        buf (primitive/cast (ptr i8) (unwrap-ptr (raw-alloc a 256 8)))]
    ; variadic with 6 anonymous args (all on the stack on Apple arm64)
    (let [n (snprintf buf 256 c"%lld|%s|%lld|%lld|%lld|%lld" 42 c"mid" -7 1000000007 5 6)]
      (out w "len" (primitive/cast i64 n))
      (print-str w "str=") (print-cstr w buf) (print-nl w))
    ; qsort calls our fnptr from C land
    (let [arr (primitive/cast (ptr i64) (unwrap-ptr (raw-alloc a 64 8)))]
      (primitive/store! (primitive/index arr 0) 42) (primitive/store! (primitive/index arr 1) -3)
      (primitive/store! (primitive/index arr 2) 17) (primitive/store! (primitive/index arr 3) 0)
      (primitive/store! (primitive/index arr 4) -100) (primitive/store! (primitive/index arr 5) 8)
      (primitive/store! (primitive/index arr 6) 99) (primitive/store! (primitive/index arr 7) 1)
      (qsort (primitive/cast (ptr i8) arr) 8 8 (primitive/fnptr-of cmp-i64))
      (let [(mut i) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) 8) (break)
          (do (print-i w (primitive/load (primitive/index arr (primitive/load i))) )
              (write-byte w (primitive/cast u8 44))
              (primitive/store! i (primitive/iadd (primitive/load i) 1))))))
      (print-nl w))
    ; a table of function pointers dispatched in a loop
    (let [tbl (primitive/cast (ptr (fnptr c [i64] i64)) (unwrap-ptr (raw-alloc a 24 8)))]
      (primitive/store! (primitive/index tbl 0) (primitive/fnptr-of dub))
      (primitive/store! (primitive/index tbl 1) (primitive/fnptr-of sqr))
      (primitive/store! (primitive/index tbl 2) (primitive/fnptr-of neg))
      (let [(mut i) 0 (mut acc) 0]
        (loop (if (primitive/icmp-ge (primitive/load i) 3) (break)
          (do (primitive/store! acc (primitive/iadd (primitive/load acc) (primitive/call-ptr (primitive/load (primitive/index tbl (primitive/load i))) 7)))
              (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
        (out w "tbl" (primitive/load acc))))
    0))
