; The COMPILED comptime readback (interp deletion step 2).
;
; Every `(comptime …)` below calls `sizeof`, which the tree-walking interpreter
; rejects outright. So the interpreter declines, the site routes to the compiled
; engine, and the value can only come back through comptime_eval's native-memory
; reader. If that reader is wrong these print wrong values or the build fails —
; and because the gate diffs arm64 against the LLVM reference, a reader that
; matches only one backend's layout fails too.
;
; Covered here: sums (fields and nullary), f32, arrays, strings, nested structs,
; and the non-default `packed` / `explicit` layouts.
(module t)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "src/stdlib/alloc.coil" :use *)
(import "src/stdlib/io.coil" :use *)
(import "src/stdlib/fmt.coil" :use *)

(defn out [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l) (print-str w "=") (print-i w v) (print-nl w) 0)

(defsum R (Yes [(v i64) (w i32)]) (No []) (Frac [(f f64)]))
(defstruct Inner [(a i32) (b i64)])
(defstruct Outer [(tag i64) (inner Inner) (cells (array i32 3))])
(defstruct Reg :layout explicit :size 16 :align 8
  [(id i32 :at 0) (data i64 :at 8)])
(defstruct Pk :layout packed [(a u8) (b i64)])

(defn mk-yes  [] (-> R)   (Yes (primitive/sizeof i64) 7))
(defn mk-no   [] (-> R)   (if (primitive/icmp-gt (primitive/sizeof i64) 0) (No) (Yes 0 0)))
(defn mk-frac [] (-> R)   (Frac (primitive/fdiv (primitive/cast f64 (primitive/sizeof i64)) 4.0)))
(defn mk-f32  [] (-> f32) (primitive/fdiv (primitive/cast f32 (primitive/sizeof i64)) 4.0))
(defn mk-outer [] (-> Outer)
  (let [p (alloc/stack Outer)]
    (primitive/store! (primitive/field p tag) (primitive/sizeof i64))
    (primitive/store! (primitive/field (primitive/field p inner) a) 11)
    (primitive/store! (primitive/field (primitive/field p inner) b) 22)
    (primitive/store! (primitive/index (primitive/field p cells) 0) 1)
    (primitive/store! (primitive/index (primitive/field p cells) 1) 2)
    (primitive/store! (primitive/index (primitive/field p cells) 2) 3)
    (primitive/load p)))
(defn mk-reg [] (-> Reg)
  (let [p (alloc/stack Reg)]
    (primitive/store! (primitive/field p id) (primitive/cast i32 (primitive/sizeof i64))) (primitive/store! (primitive/field p data) 99) (primitive/load p)))
(defn mk-pk [] (-> Pk)
  (let [p (alloc/stack Pk)]
    (primitive/store! (primitive/field p a) (primitive/cast u8 (primitive/sizeof i64))) (primitive/store! (primitive/field p b) 1234) (primitive/load p)))
(defn mk-str [] (-> (slice u8)) (if (primitive/icmp-gt (primitive/sizeof i64) 0) "eight" "other"))

(defn main [] (-> i64)
  (let [w (stdout)]
    (match (comptime (mk-yes))
      (Yes [v x] (do (out w "yes.v" v) (out w "yes.w" (primitive/cast i64 x))))
      (No [] (out w "yes" -1)) (Frac [f] (out w "yes" -2)))
    (match (comptime (mk-no))
      (Yes [v x] (out w "no" -1)) (No [] (out w "no" 0)) (Frac [f] (out w "no" -2)))
    (match (comptime (mk-frac))
      (Yes [v x] (out w "frac" -1)) (No [] (out w "frac" -2))
      (Frac [f] (out w "frac.x10" (primitive/cast i64 (primitive/fmul f 10.0)))))
    (out w "f32.x10" (primitive/cast i64 (primitive/fmul (primitive/cast f64 (comptime (mk-f32))) 10.0)))
    (let [o (alloc/stack Outer)]
      (primitive/store! o (comptime (mk-outer)))
      (out w "outer.tag" (primitive/load (primitive/field o tag)))
      (out w "outer.a"   (primitive/cast i64 (primitive/load (primitive/field (primitive/field o inner) a))))
      (out w "outer.b"   (primitive/load (primitive/field (primitive/field o inner) b)))
      (out w "outer.c0"  (primitive/cast i64 (primitive/load (primitive/index (primitive/field o cells) 0))))
      (out w "outer.c2"  (primitive/cast i64 (primitive/load (primitive/index (primitive/field o cells) 2)))))
    (let [r (alloc/stack Reg)]
      (primitive/store! r (comptime (mk-reg)))
      (out w "reg.id"   (primitive/cast i64 (primitive/load (primitive/field r id))))
      (out w "reg.data" (primitive/load (primitive/field r data))))
    (let [k (alloc/stack Pk)]
      (primitive/store! k (comptime (mk-pk)))
      (out w "pk.a" (primitive/cast i64 (primitive/load (primitive/field k a))))
      (out w "pk.b" (primitive/load (primitive/field k b))))
    (print-str w "str=") (print-str w (comptime (mk-str))) (print-nl w)
    0))
