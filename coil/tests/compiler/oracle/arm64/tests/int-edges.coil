; Adversarial integer semantics: narrow-width wraparound, signed/unsigned
; div/rem with negatives, arbitrary widths (u2/i3/u7), shift behavior.
(module t)
(import "primitive.coil" :as primitive)
(import "src/stdlib/alloc.coil" :use *)
(import "src/stdlib/io.coil" :use *)
(import "src/stdlib/fmt.coil" :use *)

(defn out [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l) (print-str w "=") (print-i w v) (print-nl w) 0)

(defn main [] (-> i64)
  (let [w (stdout)]
    ; u8 wraparound
    (out w "u8add" (primitive/cast i64 (primitive/iadd (primitive/cast u8 250) (primitive/cast u8 10))))
    (out w "u8mul" (primitive/cast i64 (primitive/imul (primitive/cast u8 20) (primitive/cast u8 20))))
    (out w "i8add" (primitive/cast i64 (primitive/iadd (primitive/cast i8 127) (primitive/cast i8 1))))
    (out w "i8sub" (primitive/cast i64 (primitive/isub (primitive/cast i8 -128) (primitive/cast i8 1))))
    (out w "u16mul" (primitive/cast i64 (primitive/imul (primitive/cast u16 300) (primitive/cast u16 300))))
    (out w "i16neg" (primitive/cast i64 (primitive/isub (primitive/cast i16 0) (primitive/cast i16 -32768))))
    (out w "u32add" (primitive/cast i64 (primitive/iadd (primitive/cast u32 4294967295) (primitive/cast u32 2))))
    ; signed division/remainder with negatives (truncated toward zero)
    (out w "sdiv1" (primitive/idiv -7 2))
    (out w "srem1" (primitive/irem -7 2))
    (out w "sdiv2" (primitive/idiv 7 -2))
    (out w "srem2" (primitive/irem 7 -2))
    (out w "sdiv3" (primitive/idiv -7 -2))
    (out w "srem3" (primitive/irem -7 -2))
    ; unsigned division on values with the high bit set
    (out w "udiv1" (primitive/cast i64 (primitive/udiv (primitive/cast u64 -2) (primitive/cast u64 3))))
    (out w "urem1" (primitive/cast i64 (primitive/urem (primitive/cast u64 -1) (primitive/cast u64 10))))
    ; narrow signed division: i8 -100 / 3
    (out w "i8div" (primitive/cast i64 (primitive/idiv (primitive/cast i8 -100) (primitive/cast i8 3))))
    (out w "i8rem" (primitive/cast i64 (primitive/irem (primitive/cast i8 -100) (primitive/cast i8 3))))
    (out w "u8div" (primitive/cast i64 (primitive/udiv (primitive/cast u8 200) (primitive/cast u8 3))))
    ; arbitrary widths
    (out w "u2" (primitive/cast i64 (primitive/cast u2 6)))
    (out w "u2add" (primitive/cast i64 (primitive/iadd (primitive/cast u2 3) (primitive/cast u2 3))))
    (out w "i3" (primitive/cast i64 (primitive/cast i3 5)))          ; 5 mod 8 -> 101 -> -3
    (out w "u7" (primitive/cast i64 (primitive/cast u7 200)))        ; 200 mod 128 = 72
    (out w "i3mul" (primitive/cast i64 (primitive/imul (primitive/cast i3 3) (primitive/cast i3 3))))  ; 9 -> 001 -> 1
    ; shifts within width
    (out w "shl" (primitive/ishl 1 62))
    (out w "shrs" (primitive/ishr -16 2))
    (out w "shru" (primitive/cast i64 (primitive/ishr (primitive/cast u64 -16) (primitive/cast u64 2))))
    (out w "u8shl" (primitive/cast i64 (primitive/ishl (primitive/cast u8 129) (primitive/cast u8 1))))
    (out w "i8shr" (primitive/cast i64 (primitive/ishr (primitive/cast i8 -64) (primitive/cast i8 3))))
    ; bitwise on mixed patterns
    (out w "and" (primitive/iand -252645136 65535))
    0))
