; Bit-struct fields at every container size, odd widths, signed bitfields,
; set/get roundtrips that must not clobber neighbors.
(module t)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "src/stdlib/alloc.coil" :use *)
(import "src/stdlib/io.coil" :use *)
(import "src/stdlib/fmt.coil" :use *)

(defn out [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l) (print-str w "=") (print-i w v) (print-nl w) 0)

(defstruct Flags :layout bits :backing :u8
  [(lo :bits 1) (mid :bits 3) (hi :bits 4)])
(defstruct Wide :layout bits :backing :u32
  [(a :bits 12) (b :bits 9) (c :bits 11)])

(defn main [] (-> i64)
  (let [w (stdout) f (alloc/stack Flags) g (alloc/stack Wide)]
    (primitive/bit-set! f lo (primitive/cast u1 1))
    (primitive/bit-set! f mid (primitive/cast u3 5))
    (primitive/bit-set! f hi (primitive/cast u4 12))
    (out w "lo" (primitive/cast i64 (primitive/bit-get f lo)))
    (out w "mid" (primitive/cast i64 (primitive/bit-get f mid)))
    (out w "hi" (primitive/cast i64 (primitive/bit-get f hi)))
    (out w "raw8" (primitive/cast i64 (primitive/load (primitive/cast (ptr u8) f))))
    ; overwrite the middle field only; neighbors must survive
    (primitive/bit-set! f mid (primitive/cast u3 2))
    (out w "lo2" (primitive/cast i64 (primitive/bit-get f lo)))
    (out w "mid2" (primitive/cast i64 (primitive/bit-get f mid)))
    (out w "hi2" (primitive/cast i64 (primitive/bit-get f hi)))
    ; 32-bit container, odd widths
    (primitive/bit-set! g a (primitive/cast u12 4095))
    (primitive/bit-set! g b (primitive/cast u9 257))
    (primitive/bit-set! g c (primitive/cast u11 1024))
    (out w "a" (primitive/cast i64 (primitive/bit-get g a)))
    (out w "b" (primitive/cast i64 (primitive/bit-get g b)))
    (out w "c" (primitive/cast i64 (primitive/bit-get g c)))
    (primitive/bit-set! g b (primitive/cast u9 0))
    (out w "a2" (primitive/cast i64 (primitive/bit-get g a)))
    (out w "c2" (primitive/cast i64 (primitive/bit-get g c)))
    ; width masking through set: 300 mod 512 = 300, 5000 mod 4096 = 904
    (primitive/bit-set! g b (primitive/cast u9 300))
    (primitive/bit-set! g a (primitive/cast u12 5000))
    (out w "amask" (primitive/cast i64 (primitive/bit-get g a)))
    (out w "bmask" (primitive/cast i64 (primitive/bit-get g b)))
    0))
