(defn
  arena-used
  [(a (ptr Allocator))]
  (-> i64)
  (load (field (cast (ptr Arena) (load (field a ctx))) off)))

(defn
  coil-test$arena-top-block-grows-in-place
  []
  (-> i64)
  (let
    [a (arena-allocator 4194304) (mut xs) (al-new [i64] a) (mut i) 0]
    (loop
      (if
        (>= (load i) 100000)
        (break)
        (do (al-push! (mut xs) (load i)) (store! i (+ (load i) 1)))))
    (if
      (= (al-len [i64] (load xs)) 100000)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-len [i64] (load xs))"
          "100000"
          "src/examples/arena-growth.coil"
          27)
        0))
    (if
      (= (al-get (load xs) 0) 0)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 0)"
          "0"
          "src/examples/arena-growth.coil"
          28)
        0))
    (if
      (= (al-get (load xs) 99999) 99999)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 99999)"
          "99999"
          "src/examples/arena-growth.coil"
          29)
        0))
    (if
      (= (arena-used a) (* 131072 8))
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(arena-used a)"
          "(* 131072 8)"
          "src/examples/arena-growth.coil"
          33)
        0)))
  0)

(defn
  coil-test$arena-interleaved-lists-keep-their-elements
  []
  (-> i64)
  (let
    [a
      (arena-allocator 65536)
      (mut xs)
      (al-new [i64] a)
      (mut ys)
      (al-new [i64] a)
      (mut i)
      0]
    (loop
      (if
        (>= (load i) 64)
        (break)
        (do
          (al-push! (mut xs) (load i))
          (al-push! (mut ys) (* (load i) 10))
          (store! i (+ (load i) 1)))))
    (if
      (= (al-len [i64] (load xs)) 64)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-len [i64] (load xs))"
          "64"
          "src/examples/arena-growth.coil"
          48)
        0))
    (if
      (= (al-len [i64] (load ys)) 64)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-len [i64] (load ys))"
          "64"
          "src/examples/arena-growth.coil"
          49)
        0))
    (if
      (= (al-get (load xs) 0) 0)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 0)"
          "0"
          "src/examples/arena-growth.coil"
          50)
        0))
    (if
      (= (al-get (load ys) 0) 0)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load ys) 0)"
          "0"
          "src/examples/arena-growth.coil"
          51)
        0))
    (if
      (= (al-get (load xs) 63) 63)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 63)"
          "63"
          "src/examples/arena-growth.coil"
          52)
        0))
    (if
      (= (al-get (load ys) 63) 630)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load ys) 63)"
          "630"
          "src/examples/arena-growth.coil"
          53)
        0)))
  0)

(defn
  coil-test$al-extend-appends-in-bulk
  []
  (-> i64)
  (let
    [a
      (malloc-allocator)
      src
      (unwrap-ptr [i64] (alloc-slice [i64] a 300))
      (mut xs)
      (al-new [i64] a)
      (mut i)
      0]
    (loop
      (if
        (>= (load i) 300)
        (break)
        (do (store! (index src (load i)) (load i)) (store! i (+ (load i) 1)))))
    (al-push! (mut xs) -1)
    (al-extend! [i64] (mut xs) src 300)
    (al-extend! [i64] (mut xs) src 300)
    (if
      (= (al-len [i64] (load xs)) 601)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-len [i64] (load xs))"
          "601"
          "src/examples/arena-growth.coil"
          69)
        0))
    (if
      (= (al-get (load xs) 0) -1)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 0)"
          "-1"
          "src/examples/arena-growth.coil"
          70)
        0))
    (if
      (= (al-get (load xs) 1) 0)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 1)"
          "0"
          "src/examples/arena-growth.coil"
          71)
        0))
    (if
      (= (al-get (load xs) 300) 299)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 300)"
          "299"
          "src/examples/arena-growth.coil"
          72)
        0))
    (if
      (= (al-get (load xs) 301) 0)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 301)"
          "0"
          "src/examples/arena-growth.coil"
          73)
        0))
    (if
      (= (al-get (load xs) 600) 299)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 600)"
          "299"
          "src/examples/arena-growth.coil"
          74)
        0)))
  0)

(defn
  coil-test$overflow-arena-outlives-its-region
  []
  (-> i64)
  (let
    [cap 4096 a (overflow-arena-allocator cap) (mut xs) (al-new [i64] a) (mut i) 0]
    (loop
      (if
        (>= (load i) 50000)
        (break)
        (do (al-push! (mut xs) (* (load i) 3)) (store! i (+ (load i) 1)))))
    (if
      (= (al-len [i64] (load xs)) 50000)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-len [i64] (load xs))"
          "50000"
          "src/examples/arena-growth.coil"
          87)
        0))
    (if
      (= (al-get (load xs) 0) 0)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 0)"
          "0"
          "src/examples/arena-growth.coil"
          88)
        0))
    (if
      (= (al-get (load xs) 49999) 149997)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 49999)"
          "149997"
          "src/examples/arena-growth.coil"
          89)
        0))
    (if
      (<= (arena-used a) cap)
      0
      (do
        (assert.assert-fail "(<= (arena-used a) cap)" "src/examples/arena-growth.coil" 91)
        0)))
  0)

(defn
  coil-test$overflow-arena-actually-bumps
  []
  (-> i64)
  (let
    [a (overflow-arena-allocator 65536) (mut xs) (al-new [i64] a)]
    (if
      (= (arena-used a) 0)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(arena-used a)"
          "0"
          "src/examples/arena-growth.coil"
          100)
        0))
    (al-push! (mut xs) 1)
    (if
      (= (arena-used a) 16)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(arena-used a)"
          "16"
          "src/examples/arena-growth.coil"
          102)
        0))
    (al-push! (mut xs) 2)
    (if
      (= (arena-used a) 16)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(arena-used a)"
          "16"
          "src/examples/arena-growth.coil"
          104)
        0))
    (al-push! (mut xs) 3)
    (if
      (= (arena-used a) 32)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(arena-used a)"
          "32"
          "src/examples/arena-growth.coil"
          106)
        0))
    (al-push! (mut xs) 4)
    (al-push! (mut xs) 5)
    (if
      (= (arena-used a) 64)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(arena-used a)"
          "64"
          "src/examples/arena-growth.coil"
          109)
        0))
    (if
      (= (al-get (load xs) 4) 5)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 4)"
          "5"
          "src/examples/arena-growth.coil"
          110)
        0)))
  0)

(defn
  coil-test$overflow-arena-frees-only-overflow-blocks
  []
  (-> i64)
  (let
    [a
      (overflow-arena-allocator 256)
      (mut in)
      (al-new [i64] a)
      (mut out)
      (al-new [i64] a)
      (mut i)
      0]
    (al-push! (mut in) 42)
    (loop
      (if
        (>= (load i) 2000)
        (break)
        (do (al-push! (mut out) (load i)) (store! i (+ (load i) 1)))))
    (al-free! (mut out))
    (al-free! (mut in))
    (if
      (= (al-len [i64] (load out)) 0)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-len [i64] (load out))"
          "0"
          "src/examples/arena-growth.coil"
          127)
        0))
    (if
      (= (al-len [i64] (load in)) 0)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-len [i64] (load in))"
          "0"
          "src/examples/arena-growth.coil"
          128)
        0)))
  0)

(defn
  coil-test$al-extend-of-nothing-changes-nothing
  []
  (-> i64)
  (let
    [a (malloc-allocator) (mut xs) (al-new [i64] a)]
    (al-push! (mut xs) 7)
    (al-extend! [i64] (mut xs) (cast (ptr i64) 0) 0)
    (if
      (= (al-len [i64] (load xs)) 1)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-len [i64] (load xs))"
          "1"
          "src/examples/arena-growth.coil"
          137)
        0))
    (if
      (= (al-get (load xs) 0) 7)
      0
      (do
        (assert.assert-fail-cmp
          "=="
          "(al-get (load xs) 0)"
          "7"
          "src/examples/arena-growth.coil"
          138)
        0)))
  0)

(defn
  main
  []
  (-> i64)
  (assert.test-run-begin 7)
  (assert.test-run-one
    "arena-top-block-grows-in-place"
    (fnptr-of coil-test$arena-top-block-grows-in-place))
  (assert.test-run-one
    "arena-interleaved-lists-keep-their-elements"
    (fnptr-of coil-test$arena-interleaved-lists-keep-their-elements))
  (assert.test-run-one
    "al-extend-appends-in-bulk"
    (fnptr-of coil-test$al-extend-appends-in-bulk))
  (assert.test-run-one
    "overflow-arena-outlives-its-region"
    (fnptr-of coil-test$overflow-arena-outlives-its-region))
  (assert.test-run-one
    "overflow-arena-actually-bumps"
    (fnptr-of coil-test$overflow-arena-actually-bumps))
  (assert.test-run-one
    "overflow-arena-frees-only-overflow-blocks"
    (fnptr-of coil-test$overflow-arena-frees-only-overflow-blocks))
  (assert.test-run-one
    "al-extend-of-nothing-changes-nothing"
    (fnptr-of coil-test$al-extend-of-nothing-changes-nothing))
  (assert.test-run-end))

