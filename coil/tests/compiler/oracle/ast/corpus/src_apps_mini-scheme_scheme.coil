(defn cadr [(x (ptr Val))] (-> (ptr Val)) (car (cdr x)))

(defn caddr [(x (ptr Val))] (-> (ptr Val)) (car (cdr (cdr x))))

(defn cadddr [(x (ptr Val))] (-> (ptr Val)) (car (cdr (cdr (cdr x)))))

(defn
  is-sym
  [(v (ptr Val)) (name (slice u8))]
  (-> bool)
  (and (symp v) (= (sym-id v) (intern name))))

(defn
  assq
  [(sym (ptr Val)) (alist (ptr Val))]
  (-> (ptr Val))
  (if
    (nullp alist)
    (snil)
    (let [pr (car alist)] (if (= (sym-id (car pr)) (sym-id sym)) pr (assq sym (cdr alist))))))

(defn
  lookup
  [(sym (ptr Val)) (env (ptr Val))]
  (-> (ptr Val))
  (let
    [pr (assq sym env)]
    (if (nullp pr) (let [gpr (assq sym (genv))] (if (nullp gpr) sym (cdr gpr))) (cdr pr))))

