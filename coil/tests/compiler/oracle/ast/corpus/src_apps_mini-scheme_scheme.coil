        [a (malloc-allocator) src (read-stdin a)]
        (let
          [$g2824
            (match
              (read-all a src 0)
              (Err [d] (do (do (io.print-str (stderr) "parse error
")) 1))
              (Ok
                [fs]
                (do
                  (let
                    [$g2825 (gc-sp)]
                    (let
                      [$g2826
                        (let
                          [$g2827 (run-forms fs 0 (forms-count fs))]
