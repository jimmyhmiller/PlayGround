(defstruct Header [(name (slice u8)) (value (slice u8))])

(defstruct
  Request
  [(method (slice u8))
    (target (slice u8))
    (version (slice u8))
    (headers (arraylist/ArrayList Header))
    (body (slice u8))
    (consumed i64)])

(defstruct Error [(offset i64) (code i64)])

(defstruct
  HttpParser
  [(source (slice u8)) (pos i64) (status i64) (headers (arraylist/ArrayList Header))])

(defn
  http-end?
  [(p (ptr HttpParser))]
  (-> bool)
  (icmp-ge (load (field p pos)) (slice/slice-len (load (field p source)))))

(defn
  http-peek
  [(p (ptr HttpParser))]
  (-> i64)
  (if
    (http-end? p)
    -1
    (cast i64 (slice/slice-get (load (field p source)) (load (field p pos))))))

(defn
  http-advance
  [(p (ptr HttpParser))]
  (-> i64)
  (store! (field p pos) (iadd (load (field p pos)) 1))
  0)

(defn
  http-fail
  [(p (ptr HttpParser)) (code i64)]
  (-> i64)
  (if (icmp-eq (load (field p status)) 0) (store! (field p status) code) 0)
  0)

(defn
  http-token-char?
  [(c i64)]
  (-> bool)
  (and
    (and (icmp-gt c 32) (icmp-lt c 127))
    (not
      (or
        (icmp-eq c 40)
        (or
          (icmp-eq c 41)
          (or
            (icmp-eq c 60)
            (or
              (icmp-eq c 62)
              (or
                (icmp-eq c 64)
                (or
                  (icmp-eq c 44)
                  (or
                    (icmp-eq c 59)
                    (or
                      (icmp-eq c 58)
                      (or
                        (icmp-eq c 92)
                        (or
                          (icmp-eq c 34)
                          (or
                            (icmp-eq c 47)
                            (or
                              (icmp-eq c 91)
                              (or
                                (icmp-eq c 93)
                                (or
                                  (icmp-eq c 63)
                                  (or (icmp-eq c 61) (or (icmp-eq c 123) (icmp-eq c 125))))))))))))))))))))

(defn
  http-scan-to
  [(p (ptr HttpParser)) (stop i64)]
  (-> (slice u8))
  (let
    [start (load (field p pos))]
    (loop (if (or (http-end? p) (icmp-eq (http-peek p) stop)) (break) (http-advance p)))
    (slice/subslice (load (field p source)) start (load (field p pos)))))

(defn
  http-expect
  [(p (ptr HttpParser)) (c i64) (code i64)]
  (-> i64)
  (if (icmp-eq (http-peek p) c) (http-advance p) (http-fail p code)))

(defn
  http-crlf
  [(p (ptr HttpParser))]
  (-> i64)
  (if
    (and
      (icmp-eq (http-peek p) 13)
      (and
        (icmp-lt (iadd (load (field p pos)) 1) (slice/slice-len (load (field p source))))
        (icmp-eq
          (cast i64 (slice/slice-get (load (field p source)) (iadd (load (field p pos)) 1)))
          10)))
    (do (http-advance p) (http-advance p))
    (http-fail p 2)))

(defn
  http-ascii-lower
  [(c i64)]
  (-> i64)
  (if (and (icmp-ge c 65) (icmp-le c 90)) (iadd c 32) c))

(defn
  http-ci-eq
  [(a (slice u8)) (b (slice u8))]
  (-> bool)
  (if
    (icmp-ne (slice/slice-len a) (slice/slice-len b))
    false
    (let
      [(mut i) 0 (mut same) true]
      (loop
        (if
          (icmp-ge (load i) (slice/slice-len a))
          (break)
          (if
            (icmp-eq
              (http-ascii-lower (cast i64 (slice/slice-get a (load i))))
              (http-ascii-lower (cast i64 (slice/slice-get b (load i)))))
            (store! i (iadd (load i) 1))
            (do (store! same false) (break)))))
      (load same))))

(defn
  http-trim-ows
  [(s (slice u8))]
  (-> (slice u8))
  (let
    [(mut lo) 0 (mut hi) (slice/slice-len s)]
    (loop
      (if
        (and
          (icmp-lt (load lo) (load hi))
          (or
            (icmp-eq (cast i64 (slice/slice-get s (load lo))) 32)
            (icmp-eq (cast i64 (slice/slice-get s (load lo))) 9)))
        (store! lo (iadd (load lo) 1))
        (break)))
    (loop
      (if
        (and
          (icmp-lt (load lo) (load hi))
          (or
            (icmp-eq (cast i64 (slice/slice-get s (isub (load hi) 1))) 32)
            (icmp-eq (cast i64 (slice/slice-get s (isub (load hi) 1))) 9)))
        (store! hi (isub (load hi) 1))
        (break)))
    (slice/subslice s (load lo) (load hi))))

(defn
  http-parse-header
  [(p (ptr HttpParser))]
  (-> i64)
  (let
    [start (load (field p pos))]
    (loop
      (if
        (or (http-end? p) (not (http-token-char? (http-peek p))))
        (break)
        (http-advance p)))
    (let
      [name (slice/subslice (load (field p source)) start (load (field p pos)))]
      (if (icmp-eq (slice/slice-len name) 0) (http-fail p 3) 0)
      (http-expect p 58 3)
      (let
        [raw (http-scan-to p 13)]
        (if
          (icmp-eq (load (field p status)) 0)
          (let
            [(mut h) (zeroed Header)]
            (store! (field h name) name)
            (store! (field h value) (http-trim-ows raw))
            (arraylist/al-push! (mut (field p headers)) (load h))
            (http-crlf p))
          0)))
    0))

(defn header-count [(r Request)] (-> i64) (arraylist/al-len (field r headers)))

(defn
  header-at
  [(r Request) (i i64)]
  (-> Header)
  (arraylist/al-get (load (field r headers)) i))

(defn
  header
  [(r Request) (name (slice u8))]
  (-> (slice u8))
  (let
    [(mut i) 0 (mut value) ""]
    (loop
      (if
        (icmp-ge (load i) (header-count r))
        (break)
        (let
          [h (header-at r (load i))]
          (if
            (http-ci-eq (load (field h name)) name)
            (do (store! value (load (field h value))) (break))
            (store! i (iadd (load i) 1))))))
    (load value)))

(defn
  http-content-length
  [(p (ptr HttpParser))]
  (-> i64)
  (let
    [(mut i) 0 (mut result) 0 (mut seen) false]
    (loop
      (if
        (icmp-ge (load i) (arraylist/al-len (field p headers)))
        (break)
        (let
          [h (arraylist/al-get (load (field p headers)) (load i))]
          (if
            (http-ci-eq (load (field h name)) "Content-Length")
            (let
              [v (load (field h value)) (mut j) 0 (mut n) 0]
              (if (load seen) (http-fail p 6) (store! seen true))
              (if (icmp-eq (slice/slice-len v) 0) (http-fail p 6) 0)
              (loop
                (if
                  (icmp-ge (load j) (slice/slice-len v))
                  (break)
                  (let
                    [c (cast i64 (slice/slice-get v (load j)))]
                    (if
                      (and (icmp-ge c 48) (icmp-le c 57))
                      (do
                        (store! n (iadd (imul (load n) 10) (isub c 48)))
                        (store! j (iadd (load j) 1)))
                      (do (http-fail p 6) (break))))))
              (store! result (load n)))
            0)
          (store! i (iadd (load i) 1)))))
    (load result)))

(defn
  parse-request
  [(a (ptr alloc/Allocator)) (source (slice u8))]
  (-> (Result Request Error))
  (let
    [p (alloc-stack HttpParser)]
    (store! (field p source) source)
    (store! (field p pos) 0)
    (store! (field p status) 0)
    (store! (field p headers) (arraylist/al-new [Header] a))
    (let
      [method (http-scan-to p 32)]
      (if (icmp-eq (slice/slice-len method) 0) (http-fail p 1) 0)
      (http-expect p 32 1)
      (let
        [target (http-scan-to p 32)]
        (if (icmp-eq (slice/slice-len target) 0) (http-fail p 1) 0)
        (http-expect p 32 1)
        (let
          [version (http-scan-to p 13)]
          (if
            (not (or (str/str-eq version "HTTP/1.1") (str/str-eq version "HTTP/1.0")))
            (http-fail p 4)
            0)
          (http-crlf p)
          (loop
            (if
              (icmp-ne (load (field p status)) 0)
              (break)
              (if
                (icmp-eq (http-peek p) 13)
                (do (http-crlf p) (break))
                (http-parse-header p))))
          (let
            [body-start (load (field p pos)) body-len (http-content-length p)]
            (if
              (icmp-gt (iadd body-start body-len) (slice/slice-len source))
              (http-fail p 5)
              0)
            (if
              (icmp-eq (load (field p status)) 0)
              (let
                [(mut r) (zeroed Request)]
                (store! (field r method) method)
                (store! (field r target) target)
                (store! (field r version) version)
                (store! (field r headers) (load (field p headers)))
                (store!
                  (field r body)
                  (slice/subslice source body-start (iadd body-start body-len)))
                (store! (field r consumed) (iadd body-start body-len))
                (Ok (load r)))
              (let
                [(mut e) (zeroed Error)]
                (store! (field e offset) (load (field p pos)))
                (store! (field e code) (load (field p status)))
                (Err (load e))))))))))

(defn
  method-is
  [(r Request) (method (slice u8))]
  (-> bool)
  (str/str-eq (load (field r method)) method))

(defn method [(r Request)] (-> (slice u8)) (load (field r method)))

(defn target [(r Request)] (-> (slice u8)) (load (field r target)))

(defn version [(r Request)] (-> (slice u8)) (load (field r version)))

(defn body [(r Request)] (-> (slice u8)) (load (field r body)))

(defn consumed [(r Request)] (-> i64) (load (field r consumed)))

(defn error-offset [(e Error)] (-> i64) (load (field e offset)))

(defn error-code [(e Error)] (-> i64) (load (field e code)))

(defn
  keep-alive?
  [(r Request)]
  (-> bool)
  (let
    [connection (header r "Connection")]
    (if
      (str/str-eq (load (field r version)) "HTTP/1.1")
      (not (http-ci-eq connection "close"))
      (http-ci-eq connection "keep-alive"))))

