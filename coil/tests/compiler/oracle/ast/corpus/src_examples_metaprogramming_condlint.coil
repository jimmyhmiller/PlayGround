(defn cl-min-tests [] (-> i64) 3)

(defn
  cl-hand-if?
  [(f Code)]
  (-> bool)
  (if
    (code-list? f)
    (if
      (icmp-eq (code-count f) 4)
      (if (code-eq (code-nth f 0) (quasiquote if)) (not (code-macro? f)) false)
      false)
    false))

(defn
  cl-chain-len
  [(f Code)]
  (-> i64)
  (if (cl-hand-if? f) (iadd 1 (cl-chain-len (code-nth f 3))) 0))

(defn
  cl-clauses
  [(f Code)]
  (-> Code)
  (if
    (cl-hand-if? f)
    (quasiquote
      ((unquote (code-nth f 1))
        (unquote (code-nth f 2))
        (unquote-splicing (cl-clauses (code-nth f 3)))))
    (quasiquote (:else (unquote f)))))

(defn cl-as-cond [(f Code)] (-> Code) (quasiquote (cond (unquote-splicing (cl-clauses f)))))

(defn
  cl-walk
  [(f Code)]
  (-> Code)
  (if
    (code-list? f)
    (if
      (icmp-ge (cl-chain-len f) (cl-min-tests))
      (do
        (suggest f "3 or more nested ifs — write this as a cond" (cl-as-cond f))
        (cl-walk-chain f))
      (cl-kids f 0 (code-count f)))
    (quasiquote 0)))

(defn
  cl-walk-chain
  [(f Code)]
  (-> Code)
  (if
    (cl-hand-if? f)
    (do (cl-walk (code-nth f 1)) (cl-walk (code-nth f 2)) (cl-walk-chain (code-nth f 3)))
    (cl-walk f)))

(defn
  cl-kids
  [(f Code) (i i64) (n i64)]
  (-> Code)
  (if (icmp-ge i n) (quasiquote 0) (do (cl-walk (code-nth f i)) (cl-kids f (iadd i 1) n))))

(defn
  cl-look-at?
  [(m Code)]
  (-> bool)
  (if (icmp-gt (code-count m) 1) (code-from-user? (code-nth m 1)) false))

(defn
  cl-forms
  [(m Code) (i i64) (n i64)]
  (-> Code)
  (if (icmp-ge i n) (quasiquote 0) (do (cl-walk (code-nth m i)) (cl-forms m (iadd i 1) n))))

(defn
  cl-mods
  [(ms Code) (i i64) (n i64)]
  (-> Code)
  (if
    (icmp-ge i n)
    (quasiquote 0)
    (do
      (let
        [m (code-nth ms i)]
        (if (cl-look-at? m) (cl-forms m 1 (code-count m)) (quasiquote 0)))
      (cl-mods ms (iadd i 1) n))))

(defn lint-nested-if [(modules Code)] (-> Code) (cl-mods modules 0 (code-count modules)))

