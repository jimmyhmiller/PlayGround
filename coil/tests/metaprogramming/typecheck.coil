(module typecheck)
(import "primitive.coil" :as primitive)
; Bans referencing a struct defined in module `wb`. Uses code-decl on a TYPE node —
; resolved exactly to its module even though `Box` is defined in both wa and wb.
(defn is-wb-struct? [(d Code)] (-> bool)
  (and (primitive/code-list? d)
       (and (primitive/icmp-ge (primitive/code-count d) 3)
            (and (primitive/code-eq (primitive/code-nth d 1) `wb) (primitive/code-eq (primitive/code-nth d 2) `struct)))))
(defn check-node [(f Code)] (-> Code)
  (do (if (is-wb-struct? (primitive/code-decl f)) (do (primitive/report f "policy: references a struct from module wb") 0) 0)
      (if (primitive/code-list? f) (check-kids f 0 (primitive/code-count f)) `0)))
(defn check-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0 (do (check-node (primitive/code-nth f i)) (check-kids f (primitive/iadd i 1) n))))
(defn look-at? [(m Code)] (-> bool)
  (if (primitive/icmp-gt (primitive/code-count m) 1) (primitive/code-from-user? (primitive/code-nth m 1)) false))
(defn check-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0 (do (check-node (primitive/code-nth m i)) (check-forms m (primitive/iadd i 1) n))))
(defn check-mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0 (do (let [m (primitive/code-nth ms i)] (if (look-at? m) (check-forms m 1 (primitive/code-count m)) `0)) (check-mods ms (primitive/iadd i 1) n))))
(defn check-types [(modules Code)] (-> Code) (check-mods modules 0 (primitive/code-count modules)))
