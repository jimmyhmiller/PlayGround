(module safedialect)
(import "primitive.coil" :as primitive)

;; --- TRANSFORM: desugar (inc E) -> (primitive/iadd E 1) program-wide (gets the FLAT program) ---
(defn has-inc? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (and (primitive/icmp-gt (primitive/code-count f) 0) (primitive/code-eq (primitive/code-nth f 0) `inc)) true (has-inc-kids? f 0 (primitive/code-count f)))
    false))
(defn has-inc-kids? [(f Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n) false (if (has-inc? (primitive/code-nth f i)) true (has-inc-kids? f (primitive/iadd i 1) n))))
(defn dw-rewrite [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (and (primitive/icmp-gt (primitive/code-count f) 0) (primitive/code-eq (primitive/code-nth f 0) `inc))
          `(primitive/iadd ~(dw-rewrite (primitive/code-nth f 1)) 1)
        (if (has-inc? f) `(~@(dw-kids f 0 (primitive/code-count f))) f))
    f))
(defn dw-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `() `(~(dw-rewrite (primitive/code-nth f i)) ~@(dw-kids f (primitive/iadd i 1) n))))
(defn desugar-inc [(prog Code)] (-> Code) `(do ~@(dw-kids prog 0 (primitive/code-count prog))))

;; --- CHECKER: ban (forbidden-op …) anywhere (gets MODULES) ---
(defn has-bad? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (and (primitive/icmp-gt (primitive/code-count f) 0) (primitive/code-eq (primitive/code-nth f 0) `forbidden-op)) true (has-bad-kids? f 0 (primitive/code-count f)))
    false))
(defn has-bad-kids? [(f Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n) false (if (has-bad? (primitive/code-nth f i)) true (has-bad-kids? f (primitive/iadd i 1) n))))
(defn mod-has-bad [(m Code)] (-> bool) (has-bad-kids? m 1 (primitive/code-count m)))
(defn any-mod-bad [(ms Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n) false (if (mod-has-bad (primitive/code-nth ms i)) true (any-mod-bad ms (primitive/iadd i 1) n))))
(defn no-forbidden-op [(modules Code)] (-> Code)
  (if (any-mod-bad modules 0 (primitive/code-count modules)) (primitive/error "safedialect: (forbidden-op …) is banned") `0))

;; --- THE DIALECT ---
(transform desugar-inc)
(checker no-forbidden-op)
