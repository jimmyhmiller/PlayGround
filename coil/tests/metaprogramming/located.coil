(module located)
(import "primitive.coil" :as primitive)
(defn check-node [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (primitive/icmp-gt (primitive/code-count f) 0)
          (do (if (primitive/code-eq (primitive/code-nth f 0) `banned) (do (primitive/report f "banned form used here") 0) 0)
              (check-kids f 0 (primitive/code-count f)))
        `0)
    `0))
(defn check-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0 (do (check-node (primitive/code-nth f i)) (check-kids f (primitive/iadd i 1) n))))
(defn check-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0 (do (check-node (primitive/code-nth m i)) (check-forms m (primitive/iadd i 1) n))))
(defn located-mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0 (do (check-forms (primitive/code-nth ms i) 1 (primitive/code-count (primitive/code-nth ms i))) (located-mods ms (primitive/iadd i 1) n))))
(defn located-check [(modules Code)] (-> Code) (located-mods modules 0 (primitive/code-count modules)))
