(module nofloat)
(import "primitive.coil" :as primitive)
; A checker that uses `(primitive/type-of NODE)` — the per-expression inferred type from the
; real type-checker. Policy: no expression may have a floating-point type. This reads
; INFERRED types, not syntax: a call `(getf)` is flagged because getf's RETURN type is
; f64 — invisible at the call site without the checker's own inference.

(defn banned-type? [(t Code)] (-> bool)
  (and (primitive/code-sym? t) (or (primitive/code-eq t `f64) (primitive/code-eq t `f32))))
(defn check-node [(f Code)] (-> Code)
  (do (if (banned-type? (primitive/type-of f))
          (do (primitive/report f "policy: floating-point values are banned in this dialect") 0)
        0)
      (if (primitive/code-list? f) (check-kids f 0 (primitive/code-count f)) `0)))
(defn check-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0 (do (check-node (primitive/code-nth f i)) (check-kids f (primitive/iadd i 1) n))))

(defn look-at? [(m Code)] (-> bool)
  (if (primitive/icmp-gt (primitive/code-count m) 1) (primitive/code-from-user? (primitive/code-nth m 1)) false))
(defn check-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0 (do (check-node (primitive/code-nth m i)) (check-forms m (primitive/iadd i 1) n))))
(defn check-mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0
    (do (let [m (primitive/code-nth ms i)] (if (look-at? m) (check-forms m 1 (primitive/code-count m)) `0))
        (check-mods ms (primitive/iadd i 1) n))))
(defn check-nofloat [(modules Code)] (-> Code) (check-mods modules 0 (primitive/code-count modules)))
