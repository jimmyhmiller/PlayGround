(module app)
(import "primitive.coil" :as primitive)
(import "lint.coil" :use *)
(checker lint-icmp)
(defn f [(x :i64) (y :i64)] (-> :i64)
  (if (primitive/icmp-lt x y) (if (primitive/icmp-gt x 0) 1 0) (if (primitive/icmp-eq y 0) 2 3)))
(defn main [] (-> :i64)
  (if (primitive/icmp-gt (f 3 4) 5) 0 42))
