; ============================================================================
; A GUI AT COMPILE TIME — the "run a GUI at comptime" milestone from the
; compile-and-run design, made real.
;
; `(mandel-pick)` is a MACRO. When the compiler expands it, it opens a real
; Cocoa window on the process main thread and renders the Mandelbrot set,
; live: WASD pans, Z/X zooms, I/O changes the iteration budget, Q or RETURN
; accepts the current view. The macro then expands to a call carrying the
; coordinates you chose — the compiled program is parameterized by a
; compile-time GUI session. Under COIL_MANDEL_AUTO=1 the viewer drives itself
; (a scripted zoom, no focus steal) so builds are reproducible/CI-able.
;
; Build (the metaprogram dylib links the same flags as the program):
;   COIL_META_MAIN=1 coil run tests/metaprogramming/compile-and-run/mandel_test.coil \
;     --link-flag -framework --link-flag AppKit --link-flag -lobjc
;
; COIL_META_MAIN=1 routes metaprogram calls to the REAL main thread (AppKit
; requires it); the driver's main thread services them while the pipeline runs.
;
; Everything here is ordinary Coil: malloc'd framebuffers, f64 math, CoreGraphics
; and the Objective-C runtime over plain C FFI, `while`/`when`/`fmt` macros used
; INSIDE the macro's own body (the tower). None of it is special-cased — the
; metaprogram is just a program.
; ============================================================================
(module mandelbrot)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :as alloc)
(import "src/stdlib/alloc.coil" :use *)
(import "src/stdlib/slice.coil" :use *)
(import "src/stdlib/io.coil" :use *)
(import "src/stdlib/fmt.coil" :use *)
(import "src/stdlib/control.coil" :use *)

; ---- Objective-C runtime + CoreGraphics, plain C ----------------------------
(extern objc_getClass    :cc c [(ptr i8)] (-> (ptr i8)))
(extern sel_registerName :cc c [(ptr i8)] (-> (ptr i8)))
(extern objc_msgSend     :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern CGColorSpaceCreateDeviceRGB :cc c [] (-> (ptr i8)))
(extern CGBitmapContextCreate       :cc c [(ptr i8) i64 i64 i64 i64 (ptr i8) i64] (-> (ptr i8)))
(extern CGBitmapContextCreateImage  :cc c [(ptr i8)] (-> (ptr i8)))
(extern CGContextRelease            :cc c [(ptr i8)] (-> i64))
(extern CGColorSpaceRelease         :cc c [(ptr i8)] (-> i64))
(extern CGImageRelease              :cc c [(ptr i8)] (-> i64))
(extern usleep                      :cc c [i64] (-> i32))
(extern getenv                      :cc c [(ptr i8)] (-> (ptr i8)))

(defstruct CGRect [(x f64) (y f64) (w f64) (h f64)])

; the CLASSIC objc `msg` macro (src/apps/chip8/objc.coil), used INSIDE a metaprogram
; body: its type-syntax arguments ((ptr i8) returns, [CGRect i64 …] argtype
; vectors) make the raw call unparseable as an expression, which is exactly the
; tower's syntactic trigger — it expands here at definition time like anywhere else
(defn mcls [(n (ptr i8))] (-> (ptr i8)) (objc_getClass n))
(defn msel [(n (ptr i8))] (-> (ptr i8)) (sel_registerName n))
(defn msg [(ret Code) (recv Code) (selector Code) (argtypes Code) & (args Code)] (-> Code)
  `(primitive/call-ptr
     (primitive/cast (fnptr c [(ptr i8) (ptr i8) ~@argtypes] ~ret) (primitive/fnptr-of objc_msgSend))
     ~recv ~selector ~@args))

; ---- the view ----------------------------------------------------------------
(defstruct MView [(cx f64) (cy f64) (scale f64) (iters i64) (done i64)])

(const MW 480)
(const MH 320)

; escape-time iteration count for one point (iters = the budget)
(defn mandel-iter [(re f64) (im f64) (iters i64)] (-> i64)
  (let [(mut zr) 0.0 (mut zi) 0.0 (mut k) 0]
    (loop
      (if (primitive/icmp-ge (primitive/load k) iters) (break (primitive/load k))
        (let [zr2 (primitive/fmul (primitive/load zr) (primitive/load zr)) zi2 (primitive/fmul (primitive/load zi) (primitive/load zi))]
          (if (primitive/fcmp-gt (primitive/fadd zr2 zi2) 4.0) (break (primitive/load k))
            (let [nzr (primitive/fadd (primitive/fsub zr2 zi2) re)
                  nzi (primitive/fadd (primitive/fmul 2.0 (primitive/fmul (primitive/load zr) (primitive/load zi))) im)]
              (do (primitive/store! zr nzr) (primitive/store! zi nzi)
                  (primitive/store! k (primitive/iadd (primitive/load k) 1))))))))))

; render the current view into an RGBA framebuffer (malloc'd, MW*MH*4 bytes)
(defn mandel-render [(v (ptr MView)) (buf (ptr u8))] (-> i64)
  (let [scale (primitive/load (primitive/field v scale))
        left (primitive/fsub (primitive/load (primitive/field v cx)) (primitive/fdiv scale 2.0))
        aspect (primitive/fdiv (primitive/cast f64 MH) (primitive/cast f64 MW))
        top  (primitive/fsub (primitive/load (primitive/field v cy)) (primitive/fdiv (primitive/fmul scale aspect) 2.0))
        step (primitive/fdiv scale (primitive/cast f64 MW))
        iters (primitive/load (primitive/field v iters))
        (mut y) 0]
    (loop (if (primitive/icmp-ge (primitive/load y) MH) (break)
      (do (let [im (primitive/fadd top (primitive/fmul (primitive/cast f64 (primitive/load y)) step)) (mut x) 0]
            (loop (if (primitive/icmp-ge (primitive/load x) MW) (break)
              (do (let [re (primitive/fadd left (primitive/fmul (primitive/cast f64 (primitive/load x)) step))
                        k (mandel-iter re im iters)
                        o (primitive/imul (primitive/iadd (primitive/imul (primitive/load y) MW) (primitive/load x)) 4)]
                    (if (primitive/icmp-ge k iters)
                        (do (primitive/store! (primitive/index buf o) (primitive/cast u8 0))
                            (primitive/store! (primitive/index buf (primitive/iadd o 1)) (primitive/cast u8 0))
                            (primitive/store! (primitive/index buf (primitive/iadd o 2)) (primitive/cast u8 0)) 0)
                      (let [t (primitive/udiv (primitive/imul k 255) iters)
                            r (let [rr (primitive/imul t 3)] (if (primitive/icmp-gt rr 255) 255 rr))
                            g t
                            b (primitive/isub 255 t)]
                        (do (primitive/store! (primitive/index buf o) (primitive/cast u8 r))
                            (primitive/store! (primitive/index buf (primitive/iadd o 1)) (primitive/cast u8 g))
                            (primitive/store! (primitive/index buf (primitive/iadd o 2)) (primitive/cast u8 b)) 0))))
                  (primitive/store! (primitive/index buf (primitive/iadd (primitive/imul (primitive/iadd (primitive/imul (primitive/load y) MW) (primitive/load x)) 4) 3)) (primitive/cast u8 255))
                  (primitive/store! x (primitive/iadd (primitive/load x) 1))))))
          (primitive/store! y (primitive/iadd (primitive/load y) 1)))))
    0))

(defn mandel-blit [(layer (ptr i8)) (buf (ptr u8))] (-> i64)
  (let [space (CGColorSpaceCreateDeviceRGB)
        ctx (CGBitmapContextCreate (primitive/cast (ptr i8) buf) MW MH 8 (primitive/imul MW 4) space 1)
        img (CGBitmapContextCreateImage ctx)]
    (msg (ptr i8) layer (msel c"setContents:") [(ptr i8)] img)
    (CGImageRelease img) (CGContextRelease ctx) (CGColorSpaceRelease space)
    0))

; keyDown handling: WASD pan, Z/X zoom, I/O iteration budget, Q or RETURN done
(defn mandel-key [(v (ptr MView)) (ev (ptr i8))] (-> i64)
  (let [chars (msg (ptr i8) ev (msel c"characters") [])]
    (if (primitive/icmp-eq (primitive/cast i64 chars) 0) 0
      (let [utf (msg (ptr i8) chars (msel c"UTF8String") [])
            ch (primitive/cast i64 (primitive/load (primitive/cast (ptr u8) utf)))
            pan (primitive/fdiv (primitive/load (primitive/field v scale)) 8.0)]
        (cond
          (primitive/icmp-eq ch 97)  (do (primitive/store! (primitive/field v cx) (primitive/fsub (primitive/load (primitive/field v cx)) pan)) 0)   ; a
          (primitive/icmp-eq ch 100) (do (primitive/store! (primitive/field v cx) (primitive/fadd (primitive/load (primitive/field v cx)) pan)) 0)   ; d
          (primitive/icmp-eq ch 119) (do (primitive/store! (primitive/field v cy) (primitive/fsub (primitive/load (primitive/field v cy)) pan)) 0)   ; w
          (primitive/icmp-eq ch 115) (do (primitive/store! (primitive/field v cy) (primitive/fadd (primitive/load (primitive/field v cy)) pan)) 0)   ; s
          (primitive/icmp-eq ch 122) (do (primitive/store! (primitive/field v scale) (primitive/fmul (primitive/load (primitive/field v scale)) 0.7)) 0) ; z
          (primitive/icmp-eq ch 120) (do (primitive/store! (primitive/field v scale) (primitive/fmul (primitive/load (primitive/field v scale)) 1.4)) 0) ; x
          (primitive/icmp-eq ch 105) (do (primitive/store! (primitive/field v iters) (primitive/iadd (primitive/load (primitive/field v iters)) 32)) 0)  ; i
          (primitive/icmp-eq ch 111) (if (primitive/icmp-gt (primitive/load (primitive/field v iters)) 48)
                               (do (primitive/store! (primitive/field v iters) (primitive/isub (primitive/load (primitive/field v iters)) 32)) 0) 0) ; o
          (primitive/icmp-eq ch 113) (do (primitive/store! (primitive/field v done) 1) 0)   ; q
          (primitive/icmp-eq ch 13)  (do (primitive/store! (primitive/field v done) 1) 0)   ; return
          0)))))

(defn mandel-pump [(app (ptr i8)) (v (ptr MView)) (mode (ptr i8))] (-> i64)
  (while 1
    (let [ev (msg (ptr i8) app (msel c"nextEventMatchingMask:untilDate:inMode:dequeue:")
                  [i64 (ptr i8) (ptr i8) i64] -1 (primitive/cast (ptr i8) 0) mode 1)]
      (if (primitive/icmp-eq (primitive/cast i64 ev) 0) (break 0)
        (do (when (primitive/icmp-eq (msg i64 ev (msel c"type") []) 10) (mandel-key v ev))
            (msg (ptr i8) app (msel c"sendEvent:") [(ptr i8)] ev)
            0)))))

; ---- THE METAPROGRAM: a GUI session at expansion time -------------------------
(defn mandel-pick [] (-> Code)
  (let [a (malloc-allocator)
        auto (primitive/icmp-ne (primitive/cast i64 (getenv c"COIL_MANDEL_AUTO")) 0)
        v (unwrap-ptr [MView] (create [MView] a))
        buf (primitive/cast (ptr u8) (unwrap-ptr [i8] (raw-alloc a (primitive/imul (primitive/imul MW MH) 4) 1)))
        app (msg (ptr i8) (mcls c"NSApplication") (msel c"sharedApplication") [])
        rect (alloc/stack CGRect)]
    (primitive/store! (primitive/field v cx) -0.6) (primitive/store! (primitive/field v cy) 0.0)
    (primitive/store! (primitive/field v scale) 3.2) (primitive/store! (primitive/field v iters) 96) (primitive/store! (primitive/field v done) 0)
    (primitive/store! (primitive/field rect x) 240.0) (primitive/store! (primitive/field rect y) 240.0)
    (primitive/store! (primitive/field rect w) (primitive/cast f64 MW)) (primitive/store! (primitive/field rect h) (primitive/cast f64 MH))
    (fmt (stderr) "[mandelbrot] compile-time viewer{s}: WASD pan, Z/X zoom, I/O iters, Q/RETURN accept\n"
         (if auto " (auto)" ""))
    (let [win (msg (ptr i8) (msg (ptr i8) (mcls c"NSWindow") (msel c"alloc") [])
                     (msel c"initWithContentRect:styleMask:backing:defer:")
                     [CGRect i64 i64 i64] (primitive/load rect) 15 2 0)
          mode (msg (ptr i8) (mcls c"NSString") (msel c"stringWithUTF8String:") [(ptr i8)] c"kCFRunLoopDefaultMode")]
      ; auto mode: accessory policy, no focus steal; interactive: regular + activate
      (msg (ptr i8) app (msel c"setActivationPolicy:") [i64] (if auto 1 0))
      (msg (ptr i8) (msg (ptr i8) win (msel c"contentView") []) (msel c"setWantsLayer:") [i64] 1)
      (msg (ptr i8) win (msel c"makeKeyAndOrderFront:") [(ptr i8)] (primitive/cast (ptr i8) 0))
      (when (not auto) (do (msg (ptr i8) app (msel c"activateIgnoringOtherApps:") [i64] 1) 0))
      (msg (ptr i8) app (msel c"finishLaunching") [])
      (let [layer (msg (ptr i8) (msg (ptr i8) win (msel c"contentView") []) (msel c"layer") [])
            (mut frame) 0]
        (while (primitive/icmp-eq (primitive/load (primitive/field v done)) 0)
          (mandel-render v buf)
          (mandel-blit layer buf)
          (mandel-pump app v mode)
          (when auto
            ; a scripted dive toward the seahorse valley, then accept
            (do (primitive/store! (primitive/field v cx) (primitive/fadd (primitive/load (primitive/field v cx)) (primitive/fmul (primitive/fsub -0.7436 (primitive/load (primitive/field v cx))) 0.18)))
                (primitive/store! (primitive/field v cy) (primitive/fadd (primitive/load (primitive/field v cy)) (primitive/fmul (primitive/fsub 0.1318 (primitive/load (primitive/field v cy))) 0.18)))
                (primitive/store! (primitive/field v scale) (primitive/fmul (primitive/load (primitive/field v scale)) 0.86))
                (when (primitive/icmp-ge (primitive/load frame) 40) (primitive/store! (primitive/field v done) 1))))
          (primitive/store! frame (primitive/iadd (primitive/load frame) 1))
          (usleep 16000))
        (msg (ptr i8) win (msel c"close") [])
        (fmt (stderr) "[mandelbrot] accepted view: center=({f}, {f}) scale={f} iters={d} after {d} frames\n"
             (primitive/load (primitive/field v cx)) (primitive/load (primitive/field v cy)) (primitive/load (primitive/field v scale)) (primitive/load (primitive/field v iters)) (primitive/load frame))
        `(mandel-chosen ~(primitive/load (primitive/field v cx)) ~(primitive/load (primitive/field v cy)) ~(primitive/load (primitive/field v scale)) ~(primitive/load (primitive/field v iters)))))))

; ---- the RUNTIME half: what the chosen constants compile into ------------------
; ASCII-render the compile-time-chosen view, so the built program carries the
; GUI session's result visibly.
(defn mandel-chosen [(cx f64) (cy f64) (scale f64) (iters i64)] (-> i64)
  (let [w 78 h 24
        left (primitive/fsub cx (primitive/fdiv scale 2.0))
        top (primitive/fsub cy (primitive/fdiv (primitive/fmul scale 0.66) 2.0))
        xstep (primitive/fdiv scale (primitive/cast f64 w))
        ystep (primitive/fdiv (primitive/fmul scale 0.66) (primitive/cast f64 h))
        ramp " .:-=+*#%@"
        (mut y) 0]
    (fmt (stdout) "view chosen in the COMPILE-TIME GUI: center=({f}, {f}) scale={f} iters={d}\n"
         cx cy scale iters)
    (loop (if (primitive/icmp-ge (primitive/load y) h) (break)
      (do (let [(mut x) 0]
            (loop (if (primitive/icmp-ge (primitive/load x) w) (break)
              (do (let [re (primitive/fadd left (primitive/fmul (primitive/cast f64 (primitive/load x)) xstep))
                        im (primitive/fadd top (primitive/fmul (primitive/cast f64 (primitive/load y)) ystep))
                        k (mandel-iter re im iters)
                        ci (if (primitive/icmp-ge k iters) 9 (primitive/udiv (primitive/imul k 9) iters))]
                    (write-byte (stdout) (slice-get ramp ci)))
                  (primitive/store! x (primitive/iadd (primitive/load x) 1))))))
          (write-byte (stdout) (primitive/cast u8 10))
          (primitive/store! y (primitive/iadd (primitive/load y) 1)))))
    0))
