(module mhost)
(import "primitive.coil" :as primitive)
(import "alloc.coil" :use *)
(import "arraylist.coil" :use *)
(import "slice.coil" :use *)
(import "io.coil"  :use *)
(import "fmt.coil" :use *)
(import "result.coil" :use *)
(import "src/compiler/reader.coil" :use *)

(extern dlopen :cc c [(ptr i8) :i64] (-> (ptr i8)))
(extern dlsym  :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(defn mk-cstr [(a (ptr Allocator)) (s (slice u8))] (-> (ptr i8))
  (let [n (slice-len s)
        buf (unwrap-ptr [i8] (raw-alloc a (primitive/iadd n 1) 1))
        (mut i) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
      (do (primitive/store! (primitive/index buf (primitive/load i)) (primitive/cast i8 (slice-get s (primitive/load i))))
          (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
    (primitive/store! (primitive/index buf n) (primitive/cast i8 0))
    buf))

(defn main [] (-> :i64)
  (let [al (malloc-allocator)]
    ; build a REAL Sexp with the compiler's real reader
    (match (read-all al "(a b c d e)" 0)
      (Err [d] (do (fmt (stdout) "read failed\n") 1))
      (Ok [forms]
        (let [sp (unwrap-ptr [Sexp] (create [Sexp] al))
              h  (dlopen (mk-cstr al "meta.dylib") 2)]
          (primitive/store! sp (al-get [Sexp] (primitive/load forms) 0))
          (if (primitive/icmp-eq (primitive/cast :i64 h) 0)
              (do (fmt (stdout) "dlopen FAILED\n") 1)
            (let [f (dlsym h (mk-cstr al "meta_count"))]
              (if (primitive/icmp-eq (primitive/cast :i64 f) 0)
                  (do (fmt (stdout) "dlsym FAILED\n") 1)
                (do (fmt (stdout) "metaprogram walked (a b c d e) -> {d} children (expect 5)\n"
                         (primitive/call-ptr (primitive/cast (fnptr c [(ptr Sexp)] :i64) f) sp))
                    0)))))))))
