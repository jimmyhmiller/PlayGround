(module tower_test)
(import "primitive.coil" :as primitive)
(import "src/stdlib/control.coil" :use *)
; MACROS IN A MACRO BODY (the tower):
; - `when` as a statement (both branches i64)
; - `cond` in Code-tail position (all branches Code)
; - a Code->Code helper called WITH a Code argument stays a FUNCTION call
(defn wrap2 [(c Code)] (-> Code) `(do ~c ~c))
(defn dbl [(c Code)] (-> Code)
  (let [(mut n) 0]
    (when (primitive/code-int? c) (primitive/store! n (primitive/code-int c)))
    `~(primitive/imul (primitive/load n) 2)))
(defn pick [(c Code)] (-> Code)
  (cond
    (primitive/code-int? c) (wrap2 `1)
    (primitive/code-sym? c) `2
    `3))
(defn main [] (-> :i64)
  ; dbl 21 -> 42 ; pick 9 -> (do 1 1) -> 1 ; pick foo -> 2
  (primitive/iadd (dbl 21) (primitive/iadd (pick 9) (pick foo))))
