(module borrowlike)
(import "primitive.coil" :as primitive)
; A use-after-free / move checker keyed on BINDING IDENTITY, not names. The
; dataflow state is a real HashMap from binding-id -> killed?, threaded through a
; recursive walk of the CHECKED program. `(primitive/binding-of NODE)` gives each reference
; the id of the exact let-binding/parameter it resolves to, so a SHADOWED local is
; a DIFFERENT binding than its outer namesake — which name-matching cannot tell
; apart. `(my-free X)` kills X's binding; any later reference to that same binding
; is reported. Runs as a compiled checker (arbitrary code + collections + the
; binding oracle) — the shape a real borrow checker takes.
(import "src/stdlib/alloc.coil" :use *)
(import "src/stdlib/hashmap.coil" :use *)
(import "src/stdlib/control.coil" :use *)

; walk a form; `killed` maps binding-id -> 1 for freed locals
(defn bc-scan [(form Code) (killed (ptr (HashMap i64 i64)))] (-> i64)
  (if (not (primitive/code-list? form)) 0
    (let [n (primitive/code-count form)]
      (if (and (= n 2)
           (and (primitive/code-sym? (primitive/code-nth form 0))
            (and (primitive/code-eq (primitive/code-nth form 0) `my-free) (primitive/code-sym? (primitive/code-nth form 1)))))
          ; (my-free X): kill X's BINDING (0 = not a local -> ignore)
          (let [bid (primitive/binding-of (primitive/code-nth form 1))]
            (if (> bid 0) (do (hm-put! killed bid 1) 0) 0))
        ; otherwise: flag any argument referencing a killed binding, then recurse
        (do
          (for [i 0 n]
            (let [c (primitive/code-nth form i)]
              (if (and (> i 0) (primitive/code-sym? c))
                  (let [bid (primitive/binding-of c)]
                    (if (> bid 0)
                        (match (hm-get [i64 i64] (primitive/load killed) bid)
                          (Some [v] (do (primitive/report c "use after my-free") 0))
                          (None [] 0))
                      0))
                (bc-scan c killed))))
          0)))))

(defn bc-body [(f Code)] (-> Code)
  (if (and (primitive/code-list? f) (>= (primitive/code-count f) 5))
      (if (and (primitive/code-sym? (primitive/code-nth f 0)) (primitive/code-eq (primitive/code-nth f 0) `defn))
          (let [(mut killed) (hm-new-scalar [i64 i64] (malloc-allocator)) n (primitive/code-count f)]
            (for [i 4 n] (bc-scan (primitive/code-nth f i) (mut killed)))
            `0)
        `0)
    `0))

(defn bc-check [(mods Code)] (-> Code)
  (let [nm (primitive/code-count mods)]
    (for [i 0 nm]
      (let [m (primitive/code-nth mods i) nf (primitive/code-count m)]
        (if (primitive/code-from-user? (primitive/code-nth m 1))
            (for [j 1 nf] (bc-body (primitive/code-nth m j)))
          0))))
  `0)
(checker bc-check)
