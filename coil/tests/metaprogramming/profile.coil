(module profile)
(import "primitive.coil" :as primitive)
; AUTO-PROFILER — a whole-program TRANSFORM that instruments every user function with
; entry/exit timing, plus a tiny runtime that accumulates per-function totals and prints
; a report when `main` returns. Zero source edits: turn it on with
;
;   coil run app.coil --use profile.coil
;
; and off by not passing it. Each user `(defn f …)` body B is rewritten to
;
;   (let [__prof_t0__ (prof-now)]
;     (let [__prof_r__ (do B)]
;       (prof-record "f" (primitive/isub (prof-now) __prof_t0__))
;       __prof_r__))                       ; + (prof-report) injected before main returns
;
; The function name is baked in as a string literal via `code-str` (spliced as a value).
; The rewrite is IDEMPOTENT (transforms run to a fixpoint) — an already-wrapped body is
; recognized by its `__prof_t0__` binding and left alone.
(import "arraylist.coil" :use *)
(import "alloc.coil" :as alloc :use *)
(import "str.coil" :use *)
(import "io.coil" :use *)
(import "fmt.coil" :use *)

; ---- timing runtime ---------------------------------------------------------
(defstruct Timespec [(sec i64) (nsec i64)])
(extern clock_gettime :cc c [i32 (ptr Timespec)] (-> i32))
(defn prof-now [] (-> i64)   ; monotonic nanoseconds (CLOCK_MONOTONIC = 6 on macOS)
  (let [ts (alloc/stack Timespec)]
    (clock_gettime 6 ts)
    (primitive/iadd (primitive/imul (primitive/load (primitive/field ts sec)) 1000000000) (primitive/load (primitive/field ts nsec)))))

; ---- accumulator table (one global cell, lazily initialized) ----------------
(defstruct ProfEntry [(name (slice u8)) (total i64) (count i64)])
(defstruct ProfTable [(entries (ArrayList ProfEntry)) (inited i64)])
(defn prof-table [] (-> (ptr ProfTable)) (alloc/static ProfTable))
(defn prof-ensure [] (-> i64)
  (let [t (prof-table)]
    (if (primitive/icmp-eq (primitive/load (primitive/field t inited)) 0)
        (do (primitive/store! (primitive/field t entries) (al-new [ProfEntry] (malloc-allocator)))
            (primitive/store! (primitive/field t inited) 1) 0)
      0)))
(defn prof-record [(name (slice u8)) (nanos i64)] (-> i64)
  (do (prof-ensure)
    (let [t (prof-table) n (al-len [ProfEntry] (primitive/load (primitive/field t entries))) (mut i) 0 (mut found) -1]
      (loop (if (if (primitive/icmp-ge (primitive/load i) n) true (primitive/icmp-ge (primitive/load found) 0)) (break)
        (do (let [ev (alloc/stack ProfEntry)]
              (primitive/store! ev (al-get [ProfEntry] (primitive/load (primitive/field t entries)) (primitive/load i)))
              (if (str-eq (primitive/load (primitive/field ev name)) name) (do (primitive/store! found (primitive/load i)) 0) 0))
            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      (if (primitive/icmp-ge (primitive/load found) 0)
          (let [ev (alloc/stack ProfEntry)]
            (primitive/store! ev (al-get [ProfEntry] (primitive/load (primitive/field t entries)) (primitive/load found)))
            (primitive/store! (primitive/field ev total) (primitive/iadd (primitive/load (primitive/field ev total)) nanos))
            (primitive/store! (primitive/field ev count) (primitive/iadd (primitive/load (primitive/field ev count)) 1))
            (al-set! [ProfEntry] (mut (primitive/field t entries)) (primitive/load found) (primitive/load ev)) 0)
        (let [ev (alloc/stack ProfEntry)]
          (primitive/store! (primitive/field ev name) name) (primitive/store! (primitive/field ev total) nanos) (primitive/store! (primitive/field ev count) 1)
          (al-push! [ProfEntry] (mut (primitive/field t entries)) (primitive/load ev)) 0)))))
(defn prof-report [] (-> i64)
  (do (prof-ensure)
    (let [t (prof-table) n (al-len [ProfEntry] (primitive/load (primitive/field t entries))) w (stderr) (mut i) 0]
      (fmt w "\n=== profile: function / calls / total ns / avg ns ===\n")
      (loop (if (primitive/icmp-ge (primitive/load i) n) (break)
        (do (let [ev (alloc/stack ProfEntry)]
              (primitive/store! ev (al-get [ProfEntry] (primitive/load (primitive/field t entries)) (primitive/load i)))
              (let [c (primitive/load (primitive/field ev count)) tot (primitive/load (primitive/field ev total))]
                (fmt w "  {s}  calls={d}  total={d}ns  avg={d}ns\n"
                     (primitive/load (primitive/field ev name)) c tot (if (primitive/icmp-gt c 0) (primitive/idiv tot c) 0))))
            (primitive/store! i (primitive/iadd (primitive/load i) 1)))))
      0)))

; ---- the transform ----------------------------------------------------------
(defn is-defn? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (primitive/icmp-ge (primitive/code-count f) 5)
            (and (primitive/code-sym? (primitive/code-nth f 0)) (primitive/code-eq (primitive/code-nth f 0) `defn)))))

; body forms of a defn as a Code list (indices 4..)
(defn forms-from [(f Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `() `(~(primitive/code-nth f i) ~@(forms-from f (primitive/iadd i 1) n))))

; already wrapped? body[0] is a `let` whose first binding symbol is __prof_t0__
(defn already-wrapped? [(f Code)] (-> bool)
  (let [b (primitive/code-nth f 4)]
    (if (and (primitive/code-list? b) (and (primitive/icmp-gt (primitive/code-count b) 1) (primitive/code-eq (primitive/code-nth b 0) `let)))
        (let [bv (primitive/code-nth b 1)]
          (and (primitive/code-list? bv) (and (primitive/icmp-gt (primitive/code-count bv) 0)
               (primitive/code-eq (primitive/code-nth bv 0) `__prof_t0__))))
      false)))

; skip comptime functions (a Code return — macros/generators/checkers/transforms)
(defn skip-defn? [(f Code)] (-> bool)
  (let [ret (primitive/code-nth (primitive/code-nth f 3) 1)]
    (primitive/code-eq ret `Code)))

(defn wrap-defn [(f Code)] (-> Code)
  (let [name (primitive/code-nth f 1) params (primitive/code-nth f 2) arrow (primitive/code-nth f 3)
        nm (primitive/code-str name)
        body (forms-from f 4 (primitive/code-count f))
        rep (if (primitive/code-eq name `main) `((prof-report)) `())]
    `(defn ~name ~params ~arrow
       (let [__prof_t0__ (prof-now)]
         (let [__prof_r__ (do ~@body)]
           (prof-record ~nm (primitive/isub (prof-now) __prof_t0__))
           ~@rep
           __prof_r__)))))

(defn prof-form [(f Code)] (-> Code)
  (if (is-defn? f)
      (if (if (already-wrapped? f) true (skip-defn? f)) f (wrap-defn f))
    f))
(defn prof-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `() `(~(prof-form (primitive/code-nth m i)) ~@(prof-forms m (primitive/iadd i 1) n))))

; process a module iff it is user code and NOT this runtime module
(defn process-mod? [(m Code)] (-> bool)
  (if (primitive/icmp-gt (primitive/code-count m) 1)
      (if (primitive/code-eq (primitive/code-nth m 0) `profile) false (primitive/code-from-user? (primitive/code-nth m 1)))
    false))
(defn prof-mod [(m Code)] (-> Code)
  (if (process-mod? m) `(~(primitive/code-nth m 0) ~@(prof-forms m 1 (primitive/code-count m))) m))
(defn prof-mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `() `(~(prof-mod (primitive/code-nth ms i)) ~@(prof-mods ms (primitive/iadd i 1) n))))
(defn prof-transform [(mods Code)] (-> Code)
  `(do ~@(prof-mods mods 0 (primitive/code-count mods))))
(transform prof-transform)
