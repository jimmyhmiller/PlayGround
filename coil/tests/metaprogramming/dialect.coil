(module dialect)
(import "primitive.coil" :as primitive)
; does form `f` contain an (inc …) call anywhere?
(defn has-inc? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (and (primitive/icmp-gt (primitive/code-count f) 0) (primitive/code-eq (primitive/code-nth f 0) `inc)) true
        (has-inc-kids? f 0 (primitive/code-count f)))
    false))
(defn has-inc-kids? [(f Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n) false
    (if (has-inc? (primitive/code-nth f i)) true (has-inc-kids? f (primitive/iadd i 1) n))))
; rewrite (inc E) -> (primitive/iadd E 1); leave inc-free forms UNTOUCHED (preserve structure)
(defn rewrite [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (and (primitive/icmp-gt (primitive/code-count f) 0) (primitive/code-eq (primitive/code-nth f 0) `inc))
          `(primitive/iadd ~(rewrite (primitive/code-nth f 1)) 1)
        (if (has-inc? f) `(~@(rewrite-kids f 0 (primitive/code-count f))) f))
    f))
(defn rewrite-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    `(~(rewrite (primitive/code-nth f i)) ~@(rewrite-kids f (primitive/iadd i 1) n))))
; the transformer is MODULE-SHAPED: it receives ((name form…) …) and returns the
; same shape. Rewrite each module's forms (indices 1.. ; index 0 is the name).
(defn desugar-mod [(m Code)] (-> Code)
  `(~(primitive/code-nth m 0) ~@(rewrite-kids m 1 (primitive/code-count m))))
(defn desugar-mods [(mods Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    `(~(desugar-mod (primitive/code-nth mods i)) ~@(desugar-mods mods (primitive/iadd i 1) n))))
(defn desugar-inc [(mods Code)] (-> Code)
  `(do ~@(desugar-mods mods 0 (primitive/code-count mods))))
