(module sigcheck)
(import "primitive.coil" :as primitive)
; A SEMANTIC checker that reads the compiler's AUTHORITATIVE work. It runs after the
; whole program is resolved + typechecked, so `(primitive/code-decl HEAD)` returns the real
; declaration — the module a name lives in and its real signature
; `(decl MODULE fn [param-types] ret-type)` — straight from the checked program, not
; a parallel resolver.
;
; Policy: a call may not target a function whose declared RETURN TYPE is a raw
; pointer `(ptr …)`. This is perfectly type-correct Coil; the checker adds a policy
; ON TOP of a valid program, using the callee's real signature (incl. across module
; boundaries). This is the "does the metaprogram know where it lives / its type?"
; question — now answered from finished work.

; A `(primitive/code-decl …)` fn record: (decl MOD fn [T…] RET). RET is index 4.
(defn is-fn-decl? [(d Code)] (-> bool)
  (and (primitive/code-list? d) (and (primitive/icmp-ge (primitive/code-count d) 5) (primitive/code-eq (primitive/code-nth d 2) `fn))))
(defn ret-is-ptr? [(d Code)] (-> bool)
  (let [ret (primitive/code-nth d 4)]
    (and (primitive/code-list? ret) (and (primitive/icmp-gt (primitive/code-count ret) 0) (primitive/code-eq (primitive/code-nth ret 0) `ptr)))))

(defn check-node [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (primitive/icmp-gt (primitive/code-count f) 0)
          (do (if (primitive/code-sym? (primitive/code-nth f 0))
                  ; pass the CALL node itself — code-decl resolves it to the EXACT
                  ; callee via node identity (unambiguous even across modules).
                  (let [d (primitive/code-decl f)]
                    (if (and (is-fn-decl? d) (ret-is-ptr? d))
                        (do (primitive/report f "policy: call targets a function that returns a raw pointer — banned by this dialect") 0)
                      0))
                0)
              (check-kids f 0 (primitive/code-count f)))
        `0)
    `0))
(defn check-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0 (do (check-node (primitive/code-nth f i)) (check-kids f (primitive/iadd i 1) n))))

; A module is `(name form…)`; only inspect USER modules.
(defn look-at? [(m Code)] (-> bool)
  (if (primitive/icmp-gt (primitive/code-count m) 1) (primitive/code-from-user? (primitive/code-nth m 1)) false))
(defn check-forms [(m Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0 (do (check-node (primitive/code-nth m i)) (check-forms m (primitive/iadd i 1) n))))
(defn check-mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `0
    (do (let [m (primitive/code-nth ms i)] (if (look-at? m) (check-forms m 1 (primitive/code-count m)) `0))
        (check-mods ms (primitive/iadd i 1) n))))
(defn check-sigs [(modules Code)] (-> Code) (check-mods modules 0 (primitive/code-count modules)))
