(module p8)
(import "derive.coil" :use *)
(import "io.coil" :use *)
(import "fmt.coil" :use *)
(defstruct Val [(kinds i64) (ilo i64)])
(derive-eq Val)
(defsum Ty (TBot) (TVal [(v Val)]))
(defn val-make [(k i64) (lo i64)] (-> Val)
  (let [(mut v) (zeroed Val)] (store! (field v kinds) k) (store! (field v ilo) lo) (load v)))
(defn ty-same [(a Ty) (b Ty)] (-> bool)
  (match a
    (TBot [] (match b (TBot [] true) (TVal [x] false)))
    (TVal [va] (match b (TBot [] false) (TVal [vb] (Val-eq va vb))))))
(impl Eq Ty (= [(a Ty) (b Ty)] (-> bool) (ty-same a b)))
(defn main [] (-> i64)
  (fmt (stdout) "eq={d}\n" (if (= (TVal (val-make 1 2)) (TVal (val-make 1 2))) 1 0))
  0)
