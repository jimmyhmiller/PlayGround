(module pb)
(import "io.coil" :use *)
(import "fmt.coil" :use *)
(defstruct Other [(z i64)])
(defn helper [(a i64) (b i64)] (-> bool) (icmp-eq a b))
(impl Eq Other (= [(a Other) (b Other)] (-> bool) (helper (load (field a z)) (load (field b z)))))
(defn main [] (-> i64) (fmt (stdout) "ok={d}\n" (if (= (zeroed Other) (zeroed Other)) 1 0)) 0)
