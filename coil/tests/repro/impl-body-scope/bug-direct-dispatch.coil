(module pa)
(import "primitive.coil" :as primitive)
(import "derive.coil" :use *)
(import "io.coil" :use *)
(import "fmt.coil" :use *)
(defstruct Val [(kinds i64)])
(derive-eq Val)
(defstruct Other [(v Val)])
(impl Eq Other (= [(a Other) (b Other)] (-> bool) (= (primitive/load (primitive/field a v)) (primitive/load (primitive/field b v)))))
(defn main [] (-> i64) (fmt (stdout) "ok\n") 0)
