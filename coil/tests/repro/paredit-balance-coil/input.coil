(module paredit-balance-repro)
(import "primitive.coil" :as primitive)

; The first form has one missing `)` on the `(loop ...)`. The intended repair is
; local: add one close after the loop body, before `(primitive/load found)`.
(defn locally-broken [(n i64)] (-> i64)
  (let [(mut i) 0
        (mut found) 0]
    (loop (if (primitive/icmp-ge (primitive/load i) n)
              (break)
              (do
                (when (primitive/icmp-eq (primitive/load i) 2)
                      (primitive/store! found 1)
                      (break))
                (primitive/store! i (primitive/iadd (primitive/load i) 1))))
    (primitive/load found)))

; This following form is already balanced. Its indentation is normal Coil style:
; a multiline cond predicate followed by its result expression. `balance` must
; leave it byte-for-byte unchanged.
(defn already-valid [(decl i64) (actual i64)] (-> i64)
  (cond (and (and (primitive/icmp-eq decl 5) (primitive/icmp-eq actual 4))
             (not (and (primitive/icmp-eq decl 6)
                       (primitive/icmp-eq actual 7))))
          (primitive/iadd decl actual)
        (and (and (primitive/icmp-eq decl 11) (primitive/icmp-eq actual 11))
             (and (primitive/icmp-eq decl actual)
                  (primitive/icmp-eq (primitive/iadd decl 1)
                           (primitive/iadd actual 1))))
          (primitive/isub decl actual)
        :else 0))
