(module http-client-integration)
(import "primitive.coil" :as primitive)
(import "http_client.coil" :as http)
(import "alloc.coil" :as alloc)
(import "slice.coil" :as slice)
(import "str.coil" :as str)

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        req (alloc/stack http/Request)]
    (primitive/store! (primitive/field req method) "POST")
    (primitive/store! (primitive/field req url) "http://127.0.0.1:38473/echo")
    (primitive/store! (primitive/field req headers) (slice/slice-new [http/Header] (primitive/cast (ptr http/Header) 0) 0))
    (primitive/store! (primitive/field req body) "coil-body")
    (primitive/store! (primitive/field req connect-timeout-ms) 1000)
    (primitive/store! (primitive/field req timeout-ms) 3000)
    (primitive/store! (primitive/field req follow-redirects) false)
    (match (http/request a req)
      (Err [e] 10)
      (Ok [response]
          (let [ok
                  (and (primitive/icmp-eq (http/response-status response) 418)
                       (and (str/str-eq (http/response-body response) "coil-body")
                            (primitive/icmp-ge (http/response-header-count response) 6)))]
            (http/response-free a response)
            (if (not ok)
                11
                (do
                  (primitive/store! (primitive/field req url) "http://127.0.0.1:1/unreachable")
                  (primitive/store! (primitive/field req body) "")
                  (match (http/request a req)
                    (Err [e] 0)
                    (Ok [unexpected]
                        (do (http/response-free a unexpected) 12))))))))))
