; lib/fs.coil — the filesystem library, exercised end to end.
;
; This file exists because fs.coil silently rotted: nothing in the tree imported
; it, so for a while it did not even COMPILE (its file-reader/file-writer called
; io.coil's fd-reader/fd-writer with the pre-`alloc-static`-fix arity), and once
; that was fixed it still did not WORK on Linux, because its open() flags were
; hardcoded to the darwin values — 512 is O_CREAT on macOS but O_TRUNC on Linux,
; so every create-or-truncate open failed. A compile check would have caught the
; first bug and not the second, so this runs the library for real. (The flags now
; select on `(target-os)` at comptime, so they stay literals and are right under
; cross-compilation too.)
;
; The paths below are unlinked FIRST, so every check exercises the create path.
; That matters: with the old darwin-only flags, 512|1024 happens to decode on
; Linux as O_TRUNC|O_APPEND, which opens and truncates an EXISTING file just
; fine — so a test that reuses files left behind by an earlier run passes even
; with the bug present. Only creating from nothing shows the missing O_CREAT.
;
; Exit 0 on success, else the number of the first failing check.
(module fslib)

(import "alloc.coil" :use *)
(import "io.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "result.coil" :use *)
(import "control.coil" :use *)
(import "match.coil" :use *)
(import "fs.coil" :use *)

(defn note! [(fb (ptr i64)) (n i64) (ok bool)] (-> i64)
  (unless ok
          (print-str (stderr) "fs: check ")
          (print-int (stderr) n)
          (print-str (stderr) " FAILED\n")
          (when (icmp-eq (load fb) 0) (store! fb n) 0)
          0)
  0)

(extern unlink :cc c [(ptr i8)] (-> i32))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        w (stdout)
        fb (alloc-stack i64)]
    (store! fb 0)
    ; start from nothing, so every open below must really create.
    (unlink (str->cstr a "/tmp/coil_fs_gate_a.txt"))
    (unlink (str->cstr a "/tmp/coil_fs_gate_b.txt"))
    (unlink (str->cstr a "/tmp/coil_fs_gate_c1.txt"))
    (unlink (str->cstr a "/tmp/coil_fs_gate_c2.txt"))
    (unlink (str->cstr a "/tmp/coil_fs_gate_t.txt"))
    (unlink (str->cstr a "/tmp/coil_fs_gate_e.txt"))
    (unlink (str->cstr a "/tmp/coil_fs_gate_big.txt"))

    ; ---- 1-2. write-file / read-file round trip
    (match (write-file a "/tmp/coil_fs_gate_a.txt" "hello fs\n")
      (Ok [n] (note! fb 1 (icmp-eq n 9)))
      (Err [e] (note! fb 1 false)))
    (match (read-file a "/tmp/coil_fs_gate_a.txt")
      (Ok [s] (note! fb 2 (str-eq s "hello fs\n")))
      (Err [e] (note! fb 2 false)))

    ; ---- 3. a missing file is an Err, not a crash and not an empty Ok
    (match (read-file a "/tmp/coil_fs_gate_missing_zzz.txt")
      (Ok [s] (note! fb 3 false))
      (Err [e] (note! fb 3 true)))

    ; ---- 4-5. the Reader/Writer bridge: stream through file-writer
    (match (file-open (str->cstr a "/tmp/coil_fs_gate_b.txt")
                      (| O_WRONLY (| O_CREAT O_TRUNC)) FILE_MODE_DEFAULT)
      (Ok [f] (let [fp (alloc-stack File)]
                (store! fp f)
                (let [out (file-writer (alloc-stack Writer) fp)]
                  (print-str out "streamed\n")
                  (file-close fp)
                  (note! fb 4 true))))
      (Err [e] (note! fb 4 false)))
    (match (read-file a "/tmp/coil_fs_gate_b.txt")
      (Ok [s] (note! fb 5 (str-eq s "streamed\n")))
      (Err [e] (note! fb 5 false)))

    ; ---- 6-8. TWO files open and streamed at once. This is the case the
    ; caller-owned Reader/Writer design exists for: when fd-reader/fd-writer
    ; handed back a shared static, the second file-writer clobbered the first
    ; and both lines landed on one fd. Interleave the writes so a shared
    ; instance cannot accidentally produce the right answer.
    (match (file-open (str->cstr a "/tmp/coil_fs_gate_c1.txt")
                      (| O_WRONLY (| O_CREAT O_TRUNC)) FILE_MODE_DEFAULT)
      (Ok [f1] (match (file-open (str->cstr a "/tmp/coil_fs_gate_c2.txt")
                                 (| O_WRONLY (| O_CREAT O_TRUNC)) FILE_MODE_DEFAULT)
                 (Ok [f2]
                     (let [p1 (alloc-stack File)
                           p2 (alloc-stack File)]
                       (store! p1 f1)
                       (store! p2 f2)
                       (let [w1 (file-writer (alloc-stack Writer) p1)
                             w2 (file-writer (alloc-stack Writer) p2)]
                         (print-str w1 "one\n")
                         (print-str w2 "two\n")
                         (file-close p1)
                         (file-close p2)
                         (note! fb 6 true))))
                 (Err [e] (note! fb 6 false))))
      (Err [e] (note! fb 6 false)))
    (match (read-file a "/tmp/coil_fs_gate_c1.txt")
      (Ok [s] (note! fb 7 (str-eq s "one\n")))
      (Err [e] (note! fb 7 false)))
    (match (read-file a "/tmp/coil_fs_gate_c2.txt")
      (Ok [s] (note! fb 8 (str-eq s "two\n")))
      (Err [e] (note! fb 8 false)))

    ; ---- 9. truncation: writing a SHORTER payload must not leave a tail of the
    ; longer one behind. This is what O_TRUNC is for, and it is exactly the flag
    ; whose darwin value (1024) means something else on Linux.
    (write-file a "/tmp/coil_fs_gate_t.txt" "aaaaaaaaaaaaaaaa")
    (write-file a "/tmp/coil_fs_gate_t.txt" "bb")
    (match (read-file a "/tmp/coil_fs_gate_t.txt")
      (Ok [s] (note! fb 9 (str-eq s "bb")))
      (Err [e] (note! fb 9 false)))

    ; ---- 10. an empty file round-trips as an empty slice, not an error
    (write-file a "/tmp/coil_fs_gate_e.txt" "")
    (match (read-file a "/tmp/coil_fs_gate_e.txt")
      (Ok [s] (note! fb 10 (icmp-eq (slice-len s) 0)))
      (Err [e] (note! fb 10 false)))

    ; ---- 11. a payload larger than read-file's 4 KiB chunk, so the streaming
    ; loop runs more than once and the ArrayList has to grow.
    (let [(mut sb) (sb-new a)
          (mut i) 0]
      (loop (if (icmp-ge (load i) 5000)
                (break)
                (do (sb-push-byte! (mut sb) (cast u8 120)) (store! i (iadd (load i) 1)))))
      (let [big (sb-str (load sb))]
        (write-file a "/tmp/coil_fs_gate_big.txt" big)
        (match (read-file a "/tmp/coil_fs_gate_big.txt")
          (Ok [s] (note! fb 11 (and (icmp-eq (slice-len s) 5000) (str-eq s big))))
          (Err [e] (note! fb 11 false)))))

    (if (icmp-eq (load fb) 0)
        (do (print-str w "fs: all checks passed\n") 0)
        (load fb))))
