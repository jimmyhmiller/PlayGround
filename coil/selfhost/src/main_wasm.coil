; selfhost/src/main_wasm.coil — self-host Coil compiler ENTRY for the WASM-HOSTED
; build. Identical to main_a64.coil (LLVM-free; native arm64 backend for `build`),
; PLUS it registers the wasm meta path so the compiler can expand macros while itself
; running inside a wasm sandbox: a metaprogram is compiled to a codegen_wasm
; SIDE-MODULE and run by the host (meta_run_wasm) sharing this instance's memory and
; exported mh_* callbacks — instead of dlopen + pthread, which the sandbox forbids.
;
; Build the wasm compiler from THIS file:
;   coil-w64 build selfhost/src/main_wasm.coil --target wasm64-unknown-unknown -o coilc.wasm
; The wasm-only pieces (extern meta_run_wasm, the codegen_wasm import) live here, not
; in metaengine.coil, so the native main.coil / main_a64.coil builds never see them.
(module mainwasm)

(import "alloc.coil" :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ffi.coil" :use *)
(import "reader.coil" :use *)
(import "ast.coil" :use *)
(import "astdump.coil" :use *)
(import "parser.coil" :use *)
(import "loader.coil" :use *)
(import "resolve.coil" :use *)
(import "check.coil" :use *)
(import "mono.coil" :use *)
(import "diag.coil" :use *)
(import "comptime.coil" :use *)
(import "metaengine.coil" :use *)
(import "expander.coil" :use *)
(import "comptime_eval.coil" :use *)
(import "codegen_a64.coil" :use *)
(import "codegen_wasm.coil" :use *)   ; side-module emitter for the wasm meta path
(import "macho.coil" :use *)
(import "driver.coil" :use *)
(import "cimport.coil" :as ci)

; ---- hard-error stubs for the (excluded) LLVM backend ----
(defn no-llvm-build [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (obj-cstr (ptr i8)) (triple (ptr i8)) (path (slice u8))] (-> i64)
  (ps (stderr) "error: this coil was built without the LLVM backend; `build` requires `--backend arm64`\n")
  (abort) 1)
(defn no-llvm-emitir [(a (ptr Allocator)) (src (slice u8)) (cwd (slice u8)) (triple (ptr i8)) (path (slice u8))] (-> i64)
  (ps (stderr) "error: this coil was built without the LLVM backend; `emit-ir` / `dump-ir` are unavailable (no textual LLVM IR without libLLVM)\n")
  (abort) 1)
(defn no-normalize [(a (ptr Allocator)) (src (slice u8))] (-> i64)
  (ps (stderr) "error: this coil was built without the LLVM backend; `__normalize` is unavailable\n")
  (abort) 1)
(defn do-cimport [(a (ptr Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (ci/cimport-cli a argc argv 2))

; the arm64 metaprogram object builder (native meta path; kept so meta-compiled? is
; true and `build --backend arm64` works — the wasm meta path below is preferred at
; runtime whenever it is registered).
(defn meta-build-obj-a64 [(a (ptr Allocator)) (mp (ptr Program)) (obj (ptr i8))] (-> i64)
  (cga64-build-object a mp obj "" ""
                      (box-al [(slice u8)] a (al-new [(slice u8)] a))
                      (box-al [(slice u8)] a (al-new [(slice u8)] a))
                      false))
(defn meta-build-mobj-a64 [(a (ptr Allocator)) (mp (ptr Program))] (-> MObj)
  (cga64-build-mobj a mp "" ""
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    false))

; ---- the wasm meta path ------------------------------------------------------------
; BUILD hook: a mono'd metaprogram Program -> a codegen_wasm side-module (bytes in
; THIS compiler's linear memory). The module imports env.memory + the mh_* callbacks
; and exports each coil_mp_<k> entry.
(defn meta-build-side-wasm [(a (ptr Allocator)) (mp (ptr Program))] (-> (slice u8))
  (set-wasm-side-module! true)
  (wcg-build-module a mp true))

; RUN hook: hand the side-module bytes, the entry symbol, and up to 8 boxed Sexp arg
; pointers to the host, which instantiates the module against this instance and calls
; the entry synchronously, returning the result Sexp handle.
(extern meta_run_wasm :cc c
  [(ptr u8) i64 (ptr i8) i64
   (ptr i8) (ptr i8) (ptr i8) (ptr i8)
   (ptr i8) (ptr i8) (ptr i8) (ptr i8)] (-> (ptr i8)))
(defn meta-run-wasm-entry
  [(bytes (ptr u8)) (len i64) (sym (ptr i8)) (argc i64)
   (a0 (ptr i8)) (a1 (ptr i8)) (a2 (ptr i8)) (a3 (ptr i8))
   (a4 (ptr i8)) (a5 (ptr i8)) (a6 (ptr i8)) (a7 (ptr i8))] (-> (ptr i8))
  (meta_run_wasm bytes len sym argc a0 a1 a2 a3 a4 a5 a6 a7))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (set-meta-build-obj! (fnptr-of meta-build-obj-a64))
  (set-meta-build-mobj! (fnptr-of meta-build-mobj-a64))
  (set-meta-wasm! (fnptr-of meta-build-side-wasm) (fnptr-of meta-run-wasm-entry))
  (register-comptime-fold!)
  (driver-main argc argv
               (fnptr-of no-llvm-build)
               (fnptr-of no-llvm-emitir)
               (fnptr-of no-normalize)
               (fnptr-of do-cimport)
               2))
