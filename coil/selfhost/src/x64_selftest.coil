; selfhost/src/x64_selftest.coil — encoder verification harness.
;
; Emits one instruction per case and prints it as
;     <hex bytes> TAB <AT&T assembly>
; The gate script (selfhost/oracle/x64/gate-encode.sh) feeds the assembly column
; to llvm-mc and diffs its encoding against the hex column. Anything that
; disagrees with a real assembler is a bug here, and hand-encoding bugs are
; otherwise near-impossible to spot by reading — they surface as a segfault in
; a large generated program, thousands of instructions from the mistake.
;
; Cases deliberately cover the encoding EDGE CASES, not just the happy path:
;   - r8..r15 in every operand position (REX.R vs REX.B vs REX.X)
;   - rsp/r12 as a memory base (forces a SIB byte)
;   - rbp/r13 as a memory base (cannot use mod=00; needs an explicit disp8 0)
;   - disp 0 / disp8 / disp32 boundaries (127/128, -128/-129)
;   - byte registers 4..7 (sil/dil/spl/bpl need a bare REX to not mean ah/ch/dh/bh)
;   - the imm-size ladder in x64-mov-imm! (xor / mov32 / sign-extended / movabs)
(module x64_selftest)

(import "alloc.coil" :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "match.coil" :use *)
(import "x64.coil" :use *)

; 0-9 -> '0'..'9', 10-15 -> 'a'..'f'  ('a' is 97, so the offset is 97-10 = 87)
(defn hexdig [(v i64)] (-> i64)
  (if (icmp-lt v 10) (iadd 48 v) (iadd 87 v)))

; print the buffer as lowercase hex bytes, then a tab, then `asm`, then newline.
; The buffer is cleared afterwards so the next case starts empty.
(defn emit-case! [(s (mut XAsm)) (asm (slice u8))] (-> i64)
  (let [a (load (field s a))
        w (stdout)
        n (al-len [u8] (load (field s buf)))
        ; build the whole line in one byte list, then write it once
        (mut out) (al-new [u8] a)
        (mut i) 0]
    (loop (if (icmp-ge (load i) n)
              (break)
              (do
                (let [b (cast i64 (al-get [u8] (load (field s buf)) (load i)))]
                  (al-push! (mut out) (cast u8 (hexdig (iand (ishr b 4) 15))))
                  (al-push! (mut out) (cast u8 (hexdig (iand b 15)))))
                (store! i (iadd (load i) 1)))))
    (al-push! (mut out) (cast u8 9))  ; tab
    (print-str w (al-slice [u8] (load out)))
    (print-str w asm)
    (print-str w "\n")
    (store! (field (field s buf) len) 0)
    0))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut s) (xasm-new a)]

    ; ---- mov r/r: low regs, high regs, and the mixed cases that exercise
    ; REX.R and REX.B independently.
    (x64-mov-rr! (mut s) (x64-rax) (x64-rdi))  (emit-case! (mut s) "movq %rdi, %rax")
    (x64-mov-rr! (mut s) (x64-rsp) (x64-rbp))  (emit-case! (mut s) "movq %rbp, %rsp")
    (x64-mov-rr! (mut s) (x64-r8) (x64-rax))   (emit-case! (mut s) "movq %rax, %r8")
    (x64-mov-rr! (mut s) (x64-rax) (x64-r15))  (emit-case! (mut s) "movq %r15, %rax")
    (x64-mov-rr! (mut s) (x64-r12) (x64-r13))  (emit-case! (mut s) "movq %r13, %r12")

    ; ---- mov load/store: the three ModRM memory shapes, on the three awkward
    ; bases (rsp needs SIB, rbp needs disp8-0, r12/r13 need both plus REX.B).
    (x64-mov-rm! (mut s) (x64-rax) (x64-rbx) 0)     (emit-case! (mut s) "movq (%rbx), %rax")
    (x64-mov-rm! (mut s) (x64-rax) (x64-rsp) 0)     (emit-case! (mut s) "movq (%rsp), %rax")
    (x64-mov-rm! (mut s) (x64-rax) (x64-rbp) 0)     (emit-case! (mut s) "movq (%rbp), %rax")
    (x64-mov-rm! (mut s) (x64-rax) (x64-r12) 0)     (emit-case! (mut s) "movq (%r12), %rax")
    (x64-mov-rm! (mut s) (x64-rax) (x64-r13) 0)     (emit-case! (mut s) "movq (%r13), %rax")
    (x64-mov-rm! (mut s) (x64-rax) (x64-rbp) -8)    (emit-case! (mut s) "movq -8(%rbp), %rax")
    (x64-mov-rm! (mut s) (x64-rax) (x64-rbp) 127)   (emit-case! (mut s) "movq 127(%rbp), %rax")
    (x64-mov-rm! (mut s) (x64-rax) (x64-rbp) 128)   (emit-case! (mut s) "movq 128(%rbp), %rax")
    (x64-mov-rm! (mut s) (x64-rax) (x64-rbp) -128)  (emit-case! (mut s) "movq -128(%rbp), %rax")
    (x64-mov-rm! (mut s) (x64-rax) (x64-rbp) -129)  (emit-case! (mut s) "movq -129(%rbp), %rax")
    (x64-mov-rm! (mut s) (x64-r9) (x64-rsp) 4096)   (emit-case! (mut s) "movq 4096(%rsp), %r9")
    (x64-mov-mr! (mut s) (x64-rbp) -16 (x64-rdx))   (emit-case! (mut s) "movq %rdx, -16(%rbp)")
    (x64-mov-mr! (mut s) (x64-r12) 24 (x64-r10))    (emit-case! (mut s) "movq %r10, 24(%r12)")

    ; ---- narrow loads/stores
    (x64-movzx8-rm! (mut s) (x64-rax) (x64-rbp) -1)   (emit-case! (mut s) "movzbq -1(%rbp), %rax")
    (x64-movsx8-rm! (mut s) (x64-rax) (x64-rbp) -1)   (emit-case! (mut s) "movsbq -1(%rbp), %rax")
    (x64-movzx16-rm! (mut s) (x64-rcx) (x64-rbp) -2)  (emit-case! (mut s) "movzwq -2(%rbp), %rcx")
    (x64-movsx16-rm! (mut s) (x64-rcx) (x64-rbp) -2)  (emit-case! (mut s) "movswq -2(%rbp), %rcx")
    (x64-mov32-rm! (mut s) (x64-rdx) (x64-rbp) -4)    (emit-case! (mut s) "movl -4(%rbp), %edx")
    (x64-movsx32-rm! (mut s) (x64-rdx) (x64-rbp) -4)  (emit-case! (mut s) "movslq -4(%rbp), %rdx")
    (x64-mov8-mr! (mut s) (x64-rbp) -1 (x64-rax))     (emit-case! (mut s) "movb %al, -1(%rbp)")
    ; sil/dil: without the bare REX these would assemble as %dh/%bh.
    (x64-mov8-mr! (mut s) (x64-rbp) -1 (x64-rsi))     (emit-case! (mut s) "movb %sil, -1(%rbp)")
    (x64-mov8-mr! (mut s) (x64-rbp) -1 (x64-rdi))     (emit-case! (mut s) "movb %dil, -1(%rbp)")
    (x64-mov8-mr! (mut s) (x64-rbp) -1 (x64-r9))      (emit-case! (mut s) "movb %r9b, -1(%rbp)")
    (x64-mov16-mr! (mut s) (x64-rbp) -2 (x64-rcx))    (emit-case! (mut s) "movw %cx, -2(%rbp)")
    (x64-mov32-mr! (mut s) (x64-rbp) -4 (x64-rdx))    (emit-case! (mut s) "movl %edx, -4(%rbp)")

    ; ---- lea
    (x64-lea! (mut s) (x64-rax) (x64-rbp) -32)   (emit-case! (mut s) "leaq -32(%rbp), %rax")
    (x64-lea! (mut s) (x64-r11) (x64-rsp) 8)     (emit-case! (mut s) "leaq 8(%rsp), %r11")

    ; ---- the immediate ladder: each rung must pick the shortest correct form.
    (x64-mov-imm! (mut s) (x64-rax) 0)            (emit-case! (mut s) "xorl %eax, %eax")
    (x64-mov-imm! (mut s) (x64-r8) 0)             (emit-case! (mut s) "xorl %r8d, %r8d")
    (x64-mov-imm! (mut s) (x64-rax) 1)            (emit-case! (mut s) "movl $1, %eax")
    (x64-mov-imm! (mut s) (x64-rcx) 4294967295)   (emit-case! (mut s) "movl $4294967295, %ecx")
    (x64-mov-imm! (mut s) (x64-rax) -1)           (emit-case! (mut s) "movq $-1, %rax")
    (x64-mov-imm! (mut s) (x64-rax) 4294967296)   (emit-case! (mut s) "movabsq $4294967296, %rax")
    (x64-mov-imm64! (mut s) (x64-r10) 123456789012345)  (emit-case! (mut s) "movabsq $123456789012345, %r10")

    ; ---- ALU reg/reg
    (x64-add-rr! (mut s) (x64-rax) (x64-rsi))  (emit-case! (mut s) "addq %rsi, %rax")
    (x64-sub-rr! (mut s) (x64-rax) (x64-rsi))  (emit-case! (mut s) "subq %rsi, %rax")
    (x64-and-rr! (mut s) (x64-rax) (x64-rsi))  (emit-case! (mut s) "andq %rsi, %rax")
    (x64-or-rr! (mut s) (x64-rax) (x64-rsi))   (emit-case! (mut s) "orq %rsi, %rax")
    (x64-xor-rr! (mut s) (x64-rax) (x64-rsi))  (emit-case! (mut s) "xorq %rsi, %rax")
    (x64-cmp-rr! (mut s) (x64-rax) (x64-rsi))  (emit-case! (mut s) "cmpq %rsi, %rax")
    (x64-add-rr! (mut s) (x64-r8) (x64-r9))    (emit-case! (mut s) "addq %r9, %r8")

    ; ---- ALU reg/imm32
    (x64-add-ri! (mut s) (x64-rsp) 64)     (emit-case! (mut s) "addq $64, %rsp")
    (x64-sub-ri! (mut s) (x64-rsp) 64)     (emit-case! (mut s) "subq $64, %rsp")
    (x64-cmp-ri! (mut s) (x64-rax) 0)      (emit-case! (mut s) "cmpq $0, %rax")
    (x64-and-ri! (mut s) (x64-rax) 255)    (emit-case! (mut s) "andq $255, %rax")
    (x64-sub-ri! (mut s) (x64-r12) 4096)   (emit-case! (mut s) "subq $4096, %r12")

    ; ---- unary / mul / div
    (x64-neg! (mut s) (x64-rax))                 (emit-case! (mut s) "negq %rax")
    (x64-not! (mut s) (x64-rbx))                 (emit-case! (mut s) "notq %rbx")
    (x64-imul-rr! (mut s) (x64-rax) (x64-rcx))   (emit-case! (mut s) "imulq %rcx, %rax")
    (x64-imul-rr! (mut s) (x64-r8) (x64-r9))     (emit-case! (mut s) "imulq %r9, %r8")
    (x64-cqo! (mut s))                           (emit-case! (mut s) "cqto")
    (x64-idiv! (mut s) (x64-rcx))                (emit-case! (mut s) "idivq %rcx")
    (x64-div! (mut s) (x64-r10))                 (emit-case! (mut s) "divq %r10")

    ; ---- shifts
    (x64-shl-cl! (mut s) (x64-rax))         (emit-case! (mut s) "shlq %cl, %rax")
    (x64-shr-cl! (mut s) (x64-rax))         (emit-case! (mut s) "shrq %cl, %rax")
    (x64-sar-cl! (mut s) (x64-rax))         (emit-case! (mut s) "sarq %cl, %rax")
    (x64-shl-imm! (mut s) (x64-rax) 3)      (emit-case! (mut s) "shlq $3, %rax")
    (x64-sar-imm! (mut s) (x64-r11) 63)     (emit-case! (mut s) "sarq $63, %r11")

    ; ---- setcc / cmov / test
    (x64-setcc! (mut s) (x64-cc-e) (x64-rax))               (emit-case! (mut s) "sete %al")
    (x64-setcc! (mut s) (x64-cc-l) (x64-rsi))               (emit-case! (mut s) "setl %sil")
    (x64-setcc! (mut s) (x64-cc-a) (x64-r10))               (emit-case! (mut s) "seta %r10b")
    (x64-movzx8-rr! (mut s) (x64-rax) (x64-rax))            (emit-case! (mut s) "movzbq %al, %rax")
    (x64-cmovcc! (mut s) (x64-cc-ne) (x64-rax) (x64-rcx))   (emit-case! (mut s) "cmovneq %rcx, %rax")
    (x64-test-rr! (mut s) (x64-rax) (x64-rax))              (emit-case! (mut s) "testq %rax, %rax")

    ; ---- stack / control
    (x64-push! (mut s) (x64-rbp))    (emit-case! (mut s) "pushq %rbp")
    (x64-push! (mut s) (x64-r13))    (emit-case! (mut s) "pushq %r13")
    (x64-pop! (mut s) (x64-rbp))     (emit-case! (mut s) "popq %rbp")
    (x64-pop! (mut s) (x64-r13))     (emit-case! (mut s) "popq %r13")
    (x64-ret! (mut s))               (emit-case! (mut s) "retq")
    (x64-leave! (mut s))             (emit-case! (mut s) "leave")
    (x64-ud2! (mut s))               (emit-case! (mut s) "ud2")
    (x64-nop! (mut s))               (emit-case! (mut s) "nop")
    (x64-call-r! (mut s) (x64-rax))  (emit-case! (mut s) "callq *%rax")
    (x64-call-r! (mut s) (x64-r11))  (emit-case! (mut s) "callq *%r11")
    (x64-jmp-r! (mut s) (x64-rax))   (emit-case! (mut s) "jmpq *%rax")

    ; ---- SSE
    (x64-movs-rr! (mut s) true 0 1)          (emit-case! (mut s) "movsd %xmm1, %xmm0")
    (x64-movs-rr! (mut s) false 0 1)         (emit-case! (mut s) "movss %xmm1, %xmm0")
    (x64-movs-rr! (mut s) true 8 9)          (emit-case! (mut s) "movsd %xmm9, %xmm8")
    (x64-movs-rm! (mut s) true 0 (x64-rbp) -8)   (emit-case! (mut s) "movsd -8(%rbp), %xmm0")
    (x64-movs-mr! (mut s) true (x64-rbp) -8 0)   (emit-case! (mut s) "movsd %xmm0, -8(%rbp)")
    (x64-movs-rm! (mut s) false 3 (x64-rsp) 16)  (emit-case! (mut s) "movss 16(%rsp), %xmm3")
    (x64-adds! (mut s) true 0 1)             (emit-case! (mut s) "addsd %xmm1, %xmm0")
    (x64-subs! (mut s) true 0 1)             (emit-case! (mut s) "subsd %xmm1, %xmm0")
    (x64-muls! (mut s) true 0 1)             (emit-case! (mut s) "mulsd %xmm1, %xmm0")
    (x64-divs! (mut s) true 0 1)             (emit-case! (mut s) "divsd %xmm1, %xmm0")
    (x64-adds! (mut s) false 0 1)            (emit-case! (mut s) "addss %xmm1, %xmm0")
    (x64-ucomis! (mut s) true 0 1)           (emit-case! (mut s) "ucomisd %xmm1, %xmm0")
    (x64-ucomis! (mut s) false 0 1)          (emit-case! (mut s) "ucomiss %xmm1, %xmm0")
    (x64-cvtsi2s! (mut s) true 0 (x64-rax))  (emit-case! (mut s) "cvtsi2sdq %rax, %xmm0")
    (x64-cvtts2si! (mut s) true (x64-rax) 0) (emit-case! (mut s) "cvttsd2siq %xmm0, %rax")
    (x64-cvts2s! (mut s) true 0 1)           (emit-case! (mut s) "cvtsd2ss %xmm1, %xmm0")
    (x64-cvts2s! (mut s) false 0 1)          (emit-case! (mut s) "cvtss2sd %xmm1, %xmm0")
    (x64-movq-xr! (mut s) 0 (x64-rax))       (emit-case! (mut s) "movq %rax, %xmm0")
    (x64-movq-rx! (mut s) (x64-rax) 0)       (emit-case! (mut s) "movq %xmm0, %rax")
    (x64-xorps! (mut s) 0 0)                 (emit-case! (mut s) "xorps %xmm0, %xmm0")

    ; ---- atomics
    (x64-lock-xadd! (mut s) (x64-rdi) 0 (x64-rax))      (emit-case! (mut s) "lock xaddq %rax, (%rdi)")
    (x64-xchg-mr! (mut s) (x64-rdi) 0 (x64-rax))        (emit-case! (mut s) "xchgq %rax, (%rdi)")
    (x64-lock-cmpxchg! (mut s) (x64-rdi) 0 (x64-rcx))   (emit-case! (mut s) "lock cmpxchgq %rcx, (%rdi)")
    (x64-mfence! (mut s))                               (emit-case! (mut s) "mfence")
    0))
