; selfhost/src/layoutdb.coil — one source of truth for runtime type layout.
(module layoutdb)

(import "alloc.coil" :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "hashmap.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "match.coil" :use *)
(import "ast.coil" :use *)

; The consumers used to have four copies of these records and of every algorithm
; below. Backend state now owns one LayoutDb; ABI classification remains backend-
; specific, but ordinary size/alignment/offset questions cannot drift.
(defstruct LayoutStruct
  [(name (slice u8))
   (fields (ptr (ArrayList Field)))
   (layout Layout)
   (size i64)
   (align i64)
   (offsets (ArrayList i64))])
(defstruct LayoutSum
  [(name (slice u8))
   (variants (ptr (ArrayList Variant)))
   (words i64)])
(defstruct LayoutDb
  [(a (ptr Allocator))
   (owner (slice u8))
   (structs (ArrayList LayoutStruct))
   (sums (ArrayList LayoutSum))
   (struct_idx (HashMap (slice u8) i64))
   (sum_idx (HashMap (slice u8) i64))])

(defn layout-fail [(db (ptr LayoutDb)) (msg (slice u8))] (-> i64)
  (print-str (stderr) (load (field db owner)))
  (print-str (stderr) ": ")
  (print-str (stderr) msg)
  (write-byte (stderr) (cast u8 10))
  (abort)
  0)
(defn layout-fail2 [(db (ptr LayoutDb)) (msg (slice u8)) (what (slice u8))] (-> i64)
  (print-str (stderr) (load (field db owner)))
  (print-str (stderr) ": ")
  (print-str (stderr) msg)
  (print-str (stderr) what)
  (write-byte (stderr) (cast u8 10))
  (abort)
  0)
(defn layout-round-up [(n i64) (a i64)] (-> i64)
  (imul (idiv (iadd n (isub a 1)) a) a))
(defn layout-align8 [(n i64)] (-> i64)
  (layout-round-up n 8))
(defn layout-at [T] [(xs (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (index (load (field xs data)) i))

(impl LayoutDb
  ; Build all nominal entries first, then sum payload sizes, then struct layouts
  ; in dependency order. No receiver means construction is explicitly qualified.
  (new [(a (ptr Allocator)) (mp (ptr Program)) (owner (slice u8))] (-> LayoutDb)
    (let [db (alloc-stack LayoutDb)]
      (store! (field db a) a)
      (store! (field db owner) owner)
      (store! (field db structs) (al-new [LayoutStruct] a))
      (store! (field db sums) (al-new [LayoutSum] a))
      (store! (field db struct_idx) (hm-new [(slice u8) i64] a (str-keyops)))
      (store! (field db sum_idx) (hm-new [(slice u8) i64] a (str-keyops)))
      (let [ss (load (field mp structs))
            n (al-len [StructDef] (load ss))
            (mut i) 0]
        (loop (if (icmp-ge (load i) n)
                  (break)
                  (do
                    (let [sd (layout-at [StructDef] ss (load i))
                          e (alloc-stack LayoutStruct)]
                      (store! (field e name) (load (field sd name)))
                      (store! (field e fields) (load (field sd fields)))
                      (store! (field e layout) (load (field sd layout)))
                      (store! (field e size) 0)
                      (store! (field e align) 1)
                      (store! (field e offsets) (al-new [i64] a))
                      (hm-put! [(slice u8) i64]
                               (mut (field db struct_idx))
                               (load (field e name))
                               (load i))
                      (al-push! (mut (field db structs)) (load e)))
                    (store! i (iadd (load i) 1))))))
      (let [ss (load (field mp sums))
            n (al-len [SumDef] (load ss))
            (mut i) 0]
        (loop (if (icmp-ge (load i) n)
                  (break)
                  (do
                    (let [sd (layout-at [SumDef] ss (load i))
                          e (alloc-stack LayoutSum)]
                      (store! (field e name) (load (field sd name)))
                      (store! (field e variants) (load (field sd variants)))
                      (store! (field e words) 0)
                      (hm-put! [(slice u8) i64]
                               (mut (field db sum_idx))
                               (load (field e name))
                               (load i))
                      (al-push! (mut (field db sums)) (load e)))
                    (store! i (iadd (load i) 1))))))
      (let [n (al-len [LayoutSum] (load (field db sums)))
            (mut i) 0]
        (loop (if (icmp-ge (load i) n)
                  (break)
                  (do
                    (let [e (layout-at [LayoutSum] (field db sums) (load i))]
                      (store! (field e words) (sum-words db (load (field e variants)))))
                    (store! i (iadd (load i) 1))))))
      (compute-struct-layouts! db)
      (load db)))

  (struct-index [(db (ptr LayoutDb)) (name (slice u8))] (-> i64)
    (match (hm-get [(slice u8) i64] (load (field db struct_idx)) name)
      (Some [i] i)
      (None [] -1)))

  (sum-index [(db (ptr LayoutDb)) (name (slice u8))] (-> i64)
    (match (hm-get [(slice u8) i64] (load (field db sum_idx)) name)
      (Some [i] i)
      (None [] -1)))

  (struct-at [(db (ptr LayoutDb)) (i i64)] (-> (ptr LayoutStruct))
    (layout-at [LayoutStruct] (field db structs) i))

  (sum-at [(db (ptr LayoutDb)) (i i64)] (-> (ptr LayoutSum))
    (layout-at [LayoutSum] (field db sums) i))

  (size [(db (ptr LayoutDb)) (t (ptr Type))] (-> i64)
    (match (load t)
      (TInt [bits _s] (cond (icmp-le bits 8) 1 (icmp-le bits 16) 2 (icmp-le bits 32) 4 :else 8))
      (TFloat [bits] (idiv bits 8))
      (TBool [] 1)
      (TVoid [] (layout-fail db "size on void"))
      (TPtr [_] 8)
      (TRef [_ _] 8)
      (TFn [_ _ _] 8)
      (TNever [] 8)
      (TArray [elem n] (imul (size db elem) n))
      (TSlice [_] 16)
      (TVec [elem n] (imul (size db elem) n))
      (TStruct [name]
        (let [si (struct-index db name)]
          (if (icmp-ge si 0)
              (load (field (struct-at db si) size))
              (let [su (sum-index db name)]
                (if (icmp-ge su 0)
                    (iadd 8 (imul 8 (load (field (sum-at db su) words))))
                    (layout-fail2 db "unknown nominal type: " name))))))
      (TApp [_ _] (layout-fail db "generic type reached layout after monomorphization"))
      (TCode [] (layout-fail db "Code reached runtime layout"))
      (TExternRef [] (layout-fail db "externref reached native layout"))))

  (align [(db (ptr LayoutDb)) (t (ptr Type))] (-> i64)
    (match (load t)
      (TInt [bits _s] (cond (icmp-le bits 8) 1 (icmp-le bits 16) 2 (icmp-le bits 32) 4 :else 8))
      (TFloat [bits] (idiv bits 8))
      (TBool [] 1)
      (TVoid [] (layout-fail db "align on void"))
      (TPtr [_] 8)
      (TRef [_ _] 8)
      (TFn [_ _ _] 8)
      (TNever [] 8)
      (TArray [elem _n] (align db elem))
      (TSlice [_] 8)
      (TVec [elem n] (imul (align db elem) n))
      (TStruct [name]
        (let [si (struct-index db name)]
          (if (icmp-ge si 0)
              (load (field (struct-at db si) align))
              (if (icmp-ge (sum-index db name) 0)
                  8
                  (layout-fail2 db "unknown nominal type: " name)))))
      (TApp [_ _] (layout-fail db "generic type reached layout after monomorphization"))
      (TCode [] (layout-fail db "Code reached runtime layout"))
      (TExternRef [] (layout-fail db "externref reached native layout"))))

  (field-offset [(db (ptr LayoutDb)) (si i64) (fi i64)] (-> i64)
    (al-get [i64] (load (field (struct-at db si) offsets)) fi))

  (field-number [(db (ptr LayoutDb)) (si i64) (name (slice u8))] (-> i64)
    (let [fs (load (field (struct-at db si) fields))
          n (al-len [Field] (load fs))
          (mut i) 0
          (mut found) -1]
      (loop (if (icmp-ge (load i) n)
                (break)
                (do
                  (when (str-eq (load (field (layout-at [Field] fs (load i)) name)) name)
                    (store! found (load i))
                    (break))
                  (store! i (iadd (load i) 1)))))
      (when (icmp-lt (load found) 0) (layout-fail2 db "no such field: " name))
      (load found)))

  (variant-number [(db (ptr LayoutDb)) (su i64) (name (slice u8))] (-> i64)
    (let [vs (load (field (sum-at db su) variants))
          n (al-len [Variant] (load vs))
          (mut i) 0
          (mut found) -1]
      (loop (if (icmp-ge (load i) n)
                (break)
                (do
                  (when (str-eq (load (field (layout-at [Variant] vs (load i)) name)) name)
                    (store! found (load i))
                    (break))
                  (store! i (iadd (load i) 1)))))
      (when (icmp-lt (load found) 0) (layout-fail2 db "no such variant: " name))
      (load found)))

  ; Conservative SUM PAYLOAD sizing. Each field occupies an 8-byte-rounded
  ; region, matching LLVM's [words x i64] payload representation.
  (type-bytes [(db (ptr LayoutDb)) (t (ptr Type))] (-> i64)
    (match (load t)
      ; Integer widths are arbitrary. Round partial bytes up: i9 occupies two
      ; bytes, which matters when arrays of narrow integers live in sum payloads.
      (TInt [bits _s] (idiv (iadd bits 7) 8))
      (TFloat [bits] (idiv bits 8))
      (TBool [] 1)
      (TPtr [_] 8)
      (TRef [_ _] 8)
      (TFn [_ _ _] 8)
      (TNever [] 8)
      (TArray [elem n] (imul (type-bytes db elem) n))
      (TSlice [_] 16)
      (TVec [elem n] (imul (type-bytes db elem) n))
      (TStruct [name]
        (let [si (struct-index db name)]
          (if (icmp-ge si 0)
              (let [fs (load (field (struct-at db si) fields))
                    n (al-len [Field] (load fs))
                    (mut i) 0
                    (mut total) 0]
                (loop (if (icmp-ge (load i) n)
                          (break)
                          (do
                            (store! total
                                    (iadd (load total)
                                          (layout-align8
                                            (type-bytes db (field (layout-at [Field] fs (load i)) ty)))))
                            (store! i (iadd (load i) 1)))))
                (load total))
              (let [su (sum-index db name)]
                (if (icmp-ge su 0)
                    (iadd 8 (imul 8 (sum-words db (load (field (sum-at db su) variants)))))
                    (layout-fail2 db "type-bytes: unknown nominal " name))))))
      (TVoid [] (layout-fail db "type-bytes on void"))
      (TApp [_ _] (layout-fail db "type-bytes on generic type"))
      (TCode [] (layout-fail db "type-bytes on Code"))
      (TExternRef [] (layout-fail db "type-bytes on externref"))))

  (sum-words [(db (ptr LayoutDb)) (variants (ptr (ArrayList Variant)))] (-> i64)
    (let [n (al-len [Variant] (load variants))
          (mut vi) 0
          (mut best) 0]
      (loop (if (icmp-ge (load vi) n)
                (break)
                (do
                  (let [fs (load (field (layout-at [Variant] variants (load vi)) fields))
                        nf (al-len [Field] (load fs))
                        (mut fi) 0
                        (mut total) 0]
                    (loop (if (icmp-ge (load fi) nf)
                              (break)
                              (do
                                (store! total
                                        (iadd (load total)
                                              (layout-align8
                                                (type-bytes db (field (layout-at [Field] fs (load fi)) ty)))))
                                (store! fi (iadd (load fi) 1)))))
                    (when (icmp-gt (load total) (load best)) (store! best (load total))))
                  (store! vi (iadd (load vi) 1)))))
      (idiv (iadd (load best) 7) 8)))

  (natural-offset [(db (ptr LayoutDb)) (fs (ptr (ArrayList Field))) (fi i64)] (-> i64)
    (let [(mut i) 0
          (mut off) 0
          (mut result) -1]
      (loop (if (icmp-gt (load i) fi)
                (break)
                (do
                  (let [ft (field (layout-at [Field] fs (load i)) ty)
                        a (align db ft)]
                    (store! off (layout-round-up (load off) a))
                    (when (icmp-eq (load i) fi) (store! result (load off)) 0)
                    (store! off (iadd (load off) (size db ft))))
                  (store! i (iadd (load i) 1)))))
      (load result)))

  (natural-layout! [(db (ptr LayoutDb)) (si i64)] (-> i64)
    (let [e (struct-at db si)
          fs (load (field e fields))
          nf (al-len [Field] (load fs))
          (mut off) 0
          (mut max-align) 1
          (mut i) 0]
      (loop (if (icmp-ge (load i) nf)
                (break)
                (do
                  (let [ft (field (layout-at [Field] fs (load i)) ty)
                        a (align db ft)]
                    (when (icmp-gt a (load max-align)) (store! max-align a))
                    (store! off (layout-round-up (load off) a))
                    (al-push! (mut (field e offsets)) (load off))
                    (store! off (iadd (load off) (size db ft))))
                  (store! i (iadd (load i) 1)))))
      (store! (field e align) (load max-align))
      (store! (field e size) (layout-round-up (load off) (load max-align)))
      0))

  (compute-one-struct! [(db (ptr LayoutDb)) (si i64)] (-> i64)
    (let [e (struct-at db si)
          fs (load (field e fields))
          nf (al-len [Field] (load fs))]
      (match (load (field e layout))
        (LBits [backing _offs]
          (do
            (store! (field e size) (idiv backing 8))
            (store! (field e align) (idiv backing 8))
            0))
        (LExplicit [offs user-size user-align]
          (do
            (let [(mut max-end) 0
                  (mut i) 0]
              (loop (if (icmp-ge (load i) nf)
                        (break)
                        (do
                          (let [end (iadd (al-get [i64] (load offs) (load i))
                                          (size db (field (layout-at [Field] fs (load i)) ty)))]
                            (when (icmp-gt end (load max-end)) (store! max-end end)))
                          (store! i (iadd (load i) 1)))))
              (store! (field e size)
                      (match user-size
                        (Some [n] (if (icmp-gt n (load max-end)) n (load max-end)))
                        (None [] (load max-end))))
              (store! (field e align) (if (icmp-gt user-align 0) user-align 1))
              (let [(mut i) 0]
                (loop (if (icmp-ge (load i) nf)
                          (break)
                          (do
                            (al-push! (mut (field e offsets)) (al-get [i64] (load offs) (load i)))
                            (store! i (iadd (load i) 1)))))))
            0))
        (LPacked []
          (do
            (let [(mut off) 0
                  (mut i) 0]
              (loop (if (icmp-ge (load i) nf)
                        (break)
                        (do
                          (al-push! (mut (field e offsets)) (load off))
                          (store! off (iadd (load off) (size db (field (layout-at [Field] fs (load i)) ty))))
                          (store! i (iadd (load i) 1)))))
              (store! (field e size) (load off))
              (store! (field e align) 1))
            0))
        (LAligned [forced]
          (do
            (natural-layout! db si)
            (when (icmp-gt forced (load (field e align))) (store! (field e align) forced))
            (store! (field e size) (layout-round-up (load (field e size)) (load (field e align))))
            0))
        (LC [] (natural-layout! db si)))))

  (type-ready? [(db (ptr LayoutDb)) (t (ptr Type)) (done (mut (ArrayList i64)))] (-> bool)
    (match-else (load t)
      (TStruct [name]
        (let [si (struct-index db name)]
          (if (icmp-ge si 0) (icmp-eq (al-get [i64] (load done) si) 1) true)))
      (TArray [elem _n] (type-ready? db elem (mut done)))
      (TVec [elem _n] (type-ready? db elem (mut done)))
      (_ true)))

  (struct-ready? [(db (ptr LayoutDb)) (si i64) (done (mut (ArrayList i64)))] (-> bool)
    (let [fs (load (field (struct-at db si) fields))
          nf (al-len [Field] (load fs))
          (mut i) 0
          (mut ready) true]
      (loop (if (icmp-ge (load i) nf)
                (break)
                (do
                  (when (not (type-ready? db (field (layout-at [Field] fs (load i)) ty) (mut done)))
                    (store! ready false))
                  (store! i (iadd (load i) 1)))))
      (load ready)))

  (compute-struct-layouts! [(db (ptr LayoutDb))] (-> i64)
    (let [n (al-len [LayoutStruct] (load (field db structs)))
          (mut done) (al-new [i64] (load (field db a)))
          (mut i) 0]
      (loop (if (icmp-ge (load i) n)
                (break)
                (do (al-push! (mut done) 0) (store! i (iadd (load i) 1)))))
      (let [(mut pass) 0]
        (loop (if (icmp-ge (load pass) (iadd n 1))
                  (break)
                  (do
                    (let [(mut si) 0
                          (mut all-done) true]
                      (loop (if (icmp-ge (load si) n)
                                (break)
                                (do
                                  (when (icmp-eq (al-get [i64] (load done) (load si)) 0)
                                    (if (struct-ready? db (load si) (mut done))
                                        (do
                                          (compute-one-struct! db (load si))
                                          (al-set! (mut done) (load si) 1))
                                        (store! all-done false)))
                                  (store! si (iadd (load si) 1)))))
                      (when (load all-done) (break)))
                    (store! pass (iadd (load pass) 1))))))
      (let [(mut si) 0]
        (loop (if (icmp-ge (load si) n)
                  (break)
                  (do
                    (when (icmp-eq (al-get [i64] (load done) (load si)) 0)
                      (layout-fail2 db "struct layout cycle at " (load (field (struct-at db (load si)) name))))
                    (store! si (iadd (load si) 1))))))
      0)))
