; selfhost/src/elf_selftest.coil — end-to-end proof that elf.coil emits a real,
; linkable ELF object.
;
; Hand-assembles a tiny program with the x64 encoder, writes it through
; elf.coil, and drops the .o on disk. The gate (selfhost/oracle/x64/gate-elf.sh)
; then links it with `cc` and runs it: if the header, section table, symbol
; table or relocations are wrong, the linker rejects the object or the program
; misbehaves. That is a far stronger check than eyeballing readelf output.
;
; The program built here is:
;     int main(void) { puts("elf ok"); return 42; }
; which exercises the three things a real object must get right: a global
; STT_FUNC symbol the linker can find, a data section with a string in it, and
; two relocations — RIP-relative (lea of the string) and PLT32 (call to puts).
(module elf_selftest)

(import "alloc.coil" :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "match.coil" :use *)
(import "x64.coil" :use *)
(import "elf.coil" :use *)

; libc file writing, declared here rather than pulled from a module: the
; compiler's own ffi.coil is not a stdlib module, and lib/fs.coil does not
; currently compile (its file-reader/file-writer call io.coil's fd-reader/
; fd-writer with the wrong arity).
(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern fwrite :cc c [(ptr i8) i64 i64 (ptr i8)] (-> i64))
(extern fclose :cc c [(ptr i8)] (-> i32))

(defn main [(argc i64) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (malloc-allocator)
        (mut o) (eobj-new a)
        ; .text: executable code
        text (eobj-add-sect! (mut o) ".text" 16 (sht-progbits)
                             (ior (shf-alloc) (shf-execinstr)))
        ; .rodata: the string constant
        rodata (eobj-add-sect! (mut o) ".rodata" 8 (sht-progbits) (shf-alloc))
        _nx (eobj-mark-nonexec-stack! (mut o))
        (mut s) (xasm-new a)]

    ; ---- .rodata: "elf ok\0"
    (xb-bytes! (mut (eobj-sect-buf (mut o) rodata)) "elf ok")
    (al-push! (mut (eobj-sect-buf (mut o) rodata)) (cast u8 0))

    ; ---- symbols. `.Lstr` is local (the linker needs it only to resolve our
    ; own reloc); `main` is global so the C runtime can call it; `puts` is
    ; undefined and comes from libc.
    (let [str-sym (eobj-add-sym! (mut o) ".Lstr" rodata 0 false)
          puts-sym (eobj-add-sym! (mut o) "puts" 0 0 true)]

      ; ---- .text: the function body
      ;   push %rbp; mov %rsp,%rbp
      (x64-push! (mut s) (x64-rbp))
      (x64-mov-rr! (mut s) (x64-rbp) (x64-rsp))
      ;   lea .Lstr(%rip), %rdi    <- needs an R_X86_64_PC32 reloc
      (x64-lea-rip! (mut s) (x64-rdi) 0)
      ; the displacement sits in the last 4 bytes just emitted. The addend is -4
      ; because the relocation is measured from the END of the instruction while
      ; the field itself starts 4 bytes earlier.
      (eobj-add-reloc! (mut o) text (isub (x64-off (mut s)) 4) str-sym (r-x86-64-pc32) -4)
      ;   call puts                <- R_X86_64_PLT32
      (let [off (x64-call-rel32! (mut s))]
        (eobj-add-reloc! (mut o) text off puts-sym (r-x86-64-plt32) -4))
      ;   mov $42,%eax; pop %rbp; ret
      (x64-mov-imm! (mut s) (x64-rax) 42)
      (x64-pop! (mut s) (x64-rbp))
      (x64-ret! (mut s))

      ; copy the code into .text and declare `main` over it
      (let [code (al-slice [u8] (load (field s buf)))]
        (xb-bytes! (mut (eobj-sect-buf (mut o) text)) code)
        (eobj-add-func-sym! (mut o) "main" text 0 true (slice-len code)))

      ; ---- serialize and write out
      ; libc fopen/fwrite directly, the same way driver.coil's d-write-file does
      ; (lib/fs.coil is not usable here: its file-reader/file-writer call
      ; io.coil's fd-reader/fd-writer with the wrong arity and do not compile).
      (let [bytes (elf-write (mut o))
            content (al-slice [u8] (load bytes))
            path (if (icmp-gt argc 1) (cstr->str (load (index argv 1))) "/tmp/elf_selftest.o")
            f (fopen (str->cstr a path) (str->cstr a "wb"))]
        (if (icmp-eq (cast i64 f) 0)
            (do (print-str (stderr) "elf_selftest: cannot write ") (print-str (stderr) path)
                (print-str (stderr) "\n") 1)
            (do
              (fwrite (cast (ptr i8) (slice-data [u8] content)) 1 (slice-len content) f)
              (fclose f)
              (print-str (stdout) "wrote ") (print-str (stdout) path) (print-str (stdout) "\n")
              0))))))
