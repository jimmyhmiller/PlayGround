; selfhost/src/interp.coil — a BYTECODE interpreter for the self-host Coil
; compiler. It consumes the SAME monomorphized Program the native backends
; consume (parse -> resolve -> check -> mono), compiles each mono'd function to a
; compact stack-bytecode ISA, and executes it on a small VM with a REAL memory
; model: pointers are genuine host addresses, `alloc-stack` bumps a malloc-backed
; per-frame buffer, heap allocations call real malloc, and loads/stores read and
; write actual process memory. FFI extern calls dispatch to real native libc
; functions through a builtin table, so a program that prints via `putchar` /
; `write` / `puts` actually prints.
;
; This module is strictly ADDITIVE: nothing here is wired into the compile
; pipeline. The driver's new `coil interp <file>` subcommand is the only entry
; point (driver.coil). The native backends are byte-unchanged.
;
; See docs/BYTECODE_INTERP.md for the ISA, value/memory model, frame layout, and
; FFI dispatch.
;
; SCOPE: the slice implemented end-to-end is integer + float arithmetic,
; locals/let/mut, if/loop/while, direct calls + recursion, casts, pointer
; load/store + alloc, and libc FFI. Everything not yet implemented HARD-ERRORS
; with a clear message (idie) — never a silent no-op or sentinel.
(module interp)

(import "alloc.coil" :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "arraylist.coil" :use *)
(import "io.coil" :use *)
(import "control.coil" :use *)
(import "try.coil" :use *)
(import "match.coil" :use *)
(import "ast.coil" :use *)
(import "parser.coil" :use *)

; libc functions the interpreter itself uses + the FFI builtin table. Names are
; module-qualified so the C SYMBOL is the last dot component (g-last-component),
; matching the cga64.* pattern; this avoids Coil-scope collisions with the same
; extern declared elsewhere while still linking to the real libc symbol.
; Signatures MUST match any other declaration of the same C symbol elsewhere in
; the compiler (one C symbol, one signature): `exit`/`write`/`malloc` are already
; declared in ffi/io/alloc, so these mirror those exactly. `putchar`/`puts` are
; unique to the interpreter.
(extern interp.malloc  [i64] (-> (ptr i8)))
(extern interp.free    [(ptr i8)] (-> i64))
(extern interp.exit    [i32] (-> i64))
(extern interp.putchar [i64] (-> i64))
(extern interp.write   [i32 (ptr i8) isize] (-> isize))
(extern interp.puts    [(ptr i8)] (-> i64))

; address of element i of an ArrayList given by pointer (local copy of the a64
; helper, renamed to avoid a duplicate generic instantiation clash).
(defn ial-at [T] [(p (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (index (load (field p data)) i))

; ============================ hard-error helpers =============================
(defn idie [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "interp: ") (ps w msg) (wb w 10) (interp.exit (cast i32 1)) 0))
(defn idie2 [(msg (slice u8)) (x (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "interp: ") (ps w msg) (ps w x) (wb w 10) (interp.exit (cast i32 1)) 0))

; ============================ bytecode data model ============================
; One instruction: op + three immediate operands. See docs/BYTECODE_INTERP.md
; for the opcode legend (mirrored in the VM `case` below).
(defstruct Instr [(op i64) (a i64) (b i64) (c i64)])

(defstruct BFunc
  [(name (slice u8))
   (nparams i64)
   (nlocals i64)
   (code (ptr (ArrayList Instr)))
   (retty Type)
   (state i64)])    ; 0 = body not yet compiled, 1 = compiled (lazy: only funcs reachable from main are compiled)

; a compile-time scope entry: local slot index + static type.
(defstruct CScope [(name (slice u8)) (slot i64) (ty Type) (next (ptr CScope))])

; a lexically-open loop during compilation.
(defstruct CLoop
  [(contlabel i64) (breaklabel i64) (resultlocal i64)
   (label (Option (slice u8))) (has_res bool) (resty Type)])

; per-function bytecode builder.
(defstruct FB
  [(cx (ptr Interp))
   (code (ArrayList Instr))
   (loops (ArrayList CLoop))
   (labels (ArrayList i64))
   (nlocals i64)
   (env (ptr CScope))
   (term bool)])

; the interpreter context: the mono'd program + compiled functions.
(defstruct Interp
  [(a (ptr Allocator))
   (mp (ptr Program))
   (externs (ptr (ArrayList Extern)))
   (bfuncs (ArrayList BFunc))])

; ============================ scope helpers ==================================
(defn cs-cons [(a (ptr Allocator)) (nm (slice u8)) (slot i64) (ty Type) (nx (ptr CScope))] (-> (ptr CScope))
  (let [p (unwrap-ptr [CScope] (create [CScope] a))]
    (store! (field p name) nm) (store! (field p slot) slot)
    (store! (field p ty) ty) (store! (field p next) nx)
    p))
(defn cs-find [(s (ptr CScope)) (nm (slice u8))] (-> (ptr CScope))
  (if (icmp-eq (cast i64 s) 0) (cast (ptr CScope) 0)
    (if (str-eq (load (field s name)) nm) s (cs-find (load (field s next)) nm))))

; ============================ type helpers ===================================
; byte size of a type in the interpreter's memory model. MUST agree with the
; native backends' ty-size for scalars/pointers/slices/arrays (which it does),
; so pointer arithmetic and FFI see identical layouts. Structs/sums are not yet
; laid out — they hard-error rather than guess.
(defn isize-of [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  (match-else (load tp)
    (TInt [bits sg] (if (icmp-le bits 8) 1 (if (icmp-le bits 16) 2 (if (icmp-le bits 32) 4 8))))
    (TFloat [bits] (idiv bits 8))
    (TBool [] 1)
    (TVoid [] 0)
    (TPtr [i0] 8) (TRef [m0 i1] 8) (TFn [c0 p0 r0] 8) (TNever [] 8)
    (TSlice [e0] 16)
    (TArray [elem n] (imul (isize-of cx elem) n))
    (TVec [elem n] (imul (isize-of cx elem) n))
    (_ (do (idie "isize-of: unsupported type (structs/sums not implemented in interp yet)") 8))))

(defn ialign-of [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  (match-else (load tp)
    (TInt [bits sg] (if (icmp-le bits 8) 1 (if (icmp-le bits 16) 2 (if (icmp-le bits 32) 4 8))))
    (TFloat [bits] (idiv bits 8))
    (TBool [] 1)
    (TPtr [i0] 8) (TRef [m0 i1] 8) (TFn [c0 p0 r0] 8) (TNever [] 8)
    (TSlice [e0] 8)
    (TArray [elem n0] (ialign-of cx elem))
    (TVec [elem n1] (imul (ialign-of cx elem) n1))
    (_ 8)))

(defn signed-of [(tp (ptr Type))] (-> bool)
  (match-else (load tp) (TInt [b sg] sg) (_ false)))
(defn ty-is-float2 [(tp (ptr Type))] (-> bool)
  (match-else (load tp) (TFloat [b] true) (_ false)))
(defn fbytes-of [(tp (ptr Type))] (-> i64)
  (match-else (load tp) (TFloat [b] (idiv b 8)) (_ 8)))
(defn isbool01 [(t Type)] (-> i64)
  (match-else t (TBool [] 1) (_ 0)))
(defn ty-pointee2 [(tp (ptr Type))] (-> Type)
  (match-else (load tp)
    (TPtr [inner] (load inner))
    (TRef [m2 inner] (load inner))
    (_ (do (idie "load/deref of a non-pointer value") (TInt 64 true)))))

; arithmetic op MODE for the BIN/CMP opcodes: 0 int, 1 f32, 2 f64.
(defn tmode [(tp (ptr Type))] (-> i64)
  (match-else (load tp)
    (TFloat [bits] (if (icmp-eq bits 32) 1 2))
    (_ 0)))
; packed (signed | bits<<1) for integer BIN canonicalization.
(defn tsignbits [(tp (ptr Type))] (-> i64)
  (match-else (load tp)
    (TInt [bits sg] (ior (if sg 1 0) (ishl bits 1)))
    (TBool [] (ishl 1 1))
    (_ (ishl 64 1))))
(defn tsigned [(tp (ptr Type))] (-> i64)
  (match-else (load tp)
    (TInt [bits sg] (if sg 1 0))
    (TBool [] 0)
    (_ 1)))
(defn tsize [(cx (ptr Interp)) (t Type)] (-> i64)
  (let [tp (alloc-stack Type)] (store! tp t) (isize-of cx tp)))

; ============================ bytecode emit ==================================
(defn femit [(fb (ptr FB)) (op i64) (a i64) (b i64) (c i64)] (-> i64)
  (let [ins (alloc-stack Instr)]
    (store! (field ins op) op) (store! (field ins a) a)
    (store! (field ins b) b)   (store! (field ins c) c)
    (al-push! (mut (field fb code)) (load ins)) 0))

(defn fnew-label [(fb (ptr FB))] (-> i64)
  (let [id (al-len [i64] (load (field fb labels)))]
    (al-push! (mut (field fb labels)) -1) id))
(defn fbind-label [(fb (ptr FB)) (id i64)] (-> i64)
  (al-set! (mut (field fb labels)) id (al-len [Instr] (load (field fb code)))) 0)
(defn fb-local! [(fb (ptr FB))] (-> i64)
  (let [n (load (field fb nlocals))] (store! (field fb nlocals) (iadd n 1)) n))

; rewrite every JMP(11)/JZ(12) target from label-id to instruction index.
(defn resolve-labels [(fb (ptr FB))] (-> i64)
  (let [n (al-len [Instr] (load (field fb code))) (mut i) 0]
    (loop (if (icmp-ge (load i) n) (break)
      (do (let [ins (ial-at [Instr] (field fb code) (load i)) op (load (field ins op))]
            (if (or (icmp-eq op 11) (icmp-eq op 12))
                (store! (field ins a) (al-get [i64] (load (field fb labels)) (load (field ins a))))
              0))
          (store! i (iadd (load i) 1))))))
  0)

; ============================ compile-time helpers ===========================
(defn find-func [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (let [n (al-len [BFunc] (load (field cx bfuncs))) (mut i) 0 (mut r) -1]
    (loop (if (icmp-ge (load i) n) (break)
      (do (if (str-eq (load (field (ial-at [BFunc] (field cx bfuncs) (load i)) name)) nm)
              (do (store! r (load i)) (break)) 0)
          (store! i (iadd (load i) 1)))))
    (load r)))

(defn find-extern [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (let [es (load (field cx externs)) n (al-len [Extern] (load es)) (mut i) 0 (mut r) -1]
    (loop (if (icmp-ge (load i) n) (break)
      (do (if (str-eq (load (field (ial-at [Extern] es (load i)) name)) nm)
              (do (store! r (load i)) (break)) 0)
          (store! i (iadd (load i) 1)))))
    (load r)))

; loop index (labeled search from innermost, else innermost). Mirrors g-loop-index.
(defn cloop-index [(fb (ptr FB)) (label (Option (slice u8)))] (-> i64)
  (let [n (al-len [CLoop] (load (field fb loops)))]
    (match label
      (None []
        (do (if (icmp-eq n 0) (idie "break/continue outside a loop") 0)
            (isub n 1)))
      (Some [want]
        (let [(mut i) (isub n 1) (mut r) -1]
          (loop (if (icmp-lt (load i) 0) (break)
            (do (match (load (field (ial-at [CLoop] (field fb loops) (load i)) label))
                  (None [] 0)
                  (Some [have] (if (and (icmp-lt (load r) 0) (str-eq have want))
                                   (do (store! r (load i)) 0) 0)))
                (store! i (isub (load i) 1)))))
          (if (icmp-lt (load r) 0) (idie2 "no such loop label: " want) 0)
          (load r))))))

; the last dot component of a name (extern "io.write" -> C symbol "write").
(defn last-component2 [(nm (slice u8))] (-> (slice u8))
  (let [n (slice-len nm) (mut dot) -1 (mut i) 0]
    (loop (if (icmp-ge (load i) n) (break)
      (do (if (icmp-eq (cast i64 (slice-get nm (load i))) 46) (store! dot (load i)) 0)
          (store! i (iadd (load i) 1)))))
    (if (icmp-ge (load dot) 0) (subslice nm (iadd (load dot) 1) n) nm)))

; intern a string literal into a persistent, NUL-terminated malloc region and
; return its address. String literals are compile-time constants, so the pointer
; is baked into the bytecode as an immediate.
(defn intern-bytes [(sv (slice u8))] (-> i64)
  (let [n (slice-len sv) addr (cast i64 (interp.malloc (iadd n 1))) (mut i) 0]
    (loop (if (icmp-ge (load i) n) (break)
      (do (store! (cast (ptr u8) (iadd addr (load i))) (slice-get sv (load i)))
          (store! i (iadd (load i) 1)))))
    (store! (cast (ptr u8) (iadd addr n)) (cast u8 0))
    addr))

; ============================ compile ========================================
(defn compile-args [(fb (ptr FB)) (args (ptr (ArrayList Expr)))] (-> i64)
  (let [n (al-len [Expr] (load args)) (mut i) 0]
    (loop (if (icmp-ge (load i) n) (break)
      (do (compile-expr fb (ial-at [Expr] args (load i)))
          (store! i (iadd (load i) 1))))))
  0)

(defn compile-call [(fb (ptr FB)) (func (slice u8)) (args (ptr (ArrayList Expr)))] (-> Type)
  (let [cx (load (field fb cx)) fi (find-func cx func)]
    (if (icmp-ge fi 0)
        (do (compile-args fb args)
            (femit fb 13 fi (al-len [Expr] (load args)) 0)
            (ensure-compiled cx fi)
            (load (field (ial-at [BFunc] (field cx bfuncs) fi) retty)))
      (let [ei (find-extern cx func)]
        (if (icmp-ge ei 0)
            (do (compile-args fb args)
                (femit fb 14 ei (al-len [Expr] (load args)) 0)
                (load (field (ial-at [Extern] (load (field cx externs)) ei) ret)))
          (do (idie2 "call to unknown function: " func) (TInt 64 true)))))))

; compile a sequence, POPping all but the last; returns the last expr's type
; (the sequence's value). Used for do / let body / function body.
(defn compile-seq [(fb (ptr FB)) (body (ptr (ArrayList Expr)))] (-> Type)
  (let [n (al-len [Expr] (load body)) (mut i) 0 (mut last) (TInt 64 true)]
    (if (icmp-eq n 0) (do (femit fb 1 0 0 0) 0) 0)   ; empty body -> push 0
    (loop (if (icmp-ge (load i) n) (break)
      (do (if (load (field fb term)) (break) 0)
          (store! last (compile-expr fb (ial-at [Expr] body (load i))))
          (if (and (icmp-lt (load i) (isub n 1)) (not (load (field fb term))))
              (femit fb 4 0 0 0) 0)                   ; POP intermediate result
          (store! i (iadd (load i) 1)))))
    (load last)))

; compile a statement sequence, POPping EVERY produced value (used for loop bodies).
(defn compile-stmts [(fb (ptr FB)) (body (ptr (ArrayList Expr)))] (-> i64)
  (let [n (al-len [Expr] (load body)) (mut i) 0]
    (loop (if (icmp-ge (load i) n) (break)
      (do (if (load (field fb term)) (break) 0)
          (compile-expr fb (ial-at [Expr] body (load i)))
          (if (load (field fb term)) 0 (femit fb 4 0 0 0))   ; POP
          (store! i (iadd (load i) 1))))))
  0)

(defn compile-binds [(fb (ptr FB)) (binds (ptr (ArrayList Bind)))] (-> i64)
  (let [n (al-len [Bind] (load binds)) (mut i) 0
        cx (load (field fb cx)) a (load (field cx a))]
    (loop (if (icmp-ge (load i) n) (break)
      (do (let [b (ial-at [Bind] binds (load i))
                t (compile-expr fb (field b value))]
            (if (load (field b mutable))
                ; mutable: spill to a frame cell, bind name -> pointer to it
                (let [sz (tsize cx t) l (fb-local! fb)]
                  (femit fb 21 l sz 0)   ; MUTCELL
                  (store! (field fb env)
                    (cs-cons a (load (field b name)) l (TPtr (box-type a t)) (load (field fb env)))))
              ; immutable: bind name -> a plain local holding the value
              (let [l (fb-local! fb)]
                (femit fb 3 l 0 0)       ; SETLOCAL
                (store! (field fb env)
                  (cs-cons a (load (field b name)) l t (load (field fb env)))))))
          (store! i (iadd (load i) 1))))))
  0)

; compile ONE expression; emit its bytecode (leaving exactly one value on the
; operand stack unless the path terminated) and RETURN its static type. This is
; the interpreter analogue of codegen_a64's emit-expr returning an AVal.
(defn compile-expr [(fb (ptr FB)) (e (ptr Expr))] (-> Type)
  (let [cx (load (field fb cx)) a (load (field cx a))]
    (match-else (load (field e kind))
      (EInt [v]   (do (femit fb 1 v 0 0) (TInt 64 true)))
      (EFloat [bits] (do (femit fb 1 bits 0 0) (TFloat 64)))
      (EBool [b]  (do (femit fb 1 (if b 1 0) 0 0) (TBool)))
      (EVar [name]
        (let [node (cs-find (load (field fb env)) name)]
          (if (icmp-eq (cast i64 node) 0)
              (do (idie2 "unbound variable: " name) (TInt 64 true))
            (do (femit fb 2 (load (field node slot)) 0 0) (load (field node ty))))))
      (ELet [binds body]
        (let [sv (load (field fb env))]
          (compile-binds fb binds)
          (let [bt (compile-seq fb body)] (store! (field fb env) sv) bt)))
      (EDo [body] (compile-seq fb body))
      (EBin [op lhs rhs]
        (let [tp (alloc-stack Type)]
          (store! tp (compile-expr fb lhs))
          (compile-expr fb rhs)
          (femit fb 8 op (tmode tp) (tsignbits tp))
          (load tp)))
      (ECmp [op lhs rhs]
        (let [tp (alloc-stack Type)]
          (store! tp (compile-expr fb lhs))
          (compile-expr fb rhs)
          (femit fb 9 op (tmode tp) (tsigned tp))
          (TBool)))
      (ENot [inner]
        (let [t (compile-expr fb inner)]
          (femit fb 10 (isbool01 t) 0 0) t))
      (EIf [cnd thn els]
        (do (compile-expr fb cnd)
            (let [lelse (fnew-label fb) lend (fnew-label fb)]
              (femit fb 12 lelse 0 0)                     ; JZ lelse
              (let [tt (compile-expr fb thn) thnterm (load (field fb term))]
                (if thnterm 0 (femit fb 11 lend 0 0))     ; JMP lend
                (store! (field fb term) false)
                (fbind-label fb lelse)
                (let [et (compile-expr fb els) elsterm (load (field fb term))]
                  (fbind-label fb lend)
                  (store! (field fb term) (and thnterm elsterm))
                  (if thnterm et tt))))))
      (ELoop [label body]
        (let [contlabel (fnew-label fb) breaklabel (fnew-label fb) resultl (fb-local! fb)
              gl (alloc-stack CLoop)]
          (store! (field gl contlabel) contlabel) (store! (field gl breaklabel) breaklabel)
          (store! (field gl resultlocal) resultl) (store! (field gl label) label)
          (store! (field gl has_res) false)      (store! (field gl resty) (TInt 64 true))
          (al-push! (mut (field fb loops)) (load gl))
          (fbind-label fb contlabel)
          (compile-stmts fb body)
          (if (load (field fb term)) 0 (femit fb 11 contlabel 0 0))   ; JMP contlabel (loop)
          (let [nn (al-len [CLoop] (load (field fb loops)))
                fin (ial-at [CLoop] (field fb loops) (isub nn 1))
                had (load (field fin has_res)) rty (load (field fin resty))]
            (store! (field (field fb loops) len) (isub nn 1))         ; pop loop frame
            (fbind-label fb breaklabel)
            (if had (femit fb 2 resultl 0 0) (femit fb 1 0 0 0))      ; push loop value (or dead 0)
            (store! (field fb term) (not had))
            rty)))
      (EBreak [label value]
        (let [li (cloop-index fb label) lp (ial-at [CLoop] (field fb loops) li)]
          (match value
            (Some [ve] (let [vt (compile-expr fb ve)]
                         (femit fb 3 (load (field lp resultlocal)) 0 0)   ; SETLOCAL resultlocal
                         (store! (field lp resty) vt)))
            (None []   (do (femit fb 1 0 0 0)                            ; push 0
                           (femit fb 3 (load (field lp resultlocal)) 0 0))))
          (store! (field lp has_res) true)
          (femit fb 11 (load (field lp breaklabel)) 0 0)                 ; JMP breaklabel
          (store! (field fb term) true)
          (TInt 64 true)))
      (EContinue [label]
        (let [li (cloop-index fb label) lp (ial-at [CLoop] (field fb loops) li)]
          (femit fb 11 (load (field lp contlabel)) 0 0)
          (store! (field fb term) true)
          (TInt 64 true)))
      (ECall [func targs args] (compile-call fb func args))
      (ELoad [inner]
        (let [tp (alloc-stack Type)]
          (store! tp (compile-expr fb inner))
          (let [pt (alloc-stack Type)]
            (store! pt (ty-pointee2 tp))
            (let [sz (isize-of cx pt)]
              (if (icmp-gt sz 8) (idie "load of an aggregate (>8 bytes) not implemented in interp yet")
                (femit fb 6 sz (if (signed-of pt) 1 0) 0))
              (load pt)))))
      (EStore [p val]
        (do (compile-expr fb p)
            (let [vt (alloc-stack Type)]
              (store! vt (compile-expr fb val))
              (let [sz (isize-of cx vt)]
                (if (icmp-gt sz 8) (idie "store of an aggregate (>8 bytes) not implemented in interp yet")
                  (femit fb 7 sz 0 0))
                (TInt 64 true)))))
      (ECast [t inner]
        (let [st (alloc-stack Type)]
          (store! st (compile-expr fb inner))
          (match-else t
            (TInt [dbits dsigned]
              (do (if (ty-is-float2 st)
                      (femit fb 18 dbits (if dsigned 1 0) (fbytes-of st))    ; F2I
                    (femit fb 16 dbits (if dsigned 1 0) 0))                  ; ICANON
                  t))
            (TFloat [dbits]
              (do (if (ty-is-float2 st)
                      (femit fb 19 (idiv dbits 8) (fbytes-of st) 0)          ; F2F
                    (femit fb 17 (idiv dbits 8) (if (signed-of st) 1 0) 0))  ; I2F
                  t))
            (_ t))))   ; ptr / fnptr / bool targets: identity 8-byte value
      (EAlloc [storage t]
        (let [tp (alloc-stack Type)]
          (store! tp t)
          (let [sz (isize-of cx tp) al (ialign-of cx tp)]
            (cond (icmp-eq storage 0) (femit fb 5 sz al 0)     ; stack (uninit)
                  (icmp-eq storage 2) (femit fb 23 sz 0 0)     ; heap malloc
                  (femit fb 24 sz 0 0))                        ; static (malloc+zero)
            (TPtr (box-type a t)))))
      (EZeroed [t]
        (let [tp (alloc-stack Type)]
          (store! tp t)
          (if (icmp-le (isize-of cx tp) 8) (femit fb 1 0 0 0)
            (femit fb 31 (isize-of cx tp) (ialign-of cx tp) 0))
          t))
      (EFree [inner] (do (compile-expr fb inner) (femit fb 22 0 0 0) (TInt 64 true)))
      (ESizeOf [t]  (let [tp (alloc-stack Type)] (store! tp t) (femit fb 1 (isize-of cx tp) 0 0) (TInt 64 true)))
      (EAlignOf [t] (let [tp (alloc-stack Type)] (store! tp t) (femit fb 1 (ialign-of cx tp) 0 0) (TInt 64 true)))
      (EStr [sv]  (do (femit fb 30 (intern-bytes sv) (slice-len sv) 0) (TSlice (box-type a (TInt 8 false)))))
      (ECStr [sv] (do (femit fb 1 (intern-bytes sv) 0 0) (TPtr (box-type a (TInt 8 true)))))
      (EBorrow [m place] (compile-expr fb place))
      (ESpillRef [inner]
        (let [t (compile-expr fb inner)]
          (let [sz (tsize cx t) l (fb-local! fb)]
            (femit fb 21 l sz 0) (femit fb 2 l 0 0)
            (TPtr (box-type a t)))))
      (EField [p fn0]  (do (idie "EField (struct field access) not implemented in interp yet") (TInt 64 true)))
      (EIndex [p idx]  (do (idie "EIndex not implemented in interp yet") (TInt 64 true)))
      (EConstruct [s v ar] (do (idie "EConstruct (sum construction) not implemented in interp yet") (TInt 64 true)))
      (EMatch [sc ar]  (do (idie "EMatch not implemented in interp yet") (TInt 64 true)))
      (_ (do (idie "unimplemented expression kind reached the interpreter compiler") (TInt 64 true))))))

; compile function `fi` on first reference (self-recursion is guarded by marking
; state=1 BEFORE compiling the body). Only functions reachable from main are ever
; compiled, so unused stdlib functions using not-yet-implemented features never
; force a hard error.
(defn ensure-compiled [(cx (ptr Interp)) (fi i64)] (-> i64)
  (let [bf (ial-at [BFunc] (field cx bfuncs) fi)]
    (if (icmp-eq (load (field bf state)) 0)
        (do (store! (field bf state) 1)
            (compile-func cx (ial-at [Func] (load (field (load (field cx mp)) funcs)) fi) fi))
      0)))

; compile one mono'd function into cx.bfuncs[fidx] (name/nparams/retty were set
; by pre-registration so calls resolve regardless of compile order).
(defn compile-func [(cx (ptr Interp)) (fd (ptr Func)) (fidx i64)] (-> i64)
  (let [a (load (field cx a)) fb (alloc-stack FB)]
    (store! (field fb cx) cx)
    (store! (field fb code)   (al-new [Instr] a))
    (store! (field fb loops)  (al-new [CLoop] a))
    (store! (field fb labels) (al-new [i64] a))
    (store! (field fb nlocals) 0)
    (store! (field fb env) (cast (ptr CScope) 0))
    (store! (field fb term) false)
    (let [ps (load (field fd params)) np (al-len [Param] (load ps)) (mut i) 0]
      (loop (if (icmp-ge (load i) np) (break)
        (do (let [p (ial-at [Param] ps (load i)) slot (fb-local! fb)]
              (store! (field fb env)
                (cs-cons a (load (field p name)) slot (load (field p ty)) (load (field fb env)))))
            (store! i (iadd (load i) 1))))))
    (compile-seq fb (load (field fd body)))
    (femit fb 15 0 0 0)   ; RET (pops the body's value)
    (resolve-labels fb)
    (let [bf (ial-at [BFunc] (field cx bfuncs) fidx)]
      (store! (field bf nlocals) (load (field fb nlocals)))
      (store! (field bf code) (box-al [Instr] a (load (field fb code)))))
    0))

; ============================ real memory model ==============================
(defn mem-load [(addr i64) (sz i64) (signed bool)] (-> i64)
  (cond (icmp-eq sz 8) (load (cast (ptr i64) addr))
        (icmp-eq sz 4) (if signed (cast i64 (load (cast (ptr i32) addr))) (cast i64 (load (cast (ptr u32) addr))))
        (icmp-eq sz 2) (if signed (cast i64 (load (cast (ptr i16) addr))) (cast i64 (load (cast (ptr u16) addr))))
        (icmp-eq sz 1) (if signed (cast i64 (load (cast (ptr i8) addr))) (cast i64 (load (cast (ptr u8) addr))))
        (do (idie "mem-load: bad size") 0)))
(defn mem-store [(addr i64) (v i64) (sz i64)] (-> i64)
  (cond (icmp-eq sz 8) (do (store! (cast (ptr i64) addr) v) 0)
        (icmp-eq sz 4) (do (store! (cast (ptr i32) addr) (cast i32 v)) 0)
        (icmp-eq sz 2) (do (store! (cast (ptr i16) addr) (cast i16 v)) 0)
        (icmp-eq sz 1) (do (store! (cast (ptr i8) addr) (cast i8 v)) 0)
        (do (idie "mem-store: bad size") 0)))
(defn memzero [(addr i64) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (icmp-ge (load i) n) (break)
      (do (store! (cast (ptr u8) (iadd addr (load i))) (cast u8 0))
          (store! i (iadd (load i) 1))))))
  0)
; bump-allocate `size` bytes (aligned) from the frame buffer; returns a real host
; address. Overflow of the fixed frame buffer is a hard error, never silent.
(defn frame-alloc [(base i64) (offc (ptr i64)) (size i64) (align i64)] (-> i64)
  (let [al (if (icmp-le align 1) 1 align)
        off (imul (idiv (iadd (load offc) (isub al 1)) al) al)
        addr (iadd base off)]
    (store! offc (iadd off size))
    (if (icmp-gt (load offc) 1048576) (idie "frame overflow: stack allocation exceeded 1 MiB frame buffer") 0)
    addr))

; ============================ float bit-casts ================================
(defn bits->f64 [(b i64)] (-> f64) (let [p (alloc-stack i64)] (store! p b) (load (cast (ptr f64) p))))
(defn f64->bits [(x f64)] (-> i64) (let [p (alloc-stack f64)] (store! p x) (load (cast (ptr i64) p))))
(defn bits->f32 [(b i64)] (-> f32) (let [p (alloc-stack i32)] (store! p (cast i32 b)) (load (cast (ptr f32) p))))
(defn f32->bits [(x f32)] (-> i64) (let [p (alloc-stack f32)] (store! p x) (cast i64 (cast u32 (load (cast (ptr i32) p))))))

(defn f64-frem-unsupported [] (-> f64) (do (idie "float remainder (frem) not implemented in interp yet") (bits->f64 0)))
(defn f32-frem-unsupported [] (-> f32) (do (idie "float remainder (frem) not implemented in interp yet") (bits->f32 0)))

; ============================ VM arithmetic =================================
; canonicalize `v` to exact iN width (container invariant: values are sign/zero
; extended from bit N-1). No-op for 64-bit — the common case.
(defn canon-int [(v i64) (bits i64) (signed bool)] (-> i64)
  (if (icmp-ge bits 64) v
    (if signed
        (let [sh (isub 64 bits)] (ishr (ishl v sh) sh))
      (iand v (isub (ishl 1 bits) 1)))))

(defn ult [(a i64) (b i64)] (-> bool) (icmp-lt (ixor a (ishl 1 63)) (ixor b (ishl 1 63))))
(defn ule [(a i64) (b i64)] (-> bool) (icmp-le (ixor a (ishl 1 63)) (ixor b (ishl 1 63))))
(defn ugt [(a i64) (b i64)] (-> bool) (icmp-gt (ixor a (ishl 1 63)) (ixor b (ishl 1 63))))
(defn uge [(a i64) (b i64)] (-> bool) (icmp-ge (ixor a (ishl 1 63)) (ixor b (ishl 1 63))))
(defn b01 [(x bool)] (-> i64) (if x 1 0))

(defn do-bin [(op i64) (mode i64) (c i64) (l i64) (r i64)] (-> i64)
  (if (icmp-eq mode 0)
      (let [signed (icmp-ne (iand c 1) 0) bits (ishr c 1)
            v (cond (icmp-eq op 0) (iadd l r)
                    (icmp-eq op 1) (isub l r)
                    (icmp-eq op 2) (imul l r)
                    (icmp-eq op 3) (if signed (idiv l r) (udiv l r))
                    (icmp-eq op 4) (if signed (irem l r) (urem l r))
                    (icmp-eq op 5) (udiv l r)
                    (icmp-eq op 6) (urem l r)
                    (icmp-eq op 7) (iand l r)
                    (icmp-eq op 8) (ior l r)
                    (icmp-eq op 9) (ixor l r)
                    (icmp-eq op 10) (ishl l r)
                    (icmp-eq op 11) (ishr l r)
                    (idie "do-bin: bad integer op"))]
        (canon-int v bits signed))
    (if (icmp-eq mode 2)
        (let [lf (bits->f64 l) rf (bits->f64 r)]
          (f64->bits (cond (icmp-eq op 0) (fadd lf rf) (icmp-eq op 1) (fsub lf rf)
                           (icmp-eq op 2) (fmul lf rf) (icmp-eq op 3) (fdiv lf rf)
                           (f64-frem-unsupported))))
      (let [lf (bits->f32 l) rf (bits->f32 r)]
        (f32->bits (cond (icmp-eq op 0) (fadd lf rf) (icmp-eq op 1) (fsub lf rf)
                         (icmp-eq op 2) (fmul lf rf) (icmp-eq op 3) (fdiv lf rf)
                         (f32-frem-unsupported)))))))

(defn do-cmp [(op i64) (mode i64) (signed i64) (l i64) (r i64)] (-> i64)
  (if (icmp-eq mode 0)
      (if (icmp-ne signed 0)
          (cond (icmp-eq op 0) (b01 (icmp-lt l r)) (icmp-eq op 1) (b01 (icmp-le l r))
                (icmp-eq op 2) (b01 (icmp-gt l r)) (icmp-eq op 3) (b01 (icmp-ge l r))
                (icmp-eq op 4) (b01 (icmp-eq l r)) (b01 (icmp-ne l r)))
        (cond (icmp-eq op 0) (b01 (ult l r)) (icmp-eq op 1) (b01 (ule l r))
              (icmp-eq op 2) (b01 (ugt l r)) (icmp-eq op 3) (b01 (uge l r))
              (icmp-eq op 4) (b01 (icmp-eq l r)) (b01 (icmp-ne l r))))
    (if (icmp-eq mode 2)
        (let [lf (bits->f64 l) rf (bits->f64 r)]
          (cond (icmp-eq op 0) (b01 (fcmp-lt lf rf)) (icmp-eq op 1) (b01 (fcmp-le lf rf))
                (icmp-eq op 2) (b01 (fcmp-gt lf rf)) (icmp-eq op 3) (b01 (fcmp-ge lf rf))
                (icmp-eq op 4) (b01 (fcmp-eq lf rf)) (b01 (fcmp-ne lf rf))))
      (let [lf (bits->f32 l) rf (bits->f32 r)]
        (cond (icmp-eq op 0) (b01 (fcmp-lt lf rf)) (icmp-eq op 1) (b01 (fcmp-le lf rf))
              (icmp-eq op 2) (b01 (fcmp-gt lf rf)) (icmp-eq op 3) (b01 (fcmp-ge lf rf))
              (icmp-eq op 4) (b01 (fcmp-eq lf rf)) (b01 (fcmp-ne lf rf)))))))

(defn i2f [(v i64) (fbytes i64) (srcsigned i64)] (-> i64)
  (if (icmp-eq fbytes 4) (f32->bits (cast f32 v)) (f64->bits (cast f64 v))))
(defn f2i [(v i64) (destbits i64) (destsigned i64) (srcfbytes i64)] (-> i64)
  (let [x (if (icmp-eq srcfbytes 4) (cast f64 (bits->f32 v)) (bits->f64 v))]
    (canon-int (cast i64 x) destbits (icmp-ne destsigned 0))))
(defn f2f [(v i64) (destbytes i64) (srcbytes i64)] (-> i64)
  (if (icmp-eq destbytes srcbytes) v
    (if (icmp-eq destbytes 8) (f64->bits (cast f64 (bits->f32 v)))
      (f32->bits (cast f32 (bits->f64 v))))))

; ============================ FFI dispatch ==================================
; Builtin table: dispatch an extern call to the REAL native libc function by its
; C symbol name. This is self-contained (no dlsym) and every entry is a genuine
; native call with the correct signature. An extern not in the table hard-errors
; — never a silent no-op.
(defn extern-call [(cx (ptr Interp)) (ei i64) (buf (ptr i64)) (n i64)] (-> i64)
  (let [nm (last-component2 (load (field (ial-at [Extern] (load (field cx externs)) ei) name)))]
    (cond
      (str-eq nm "putchar") (interp.putchar (load (index buf 0)))
      (str-eq nm "putc")    (interp.putchar (load (index buf 0)))
      (str-eq nm "write")   (cast i64 (interp.write (cast i32 (load (index buf 0))) (cast (ptr i8) (load (index buf 1))) (cast isize (load (index buf 2)))))
      (str-eq nm "puts")    (interp.puts (cast (ptr i8) (load (index buf 0))))
      (str-eq nm "exit")    (interp.exit (cast i32 (load (index buf 0))))
      (str-eq nm "malloc")  (cast i64 (interp.malloc (load (index buf 0))))
      (str-eq nm "free")    (do (interp.free (cast (ptr i8) (load (index buf 0)))) 0)
      (do (idie2 "unsupported extern (add it to the interp builtin table): " nm) 0))))

; ============================ the VM ========================================
(defn vpush [(ops (ptr i64)) (spc (ptr i64)) (v i64)] (-> i64)
  (store! (index ops (load spc)) v) (store! spc (iadd (load spc) 1)) 0)
(defn vpop [(ops (ptr i64)) (spc (ptr i64))] (-> i64)
  (let [t (isub (load spc) 1)] (store! spc t) (load (index ops t))))

; execute compiled function `fidx` with `argc` i64 arguments; return its i64
; result. Recursion uses the host call stack (one vm-exec activation per call).
(defn vm-exec [(cx (ptr Interp)) (fidx i64) (argv (ptr i64)) (argc i64)] (-> i64)
  (let [bf (ial-at [BFunc] (field cx bfuncs) fidx)
        nl (load (field bf nlocals))
        nlb (if (icmp-le nl 1) 1 nl)
        locals (cast (ptr i64) (interp.malloc (imul nlb 8)))
        framemem (cast i64 (interp.malloc 1048576))
        ops (cast (ptr i64) (interp.malloc 32768))
        spc (alloc-stack i64)
        memoffc (alloc-stack i64)
        code (load (field bf code))
        argbuf (alloc-stack (array i64 32))
        (mut pc) 0 (mut halt) false (mut retval) 0]
    (store! spc 0) (store! memoffc 0)
    (let [(mut i) 0]
      (loop (if (icmp-ge (load i) argc) (break)
        (do (store! (index locals (load i)) (load (index argv (load i))))
            (store! i (iadd (load i) 1))))))
    (loop
      (if (load halt) (break)
        (let [ins (ial-at [Instr] code (load pc))
              op (load (field ins op)) a (load (field ins a))
              b (load (field ins b)) c (load (field ins c))]
          (store! pc (iadd (load pc) 1))
          (case op
            1  (vpush ops spc a)
            2  (vpush ops spc (load (index locals a)))
            3  (store! (index locals a) (vpop ops spc))
            4  (do (vpop ops spc) 0)
            5  (vpush ops spc (frame-alloc framemem memoffc a b))
            6  (let [addr (vpop ops spc)] (vpush ops spc (mem-load addr a (icmp-ne b 0))))
            7  (let [v (vpop ops spc) addr (vpop ops spc)] (do (mem-store addr v a) (vpush ops spc 0)))
            8  (let [r (vpop ops spc) l (vpop ops spc)] (vpush ops spc (do-bin a b c l r)))
            9  (let [r (vpop ops spc) l (vpop ops spc)] (vpush ops spc (do-cmp a b c l r)))
            10 (let [v (vpop ops spc)] (vpush ops spc (if (icmp-ne a 0) (if (icmp-eq v 0) 1 0) (ixor v -1))))
            11 (store! pc a)
            12 (let [v (vpop ops spc)] (if (icmp-eq v 0) (store! pc a) 0))
            13 (let [(mut k) (isub b 1)]
                 (loop (if (icmp-lt (load k) 0) (break)
                   (do (store! (index (cast (ptr i64) argbuf) (load k)) (vpop ops spc))
                       (store! k (isub (load k) 1)))))
                 (vpush ops spc (vm-exec cx a (cast (ptr i64) argbuf) b)))
            14 (let [(mut k) (isub b 1)]
                 (loop (if (icmp-lt (load k) 0) (break)
                   (do (store! (index (cast (ptr i64) argbuf) (load k)) (vpop ops spc))
                       (store! k (isub (load k) 1)))))
                 (vpush ops spc (extern-call cx a (cast (ptr i64) argbuf) b)))
            15 (do (store! retval (vpop ops spc)) (store! halt true) 0)
            16 (let [v (vpop ops spc)] (vpush ops spc (canon-int v a (icmp-ne b 0))))
            17 (let [v (vpop ops spc)] (vpush ops spc (i2f v a b)))
            18 (let [v (vpop ops spc)] (vpush ops spc (f2i v a b c)))
            19 (let [v (vpop ops spc)] (vpush ops spc (f2f v a b)))
            21 (let [v (vpop ops spc) addr (frame-alloc framemem memoffc b 8)]
                 (do (mem-store addr v b) (store! (index locals a) addr)))
            22 (let [addr (vpop ops spc)] (do (interp.free (cast (ptr i8) addr)) (vpush ops spc 0)))
            23 (vpush ops spc (cast i64 (interp.malloc a)))
            24 (let [addr (cast i64 (interp.malloc a))] (do (memzero addr a) (vpush ops spc addr)))
            30 (let [addr (frame-alloc framemem memoffc 16 8)]
                 (do (mem-store addr a 8) (mem-store (iadd addr 8) b 8) (vpush ops spc addr)))
            31 (let [addr (frame-alloc framemem memoffc a b)] (do (memzero addr a) (vpush ops spc addr)))
            (do (idie "VM: bad opcode") 0)))))
    (interp.free (cast (ptr i8) locals))
    (interp.free (cast (ptr i8) framemem))
    (interp.free (cast (ptr i8) ops))
    (load retval)))

; ============================ top-level entry ================================
; Compile every mono'd function to bytecode, then run `main` and return its i64
; (the process exit code). Registration happens BEFORE compilation so calls
; resolve by name regardless of order.
(defn interp-program [(a (ptr Allocator)) (mp (ptr Program))] (-> i64)
  (let [cx (alloc-stack Interp)]
    (store! (field cx a) a)
    (store! (field cx mp) mp)
    (store! (field cx externs) (load (field mp externs)))
    (store! (field cx bfuncs) (al-new [BFunc] a))
    ; pre-register: name + nparams + retty for every func (calls need these).
    (let [fs (load (field mp funcs)) n (al-len [Func] (load fs)) (mut i) 0 bf0 (alloc-stack BFunc)]
      (loop (if (icmp-ge (load i) n) (break)
        (do (let [fd (ial-at [Func] fs (load i))]
              (store! (field bf0 name) (load (field fd name)))
              (store! (field bf0 nparams) (al-len [Param] (load (field fd params))))
              (store! (field bf0 nlocals) 0)
              (store! (field bf0 code) (cast (ptr (ArrayList Instr)) 0))
              (store! (field bf0 retty) (load (field fd ret)))
              (store! (field bf0 state) 0)
              (al-push! (mut (field cx bfuncs)) (load bf0)))
            (store! i (iadd (load i) 1))))))
    ; lazily compile from main (transitively compiles exactly the reachable set),
    ; then run it. main's i64 return is the process exit code.
    (let [mi (find-func cx "main")]
      (if (icmp-lt mi 0) (do (idie "no `main` function in program") 1)
        (do (ensure-compiled cx mi)
            (let [argbuf (alloc-stack (array i64 4))]
              (vm-exec cx mi (cast (ptr i64) argbuf) 0)))))))
