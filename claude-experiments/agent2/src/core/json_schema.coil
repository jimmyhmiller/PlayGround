(module harness-json-schema)

(import "alloc.coil" :use *)
(import "arraylist.coil" :use *)
(import "match.coil" :use *)
(import "result.coil" :use *)
(import "slice.coil" :use *)
(import "str.coil" :use *)
(import "../core/json.coil" :use *)

(defstruct SchemaValidation
  [(ok bool)
   (path (slice u8))
   (message (slice u8))])

(defn schema-valid [] (-> SchemaValidation)
  (let [result (alloc-stack SchemaValidation)]
    (store! (field result ok) true)
    (store! (field result path) "$")
    (store! (field result message) "")
    (load result)))

(defn schema-invalid [(path (slice u8)) (message (slice u8))] (-> SchemaValidation)
  (let [result (alloc-stack SchemaValidation)]
    (store! (field result ok) false)
    (store! (field result path) path)
    (store! (field result message) message)
    (load result)))

(defn json-value-type [(value Json)] (-> (slice u8))
  (match value
    (JsonNull [] "null")
    (JsonBool [flag] "boolean")
    (JsonNumber [raw]
                (if (or (match (str-find raw ".") (Some [index] true) (None [] false))
                        (or (match (str-find raw "e") (Some [index] true) (None [] false))
                            (match (str-find raw "E") (Some [index] true) (None [] false))))
                    "number"
                    "integer"))
    (JsonString [text] "string")
    (JsonArray [items] "array")
    (JsonObject [keys values] "object")))

(defn schema-type-matches? [(expected (slice u8)) (value Json)] (-> bool)
  (let [actual (json-value-type value)]
    (or (str-eq expected actual)
        (and (str-eq expected "number") (str-eq actual "integer")))))

(defn schema-allows-type? [(schema Json) (value Json)] (-> bool)
  (let [wire (json-get schema "type")]
    (match-else wire
                (JsonNull [] true)
                (JsonString [expected] (schema-type-matches? expected value))
                (JsonArray [items]
                           (let [(mut i) 0
                                 n (al-len [Json] (load items))
                                 (mut allowed) false]
                             (loop (if (icmp-ge (load i) n)
                                       (break)
                                       (match-else (al-get [Json] (load items) (load i))
                                                   (JsonString [expected]
                                                               (if (schema-type-matches? expected value)
                                                                   (do (store! allowed true) (break))
                                                                   (store! i (iadd (load i) 1))))
                                                   (_ (store! i (iadd (load i) 1))))))
                             (load allowed)))
                (_ false))))

(defn json-schema-equal? [(allocator (ptr Allocator)) (left Json) (right Json)] (-> bool)
  (str-eq (json-stringify allocator left) (json-stringify allocator right)))

(defn schema-enum-valid? [(allocator (ptr Allocator)) (schema Json) (value Json)] (-> bool)
  (match-else (json-get schema "enum")
              (JsonNull [] true)
              (JsonArray [items]
                         (let [(mut i) 0
                               n (al-len [Json] (load items))
                               (mut found) false]
                           (loop (if (icmp-ge (load i) n)
                                     (break)
                                     (if (json-schema-equal? allocator
                                                             (al-get [Json] (load items) (load i))
                                                             value)
                                         (do (store! found true) (break))
                                         (store! i (iadd (load i) 1)))))
                           (load found)))
              (_ false)))

(defn schema-required-valid? [(schema Json) (value Json)] (-> bool)
  (match-else (json-get schema "required")
              (JsonNull [] true)
              (JsonArray [required]
                         (let [(mut i) 0
                               n (al-len [Json] (load required))
                               (mut valid) true]
                           (loop (if (icmp-ge (load i) n)
                                     (break)
                                     (match-else (al-get [Json] (load required) (load i))
                                                 (JsonString [key]
                                                             (if (json-has-key? value key)
                                                                 (store! i (iadd (load i) 1))
                                                                 (do (store! valid false) (break))))
                                                 (_ (do (store! valid false) (break))))))
                           (load valid)))
              (_ false)))

(defn schema-properties-valid? [(allocator (ptr Allocator)) (schema Json) (value Json) (depth i64)] (-> SchemaValidation)
  (let [properties (json-get schema "properties")]
    (match (json-object-keys value)
      (None [] (schema-valid))
      (Some [keys]
            (let [(mut i) 0
                  n (al-len [(slice u8)] (load keys))
                  (mut result) (schema-valid)
                  additional
                    (match (json-bool-value (json-get schema "additionalProperties"))
                      (Some [flag] flag)
                      (None [] true))]
              (loop (if (or (icmp-ge (load i) n) (not (load (field result ok))))
                        (break)
                        (let [key (al-get [(slice u8)] (load keys) (load i))]
                          (if (json-has-key? properties key)
                              (store! result
                                      (json-schema-validate-depth allocator
                                                                  (json-get properties key)
                                                                  (json-get value key)
                                                                  key
                                                                  (iadd depth 1)))
                              (if additional
                                  0
                                  (store! result
                                          (schema-invalid key "additional property is not allowed"))))
                          (store! i (iadd (load i) 1)))))
              (load result))))))

(defn schema-array-valid? [(allocator (ptr Allocator)) (schema Json) (value Json) (path (slice u8)) (depth i64)] (-> SchemaValidation)
  (let [item-schema (json-get schema "items")]
    (match-else value
                (JsonArray [items]
                           (let [(mut i) 0
                                 n (al-len [Json] (load items))
                                 (mut result) (schema-valid)]
                             (loop (if (or (icmp-ge (load i) n) (not (load (field result ok))))
                                       (break)
                                       (do
                                         (store! result
                                                 (json-schema-validate-depth allocator
                                                                             item-schema
                                                                             (al-get [Json] (load items) (load i))
                                                                             path
                                                                             (iadd depth 1)))
                                         (store! i (iadd (load i) 1)))))
                             (load result)))
                (_ (schema-valid)))))

(defn schema-any-of-valid? [(allocator (ptr Allocator)) (schema Json) (value Json) (path (slice u8)) (depth i64)] (-> bool)
  (match-else (json-get schema "anyOf")
              (JsonNull [] true)
              (JsonArray [choices]
                         (let [(mut i) 0
                               n (al-len [Json] (load choices))
                               (mut valid) false]
                           (loop (if (icmp-ge (load i) n)
                                     (break)
                                     (let [result
                                             (json-schema-validate-depth allocator
                                                                         (al-get [Json] (load choices) (load i))
                                                                         value
                                                                         path
                                                                         (iadd depth 1))]
                                       (if (load (field result ok))
                                           (do (store! valid true) (break))
                                           (store! i (iadd (load i) 1))))))
                           (load valid)))
              (_ false)))

;; Validate the JSON Schema subset shared by OpenAI strict tools and DeepSeek:
;; object/properties/required/additionalProperties, arrays/items, primitive types,
;; nullable type unions, enum, and anyOf. Unknown annotation keywords are ignored.
(defn json-schema-validate-depth [(allocator (ptr Allocator))
                                  (schema Json)
                                  (value Json)
                                  (path (slice u8))
                                  (depth i64)] (-> SchemaValidation)
  (if (icmp-gt depth 64)
      (schema-invalid path "schema nesting exceeds 64 levels")
      (if (json-has-key? schema "anyOf")
          (if (schema-any-of-valid? allocator schema value path depth)
              (schema-valid)
              (schema-invalid path "value does not match anyOf"))
          (if (not (schema-allows-type? schema value))
              (schema-invalid path "value has the wrong JSON type")
              (if (not (schema-enum-valid? allocator schema value))
                  (schema-invalid path "value is not in enum")
                  (let [actual (json-value-type value)]
                    (cond (str-eq actual "object")
                            (if (schema-required-valid? schema value)
                                (schema-properties-valid? allocator schema value depth)
                                (schema-invalid path "required property is missing"))
                          (str-eq actual "array") (schema-array-valid? allocator schema value path depth)
                          :else (schema-valid))))))))

(defn json-schema-validate [(allocator (ptr Allocator)) (schema Json) (value Json)] (-> SchemaValidation)
  (json-schema-validate-depth allocator schema value "$" 0))

(defn json-schema-valid? [(schema Json) (value Json)] (-> bool)
  (let [result (json-schema-validate (malloc-allocator) schema value)]
    (load (field result ok))))
