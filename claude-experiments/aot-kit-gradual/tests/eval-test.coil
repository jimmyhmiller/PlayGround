;; M3 slice 2: the IR interpreter, and the differential property it exists for.
;;
;; Two halves. First the interpreter is pinned against hand-computed answers, because an oracle
;; nobody checked is not an oracle. Then the property that makes it valuable: for every corpus
;; program that exists in both a raw and an optimised build, both builds must produce the SAME
;; observable result, under many argument bindings.
;;
;; That second half is what every milestone after this one is gated on. A golden string tells you a
;; graph changed; only this tells you it still computes the same thing.
;;
;;   coil test tests/eval-test.coil
(module evaltest)

(import "../src/ty.coil"     :use *)
(import "../src/shape.coil"  :use *)
(import "../src/node.coil"   :use *)
(import "../src/corpus.coil" :use *)
(import "../src/eval.coil"   :use *)
(import "assert.coil"        :use *)
(import "control.coil"       :use *)
(import "io.coil"            :use *)
(import "fmt.coil"           :use *)
(import "alloc.coil"         :use *)
(import "arraylist.coil"     :use *)
(import "slice.coil"         :use *)

(const BUDGET i64 100000)

(defn a-arg [(t i64)] (-> i64) (n-peephole (n-new1 OP-ARG t (g-start))))
(defn a-int [(v i64)] (-> i64) (n-const (t-int-con v)))
(defn a-con [(t i64)] (-> i64) (n-const t))
(defn a-bin [(op i64) (a i64) (b i64)] (-> i64) (n-peephole (n-new3 op 0 NO-NODE a b)))
(defn a-un  [(op i64) (a i64)] (-> i64) (n-peephole (n-new2 OP-MINUS 0 NO-NODE a)))
(defn a-ret [(v i64)] (-> i64)
  (let [r (n-peephole (n-new2 OP-RETURN 0 (g-start) v))]
    (n-add-def! (g-stop) r) (n-peephole (g-stop)) (iterate!) r))

(defn fail [(what (slice u8))] (-> i64)
  (let [w (stderr)]
    (ps w "\n") (ps w what) (ps w "\n  eval: ") (ev-print w) (ps w "\n")
    (g-print-flat w))
  (abort) 0)

;; Run the current graph with no arguments and require an integer result.
(defn expect-int [(what (slice u8)) (want i64)] (-> i64)
  (ev-run BUDGET)
  (if (!= (ev-status) EV-OK) (fail what) 0)
  (if (rt-eq? (ev-result) (RInt want)) 0
    (do (let [w (stderr)]
          (ps w "\n") (ps w what) (ps w "\n  want: ") (rt-print w (RInt want))
          (ps w "\n  got:  ") (rt-print w (ev-result)) (ps w "\n"))
        (abort) 0)))

(defn expect-bool [(what (slice u8)) (want bool)] (-> i64)
  (ev-run BUDGET)
  (if (!= (ev-status) EV-OK) (fail what) 0)
  (if (rt-eq? (ev-result) (RBool want)) 0 (fail what)))

(defn expect-status [(what (slice u8)) (want i64)] (-> i64)
  (ev-run BUDGET)
  (if (= (ev-status) want) 0
    (do (let [w (stderr)]
          (ps w "\n") (ps w what) (ps w "\n  want status: ") (ps w (ev-status-name want))
          (ps w "\n  got:         ") (ps w (ev-status-name (ev-status))) (ps w "\n"))
        (abort) 0)))

; ---------------------------------------------------------------------------
; The oracle is itself checked
; ---------------------------------------------------------------------------
(deftest straight_line_arithmetic
  (graph-reset! 1) (a-ret (a-int 7))                            (expect-int "7" 7)
  (graph-reset! 1) (a-ret (a-bin OP-ADD (a-int 2) (a-int 3)))    (expect-int "2+3" 5)
  (graph-reset! 1) (a-ret (a-bin OP-SUB (a-int 2) (a-int 9)))    (expect-int "2-9" -7)
  (graph-reset! 1) (a-ret (a-bin OP-MUL (a-int 6) (a-int 7)))    (expect-int "6*7" 42)
  (graph-reset! 1) (a-ret (a-bin OP-DIV (a-int 12) (a-int 4)))   (expect-int "12/4" 3)
  (graph-reset! 1) (a-ret (a-un OP-MINUS (a-int 5)))             (expect-int "-5" -5))

;; Inexact division leaves the integers, which is what the lattice claims with `num` and what the
;; interpreter has to actually do, or the two disagree about the language.
(deftest division_leaves_the_integers
  (graph-reset! 1)
  (a-ret (a-bin OP-DIV (a-int 1) (a-int 2)))
  (ev-run BUDGET)
  (assert (= (ev-status) EV-OK))
  (assert (rt-eq? (ev-result) (RFlt (f64-bits 0.5))))

  ; and dividing by zero is an infinity, not a trap
  (graph-reset! 1)
  (a-ret (a-bin OP-DIV (a-int 1) (a-int 0)))
  (ev-run BUDGET)
  (assert (= (ev-status) EV-OK))
  (assert (not (rt-eq? (ev-result) (RInt 0)))))

(deftest comparisons_and_truthiness
  (graph-reset! 1) (a-ret (a-bin OP-LT (a-int 1) (a-int 2)))  (expect-bool "1<2" true)
  (graph-reset! 1) (a-ret (a-bin OP-LT (a-int 2) (a-int 1)))  (expect-bool "2<1" false)
  (graph-reset! 1) (a-ret (a-bin OP-EQ (a-int 3) (a-int 3)))  (expect-bool "3==3" true)
  (graph-reset! 1) (a-ret (n-peephole (n-new2 OP-NOT 0 NO-NODE (a-int 0))))  (expect-bool "!0" true)
  (graph-reset! 1) (a-ret (n-peephole (n-new2 OP-NOT 0 NO-NODE (a-int 9))))  (expect-bool "!9" false))

;; The interpreter's truthiness and the compiler's must agree, or the interpreter takes a different
;; branch than the compiler predicted and the oracle is worse than useless. Checked directly, over
;; every constant the runtime domain can represent.
(deftest runtime_truthiness_agrees_with_the_lattice
  (let [n 9 (mut i) 0]
    (loop
      (if (>= (load i) n) (break)
        (let [v (case (load i)
                  0 (RInt 0) 1 (RInt 1) 2 (RInt -3)
                  3 (RBool true) 4 (RBool false)
                  5 (RUndef) 6 (RNull)
                  7 (RFlt (f64-bits 0.0))
                  8 (RFlt 9221120237041090560)          ; NaN, which is falsey
                  (RUndef))]
          (let [t (rt-ty v)
                runtime (rt-truthy? v)
                compiler-can-be-truthy (ty-can-be-truthy? t)
                compiler-can-be-falsey (ty-can-be-falsey? t)]
            ; each of these is a single concrete value, so the compiler must be DECIDED about it
            ; and must decide the same way the interpreter does
            (if (= runtime compiler-can-be-truthy) 0
              (do (let [w (stderr)]
                    (ps w "\ntruthiness disagreement on ") (rt-print w v)
                    (ps w " : ") (ty-print w t)
                    (fmt w "\n  interpreter says truthy={d}, lattice says can-be-truthy={d}\n"
                         (if runtime 1 0) (if compiler-can-be-truthy 1 0)))
                  (abort) 0))
            (if (!= runtime compiler-can-be-falsey) 0
              (do (let [w (stderr)]
                    (ps w "\nfalseyness disagreement on ") (rt-print w v) (ps w "\n"))
                  (abort) 0))
            0))
        )
      (store! i (+ (load i) 1))
      0)))

; ---------------------------------------------------------------------------
; Control flow
; ---------------------------------------------------------------------------
(deftest branches_take_the_right_arm
  ; if (arg) 10 else 20, with arg bound both ways
  (let [(mut trial) 0]
    (loop
      (if (>= (load trial) 2) (break)
        (do (graph-reset! 1)
            (let [a   (a-arg (t-dyn))
                  arms (n-if-arms! (n-peephole (n-new2 OP-IF 0 (g-start) a)))
                  t   (arms-t arms)
                  f   (arms-f arms)
                  r   (n-new OP-REGION 0)]
              (n-add-def! r NO-NODE) (n-add-def! r t) (n-add-def! r f)
              (let [ph (n-new OP-PHI (t-dyn))]
                (n-add-def! ph r) (n-add-def! ph (a-int 10)) (n-add-def! ph (a-int 20))
                (let [ret (n-peephole (n-new2 OP-RETURN 0 r ph))]
                  (n-add-def! (g-stop) ret) (n-peephole (g-stop))
                  (wl-push! r) (wl-push! ph) (iterate!))
                (ev-reset!)
                (ev-bind! a (if (= (load trial) 0) (RInt 1) (RInt 0)))
                (ev-run-nobind BUDGET)
                (assert (= (ev-status) EV-OK))
                (assert (rt-eq? (ev-result) (RInt (if (= (load trial) 0) 10 20)))))
              0)
            (store! trial (+ (load trial) 1))
            0)))))

;; A counted loop actually counts. This is the test that a Phi environment and simultaneous update
;; work: `i = 0; while (i < 5) i = i + 1; return i;` must return 5 and not 1, 0, or a hang.
(deftest a_counted_loop_counts
  (graph-reset! 1)
  (let [lp (n-new OP-LOOP 0)]
    (n-add-def! lp NO-NODE) (n-add-def! lp (g-start)) (n-add-def! lp NO-NODE)
    (n-peephole lp)
    (let [ph (n-new OP-PHI (t-int))]
      (n-add-def! ph lp) (n-add-def! ph (a-int 0)) (n-add-def! ph NO-NODE)
      (n-peephole ph)
      (let [nx   (a-bin OP-ADD ph (a-int 1))
            test (a-bin OP-LT ph (a-int 5))
            arms (n-if-arms! (n-peephole (n-new2 OP-IF 0 lp test)))
            body (arms-t arms)
            exit (arms-f arms)]
        (n-set-def! ph 2 nx)
        (n-set-def! lp 2 body)
        (let [ret (n-peephole (n-new2 OP-RETURN 0 exit ph))]
          (n-add-def! (g-stop) ret) (n-peephole (g-stop)))
        (wl-push! lp) (wl-push! ph) (wl-push! nx) (iterate!)
        (expect-int "counted loop to 5" 5))))

  ; And a loop whose test never fails reports the budget rather than hanging. Note it needs a real
  ; branch: a Loop whose back edge is ITSELF, with a Return hanging off it, is not an infinite loop
  ; at all. It is a loop nothing iterates, because control's only forward step is the Return. That
  ; distinction cost a debugging round, and it is the reason the corpus loop fixture was rebuilt
  ; with a genuine exit test.
  (graph-reset! 1)
  (let [lp (n-new OP-LOOP 0)]
    (n-add-def! lp NO-NODE) (n-add-def! lp (g-start)) (n-add-def! lp NO-NODE)
    (n-peephole lp)
    (let [ph (n-new OP-PHI (t-int))
          keep (a-arg (t-dyn))]
      (n-add-def! ph lp) (n-add-def! ph (a-int 0)) (n-add-def! ph NO-NODE)
      (n-peephole ph)
      (let [nx   (a-bin OP-ADD ph (a-int 1))
            arms (n-if-arms! (n-peephole (n-new2 OP-IF 0 lp keep)))
            body (arms-t arms)
            exit (arms-f arms)]
        (n-set-def! ph 2 nx)
        (n-set-def! lp 2 body)
        (let [ret (n-peephole (n-new2 OP-RETURN 0 exit ph))]
          (n-add-def! (g-stop) ret) (n-peephole (g-stop)))
        (wl-push! lp) (wl-push! ph) (wl-push! nx) (iterate!)
        (ev-reset!)
        (ev-bind! keep (RInt 1))            ; the test never fails, so control never leaves
        (ev-run-nobind 500)
        (assert (= (ev-status) EV-STEPS))))))

; ---------------------------------------------------------------------------
; It refuses to guess
; ---------------------------------------------------------------------------
;; Overflow is where a lazy interpreter would silently wrap and quietly disagree with JavaScript,
;; which promotes to a double. Reporting a named status is the honest answer until M5 gives the
;; runtime a value domain that can hold the result.
(deftest overflow_is_reported_not_wrapped
  (graph-reset! 1)
  (let [a (a-arg (t-int))]
    (a-ret (a-bin OP-ADD a a))
    (ev-reset!)
    (ev-bind! a (RInt 5000000000000000000))
    (ev-run-nobind BUDGET)
    (assert (= (ev-status) EV-OVERFLOW))))

(deftest an_unbound_argument_is_reported
  (graph-reset! 1)
  (let [a (a-arg (t-int))]
    (a-ret (a-bin OP-ADD a (a-int 1)))
    (expect-status "unbound arg" EV-UNBOUND)))

;; A Cast that fails at runtime means the compiler narrowed a type it had not proven. That is a
;; compiler bug and gets its own status, so a future guard that is placed wrongly is caught by
;; running the program rather than by inspecting the graph.
(deftest a_failing_cast_is_reported_as_a_compiler_bug
  (graph-reset! 1)
  (let [a (a-arg (t-dyn))
        c (n-peephole (n-new2 OP-CAST (t-int) (g-start) a))]
    (a-ret c)
    ; the cast survived, because nothing proved the argument is an int
    (assert (!= c a))
    ; bind it to something that satisfies the cast: fine
    (ev-reset!) (ev-bind! a (RInt 3)) (ev-run-nobind BUDGET)
    (assert (= (ev-status) EV-OK))
    (assert (rt-eq? (ev-result) (RInt 3)))
    ; bind it to something that does not: the cast is unsatisfied
    (ev-reset!) (ev-bind! a (RNull)) (ev-run-nobind BUDGET)
    (assert (= (ev-status) EV-CAST))))

;; The live node with this op, or a hard error. Structural lookups read better than node ids,
;; which shift whenever a builder gains a node.
(defn find-live-op [(op i64)] (-> i64)
  (let [n (n-count) (mut i) 0 (mut found) NO-NODE]
    (loop
      (if (>= (load i) n) (break)
        (do (if (and (and (not (n-dead? (load i))) (= (n-op (load i)) op)) (= (load found) NO-NODE))
                (store! found (load i))
              0)
            (store! i (+ (load i) 1))
            0)))
    (if (= (load found) NO-NODE)
        (do (let [w (stderr)] (ps w "\nfind-live-op: no live node with op ")
              (ps w (op-name op)) (ps w "\n") (g-print-flat w))
            (abort) NO-NODE)
      (load found))))

; ---------------------------------------------------------------------------
; A dead branch nested inside a live one
; ---------------------------------------------------------------------------
;; `if (p) return 1; else { if (0) return 2; else return 3; }`
;;
;; The reason this is a separate gate and the flat `if(0)` fixture is not enough: peepholing a
;; multi node's projections one at a time kills the multi in between, and the sibling's rewrite
;; then reaches for the killed If's control input. On the flat fixture that input is Start, which
;; is pinned, so the wrong answer happened to be the right node. Here it is an ordinary CProj, and
;; getting it wrong left the surviving Return reading a DEAD node: `p = 0` reported EV-STUCK
;; instead of 3. That is the observable half of the same defect `g-verify`'s VERR-DEAD-INPUT sees.
(deftest a_dead_branch_nested_in_a_live_one_still_runs
  (corpus-build! CX-NESTED-DEAD)
  (let [p (find-live-op OP-ARG)]
    ; the live outer branch still branches, and the inner one is gone entirely
    (assert (= (n-ty p) (t-dyn)))
    (ev-reset!) (ev-bind! p (RInt 1)) (ev-run-nobind BUDGET)
    (assert (= (ev-status) EV-OK))
    (assert (rt-eq? (ev-result) (RInt 1)))
    ; the arm the inner if(0) selects: 3, and never `2`, never STUCK
    (ev-reset!) (ev-bind! p (RInt 0)) (ev-run-nobind BUDGET)
    (if (= (ev-status) EV-OK) 0 (fail "the nested surviving arm did not run"))
    (assert (rt-eq? (ev-result) (RInt 3)))))

; ---------------------------------------------------------------------------
; An identity peephole may not change what the program does
; ---------------------------------------------------------------------------
;; `x+0`, `x-0`, `x*1` and `-(-x)` hold over the NUMBERS. A bool is not a number, and unlike a
;; string it exists in the interpreter's value domain, so this class is observable TODAY rather than
;; at M5. `ev-arith` deliberately reports EV-TYPE for a non-numeric operand instead of inventing an
;; answer; an unguarded peephole hands back the bool itself and the optimised build answers `true`
;; where the raw build reported a type error. Same program, two observable results.
(defn expect-same-status [(label (slice u8)) (raw i64) (opt i64)] (-> i64)
  (if (= raw opt) 0
    (do (let [w (stderr)]
          (ps w "\nRAW AND OPTIMISED DISAGREE: ") (ps w label)
          (ps w "\n  raw:       ") (ps w (ev-status-name raw))
          (ps w "\n  optimised: ") (ps w (ev-status-name opt)) (ps w "\n")
          (g-print-flat w))
        (abort) 0)))

(defn bin-identity-both-ways [(label (slice u8)) (op i64) (k i64)] (-> i64)
  ; RAW: analysed but never rewritten, so no identity can fire. This is the reference answer.
  (graph-reset! 1)
  (let [x (n-new1 OP-ARG (t-bool) (g-start))
        n (n-new3 op 0 NO-NODE x (n-new1 OP-CONST (t-int-con k) (g-start)))
        r (n-new2 OP-RETURN 0 (g-start) n)]
    (n-add-def! (g-stop) r)
    (g-analyze!)
    (ev-reset!) (ev-bind! x (RBool true)) (ev-run-nobind BUDGET)
    (let [raw (ev-status)]
      ; OPTIMISED: peepholed as it is built, which is what a front end does
      (graph-reset! 1)
      (let [y (a-arg (t-bool))]
        (a-ret (a-bin op y (a-int k)))
        (ev-reset!) (ev-bind! y (RBool true)) (ev-run-nobind BUDGET)
        (expect-same-status label raw (ev-status)))))
  0)

(deftest an_identity_peephole_preserves_the_answer_on_a_non_number
  (bin-identity-both-ways "bool + 0" OP-ADD 0)
  (bin-identity-both-ways "bool - 0" OP-SUB 0)
  (bin-identity-both-ways "bool * 1" OP-MUL 1)
  ; the guarded sibling, as a control: it agreed before the fix too
  (bin-identity-both-ways "bool * 0" OP-MUL 0)

  ; -(-x)
  (graph-reset! 1)
  (let [x (n-new1 OP-ARG (t-bool) (g-start))
        m (n-new2 OP-MINUS 0 NO-NODE (n-new2 OP-MINUS 0 NO-NODE x))
        r (n-new2 OP-RETURN 0 (g-start) m)]
    (n-add-def! (g-stop) r)
    (g-analyze!)
    (ev-reset!) (ev-bind! x (RBool true)) (ev-run-nobind BUDGET)
    (let [raw (ev-status)]
      (graph-reset! 1)
      (let [y (a-arg (t-bool))]
        (a-ret (a-un OP-MINUS (a-un OP-MINUS y)))
        (ev-reset!) (ev-bind! y (RBool true)) (ev-run-nobind BUDGET)
        (expect-same-status "-(-bool)" raw (ev-status)))))

  ; NON-VACUITY: the raw side really did report a defect rather than both sides agreeing on a value
  (graph-reset! 1)
  (let [x (n-new1 OP-ARG (t-bool) (g-start))
        n (n-new3 OP-ADD 0 NO-NODE x (n-new1 OP-CONST (t-int-con 0) (g-start)))
        r (n-new2 OP-RETURN 0 (g-start) n)]
    (n-add-def! (g-stop) r)
    (g-analyze!)
    (ev-reset!) (ev-bind! x (RBool true)) (ev-run-nobind BUDGET)
    (assert (= (ev-status) EV-TYPE))))

; ---------------------------------------------------------------------------
; A Cast nothing satisfies must not be optimised away
; ---------------------------------------------------------------------------
;; `if (p) a = 1; else a = null; return (int)a;`
;;
;; Built the way a parser has to build a merge: the Region and the Phi RAW, the Cast placed on the
;; phi before anything has been analysed, everything on the worklist, and only then peepholed. At
;; the moment the Cast is looked at, the phi is still ANY, and `ty-isa ANY int` is TRUE for every
;; target, so an unguarded `cast-idealize` discharges the check on every seed. The program then
;; RETURNS null on the arm where the annotation said int, instead of reporting that the compiler
;; narrowed without proof. EV-CAST is the correct answer here: nothing ever proved `a` is an int.
(defn build-raw-guarded-merge [(seed i64)] (-> i64)
  (graph-reset! seed)
  ; The branch itself is built EAGERLY, which is what the corpus's own diamond fixtures do and what
  ; a front end does. The MERGE is the part that has to be raw: a two-armed region with no phi yet
  ; is a degenerate diamond and collapses on sight, so the region, the phi and the Cast on it all
  ; exist before anything looks at them. That is the ordinary order, not an exotic one, and it is
  ; the order in which the Cast is peepholed against a phi whose type is still ANY.
  (let [p    (a-arg (t-dyn))
        arms (n-if-arms! (n-peephole (n-new2 OP-IF 0 (g-start) p)))
        r    (let [q (n-new OP-REGION 0)]
               (n-add-def! q NO-NODE) (n-add-def! q (arms-t arms)) (n-add-def! q (arms-f arms)) q)]
    (let [ph (n-new OP-PHI (t-dyn))]
      (n-add-def! ph r)
      (n-add-def! ph (a-int 1))
      (n-add-def! ph (a-con (t-null)))
      (let [c   (n-peephole (n-new2 OP-CAST (t-int) r ph))
            ret (n-peephole (n-new2 OP-RETURN 0 r c))]
        (n-add-def! (g-stop) ret)
        (n-peephole (g-stop))
        (wl-push! r) (wl-push! ph) (wl-push! c)
        (iterate!)
        p))))

(defn live-casts [] (-> i64)
  (let [n (n-count) (mut i) 0 (mut k) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-CAST))
                (store! k (+ (load k) 1))
              0)
            (store! i (+ (load i) 1))
            0)))
    (load k)))

(deftest a_cast_nothing_proved_is_kept_whatever_the_worklist_order
  (let [(mut s) 0 (mut lost) 0 (mut wrong) 0]
    (loop
      (if (>= (load s) 200) (break)
        (let [p (build-raw-guarded-merge (+ 1 (load s)))]
          (if (= (live-casts) 0) (store! lost (+ (load lost) 1)) 0)
          ; RInt 0 is falsey, so control takes the arm that assigned null
          (ev-reset!) (ev-bind! p (RInt 0)) (ev-run-nobind BUDGET)
          (if (= (ev-status) EV-CAST) 0 (store! wrong (+ (load wrong) 1)))
          (store! s (+ (load s) 1))
          0)))
    (if (and (= (load lost) 0) (= (load wrong) 0)) 0
      (do (let [w (stderr)]
            (fmt w "\nthe Cast was discharged on {d} of 200 seeds, and {d} runs did not report EV-CAST\n"
                 (load lost) (load wrong))
            (ps w "  ") (ev-print w) (ps w "\n")
            (g-print-flat w))
          (abort) 0))
    ; the other arm satisfies the cast, which is what says the fixture is a guard and not a wall
    (let [p (build-raw-guarded-merge 1)]
      (ev-reset!) (ev-bind! p (RInt 1)) (ev-run-nobind BUDGET)
      (assert (= (ev-status) EV-OK))
      (assert (rt-eq? (ev-result) (RInt 1))))))

; ---------------------------------------------------------------------------
; THE DIFFERENTIAL PROPERTY
; ---------------------------------------------------------------------------
;; Every corpus program that exists in both a raw and an optimised build must produce the same
;; observable result. The pairs are the four the corpus names: fold, gvn, big, dead-branch.
;;
;; Arguments are bound to values INSIDE their declared types, keyed by type rather than by node id,
;; because optimisation deletes arguments and shifts ids. See ev-bind-args!.
;;
;; THE COMPARISON IS `ev-outcome` AND NOT `rt-eq?`, and the difference only shows up once a
;; fixture's result is an OBJECT. `rt-eq?` compares an object by its index in the allocation
;; stream, which is a run artefact rather than an observable: it reports a difference when a
;; rewrite removes an allocation nothing reads, and it reports EQUALITY for two different objects
;; that happen to land at the same index. `ev-outcome` renders the reachable heap under the result
;; with objects numbered by discovery order, which is the same thing up to renaming, and it does
;; it as BYTES so run A's answer survives the `ev-reset!` that run B needs.
(defn bytes-eq? [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (slice-len a) (slice-len b)) false
    (let [n (slice-len a) (mut i) 0 (mut same) true]
      (loop
        (if (or (>= (load i) n) (not (load same))) (break)
          (do (if (!= (slice-get a (load i)) (slice-get b (load i))) (store! same false) 0)
              (store! i (+ (load i) 1))
              0)))
      (load same))))

(defn diff-pair [(raw i64) (opt i64) (label (slice u8))] (-> i64)
  (let [ba (alloc-stack (array u8 8192))
        bb (alloc-stack (array u8 8192))
        (mut seed) 1]
    (loop
      (if (> (load seed) 12) (break)
        (do (corpus-build! raw)
            (let [sr (ev-run-bound (load seed) BUDGET)
                  oa (ev-outcome (cast (ptr i8) ba) 8192)]
              (corpus-build! opt)
              (let [so (ev-run-bound (load seed) BUDGET)
                    ob (ev-outcome (cast (ptr i8) bb) 8192)]
                (if (and (= sr so) (bytes-eq? oa ob)) 0
                  (do (let [w (stderr)]
                        (ps w "\nDIFFERENTIAL FAILURE: ") (ps w label)
                        (fmt w "  (seed {d})\n  raw:       " (load seed))
                        (ps w oa)
                        (ps w "\n  optimised: ")
                        (ps w ob)
                        (ps w "\n"))
                      (abort) 0))))
            (store! seed (+ (load seed) 1))
            0)))
    0))

(deftest optimisation_preserves_the_answer
  (diff-pair CX-FOLD-BEFORE CX-FOLD-AFTER  "1 + 2*3, folded")
  (diff-pair CX-GVN-BEFORE  CX-GVN-AFTER   "(arg+2)-(2+arg), value numbered")
  (diff-pair CX-BIG-BEFORE  CX-BIG-AFTER   "nine expressions collapsing to one multiply")
  (diff-pair CX-DEAD-BEFORE CX-DEAD-AFTER  "if(0), dead branch removed")
  ;; THE PAIR WHOSE RESULT IS AN OBJECT. It is the same program with and without a scratch
  ;; allocation nothing reads back, which is 4c-3's dead-allocation removal, and it is the first
  ;; pair in this corpus that a positional object identity gets wrong: the returned object is
  ;; allocation 1 in one build and allocation 0 in the other. With `rt-eq?` this line aborts with
  ;; DIFFERENTIAL FAILURE on a pair that agrees.
  (diff-pair CX-OBJECT-RET-SCRATCH CX-OBJECT-RET "o = {x}; o.x = 5; return o, with and without a scratch allocation"))

;; THE OTHER DIRECTION, and it is the half that says the comparison is not vacuous. An oracle that
;; called every pair equal would satisfy the test above; this one requires two programs that
;; genuinely differ to be reported as DIFFERENT.
;;
;; Both builds return an object that is the FIRST allocation of its run, so both are `obj0` and
;; `rt-eq?` calls them the same value -- shape included, since `rt-eq?` compares the tag and the
;; table index and nothing else. They are not the same value: one is an object of shape `{x}`,
;; the other of shape `{y}`, and the WORD THEY HOLD IS THE SAME 5, so the only thing that can tell
;; them apart is the shape. The shape has to be named by its FIELD NAMES for that to work: both
;; are shape id 1 in their own run, ids being allocated in transition order.
(defn build-ret-obj! [(field-name (slice u8)) (v i64)] (-> i64)
  (graph-reset! 1)
  (shape-reset!)
  (let [s (shape-transition SHAPE-ROOT field-name (t-dyn))]
    (let [a (shape-field-alias s 0)]
      (let [nw (n-new-obj1! (g-start) s (mk-mem-in a))]
        (let [o (n-obj-ptr nw)]
          (let [m (n-store! (n-obj-mem nw 0) o (mk-int v) a)]
            (ret-to-mem (g-start) o m))))))
  (iterate!) 0)

(deftest the_oracle_can_tell_two_different_objects_apart
  (let [w (stdout)
        ba (alloc-stack (array u8 8192))
        bb (alloc-stack (array u8 8192))]
    (ps w "\n--- two results, both the first allocation of their run ---\n")
    (build-ret-obj! "x" 5)
    (assert (= (ev-run-bound 1 BUDGET) EV-OK))
    (let [va (ev-result)
          oa (ev-outcome (cast (ptr i8) ba) 8192)]
      (ps w "  shape {x}, holding 5: ") (ps w oa) (ps w "\n")
      (build-ret-obj! "y" 5)
      (assert (= (ev-run-bound 1 BUDGET) EV-OK))
      (let [vb (ev-result)
            ob (ev-outcome (cast (ptr i8) bb) 8192)]
        (ps w "  shape {y}, holding 5: ") (ps w ob) (ps w "\n")
        ; the premise: a positional identity really cannot tell them apart
        (assert (rt-eq? va vb))
        ; and the outcome comparison really can
        (assert (not (bytes-eq? oa ob)))))))

;; Every corpus program must reach a DEFINITE outcome, and specifically must never report a defect.
;; STUCK, TYPE, CAST and DEAD each mean something is wrong with the graph or the compiler, so none
;; is ever acceptable. EV-STEPS is different: two fixtures are infinite loops by construction, and
;; demanding a value from them would be demanding the interpreter be wrong. Those two are named
;; here so that a THIRD fixture quietly becoming non-terminating is a failure rather than a shrug.
(defn corpus-may-not-terminate? [(i i64)] (-> bool)
  (= i CX-NESTED))  ; while (a) while (b) {}, and an opaque `a` stays truthy for ever

(deftest every_corpus_program_reaches_a_definite_outcome
  (let [n (corpus-count) (mut i) 0 (mut valued) 0 (mut looped) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (corpus-build! (load i))
            (let [st (ev-run-bound 5 BUDGET)]
              (if (= st EV-OK) (store! valued (+ (load valued) 1))
                (if (and (= st EV-STEPS) (corpus-may-not-terminate? (load i)))
                    (store! looped (+ (load looped) 1))
                  (do (let [w (stderr)]
                        (ps w "\ncorpus program reached no definite outcome: ")
                        (ps w (corpus-name (load i)))
                        (ps w "\n  ") (ev-print w)
                        (ps w "\n  STUCK/TYPE/CAST/DEAD are defects; STEPS is only acceptable for a\n")
                        (ps w "  fixture listed in corpus-may-not-terminate?.\n")
                        (g-print-flat w))
                      (abort) 0))))
            (store! i (+ (load i) 1))
            0)))
    (let [w (stdout)]
      (fmt w "\n{d} corpus programs returned a value, {d} ran for ever as designed, {d} total\n"
           (load valued) (load looped) n))
    (assert (= (+ (load valued) (load looped)) n))
    ; and the ones that do terminate really are the majority: a corpus of infinite loops would
    ; satisfy the check above while testing almost nothing
    (assert (>= (load valued) 13))))

;; The diagram fixtures and the differential corpus are the same graphs, so a printed result next to
;; each one is free and makes the gallery show what a program DOES rather than only its shape.
(deftest print_corpus_results
  (let [w (stdout) n (corpus-count) (mut i) 0]
    (ps w "\n--- corpus results (seed 5) ---\n")
    (loop
      (if (>= (load i) n) (break)
        (do (corpus-build! (load i))
            (ev-run-bound 5 BUDGET)
            (ps w "  ") (ps w (corpus-name (load i))) (ps w ": ") (ev-print w) (ps w "\n")
            (store! i (+ (load i) 1))
            0)))
    0))

; ---------------------------------------------------------------------------
; A MERGE WHOSE INPUT IS A MERGE
; ---------------------------------------------------------------------------
;; Nested control flow, over every worklist order, checked by running the program.
;;
;; This is the shape the corpus was missing, and the whole family of miscompiles the M3 review
;; found lived in the gap. What made them invisible was not subtlety: `g-verify` reports nothing,
;; because a graph with an arm deleted is still a structurally valid graph, and the printer omits
;; dead nodes, so the diagram of the wreckage looks like a smaller program rather than a wrong one.
;; Only running it says anything.
;;
;; The mechanism, once: an unanalysed Region reported `~ctrl`. `region-compute` seeds its meet with
;; `~ctrl` and meet(~ctrl, ANY) is `~ctrl`, so a merge none of whose paths has a type yet claimed to
;; be PROVABLY UNREACHABLE. A merge above it inherits that claim as a dead path. Four rewrites test
;; `= (t-xctrl)` in the belief that it is the proven answer, and on the control axis it is not: XCtrl
;; is the HIGH element there, so it may still fall to `ctrl`.
;;
;; HOW THIS FAILS WITHOUT THE FIX, measured: `region-compute` without its `n-inputs-analysed?` guard
;; gives the wrong answer on 55 of 200 seeds for the two-level program below (the whole graph becomes
;; `return 1`), and deletes the entire program on 31 of 200 for the three-merge one (Stop with no
;; inputs at all, and the interpreter reporting EV-STUCK where a value is the only correct answer).
;; It is not a golden-string gate for the same reason: the answer is seed-dependent, so on any given
;; seed the golden string may be the right one.

;; `if (p) x = 1; else { if (q) x = 2; else x = 3; }  return x;`
;; Arms EAGER, both merges RAW and on the worklist, then `iterate!`. Returns `p`; `q` is the next
;; node, which the caller asserts rather than assumes.
(defn build-merge-of-merge [(seed i64)] (-> i64)
  (graph-reset! seed)
  (let [p (a-arg (t-dyn))
        q (a-arg (t-dyn))]
    (let [o (n-if-arms! (n-peephole (n-new2 OP-IF 0 (g-start) p)))]
      (let [i2 (n-if-arms! (n-peephole (n-new2 OP-IF 0 (arms-f o) q)))]
        (let [ri (let [z (n-new OP-REGION 0)]
                   (n-add-def! z NO-NODE) (n-add-def! z (arms-t i2)) (n-add-def! z (arms-f i2)) z)]
          (let [pi (let [z (n-new OP-PHI (t-int))]
                     (n-add-def! z ri) (n-add-def! z (a-int 2)) (n-add-def! z (a-int 3)) z)
                ro (let [z (n-new OP-REGION 0)]
                     (n-add-def! z NO-NODE) (n-add-def! z (arms-t o)) (n-add-def! z ri) z)]
            (let [po (let [z (n-new OP-PHI (t-int))]
                       (n-add-def! z ro) (n-add-def! z (a-int 1)) (n-add-def! z pi) z)]
              (let [ret (n-peephole (n-new2 OP-RETURN 0 ro po))]
                (n-add-def! (g-stop) ret)
                (n-peephole (g-stop)))
              (wl-push! ri) (wl-push! pi) (wl-push! ro) (wl-push! po)
              (iterate!)
              p)))))))

;; p and q as two integers, and the answer the program must give.
(defn run2 [(p i64) (pv i64) (qv i64)] (-> i64)
  (ev-reset!) (ev-bind! p (RInt pv)) (ev-bind! (+ p 1) (RInt qv)) (ev-run-nobind BUDGET) 0)

(defn expect2 [(what (slice u8)) (p i64) (pv i64) (qv i64) (want i64)] (-> i64)
  (run2 p pv qv)
  (if (!= (ev-status) EV-OK) (fail what) 0)
  (if (rt-eq? (ev-result) (RInt want)) 0
    (do (let [w (stderr)]
          (ps w "\n") (ps w what) (ps w "\n  want: ") (rt-print w (RInt want))
          (ps w "\n  got:  ") (rt-print w (ev-result)) (ps w "\n"))
        (abort) 0)))

(deftest a_merge_whose_input_is_a_merge_computes_the_same_program_under_every_seed
  (let [(mut s) 0]
    (loop
      (if (>= (load s) 200) (break)
        (let [p (build-merge-of-merge (+ 1 (load s)))]
          ; the two Args really are the two predicates: ids shift whenever a builder changes
          (assert (= (n-op p) OP-ARG))
          (assert (= (n-op (+ p 1)) OP-ARG))
          ; all three arms, on every seed. p false and q true is the one that was miscompiled.
          (expect2 "merge of merges: p=1 takes the outer arm"   p 1 0 1)
          (expect2 "merge of merges: p=0 q=1 takes the inner true arm"  p 0 1 2)
          (expect2 "merge of merges: p=0 q=0 takes the inner false arm" p 0 0 3)
          (store! s (+ (load s) 1))
          0)))))

;; `if (p) { if (q) x=1; else x=2; } else { if (r) x=3; else x=4; }  return x;`
;; Two merges feeding a merge: BOTH of the outer merge's paths are unanalysed merges at once.
(defn build-merge-tree [(seed i64)] (-> i64)
  (graph-reset! seed)
  (let [p (a-arg (t-dyn))
        q (a-arg (t-dyn))
        r (a-arg (t-dyn))]
    (let [o (n-if-arms! (n-peephole (n-new2 OP-IF 0 (g-start) p)))]
      (let [a (n-if-arms! (n-peephole (n-new2 OP-IF 0 (arms-t o) q)))
            b (n-if-arms! (n-peephole (n-new2 OP-IF 0 (arms-f o) r)))]
        (let [ra (let [z (n-new OP-REGION 0)]
                   (n-add-def! z NO-NODE) (n-add-def! z (arms-t a)) (n-add-def! z (arms-f a)) z)
              rb (let [z (n-new OP-REGION 0)]
                   (n-add-def! z NO-NODE) (n-add-def! z (arms-t b)) (n-add-def! z (arms-f b)) z)]
          (let [pa (let [z (n-new OP-PHI (t-int))]
                     (n-add-def! z ra) (n-add-def! z (a-int 1)) (n-add-def! z (a-int 2)) z)
                pb (let [z (n-new OP-PHI (t-int))]
                     (n-add-def! z rb) (n-add-def! z (a-int 3)) (n-add-def! z (a-int 4)) z)]
            (let [ro (let [z (n-new OP-REGION 0)]
                       (n-add-def! z NO-NODE) (n-add-def! z ra) (n-add-def! z rb) z)]
              (let [po (let [z (n-new OP-PHI (t-int))]
                         (n-add-def! z ro) (n-add-def! z pa) (n-add-def! z pb) z)]
                (let [ret (n-peephole (n-new2 OP-RETURN 0 ro po))]
                  (n-add-def! (g-stop) ret)
                  (n-peephole (g-stop)))
                (wl-push! ra) (wl-push! pa) (wl-push! rb) (wl-push! pb)
                (wl-push! ro) (wl-push! po)
                (iterate!)
                p))))))))

(defn run3 [(p i64) (pv i64) (qv i64) (rv i64)] (-> i64)
  (ev-reset!) (ev-bind! p (RInt pv)) (ev-bind! (+ p 1) (RInt qv)) (ev-bind! (+ p 2) (RInt rv))
  (ev-run-nobind BUDGET) 0)

(defn expect3 [(what (slice u8)) (p i64) (pv i64) (qv i64) (rv i64) (want i64)] (-> i64)
  (run3 p pv qv rv)
  (if (!= (ev-status) EV-OK) (fail what) 0)
  (if (rt-eq? (ev-result) (RInt want)) 0
    (do (let [w (stderr)]
          (ps w "\n") (ps w what) (ps w "\n  want: ") (rt-print w (RInt want))
          (ps w "\n  got:  ") (rt-print w (ev-result)) (ps w "\n"))
        (abort) 0)))

(deftest two_merges_feeding_a_merge_keep_the_whole_program
  (let [(mut s) 0]
    (loop
      (if (>= (load s) 200) (break)
        (let [p (build-merge-tree (+ 1 (load s)))]
          (assert (= (n-op p) OP-ARG))
          ; the Return is still there. Checked directly as well as through the interpreter, because
          ; `stop-idealize` dropping it is what left Start and Stop with nothing in between, and a
          ; verifier cannot object to an empty graph.
          (assert (= (n-nins (g-stop)) 1))
          (expect3 "merge tree: p=1 q=1" p 1 1 0 1)
          (expect3 "merge tree: p=1 q=0" p 1 0 0 2)
          (expect3 "merge tree: p=0 r=1" p 0 0 1 3)
          (expect3 "merge tree: p=0 r=0" p 0 0 0 4)
          (store! s (+ (load s) 1))
          0)))))

; ---------------------------------------------------------------------------
; The same, one level deeper, for the two rewrites that read a PHI's type
; ---------------------------------------------------------------------------
;; `a_cast_nothing_proved_is_kept_whatever_the_worklist_order` above builds its branch eagerly, so
;; both of the region's paths are typed `ctrl` from the start and only the Phi itself is ANY. Add one
;; level of nesting, which any nested if/else produces, and the guard it gates on is defeated:
;; `phi-compute` legitimately SKIPS a region path whose control is still high, so the outer Phi
;; momentarily reports the type of the single arm that happens to have been analysed. That type is
;; LOW, it satisfies the Cast, and the type check was deleted on 110 of 200 seeds. The surviving
;; graph even printed the Phi's settled type as `null|int`, so the analysis proved the Cast
;; unsatisfiable AFTER the Cast was gone.
;;
;; `if (p) { a = 1; } else { if (q) a = null; else a = null; }  return (int)a;`
(defn build-nested-guarded-merge [(seed i64)] (-> i64)
  (graph-reset! seed)
  (let [p (a-arg (t-dyn))
        q (a-arg (t-dyn))]
    (let [o (n-if-arms! (n-peephole (n-new2 OP-IF 0 (g-start) p)))]
      (let [i2 (n-if-arms! (n-peephole (n-new2 OP-IF 0 (arms-f o) q)))]
        (let [ri (let [z (n-new OP-REGION 0)]
                   (n-add-def! z NO-NODE) (n-add-def! z (arms-t i2)) (n-add-def! z (arms-f i2)) z)]
          (let [pi (let [z (n-new OP-PHI (t-dyn))]
                     (n-add-def! z ri) (n-add-def! z (a-con (t-null)))
                     (n-add-def! z (a-con (t-null))) z)
                ro (let [z (n-new OP-REGION 0)]
                     (n-add-def! z NO-NODE) (n-add-def! z (arms-t o)) (n-add-def! z ri) z)]
            (let [po (let [z (n-new OP-PHI (t-dyn))]
                       (n-add-def! z ro) (n-add-def! z (a-int 1)) (n-add-def! z pi) z)]
              (let [c   (n-new2 OP-CAST (t-int) ro po)]
                (let [ret (n-peephole (n-new2 OP-RETURN 0 ro c))]
                  (n-add-def! (g-stop) ret)
                  (n-peephole (g-stop)))
                (wl-push! ri) (wl-push! pi) (wl-push! ro) (wl-push! po) (wl-push! c)
                (iterate!)
                p))))))))

(deftest a_cast_nothing_proved_survives_a_merge_of_merges
  (let [(mut s) 0 (mut lost) 0 (mut wrong) 0]
    (loop
      (if (>= (load s) 200) (break)
        (let [p (build-nested-guarded-merge (+ 1 (load s)))]
          (if (= (live-casts) 0) (store! lost (+ (load lost) 1)) 0)
          ; p falsey takes the nested arms, both of which assign null, so nothing satisfies the
          ; annotation and EV-CAST is the only correct answer.
          (run2 p 0 1)
          (if (= (ev-status) EV-CAST) 0 (store! wrong (+ (load wrong) 1)))
          (run2 p 0 0)
          (if (= (ev-status) EV-CAST) 0 (store! wrong (+ (load wrong) 1)))
          (store! s (+ (load s) 1))
          0)))
    (if (and (= (load lost) 0) (= (load wrong) 0)) 0
      (do (let [w (stderr)]
            (fmt w "\nnested: the Cast was discharged on {d} of 200 seeds, {d} runs did not report EV-CAST\n"
                 (load lost) (load wrong))
            (ps w "  ") (ev-print w) (ps w "\n")
            (g-print-flat w))
          (abort) 0))
    ; and the outer arm still satisfies it, so this is a guard and not a wall
    (let [p (build-nested-guarded-merge 1)]
      (run2 p 1 0)
      (assert (= (ev-status) EV-OK))
      (assert (rt-eq? (ev-result) (RInt 1))))))

;; AN IDENTITY ON A PROVISIONAL PHI TYPE, which is the same defeat aimed at `ty-int-only?` instead
;; of at the Cast: `if (p) x = 1; else { if (q) x = true; else x = true; }  return x + 0;`
;;
;; With the inner merge unanalysed the outer Phi reports `int=1`, `ty-int-only?` is true, and `x + 0`
;; hands back the phi. Its settled type is `bool|int`, and `true + 0` is what `ev-arith` correctly
;; refuses. The Add was lost on 99 of 200 seeds and the program answered `true`; when the live arm is
;; a constant, the Add folded to `Const int=1` on 108 of 200 instead. EV-TYPE is the only correct
;; answer on the arm that assigns a bool.
(defn build-nested-bool-merge [(seed i64) (live-const bool)] (-> i64)
  (graph-reset! seed)
  (let [p (a-arg (t-dyn))
        q (a-arg (t-dyn))]
    (let [o (n-if-arms! (n-peephole (n-new2 OP-IF 0 (g-start) p)))]
      (let [i2 (n-if-arms! (n-peephole (n-new2 OP-IF 0 (arms-f o) q)))]
        (let [ri (let [z (n-new OP-REGION 0)]
                   (n-add-def! z NO-NODE) (n-add-def! z (arms-t i2)) (n-add-def! z (arms-f i2)) z)]
          (let [pi (let [z (n-new OP-PHI (t-dyn))]
                     (n-add-def! z ri) (n-add-def! z (a-con (t-bool-con true)))
                     (n-add-def! z (a-con (t-bool-con true))) z)
                ro (let [z (n-new OP-REGION 0)]
                     (n-add-def! z NO-NODE) (n-add-def! z (arms-t o)) (n-add-def! z ri) z)]
            ; a constant live arm lets the whole Add fold; a range live arm leaves only the
            ; `x + 0` identity. Both were defeated through the phi, so both are covered.
            (let [po (let [z (n-new OP-PHI (t-dyn))]
                       (n-add-def! z ro)
                       (n-add-def! z (if live-const (a-int 1) (a-arg (t-int-range 3 9))))
                       (n-add-def! z pi) z)]
              (let [add (n-new3 OP-ADD 0 NO-NODE po (a-int 0))]
                (let [ret (n-peephole (n-new2 OP-RETURN 0 ro add))]
                  (n-add-def! (g-stop) ret)
                  (n-peephole (g-stop)))
                (wl-push! ri) (wl-push! pi) (wl-push! ro) (wl-push! po) (wl-push! add)
                (iterate!)
                p))))))))

(deftest an_identity_is_not_taken_on_a_provisional_phi_type
  (let [(mut variant) 0]
    (loop
      (if (>= (load variant) 2) (break)
        (let [(mut s) 0 (mut wrong) 0]
          (loop
            (if (>= (load s) 200) (break)
              (let [p (build-nested-bool-merge (+ 1 (load s)) (= (load variant) 0))]
                ; p falsey reaches the arms that assign `true`, and `true + 0` is a type error
                (run2 p 0 1)
                (if (= (ev-status) EV-TYPE) 0 (store! wrong (+ (load wrong) 1)))
                (store! s (+ (load s) 1))
                0)))
          (if (= (load wrong) 0) 0
            (do (let [w (stderr)]
                  (fmt w "\nx+0 on a provisional phi: {d} of 200 seeds did not report EV-TYPE (variant {d})\n"
                       (load wrong) (load variant))
                  (ps w "  ") (ev-print w) (ps w "\n")
                  (g-print-flat w))
                (abort) 0))
          (store! variant (+ (load variant) 1))
          0)))
    ; the reference answer, from a build that never rewrites anything: same program, same verdict
    (graph-reset! 1)
    (let [x (a-arg (t-bool))
          n (n-new3 OP-ADD 0 NO-NODE x (a-int 0))
          r (n-new2 OP-RETURN 0 (g-start) n)]
      (n-add-def! (g-stop) r)
      (g-analyze!)
      (ev-reset!) (ev-bind! x (RBool true)) (ev-run-nobind BUDGET)
      (assert (= (ev-status) EV-TYPE)))))

; ---------------------------------------------------------------------------
; An If whose own control has not been analysed yet
; ---------------------------------------------------------------------------
;; `if (p) { if (q) return 1; else return 2; } else return 3;` with the OUTER If and its projections
;; raw and the inner branch eager. `if-compute`'s unreachable-control test was
;; `(and (!= c (t-ctrl)) (!= c (t-bot)))`, which ANY satisfies, so an If whose control was merely
;; unanalysed reported [~ctrl ~ctrl]: both arms provably not taken, out of nothing. `cproj-idealize`
;; then replaced BOTH live projections with XCtrl and the two Returns were killed outright.
(defn build-raw-outer-if [(seed i64)] (-> i64)
  (graph-reset! seed)
  (let [p   (a-arg (t-dyn))
        q   (a-arg (t-dyn))
        iff (n-new2 OP-IF 0 (g-start) p)]
    ; raw, and both projections exist before either is looked at
    (let [tt (n-new1 OP-CPROJ 0 iff)
          ff (n-new1 OP-CPROJ 1 iff)]
      (let [inner (n-if-arms! (n-peephole (n-new2 OP-IF 0 tt q)))]
        (let [r1 (n-peephole (n-new2 OP-RETURN 0 (arms-t inner) (a-int 1)))
              r2 (n-peephole (n-new2 OP-RETURN 0 (arms-f inner) (a-int 2)))
              r3 (n-peephole (n-new2 OP-RETURN 0 ff (a-int 3)))]
          (n-add-def! (g-stop) r1) (n-add-def! (g-stop) r2) (n-add-def! (g-stop) r3)
          (n-peephole (g-stop))
          (wl-push! iff) (wl-push! tt) (wl-push! ff)
          (iterate!)
          p)))))

(deftest a_raw_outer_if_keeps_the_arms_of_a_nested_if
  (let [(mut s) 0]
    (loop
      (if (>= (load s) 200) (break)
        (let [p (build-raw-outer-if (+ 1 (load s)))]
          (assert (= (n-op p) OP-ARG))
          ; all three Returns are still reachable, on every seed
          (assert (= (n-nins (g-stop)) 3))
          (expect2 "raw outer if: p=1 q=1" p 1 1 1)
          (expect2 "raw outer if: p=1 q=0" p 1 0 2)
          (expect2 "raw outer if: p=0"     p 0 0 3)
          (store! s (+ (load s) 1))
          0)))))

; ---------------------------------------------------------------------------
; A diamond built entirely raw, then peepholed
; ---------------------------------------------------------------------------
;; `if (p) x = 8; else x = 0; return x + 1;` with nothing peepholed and everything on the worklist.
;; The flat case, and it miscompiled to `return 1` on 9 of 40 seeds through a route none of the
;; guards above covers: the phi met `int=0` with an as-yet-unanalysed `8` (ANY is the identity for
;; meet), so it LOOKED like the integer constant 0. `should-swap?` moved it to the right because
;; constants belong on the right, and `x + 0 = x` then returned the literal 1 as the whole program.
;; No fold and no control rewrite was involved: the guard that was missing is on `n-int-con?`.
;; CONSTRUCTION ORDER IS PART OF THE FIXTURE. Every node is created before anything is pushed, and
;; they are pushed in creation order, because `wl-pop!` picks a random INDEX in the worklist: which
;; orders the seed can produce depends on how the list was filled. An earlier version of this builder
;; created the constants inline (so they got later ids) and pushed with `wl-push-live!`, and it did
;; not reproduce the miscompile at all, on any of 200 seeds. A fixture that cannot fail is not a gate.
(defn build-raw-diamond [(seed i64)] (-> i64)
  (graph-reset! seed)
  (let [p   (n-new1 OP-ARG (t-dyn) (g-start))
        iff (n-new2 OP-IF 0 (g-start) p)
        tt  (n-new1 OP-CPROJ 0 iff)
        ff  (n-new1 OP-CPROJ 1 iff)
        c8  (n-new1 OP-CONST (t-int-con 8) (g-start))
        c0  (n-new1 OP-CONST (t-int-con 0) (g-start))
        c1  (n-new1 OP-CONST (t-int-con 1) (g-start))
        r   (n-new OP-REGION 0)]
    (n-add-def! r NO-NODE) (n-add-def! r tt) (n-add-def! r ff)
    (let [ph (n-new OP-PHI (t-int))]
      (n-add-def! ph r) (n-add-def! ph c8) (n-add-def! ph c0)
      (let [add (n-new3 OP-ADD 0 NO-NODE ph c1)
            ret (n-new2 OP-RETURN 0 r add)]
        (n-add-def! (g-stop) ret)
        (wl-push! p) (wl-push! iff) (wl-push! tt) (wl-push! ff)
        (wl-push! c8) (wl-push! c0) (wl-push! c1)
        (wl-push! r) (wl-push! ph) (wl-push! add) (wl-push! ret)
        (wl-push! (g-start)) (wl-push! (g-stop))
        (iterate!)
        p))))

;; The value type the surviving Return publishes, found from Stop so a folded Add is still seen.
(defn stop-return-value-ty [] (-> i64)
  (let [st (g-stop)]
    (assert (= (n-nins st) 1))
    (n-ty (n-in (n-in st 0) 1))))

(deftest a_raw_diamond_computes_the_same_program_under_every_seed
  (let [(mut s) 0]
    (loop
      (if (>= (load s) 200) (break)
        (let [p (build-raw-diamond (+ 1 (load s)))]
          ; the published type is the whole range, not one arm of it: `int=1` here was the analysis
          ; agreeing with the miscompile
          (if (= (stop-return-value-ty) (t-int-range 1 9)) 0
            (do (let [w (stderr)]
                  (fmt w "\nraw diamond, seed {d}: the return value's type is " (+ 1 (load s)))
                  (ty-print w (stop-return-value-ty))
                  (ps w " and should be int=[1..9]\n")
                  (g-print-flat w))
                (abort) 0))
          (ev-reset!) (ev-bind! p (RInt 1)) (ev-run-nobind BUDGET)
          (if (and (= (ev-status) EV-OK) (rt-eq? (ev-result) (RInt 9))) 0
            (fail "raw diamond: the true arm should give 9"))
          (ev-reset!) (ev-bind! p (RInt 0)) (ev-run-nobind BUDGET)
          (if (and (= (ev-status) EV-OK) (rt-eq? (ev-result) (RInt 1))) 0
            (fail "raw diamond: the false arm should give 1"))
          (store! s (+ (load s) 1))
          0)))))

;; And the ANALYSIS-only half of the same fixture, which is the corpus's one raw merge. A phi type
;; that is too SPECIFIC is the miscompile direction: it excludes a value the program produces, so a
;; later fold on it is wrong rather than merely missed. `phi-compute` recorded its revisit dependency
;; on the REGION instead of on the region's control input, and a region already at `ctrl` does not
;; change type when a second path goes live (meet(ctrl,ctrl) is ctrl), so nothing re-queued the phi;
;; `g-analyze!` also never flushed the deps list at all. Either bug alone leaves this wrong on 5 of
;; 40 seeds, with `g-verify` reporting VERR-STALE-TYPE on exactly those.
(deftest the_analysis_only_pass_reaches_the_same_fixpoint_under_every_seed
  (let [(mut s) 0]
    (loop
      (if (>= (load s) 200) (break)
        (do (graph-reset! (+ 1 (load s)))
            ; the corpus fixture, rebuilt here per seed: same program, seed 1 there
            (let [p   (n-new1 OP-ARG (t-dyn) (g-start))
                  iff (n-new2 OP-IF 0 (g-start) p)]
              (let [tt (n-new1 OP-CPROJ 0 iff)
                    ff (n-new1 OP-CPROJ 1 iff)
                    r  (n-new OP-REGION 0)]
                (n-add-def! r NO-NODE) (n-add-def! r tt) (n-add-def! r ff)
                (let [ph (n-new OP-PHI (t-int))]
                  (n-add-def! ph r)
                  (n-add-def! ph (n-new1 OP-CONST (t-int-con 8) (g-start)))
                  (n-add-def! ph (n-new1 OP-CONST (t-int-con 0) (g-start)))
                  (let [add (n-new3 OP-ADD 0 NO-NODE ph (n-new1 OP-CONST (t-int-con 1) (g-start)))
                        ret (n-new2 OP-RETURN 0 r add)]
                    (n-add-def! (g-stop) ret)
                    (g-analyze!)
                    ; the analysis really ran, rather than the assertions holding vacuously
                    (assert (> (g-analyze-checks) 0))
                    (if (and (= (n-ty ph) (t-int-range 0 8)) (= (n-ty add) (t-int-range 1 9))) 0
                      (do (let [w (stderr)]
                            (fmt w "\nraw analysis, seed {d}: phi is " (+ 1 (load s)))
                            (ty-print w (n-ty ph)) (ps w " (want int=[0..8]) and add is ")
                            (ty-print w (n-ty add)) (ps w " (want int=[1..9])\n")
                            (g-print-flat w))
                          (abort) 0))
                    ; and the interpreter's answer on the arm the stale type excluded
                    (ev-reset!) (ev-bind! p (RInt 0)) (ev-run-nobind BUDGET)
                    (if (and (= (ev-status) EV-OK) (rt-eq? (ev-result) (RInt 1))) 0
                      (fail "raw analysis: the false arm should give 1"))))))
            (store! s (+ (load s) 1))
            0)))))

;; `iterate!` CLAIMS A PEEPHOLE FIXPOINT, so ask for it. Draining the worklist once is no longer
;; enough on its own: a rewrite that needs a proven type is REFUSED while its input cone is still
;; settling, and nothing re-queues it afterwards, because the blocker's type may never change again
;; and neither `wl-push-outs!` nor the deps list will fire. One drain therefore reaches a fixpoint of
;; "what could be proven at the time", which is a function of the pop order; `1 + 2*3` stayed unfolded
;; on some seeds. `iterate!` sweeps instead: drain, and if that drain changed anything, push every
;; live node and drain again.
;;
;; This checks the claim rather than the mechanism: after any corpus fixture that says it is
;; optimised, one more full sweep must change nothing. The step count is asserted too, so the test
;; cannot pass by sweeping nothing.
(deftest iterate_reaches_a_peephole_fixpoint_on_every_optimised_fixture
  (let [n (corpus-count) (mut i) 0 (mut checked) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (if (= (corpus-mode (load i)) CORPUS-OPTIMISED)
                (do (corpus-build! (load i))
                    (let [before (g-changes)]
                      (wl-push-live!)
                      (let [steps (wl-drain!)]
                        ; real work: every live node was reconsidered
                        (assert (> steps 0))
                        (if (= (g-changes) before) 0
                          (do (let [w (stderr)]
                                (ps w "\n") (ps w (corpus-name (load i)))
                                (fmt w " was not at a peephole fixpoint: one more sweep made {d} change(s) in {d} steps\n"
                                     (- (g-changes) before) steps)
                                (g-print-flat w))
                              (abort) 0))))
                    (store! checked (+ (load checked) 1))
                    0)
              0)
            (store! i (+ (load i) 1))
            0)))
    ; and it really did range over the optimised half of the corpus
    (assert (>= (load checked) 12))))

