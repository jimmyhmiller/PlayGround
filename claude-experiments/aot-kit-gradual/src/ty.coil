;; The type lattice.
;;
;; Types form a symmetric bounded lattice with `meet` (greatest lower bound) and an
;; involutive `dual`. `join` is the dual of the meet of the duals; `isa` is defined by
;; `meet`. Types are INTERNED, so a type is a dense integer id and structural equality is
;; id equality.
;;
;; THE UNIFORM RULE. Every axis of every type is stored so that `meet` is the *widening*
;; or *union* operation on the stored representation and `dual` is the *complementing*
;; operation, with "high" (optimistic, above the centreline) showing up as a stored form
;; that is inverted or empty. Bitsets meet by OR and dual by complement; ranges meet by
;; widening the interval and dual by swapping the ends, so an inverted range under a
;; widening meet computes exactly the intersection of the high elements. One rule for
;; every axis is what keeps the lattice laws provable instead of hoped for.
;;
;; TERMINATION. Bitset axes are finite and converge on their own. Interval axes do not: a
;; loop induction variable could widen forever. The int axis therefore carries a small
;; widening counter; after a few widenings it falls straight to the axis bottom.
(module ty)

(import "alloc.coil"     :use *)
(import "arraylist.coil" :use *)
(import "hashmap.coil"   :use *)
(import "control.coil"   :use *)
(import "io.coil"        :use *)
(import "fmt.coil"       :use *)

; ============================================================================
; Ids
; ============================================================================
;; A type id (`TyId` by convention) is a plain `i64`: an index into the interned table.
;; It is deliberately NOT a one-field struct. Coil passes an aggregate by reference, so a
;; wrapper would turn the compiler's hottest handle into a pointer to a stack slot. The
;; discipline is naming instead: type ids are `tid`/`t`, node ids will be `nid`/`n`.

(const TY-NO-ID i64 -1)          ; "no id yet", used while installing duals

; ============================================================================
; Value kinds
; ============================================================================
;; A dynamic value's coarse shape, as a bitset. `meet` unions the set, so the empty set is
;; the TOP of this axis and the full set is its BOTTOM. Unions are therefore first class:
;; `number | undefined` is a different lattice element from `dyn`, which is the difference
;; between a load and a load plus a branch.
;;
;; `int` is split out from `flt` even though the source language has one number type. That
;; split is the single highest-value refinement in the lattice: it is what turns `a + b`
;; into an integer add. `number` is just `int | flt`.
(const VK-UNDEF i64 1)
(const VK-NULL  i64 2)
(const VK-BOOL  i64 4)
(const VK-INT   i64 8)
(const VK-FLT   i64 16)
(const VK-STR   i64 32)
(const VK-SYM   i64 64)
(const VK-BIG   i64 128)         ; bigint
(const VK-OBJ   i64 256)
(const VK-FUN   i64 512)
(const VK-MASK  i64 1023)        ; every kind: the bottom of this axis
(const VK-NONE  i64 0)           ; no kind: the top of this axis
(const VK-NUM   i64 24)          ; VK-INT | VK-FLT

; ============================================================================
; Axis bounds
; ============================================================================
(const TY-IMIN  i64 (<< 1 63))            ; INT64_MIN
(const TY-IMAX  i64 (^ (<< 1 63) -1))     ; INT64_MAX
(const TY-WIDEN-MAX i64 3)                ; widenings before the int axis falls to bottom

;; The float axis is a three-element chain: high, a constant, low. Sizes are the marker,
;; as in Simple's `TypeFloat._sz`: the sign carries high/low and 0 means "a constant".
;; Only f64 exists here on purpose; the source language's numbers are doubles, and f32
;; arrives with typed arrays or not at all.
(const FSZ-HIGH i64 -64)
(const FSZ-CON  i64 0)
(const FSZ-LOW  i64 64)

; ============================================================================
; Val: the value sublattice
; ============================================================================
;; A product of independent axes. Meet and dual are componentwise, which is what makes the
;; lattice laws hold by construction: a product of lattices is a lattice.
;;
;; A refinement is only *meaningful* when its kind bit is present, but it is still carried
;; and still met when the bit is absent. That is deliberate. Canonicalising an unused
;; refinement would not survive `dual` (dual maps an axis bottom to an axis top), so the
;; redundancy is the price of an involutive dual. It costs a little interning space and
;; never costs precision, because every decision consults `kinds` first.
(defstruct Val
  [(kinds  i64)     ; VK-* bitset;  meet = OR,  dual = complement within VK-MASK
   (ilo    i64)     ; int axis: inclusive range. ilo > ihi means high (an inverted range)
   (ihi    i64)
   (iwide  i64)     ; widening counter, -3..3;  meet = max,  dual = negate
   (fsz    i64)     ; float axis: FSZ-HIGH / FSZ-CON / FSZ-LOW
   (fbits  i64)     ; the f64 constant as its BIT PATTERN when fsz = FSZ-CON, else 0.
                    ; Bits, not an f64: NaN is not reflexive under fcmp, and interning
                    ; needs exact identity. Bit patterns are also what NaN-boxing wants.
   (fidxs  i64)     ; function-set bitset; meet = OR, dual = complement
   (shapes i64)])   ; object-shape-set bitset; meet = OR, dual = complement

(defn val-make [(kinds i64) (ilo i64) (ihi i64) (iwide i64)
                (fsz i64) (fbits i64) (fidxs i64) (shapes i64)] (-> Val)
  (let [(mut v) (zeroed Val)]
    (store! (field v kinds)  kinds)
    (store! (field v ilo)    ilo)
    (store! (field v ihi)    ihi)
    (store! (field v iwide)  iwide)
    (store! (field v fsz)    fsz)
    ; Canonical: a non-constant float carries no bits. Safe to normalise because `dual`
    ; only flips the sign of fsz and never turns a non-constant into a constant.
    (store! (field v fbits)  (if (= fsz FSZ-CON) fbits 0))
    (store! (field v fidxs)  fidxs)
    (store! (field v shapes) shapes)
    (load v)))

;; Field accessors. `match` binds a struct payload BY VALUE, and `field` needs a place, so
;; a matched `Val` cannot be poked at directly. Passing it to a function gives a read-only
;; reference, which is what these are for, and they read better than `(load (field …))` at
;; every use site.
(defn val-kinds  [(x Val)] (-> i64) (load (field x kinds)))
(defn val-ilo    [(x Val)] (-> i64) (load (field x ilo)))
(defn val-ihi    [(x Val)] (-> i64) (load (field x ihi)))
(defn val-iwide  [(x Val)] (-> i64) (load (field x iwide)))
(defn val-fsz    [(x Val)] (-> i64) (load (field x fsz)))
(defn val-fbits  [(x Val)] (-> i64) (load (field x fbits)))
(defn val-fidxs  [(x Val)] (-> i64) (load (field x fidxs)))
(defn val-shapes [(x Val)] (-> i64) (load (field x shapes)))

(defn val-eq [(x Val) (y Val)] (-> bool)
  (and (= (val-kinds x)  (val-kinds y))
   (and (= (val-ilo x)   (val-ilo y))
    (and (= (val-ihi x)  (val-ihi y))
     (and (= (val-iwide x) (val-iwide y))
      (and (= (val-fsz x)  (val-fsz y))
       (and (= (val-fbits x)  (val-fbits y))
        (and (= (val-fidxs x)  (val-fidxs y))
             (= (val-shapes x) (val-shapes y))))))))))

(defn hash-step [(h i64) (x i64)] (-> i64) (* (^ h x) 1099511628211))

(defn val-hash [(x Val)] (-> i64)
  (hash-step
   (hash-step
    (hash-step
     (hash-step
      (hash-step
       (hash-step
        (hash-step
         (hash-step -3750763034362895579 (val-kinds x))
         (val-ilo x))
        (val-ihi x))
       (val-iwide x))
      (val-fsz x))
     (val-fbits x))
    (val-fidxs x))
   (val-shapes x)))

(impl Eq Val (= [(x Val) (y Val)] (-> bool) (val-eq x y)))

; ---------------------------------------------------------------------------
; Axis operations. Each is meet + dual, named so the uniform rule is visible.
; ---------------------------------------------------------------------------

;; A bitset axis. Union to meet, complement to dual. `mask` bounds the complement so that
;; dual stays involutive on a narrower-than-64-bit set.
(defn bits-meet [(a i64) (b i64)] (-> i64) (| a b))
(defn bits-dual [(a i64) (mask i64)] (-> i64) (& (^ a -1) mask))

(defn imin2 [(a i64) (b i64)] (-> i64) (if (< a b) a b))
(defn imax2 [(a i64) (b i64)] (-> i64) (if (> a b) a b))

;; The float chain. `meet` walks down {high, constant, low}: two equal constants stay that
;; constant, two unequal constants fall to low, and high is the identity.
(defn fsz-meet [(asz i64) (abits i64) (bsz i64) (bbits i64)] (-> i64)
  (if (= asz bsz)
      (if (= asz FSZ-CON) (if (= abits bbits) FSZ-CON FSZ-LOW) asz)
    (if (or (= asz FSZ-LOW) (= bsz FSZ-LOW)) FSZ-LOW
      ; one side is high, which is the identity, so the result is the other side's size
      (if (= asz FSZ-HIGH) bsz asz))))

(defn fbits-meet [(asz i64) (abits i64) (bsz i64) (bbits i64)] (-> i64)
  (if (= (fsz-meet asz abits bsz bbits) FSZ-CON)
      (if (= asz FSZ-CON) abits bbits)
    0))

;; Constants are self-dual: they sit on the lattice centreline. Everything else flips.
(defn fsz-dual [(sz i64)] (-> i64) (if (= sz FSZ-CON) FSZ-CON (- 0 sz)))

; ---------------------------------------------------------------------------
; Val meet / dual / predicates
; ---------------------------------------------------------------------------
(defn val-meet [(x Val) (y Val)] (-> Val)
  (val-make
   (bits-meet (val-kinds x) (val-kinds y))
   (imin2 (val-ilo x)   (val-ilo y))
   (imax2 (val-ihi x)   (val-ihi y))
   (imax2 (val-iwide x) (val-iwide y))
   (fsz-meet   (val-fsz x) (val-fbits x)
               (val-fsz y) (val-fbits y))
   (fbits-meet (val-fsz x) (val-fbits x)
               (val-fsz y) (val-fbits y))
   (bits-meet (val-fidxs x)  (val-fidxs y))
   (bits-meet (val-shapes x) (val-shapes y))))

(defn val-dual [(x Val)] (-> Val)
  (let [lo  (val-ilo x)
        hi  (val-ihi x)
        con (= lo hi)]      ; an integer constant is self-dual, like a float constant
    (val-make
     (bits-dual (val-kinds x) VK-MASK)
     (if con lo hi)
     (if con hi lo)
     (if con (val-iwide x) (- 0 (val-iwide x)))
     (fsz-dual (val-fsz x))
     (val-fbits x)
     (bits-dual (val-fidxs x)  -1)
     (bits-dual (val-shapes x) -1))))

;; High means "no value can be here": the optimistic pass uses it to spot dead code, and
;; constant folding refuses to fire on it. Reporting `false` where `true` was possible
;; loses an optimisation and never breaks correctness, so this errs toward `false`.
(defn val-high? [(x Val)] (-> bool) (= (val-kinds x) VK-NONE))

;; Exactly one kind, pinned to one inhabitant. `undefined` and `null` are single-inhabitant
;; kinds, so naming the kind is naming the value. Booleans reuse the int axis (0 or 1).
(defn val-const? [(x Val)] (-> bool)
  (let [k (val-kinds x)]
    (if (= k VK-UNDEF) true
      (if (= k VK-NULL) true
        (if (or (= k VK-INT) (= k VK-BOOL)) (= (val-ilo x) (val-ihi x))
          (if (= k VK-FLT) (= (val-fsz x) FSZ-CON)
            (if (= k VK-FUN) (= (popcount64 (val-fidxs x)) 1)
              false)))))))

;; Bit population count. Used for "is this a single function" and for printing.
(defn popcount64 [(x i64)] (-> i64)
  (let [(mut v) x (mut n) 0]
    (loop
      (if (= (load v) 0) (break)
        (do (store! v (& (load v) (- (load v) 1)))
            (store! n (+ (load n) 1))
            0)))
    (load n)))

; ============================================================================
; Ty: the full type
; ============================================================================
;; A closed set of mutually exclusive shapes, so `match` is exhaustive and forgetting a
;; kind in `meet` is a compile error rather than a silent miscompile. Children of a tuple
;; are type *ids* in a side array, which keeps this sum small and non-recursive.
(defsum Ty
  (TBot)                              ; ALL: the bottom of everything, "mixed unrelated"
  (TTop)                              ; ANY: the top
  (TCtrl)                             ; control, reachable
  (TXCtrl)                            ; control, unreachable (the dual of TCtrl)
  (TVal   [(v Val)])                  ; a dynamic value
  (TTuple [(off i64) (len i64)]))     ; parallel types; members live in the kid array

(defn ty-tag [(t Ty)] (-> i64)
  (match t (TBot [] 0) (TTop [] 1) (TCtrl [] 2) (TXCtrl [] 3) (TVal [v] 4) (TTuple [o l] 5)))

; ============================================================================
; The interning table
; ============================================================================
(defstruct Types
  [(tab    (ArrayList Ty))       ; id -> Ty
   (duals  (ArrayList i64))      ; id -> the id of its dual
   (kids   (ArrayList i64))      ; tuple members, addressed by (off, len)
   (intern (HashMap Ty i64))     ; Ty -> id
   (inited bool)])

;; The one global. Coil has no top-level mutable binding; `alloc-static` in a zero-arg
;; accessor returns the same cell every call, which is the idiom for a singleton.
(defn types [] (-> (ptr Types))
  (let [p (alloc-static Types)]
    (if (load (field p inited)) 0
      (do (store! (field p inited) true)   ; set FIRST: seeding re-enters through `types`
          (store! (field p tab)    (al-new [Ty] (malloc-allocator)))
          (store! (field p duals)  (al-new [i64] (malloc-allocator)))
          (store! (field p kids)   (al-new [i64] (malloc-allocator)))
          (store! (field p intern) (hm-new [Ty i64] (malloc-allocator) (ty-keyops)))
          (ty-seed p)
          0))
    p))

(defn ty-kid [(off i64) (i i64)] (-> i64)
  (al-get (load (field (types) kids)) (+ off i)))

;; Structural equality. Tuples compare by their MEMBERS, not by where those members happen
;; to sit in the kid array, or two structurally identical tuples would intern separately.
(defn ty-eq [(p Ty) (q Ty)] (-> bool)
  (if (!= (ty-tag p) (ty-tag q)) false
    (match p
      (TBot   [] true)
      (TTop   [] true)
      (TCtrl  [] true)
      (TXCtrl [] true)
      (TVal [vp] (match q
                   (TVal [vq] (val-eq vp vq))
                   (TBot [] false) (TTop [] false) (TCtrl [] false) (TXCtrl [] false)
                   (TTuple [o l] false)))
      (TTuple [op lp] (match q
                        (TTuple [oq lq] (and (= lp lq) (ty-kids-eq op oq lp)))
                        (TBot [] false) (TTop [] false) (TCtrl [] false) (TXCtrl [] false)
                        (TVal [v] false))))))

(defn ty-kids-eq [(oa i64) (ob i64) (n i64)] (-> bool)
  (let [(mut i) 0 (mut same) true]
    (loop
      (if (or (>= (load i) n) (not (load same))) (break)
        (do (if (!= (ty-kid oa (load i)) (ty-kid ob (load i))) (store! same false) 0)
            (store! i (+ (load i) 1))
            0)))
    (load same)))

(defn ty-hash [(p Ty)] (-> i64)
  (match p
    (TBot   [] 1099511628211)
    (TTop   [] 2199023255551)
    (TCtrl  [] 3331113965338635107)
    (TXCtrl [] 8493516592567629853)
    (TVal [v] (hash-step (val-hash v) 4))
    (TTuple [o l] (ty-kids-hash o l 0 (hash-step 5 l)))))

(defn ty-kids-hash [(off i64) (n i64) (i i64) (h i64)] (-> i64)
  (if (>= i n) h (ty-kids-hash off n (+ i 1) (hash-step h (ty-kid off i)))))

(impl Eq Ty (= [(x Ty) (y Ty)] (-> bool) (ty-eq x y)))

;; HashMap keys are compared through a KeyOps vtable of byte-pointer callbacks. These two
;; wrappers load the slot and hand off to the value-level functions above, so the
;; structural definition of equality lives in exactly one place.
(defn ty-keyhash [(slot (ptr i8)) (n i64)] (-> i64)
  (ty-hash (load (cast (ptr Ty) slot))))
(defn ty-keyeq [(ka (ptr i8)) (kb (ptr i8)) (n i64)] (-> bool)
  (ty-eq (load (cast (ptr Ty) ka)) (load (cast (ptr Ty) kb))))
(defn ty-keyops [] (-> (ptr KeyOps))
  (let [o (alloc-static KeyOps)]
    (store! (field o hash) (fnptr-of ty-keyhash))
    (store! (field o eq)   (fnptr-of ty-keyeq))
    (store! (field o size) (sizeof Ty))
    o))

; ---------------------------------------------------------------------------
; Interning, with duals installed in pairs
; ---------------------------------------------------------------------------
(defn ty-get [(t i64)] (-> Ty) (al-get (load (field (types) tab)) t))
(defn ty-count [] (-> i64) (al-len [Ty] (load (field (types) tab))))

(defn ty-push [(p (ptr Types)) (t Ty)] (-> i64)
  (let [id (al-len [Ty] (load (field p tab)))]
    (al-push! [Ty]  (field p tab)   t)
    (al-push! [i64] (field p duals) TY-NO-ID)
    (hm-put! [Ty i64] (field p intern) t id)
    id))

(defn ty-lookup [(p (ptr Types)) (t Ty)] (-> i64)
  (match (hm-get (load (field p intern)) t) (Some [id] id) (None [] TY-NO-ID)))

;; Intern a type and return its id. A type and its dual are installed together, so
;; `ty-dual` is a table read rather than a computation, and `dual(dual(x)) == x` holds by
;; construction instead of by luck.
(defn ty-intern [(t Ty)] (-> i64)
  (let [p (types) found (ty-lookup p t)]
    (if (!= found TY-NO-ID) found
      (let [id (ty-push p t)
            d  (ty-xdual t)]
        (if (ty-eq d t)
            (al-set! [i64] (field p duals) id id)          ; self-dual: on the centreline
          (let [did0 (ty-lookup p d)
                did  (if (= did0 TY-NO-ID) (ty-push p d) did0)]
            (al-set! [i64] (field p duals) id did)
            (al-set! [i64] (field p duals) did id)))
        id))))

(defn ty-dual [(t i64)] (-> i64)
  (al-get (load (field (types) duals)) t))

;; The structural dual, used only while interning. Tuple members are already interned, so
;; their duals are a table read and this does not recurse indefinitely.
(defn ty-xdual [(t Ty)] (-> Ty)
  (match t
    (TBot   [] (TTop))
    (TTop   [] (TBot))
    (TCtrl  [] (TXCtrl))
    (TXCtrl [] (TCtrl))
    (TVal [v] (TVal (val-dual v)))
    (TTuple [off len] (ty-tuple-of-duals off len))))

(defn ty-tuple-of-duals [(off i64) (len i64)] (-> Ty)
  (let [p (types)
        noff (al-len [i64] (load (field p kids)))
        (mut i) 0]
    (loop
      (if (>= (load i) len) (break)
        (do (al-push! [i64] (field p kids) (ty-dual (ty-kid off (load i))))
            (store! i (+ (load i) 1))
            0)))
    (TTuple noff len)))

; ============================================================================
; meet / join / isa
; ============================================================================
(defn ty-meet [(a i64) (b i64)] (-> i64)
  (if (= a b) a
    (let [ta (ty-get a) tb (ty-get b)]
      (match ta
        (TBot   [] (t-bot))
        (TTop   [] b)
        (TCtrl  [] (ty-meet-ctrl b true))
        (TXCtrl [] (ty-meet-ctrl b false))
        (TVal [va] (match tb
                     (TBot   [] (t-bot))
                     (TTop   [] a)
                     (TCtrl  [] (t-bot))
                     (TXCtrl [] (t-bot))
                     (TVal [vb] (ty-intern (TVal (val-meet va vb))))
                     (TTuple [o l] (t-bot))))
        (TTuple [oa la] (match tb
                          (TBot   [] (t-bot))
                          (TTop   [] a)
                          (TCtrl  [] (t-bot))
                          (TXCtrl [] (t-bot))
                          (TVal [v] (t-bot))
                          (TTuple [ob lb] (if (!= la lb) (t-bot)
                                            (ty-meet-tuples oa ob la)))))))))

;; Control against anything: control meets control (reachable wins, since reachable is the
;; low element), and control mixed with a value or a tuple is genuinely unrelated.
(defn ty-meet-ctrl [(b i64) (a-reachable bool)] (-> i64)
  (match (ty-get b)
    (TBot   [] (t-bot))
    (TTop   [] (if a-reachable (t-ctrl) (t-xctrl)))
    (TCtrl  [] (t-ctrl))
    (TXCtrl [] (if a-reachable (t-ctrl) (t-xctrl)))
    (TVal [v]      (t-bot))
    (TTuple [o l]  (t-bot))))

(defn ty-meet-tuples [(oa i64) (ob i64) (n i64)] (-> i64)
  (let [p (types)
        noff (al-len [i64] (load (field p kids)))
        (mut i) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (al-push! [i64] (field p kids) (ty-meet (ty-kid oa (load i)) (ty-kid ob (load i))))
            (store! i (+ (load i) 1))
            0)))
    (ty-intern (TTuple noff n))))

;; join(a,b) = ~(~a meet ~b). Defined, not implemented: the lattice has one primitive.
(defn ty-join [(a i64) (b i64)] (-> i64)
  (ty-dual (ty-meet (ty-dual a) (ty-dual b))))

;; ORIENTATION. ANY (top) is "nothing is known yet, no value is possible"; ALL (bottom) is
;; "any value at all". Analysis starts at ANY and FALLS toward ALL as it learns. So a more
;; specific type is HIGHER, and `a isa b` means "a is at least as specific as b", i.e. a is
;; at or above b. That makes `x isa ALL` true for every x and `ANY isa x` true for every x,
;; which reads backwards until you hold the orientation in mind. It is Simple's convention
;; and the tests pin it down explicitly.
(defn ty-isa [(a i64) (b i64)] (-> bool) (= (ty-meet a b) b))

;; "`new` is at or below `old`", which is the only direction an analysis is allowed to move a
;; type. It is `isa` with its arguments named after the thing being asserted, because
;; `(ty-isa old new)` reads backwards at the assertion site and an assertion nobody can read
;; is an assertion that gets written the wrong way round. (M0 had three of those.)
(defn ty-falls? [(old i64) (new i64)] (-> bool) (ty-isa old new))

(defn ty-high? [(t i64)] (-> bool)
  (match (ty-get t)
    (TBot   [] false)
    (TTop   [] true)
    (TCtrl  [] false)
    (TXCtrl [] true)
    (TVal [v] (val-high? v))
    (TTuple [o l] false)))

(defn ty-const? [(t i64)] (-> bool)
  (match (ty-get t)
    (TBot   [] false)
    (TTop   [] false)
    (TCtrl  [] false)
    (TXCtrl [] false)
    (TVal [v] (val-const? v))
    (TTuple [o l] false)))

; ============================================================================
; Well-known types
; ============================================================================
;; Seeded in a fixed order so the ids are stable, which is what makes printed IR and
;; golden tests comparable across runs.
(defn ty-seed [(p (ptr Types))] (-> i64)
  (ty-intern (TBot))     ; 0, and TTop lands at 1 as its dual
  (ty-intern (TCtrl))    ; 2, TXCtrl at 3
  (t-dyn)                ; 4, ~dyn at 5
  0)

(defn t-bot   [] (-> i64) 0)
(defn t-top   [] (-> i64) 1)
(defn t-ctrl  [] (-> i64) 2)
(defn t-xctrl [] (-> i64) 3)

;; A value of a given kind set, with every refinement at the BOTTOM of its axis: the least
;; type with those kinds. The int axis is fully widened, since this is already the widest
;; integer range and cannot usefully widen further.
(defn t-kinds [(kinds i64)] (-> i64)
  (ty-intern (TVal (val-make kinds TY-IMIN TY-IMAX TY-WIDEN-MAX FSZ-LOW 0 -1 -1))))

(defn t-dyn    [] (-> i64) (t-kinds VK-MASK))    ; any value at all
(defn t-nodyn  [] (-> i64) (ty-dual (t-dyn)))    ; ~dyn: a value slot, but no value fits
(defn t-num    [] (-> i64) (t-kinds VK-NUM))
(defn t-int    [] (-> i64) (t-kinds VK-INT))
(defn t-flt    [] (-> i64) (t-kinds VK-FLT))
(defn t-str    [] (-> i64) (t-kinds VK-STR))
(defn t-bool   [] (-> i64) (t-kinds VK-BOOL))
(defn t-undef  [] (-> i64) (t-kinds VK-UNDEF))
(defn t-null   [] (-> i64) (t-kinds VK-NULL))
(defn t-obj    [] (-> i64) (t-kinds VK-OBJ))
(defn t-fun    [] (-> i64) (t-kinds VK-FUN))

;; A narrow value: refinements pinned on the named axis, every other axis at its bottom so
;; that meeting with a wider type of the same kind behaves.
(defn t-int-range [(lo i64) (hi i64)] (-> i64)
  (ty-intern (TVal (val-make VK-INT lo hi 0 FSZ-LOW 0 -1 -1))))
(defn t-int-con [(v i64)] (-> i64) (t-int-range v v))

(defn t-bool-con [(b bool)] (-> i64)
  (let [n (if b 1 0)]
    (ty-intern (TVal (val-make VK-BOOL n n 0 FSZ-LOW 0 -1 -1)))))

(defn t-flt-bits [(bits i64)] (-> i64)
  (ty-intern (TVal (val-make VK-FLT TY-IMIN TY-IMAX TY-WIDEN-MAX FSZ-CON bits -1 -1))))
(defn t-flt-con [(x f64)] (-> i64) (t-flt-bits (f64-bits x)))

(defn t-fun-set [(fidxs i64)] (-> i64)
  (ty-intern (TVal (val-make VK-FUN TY-IMIN TY-IMAX TY-WIDEN-MAX FSZ-LOW 0 fidxs -1))))
(defn t-fun-con [(fidx i64)] (-> i64) (t-fun-set (<< 1 fidx)))

(defn t-obj-shapes [(shapes i64)] (-> i64)
  (ty-intern (TVal (val-make VK-OBJ TY-IMIN TY-IMAX TY-WIDEN-MAX FSZ-LOW 0 -1 shapes))))
(defn t-obj-shape [(shape i64)] (-> i64) (t-obj-shapes (<< 1 shape)))

(defn t-tuple2 [(a i64) (b i64)] (-> i64)
  (let [p (types) off (al-len [i64] (load (field p kids)))]
    (al-push! [i64] (field p kids) a)
    (al-push! [i64] (field p kids) b)
    (ty-intern (TTuple off 2))))

(defn t-tuple3 [(a i64) (b i64) (c i64)] (-> i64)
  (let [p (types) off (al-len [i64] (load (field p kids)))]
    (al-push! [i64] (field p kids) a)
    (al-push! [i64] (field p kids) b)
    (al-push! [i64] (field p kids) c)
    (ty-intern (TTuple off 3))))

; ---------------------------------------------------------------------------
; Widening: how an interval axis is forced to converge
; ---------------------------------------------------------------------------
;; Bump the widening counter; once it is spent, fall to the bottom of the int axis. A loop
;; induction variable's range would otherwise creep upward forever and the optimistic pass
;; would not terminate.
;; How much widening fuel this type has already spent.
(defn ty-iwide [(t i64)] (-> i64)
  (match (ty-get t)
    (TVal [v] (val-iwide v))
    (TBot   [] TY-WIDEN-MAX)     ; already at the bottom; no fuel left to spend
    (TTop   [] 0) (TCtrl [] 0) (TXCtrl [] 0) (TTuple [o l] 0)))

(defn ty-with-iwide [(t i64) (w i64)] (-> i64)
  (match (ty-get t)
    (TVal [v] (ty-intern (TVal (val-make (val-kinds v) (val-ilo v) (val-ihi v) w
                                         (val-fsz v) (val-fbits v)
                                         (val-fidxs v) (val-shapes v)))))
    (TBot [] t) (TTop [] t) (TCtrl [] t) (TXCtrl [] t) (TTuple [o l] t)))

;; Widen `t`, taking the fuel already spent from `prev` rather than from `t` itself.
;;
;; This distinction is the whole difference between terminating and not. A loop phi's new type is
;; the meet of its incoming paths, and integer arithmetic MINTS A FRESH TYPE: `t-int-range` sets
;; the counter to 0. So a phi that reads its fuel out of that meet is handed a full tank on every
;; trip, one widening step never accumulates into the next, and the range creeps by one step per
;; round for ever. The fuel has to come from the phi's own previous type, which is the only place
;; that remembers how many times it has already widened.
(defn ty-widen-from [(prev i64) (t i64)] (-> i64)
  (let [w (imax2 (ty-iwide prev) (ty-iwide t))]
    (if (>= w TY-WIDEN-MAX)
        (match (ty-get t)
          (TVal [v] (t-kinds (val-kinds v)))
          (TBot [] t) (TTop [] t) (TCtrl [] t) (TXCtrl [] t) (TTuple [o l] t))
      (ty-with-iwide t (+ w 1)))))

(defn ty-widen [(t i64)] (-> i64)
  (match (ty-get t)
    (TVal [v]
      (let [w0 (val-iwide v)
            ; A negative counter only ever arises as the image of `dual`. Widening is there
            ; to bound a FALLING sequence, so entering from the negative side jumps straight
            ; into the positive range; otherwise the bound would be 2*TY-WIDEN-MAX+1 steps
            ; instead of TY-WIDEN-MAX.
            w  (if (< w0 0) 0 w0)]
        (if (>= w TY-WIDEN-MAX) (t-kinds (val-kinds v))
          (ty-intern (TVal (val-make (val-kinds v)
                                     (val-ilo v) (val-ihi v) (+ w 1)
                                     (val-fsz v) (val-fbits v)
                                     (val-fidxs v) (val-shapes v)))))))
    (TBot [] t) (TTop [] t) (TCtrl [] t) (TXCtrl [] t) (TTuple [o l] t)))

; ============================================================================
; f64 <-> bits
; ============================================================================
;; A numeric `cast` between f64 and i64 converts the VALUE; a bit pattern needs a round
;; trip through memory, which LLVM folds to a register move.
(defn f64-bits [(x f64)] (-> i64)
  (let [p (alloc-stack f64)] (store! p x) (load (cast (ptr i64) p))))
(defn bits-f64 [(b i64)] (-> f64)
  (let [p (alloc-stack i64)] (store! p b) (load (cast (ptr f64) p))))

; ============================================================================
; Printing
; ============================================================================
;; `print-str` and `fmt` return `(Result i64 IoError)`. A failed write to a debug stream is
;; not worth infecting every printer's signature with, so it is discarded, but through a
;; named helper so the discard is deliberate and greppable rather than accidental.
(defn ps [(w (ptr Writer)) (s (slice u8))] (-> i64) (print-str w s) 0)

(defn ty-print [(w (ptr Writer)) (t i64)] (-> i64)
  (match (ty-get t)
    (TBot   [] (ps w "ALL"))
    (TTop   [] (ps w "ANY"))
    (TCtrl  [] (ps w "ctrl"))
    (TXCtrl [] (ps w "~ctrl"))
    (TVal [v] (val-print w v))
    (TTuple [off len] (tuple-print w off len))))

(defn tuple-print [(w (ptr Writer)) (off i64) (len i64)] (-> i64)
  (ps w "[")
  (let [(mut i) 0]
    (loop
      (if (>= (load i) len) (break)
        (do (if (> (load i) 0) (ps w " ") 0)
            (ty-print w (ty-kid off (load i)))
            (store! i (+ (load i) 1))
            0))))
  (ps w "]"))

;; A value prints as its kinds, then each pinned refinement.
;;
;; Two display conventions, both borrowed from how the lattice is normally drawn. A kind set
;; with most kinds present is almost always the dual of a small one, so it shows as `~` plus
;; the complement (`~int` rather than nine names). And when the set is a single kind, the
;; refinement is written compactly against it (`int=0`, `flt=3.5`) instead of being labelled.
(defn val-print [(w (ptr Writer)) (v Val)] (-> i64)
  (let [k (val-kinds v)
        n (popcount64 k)]
    (if (= k VK-NONE) (ps w "~dyn")
      (if (= k VK-MASK) (ps w "dyn")
        (do (if (> n 5)
                (do (ps w "~") (kinds-print w (bits-dual k VK-MASK)))
              (kinds-print w k))
            (refinements-print w v (= n 1))
            0)))))

;; `solo` means the kind set is a single kind, so the refinement needs no label.
(defn refinements-print [(w (ptr Writer)) (v Val) (solo bool)] (-> i64)
  (let [k (val-kinds v)]
    ; bool constants ride on the int axis, so both kinds read it
    (if (and (!= (& k (| VK-INT VK-BOOL)) 0) (!= (val-iwide v) TY-WIDEN-MAX))
        (do (if solo 0 (ps w " int"))
            (int-range-print w (val-ilo v) (val-ihi v)))
      0)
    (if (and (!= (& k VK-FLT) 0) (= (val-fsz v) FSZ-CON))
        (do (if solo 0 (ps w " flt"))
            (ps w "=")
            (fmt w "{f}" (bits-f64 (val-fbits v)))
            0)
      0)
    (if (and (!= (& k VK-FUN) 0) (!= (val-fidxs v) -1))
        (do (if solo 0 (ps w " fun")) (fmt w "#{d}" (val-fidxs v)) 0)
      0)
    (if (and (!= (& k VK-OBJ) 0) (!= (val-shapes v) -1))
        (do (if solo 0 (ps w " obj")) (fmt w "@{d}" (val-shapes v)) 0)
      0)
    0))

;; The axis bounds print as names, not as their digits. Partly because they are noise, and
;; partly because `fmt`'s `{d}` renders INT64_MIN as "-0".
(defn ibound-print [(w (ptr Writer)) (n i64)] (-> i64)
  (if (= n TY-IMIN) (ps w "min")
    (if (= n TY-IMAX) (ps w "max")
      (do (fmt w "{d}" n) 0))))

(defn int-range-print [(w (ptr Writer)) (lo i64) (hi i64)] (-> i64)
  (if (= lo hi) (do (ps w "=") (ibound-print w lo))
    (do (ps w (if (> lo hi) "=~[" "=["))
        (ibound-print w (if (> lo hi) hi lo))
        (ps w "..")
        (ibound-print w (if (> lo hi) lo hi))
        (ps w "]"))))

(defn kind-name [(bit i64)] (-> (slice u8))
  (if (= bit VK-UNDEF) "undefined"
    (if (= bit VK-NULL) "null"
      (if (= bit VK-BOOL) "bool"
        (if (= bit VK-INT) "int"
          (if (= bit VK-FLT) "flt"
            (if (= bit VK-STR) "str"
              (if (= bit VK-SYM) "sym"
                (if (= bit VK-BIG) "bigint"
                  (if (= bit VK-OBJ) "obj"
                    (if (= bit VK-FUN) "fun" "?")))))))))))

(defn kinds-print [(w (ptr Writer)) (k i64)] (-> i64)
  (if (= (& k VK-NUM) VK-NUM)
      ; int|flt together is the source language's `number`; print it that way
      (do (ps w "num")
          (if (!= (& k (^ VK-NUM -1)) 0)
              (do (ps w "|") (kinds-print-bits w (& k (^ VK-NUM -1)) 0))
            0)
          0)
    (kinds-print-bits w k 0)))

(defn kinds-print-bits [(w (ptr Writer)) (k i64) (first-done i64)] (-> i64)
  (let [(mut bit) 1 (mut done) first-done]
    (loop
      (if (> (load bit) VK-FUN) (break)
        (do (if (!= (& k (load bit)) 0)
                (do (if (> (load done) 0) (ps w "|") 0)
                    (ps w (kind-name (load bit)))
                    (store! done (+ (load done) 1))
                    0)
              0)
            (store! bit (<< (load bit) 1))
            0)))
    (load done)))

; ============================================================================
; A sample of the lattice, for property tests
; ============================================================================
;; Property tests need a set of types that exercises every axis at its top, centreline and
;; bottom, plus duals and composites. `ty-sample-count` and `ty-sample` are that set. The
;; laws are then checked over every pair and a spread of triples.
(defn ty-sample-count [] (-> i64) 28)

(defn ty-sample [(i i64)] (-> i64)
  (case i
    0  (t-bot)
    1  (t-top)
    2  (t-ctrl)
    3  (t-xctrl)
    4  (t-dyn)
    5  (t-nodyn)
    6  (t-num)
    7  (t-int)
    8  (t-flt)
    9  (t-str)
    10 (t-bool)
    11 (t-undef)
    12 (t-null)
    13 (t-obj)
    14 (t-fun)
    15 (t-int-con 0)
    16 (t-int-con 1)
    17 (t-int-con -7)
    18 (t-int-range 0 10)
    19 (t-int-range -5 5)
    20 (t-bool-con true)
    21 (t-bool-con false)
    22 (t-flt-con 0.0)
    23 (t-flt-con 3.5)
    24 (t-fun-con 3)
    25 (t-obj-shape 2)
    26 (t-tuple2 (t-ctrl) (t-int))
    27 (t-tuple2 (t-ctrl) (t-dyn))
    (t-bot)))

;; Duals of the sample are themselves interesting inputs; this doubles the set without
;; hand-listing high types, which are the easiest ones to get wrong.
(defn ty-sample-dual [(i i64)] (-> i64) (ty-dual (ty-sample i)))
