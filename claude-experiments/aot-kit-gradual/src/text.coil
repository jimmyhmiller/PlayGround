;; The EXACT textual form of a type: printer and parser, in one file because they are one
;; format. D7 says the textual IR round-trips and that round-tripping is a TESTED identity, and
;; M3's gate is `print` then `parse` is the identity on the whole corpus. A graph round trip
;; cannot be exact while the type form is ambiguous, so this is the enabling half of it.
;;
;; WHY A SECOND PRINTER. `ty-print` in ty.coil is the human and diagram form and it is
;; deliberately lossy: it consults the KIND BITS before printing a refinement, so `int` with a
;; leftover float constant prints as plain `int`, and two distinct interned types print the same
;; string. That is right for a diagram label and fatal for a format that has to decode. So this
;; printer decides every axis BY FIELD VALUE and never by a kind bit. Every field of `Val` has
;; a printed form whenever it differs from its default, whether or not the matching kind bit is
;; set.
;;
;; THE TWO SEPARATORS MUST DIFFER, and this is the one design constraint that is easy to get
;; wrong. If a value's refinements and a tuple's members were both space-separated, then
;; `[int flt=b1]` reads two ways: a 1-tuple whose member is `int` carrying a float constant, or
;; a 2-tuple of `int` and a float constant. No amount of lookahead fixes that; the printer would
;; emit one string for two types. So refinements are space-separated (which keeps every value's
;; spelling identical to `ty-print`, and every golden string in the project is a value) and
;; tuple members are comma-separated.
;;
;; THE FIRST REFINEMENT MAY ATTACH. When the kinds text is exactly one kind whose name is also
;; an axis label, the first refinement drops the label and hangs straight off it: `int=0`,
;; `bool=1`, `fun#8`, `obj@4`. Only the FIRST can, because an attached spec in the middle of the
;; list would have nothing to bind to. Which axis attaches is derived from the kinds VALUE by
;; `attach-axis`, so printer and parser cannot disagree about it. `bool` attaches the INT axis,
;; since bool constants ride on it.
;;
;; NUMBERS ARE WRITTEN BY `dec-print`, NOT BY `{d}`. `fmt`'s `{d}` renders INT64_MIN as "-0",
;; which is cosmetic in a debug dump and a correctness bug here: `fun#-0` decodes to 0, and
;; `t-fun-con 63` really is the bitset INT64_MIN. Float constants are written as their signed
;; decimal BIT PATTERN for the same reason twice over: `{f}` is a fixed 6-digit display that
;; cannot round-trip, and NaN is not reflexive under `fcmp` while interning needs exact identity.
;;
;; ONE NAMED CODE PER FAILURE CLASS, following verify.coil. A parser that returns a plausible
;; type id on malformed input turns a format bug into a miscompile hunt, so `ty-parse` panics
;; with the code's NAME and `ty-try-parse` leaves it readable for a test. "parse failed" is
;; satisfied by a parser that always fails; "a missing `..` reports TERR-NO-DOTDOT" is a claim
;; about a specific check being the one that noticed.
(module text)

(import "alloc.coil"     :use *)
(import "control.coil"   :use *)
(import "io.coil"        :use *)
(import "fmt.coil"       :use *)
(import "slice.coil"     :use *)
(import "ty.coil"        :use *)

; ============================================================================
; The grammar
; ============================================================================
;;   type    := "ALL" | "ANY" | "ctrl" | "~ctrl" | mem | tuple | value
;;   tuple   := "[" ( type ("," type)* )? "]"
;;   mem     := "mem#" dec " " type          ; the type must be a value, "ANY" or "ALL"
;;   value   := kinds attached? (" " label spec)*
;;   kinds   := "dyn" | "~dyn" | "~"? name ("|" name)*
;;   name    := "undefined"|"null"|"bool"|"int"|"num"|"flt"|"str"|"sym"|"bigint"|"obj"|"fun"
;;   label   := "int" | "w" | "flt" | "fun" | "obj"
;;   spec    := "=" bound | "=[" bound ".." bound "]" | "=~[" bound ".." bound "]"   ; int
;;            | dec                                                                 ; w
;;            | "=b" dec | "^"                                                      ; flt
;;            | "#" dec                                                             ; fun
;;            | "@" dec                                                             ; obj
;;   bound   := "min" | "max" | dec
;;   dec     := "-"? digit+                     ; the whole i64 range, INT64_MIN included
;;
;; `attached?` is the first refinement's spec with its label dropped, allowed only when
;; `attach-axis` of the kinds value names that axis.

; ---------------------------------------------------------------------------
; The bytes the grammar is made of, named so a comparison reads as the character.
; ---------------------------------------------------------------------------
(const CH-SPACE  i64 32)
(const CH-HASH   i64 35)
(const CH-COMMA  i64 44)
(const CH-MINUS  i64 45)
(const CH-ZERO   i64 48)
(const CH-NINE   i64 57)
(const CH-EQ     i64 61)
(const CH-AT     i64 64)
(const CH-LBRACK i64 91)
(const CH-RBRACK i64 93)
(const CH-CARET  i64 94)
(const CH-LOWER-B i64 98)
(const CH-BAR    i64 124)
(const CH-TILDE  i64 126)

; ---------------------------------------------------------------------------
; The axes, as a closed set of small ids
; ---------------------------------------------------------------------------
;; Case keys are named constants, never literal numbers: a renumbering would otherwise rewire
;; every dispatch on an axis at once and silently.
(const AX-NONE i64 0)      ; "no axis attaches here"
(const AX-INT  i64 1)
(const AX-WIDE i64 2)
(const AX-FLT  i64 3)
(const AX-FUN  i64 4)
(const AX-OBJ  i64 5)

;; The label each axis is written with. `w` is NOT a kind name, which is why the widening counter
;; never attaches and never appears in `attach-axis`.
;;
;; AX-NONE has no label, and there is no placeholder for it: a printer that emitted `?` would
;; produce a string the parser rejects, and the round-trip check would then report the format as
;; ambiguous when the real fault was here.
(defn axis-label [(ax i64)] (-> (slice u8))
  (case ax
    AX-INT  "int"
    AX-WIDE "w"
    AX-FLT  "flt"
    AX-FUN  "fun"
    AX-OBJ  "obj"
    (do (panic-text "axis-label: no printed label for this axis") "")))

;; Which axis a spec attached directly to the kinds text belongs to, decided by the kinds VALUE.
;; A single kind whose name is also an axis label may carry its axis unlabelled; `bool` carries
;; the INT axis, because a bool constant is stored on it. Everything else (`dyn`, `~dyn`, a
;; union, a complement) has no attaching axis, so a sigil right after it is malformed rather
;; than guessed at.
(defn attach-axis [(k i64)] (-> i64)
  (if (= k VK-INT) AX-INT
    (if (= k VK-BOOL) AX-INT
      (if (= k VK-FLT) AX-FLT
        (if (= k VK-FUN) AX-FUN
          (if (= k VK-OBJ) AX-OBJ AX-NONE))))))

; ============================================================================
; Failure codes
; ============================================================================
(const TERR-NONE             i64 0)   ; no failure

(const TERR-UNKNOWN-KIND     i64 1)   ; a kind name that is not one of the eleven
(const TERR-DUP-KIND         i64 2)   ; the same kind bit named twice (`int|int`, `num|flt`)
(const TERR-ATTACHED-NO-AXIS i64 3)   ; a spec attached to a kinds text that names no one axis
(const TERR-BAD-REFINE       i64 4)   ; a refinement label that is not int/w/flt/fun/obj
(const TERR-DUP-REFINE       i64 5)   ; the same axis refined twice
(const TERR-BAD-SIGIL        i64 6)   ; the wrong sigil for this axis (`fun=3`, `flt=3`)
(const TERR-BAD-BOUND        i64 7)   ; an int bound that is not min/max and has no digits
(const TERR-BAD-INT          i64 8)   ; a decimal with no digits at all
(const TERR-INT-RANGE        i64 9)   ; a decimal that does not fit in an i64
(const TERR-NO-DOTDOT        i64 10)  ; a bracketed range with no ".."
(const TERR-NO-RBRACK        i64 11)  ; a bracketed range or a tuple with no "]"
(const TERR-BAD-RANGE        i64 12)  ; `[a..b]` with a >= b; the printer only writes a < b
(const TERR-WIDEN-RANGE      i64 13)  ; |w| > TY-WIDEN-MAX: not a counter the lattice can reach
(const TERR-DEPTH            i64 14)  ; tuples nested deeper than the recursion budget
;; The comma scan's arity and the parsed member count disagreed. This one is an ASSERTION between
;; two implementations of "how many members are here", not a report about the input: no text is
;; currently known to reach it, because every way the member loop can stop early also sets one of
;; the codes above first. It is here rather than left implicit because the alternative to noticing
;; the disagreement is an unfilled member slot, and that is a panic inside `ty-tuple-close` with
;; nothing to say about which text caused it. If a test ever does provoke it, that is a real find
;; about the grammar and not a badly written test.
(const TERR-TUPLE-COUNT      i64 15)
(const TERR-TRAILING         i64 16)  ; a complete type, then bytes left over

;; The input ended where a type had to start. A non-empty text that starts no known form is NOT
;; this code: every form that is not one of the four keywords or a tuple is attempted as a value,
;; so `"wat"` is reported by the kind-name parser as TERR-UNKNOWN-KIND. There is deliberately no
;; separate "unknown top-level form", because there is no way to tell one from a misspelled kind.
(const TERR-UNKNOWN-FORM     i64 17)

;; The memory production. `mem` is matched as a WORD and then `#` is required, rather than the
;; whole `mem#` being one literal, so a text that starts `mem` and then goes wrong is reported as
;; a broken memory form instead of falling through to the value parser and coming back as
;; TERR-UNKNOWN-KIND about a kind nobody wrote.
(const TERR-MEM-NO-HASH      i64 18)  ; `mem` not followed by the alias bitset's `#`
(const TERR-MEM-NO-SPACE     i64 19)  ; `mem#N` with no space and contents after it
;; The contents parsed, but to something `t-mem` refuses to hold: a control edge, a tuple, or
;; another memory type. This is a report about the INPUT, not an assertion: `mem#1 ctrl` is a text
;; a hand-written graph can easily contain, and the alternative to naming it here is `t-mem`'s
;; abort with nothing to say about which text caused it.
(const TERR-MEM-CONTENTS     i64 20)

(defn text-err-name [(c i64)] (-> (slice u8))
  (case c
    TERR-NONE             "TERR-NONE"
    TERR-UNKNOWN-KIND     "TERR-UNKNOWN-KIND"
    TERR-DUP-KIND         "TERR-DUP-KIND"
    TERR-ATTACHED-NO-AXIS "TERR-ATTACHED-NO-AXIS"
    TERR-BAD-REFINE       "TERR-BAD-REFINE"
    TERR-DUP-REFINE       "TERR-DUP-REFINE"
    TERR-BAD-SIGIL        "TERR-BAD-SIGIL"
    TERR-BAD-BOUND        "TERR-BAD-BOUND"
    TERR-BAD-INT          "TERR-BAD-INT"
    TERR-INT-RANGE        "TERR-INT-RANGE"
    TERR-NO-DOTDOT        "TERR-NO-DOTDOT"
    TERR-NO-RBRACK        "TERR-NO-RBRACK"
    TERR-BAD-RANGE        "TERR-BAD-RANGE"
    TERR-WIDEN-RANGE      "TERR-WIDEN-RANGE"
    TERR-DEPTH            "TERR-DEPTH"
    TERR-TUPLE-COUNT      "TERR-TUPLE-COUNT"
    TERR-TRAILING         "TERR-TRAILING"
    TERR-UNKNOWN-FORM     "TERR-UNKNOWN-FORM"
    TERR-MEM-NO-HASH      "TERR-MEM-NO-HASH"
    TERR-MEM-NO-SPACE     "TERR-MEM-NO-SPACE"
    TERR-MEM-CONTENTS     "TERR-MEM-CONTENTS"
    "TERR-?"))

; ============================================================================
; Parser state
; ============================================================================
;; Only the FIRST failure is kept, with the byte offset it was found at. Coil has no early
;; return, so every parse step instead checks `text-ok?` before it uses the previous step's
;; result; keeping the first code means that check never overwrites the interesting one with
;; whatever the parser tripped over next.
(defstruct TextState
  [(err   i64)
   (pos   i64)
   (depth i64)])     ; tuple nesting, so a deep input errors instead of overflowing the C stack

(defn text-state [] (-> (ptr TextState)) (alloc-static TextState))

(defn text-err     [] (-> i64) (load (field (text-state) err)))
(defn text-err-pos [] (-> i64) (load (field (text-state) pos)))
(defn text-ok?     [] (-> bool) (= (load (field (text-state) err)) TERR-NONE))

;; There is NO limit on a tuple's arity: the member window is reserved before the members are
;; parsed (`ty-tuple-open`), so no per-frame array bounds it, which matters because M6's `Start`
;; gets one output per parameter and a printer that refuses to print a legally constructed type
;; is worse than no printer.
;;
;; Nesting depth IS bounded, because `parse-type` recurses on the C stack, and it reports TERR-DEPTH
;; instead of overflowing it. The bound is NOT this file's to choose: a type the lattice can mint and
;; this parser refuses to read is a type whose exact form cannot be printed at all, and reporting
;; that as a format ambiguity sends the reader here instead of to the constructor. So the number is
;; `TY-MAX-TUPLE-DEPTH` in src/ty.coil, `ty-tuple-close` refuses to mint anything deeper, and a gate
;; pins the two equal and round-trips a tuple at exactly the bound.
(const TEXT-MAX-DEPTH i64 TY-MAX-TUPLE-DEPTH)

; ---------------------------------------------------------------------------
; The cursor
; ---------------------------------------------------------------------------
;; A byte offset into a borrowed slice. The parser owns no memory at all: no buffer, no member
;; array, no allocator. It is called from `ty-injective?` on every interned type, and a parser
;; with its own storage would make that sweep a memory test instead of a format test.
;;
;; It does reach into the type table, though, and the claim here used to be "the only growth it
;; causes is interning", which was FALSE for every tuple: `parse-tuple-body` reserves a member
;; window before it can know whether the tuple already exists, and the kid array is append-only.
;; `ty-print-exact` parses on every print to check its own output, so PRINTING an interned tuple
;; grew the table, unbounded in the number of prints. `ty-tuple-close` now reclaims the window when
;; the tuple turns out to already exist, so the accurate statement is: a SUCCESSFUL parse grows the
;; table by exactly the types it interns and by nothing else. A parse that fails part way through a
;; tuple still abandons its reservation, which is what an append-only arena is for and is bounded by
;; the number of malformed inputs rather than by the number of parses.
(defstruct Cur
  [(data (ptr u8))
   (len  i64)
   (i    i64)])

(defn cur-eof? [(c (ptr Cur))] (-> bool) (>= (load (field c i)) (load (field c len))))

;; -1 at end of input, which is not a byte, so no comparison against a real byte can match it.
(defn cur-peek [(c (ptr Cur))] (-> i64)
  (if (cur-eof? c) -1
    (cast i64 (load (index (load (field c data)) (load (field c i)))))))

(defn cur-bump! [(c (ptr Cur))] (-> i64)
  (store! (field c i) (+ (load (field c i)) 1)) 0)

(defn text-fail! [(c (ptr Cur)) (code i64)] (-> i64)
  (let [p (text-state)]
    (if (text-ok?)
        (do (store! (field p err) code) (store! (field p pos) (load (field c i))) 0)
      0)))

;; Match a literal word, consuming it only on a full match. No kind name is a prefix of another
;; and no axis label is a prefix of another, so a word match needs no longest-first ordering and
;; no backtracking beyond this.
(defn cur-eat? [(c (ptr Cur)) (word (slice u8))] (-> bool)
  (let [wn    (slice-len word)
        start (load (field c i))]
    (if (> (+ start wn) (load (field c len))) false
      (let [(mut j) 0 (mut ok) true]
        (loop
          (if (or (>= (load j) wn) (not (load ok))) (break)
            (do (if (!= (cast i64 (load (index (load (field c data)) (+ start (load j)))))
                        (cast i64 (slice-get word (load j))))
                    (store! ok false)
                  0)
                (store! j (+ (load j) 1))
                0)))
        (if (load ok) (do (store! (field c i) (+ start wn)) true) false)))))

(defn cur-eat-ch? [(c (ptr Cur)) (ch i64)] (-> bool)
  (if (= (cur-peek c) ch) (do (cur-bump! c) true) false))

(defn digit? [(b i64)] (-> bool) (and (>= b CH-ZERO) (<= b CH-NINE)))

;; The four sigils that can hang straight off the kinds text. A digit is NOT one of them, which
;; is why the widening counter can never be the attached refinement.
(defn refine-sigil? [(b i64)] (-> bool)
  (or (= b CH-EQ) (or (= b CH-CARET) (or (= b CH-HASH) (= b CH-AT)))))

; ============================================================================
; Numbers
; ============================================================================
;; INT64_MIN / 10 and INT64_MIN % 10, as the two halves of "the next multiply-and-subtract still
;; fits". Named because a mistyped digit here is an overflow the parser reports as a valid number.
(const DEC-ACC-LIMIT i64 -922337203685477580)
(const DEC-LAST-DIGIT i64 8)

;; Parse a signed decimal over the whole i64 range. It accumulates NEGATIVE, because the magnitude
;; of INT64_MIN has no positive i64 form, so a parser that builds the magnitude first cannot read
;; back the number the printer wrote.
(defn parse-dec [(c (ptr Cur))] (-> i64)
  (let [neg (cur-eat-ch? c CH-MINUS)
        (mut acc) 0
        (mut digits) 0
        (mut over) false]
    (loop
      (if (not (digit? (cur-peek c))) (break)
        (let [d (- (cur-peek c) CH-ZERO)]
          (if (or (< (load acc) DEC-ACC-LIMIT)
                  (and (= (load acc) DEC-ACC-LIMIT) (> d DEC-LAST-DIGIT)))
              (do (store! over true) 0)
            (do (store! acc (- (* (load acc) 10) d))
                (store! digits (+ (load digits) 1))
                (cur-bump! c)
                0))
          (if (load over) (break) 0))))
    (if (load over) (do (text-fail! c TERR-INT-RANGE) 0)
      (if (= (load digits) 0) (do (text-fail! c TERR-BAD-INT) 0)
        (if neg (load acc)
          ; +9223372036854775808 is the one magnitude with no positive form
          (if (= (load acc) TY-IMIN) (do (text-fail! c TERR-INT-RANGE) 0)
            (- 0 (load acc))))))))

;; An int-axis bound. `min` and `max` are names rather than digits: partly because the extremes
;; are noise in a printed range, and partly because they are the values a decimal writer is
;; most likely to get wrong.
(defn parse-bound [(c (ptr Cur))] (-> i64)
  (if (cur-eat? c "min") TY-IMIN
    (if (cur-eat? c "max") TY-IMAX
      (let [b (cur-peek c)]
        (if (or (= b CH-MINUS) (digit? b)) (parse-dec c)
          (do (text-fail! c TERR-BAD-BOUND) 0))))))

; ============================================================================
; Printing
; ============================================================================
;; The kinds text. Same two display conventions as `ty-print`, and it calls the SAME
;; `kinds-print`, so there is one spelling of a kind set in the project and the two printers
;; cannot drift on it. `dyn` and `~dyn` are named rather than derived because the general rules
;; degenerate on them: the complement of the full set is empty, and the name list of the empty
;; set is empty.
(defn kinds-write-exact [(w (ptr Writer)) (k i64)] (-> i64)
  (if (= k VK-MASK) (ps w "dyn")
    (if (= k VK-NONE) (ps w "~dyn")
      (if (> (popcount64 k) 5)
          (do (ps w "~") (kinds-print w (bits-dual k VK-MASK)) 0)
        (do (kinds-print w k) 0)))))

;; `attach` drops the label and the separator, which only the first refinement may do.
(defn refine-open [(w (ptr Writer)) (attach bool) (ax i64)] (-> i64)
  (if attach 0 (do (ps w " ") (ps w (axis-label ax)) 0)))

;; FSZ-LOW is the axis bottom and has no printed form, so reaching here with it is a printer bug
;; rather than a value to guess at.
(defn flt-spec-write [(w (ptr Writer)) (fsz i64) (fbits i64)] (-> i64)
  (if (= fsz FSZ-CON) (do (ps w "=b") (dec-print w fbits) 0)
    (if (= fsz FSZ-HIGH) (ps w "^")
      (do (panic-text "flt-spec-write: a float size that is neither FSZ-CON nor FSZ-HIGH") 0))))

;; Every axis is decided BY FIELD VALUE. The int axis prints whenever the interval is not the
;; full one; the widening counter prints whenever it differs from the default the interval
;; implies (a pinned interval is freshly minted, so 0; an unpinned one is already as wide as it
;; can get, so TY-WIDEN-MAX); the float, function and shape axes print whenever they are off
;; their bottoms. Not one of those tests looks at a kind bit, which is the whole difference
;; between this printer and `ty-print`.
(defn val-write-exact [(w (ptr Writer)) (v Val)] (-> i64)
  (let [k    (val-kinds v)
        ax   (attach-axis k)
        ilo  (val-ilo v)
        ihi  (val-ihi v)
        int-shown (or (!= ilo TY-IMIN) (!= ihi TY-IMAX))
        wdef      (if int-shown 0 TY-WIDEN-MAX)
        wide-shown (!= (val-iwide v) wdef)
        flt-shown  (!= (val-fsz v) FSZ-LOW)
        fun-shown  (!= (val-fidxs v) -1)
        obj-shown  (!= (val-shapes v) -1)
        (mut first) true]
    (kinds-write-exact w k)
    (if int-shown
        (do (refine-open w (and (load first) (= ax AX-INT)) AX-INT)
            (store! first false)
            ; the same spelling ty.coil's debug printer writes, from the same function
            (int-range-print w ilo ihi)
            0)
      0)
    (if wide-shown
        (do (refine-open w false AX-WIDE)
            (store! first false)
            (dec-print w (val-iwide v))
            0)
      0)
    (if flt-shown
        (do (refine-open w (and (load first) (= ax AX-FLT)) AX-FLT)
            (store! first false)
            (flt-spec-write w (val-fsz v) (val-fbits v))
            0)
      0)
    (if fun-shown
        (do (refine-open w (and (load first) (= ax AX-FUN)) AX-FUN)
            (store! first false)
            (ps w "#") (dec-print w (val-fidxs v))
            0)
      0)
    (if obj-shown
        (do (refine-open w (and (load first) (= ax AX-OBJ)) AX-OBJ)
            (store! first false)
            (ps w "@") (dec-print w (val-shapes v))
            0)
      0)
    0))

;; Members are COMMA-separated. See the header: a space here would make `[int flt=b1]` mean two
;; different types.
(defn tuple-write-exact [(w (ptr Writer)) (off i64) (len i64)] (-> i64)
  (ps w "[")
  (let [(mut i) 0]
    (loop
      (if (>= (load i) len) (break)
        (do (if (> (load i) 0) (ps w ",") 0)
            (ty-write-exact w (ty-kid off (load i)))
            (store! i (+ (load i) 1))
            0))))
  (ps w "]"))

;; The unchecked writer. `ty-print-exact` is the entry point callers want; this one exists
;; because `ty-injective?` has to write a type in order to find out whether it may be written,
;; and going through the checked printer would recurse for ever.
(defn ty-write-exact [(w (ptr Writer)) (t i64)] (-> i64)
  (match (ty-get t)
    (TBot   [] (ps w "ALL"))
    (TTop   [] (ps w "ANY"))
    (TCtrl  [] (ps w "ctrl"))
    (TXCtrl [] (ps w "~ctrl"))
    (TVal   [v] (val-write-exact w v))
    (TTuple [off len] (tuple-write-exact w off len))
    ; THE SAME WRITER THE DEBUG PRINTER USES, from src/ty.coil, for the same reason the int axis
    ; shares `int-range-print`: a memory type has no kind bits to consult, so there is nothing for
    ; an exact printer to decide differently, and one spelling is one thing to keep injective. The
    ; recursion into the contents goes through `ty-print`, whose value form is lossy — which is
    ; exactly why `mem-print` is the DEBUG form and this arm writes the contents itself.
    (TMem [a c] (do (ps w "mem#") (dec-print w a) (ps w " ") (ty-write-exact w c) 0))))

; ============================================================================
; Parsing
; ============================================================================
(defn parse-kind-name [(c (ptr Cur))] (-> i64)
  (if (cur-eat? c "undefined") VK-UNDEF
    (if (cur-eat? c "null") VK-NULL
      (if (cur-eat? c "bool") VK-BOOL
        (if (cur-eat? c "bigint") VK-BIG
          (if (cur-eat? c "int") VK-INT
            (if (cur-eat? c "num") VK-NUM
              (if (cur-eat? c "flt") VK-FLT
                (if (cur-eat? c "str") VK-STR
                  (if (cur-eat? c "sym") VK-SYM
                    (if (cur-eat? c "obj") VK-OBJ
                      (if (cur-eat? c "fun") VK-FUN
                        (do (text-fail! c TERR-UNKNOWN-KIND) 0)))))))))))))

;; `name|name|…`. A repeated bit is refused rather than absorbed: `num|int` denotes the same set
;; as `num`, and quietly accepting a second spelling of one type is how a format acquires a
;; second, untested encoding.
(defn parse-namelist [(c (ptr Cur))] (-> i64)
  (let [(mut acc) 0 (mut done) false]
    (loop
      (if (load done) (break)
        (let [b (parse-kind-name c)]
          (if (not (text-ok?)) (store! done true)
            (do (if (!= (& (load acc) b) 0) (text-fail! c TERR-DUP-KIND) 0)
                (store! acc (| (load acc) b))
                (if (cur-eat-ch? c CH-BAR) 0 (store! done true))
                0)))))
    (load acc)))

(defn parse-kinds [(c (ptr Cur))] (-> i64)
  (if (cur-eat? c "~dyn") VK-NONE
    (if (cur-eat? c "dyn") VK-MASK
      (if (cur-eat-ch? c CH-TILDE)
          (let [k (parse-namelist c)] (if (text-ok?) (bits-dual k VK-MASK) 0))
        (parse-namelist c)))))

; ---------------------------------------------------------------------------
; One value's axes, while it is being parsed
; ---------------------------------------------------------------------------
;; A struct rather than a pile of `(mut …)` cells, because the refinement parser has to be able
;; to write any one axis and Coil passes a struct pointer, not seven references.
(defstruct VAcc
  [(ilo i64) (ihi i64) (iwide i64) (fsz i64) (fbits i64) (fidxs i64) (shapes i64)
   (seen i64)])     ; which axes a refinement has already set, as an AX-* bitset

(defn axis-bit [(ax i64)] (-> i64) (<< 1 ax))
(defn axis-seen? [(a (ptr VAcc)) (ax i64)] (-> bool)
  (!= (& (load (field a seen)) (axis-bit ax)) 0))

(defn vacc-init! [(a (ptr VAcc))] (-> i64)
  (store! (field a ilo)    TY-IMIN)
  (store! (field a ihi)    TY-IMAX)
  (store! (field a iwide)  0)
  (store! (field a fsz)    FSZ-LOW)
  (store! (field a fbits)  0)
  (store! (field a fidxs)  -1)
  (store! (field a shapes) -1)
  (store! (field a seen)   0)
  0)

;; `=N` / `=[lo..hi]` / `=~[hi..lo]`, mirroring `int-range-print`. The inverted spelling is the
;; high side of the axis: a widening meet over an inverted interval computes the intersection of
;; the high elements, which is why `dual` swaps the ends rather than complementing them.
(defn parse-int-spec! [(c (ptr Cur)) (a (ptr VAcc))] (-> i64)
  (if (not (cur-eat-ch? c CH-EQ)) (text-fail! c TERR-BAD-SIGIL)
    (let [inv (cur-eat-ch? c CH-TILDE)]
      (if (cur-eat-ch? c CH-LBRACK)
          (let [x (parse-bound c)]
            (if (not (text-ok?)) 0
              (if (not (cur-eat? c "..")) (text-fail! c TERR-NO-DOTDOT)
                (let [y (parse-bound c)]
                  (if (not (text-ok?)) 0
                    (if (not (cur-eat-ch? c CH-RBRACK)) (text-fail! c TERR-NO-RBRACK)
                      ; the printer writes the ends in increasing order in BOTH spellings, and
                      ; writes `=N` when they coincide, so a >= b is not a form it can produce
                      (if (>= x y) (text-fail! c TERR-BAD-RANGE)
                        (do (store! (field a ilo) (if inv y x))
                            (store! (field a ihi) (if inv x y))
                            0))))))))
        ; `=~N` would be an inverted single point, which is just that point
        (if inv (text-fail! c TERR-BAD-SIGIL)
          (let [x (parse-bound c)]
            (if (not (text-ok?)) 0
              (do (store! (field a ilo) x) (store! (field a ihi) x) 0))))))))

;; The counter is bounded by construction: `ty-widen` stops at TY-WIDEN-MAX and `dual` negates
;; it, so nothing the lattice can build lies outside ±TY-WIDEN-MAX. Refusing a wider one keeps
;; the parser from minting a type that no `meet` or `dual` could have produced.
(defn parse-wide-spec! [(c (ptr Cur)) (a (ptr VAcc))] (-> i64)
  (let [n (parse-dec c)]
    (if (not (text-ok?)) 0
      (if (or (> n TY-WIDEN-MAX) (< n (- 0 TY-WIDEN-MAX))) (text-fail! c TERR-WIDEN-RANGE)
        (do (store! (field a iwide) n) 0)))))

(defn parse-flt-spec! [(c (ptr Cur)) (a (ptr VAcc))] (-> i64)
  (if (cur-eat-ch? c CH-CARET) (do (store! (field a fsz) FSZ-HIGH) 0)
    (if (not (cur-eat-ch? c CH-EQ)) (text-fail! c TERR-BAD-SIGIL)
      (if (not (cur-eat-ch? c CH-LOWER-B)) (text-fail! c TERR-BAD-SIGIL)
        (let [n (parse-dec c)]
          (if (not (text-ok?)) 0
            (do (store! (field a fsz) FSZ-CON) (store! (field a fbits) n) 0)))))))

(defn parse-fun-spec! [(c (ptr Cur)) (a (ptr VAcc))] (-> i64)
  (if (not (cur-eat-ch? c CH-HASH)) (text-fail! c TERR-BAD-SIGIL)
    (let [n (parse-dec c)]
      (if (not (text-ok?)) 0 (do (store! (field a fidxs) n) 0)))))

(defn parse-obj-spec! [(c (ptr Cur)) (a (ptr VAcc))] (-> i64)
  (if (not (cur-eat-ch? c CH-AT)) (text-fail! c TERR-BAD-SIGIL)
    (let [n (parse-dec c)]
      (if (not (text-ok?)) 0 (do (store! (field a shapes) n) 0)))))

(defn parse-refine! [(c (ptr Cur)) (ax i64) (a (ptr VAcc))] (-> i64)
  (if (axis-seen? a ax) (text-fail! c TERR-DUP-REFINE)
    (do (store! (field a seen) (| (load (field a seen)) (axis-bit ax)))
        (case ax
          AX-INT  (parse-int-spec!  c a)
          AX-WIDE (parse-wide-spec! c a)
          AX-FLT  (parse-flt-spec!  c a)
          AX-FUN  (parse-fun-spec!  c a)
          AX-OBJ  (parse-obj-spec!  c a)
          (text-fail! c TERR-BAD-REFINE)))))

(defn parse-refine-label [(c (ptr Cur))] (-> i64)
  (if (cur-eat? c "int") AX-INT
    (if (cur-eat? c "w") AX-WIDE
      (if (cur-eat? c "flt") AX-FLT
        (if (cur-eat? c "fun") AX-FUN
          (if (cur-eat? c "obj") AX-OBJ
            (do (text-fail! c TERR-BAD-REFINE) AX-NONE)))))))

;; Rebuilt through `val-make` and `ty-intern`, never by writing a Val's fields directly: the
;; canonicalisation is theirs and inventing a second one here would break the identity in a way
;; only an exhaustive sweep could find. `val-make` already forces fbits to 0 unless fsz is
;; FSZ-CON, which is compatible only because the printer never writes bits without FSZ-CON.
(defn parse-value [(c (ptr Cur))] (-> i64)
  (let [k (parse-kinds c)]
    (if (not (text-ok?)) TY-NO-ID
      (let [a  (alloc-stack VAcc)
            ax (attach-axis k)]
        (vacc-init! a)
        ; the one refinement allowed to hang straight off the kinds text
        (if (refine-sigil? (cur-peek c))
            (if (= ax AX-NONE) (text-fail! c TERR-ATTACHED-NO-AXIS)
              (parse-refine! c ax a))
          0)
        (loop
          (if (or (not (text-ok?)) (not (cur-eat-ch? c CH-SPACE))) (break)
            (let [ax2 (parse-refine-label c)]
              (if (text-ok?) (parse-refine! c ax2 a) 0))))
        (if (not (text-ok?)) TY-NO-ID
          ; the counter's default is the one the printer suppressed, and it depends on whether
          ; the interval was pinned; getting this wrong loses the whole widening axis silently
          (let [iw (if (axis-seen? a AX-WIDE) (load (field a iwide))
                     (if (axis-seen? a AX-INT) 0 TY-WIDEN-MAX))]
            (ty-intern (TVal (val-make k
                                       (load (field a ilo)) (load (field a ihi)) iw
                                       (load (field a fsz)) (load (field a fbits))
                                       (load (field a fidxs)) (load (field a shapes)))))))))))

;; Members land in this frame's array and only then become a tuple, because a nested member's
;; own interning appends to the shared kid array in between: pushing members as they are parsed
;; would interleave two tuples' (off,len) windows.
(defn parse-tuple [(c (ptr Cur))] (-> i64)
  (let [p (text-state)]
    (if (>= (load (field p depth)) TEXT-MAX-DEPTH) (do (text-fail! c TERR-DEPTH) TY-NO-ID)
      (do (store! (field p depth) (+ (load (field p depth)) 1))
          (let [t (parse-tuple-body c)]
            (store! (field p depth) (- (load (field p depth)) 1))
            t)))))

;; How many members the tuple at the cursor has, counted WITHOUT parsing them: a scan for commas
;; at bracket depth 1. The cursor does not move.
;;
;; The arity has to be known before the first member is parsed, because the member window is
;; reserved up front. Counting by parsing the members and throwing the ids away would instead be
;; exponential in the nesting depth, since every level would re-parse everything below it.
;;
;; Depth counting is enough because the only brackets in the grammar are a tuple's and an int
;; range's `[lo..hi]`, and both are balanced; and a comma appears nowhere but between members.
(defn tuple-arity [(c (ptr Cur))] (-> i64)
  (let [(mut j)      (+ (load (field c i)) 1)     ; just past the "["
        (mut depth)  1
        (mut commas) 0
        (mut empty)  true
        (mut closed) false]
    (loop
      (if (or (load closed) (>= (load j) (load (field c len)))) (break)
        (let [b (cast i64 (load (index (load (field c data)) (load j))))]
          (if (= b CH-LBRACK) (store! depth (+ (load depth) 1))
            (if (= b CH-RBRACK)
                (do (store! depth (- (load depth) 1))
                    (if (= (load depth) 0) (store! closed true) 0)
                    0)
              (if (and (= b CH-COMMA) (= (load depth) 1))
                  (store! commas (+ (load commas) 1))
                0)))
          ; anything at all before the matching "]" means there is a first member
          (if (load closed) 0 (store! empty false))
          (store! j (+ (load j) 1))
          0)))
    (if (not (load closed)) (do (text-fail! c TERR-NO-RBRACK) 0)
      (if (load empty) 0 (+ (load commas) 1)))))

;; The window is reserved BEFORE any member is parsed, because parsing a member interns it and
;; interning appends to the very array the window lives in. See `ty-tuple-open`.
;;
;; The comma scan and the member loop are two ways of counting the same thing, so they are
;; checked against each other: a disagreement means one of them is wrong about the grammar, and
;; that is a named error rather than an unfilled member slot. If the parse fails part way the
;; reserved slots are simply abandoned, which is what an append-only arena is for.
(defn parse-tuple-body [(c (ptr Cur))] (-> i64)
  (let [arity (tuple-arity c)]
    (if (not (text-ok?)) TY-NO-ID
      (let [tb (ty-tuple-open arity)
            (mut n) 0
            (mut done) false]
        (cur-bump! c)                                   ; the "["
        (if (cur-eat-ch? c CH-RBRACK) (store! done true) 0)
        (loop
          (if (or (load done) (not (text-ok?))) (break)
            (let [m (parse-type c)]
              (if (not (text-ok?)) (store! done true)
                (if (>= (load n) arity) (text-fail! c TERR-TUPLE-COUNT)
                  (do (ty-tuple-put! tb (load n) m)
                      (store! n (+ (load n) 1))
                      (if (cur-eat-ch? c CH-COMMA) 0
                        (if (cur-eat-ch? c CH-RBRACK) (store! done true)
                          (text-fail! c TERR-NO-RBRACK)))
                      0))))))
        (if (not (text-ok?)) TY-NO-ID
          (if (!= (load n) arity) (do (text-fail! c TERR-TUPLE-COUNT) TY-NO-ID)
            ; a 0-member tuple is accepted even though nothing in the lattice builds one yet: the
            ; printer has to be total on every id `t-tuple-list` can mint, or printing panics on
            ; a type that was perfectly legal to construct
            (ty-tuple-close tb)))))))

;; The memory form. THE DEPTH COUNTER IS BUMPED even though a legal memory type nests exactly one
;; level, because the CHECK that the contents is a value happens after the contents has been
;; parsed, and a hostile `mem#1 mem#1 mem#1 …` would otherwise recurse on the C stack until it
;; overflowed rather than reporting TERR-MEM-CONTENTS. Same mechanism as `parse-tuple`, same
;; reason: this parser recurses, so every recursive production pays into one budget.
(defn parse-mem [(c (ptr Cur))] (-> i64)
  (let [p (text-state)]
    (if (>= (load (field p depth)) TEXT-MAX-DEPTH) (do (text-fail! c TERR-DEPTH) TY-NO-ID)
      (do (store! (field p depth) (+ (load (field p depth)) 1))
          (let [t (parse-mem-body c)]
            (store! (field p depth) (- (load (field p depth)) 1))
            t)))))

(defn parse-mem-body [(c (ptr Cur))] (-> i64)
  (if (not (cur-eat-ch? c CH-HASH)) (do (text-fail! c TERR-MEM-NO-HASH) TY-NO-ID)
    (let [bits (parse-dec c)]
      (if (not (text-ok?)) TY-NO-ID
        (if (not (cur-eat-ch? c CH-SPACE)) (do (text-fail! c TERR-MEM-NO-SPACE) TY-NO-ID)
          (let [inner (parse-type c)]
            (if (not (text-ok?)) TY-NO-ID
              ; asked BEFORE `t-mem`, so a malformed text is a named parse failure and not an abort
              ; inside the constructor with no byte offset to report
              (if (not (ty-mem-contents-ok? inner))
                  (do (text-fail! c TERR-MEM-CONTENTS) TY-NO-ID)
                (t-mem bits inner)))))))))

;; `mem` is tried before the value parser because no kind name begins with it, so there is no text
;; that both productions could claim.
(defn parse-type [(c (ptr Cur))] (-> i64)
  (if (cur-eat? c "ALL") (t-bot)
    (if (cur-eat? c "ANY") (t-top)
      (if (cur-eat? c "~ctrl") (t-xctrl)              ; before "ctrl", and before "~" + names
        (if (cur-eat? c "ctrl") (t-ctrl)
          (if (cur-eat? c "mem") (parse-mem c)
            (if (= (cur-peek c) CH-LBRACK) (parse-tuple c)
              (if (cur-eof? c) (do (text-fail! c TERR-UNKNOWN-FORM) TY-NO-ID)
                (parse-value c)))))))))

; ============================================================================
; Entry points
; ============================================================================
;; Returns the interned id, or TY-NO-ID with `text-err` set. The caller MUST check: TY-NO-ID is
;; -1 and handing it to `ty-get` is an out-of-bounds read, which is why `ty-parse` below exists
;; and is what ordinary code should use.
(defn ty-try-parse [(s (slice u8))] (-> i64)
  (let [c (alloc-stack Cur)
        p (text-state)]
    (store! (field p err)   TERR-NONE)
    (store! (field p pos)   0)
    (store! (field p depth) 0)
    (store! (field c data) (slice-data s))
    (store! (field c len)  (slice-len s))
    (store! (field c i)    0)
    (let [t (parse-type c)]
      (if (not (text-ok?)) TY-NO-ID
        (if (cur-eof? c) t (do (text-fail! c TERR-TRAILING) TY-NO-ID))))))

;; The strict entry point. Malformed text means whatever produced it is broken, and a returned
;; sentinel would surface three passes later as an ALL-typed node with no trace of where it came
;; from, so this reports the failure by NAME and stops.
(defn ty-parse [(s (slice u8))] (-> i64)
  (let [t (ty-try-parse s)]
    (if (!= t TY-NO-ID) t
      (do (let [w (stderr)]
            (ps w "textual IR: cannot parse a type: ")
            (ps w (text-err-name (text-err)))
            (ps w " at byte ")
            (dec-print w (text-err-pos))
            (ps w " of \"")
            (print-str w s)
            (ps w "\"\n"))
          (abort)
          0))))

; ---------------------------------------------------------------------------
; Round-trip checking
; ---------------------------------------------------------------------------
;; One static scratch buffer. It is used only by `ty-injective?`, which does not recurse into
;; itself, so a single cell is enough and a per-call stack buffer this size is not.
(const TEXT-SCRATCH i64 65536)
(defstruct TextScratch [(buf (array i8 65536))])
(defn text-scratch [] (-> (ptr TextScratch)) (alloc-static TextScratch))

;; WHY THE ROUND TRIP REPORTS A CAUSE AND NOT A BOOL. Three different bugs make a print fail to
;; decode, they live in three different files, and a bare `false` collapses them into one message
;; that names the wrong one. The scratch buffer already had its own hard error for exactly this
;; reason ("the buffer was too small" and "the format is ambiguous" are different bugs); a parse
;; that GAVE UP is a third cause, and reporting it as an ambiguity sends the reader to the printer
;; when the answer is in the parser.
(const RT-OK           i64 0)   ; the text parsed back to the same id
(const RT-PARSE-FAILED i64 1)   ; the text did not parse at all; `text-err` names the production
(const RT-DIFFERENT-ID i64 2)   ; it parsed, to a DIFFERENT type: the format really is ambiguous

;; Does this type's printed form decode back to it, and if not, why not?
;;
;; It writes with `ty-write-exact` and NOT with `ty-print-exact`, which would call straight back
;; into here. Truncation is its own hard error rather than a code, because a type whose text does
;; not fit is a claim about this buffer and not about the format at all.
(defn ty-round-trip-check [(t i64)] (-> i64)
  (let [sc (text-scratch)
        fb (alloc-stack FixBuf)
        w  (alloc-stack Writer)]
    (store! (field fb data) (cast (ptr i8) (index (field sc buf) 0)))
    (store! (field fb cap)  TEXT-SCRATCH)
    (store! (field fb len)  0)
    (fixed-buffer-writer w fb)
    (ty-write-exact w t)
    (let [n (load (field fb len))]
      (if (>= n TEXT-SCRATCH)
          (do (panic-text "ty-round-trip-check: a type's exact form is longer than the scratch buffer")
              RT-PARSE-FAILED)
        (let [got (ty-try-parse (slice-new [u8] (cast (ptr u8) (index (field sc buf) 0)) n))]
          (if (= got TY-NO-ID) RT-PARSE-FAILED
            (if (= got t) RT-OK RT-DIFFERENT-ID)))))))

;; The bool the sweep wants. `text-err` and `text-err-pos` are still readable afterwards, because
;; `ty-try-parse` resets them on entry and nothing on the failure path touches them.
;;
;; A note for whoever sweeps this over the interning table: a type that round-trips interns
;; nothing new, but a type that does NOT round-trips into a fresh id and its dual, so the table
;; can grow mid-sweep. Snapshot `ty-count` before the loop.
(defn ty-injective? [(t i64)] (-> bool) (= (ty-round-trip-check t) RT-OK))

;; The printer callers should use: it refuses to emit a string that does not decode back.
;;
;; That costs a parse on every print, which is the right trade for a format whose whole purpose
;; is to be read back. A printer that emits an ambiguous string is worse than one that stops,
;; because the string gets committed as a golden and the ambiguity is discovered by a
;; miscompile much later.
;;
;; Each cause gets its OWN message, and each message names the file to go and read.
(defn ty-print-exact [(w (ptr Writer)) (t i64)] (-> i64)
  (let [rt (ty-round-trip-check t)]
    (if (= rt RT-OK) (ty-write-exact w t)
      (do (let [e (stderr)]
            (ps e "textual IR: t") (dec-print e t)
            (ps e " prints as \"")
            (ty-write-exact e t)
            (ps e "\"\n")
            (if (= rt RT-DIFFERENT-ID)
                (ps e "  which decodes back to a DIFFERENT type: the exact form is ambiguous\n")
              (do (ps e "  which does not parse: ")
                  (ps e (text-err-name (text-err)))
                  (ps e " at byte ")
                  (dec-print e (text-err-pos))
                  (ps e "\n")
                  (if (= (text-err) TERR-DEPTH)
                      ; the one cause that is NOT a printer bug: the parser recurses on the C
                      ; stack and gives up past TEXT-MAX-DEPTH. `ty-tuple-close` refuses to mint a
                      ; type that deep for precisely this reason, so reaching here means those two
                      ; bounds have drifted apart. src/ty.coil's TY-MAX-TUPLE-DEPTH is the pair.
                      (ps e "  the format is not at fault: the parser's depth budget is TEXT-MAX-DEPTH, and TY-MAX-TUPLE-DEPTH was supposed to keep a type this deep from existing\n")
                    0)
                  0)))
          (if (= rt RT-DIFFERENT-ID)
              (panic-text "ty-print-exact: the exact form of this type is not injective")
            (panic-text "ty-print-exact: the exact form of this type does not parse back"))
          0))))

;; Render a type into a caller-owned buffer so a test can compare the exact text as a string.
;; The `n-render` pattern: the Writer and the FixBuf are the caller's frame, never a static, so
;; rendering two things at once does not merge them.
(defn ty-render [(t i64) (buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (alloc-stack FixBuf)
        w  (alloc-stack Writer)]
    (store! (field fb data) buf)
    (store! (field fb cap)  cap)
    (store! (field fb len)  0)
    (fixed-buffer-writer w fb)
    (ty-print-exact w t)
    (slice-new [u8] (cast (ptr u8) buf) (load (field fb len)))))

(defn panic-text [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "textual IR: ") (ps w msg) (ps w "\n"))
  (abort) 0)
