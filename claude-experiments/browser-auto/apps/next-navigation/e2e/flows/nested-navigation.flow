# Rewrite of Next's 'should navigate to nested pages' (navigation.test.ts:683)
# — now with a table-driven loop, unrolled at parse time into flat steps.
# Matches the shape of Next's JS double-loop, but every hop stays an
# independently traceable/replayable step (see the [iteration] tag on failure).
flow "navigate nested pages"

go /nested-navigation
  expect heading "Home"

# top-level categories
for $cat $all
  "Electronics" "All Electronics"
  "Clothing"    "All Clothing"
  "Books"       "All Books"
do
  click link "$cat"
    expect text "$all"

# electronics subcategories (unambiguous names)
go /nested-navigation/electronics
  expect text "All Electronics"

for $sub in
  "Phones"
  "Tablets"
  "Laptops"
do
  click link "$sub"
    expect text "$sub"
